   146 				; Wait For VSync (locks to the refresh rate, PAL=50Hz, NTSC=60Hz)  Thanks tebe
   147 				;-----------------------------------------------------------------------------
   148 420E			Wait_For_Sync							; Hold until VCOUNT == 0
