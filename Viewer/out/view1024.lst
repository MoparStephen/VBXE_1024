   560 				;-----------------------------------------------------------------------------
   561 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner (pixel data,
   562 				; attribute map) into dedicated, resident VRAM - never touched by Load_Image,
   563 				; and never reloaded from disk again after this one call, since the banner
   564 				; never changes at runtime.  Blank-fills any banner target whose file is
   565 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   566 				; no asset file at all - it is always a fixed-colour blitter fill
   567 				; (Menu_Sep_Blank).  The banner's palette (registers 1-3) is no longer a disk
   568 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   569 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   570 				; Enter_Selector.
   571 				;-----------------------------------------------------------------------------
   572 3423			Load_Menu_Banner_Raw
   573 3423 A9 FD			lda #<Menu_Banner_Raw_Name
   574 3425 8D 28 31			sta FileNamePtr
   575 3428 A9 35			lda #>Menu_Banner_Raw_Name
   576 342A 8D 29 31			sta FileNamePtr + $01
   577 342D A9 30			lda #MENU_BANNER_BANK
   578 342F 85 8E			sta BankIndex
   579 3431 20 AA 30			jsr LoadData
   580 3434 AD 2D 31			lda LoadStatus
   581 3437 D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   582 3439 20 A0 35			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   583
   584 343C			Load_Menu_Banner_Raw_Sep
   585 343C 20 C9 35			jsr Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   586
   587 343F			Load_Menu_Banner_Raw_Map
   588 				; Load the banner's .MAP into $14000 (CRAM_Buffer, shared scratch - fine,
   589 				; this is a one-time boot step) and expand it into MENU_BANNER_MAP_VRAM (its
   590 				; own resident copy, NOT the shared CRAM $017000 - see Setup_Menu_Cmap).
   591 343F A9 F2			lda #<Menu_Banner_Map_Name
   592 3441 8D 28 31			sta FileNamePtr
   593 3444 A9 35			lda #>Menu_Banner_Map_Name
   594 3446 8D 29 31			sta FileNamePtr + $01
   595 3449 A9 14			lda #$14
   596 344B 85 8E			sta BankIndex
   597 344D 20 AA 30			jsr LoadData
   598 3450 AD 2D 31			lda LoadStatus
   599 3453 F0 03			beq Load_Menu_Banner_Raw_Done		; OPEN/load failed - leave MENU_BANNER_MAP_VRAM as-is
   600 3455 20 77 33			jsr Setup_Menu_Cmap
