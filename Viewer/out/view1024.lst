   552 4E5C A9 00			lda #MEMAC_GLOBAL_DISABLE
   553 4E5E				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 4E5E A0 5F			ldy #<VBXE_MA_BSEL
     3 4E60 91 93			sta (VBXEBase),y
Source: ui.asm
