    23
    24 				; VBXE hardware split-screen menu/info XDL - banner + main text + separator +
    25 				; footer text + separator, framed by blank borders.  Used by both the file
    26 				; selector (UI_Mode 0) and the info/.nfo viewer (UI_Mode 4); the image viewer
    27 				; (XDL_Image_Attribute/Normal above) is untouched.  Font/screen/pitch equates
    28 				; all come from view1024.asm's .def block so this XDL and text80.asm cannot
    29 				; drift.  OV_PALETTE = 0 (ui.asm's Restore_Palette0 keeps standard PAL/NTSC
    30 				; colours in palette 0); the banner's attribute map lives in its own
    31 				; dedicated, resident MENU_BANNER_MAP_VRAM (zeroed at boot = palette 0, plus
    32 				; the ramp squares' cells; never the shared CRAM $017000 the image viewer
    33 				; uses) so it never needs a reload.
    34 				; The palette REGISTERS (text set 0 + banner 1-3) need an Enter_Selector
    35 				; refresh - a cheap resident-VRAM-to-register copy, no disk access - since
    36 				; VBXE has exactly 4 physical palette registers total and Load_Image
    37 				; legitimately overwrites them for every real image viewed; see
    38 				; Apply_Menu_Palettes (view1024.asm).
    39 				;
    40 				; 239-scanline layout (confirmed with Stephen; down from the original 240
    41 				; due to the extra separator block added under the banner):
    42 				;   8  blank (top border)
    43 				;  34  med-res graphics + attribute map (banner)                  MENU_BANNER_VRAM
    44 				;   1  lo-res graphics, no attribute map (separator)               MENU_SEP_VRAM
    45 				;   1  blank
    46 				; 160  text, 20 rows (main content: grid / Location / NFO scroll) TEXT_SCREEN_VRAM
    47 				;   1  lo-res graphics, no attribute map (separator, same image)   MENU_SEP_VRAM
    48 				;   1  blank
    49 				;  24  text, 3 rows (footer: status/delay/legend, or info hint)   TEXT_FOOTER_VRAM
    50 				;   1  lo-res graphics, no attribute map (separator, same image)   MENU_SEP_VRAM
    51 				;   8  blank (bottom border)
    52 				;  ---
    53 				; 239  total
    54 2021			XDL_MainMenu
    55 				; Blank-group encoding (XDLC_OVOFF|XDLC_MAPOFF|XDLC_RPTL, no OVADR/OVATT) and
    56 				; the RPTL = scanlines-1 formula both come from Stephen's own working draft.
    57 				;		 76543210
    58 				; --- Block 1: 8 blank scanlines (top border) --------------------------------
    59 2021 34				dta %00110100						; XDLC Byte 1 $34 (XDLC_OVOFF | XDLC_MAPOFF | XDLC_RPTL)
    60 2022 00				dta $00								; XDLC Byte 2 (no ATT/CHBASE)
    61 2023 07				dta $07								; XDLC_RPTL = 8-1
    62
    63 				; --- Block 2: 34 med-res scanlines, banner (attribute-mapped) --------------
    64 2024 6A 0E			dta %01101010,%00001110			; XDLC (GMON|MAPON|RPTL|OVADR, ATT) - matches XDL_Image_Attribute
    65 2026 21				dta $21								; XDLC_RPTL = 34-1
    66 2027 00 00 03 40 01		dta <MENU_BANNER_VRAM, >MENU_BANNER_VRAM, MENU_BANNER_VRAM >> 16, <MENU_BANNER_PITCH, >MENU_BANNER_PITCH
    67 202C 00 50 03 A0 00		dta <MENU_BANNER_MAP_VRAM, >MENU_BANNER_MAP_VRAM, MENU_BANNER_MAP_VRAM >> 16, <$00A0, >$00A0	; XDLC_MAPADR (5 bytes) - dedicated, resident (NOT shared CRAM), Step $00A0
    68 2031 00 00 07 00			dta $00,$00,$07,$00					; XDLC_MAPPAR (4 bytes) No Scroll, size 8x1
    69 2035 11 FE			dta %00010001,$FE					; XDLC_OVATT (2 bytes)  Priority $FE (per Stephen's draft)
    70
    71 				; --- Block 3: 1 lo-res scanline, separator (no attribute map) --------------
    72 				; OV_WIDTH=00 (vs the banner/text's 01) for the narrower 160-byte/row lo-res
    73 				; pitch - UNVERIFIED, tune against Altirra alongside the RPTL/chaining checks
    74 				; this whole XDL already needs (see the implementation plan's risk notes).
    75 2037 72				dta %01110010						; XDLC Byte 1 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    76 2038 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    77 2039 00				dta $00								; XDLC_RPTL = 1-1
    78 203A 00 40 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
    79 203F 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
    80
    81 				; --- Block 4: 1 blank scanline ----------------------------------------------
    82 2041 34				dta %00110100
    83 2042 00				dta $00
    84 2043 00				dta $00								; XDLC_RPTL = 1-1
    85
    86 				; --- Block 5: 160 text scanlines, 20 rows (main content) -------------------
    87 2044 71				dta %01110001						; XDLC Byte 1 (XDLC_TMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    88 2045 09				dta %00001001						; XDLC Byte 2 (XDLC_CHBASE | XDLC_ATT)
    89 2046 9F				dta $9F								; XDLC_RPTL = 160-1
    90 2047 00 30 02 A0 00		dta <TEXT_SCREEN_VRAM, >TEXT_SCREEN_VRAM, TEXT_SCREEN_VRAM >> 16, <TEXT_PITCH, >TEXT_PITCH
    91 204C			XDL_MainMenu_CHBase						; Toggle_Font pokes this byte - see text80.asm
    92 204C 44				dta TEXT_CHBASE						; XDLC_CHBASE (1 byte)  font @ TEXT_FONT_VRAM
    93 204D 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=01 | OV_PALETTE=00 ; Priority $FE
    94
    95 				; --- Block 6: 1 lo-res scanline, separator (same image as Block 3) ---------
    96 204F 72				dta %01110010						; XDLC Byte 1 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    97 2050 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    98 2051 00				dta $00								; XDLC_RPTL = 1-1
    99 2052 00 40 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
   100 2057 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
   101
   102 				; --- Block 7: 1 blank scanline ----------------------------------------------
   103 2059 34				dta %00110100
