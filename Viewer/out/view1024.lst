  1049 5406 9D 45 03			sta ICBAH,x
  1050 5409 A9 03			lda #CIO_open
  1051 540B 9D 42 03			sta ICCOM,x
  1052 540E 20 56 E4			jsr CIOV
  1053 5411 30 5C			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
  1054
  1055 5413			Nfo_Name_LoadManifest_Line
