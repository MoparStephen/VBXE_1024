  2416 5DCD			Slideshow_Reload_Counter
  2417 5DCD A9 00			lda #$00
  2418 5DCF 8D CA 04			sta Slide_FrameCtr
  2419 5DD2 8D CB 04			sta Slide_FrameCtr+1
  2420 5DD5 AE C9 04			ldx Slide_Secs
  2421 5DD8 F0 1E			beq Slideshow_Reload_Done
  2422 5DDA AD 89 04			lda Video_Flag
  2423 5DDD D0 04			bne Slideshow_Reload_NTSC
  2424 5DDF A9 32			lda #50
  2425 5DE1 D0 02			bne Slideshow_Reload_Set
  2426 5DE3			Slideshow_Reload_NTSC
  2427 5DE3 A9 3C			lda #60
  2428 5DE5			Slideshow_Reload_Set
  2429 5DE5 85 80			sta Reg1							; Reg1 = frames to add per second
  2430 5DE7			Slideshow_Reload_L1
  2431 5DE7 18				clc
  2432 5DE8 AD CA 04			lda Slide_FrameCtr
  2433 5DEB 65 80			adc Reg1
  2434 5DED 8D CA 04			sta Slide_FrameCtr
  2435 5DF0 90 03			bcc Slideshow_Reload_NoCarry
