   731 				;-----------------------------------------------------------------------------
   732 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   733 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   734 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   735 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   736 				;-----------------------------------------------------------------------------
   737 3497			Image_Read_Segment
   738 3497 8D E3 04			sta Seg_Bank
   739 349A 8E E4 04			stx Seg_Chunks
   740 349D			Image_Read_Segment_L1
   741 349D AD E4 04			lda Seg_Chunks
   742 34A0 F0 0F			beq Image_Read_Segment_Tail
   743 34A2 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   744 34A4 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   745 34A6 20 C4 34			jsr Image_Read_Chunk
   746 34A9 B0 18			bcs Image_Read_Segment_Done
   747 34AB CE E4 04			dec Seg_Chunks
   748 34AE 4C 9D 34			jmp Image_Read_Segment_L1
   749
   750 34B1			Image_Read_Segment_Tail
