   307 39FB A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 39FD 8D 9A 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3A00 4C 6A 3A			jmp Text_Window_Kick
   310
   311 3A03			Text_Window_Restore
