   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3FA2			Text_Window_Frame_Chars
   504 3FA2 C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3FAB DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3FB4			Text_Window_Frame
   508 3FB4 A5 80			lda Reg1
   509 3FB6 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3FB8 AD B1 06			lda Txt_Col
   511 3FBB 85 87			sta Reg8							; Reg8 = left column
   512 3FBD AD B0 06			lda Txt_Row
   513 3FC0 18				clc
   514 3FC1 65 81			adc Reg2
   515 3FC3 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3FC5 AD B0 06			lda Txt_Row
   517 3FC8 85 84			sta Reg5							; Reg5 = current screen row
   518 3FCA AE B5 06			ldx Txt_FrameStyle
   519 3FCD 20 EC 3F			jsr Text_Window_Frame_Row			; top edge
   520 3FD0			Text_Window_Frame_Mid
   521 3FD0 E6 84			inc Reg5
   522 3FD2 A5 84			lda Reg5
   523 3FD4 C5 85			cmp Reg6
   524 3FD6 B0 0D			bcs Text_Window_Frame_Bottom
   525 3FD8 AD B5 06			lda Txt_FrameStyle
   526 3FDB 18				clc
   527 3FDC 69 03			adc #$03
   528 3FDE AA				tax
   529 3FDF 20 EC 3F			jsr Text_Window_Frame_Row			; interior row
   530 3FE2 4C D0 3F			jmp Text_Window_Frame_Mid
   531 3FE5			Text_Window_Frame_Bottom
   532 3FE5 AD B5 06			lda Txt_FrameStyle
   533 3FE8 18				clc
   534 3FE9 69 06			adc #$06
   535 3FEB AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3FEC			Text_Window_Frame_Row
   540 3FEC BD A2 3F			lda Text_Window_Frame_Chars,x
   541 3FEF 8D 80 06			sta Txt_Line+0
   542 3FF2 BD A3 3F			lda Text_Window_Frame_Chars+1,x
   543 3FF5 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3FF7 BD A4 3F			lda Text_Window_Frame_Chars+2,x
   545 3FFA 85 82			sta Reg3							; Reg3 = right char
   546 3FFC A2 01			ldx #$01
   547 3FFE			Text_Window_Frame_Row_L1
   548 3FFE E4 86			cpx Reg7
   549 4000 B0 08			bcs Text_Window_Frame_Row_End
   550 4002 A5 83			lda Reg4
   551 4004 9D 80 06			sta Txt_Line,x
   552 4007 E8				inx
   553 4008 D0 F4			bne Text_Window_Frame_Row_L1
   554 400A			Text_Window_Frame_Row_End
   555 400A A5 82			lda Reg3
   556 400C 9D 80 06			sta Txt_Line,x
   557 400F E8				inx
   558 4010			Text_Window_Frame_PutRow
   559 4010 A9 00			lda #$00
   560 4012 9D 80 06			sta Txt_Line,x
   561 4015 A5 84			lda Reg5
   562 4017 8D B0 06			sta Txt_Row
   563 401A A5 87			lda Reg8
   564 401C 8D B1 06			sta Txt_Col
   565 401F A9 80			lda #<Txt_Line
   566 4021 85 96			sta Txt_Ptr
   567 4023 A9 06			lda #>Txt_Line
   568 4025 85 97			sta Txt_Ptr + $01
   569 4027 4C 2A 40			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
