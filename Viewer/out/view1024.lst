   780 				;-----------------------------------------------------------------------------
   781 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   782 				;  Out: C=1 on a read error / short file.
   783 				;-----------------------------------------------------------------------------
   784 358F			Image_Read_Pal
   785 358F A9 21			lda #V1K_PAL_BANK
   786 3591 A2 00			ldx #V1K_PAL_LEN / $1000
   787 3593 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   788 3595 8C E5 04			sty Seg_Tail
   789 3598 A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   790 359A 8C E6 04			sty Seg_Tail + $01
   791 359D 4C D1 35			jmp Image_Read_Segment
