   930 523D A9 20			lda #$20
   931 523F			Nfo_Name_Emit_PadL
   932 523F C0 30			cpy #NFO_NAME_CAP
   933 5241 B0 06			bcs Nfo_Name_Emit_Term
   934 5243 99 8D 04			sta Path_Buf,y
   935 5246 C8				iny
   936 5247 D0 F6			bne Nfo_Name_Emit_PadL				; always (Y < NFO_NAME_CAP)
   937 5249			Nfo_Name_Emit_Term
