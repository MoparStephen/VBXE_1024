   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    69
    70 				;-----------------------------------------------------------------------------
    71 				; Structure Declarations
    72 				;-----------------------------------------------------------------------------
    73
    74 				;-----------------------------------------------------------------------------
    75 				; Variables go here
    76 				;-----------------------------------------------------------------------------
    77 				; Page 0 user data ($80 to $FF with some reserved for OS)
    78 				.zpvar Reg1				.byte			; Multi-Use Variables
    79 				.zpvar Reg2				.byte			; Multi-Use Variables
    80 				.zpvar Reg3				.byte			; Multi-Use Variables
    81 				.zpvar Reg4				.byte			; Multi-Use Variables
    82 				.zpvar Reg5				.byte			; Multi-Use Variables
    83 				.zpvar Reg6				.byte			; Multi-Use Variables
    84 				.zpvar Reg7				.byte			; Multi-Use Variables
    85 				.zpvar Reg8				.byte			; Multi-Use Variables
    86 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    87 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    88 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    89 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    90
    91 				; Non Page-0 Variables
    92 				;	$480 to $4FF free
    93 				;	$600 to $6FF free
    94 				; When using PMG the 1st $300 bytes are always free
    95 				.var SDMCTL_OLD			.byte = $480	; Save DMA
    96 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
    97 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
    98 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
    99 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   100 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   101 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   102 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   103 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   104 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   105 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   106 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   107 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   108 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   109 				; --- viewer UI state (ui.asm) ---
   110 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 6 P-preview
   111 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   112 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   113 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   114 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   115 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   116 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   117 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   118 				.var FileStart			.byte = $4DA	; selector list: index of the first *.V1K row (= upCount + Dir_Count)
   119 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   120 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   121 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   122 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   123 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   124 				; --- single-file .V1K image loader (Image_Open / Image_Read_Segment) ---
   125 				.var Load_IOCB			.byte = $4E2	; IOCB offset of the open .V1K file
   126 				.var Seg_Bank			.byte = $4E3	; VBXE bank the next 4K chunk lands in
   127 				.var Seg_Chunks			.byte = $4E4	; full 4K chunks left in this segment
   128 				.var Seg_Tail			.word = $4E5	; bytes in the segment's final partial chunk
   129 				;	$4E7 to $4FF free
   130 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   131 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   132 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.V1K",$9B ($650-$67F)
   133 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   134 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP name + $9B) for
   135 				; Nfo_Name_LoadManifest.  Own buffer, not Dir_Line_Buf, because a record can
   136 				; run to 8+48+1 = 57 bytes - past that 40-byte line's end.
   137 				.var Nfo_Name_Line		:58 .byte = $6B7	; 8 key + 48 name + $9B, rounded ($6B7-$6F0)
   138 				;	$6F1 to $6FF free (text80.asm uses $6B0-$6B6)
   139 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   140 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   141 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   142 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   143 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   144
   145 				;-----------------------------------------------------------------------------
   146 				; Defines go here
   147 				;-----------------------------------------------------------------------------
   148 = FFFF0001		.def	__VBXE_AUTO__
   149 = 2000			.def	VBXE_WINDOW						= $2000
   150 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   151 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   152 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   153
   154 				; Image name list (built by Rescan_Images - see ui.asm)
   155 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   156 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   157 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   158 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   159 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   160
   161 				; Single-file image: <name>.V1K = .PAL block + .MAP block + .RAW block, no
   162 				; header - every block is fixed-size, so every offset is a constant.
   163 				; Load_Image streams each block to the same VRAM the old 3-file load used.
   164 = 0C00			.def	V1K_PAL_LEN						= $0C00		; 4 palettes x 768     = 3072
   165 = 2580			.def	V1K_MAP_LEN						= $2580		; 40 cells x 240 rows  = 9600
   166 = 012C00			.def	V1K_RAW_LEN						= $12C00	; 320 x 240 pixels     = 76800
   167 = 0021			.def	V1K_PAL_BANK					= $21		; -> $21000 (read back by Apply_Image_Palette)
   168 = 0014			.def	V1K_MAP_BANK					= $14		; -> $14000 (CRAM_Buffer, Setup_Cmap1 expands it)
   169 = 0001			.def	V1K_RAW_BANK					= $01		; -> $01000 (framebuffer)
   170
   171 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   172 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   173 				; ($21000), the name list ($40000) and the dir browser ($41000).
   174 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   175 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   176 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   177 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   178 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   179 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   180 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   181 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   182 = 0050			.def	TEXT_COLS						= 80
   183 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   184 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   185 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   186 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   187 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   188 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   189 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   190 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   191 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   192
   193 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   194 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   195 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   196 = 030000			.def	MENU_BANNER_VRAM				= $30000
   197 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   198 = 0024			.def	MENU_BANNER_ROWS				= 36
   199 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   200 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   201 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   202 = 00A0			.def	MENU_SEP_PITCH					= 160
   203 = 0007			.def	MENU_SEP_FILL_COLOUR			= $07		; white in the modified A8 palette (Palette 0)  Palette is modified so text can use all 128 colours
   204
   205 				; Banner palette + attribute map: never touched at runtime (unlike the real
   206 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   207 				; overwrites for every image view).  Dedicated, resident VRAM - see
   208 				; Load_Menu_Banner_Raw / Apply_Menu_Banner_Palette (below) and Setup_Menu_Cmap.
   209 				; The palette bytes are assembly-embedded (Load_Menu_Ramps, init_vbxe.asm),
   210 				; not disk-loaded; the attribute map is still loaded once from D:MENU.MAP.
   211 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   212 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   213 																	; - palette register 0 is reserved for text
   214 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   215 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   216 																	; XDL_MainMenu's banner MAPADR points here, NOT
   217 																	; at the shared $017000 CRAM
   218
   219 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   220 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   221 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   222 				; unchanged) but horizontally mirrored via the attribute map only -
   223 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   224 				; Squares, Set_Menu_Demo_Attrs (below).
   225 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   226 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   227 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   228 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   229 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   230 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   231 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   232 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   233 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   234 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   235 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   236 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   237 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   238 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   239
   240 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   241 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   242 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   243 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   244 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   245 = 1000			.def	PAL_PREVIEW_VRAM				= $001000	; image framebuffer (same target Load_Image's .RAW uses)
   246 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   247 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   248 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   249 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   250 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   251 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   252 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   253 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   254 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   255 = 18F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   256 = 1960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   257 = A4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   258 = A560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   259 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   260 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   261 				; whole buffer, and palette 0 = $00 is the zero default).
   262 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   263 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   264 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   265 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   266 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   267 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   268 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   269 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   270
   271 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   272 				; converter emits it as this exact byte image of the text screen - fixed
   273 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   274 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   275 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   276 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   277 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   278 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   279
   280 				; Selector status-line long-name cache.  One NFO_NAME_SLOT-byte slot per image
   281 				; ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   282 				; Rescan_Images (the converter writes that file - 8-byte key + source name per
   283 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  64
   284 				; divides 4K so no slot straddles a bank; 255*64 = $3FC0 -> banks $2A-$2D.
   285 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   286 = 02A000			.def	NFO_NAME_VRAM					= $2A000
   287 = 002A			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $2A
   288 = 0040			.def	NFO_NAME_SLOT					= 64		; bytes per image slot
   289 = 0030			.def	NFO_NAME_CAP						= 48		; chars shown on the status line
   290
   291 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   292 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   293 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   294 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   295 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   296 = 0006			.def	DRIVE_WIN_ROW					= 6
   297 = 001E			.def	DRIVE_WIN_COL					= 30
   298 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   299 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   300
   301 				; Quit-confirm popup (UI_Mode 5) - "Are you sure to Quit" + (Y/N), Selector only.
   302 = 0008			.def	QUIT_WIN_ROW					= 8
   303 = 0016			.def	QUIT_WIN_COL					= 22
   304 = 0024			.def	QUIT_WIN_W						= 36		; cells wide  (border + text + border)
   305 = 0005			.def	QUIT_WIN_H						= 5		; rows        (border + text + hint + border, +1)
   306
   307 				; BCB field byte offsets
   308 = 0000			.def	Src_Adr0						= $00
   309 = 0001			.def	Src_Adr1						= $01
   310 = 0002			.def	Src_Adr2						= $02
   311 = 0006			.def	Dest_Adr0						= $06
