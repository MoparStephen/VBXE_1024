  1362 				;-----------------------------------------------------------------------------
  1363 				; Increment_Image - advance File_Index within the *.V1K file band
  1364 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1365 				; No-op when the list holds no files.  (The selector list may now also carry
  1366 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1367 				;-----------------------------------------------------------------------------
  1368 38B8			Increment_Image
  1369 38B8 AD DA 04			lda FileStart
  1370 38BB CD 8B 04			cmp ImageCount
  1371 38BE B0 12			bcs Increment_Image_Done			; no *.V1K files in the list
  1372 38C0 AE 8A 04			ldx File_Index
  1373 38C3 E8				inx
  1374 38C4 EC 8B 04			cpx ImageCount
  1375 38C7 90 03			bcc Increment_Image_Store
  1376 38C9 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1377 38CC			Increment_Image_Store
  1378 38CC 8E 8A 04			stx File_Index
  1379 38CF 20 0E 34			jsr Load_Image
  1380 38D2			Increment_Image_Done
  1381 38D2 60				rts
  1382
  1383 				;-----------------------------------------------------------------------------
  1384 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1385 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1386 				;-----------------------------------------------------------------------------
  1387 38D3			Decrement_Image
  1388 38D3 AD DA 04			lda FileStart
  1389 38D6 CD 8B 04			cmp ImageCount
  1390 38D9 B0 12			bcs Decrement_Image_Done
  1391 38DB AE 8A 04			ldx File_Index
  1392 38DE EC DA 04			cpx FileStart
  1393 38E1 D0 03			bne Decrement_Image_Step
  1394 38E3 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1395 38E6			Decrement_Image_Step
  1396 38E6 CA				dex
  1397 38E7 8E 8A 04			stx File_Index
  1398 38EA 20 0E 34			jsr Load_Image
  1399 38ED			Decrement_Image_Done
  1400 38ED 60				rts
