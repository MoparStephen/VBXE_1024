  1296 58D9 A0 08			ldy #$08
  1297 58DB A9 20			lda #' '
  1298 58DD 99 CD 04			sta Name_Row_Buf,y
  1299 58E0 C8				iny
  1300 58E1 99 CD 04			sta Name_Row_Buf,y
  1301 58E4 C8				iny
