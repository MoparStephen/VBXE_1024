  2115 5E1D 20 F9 34			jsr Read_Image_Palette				; .PAL block -> $21000, registers untouched
  2116 5E20 90 03			bcc Selector_Handle_P_Loaded
  2117 5E22 4C 01 55			jmp Selector_Restore_LocRow			; failed - selector stays up (tail)
  2118
  2119 5E25			Selector_Handle_P_Loaded
  2120 5E25 20 AE 3A			jsr Set_Attr_Source_Preview			; prebuilt at boot (Pal_Preview_Init)
  2121 5E28 20 E5 34			jsr Display_Off						; blank while the registers change
  2122 5E2B 20 0C 35			jsr Apply_Image_Palette				; sets Pal_Image -> Enter_Selector restores
