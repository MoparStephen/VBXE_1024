  2610 5E6D CA				dex									; step onto the trailing '>'
  2611 5E6E			Path_Pop_L1
  2612 5E6E E0 00			cpx #$00
  2613 5E70 F0 09			beq Path_Pop_Cut
  2614 5E72 CA				dex
  2615 5E73 BD 28 06			lda Scan_Path,x
  2616 5E76 C9 3E			cmp #'>'
  2617 5E78 D0 F4			bne Path_Pop_L1
  2618 5E7A E8				inx									; keep this separator
  2619 5E7B			Path_Pop_Cut
  2620 5E7B A9 00			lda #$00
  2621 5E7D 9D 28 06			sta Scan_Path,x
