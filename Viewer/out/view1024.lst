  2486 5D36 85 88			sta Ptr_Lo
  2487 5D38 A9 20			lda #>VBXE_WINDOW
  2488 5D3A 85 89			sta Ptr_Hi
  2489 5D3C			Info_Count_L1
  2490 5D3C A0 00			ldy #$00
  2491 5D3E B1 88			lda (Ptr_Lo),y
  2492 5D40 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2493 5D42 EE DE 04			inc Nfo_LineCount
  2494 5D45 AD DE 04			lda Nfo_LineCount
  2495 5D48 C9 7F			cmp #NFO_MAX_LINES
  2496 5D4A B0 24			bcs Info_Count_Done					; hit the record cap
  2497 5D4C A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2498 5D4E 18				clc
  2499 5D4F 69 A0			adc #TEXT_PITCH
  2500 5D51 85 88			sta Ptr_Lo
  2501 5D53 90 E7			bcc Info_Count_L1
  2502 5D55 E6 89			inc Ptr_Hi
  2503 5D57 A5 89			lda Ptr_Hi
  2504 5D59 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2505 5D5B 90 DF			bcc Info_Count_L1
  2506 5D5D E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2507 5D5F 85 89			sta Ptr_Hi
  2508 5D61 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2509 5D64 AD 50 06			lda Nfo_WalkBank
  2510 5D67 09 80			ora #MEMAC_GLOBAL_ENABLE
  2511 5D69				vbsta VBXE_MA_BSEL
