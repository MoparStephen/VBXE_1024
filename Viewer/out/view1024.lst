   233 3BEA A9 00			lda #<TEXT_BACK_VRAM
   234 3BEC 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   235 3BEF A9 A0			lda #>TEXT_BACK_VRAM
   236 3BF1 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   237 3BF4 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   238 3BF6 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   239 3BF9 A9 00			lda #<TEXT_SCREEN_VRAM
   240 3BFB 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   241 3BFE A9 30			lda #>TEXT_SCREEN_VRAM
   242 3C00 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   243 3C03 A9 02			lda #[TEXT_SCREEN_VRAM >> 16]
   244 3C05 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   245 3C08 A9 9F			lda #<[TEXT_PITCH-1]
   246 3C0A 8D 8A 21			sta BLT_TEXT_RECT + Blt_W0			; Width-1  = 159 bytes (80 cells)
   247 3C0D A9 00			lda #>[TEXT_PITCH-1]
   248 3C0F 8D 8B 21			sta BLT_TEXT_RECT + Blt_W1
   249 3C12 A9 16			lda #TEXT_ROWS-1
   250 3C14 8D 8C 21			sta BLT_TEXT_RECT + Blt_H			; Height-1 = every row, both bands
   251 3C17 A9 00			lda #$00
