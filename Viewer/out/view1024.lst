  1631 3A2C B9 8D 04			lda Path_Buf,y
  1632 3A2F 91 8C			sta (Sort_Ptr),y
  1633 3A31 C8				iny
  1634 3A32 C0 08			cpy #$08
  1635 3A34 90 ED			bcc Swap_Records_L1
  1636 3A36 60				rts
