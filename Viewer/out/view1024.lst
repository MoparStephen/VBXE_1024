  2775 				;=============================================================================
  2776 				; Shared directory helpers
  2777 				;-----------------------------------------------------------------------------
  2778 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2779 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2780 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2781 				; navigation lives in the selector itself.
  2782 				;=============================================================================
  2783
  2784 				;-----------------------------------------------------------------------------
  2785 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2786 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2787 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2788 				;-----------------------------------------------------------------------------
  2789 6287			Line_Has_Dir_Tag
  2790 6287 A2 00			ldx #$00
  2791 6289			Line_Has_Dir_Tag_L1
  2792 6289 BD 00 06			lda Dir_Line_Buf,x
  2793 628C C9 3C			cmp #'<'
  2794 628E D0 1F			bne Line_Has_Dir_Tag_Next
  2795 6290 BD 01 06			lda Dir_Line_Buf+1,x
  2796 6293 C9 44			cmp #'D'
  2797 6295 D0 18			bne Line_Has_Dir_Tag_Next
  2798 6297 BD 02 06			lda Dir_Line_Buf+2,x
  2799 629A C9 49			cmp #'I'
  2800 629C D0 11			bne Line_Has_Dir_Tag_Next
  2801 629E BD 03 06			lda Dir_Line_Buf+3,x
  2802 62A1 C9 52			cmp #'R'
  2803 62A3 D0 0A			bne Line_Has_Dir_Tag_Next
  2804 62A5 BD 04 06			lda Dir_Line_Buf+4,x
  2805 62A8 C9 3E			cmp #'>'
  2806 62AA D0 03			bne Line_Has_Dir_Tag_Next
  2807 62AC A9 01			lda #$01							; found
  2808 62AE 60				rts
  2809 62AF			Line_Has_Dir_Tag_Next
  2810 62AF E8				inx
  2811 62B0 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2812 62B2 90 D5			bcc Line_Has_Dir_Tag_L1
  2813 62B4 A9 00			lda #$00							; not found
  2814 62B6 60				rts
