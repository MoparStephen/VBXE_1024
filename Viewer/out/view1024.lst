  2187 				;=============================================================================
  2188 				; Shared directory helpers
  2189 				;-----------------------------------------------------------------------------
  2190 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2191 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2192 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2193 				; navigation lives in the selector itself.
  2194 				;=============================================================================
  2195
  2196 				;-----------------------------------------------------------------------------
  2197 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2198 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2199 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2200 				;-----------------------------------------------------------------------------
  2201 5862			Line_Has_Dir_Tag
  2202 5862 A2 00			ldx #$00
  2203 5864			Line_Has_Dir_Tag_L1
  2204 5864 BD 00 06			lda Dir_Line_Buf,x
  2205 5867 C9 3C			cmp #'<'
  2206 5869 D0 1F			bne Line_Has_Dir_Tag_Next
  2207 586B BD 01 06			lda Dir_Line_Buf+1,x
  2208 586E C9 44			cmp #'D'
  2209 5870 D0 18			bne Line_Has_Dir_Tag_Next
  2210 5872 BD 02 06			lda Dir_Line_Buf+2,x
  2211 5875 C9 49			cmp #'I'
  2212 5877 D0 11			bne Line_Has_Dir_Tag_Next
  2213 5879 BD 03 06			lda Dir_Line_Buf+3,x
  2214 587C C9 52			cmp #'R'
  2215 587E D0 0A			bne Line_Has_Dir_Tag_Next
  2216 5880 BD 04 06			lda Dir_Line_Buf+4,x
  2217 5883 C9 3E			cmp #'>'
  2218 5885 D0 03			bne Line_Has_Dir_Tag_Next
  2219 5887 A9 01			lda #$01							; found
  2220 5889 60				rts
  2221 588A			Line_Has_Dir_Tag_Next
  2222 588A E8				inx
