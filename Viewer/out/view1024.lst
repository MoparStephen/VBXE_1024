   862 52B5 85 97			sta Txt_Ptr + $01
   863 52B7 4C FB 3C			jmp Text_PutStrAt					; the padded name from col 5 (tail)
   864 52BA			Selector_DrawStatus_Blank
   865 52BA A9 14			lda #20
