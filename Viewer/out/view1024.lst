   540 				;=============================================================================
   541 				; Selector screen
   542 				;=============================================================================
   543
   544 				;-----------------------------------------------------------------------------
   545 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   546 				; menu palettes back ONLY if an image replaced them (Pal_Image) or the palette
   547 				; keys switched some off (Pal_Off - a directory P-preview) - after Info, Drive,
   548 				; Quit or an untouched directory P-preview the registers are already right), then
   549 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   550 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   551 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   552 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   553 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   554 				; always returns.
   555 				;-----------------------------------------------------------------------------
   556 53C6			Enter_Selector
   557 53C6 A9 00			lda #$00							; forget the image view's key-5 / 0-3 / P state.
   558 53C8 8D F5 04			sta Map_View						; XDL_Image_Attribute's source is NOT reset here -
   559 53CB 8D F6 04			sta View_Normal						; it may still be on screen (a stale image would
   560 53CE 8D F7 04			sta Preview_From_Image				; flash); View_Selected resets it, unseen
   561 53D1 A9 00			lda #$00
   562 53D3 8D C6 04			sta UI_Mode
   563 53D6 20 68 54			jsr Selector_Draw					; back buffer only - nothing visible yet
   564 53D9 AD E7 04			lda Pal_Image
   565 53DC 0D FB 04			ora Pal_Off							; ...or some switched off on a folder-row P screen
   566 53DF F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   567 53E1 20 E5 34			jsr Display_Off						; blank while the registers are rewritten
   568 53E4 20 42 36			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   569 53E7 20 50 3E			jsr Text_Present
   570 53EA 20 2E 3E			jsr Text_Activate
   571 53ED 4C EF 34			jmp Display_On						; (tail)
   572 53F0			Enter_Selector_Show
   573 53F0 20 50 3E			jsr Text_Present					; the finished screen, in one blit
   574 53F3 4C 2E 3E			jmp Text_Activate					; (tail) a pure XDL swap
   575
   576 				;-----------------------------------------------------------------------------
   577 				; UI_Build_TextPalette - the standard Atari 256-colour master (NTSC $00200 /
   578 				; PAL $00500, per Video_Flag) has its entries 0-127 in hues 0-7 only (no
   579 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   580 				; De-interleave it so:
   581 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   582 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   583 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   584 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   585 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   586 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   587 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   588 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   589 				;-----------------------------------------------------------------------------
   590 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   591
   592 53F6			UI_Build_TextPalette
   593 53F6 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   594 53F8				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 53F8 A0 5F			ldy #<VBXE_MA_BSEL
     3 53FA 91 93			sta (VBXEBase),y
Source: ui.asm
   595
   596 				; --- pass 1: even master colours -> buf[0..127]
   597 53FC 20 2A 54			jsr UI_Apply_TP_SrcBase
   598 53FF A9 00			lda #<UI_APPLY_TP_BUF
   599 5401 85 8A			sta Name_Ptr
   600 5403 A9 28			lda #>UI_APPLY_TP_BUF
   601 5405 85 8B			sta Name_Ptr+1
   602 5407 20 41 54			jsr UI_Apply_TP_Pass
   603
   604 				; --- pass 2: odd master colours -> buf[128..255]
   605 540A 20 2A 54			jsr UI_Apply_TP_SrcBase
   606 540D A5 88			lda Ptr_Lo
   607 540F 18				clc
