  1603 				;-----------------------------------------------------------------------------
  1604 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1605 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1606 				; equal) otherwise.
  1607 				;-----------------------------------------------------------------------------
  1608 3A13			Cmp_Records
  1609 3A13 A0 00			ldy #$00
  1610 3A15			Cmp_Records_L1
  1611 3A15 B1 8A			lda (Name_Ptr),y
  1612 3A17 D1 8C			cmp (Sort_Ptr),y
  1613 3A19 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1614 3A1B C8				iny
  1615 3A1C C0 08			cpy #$08
  1616 3A1E 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1617 3A20			Cmp_Records_Done
  1618 3A20 60				rts
