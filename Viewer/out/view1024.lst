  1746 				; Build_Filename
  1747 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1748 				;       File_Index = image ordinal
  1749 				;  Out: FileNamePtr -> Path_Buf holding
  1750 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1751 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1752 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1753 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1754 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1755 				;-----------------------------------------------------------------------------
