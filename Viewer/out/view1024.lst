  1049 				;-----------------------------------------------------------------------------
  1050 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1051 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1052 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1053 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1054 				;-----------------------------------------------------------------------------
  1055 5418			Nfo_Name_MapSlot
  1056 5418 AD E1 04			lda Nfo_Name_Ord
  1057 541B 4A				lsr									; C = Ord & 1
  1058 541C A9 00			lda #$00
  1059 541E 6A				ror									; A = (Ord & 1) << 7
  1060 541F 85 88			sta Ptr_Lo
  1061 5421 AD E1 04			lda Nfo_Name_Ord
  1062 5424 4A				lsr
  1063 5425 29 0F			and #$0F							; (Ord >> 1) & 15
  1064 5427 18				clc
  1065 5428 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1066 542A 85 89			sta Ptr_Hi
  1067 542C AD E1 04			lda Nfo_Name_Ord
  1068 542F 4A				lsr
  1069 5430 4A				lsr
  1070 5431 4A				lsr
  1071 5432 4A				lsr
  1072 5433 4A				lsr									; Ord >> 5  (0..7)
  1073 5434 18				clc
  1074 5435 69 37			adc #NFO_NAME_BANK
  1075 5437 09 80			ora #MEMAC_GLOBAL_ENABLE
  1076 5439				vbsta VBXE_MA_BSEL
