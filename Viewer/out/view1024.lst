   938 				; Attribute-cell byte offsets (within a 160-byte expanded map row) for the 8
   939 				; columns the demo overlay covers - cell*4+3 (the real attribute byte; the
   940 				; other 3 bytes/cell are always zero - the whole map is zeroed at boot by
   941 				; clear_vbxe).  Left-edge block = cells 0-3 (pixels 0-31); right-edge block = cells
   942 				; 36-39 (pixels 288-319, since MENU_BANNER_PITCH/8 = 40 cells/row).
   943 35F9			Menu_Demo_Attr_Cols
   944 35F9 03 07 0B 0F 93 97 + 	dta 3,7,11,15,147,151,155,159
   945 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
   946 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
   947 				; copy reads as a flipped reflection of the left-hand one; the underlying
   948 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
   949 				; register each cell points at changes.
   950 3601			Menu_Demo_Attr_Top_Vals
   951 3601 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
   952 				; Same column order: BL/BR pal ids (<<4), left edge then right edge (mirrored:
   953 				; pal 3,2 instead of 2,3 - see note above).
   954 3609			Menu_Demo_Attr_Bot_Vals
   955 3609 20 20 30 30 30 30 + 	dta $20,$20,$30,$30,$30,$30,$20,$20
