  1053 				;-----------------------------------------------------------------------------
  1054 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1055 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1056 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1057 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1058 				;-----------------------------------------------------------------------------
  1059 56C1			Nfo_Name_MapSlot
  1060 56C1 AD E1 04			lda Nfo_Name_Ord
  1061 56C4 4A				lsr									; C = Ord & 1
  1062 56C5 A9 00			lda #$00
