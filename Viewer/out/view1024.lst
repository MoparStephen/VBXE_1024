  1436 				; Build_Filename
  1437 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1438 				;       File_Index = image ordinal
  1439 				;  Out: FileNamePtr -> Path_Buf holding
  1440 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1441 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1442 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1443 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1444 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1445 				;-----------------------------------------------------------------------------
