  2438 				;-----------------------------------------------------------------------------
  2439 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2440 				;-----------------------------------------------------------------------------
  2441 5CC6			Path_Pop_Segment
  2442 5CC6 A2 00			ldx #$00
  2443 5CC8			Path_Pop_End
  2444 5CC8 BD 28 06			lda Scan_Path,x
