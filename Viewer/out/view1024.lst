   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3EA9			Text_Window_Save
   393 3EA9 20 FC 3E			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3EAC A5 83			lda Reg4
   395 3EAE 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3EB1 A5 84			lda Reg5
   397 3EB3 18				clc
   398 3EB4 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3EB6 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3EB9 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3EBB 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3EBE A9 00			lda #<WIN_SAVE_VRAM
   403 3EC0 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3EC3 A9 F0			lda #>WIN_SAVE_VRAM
   405 3EC5 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3EC8 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3ECA 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3ECD 4C 3C 3F			jmp Text_Window_Kick
   409
   410 3ED0			Text_Window_Restore
   411 3ED0 A9 01			lda #$01
   412 3ED2 8D B7 06			sta Txt_Dirty
   413 3ED5 20 FC 3E			jsr Text_Window_Setup
   414 3ED8 A9 00			lda #<WIN_SAVE_VRAM
   415 3EDA 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3EDD A9 F0			lda #>WIN_SAVE_VRAM
   417 3EDF 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3EE2 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3EE4 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3EE7 A5 83			lda Reg4
   421 3EE9 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3EEC A5 84			lda Reg5
   423 3EEE 18				clc
   424 3EEF 69 A0			adc #>TEXT_BACK_VRAM
   425 3EF1 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3EF4 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3EF6 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3EF9 4C 3C 3F			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3EFC			Text_Window_Setup
   433 3EFC A9 00			lda #$00
   434 3EFE 85 83			sta Reg4
   435 3F00 85 84			sta Reg5
   436 3F02 AE B0 06			ldx Txt_Row
   437 3F05 F0 0E			beq Text_Window_Setup_Col
   438 3F07			Text_Window_Setup_RowL
   439 3F07 A5 83			lda Reg4
   440 3F09 18				clc
