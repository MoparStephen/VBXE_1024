  2027 5817 C6 83			dec Reg4							; Reg4 = height-1
  2028 5819 4C 20 58			jmp Info_Draw_Blit
  2029 581C			Info_Draw_Full
  2030 581C A9 13			lda #NFO_VISROWS-1
  2031 581E 85 83			sta Reg4
  2032 5820			Info_Draw_Blit
  2033 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2034 5820 A9 00			lda #$00
