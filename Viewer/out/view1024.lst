   541 				;=============================================================================
   542 				; Selector screen
   543 				;=============================================================================
   544
   545 				;-----------------------------------------------------------------------------
   546 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   547 				; menu palettes back ONLY if an image replaced them (Pal_Image) or the palette
   548 				; keys switched some off (Pal_Off - a directory P-preview) - after Info, Drive,
   549 				; Quit or an untouched directory P-preview the registers are already right), then
   550 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   551 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   552 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   553 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   554 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   555 				; always returns.
   556 				;-----------------------------------------------------------------------------
   557 53CF			Enter_Selector
   558 53CF A9 00			lda #$00							; forget the image view's M / 0-3 / P state.
   559 53D1 8D F5 04			sta Map_View						; XDL_Image_Attribute's source is NOT reset here -
   560 53D4 8D F6 04			sta View_Normal						; it may still be on screen (a stale image would
   561 53D7 8D F7 04			sta Preview_From_Image				; flash); View_Selected resets it, unseen
   562 53DA A9 00			lda #$00
   563 53DC 8D C6 04			sta UI_Mode
   564 53DF 20 63 54			jsr Selector_Draw					; back buffer only - nothing visible yet
   565 53E2 AD E7 04			lda Pal_Image
   566 53E5 0D FB 04			ora Pal_Off							; ...or some switched off on a folder-row P screen
   567 53E8 F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   568 53EA 20 E5 34			jsr Display_Off						; blank while the registers are rewritten
   569 53ED 20 42 36			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   570 53F0 20 59 3E			jsr Text_Present
   571 53F3 20 37 3E			jsr Text_Activate
   572 53F6 4C EF 34			jmp Display_On						; (tail)
   573 53F9			Enter_Selector_Show
   574 53F9 20 59 3E			jsr Text_Present					; the finished screen, in one blit
   575 53FC 4C 37 3E			jmp Text_Activate					; (tail) a pure XDL swap
   576
   577 				;-----------------------------------------------------------------------------
   578 				; UI_Build_TextPalette - the standard Atari 256-colour master (always the PAL
   579 				; one at $00500, even on NTSC - the UI colours were chosen on PAL, and some
   580 				; look wrong in the NTSC master) has its entries 0-127 in hues 0-7 only (no
   581 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   582 				; De-interleave it so:
   583 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   584 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   585 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   586 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   587 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   588 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   589 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   590 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   591 				;-----------------------------------------------------------------------------
   592 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   593
   594 53FF			UI_Build_TextPalette
   595 53FF A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   596 5401				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5401 A0 5F			ldy #<VBXE_MA_BSEL
     3 5403 91 93			sta (VBXEBase),y
Source: ui.asm
   597
   598 				; --- pass 1: even master colours -> buf[0..127]
   599 5405 20 33 54			jsr UI_Apply_TP_SrcBase
