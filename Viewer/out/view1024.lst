Source: text80.asm
     1 				;=============================================================================
     2 				; text80.asm  -  VBXE 80-column text screen for the viewer UI
     3 				;-----------------------------------------------------------------------------
     4 				; VBXE FX *hardware text mode* (XDLC_TMON + XDLC_CHBASE + XDLC_ATT), ported from
     5 				; VBXE_APOD (ASM Samples/Mockup1 - Load_Font / the XDL text block; Mockup2's
     6 				; Load_Text_Print_Error_L1 string writer and Set_Status_Colour).
     7 				;
     8 				; The 2048-byte IBM CGA font (CGA.F08: 256 x 8x8 1bpp, code page 437 order -
     9 				; glyph index = raw ASCII byte, NO ATASCII remap) is streamed from disk into
    10 				; VRAM at TEXT_FONT_VRAM; the XDL's CHBASE points at it.  "Drawing text" = poking
    11 				; a {glyph, colour} byte pair per cell into the XDL's screen RAM
    12 				; (TEXT_SCREEN_VRAM) through the $2000 MEMAC window.  No glyph rasteriser, no
    13 				; bit-depth expansion.
    14 				;
    15 				; The colour byte: bits 0-6 select the palette entry (0-127) for the character;
    16 				; bit 7 = 0 -> transparent background, 1 -> opaque/coloured background.
    17 				;
    18 				; TEXT_FONT_VRAM / TEXT_SCREEN_VRAM / TEXT_PITCH / TEXT_CHBASE live in
    19 				; view1024.asm's .def block and are shared with XDL_MainMenu (xdl.asm) so the
    20 				; two halves cannot drift.
    21 				;
    22 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register hit goes through
    23 				; vbsta / vblda; writes to VBXE_WINDOW ($2000..$2FFF) are plain stores (real
    24 				; memory - the mapped MEMAC window).  vbsta clobbers Y in auto mode: no live Y
    25 				; is held across one below.
    26 				;
    27 				; PUBLIC API (called by ui.asm):
    28 				;   Text_Init        stream CGA.F08 into VRAM once; blank the screen RAM.
    29 				;   Text_Activate    point VBXE_XDL_ADR0/1/2 at XDL_MainMenu.
    30 				;   Text_Deactivate  point them back at XDL_Image_Attribute (offset 0).
    31 				;   Text_Clear       blitter zero-fill of the 80 x TEXT_ROWS cells (blank +
    32 				;                    transparent) - ONE contiguous buffer backing both the
    33 				;                    XDL's main-content and footer text bands, see xdl.asm.
    34 				;   Text_FillColour  blitter recolour of a cell rectangle: Txt_Row/Txt_Col =
    35 				;                    top-left, Reg1 = width-1 (cells), Reg2 = height-1 (rows),
    36 				;                    A = attribute byte.  Floods the attribute bytes only.
    37 				;   Text_SetPen      A = fg palette entry (0-127), X = bg (0 transparent /
    38 				;                    non-zero opaque)  -> Make_Attr -> Txt_Attr.
    39 				;   Text_PutStrAt    draw the $00-terminated ASCII string at Txt_Ptr, from cell
    40 				;                    (Txt_Col, Txt_Row).
    41 				;
    42 				; INPUT VARIABLES (set by ui.asm before the call):
    43 				;   Txt_Row .byte  0..(TEXT_ROWS-1)    Txt_Col .byte  0..79    Txt_Ptr .word  -> string
    44 				;=============================================================================
    45
    46 				; --- placeholder tuning knobs (Stephen finalises with Make_Attr / the XDL) ---
    47 = 000F			.def	TEXT_DEF_FG		= $0F			; default foreground (palette 0 index)
    48 = 0000			.def	TEXT_DEF_BG		= $00			; default background
    49
    50 3A6F			.zpvar	Txt_Ptr			.word			; -> the string Text_PutStrAt is drawing
    51 3A6F			.var	Txt_Row			.byte = $6B0
    52 3A6F			.var	Txt_Col			.byte = $6B1
    53 3A6F			.var	Txt_Fg			.byte = $6B2
    54 3A6F			.var	Txt_Bg			.byte = $6B3
    55 3A6F			.var	Txt_Attr		.byte = $6B4	; current pen, as one cell attribute byte
    56 				;	$6B5 free  (was Txt_ClearAttr - the blitter Text_Clear zero-fills, no attr byte)
    57 3A6F			.var	Txt_Bank		.byte = $6B6	; VBXE bank currently mapped by the cell writer
    58 				;	$6B7 to $6FF free
    59
    60 				;-----------------------------------------------------------------------------
    61 				; Text_Init - default pen, load the font, blank the screen.  Called once.
    62 				;-----------------------------------------------------------------------------
    63 3A6F			Text_Init
    64 3A6F A9 0F			lda #TEXT_DEF_FG
    65 3A71 A2 00			ldx #TEXT_DEF_BG
    66 3A73 20 03 3B			jsr Text_SetPen						; sets Txt_Attr
    67
    68 3A76 20 7C 3A			jsr Text_Load_Fonts					; embedded CGA.F08 + ATARI.F08 -> VRAM bank $22
    69 3A79 4C 1D 3B			jmp Text_Clear						; blank the screen RAM, then rts
    70
    71 				;-----------------------------------------------------------------------------
    72 				; Text_Load_Fonts - copy both embedded 2048-byte fonts into VRAM bank
    73 				; TEXT_FONT_BANK ($22) through the $2000 window: CGA.F08 -> $022000 (CHBASE
    74 				; $44), ATARI.F08 -> $022800 (CHBASE $45).  Fonts are embedded rather than
    75 				; streamed from disk so the viewer never depends on a font file being on
    76 				; whatever disk it happens to boot from.  F (Handle_Keys) flips XDL_MainMenu's
    77 				; two CHBASE bytes (main + footer text blocks) between the two.
    78 				;-----------------------------------------------------------------------------
    79 3A7C			Text_Load_Fonts
    80 3A7C A9 A2			lda #TEXT_FONT_BANK | MEMAC_GLOBAL_ENABLE
    81 3A7E				vbsta VBXE_MA_BSEL					; map VRAM bank $22 into $2000-$2FFF
Macro: VBSTA [Source: vbxe_min.asm]
