    96 3A2C 85 89			sta Ptr_Hi
    97 3A2E A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3A30 85 80			sta Reg1
    99 3A32 A9 20			lda #>VBXE_WINDOW
   100 3A34 85 81			sta Reg2
   101 3A36 20 A8 3A			jsr Text_Copy_2K
   102
   103 3A39 A9 0A			lda #<Atari_Font_Data
   104 3A3B 85 88			sta Ptr_Lo
   105 3A3D A9 46			lda #>Atari_Font_Data
   106 3A3F 85 89			sta Ptr_Hi
   107 3A41 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3A43 85 80			sta Reg1
   109 3A45 A9 28			lda #>[VBXE_WINDOW + $800]
   110 3A47 85 81			sta Reg2
   111 3A49 20 A8 3A			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3A4C A2 00			ldx #$00
   120 3A4E			Text_Load_Fonts_Remap
   121 3A4E BD 88 3A			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3A51 20 78 3A			jsr Text_Glyph_Addr
   123 3A54 85 88			sta Ptr_Lo
   124 3A56 84 89			sty Ptr_Hi
   125 3A58 BD 89 3A			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3A5B 20 78 3A			jsr Text_Glyph_Addr
   127 3A5E 85 80			sta Reg1
   128 3A60 84 81			sty Reg2
   129 3A62 A0 07			ldy #$07
   130 3A64			Text_Load_Fonts_Glyph
   131 3A64 B1 88			lda (Ptr_Lo),y
   132 3A66 91 80			sta (Reg1),y
   133 3A68 88				dey
   134 3A69 10 F9			bpl Text_Load_Fonts_Glyph
   135 3A6B E8				inx
   136 3A6C E8				inx
   137 3A6D E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3A6F D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3A71 A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3A73				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3A73 A0 5F			ldy #<VBXE_MA_BSEL
     3 3A75 91 93			sta (VBXEBase),y
Source: text80.asm
   142 3A77 60				rts
   143
   144 				; A = glyph code -> A/Y = lo/hi of that glyph's 8 bytes in the Atari font, as
   145 				; mapped at VBXE_WINDOW + $800.  X preserved.
   146 3A78			Text_Glyph_Addr
   147 3A78 A0 05			ldy #>[[VBXE_WINDOW + $800] / 8]	; = $05 - becomes $28 after the x8 below
   148 3A7A 84 82			sty Reg3
   149 3A7C 0A				asl
   150 3A7D 26 82			rol Reg3
   151 3A7F 0A				asl
   152 3A80 26 82			rol Reg3
   153 3A82 0A				asl
   154 3A83 26 82			rol Reg3							; Reg3:A = $2800 + code*8
   155 3A85 A4 82			ldy Reg3
   156 3A87 60				rts
   157
   158 				; {source, destination} glyph pairs, applied in order.  Box lines first: $1A
   159 				; (ATASCII Ctrl-Z corner) is read here before the arrows overwrite it.
   160 				; CP437 double and single box sets both map onto the Atari single-line set.
   161 3A88			Atari_Remap_Table
   162 3A88 11 C9 12 CD 05 BB + 	dta $11,$C9, $12,$CD, $05,$BB, $7C,$BA, $1A,$C8, $03,$BC	; double: TL - TR | BL BR
   163 3A94 11 DA 12 C4 05 BF + 	dta $11,$DA, $12,$C4, $05,$BF, $7C,$B3, $1A,$C0, $03,$D9	; single: TL - TR | BL BR
   164 3AA0 1C 18 1D 19 1E 1B + 	dta $1C,$18, $1D,$19, $1E,$1B, $1F,$1A						; arrows: up down left right
   165 3AA8			Atari_Remap_Table_End
   166
   167 				; Copy 2048 bytes (Ptr_Lo/Hi) -> (Reg1/Reg2), 8 pages.
   168 3AA8			Text_Copy_2K
   169 3AA8 A2 08			ldx #$08
   170 3AAA A0 00			ldy #$00
   171 3AAC			Text_Copy_2K_L1
   172 3AAC B1 88			lda (Ptr_Lo),y
   173 3AAE 91 80			sta (Reg1),y
   174 3AB0 C8				iny
   175 3AB1 D0 F9			bne Text_Copy_2K_L1
   176 3AB3 E6 89			inc Ptr_Hi
   177 3AB5 E6 81			inc Reg2
   178 3AB7 CA				dex
   179 3AB8 D0 F2			bne Text_Copy_2K_L1
   180 3ABA 60				rts
