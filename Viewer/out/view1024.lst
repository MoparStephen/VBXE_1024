  2504 				;=============================================================================
  2505 				; Shared directory helpers
  2506 				;-----------------------------------------------------------------------------
  2507 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2508 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2509 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2510 				; navigation lives in the selector itself.
  2511 				;=============================================================================
  2512
  2513 				;-----------------------------------------------------------------------------
  2514 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2515 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2516 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2517 				;-----------------------------------------------------------------------------
  2518 5D1B			Line_Has_Dir_Tag
  2519 5D1B A2 00			ldx #$00
  2520 5D1D			Line_Has_Dir_Tag_L1
  2521 5D1D BD 00 06			lda Dir_Line_Buf,x
  2522 5D20 C9 3C			cmp #'<'
  2523 5D22 D0 1F			bne Line_Has_Dir_Tag_Next
  2524 5D24 BD 01 06			lda Dir_Line_Buf+1,x
  2525 5D27 C9 44			cmp #'D'
  2526 5D29 D0 18			bne Line_Has_Dir_Tag_Next
  2527 5D2B BD 02 06			lda Dir_Line_Buf+2,x
  2528 5D2E C9 49			cmp #'I'
  2529 5D30 D0 11			bne Line_Has_Dir_Tag_Next
  2530 5D32 BD 03 06			lda Dir_Line_Buf+3,x
  2531 5D35 C9 52			cmp #'R'
  2532 5D37 D0 0A			bne Line_Has_Dir_Tag_Next
  2533 5D39 BD 04 06			lda Dir_Line_Buf+4,x
  2534 5D3C C9 3E			cmp #'>'
  2535 5D3E D0 03			bne Line_Has_Dir_Tag_Next
  2536 5D40 A9 01			lda #$01							; found
  2537 5D42 60				rts
  2538 5D43			Line_Has_Dir_Tag_Next
  2539 5D43 E8				inx
  2540 5D44 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2541 5D46 90 D5			bcc Line_Has_Dir_Tag_L1
  2542 5D48 A9 00			lda #$00							; not found
  2543 5D4A 60				rts
  2544
  2545 				;-----------------------------------------------------------------------------
  2546 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2547 				; space-padded).  Refuses if the result would not fit.
  2548 				;-----------------------------------------------------------------------------
  2549 5D4B			Folder_Path_Push
  2550 5D4B A2 00			ldx #$00
  2551 5D4D			Folder_Path_Push_End
  2552 5D4D BD 28 06			lda Scan_Path,x
  2553 5D50 F0 06			beq Folder_Path_Push_Name
  2554 5D52 E8				inx
  2555 5D53 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2556 5D55 90 F6			bcc Folder_Path_Push_End
  2557 5D57 60				rts									; path too long already - refuse
  2558 5D58			Folder_Path_Push_Name
  2559 5D58 A0 00			ldy #$00
  2560 5D5A			Folder_Path_Push_L1
  2561 5D5A B9 CD 04			lda Name_Row_Buf,y
  2562 5D5D F0 0D			beq Folder_Path_Push_Sep
  2563 5D5F C9 20			cmp #' '
  2564 5D61 F0 09			beq Folder_Path_Push_Sep
  2565 5D63 9D 28 06			sta Scan_Path,x
  2566 5D66 E8				inx
  2567 5D67 C8				iny
  2568 5D68 C0 08			cpy #$08
  2569 5D6A 90 EE			bcc Folder_Path_Push_L1
  2570 5D6C			Folder_Path_Push_Sep
  2571 5D6C A9 3E			lda #'>'
  2572 5D6E 9D 28 06			sta Scan_Path,x
  2573 5D71 E8				inx
  2574 5D72 A9 00			lda #$00
  2575 5D74 9D 28 06			sta Scan_Path,x
  2576 5D77 60				rts
  2577
  2578 				;-----------------------------------------------------------------------------
  2579 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2580 				;-----------------------------------------------------------------------------
  2581 5D78			Path_Pop_Segment
  2582 5D78 A2 00			ldx #$00
  2583 5D7A			Path_Pop_End
  2584 5D7A BD 28 06			lda Scan_Path,x
  2585 5D7D F0 05			beq Path_Pop_Found
  2586 5D7F E8				inx
  2587 5D80 E0 28			cpx #$28
  2588 5D82 90 F6			bcc Path_Pop_End
  2589 5D84			Path_Pop_Found							; X = index of the NUL
  2590 5D84 E0 00			cpx #$00
  2591 5D86 F0 13			beq Path_Pop_Done					; already empty
  2592 5D88 CA				dex									; step onto the trailing '>'
  2593 5D89			Path_Pop_L1
  2594 5D89 E0 00			cpx #$00
  2595 5D8B F0 09			beq Path_Pop_Cut
  2596 5D8D CA				dex
  2597 5D8E BD 28 06			lda Scan_Path,x
  2598 5D91 C9 3E			cmp #'>'
  2599 5D93 D0 F4			bne Path_Pop_L1
  2600 5D95 E8				inx									; keep this separator
  2601 5D96			Path_Pop_Cut
  2602 5D96 A9 00			lda #$00
  2603 5D98 9D 28 06			sta Scan_Path,x
  2604 5D9B			Path_Pop_Done
  2605 5D9B 60				rts
  2606
  2607 				;=============================================================================
  2608 				; UI strings  (ATASCII; the text renderer maps to internal codes)
  2609 				;=============================================================================
  2610 				; TXT_PEN,<pen> switches colour mid-string and takes no column (text80.asm),
  2611 				; so these lay out exactly as their plain text.
  2612 5D9C 4C 6F 63 61 74 69 + UI_Str_Loc			dta c'Location: ',0	; drawn in UI_PEN_LOC, the same pen as the path
  2613 5DA7 01 1B 2A 20 4E 6F + UI_Str_Empty		dta TXT_PEN,UI_PEN_EMPTY,c'* No images *',0
  2614 				; Status panel rows 20-22: each starts with a 3-letter tag + ':' in UI_PEN_LOC.
  2615 				; Row 21 = "Cfg:" (col 0) + the delay (cols 5-6) + UI_Str_DelayHint (col 7);
  2616 				; row 22 = UI_Str_Legend (col 0).  Both rows are exactly 80 cells.
  2617 5DB7 01 7C 43 66 67 3A + UI_Str_Delay		dta TXT_PEN,UI_PEN_LOC,c'Cfg:',0
  2618 5DBE 01 3A 20 73 65 63 + UI_Str_DelayHint	dta TXT_PEN,UI_PEN_VALUE,c' sec '
  2619 5DC5 01 43 3C 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'<',TXT_PEN,UI_PEN_DESC,c' Less '
  2620 5DD0 01 43 3E 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'>',TXT_PEN,UI_PEN_DESC,c' More                  Press '
  2621 5DF2 01 43 48 45 4C 50 + 					dta TXT_PEN,UI_PEN_KEY,c'HELP',TXT_PEN,UI_PEN_DESC,c' for additional information',0
  2622 5E16 01 7C 4E 61 76 3A + UI_Str_Legend		dta TXT_PEN,UI_PEN_LOC,c'Nav: ',TXT_PEN,UI_PEN_KEY
  2623 5E1F 55 44 4C 52		UI_Legend_Arrows	dta c'UDLR'							; patched per font - Selector_DrawLegend
  2624 5E23 01 3A 20 53 65 6C + 					dta TXT_PEN,UI_PEN_DESC,c' Select '
  2625 5E2D 01 43 45 6E 74 65 + 					dta TXT_PEN,UI_PEN_KEY,c'Enter',TXT_PEN,UI_PEN_DESC,c' Choose '
  2626 5E3E 01 43 53 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'S',TXT_PEN,UI_PEN_DESC,c' Slideshow '
  2627 5E4E 01 43 44 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'D',TXT_PEN,UI_PEN_DESC,c' Drive '
  2628 5E5A 01 43 50 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'P',TXT_PEN,UI_PEN_DESC,c' Palette '
  2629 5E68 01 43 49 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'I',TXT_PEN,UI_PEN_DESC,c' Info '
  2630 5E73 01 43 46 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'F',TXT_PEN,UI_PEN_DESC,c' Font '
  2631 5E7E 01 43 51 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'Q',TXT_PEN,UI_PEN_DESC,c' Quit',0
  2632 				; Info screen row 22 (col 0, 80 cells) - same scheme as UI_Str_Legend; the two
  2633 				; arrow pairs are patched per font by Info_DrawFooter.
  2634 5E89 01 7C 4E 61 76 3A + UI_Str_InfoHint		dta TXT_PEN,UI_PEN_LOC,c'Nav: ',TXT_PEN,UI_PEN_KEY,c'ESC'
  2635 5E95 01 3A 20 47 6F 20 + 					dta TXT_PEN,UI_PEN_DESC,c' Go Back ',TXT_PEN,UI_PEN_KEY
  2636 5EA2 55 44 01 3A 20 73 + UI_InfoHint_UD		dta c'UD',TXT_PEN,UI_PEN_DESC,c' scroll ',TXT_PEN,UI_PEN_KEY
  2637 5EB0 4C 52 01 3A 20 50 + UI_InfoHint_LR		dta c'LR',TXT_PEN,UI_PEN_DESC,c' Page         Press '
  2638 5EC8 01 43 48 45 4C 50 + 					dta TXT_PEN,UI_PEN_KEY,c'HELP',TXT_PEN,UI_PEN_DESC,c' for additional information',0
  2639 5EEC 4C 6F 67 20 44 72 + UI_Str_DriveTitle	dta c'Log Drive',0
  2640 5EF6 01 3B 41 72 65 20 + UI_Str_QuitConfirm	dta TXT_PEN,UI_PEN_QUITQ,c'Are You Sure To Quit',0
  2641 5F0D 01 5B 59 00		UI_Str_QuitYes		dta TXT_PEN,UI_PEN_YES,c'Y',0
  2642 5F11 01 13 4E 00		UI_Str_QuitNo		dta TXT_PEN,UI_PEN_NO,c'N',0
  2643 5F15 01 7C 4E 66 6F 3A + UI_Str_Nfo			dta TXT_PEN,UI_PEN_LOC,c'Nfo:',TXT_PEN,UI_PEN_VALUE,c' ',0
  2644 5F1F 20 20 20 20 20 20 + UI_Str_StatusBlank	dta c'                                                                                ',0	; 80 spaces (Nfo: + NFO_NAME_CAP)
  2645 5F70 53 63 61 6E 6E 69 + UI_Str_Scanning		dta c'Scanning directory...',0
  2646 5F86 20 6F 66 20 00	UI_Str_Of			dta c' of ',0
  2647 5F8B 20 69 6D 61 67 65 + UI_Str_Images		dta c' images',0
  2648 5F93 20 69 6D 61 67 65 + UI_Str_Image1		dta c' image ',0
  2649
  2650 				;-----------------------------------------------------------------------------
  2651 				; Sel_ColX - screen column for grid column c (0..UI_COLS-1), 10-char cells.
  2652 				; Indexed by (list index AND [UI_COLS-1]).  Relocate the whole grid by
  2653 				; changing UI_GRIDCOL0 alone.
  2654 				;-----------------------------------------------------------------------------
  2655 5F9B 00 0A 14 1E		Sel_ColX	dta UI_GRIDCOL0+0, UI_GRIDCOL0+10, UI_GRIDCOL0+20, UI_GRIDCOL0+30
  2656 5F9F 28 32 3C 46					dta UI_GRIDCOL0+40, UI_GRIDCOL0+50, UI_GRIDCOL0+60, UI_GRIDCOL0+70
  1680
