  1412 				;-----------------------------------------------------------------------------
  1413 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1414 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1415 				; crosses the visible window, else just re-colours the old and new cells;
  1416 				; always repaints the status line, then returns to the key loop.
  1417 				;-----------------------------------------------------------------------------
  1418 5605			Sel_Nav_Apply
  1419 5605 48				pha									; stash the new index
  1420 5606 AD C7 04			lda Sel_Index
  1421 5609 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1422 560B 68				pla
  1423 560C 8D C7 04			sta Sel_Index
  1424 560F 20 31 56			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1425 5612 CD C8 04			cmp Sel_Top
  1426 5615 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1427 5617 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1428 561A 20 08 51			jsr Selector_DrawList
  1429 561D 4C 2B 56			jmp Sel_Key_Nav_Done
  1430 5620			Sel_Nav_Apply_Rows
  1431 5620 A5 87			lda Reg8
  1432 5622 20 BB 51			jsr Selector_HiRow					; un-highlight the cell we left
  1433 5625 AD C7 04			lda Sel_Index
  1434 5628 20 BB 51			jsr Selector_HiRow					; highlight the cell we moved to
  1435 562B			Sel_Key_Nav_Done
  1436 562B 20 72 52			jsr Selector_DrawStatus				; row 20: source name of the new row
  1437 562E 4C 8F 38			jmp Read_Key_Done
  1438
  1439 				;-----------------------------------------------------------------------------
  1440 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1441 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1442 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1443 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1444 				;-----------------------------------------------------------------------------
  1445 5631			Sel_Top_For_Index
  1446 5631 4A				lsr
  1447 5632 4A				lsr
  1448 5633 4A				lsr
  1449 5634 85 80			sta Reg1							; Reg1 = target item_row
  1450 5636 AD C8 04			lda Sel_Top
  1451 5639 4A				lsr
  1452 563A 4A				lsr
  1453 563B 4A				lsr								; A = current top_row
  1454 563C C5 80			cmp Reg1
  1455 563E 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1456 5640 F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1457 5642 A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1458 5644 4C 53 56			jmp Sel_Top_FI_Scale
  1459 5647			Sel_Top_FI_MaybeDown
  1460 5647 18				clc
  1461 5648 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1462 564A C5 80			cmp Reg1
  1463 564C B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1464 564E A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1465 5650 38				sec
  1466 5651 E9 0E			sbc #[UI_VISROWS-1]
  1467 5653			Sel_Top_FI_Scale
  1468 5653 0A				asl
  1469 5654 0A				asl
  1470 5655 0A				asl								; row -> Sel_Top (* UI_COLS)
  1471 5656 60				rts
  1472 5657			Sel_Top_FI_Unchanged
  1473 5657 AD C8 04			lda Sel_Top
  1474 565A 60				rts
