  2028 				;-----------------------------------------------------------------------------
  2029 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2030 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2031 				; the whole .NFO is shorter than the window, clear first and blit only the
  2032 				; records that exist.
  2033 				;-----------------------------------------------------------------------------
  2034 5A10			Info_Draw
  2035 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2036 5A10 38				sec
  2037 5A11 AD DE 04			lda Nfo_LineCount
  2038 5A14 ED DC 04			sbc Nfo_Top
  2039 5A17 85 84			sta Reg5
  2040 5A19 AD DF 04			lda Nfo_LineCount + $01
  2041 5A1C ED DD 04			sbc Nfo_Top + $01
  2042 5A1F 85 85			sta Reg6
  2043 				; rows = min(available, NFO_VISROWS)
  2044 5A21 A5 85			lda Reg6
  2045 5A23 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2046 5A25 A5 84			lda Reg5
  2047 5A27 C9 14			cmp #NFO_VISROWS
  2048 5A29 B0 10			bcs Info_Draw_Full
  2049 				; short document: clear, then blit only the records that exist
  2050 5A2B A5 84			lda Reg5
  2051 5A2D 85 83			sta Reg4
  2052 5A2F 20 1D 3B			jsr Text_Clear
  2053 5A32 A5 83			lda Reg4
  2054 5A34 F0 68			beq Info_Draw_Ret					; nothing to draw
  2055 5A36 C6 83			dec Reg4							; Reg4 = height-1
  2056 5A38 4C 3F 5A			jmp Info_Draw_Blit
  2057 5A3B			Info_Draw_Full
  2058 5A3B A9 13			lda #NFO_VISROWS-1
  2059 5A3D 85 83			sta Reg4
  2060 5A3F			Info_Draw_Blit
  2061 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2062 5A3F A9 00			lda #$00
  2063 5A41 85 80			sta Reg1
  2064 5A43 85 81			sta Reg2
  2065 5A45 AE DC 04			ldx Nfo_Top
  2066 5A48 F0 0E			beq Info_Draw_Patch
  2067 5A4A			Info_Draw_MulL
  2068 5A4A A5 80			lda Reg1
  2069 5A4C 18				clc
  2070 5A4D 69 A0			adc #TEXT_PITCH
  2071 5A4F 85 80			sta Reg1
  2072 5A51 90 02			bcc Info_Draw_MulNC
  2073 5A53 E6 81			inc Reg2
  2074 5A55			Info_Draw_MulNC
  2075 5A55 CA				dex
  2076 5A56 D0 F2			bne Info_Draw_MulL
  2077 5A58			Info_Draw_Patch
  2078 5A58 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2079 5A5A				vbsta VBXE_MA_BSEL
