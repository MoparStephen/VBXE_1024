   681 				;-----------------------------------------------------------------------------
   682 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   683 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   684 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   685 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   686 				;-----------------------------------------------------------------------------
   687 3472			Image_Read_Segment
   688 3472 8D E3 04			sta Seg_Bank
   689 3475 8E E4 04			stx Seg_Chunks
   690 3478			Image_Read_Segment_L1
   691 3478 AD E4 04			lda Seg_Chunks
   692 347B F0 0F			beq Image_Read_Segment_Tail
   693 347D A9 00			lda #<VBXE_WINDOW_SIZE_4k
   694 347F A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   695 3481 20 9F 34			jsr Image_Read_Chunk
   696 3484 B0 18			bcs Image_Read_Segment_Done
   697 3486 CE E4 04			dec Seg_Chunks
   698 3489 4C 78 34			jmp Image_Read_Segment_L1
   699
   700 348C			Image_Read_Segment_Tail
   701 348C AD E5 04			lda Seg_Tail
   702 348F 0D E6 04			ora Seg_Tail + $01
   703 3492 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   704 3494 AD E5 04			lda Seg_Tail
   705 3497 AC E6 04			ldy Seg_Tail + $01
   706 349A 4C 9F 34			jmp Image_Read_Chunk
   707
   708 349D			Image_Read_Segment_OK
   709 349D 18				clc
   710 349E			Image_Read_Segment_Done
   711 349E 60				rts
   712
   713 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   714 				; C=1 on a CIO error.
