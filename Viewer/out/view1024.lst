   514 3B5D A9 00			lda #$00
   515 3B5F 85 82			sta Reg3							; Reg3 = source string index
   516 3B61 AD B1 06			lda Txt_Col
   517 3B64 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
