  2090 				;-----------------------------------------------------------------------------
  2091 				; Selector_Handle_P - "P" key: show a 2x2 grid of ramp squares, one per
  2092 				; palette register, zoomed 7x and centered on the image screen (UI_Mode 6,
  2093 				; Esc-only - see Pal_Preview_Keys).
  2094 				;   * on a *.V1K row: "Reading palette..." in row 0, read the .PAL block to
  2095 				;     $21000 with the selector still up; a missing / short file leaves the
  2096 				;     selector up (row 0 restored).  Only once it has loaded is the screen
  2097 				;     (prebuilt at boot by Pal_Preview_Init) swapped in, with the registers
  2098 				;     rewritten under a blanked overlay.
  2099 				;   * on "..", a directory or an empty list: no disk access at all - the
  2100 				;     registers already hold the menu's own palettes 0-3, so just show them.
  2101 				;-----------------------------------------------------------------------------
  2102 5E00			Selector_Handle_P
  2103 5E00 AD 8B 04			lda ImageCount
  2104 5E03 0D 8C 04			ora ImageCount+1
  2105 5E06 F0 35			beq Selector_Handle_P_Menu			; empty list -> the menu palettes
  2106 5E08 AD C7 04			lda Sel_Index
  2107 5E0B 20 B6 58			jsr UI_RowType
  2108 5E0E D0 2D			bne Selector_Handle_P_Menu			; dir / ".." -> the menu palettes
  2109
