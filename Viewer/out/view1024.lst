   437 				;-----------------------------------------------------------------------------
   438 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   439 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   440 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   441 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   442 				;  Returns A = $01 if a name was written, $00 if not.
   443 				;-----------------------------------------------------------------------------
   444 5083			Parse_Dir_Line
   445 5083 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   446 5085			Parse_Skip_L1							; Skip leading spaces / protect flag
   447 5085 BD 00 06			lda Dir_Line_Buf,x
   448 5088 C9 9B			cmp #$9B
   449 508A F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   450 508C C9 20			cmp #' '
   451 508E F0 04			beq Parse_Skip_Next
   452 5090 C9 2A			cmp #'*'
   453 5092 D0 07			bne Parse_Skip_Done
   454 5094			Parse_Skip_Next
   455 5094 E8				inx
   456 5095 E0 28			cpx #Dir_Line_Len
   457 5097 90 EC			bcc Parse_Skip_L1
   458 5099 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   459 509B			Parse_Skip_Done
   460 509B A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   461 509D A9 00			lda #$00
   462 509F 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   463
   464 50A1			Parse_Copy_L1
   465 50A1 BD 00 06			lda Dir_Line_Buf,x
   466 50A4 C9 9B			cmp #$9B
   467 50A6 F0 24			beq Parse_Copy_Done
   468 50A8 C9 20			cmp #' '
   469 50AA F0 20			beq Parse_Copy_Done
   470 50AC C9 2E			cmp #'.'
   471 50AE F0 1C			beq Parse_Copy_Done
   472 50B0 C9 30			cmp #'0'
   473 50B2 90 07			bcc Parse_Copy_Is_Name_Char
   474 50B4 C9 3A			cmp #'9'+1
   475 50B6 B0 03			bcs Parse_Copy_Is_Name_Char
   476 50B8 4C BD 50			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   477 50BB			Parse_Copy_Is_Name_Char
   478 50BB E6 80			inc Reg1
   479 50BD			Parse_Copy_Store
   480 50BD C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   481 50BF B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   482 50C1 BD 00 06			lda Dir_Line_Buf,x
   483 50C4 91 8A			sta (Name_Ptr),y
   484 50C6 C8				iny
   485 50C7			Parse_Copy_Next
   486 50C7 E8				inx
   487 50C8 E0 28			cpx #Dir_Line_Len
   488 50CA 90 D5			bcc Parse_Copy_L1
   489
   490 50CC			Parse_Copy_Done
   491 50CC A5 80			lda Reg1
   492 50CE F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   493
   494 50D0			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   495 50D0 C0 08			cpy #$08
   496 50D2 B0 07			bcs Parse_Dir_Line_Accept
   497 50D4 A9 20			lda #' '
   498 50D6 91 8A			sta (Name_Ptr),y
   499 50D8 C8				iny
   500 50D9 D0 F5			bne Parse_Pad_L1
   501
   502 50DB			Parse_Dir_Line_Accept
   503 50DB A9 01			lda #$01							; Non-zero - a name was stored
   504 50DD 60				rts
   505 50DE			Parse_Dir_Line_Reject
   506 50DE A9 00			lda #$00
   507 50E0 60				rts
