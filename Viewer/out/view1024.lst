   590 				;-----------------------------------------------------------------------------
   591 				; Sort_Image_List - in-place alphabetical (lexicographic) selection sort of
   592 				; the ImageCount 8-byte space-padded records in IMAGE_BANK.
   593 				; NOT CALLED YET - hook is the commented "jsr Sort_Image_List" in Scan_Images
   594 				; (init_vbxe.asm). Resident and self-contained so a future viewer UI can also
   595 				; call it at runtime. O(n^2) byte compares; trivial at MAX_IMAGES = 255.
   596 				; Clobbers A/X/Y, Reg2..Reg8, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
   597 				;-----------------------------------------------------------------------------
   598 3543			Sort_Image_List
   599 3543 AD 8B 04			lda ImageCount
   600 3546 C9 02			cmp #$02
   601 3548 90 64			bcc Sort_Image_List_Done			; 0 or 1 records -> nothing to do
   602 354A 85 84			sta Reg5							; Reg5 = n
   603 354C 38				sec
   604 354D E9 01			sbc #$01
   605 354F 85 85			sta Reg6							; Reg6 = n-1 (outer limit)
   606
   607 3551 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   608 3553				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3553 A0 5F			ldy #<VBXE_MA_BSEL
     3 3555 91 93			sta (VBXEBase),y
Source: view1024.asm
   609
   610 3557 A9 00			lda #$00
   611 3559 85 81			sta Reg2							; i = 0
   612 355B			Sort_Outer
   613 355B A5 81			lda Reg2
   614 355D C5 85			cmp Reg6
   615 355F B0 47			bcs Sort_Image_List_Unmap			; i >= n-1 -> done
   616
   617 3561 85 83			sta Reg4							; m = i
   618 3563 20 D3 35			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
   619
   620 3566 A5 81			lda Reg2
   621 3568 18				clc
   622 3569 69 01			adc #$01
   623 356B 85 82			sta Reg3							; j = i + 1
   624 356D			Sort_Inner
   625 356D A5 82			lda Reg3
   626 356F C5 84			cmp Reg5
   627 3571 B0 1D			bcs Sort_Inner_Done					; j >= n
   628
   629 3573 A5 82			lda Reg3
   630 3575 20 DF 35			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
   631 3578 20 AF 35			jsr Cmp_Records						; rec(m) : rec(j)
   632 357B 90 0E			bcc Sort_Inner_Next					; rec(m) < rec(j) -> keep m
   633 357D F0 0C			beq Sort_Inner_Next					; equal          -> keep m
   634 357F A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
   635 3581 85 83			sta Reg4
   636 3583 A5 8C			lda Sort_Ptr
   637 3585 85 8A			sta Name_Ptr
   638 3587 A5 8D			lda Sort_Ptr + $01
   639 3589 85 8B			sta Name_Ptr + $01
   640 358B			Sort_Inner_Next
   641 358B E6 82			inc Reg3
   642 358D 4C 6D 35			jmp Sort_Inner
   643 3590			Sort_Inner_Done
   644 3590 A5 83			lda Reg4
   645 3592 C5 81			cmp Reg2
   646 3594 F0 0D			beq Sort_Outer_Next					; min already in place
   647 3596 A5 81			lda Reg2
   648 3598 20 DF 35			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
   649 359B A5 83			lda Reg4
   650 359D 20 D3 35			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
   651 35A0 20 BD 35			jsr Swap_Records
   652 35A3			Sort_Outer_Next
   653 35A3 E6 81			inc Reg2
   654 35A5 4C 5B 35			jmp Sort_Outer
   655
   656 35A8			Sort_Image_List_Unmap
   657 35A8 A9 00			lda #MEMAC_GLOBAL_DISABLE
   658 35AA				vbsta VBXE_MA_BSEL
