  1224 3787 D0 06			bne Handle_Keys_Mode
  1225 3789 20 BB 3A			jsr Toggle_Font						; (text80.asm) - a CHBASE flip, nothing is redrawn
  1226 378C 4C 28 38			jmp Read_Key_Done
  1227 378F			Handle_Keys_Mode
  1228 378F AD C6 04			lda UI_Mode
  1229 3792 D0 03			bne Handle_Keys_NotSelector
  1230 3794 4C F2 56			jmp Selector_Keys					; 0 = selector
  1231 3797			Handle_Keys_NotSelector
  1232 3797 C9 02			cmp #$02
  1233 3799 D0 03			bne Handle_Keys_NotSlide
  1234 379B 4C 9F 5C			jmp Slideshow_Keys					; 2 = slideshow
  1235 379E			Handle_Keys_NotSlide
  1236 379E C9 03			cmp #$03
  1237 37A0 D0 03			bne Handle_Keys_NotFolder
  1238 37A2 4C 2F 59			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
  1239 37A5			Handle_Keys_NotFolder
  1240 37A5 C9 04			cmp #$04
  1241 37A7 D0 03			bne Handle_Keys_NotInfo
  1242 37A9 4C 60 5E			jmp Info_Keys						; 4 = info viewer (.nfo)
  1243 37AC			Handle_Keys_NotInfo
  1244 37AC C9 05			cmp #$05
  1245 37AE D0 03			bne Handle_Keys_NotQuit
  1246 37B0 4C 3C 5A			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
  1247 37B3			Handle_Keys_NotQuit
  1248 37B3 C9 06			cmp #$06
