   107 				; Copy 2048 bytes (Ptr_Lo/Hi) -> (Reg1/Reg2), 8 pages.
   108 3A8B			Text_Copy_2K
   109 3A8B A2 08			ldx #$08
   110 3A8D A0 00			ldy #$00
   111 3A8F			Text_Copy_2K_L1
   112 3A8F B1 88			lda (Ptr_Lo),y
   113 3A91 91 80			sta (Reg1),y
   114 3A93 C8				iny
