  1656 584D C5 80			cmp Reg1
  1657 584F 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1658 5851 F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1659 5853 A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1660 5855 4C 64 58			jmp Sel_Top_FI_Scale
  1661 5858			Sel_Top_FI_MaybeDown
  1662 5858 18				clc
  1663 5859 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1664 585B C5 80			cmp Reg1
  1665 585D B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1666 585F A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1667 5861 38				sec
  1668 5862 E9 0E			sbc #[UI_VISROWS-1]
  1669 5864			Sel_Top_FI_Scale
  1670 5864 0A				asl
  1671 5865 0A				asl
  1672 5866 0A				asl								; row -> Sel_Top (* UI_COLS)
  1673 5867 60				rts
  1674 5868			Sel_Top_FI_Unchanged
  1675 5868 AD C8 04			lda Sel_Top
  1676 586B 60				rts
