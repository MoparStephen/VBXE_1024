   343 				;-----------------------------------------------------------------------------
   344 				; Handle_Keys
   345 				;-----------------------------------------------------------------------------
   346 3430			Handle_Keys
   347 				; If present, the next 3 lines will allow a "jump to exit" on a specific key press
   348 3430 AD FC 02			lda CH
   349 3433 C9 2F			cmp #$2F							; Press Q to quit
   350 3435 F0 13			beq	Exit
   351 3437			Check_Space
   352 3437 C9 21			cmp #$21							; Space
   353 3439 F0 03			beq Handle_Space
   354 343B 4C 44 34			jmp Read_Key_Done
   355
   356 343E			Handle_Space
   357 343E 20 54 33			jsr Clear_Screen					; Clear the VBXE RAM
   358 3441 20 4D 34			jsr Increment_Image					; Display the next image
   359
   360 3444			Read_Key_Done
   361 3444 A9 FF			lda #$FF
   362 3446 8D FC 02			sta CH								; Clear last key pressed
   363 3449 60				rts									; Else return to caller
   364 344A			Exit
   365 344A 4C D2 31			jmp	Cleanup_Exit					; Clean up and exit (accounts for any long branch issues)
   366
   367 				;-----------------------------------------------------------------------------
   368 				; Increment_Image
   369 				;-----------------------------------------------------------------------------
   370 344D			Increment_Image
   371 344D 18				clc
   372 344E AD 8A 04			lda File_Index
   373 3451 69 10			adc #$10
   374 3453 C9 80			cmp #$80							; Past index 7?
   375 3455 90 02			bcc Increment_Image_Valid
   376 3457 A9 00			lda #$00							; Wrap to index 0
   377 3459			Increment_Image_Valid
   378 3459 8D 8A 04			sta File_Index
   379 345C AA				tax
   380 345D 20 9A 33			jsr Load_Image
   381 3460 60				rts
   382
