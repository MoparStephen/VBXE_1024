  1630 39F7			Sort_Range_Outer
  1631 39F7 A5 81			lda Reg2
  1632 39F9 C5 85			cmp Reg6
  1633 39FB B0 47			bcs Sort_Range_Unmap				; i >= end-1 -> done
  1634
  1635 39FD 85 83			sta Reg4							; m = i
  1636 39FF 20 6F 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1637
  1638 3A02 A5 81			lda Reg2
  1639 3A04 18				clc
  1640 3A05 69 01			adc #$01
  1641 3A07 85 82			sta Reg3							; j = i + 1
  1642 3A09			Sort_Range_Inner
  1643 3A09 A5 82			lda Reg3
  1644 3A0B C5 84			cmp Reg5
  1645 3A0D B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1646
  1647 3A0F A5 82			lda Reg3
  1648 3A11 20 7B 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1649 3A14 20 4B 3A			jsr Cmp_Records						; rec(m) : rec(j)
  1650 3A17 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1651 3A19 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1652 3A1B A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1653 3A1D 85 83			sta Reg4
  1654 3A1F A5 8C			lda Sort_Ptr
  1655 3A21 85 8A			sta Name_Ptr
  1656 3A23 A5 8D			lda Sort_Ptr + $01
  1657 3A25 85 8B			sta Name_Ptr + $01
  1658 3A27			Sort_Range_Inner_Next
  1659 3A27 E6 82			inc Reg3
  1660 3A29 4C 09 3A			jmp Sort_Range_Inner
  1661 3A2C			Sort_Range_Inner_Done
  1662 3A2C A5 83			lda Reg4
  1663 3A2E C5 81			cmp Reg2
  1664 3A30 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1665 3A32 A5 81			lda Reg2
  1666 3A34 20 7B 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1667 3A37 A5 83			lda Reg4
  1668 3A39 20 6F 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1669 3A3C 20 59 3A			jsr Swap_Records
  1670 3A3F			Sort_Range_Outer_Next
  1671 3A3F E6 81			inc Reg2
  1672 3A41 4C F7 39			jmp Sort_Range_Outer
