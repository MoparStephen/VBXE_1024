  1928 3C9E B1 8C			lda (Sort_Ptr),y
  1929 3CA0 91 8A			sta (Name_Ptr),y
  1930 3CA2 B9 8D 04			lda Path_Buf,y
  1931 3CA5 91 8C			sta (Sort_Ptr),y
  1932 3CA7 C8				iny
