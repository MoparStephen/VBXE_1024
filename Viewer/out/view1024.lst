  1002 				;-----------------------------------------------------------------------------
  1003 				; Increment_Image - advance File_Index within the *.MAP file band
  1004 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1005 				; No-op when the list holds no files.  (The selector list may now also carry
  1006 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1007 				;-----------------------------------------------------------------------------
  1008 36C9			Increment_Image
  1009 36C9 AD DA 04			lda FileStart
  1010 36CC CD 8B 04			cmp ImageCount
  1011 36CF B0 12			bcs Increment_Image_Done			; no *.MAP files in the list
  1012 36D1 AE 8A 04			ldx File_Index
  1013 36D4 E8				inx
  1014 36D5 EC 8B 04			cpx ImageCount
  1015 36D8 90 03			bcc Increment_Image_Store
  1016 36DA AE DA 04			ldx FileStart						; wrap past the last file to the first
  1017 36DD			Increment_Image_Store
  1018 36DD 8E 8A 04			stx File_Index
  1019 36E0 20 BB 33			jsr Load_Image
  1020 36E3			Increment_Image_Done
  1021 36E3 60				rts
  1022
  1023 				;-----------------------------------------------------------------------------
  1024 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1025 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1026 				;-----------------------------------------------------------------------------
  1027 36E4			Decrement_Image
  1028 36E4 AD DA 04			lda FileStart
  1029 36E7 CD 8B 04			cmp ImageCount
  1030 36EA B0 12			bcs Decrement_Image_Done
  1031 36EC AE 8A 04			ldx File_Index
  1032 36EF EC DA 04			cpx FileStart
  1033 36F2 D0 03			bne Decrement_Image_Step
  1034 36F4 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1035 36F7			Decrement_Image_Step
  1036 36F7 CA				dex
  1037 36F8 8E 8A 04			stx File_Index
  1038 36FB 20 BB 33			jsr Load_Image
  1039 36FE			Decrement_Image_Done
  1040 36FE 60				rts
