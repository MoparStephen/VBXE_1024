Source: ui.asm
     1 				;=============================================================================
     2 				; ui.asm  -  viewer UI: file selector, slideshow, runtime directory scan
     3 				;-----------------------------------------------------------------------------
     4 				; This is the main segment (icl'd from view1024.asm at $3300+).  Everything
     5 				; here is entered only at runtime - from start: and from the key handlers -
     6 				; so NONE of it is reachable from an ini step (unlike the old Scan_Images).
     7 				;
     8 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register access here
     9 				; goes through vbsta / vblda, never a bare lda / sta VBXE_* (a bare access
    10 				; silently collapses to a zero-page hit - the $53 / VBXE_BLITTER_BUSY hang).
    11 				; vbsta/vblda clobber Y in auto mode: no live Y is held across one below.
    12 				;
    13 				; Screen model (text80.asm): 80 columns x TEXT_ROWS(23) rows, Palette 0 - the
    14 				; menu/info XDL (xdl.asm) displays this ONE buffer as two on-screen bands (a
    15 				; graphics banner sits above it, a 1-line separator between the bands, see
    16 				; xdl.asm for the full 240-scanline layout).  Selector row map:
    17 				;   row 0            Location: <path>  ...  image counter (cols 68-77,
    18 				;                    "nnn of NNN" / "NNN images" - Selector_DrawCount);
    19 				;                    "Scanning directory..." in the path's place while
    20 				;                    Rescan_Images runs
    21 				;   row 1            blank
    22 				;   rows 2-16 (15)   scrolling grid (UI_FIRSTROW/UI_VISROWS below)
    23 				;   rows 17-19       spare/margin (blank)
    24 				;   row 20 (TEXT_MAIN_ROWS+0)   "Nfo: <description>"
    25 				;   row 21 (TEXT_MAIN_ROWS+1)   "Cfg: NN sec (< Less > More)  ...  Press HELP ..."
    26 				;   row 22 (TEXT_MAIN_ROWS+2)   "Nav: <arrows> Select Enter Choose ..." (key legend)
    27 				;   - each starts with a 3-letter tag + ':' in UI_PEN_LOC, at col 0
    28 				; The info viewer uses rows 0..TEXT_MAIN_ROWS-1 for scrollable content and
    29 				; row TEXT_MAIN_ROWS for a single fixed hint line - see NFO_VISROWS below.
    30 				;
    31 				; UI_Mode:  0 = selector   1 = image view   2 = slideshow
    32 				;           3 = drive picker (D-key save-under overlay)   4 = info viewer (.nfo)
    33 				;           5 = quit-confirm (Q-key save-under overlay, selector only)
    34 				;           6 = P-preview (P-key 4-palette ramp-square screen, Esc only)
    35 				;=============================================================================
    36
    37 = 0008			.def	UI_COLS			= 8				; grid columns (items/row) - a power of 2
    38 														; keeps row=index>>3 / col=index&7 cheap
    39 = 000F			.def	UI_VISROWS		= 15			; grid rows visible at once
    40 = 0002			.def	UI_FIRSTROW		= 2				; first screen row of the grid
    41 = 0000			.def	UI_GRIDCOL0		= 0				; first screen column of the grid (Sel_ColX base)
    42 = 0044			.def	UI_COUNT_COL	= 68			; row 0 image counter, 10 chars (cols 68-77,
    43 														; mirroring Location:'s 2-col left margin)
    44 				; UI_FIRSTROW / UI_GRIDCOL0 are the only placement knobs - see the row map
    45 				; above for the rest of the selector's chrome (status/delay/legend rows).
    46 = 0001			.def	UI_SLIDE_MIN	= 1
    47 = 001E			.def	UI_SLIDE_MAX	= 30
    48 				; VBXE text-mode colour byte: bits 0-6 = foreground palette-0 entry (0-127),
    49 				; bit 7 = 1 -> opaque background (hardware-forced to palette[fg+128]), 0 ->
    50 				; transparent.  UI_Build_TextPalette de-interleaves the Atari master for set 0
    51 				; so entry e = master colour 2e: hue = e>>3 (all 16 hues), luma = (e&7)*2.
    52 				; The cursor row is marked by FOREGROUND colour only - no opaque bar - because
    53 				; after the de-interleave palette[e+128] is the adjacent-luma neighbour of
    54 				; palette[e] and gives no contrast.  Tune the three indices once on screen.
    55 = 0007			.def	UI_PEN_FG		= $07			; normal text   : hue 0 grey,  luma 14
    56 = 000F			.def	UI_PEN_HI		= $0F			; drive picker highlight : hue 1 gold, luma 14
    57 				; Selector grid - UI_Name_Pen picks one of these four per cell:
    58 = 003A			.def	UI_PEN_FILE		= $3A			; *.V1K file rows          : hue 7 blue,  luma 4
    59 = 0053			.def	UI_PEN_DIR		= $53			; directory / ".." rows    : hue $A green, luma 6
    60 = 0044			.def	UI_PEN_FILEHI	= $44			; highlighted file         : hue 8 light blue, luma 8
    61 = 0056			.def	UI_PEN_DIRHI	= $56			; highlighted dir / ".."   : hue $A green, luma 12
    62 = 001B			.def	UI_PEN_EMPTY	= $1B			; "* No images *" note     : hue 3 red,   luma 6
    63 				; Chrome colours - mirror PEN_* in Convertor/nfo_encode.py (the .nfo info
    64 				; screen), so the selector and the info screen share one scheme.  Labels and
    65 				; the legend/hint strings carry these inline (TXT_PEN escapes, text80.asm).
    66 = 007C			.def	UI_PEN_LABEL	= $7C			; label left of ':'  : hue $F gold,  luma 8
    67 = 0044			.def	UI_PEN_SEP		= $44			; the ':'            : hue 8 blue,   luma 8
    68 = 003A			.def	UI_PEN_VALUE	= $3A			; values             : hue 7 blue,   luma 4
    69 = 007C			.def	UI_PEN_LOC		= $7C			; row 0 "Location: " + path (all one colour)
    70 = 003B			.def	UI_PEN_NFO		= $3B			; status row 20 description (after "Nfo: ") : hue 7, luma 6
    71 = 003B			.def	UI_PEN_COUNT	= $3B			; row 0 "nnn of NNN" / "NNN images" : hue 7, luma 6
    72 = 003A			.def	UI_PEN_FRAMEC	= $3A			; popup window frames: hue 7 blue,  luma 4
    73 = 003B			.def	UI_PEN_QUITQ	= $3B			; quit question      : hue 7 blue,   luma 6
    74 = 0052			.def	UI_PEN_YES		= $52			; quit "Y" button    : hue $A dark green, luma 4
    75 = 0019			.def	UI_PEN_NO		= $19			; quit "N" button    : hue 3 dark red,   luma 2
    76 = 0043			.def	UI_PEN_KEY		= $43			; key names          : hue 8 light blue, luma 6 (= info screen notes)
    77 = 003A			.def	UI_PEN_DESC		= $3A			; key descriptions   : hue 7 dark blue,  luma 4 (= info screen values)
    78 = 0059			.def	UI_PEN_HELP		= $59			; help page text     : hue $B teal-green, luma 2
    79 = 005D			.def	UI_PEN_HELPHEAD	= $5D			; help section name  : hue $B teal-green, luma 10
    80 = 005A			.def	UI_PEN_HELPKEY	= $5A			; help key column    : hue $B teal-green, luma 4 (one step over UI_PEN_HELP)
    81 = 005B			.def	UI_PEN_HELPNAV	= $5B			; help Section 2 keys: hue $B teal-green, luma 6 (one step over UI_PEN_HELPKEY)
    82 = 0003			.def	HELP_PAGES		= 3				; Help_Text_1..3 (Help_Page_Lo/Hi)
    83 = 0013			.def	HELP_VISROWS	= TEXT_MAIN_ROWS-1	; help section rows visible at once (rows 1-19)
    84
    85 = 0000			.def	NFO_TOPROW		= 0				; info viewer: first screen row of the scroll region
    86 = 0014			.def	NFO_VISROWS		= TEXT_MAIN_ROWS	; info viewer: visible text rows (main band only)
    87 				; The logo band is real now (the menu XDL's graphics group, see xdl.asm) - it
    88 				; lives in its own VRAM, not stolen text rows, so NFO_TOPROW stays 0.
    89 				; NFO_VISROWS must equal TEXT_MAIN_ROWS (not the full TEXT_ROWS buffer): the
    90 				; blit overwrites every row it touches, and rows TEXT_MAIN_ROWS..TEXT_ROWS-1
    91 				; hold the separate static footer hint line - the NFO blit must not touch it.
    92 = 007F			.def	NFO_MAX_LINES	= 127			; cap on displayed .NFO records; NFO_BUF_VRAM (5 banks)
    93 													; holds 128 * 160, the 128th slot being the $00 sentinel
    94
    95 				; --- CH key codes (POKEY, no modifier).  Matches the bare-CH style in
    96 				;     Handle_Keys (Q $2F, Space $21, BkSp $34, Esc $1C, digits ...).
    97 				;     The 4 arrows are also accepted with CTRL held ($8E/$8F/$86/$87): each
    98 				;     handler ANDs CH with KEY_CTRL_OFF before the arrow compares, then
    99 				;     reloads the raw CH for everything else.
   100 = 007F			.def	KEY_CTRL_OFF	= $7F			; CH AND mask - clears the CTRL bit ($80)
   101 = 000E			.def	KEY_UP			= $0E			; "-" key (up-arrow;    Ctrl = $8E)
   102 = 000F			.def	KEY_DOWN		= $0F			; "=" key (down-arrow;  Ctrl = $8F)
   103 = 0006			.def	KEY_LEFT		= $06			; "+" key (left-arrow;  Ctrl = $86)
   104 = 0007			.def	KEY_RIGHT		= $07			; "*" key (right-arrow; Ctrl = $87)
   105 = 000C			.def	KEY_RETURN		= $0C
   106 = 001C			.def	KEY_ESC			= $1C
   107 = 0021			.def	KEY_SPACE		= $21
   108 = 002F			.def	KEY_Q			= $2F
   109 = 003E			.def	KEY_S			= $3E
   110 = 003A			.def	KEY_D			= $3A
   111 = 0038			.def	KEY_F			= $38			; toggle text font (CGA <-> Atari)
   112 = 000A			.def	KEY_P			= $0A
   113 = 000D			.def	KEY_I			= $0D
   114 = 0020			.def	KEY_COMMA		= $20			; "," - shorter slideshow delay (selector)
   115 = 0022			.def	KEY_DOT			= $22			; "." - longer slideshow delay  (selector)
   116 														;     (shown as "<" / ">" in the Cfg: row - the
   117 														;     same keys on a PC keyboard)
   118 = 002B			.def	KEY_Y			= $2B			; quit-confirm: yes (verified via Altirra CH readback)
   119 = 0023			.def	KEY_N			= $23			; quit-confirm: no  (verified via Altirra CH readback)
