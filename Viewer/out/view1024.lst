    75 2038 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    76 2039 00				dta $00								; XDLC_RPTL = 1-1
    77 203A 00 30 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
    78 203F 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
    79
    80 				; --- Block 4: 1 blank scanline ----------------------------------------------
    81 2041 34				dta %00110100
    82 2042 00				dta $00
    83 2043 00				dta $00								; XDLC_RPTL = 1-1
    84
    85 				; --- Block 5: 160 text scanlines, 20 rows (main content) -------------------
    86 2044 71				dta %01110001						; XDLC Byte 1 (XDLC_TMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    87 2045 09				dta %00001001						; XDLC Byte 2 (XDLC_CHBASE | XDLC_ATT)
    88 2046 9F				dta $9F								; XDLC_RPTL = 160-1
    89 2047 00 30 02 A0 00		dta <TEXT_SCREEN_VRAM, >TEXT_SCREEN_VRAM, TEXT_SCREEN_VRAM >> 16, <TEXT_PITCH, >TEXT_PITCH
    90 204C			XDL_MainMenu_CHBase						; Toggle_Font pokes this byte - see text80.asm
    91 204C 44				dta TEXT_CHBASE						; XDLC_CHBASE (1 byte)  font @ TEXT_FONT_VRAM
    92 204D 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=01 | OV_PALETTE=00 ; Priority $FE
    93
    94 				; --- Block 6: 1 lo-res scanline, separator (same image as Block 3) ---------
    95 204F 72				dta %01110010						; XDLC Byte 1 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    96 2050 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    97 2051 00				dta $00								; XDLC_RPTL = 1-1
    98 2052 00 30 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
    99 2057 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
   100
   101 				; --- Block 7: 1 blank scanline ----------------------------------------------
   102 2059 34				dta %00110100
