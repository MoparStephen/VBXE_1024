   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3CA2			Text_Window_Save
   393 3CA2 20 F5 3C			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3CA5 A5 83			lda Reg4
   395 3CA7 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3CAA A5 84			lda Reg5
   397 3CAC 18				clc
   398 3CAD 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3CAF 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3CB2 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3CB4 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3CB7 A9 00			lda #<WIN_SAVE_VRAM
   403 3CB9 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3CBC A9 F0			lda #>WIN_SAVE_VRAM
   405 3CBE 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3CC1 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3CC3 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3CC6 4C 35 3D			jmp Text_Window_Kick
   409
   410 3CC9			Text_Window_Restore
   411 3CC9 A9 01			lda #$01
   412 3CCB 8D B7 06			sta Txt_Dirty
   413 3CCE 20 F5 3C			jsr Text_Window_Setup
   414 3CD1 A9 00			lda #<WIN_SAVE_VRAM
   415 3CD3 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3CD6 A9 F0			lda #>WIN_SAVE_VRAM
   417 3CD8 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3CDB A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3CDD 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3CE0 A5 83			lda Reg4
   421 3CE2 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3CE5 A5 84			lda Reg5
   423 3CE7 18				clc
   424 3CE8 69 A0			adc #>TEXT_BACK_VRAM
   425 3CEA 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3CED A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3CEF 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3CF2 4C 35 3D			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3CF5			Text_Window_Setup
   433 3CF5 A9 00			lda #$00
   434 3CF7 85 83			sta Reg4
   435 3CF9 85 84			sta Reg5
   436 3CFB AE B0 06			ldx Txt_Row
   437 3CFE F0 0E			beq Text_Window_Setup_Col
   438 3D00			Text_Window_Setup_RowL
   439 3D00 A5 83			lda Reg4
   440 3D02 18				clc
   441 3D03 69 A0			adc #TEXT_PITCH
   442 3D05 85 83			sta Reg4
   443 3D07 90 02			bcc Text_Window_Setup_RowNC
   444 3D09 E6 84			inc Reg5
   445 3D0B			Text_Window_Setup_RowNC
   446 3D0B CA				dex
   447 3D0C D0 F2			bne Text_Window_Setup_RowL
   448 3D0E			Text_Window_Setup_Col
   449 3D0E AD B1 06			lda Txt_Col
   450 3D11 0A				asl
   451 3D12 18				clc
   452 3D13 65 83			adc Reg4
   453 3D15 85 83			sta Reg4
   454 3D17 90 02			bcc Text_Window_Setup_ColNC
   455 3D19 E6 84			inc Reg5
   456 3D1B			Text_Window_Setup_ColNC
   457 3D1B A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3D1D				vbsta VBXE_MA_BSEL
