  1032 53C0 85 81			sta Reg2							; Reg2 = row index
  1033 53C2 A9 00			lda #$00
  1034 53C4 85 89			sta Ptr_Hi
  1035 53C6 A5 81			lda Reg2
  1036 53C8 0A				asl
  1037 53C9 26 89			rol Ptr_Hi
  1038 53CB 0A				asl
  1039 53CC 26 89			rol Ptr_Hi
  1040 53CE 0A				asl
