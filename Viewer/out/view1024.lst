   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a simple ASCII box ('+' '-' '|') with a blank
   392 				; interior over Txt_Row / Txt_Col / Reg1 (width-1) / Reg2 (height-1), using the
   393 				; current pen.  Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   394 				;-----------------------------------------------------------------------------
   395 3C82			Text_Window_Frame
   396 3C82 A5 80			lda Reg1
   397 3C84 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   398 3C86 AD B1 06			lda Txt_Col
   399 3C89 85 87			sta Reg8							; Reg8 = left column
   400 3C8B AD B0 06			lda Txt_Row
   401 3C8E 18				clc
   402 3C8F 65 81			adc Reg2
