  1015 				;-----------------------------------------------------------------------------
  1016 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1017 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1018 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1019 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1020 				;-----------------------------------------------------------------------------
  1021 53B7			Nfo_Name_MapSlot
  1022 53B7 AD E1 04			lda Nfo_Name_Ord
  1023 53BA 4A				lsr									; C = Ord & 1
  1024 53BB A9 00			lda #$00
  1025 53BD 6A				ror									; A = (Ord & 1) << 7
  1026 53BE 85 88			sta Ptr_Lo
  1027 53C0 AD E1 04			lda Nfo_Name_Ord
  1028 53C3 4A				lsr
  1029 53C4 29 0F			and #$0F							; (Ord >> 1) & 15
  1030 53C6 18				clc
  1031 53C7 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1032 53C9 85 89			sta Ptr_Hi
  1033 53CB AD E1 04			lda Nfo_Name_Ord
  1034 53CE 4A				lsr
  1035 53CF 4A				lsr
  1036 53D0 4A				lsr
  1037 53D1 4A				lsr
  1038 53D2 4A				lsr									; Ord >> 5  (0..7)
  1039 53D3 18				clc
  1040 53D4 69 37			adc #NFO_NAME_BANK
  1041 53D6 09 80			ora #MEMAC_GLOBAL_ENABLE
  1042 53D8				vbsta VBXE_MA_BSEL
