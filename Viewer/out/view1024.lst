  1244 				; UI_Format_Row - A = row type (from UI_RowType).  Rewrites Name_Row_Buf (which
  1245 				; holds the raw 8-byte record from UI_ReadRec) as a fixed 10-char space-padded
  1246 				; field + NUL:  file -> "NAME    " ; dir -> "<NAME....>" ; ".." -> ".."  .
  1247 				; A fixed width means scrolling onto a shorter entry leaves no stale glyphs.
  1248 				; Uses Txt_Line as scratch for the directory case.
  1249 				;-----------------------------------------------------------------------------
  1250 550E			UI_Format_Row
  1251 550E C9 02			cmp #$02
  1252 5510 F0 16			beq UI_Format_Up
  1253 5512 C9 01			cmp #$01
