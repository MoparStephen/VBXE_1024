  1546 3A4B CD 8B 04			cmp ImageCount
  1547 3A4E B0 15			bcs Decrement_Image_Done
  1548 3A50 AE 8A 04			ldx File_Index
  1549 3A53 EC DA 04			cpx FileStart
  1550 3A56 D0 03			bne Decrement_Image_Step
  1551 3A58 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1552 3A5B			Decrement_Image_Step
  1553 3A5B CA				dex
  1554 3A5C 8E 8A 04			stx File_Index
  1555 3A5F 20 51 35			jsr Load_Image
  1556 3A62 20 0F 3B			jsr Map_View_Reapply
  1557 3A65			Decrement_Image_Done
