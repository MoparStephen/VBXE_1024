   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3F68			Text_Window_Save
   393 3F68 20 BB 3F			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3F6B A5 83			lda Reg4
   395 3F6D 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3F70 A5 84			lda Reg5
   397 3F72 18				clc
   398 3F73 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3F75 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3F78 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3F7A 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3F7D A9 00			lda #<WIN_SAVE_VRAM
   403 3F7F 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3F82 A9 F0			lda #>WIN_SAVE_VRAM
   405 3F84 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3F87 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3F89 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3F8C 4C FB 3F			jmp Text_Window_Kick
   409
   410 3F8F			Text_Window_Restore
   411 3F8F A9 01			lda #$01
   412 3F91 8D B7 06			sta Txt_Dirty
   413 3F94 20 BB 3F			jsr Text_Window_Setup
   414 3F97 A9 00			lda #<WIN_SAVE_VRAM
   415 3F99 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3F9C A9 F0			lda #>WIN_SAVE_VRAM
   417 3F9E 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3FA1 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3FA3 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3FA6 A5 83			lda Reg4
   421 3FA8 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3FAB A5 84			lda Reg5
   423 3FAD 18				clc
   424 3FAE 69 A0			adc #>TEXT_BACK_VRAM
   425 3FB0 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3FB3 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3FB5 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3FB8 4C FB 3F			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3FBB			Text_Window_Setup
   433 3FBB A9 00			lda #$00
   434 3FBD 85 83			sta Reg4
   435 3FBF 85 84			sta Reg5
   436 3FC1 AE B0 06			ldx Txt_Row
   437 3FC4 F0 0E			beq Text_Window_Setup_Col
   438 3FC6			Text_Window_Setup_RowL
   439 3FC6 A5 83			lda Reg4
