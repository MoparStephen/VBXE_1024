   337 342A			Load_Image_Done
   338 342A A9 00			lda	#MEMAC_GLOBAL_DISABLE			; USE CPU address space
   339 342C 8D 5F D6			sta VBXE_MA_BSEL
   340
   341 342F 60				rts
