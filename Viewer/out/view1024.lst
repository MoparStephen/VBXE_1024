   524 				;-----------------------------------------------------------------------------
   525 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   526 				; menu palettes back ONLY if an image replaced them (Pal_Image - after Info,
   527 				; Drive, Quit or a directory P-preview the registers are already right), then
   528 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   529 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   530 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   531 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   532 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   533 				; always returns.
   534 				;-----------------------------------------------------------------------------
   535 50F5			Enter_Selector
   536 50F5 A9 00			lda #$00
   537 50F7 8D C6 04			sta UI_Mode
   538 50FA 20 89 51			jsr Selector_Draw					; back buffer only - nothing visible yet
   539 50FD AD E7 04			lda Pal_Image
   540 5100 F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   541 5102 20 AE 33			jsr Display_Off						; blank while the registers are rewritten
   542 5105 20 6D 35			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   543 5108 20 7F 3B			jsr Text_Present
   544 510B 20 5D 3B			jsr Text_Activate
   545 510E 4C B8 33			jmp Display_On						; (tail)
   546 5111			Enter_Selector_Show
   547 5111 20 7F 3B			jsr Text_Present					; the finished screen, in one blit
   548 5114 4C 5D 3B			jmp Text_Activate					; (tail) a pure XDL swap
   549
   550 				;-----------------------------------------------------------------------------
   551 				; UI_Build_TextPalette - the standard Atari 256-colour master (NTSC $00200 /
   552 				; PAL $00500, per Video_Flag) has its entries 0-127 in hues 0-7 only (no
   553 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   554 				; De-interleave it so:
   555 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   556 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   557 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   558 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   559 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   560 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   561 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   562 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   563 				;-----------------------------------------------------------------------------
   564 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   565
   566 5117			UI_Build_TextPalette
   567 5117 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   568 5119				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5119 A0 5F			ldy #<VBXE_MA_BSEL
     3 511B 91 93			sta (VBXEBase),y
Source: ui.asm
