   308 				;-----------------------------------------------------------------------------
   309 				; Text_FillColour - recolour a rectangle of cells by flooding their attribute
   310 				; (odd) bytes.  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   311 				; (cells), Reg2 = height-1 (rows), A = attribute byte.  Patches BLT_FILL_COLOUR
   312 				; (dest address, Width-1, Height-1, Xor mask) then kicks it and waits.
   313 				;-----------------------------------------------------------------------------
   314 3B82			Text_FillColour
   315 3B82 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   316 3B84 A9 01			lda #$01
   317 3B86 8D B7 06			sta Txt_Dirty
   318 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
   319 3B89 A9 00			lda #$00
   320 3B8B 85 83			sta Reg4
   321 3B8D 85 84			sta Reg5
   322 3B8F AE B0 06			ldx Txt_Row
   323 3B92 F0 0E			beq Text_FillColour_Col
   324 3B94			Text_FillColour_RowL
   325 3B94 A5 83			lda Reg4
   326 3B96 18				clc
   327 3B97 69 A0			adc #TEXT_PITCH						; + 160 per row
   328 3B99 85 83			sta Reg4
   329 3B9B 90 02			bcc Text_FillColour_RowNC
   330 3B9D E6 84			inc Reg5
   331 3B9F			Text_FillColour_RowNC
   332 3B9F CA				dex
   333 3BA0 D0 F2			bne Text_FillColour_RowL
   334 3BA2			Text_FillColour_Col
   335 3BA2 AD B1 06			lda Txt_Col
   336 3BA5 0A				asl									; Txt_Col * 2
   337 3BA6 18				clc
   338 3BA7 65 83			adc Reg4
   339 3BA9 85 83			sta Reg4
   340 3BAB 90 02			bcc Text_FillColour_ColNC
   341 3BAD E6 84			inc Reg5
   342 3BAF			Text_FillColour_ColNC
   343 3BAF E6 83			inc Reg4							; + 1  -> the attribute (odd) byte
   344 3BB1 D0 02			bne Text_FillColour_Patch
   345 3BB3 E6 84			inc Reg5
   346 3BB5			Text_FillColour_Patch
   347 3BB5 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   348 3BB7				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3BB7 A0 5F			ldy #<VBXE_MA_BSEL
     3 3BB9 91 93			sta (VBXEBase),y
Source: text80.asm
