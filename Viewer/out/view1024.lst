  2012 				;-----------------------------------------------------------------------------
  2013 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  2014 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  2015 				; equal) otherwise.
  2016 				;-----------------------------------------------------------------------------
  2017 3D11			Cmp_Records
  2018 3D11 A0 00			ldy #$00
  2019 3D13			Cmp_Records_L1
  2020 3D13 B1 8A			lda (Name_Ptr),y
  2021 3D15 D1 8C			cmp (Sort_Ptr),y
  2022 3D17 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  2023 3D19 C8				iny
  2024 3D1A C0 08			cpy #$08
  2025 3D1C 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  2026 3D1E			Cmp_Records_Done
  2027 3D1E 60				rts
  2028
  2029 				;-----------------------------------------------------------------------------
  2030 				; Swap_Records - exchange the 8-byte records at (Name_Ptr) and (Sort_Ptr),
  2031 				; using Path_Buf as scratch.
  2032 				;-----------------------------------------------------------------------------
  2033 3D1F			Swap_Records
  2034 3D1F A0 00			ldy #$00
  2035 3D21			Swap_Records_L1
  2036 3D21 B1 8A			lda (Name_Ptr),y
  2037 3D23 99 8D 04			sta Path_Buf,y
  2038 3D26 B1 8C			lda (Sort_Ptr),y
  2039 3D28 91 8A			sta (Name_Ptr),y
  2040 3D2A B9 8D 04			lda Path_Buf,y
  2041 3D2D 91 8C			sta (Sort_Ptr),y
  2042 3D2F C8				iny
  2043 3D30 C0 08			cpy #$08
  2044 3D32 90 ED			bcc Swap_Records_L1
  2045 3D34 60				rts
  2046
  2047 				;-----------------------------------------------------------------------------
  2048 				; Sort_SetNamePtr / Sort_SetSortPtr - A = record index -> set the zp pointer
  2049 				; to ImageNames + index*8. Sort_IndexToOffset does the 16-bit math in Reg7/Reg8.
  2050 				;-----------------------------------------------------------------------------
  2051 3D35			Sort_SetNamePtr
  2052 3D35 20 4D 3D			jsr Sort_IndexToOffset
  2053 3D38 A5 86			lda Reg7
  2054 3D3A 85 8A			sta Name_Ptr
  2055 3D3C A5 87			lda Reg8
  2056 3D3E 85 8B			sta Name_Ptr + $01
  2057 3D40 60				rts
  2058
  2059 3D41			Sort_SetSortPtr
  2060 3D41 20 4D 3D			jsr Sort_IndexToOffset
  2061 3D44 A5 86			lda Reg7
  2062 3D46 85 8C			sta Sort_Ptr
  2063 3D48 A5 87			lda Reg8
  2064 3D4A 85 8D			sta Sort_Ptr + $01
  2065 3D4C 60				rts
  2066
  2067 3D4D			Sort_IndexToOffset
  2068 3D4D 85 86			sta Reg7
  2069 3D4F A9 00			lda #$00
  2070 3D51 85 87			sta Reg8
  2071 3D53 06 86			asl Reg7
  2072 3D55 26 87			rol Reg8
  2073 3D57 06 86			asl Reg7
  2074 3D59 26 87			rol Reg8
  2075 3D5B 06 86			asl Reg7
  2076 3D5D 26 87			rol Reg8							; Reg7/Reg8 = index * 8
  2077 3D5F A5 86			lda Reg7
  2078 3D61 18				clc
  2079 3D62 69 00			adc #<ImageNames
  2080 3D64 85 86			sta Reg7
  2081 3D66 A5 87			lda Reg8
  2082 3D68 69 20			adc #>ImageNames
  2083 3D6A 85 87			sta Reg8
  2084 3D6C 60				rts
