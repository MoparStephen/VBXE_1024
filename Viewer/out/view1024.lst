  1047 				;-----------------------------------------------------------------------------
  1048 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1049 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1050 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1051 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1052 				;-----------------------------------------------------------------------------
  1053 54AF			Nfo_Name_MapSlot
  1054 54AF AD E1 04			lda Nfo_Name_Ord
  1055 54B2 4A				lsr									; C = Ord & 1
  1056 54B3 A9 00			lda #$00
  1057 54B5 6A				ror									; A = (Ord & 1) << 7
  1058 54B6 85 88			sta Ptr_Lo
  1059 54B8 AD E1 04			lda Nfo_Name_Ord
  1060 54BB 4A				lsr
  1061 54BC 29 0F			and #$0F							; (Ord >> 1) & 15
  1062 54BE 18				clc
  1063 54BF 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1064 54C1 85 89			sta Ptr_Hi
  1065 54C3 AD E1 04			lda Nfo_Name_Ord
  1066 54C6 4A				lsr
  1067 54C7 4A				lsr
  1068 54C8 4A				lsr
  1069 54C9 4A				lsr
  1070 54CA 4A				lsr									; Ord >> 5  (0..7)
  1071 54CB 18				clc
  1072 54CC 69 37			adc #NFO_NAME_BANK
  1073 54CE 09 80			ora #MEMAC_GLOBAL_ENABLE
  1074 54D0				vbsta VBXE_MA_BSEL
