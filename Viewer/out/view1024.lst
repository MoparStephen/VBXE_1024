   284 				;-----------------------------------------------------------------------------
   285 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   286 				; cells between the text screen and WIN_SAVE_VRAM (a save-under buffer held at
   287 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   288 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   289 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   290 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   291 				; caller can Save then Frame on the same geometry.)
   292 				;-----------------------------------------------------------------------------
   293 3BA1			Text_Window_Save
   294 3BA1 20 EF 3B			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   295 3BA4 A5 83			lda Reg4
   296 3BA6 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   297 3BA9 A5 84			lda Reg5
   298 3BAB 18				clc
   299 3BAC 69 30			adc #$30							; low 16 bits of TEXT_SCREEN_VRAM = $3000
   300 3BAE 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   301 3BB1 A9 02			lda #$02
   302 3BB3 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   303 3BB6 A9 00			lda #<WIN_SAVE_VRAM
   304 3BB8 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   305 3BBB A9 F0			lda #>WIN_SAVE_VRAM
   306 3BBD 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   307 3BC0 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 3BC2 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3BC5 4C 2F 3C			jmp Text_Window_Kick
   310
   311 3BC8			Text_Window_Restore
   312 3BC8 20 EF 3B			jsr Text_Window_Setup
   313 3BCB A9 00			lda #<WIN_SAVE_VRAM
   314 3BCD 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3BD0 A9 F0			lda #>WIN_SAVE_VRAM
   316 3BD2 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3BD5 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3BD7 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3BDA A5 83			lda Reg4
   320 3BDC 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   321 3BDF A5 84			lda Reg5
   322 3BE1 18				clc
   323 3BE2 69 30			adc #$30
   324 3BE4 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   325 3BE7 A9 02			lda #$02
   326 3BE9 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   327 3BEC 4C 2F 3C			jmp Text_Window_Kick
   328
   329 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   330 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   331 3BEF			Text_Window_Setup
   332 3BEF A9 00			lda #$00
   333 3BF1 85 83			sta Reg4
   334 3BF3 85 84			sta Reg5
   335 3BF5 AE B0 06			ldx Txt_Row
   336 3BF8 F0 0E			beq Text_Window_Setup_Col
   337 3BFA			Text_Window_Setup_RowL
   338 3BFA A5 83			lda Reg4
   339 3BFC 18				clc
   340 3BFD 69 A0			adc #TEXT_PITCH
   341 3BFF 85 83			sta Reg4
   342 3C01 90 02			bcc Text_Window_Setup_RowNC
   343 3C03 E6 84			inc Reg5
   344 3C05			Text_Window_Setup_RowNC
   345 3C05 CA				dex
   346 3C06 D0 F2			bne Text_Window_Setup_RowL
   347 3C08			Text_Window_Setup_Col
   348 3C08 AD B1 06			lda Txt_Col
   349 3C0B 0A				asl
   350 3C0C 18				clc
   351 3C0D 65 83			adc Reg4
   352 3C0F 85 83			sta Reg4
   353 3C11 90 02			bcc Text_Window_Setup_ColNC
   354 3C13 E6 84			inc Reg5
   355 3C15			Text_Window_Setup_ColNC
   356 3C15 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   357 3C17				vbsta VBXE_MA_BSEL
