   117 				;-----------------------------------------------------------------------------
   118 				; SDX_Con_Xio32   - XIO 32,#0,12,0,"E:"  - tell the soft console to move its
   119 				;                   display list + screen memory and fix its internal pointers.
   120 				; SDX_Con_ModeCall - XIO <SDX_Con_Func>,#0,12,A,"E:"   A = AUX2 (0 disable
   121 				;                   extended console, 128 enable).  Shares the CIO tail.
   122 				;-----------------------------------------------------------------------------
   123 32C4			SDX_Con_Xio32
   124 32C4 A2 00			ldx #SDX_CON_IOCB
   125 32C6 A9 20			lda #$20								; XIO 32
   126 32C8 9D 42 03			sta ICCOM,x
   127 32CB A9 00			lda #$00
   128 32CD 9D 4B 03			sta ICAX2,x
   129 32D0 4C DE 32			jmp SDX_Con_XioTail
   130
   131 32D3			SDX_Con_ModeCall
   132 32D3 A2 00			ldx #SDX_CON_IOCB
   133 32D5 9D 4B 03			sta ICAX2,x
   134 32D8 AD 14 33			lda SDX_Con_Func
   135 32DB 9D 42 03			sta ICCOM,x
   136 32DE			SDX_Con_XioTail
   137 32DE A9 0C			lda #SDX_CON_RW
   138 32E0 9D 4A 03			sta ICAX1,x
   139 32E3 A9 11			lda #<SDX_Con_EDev
   140 32E5 9D 44 03			sta ICBAL,x
   141 32E8 A9 33			lda #>SDX_Con_EDev
   142 32EA 9D 45 03			sta ICBAH,x
   143 32ED 4C 56 E4			jmp CIOV
   144
   145 				;-----------------------------------------------------------------------------
   146 				; SDX_Con_PutByte - PUT the byte in A to IOCB #0 as a real 1-byte buffer (not
   147 				; the zero-length-outputs-A quirk), so it goes through the soft console's
   148 				; handler the same way it goes through the ROM editor.
   149 				;-----------------------------------------------------------------------------
   150 32F0			SDX_Con_PutByte
   151 32F0 8D 16 33			sta SDX_Con_OutChar
   152 32F3 A2 00			ldx #SDX_CON_IOCB
   153 32F5 A9 0B			lda #$0B								; PUT BYTES
   154 32F7 9D 42 03			sta ICCOM,x
   155 32FA A9 16			lda #<SDX_Con_OutChar
   156 32FC 9D 44 03			sta ICBAL,x
   157 32FF A9 33			lda #>SDX_Con_OutChar
   158 3301 9D 45 03			sta ICBAH,x
   159 3304 A9 01			lda #$01
   160 3306 9D 48 03			sta ICBLL,x
   161 3309 A9 00			lda #$00
   162 330B 9D 49 03			sta ICBLH,x
   163 330E 4C 56 E4			jmp CIOV
   164
   165 3311			SDX_Con_EDev
   166 3311 45 3A 9B			dta c"E:",$9B
   167
   168 3314			.var SDX_Con_OutChar	.byte				; 1-byte PUT buffer for SDX_Con_PutByte
   168 = 3314 00		SDX_CON_FUNC
   168 = 3315 00		SDX_CON_WASEXT
   168 = 3316 00		SDX_CON_OUTCHAR
   470 3317			.endpg
