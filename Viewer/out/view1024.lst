  2441 				;=============================================================================
  2442 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2443 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2444 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2445 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2446 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits record 0 (the title rule,
  2447 				; pinned to row 0) plus a 19-row scrolling window of the rest - two
  2448 				; BLT_NFO_DRAW copies per scroll, no reformat, no re-walk.
  2449 				;=============================================================================
  2450
  2451 				;-----------------------------------------------------------------------------
  2452 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2453 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2454 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2455 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2456 				; off screen.
  2457 				;-----------------------------------------------------------------------------
  2458 5DA8			Info_Load
  2459 5DA8 A9 25			lda #NFO_BUF_BANK
  2460 5DAA 85 8E			sta BankIndex
  2461 5DAC 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2462 5DAF AD 2D 31			lda LoadStatus
  2463 5DB2 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2464 5DB4 20 B8 5D			jsr Info_Count_Lines				; sets Nfo_LineCount
  2465 5DB7			Info_Load_Ret
  2466 5DB7 60				rts
  2467
  2468 				;-----------------------------------------------------------------------------
  2469 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2470 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2471 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2472 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2473 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2474 				;-----------------------------------------------------------------------------
  2475 5DB8			Info_Count_Lines
  2476 5DB8 A9 00			lda #$00
  2477 5DBA 8D DE 04			sta Nfo_LineCount
  2478 5DBD 8D DF 04			sta Nfo_LineCount + $01
  2479 5DC0 A9 25			lda #NFO_BUF_BANK
  2480 5DC2 8D 50 06			sta Nfo_WalkBank
  2481 5DC5 09 80			ora #MEMAC_GLOBAL_ENABLE
  2482 5DC7				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5DC7 A0 5F			ldy #<VBXE_MA_BSEL
     3 5DC9 91 93			sta (VBXEBase),y
Source: ui.asm
  2483 5DCB A9 00			lda #<VBXE_WINDOW
  2484 5DCD 85 88			sta Ptr_Lo
  2485 5DCF A9 20			lda #>VBXE_WINDOW
  2486 5DD1 85 89			sta Ptr_Hi
  2487 5DD3			Info_Count_L1
  2488 5DD3 A0 00			ldy #$00
  2489 5DD5 B1 88			lda (Ptr_Lo),y
  2490 5DD7 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2491 5DD9 EE DE 04			inc Nfo_LineCount
  2492 5DDC AD DE 04			lda Nfo_LineCount
  2493 5DDF C9 7F			cmp #NFO_MAX_LINES
  2494 5DE1 B0 24			bcs Info_Count_Done					; hit the record cap
  2495 5DE3 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2496 5DE5 18				clc
  2497 5DE6 69 A0			adc #TEXT_PITCH
  2498 5DE8 85 88			sta Ptr_Lo
  2499 5DEA 90 E7			bcc Info_Count_L1
  2500 5DEC E6 89			inc Ptr_Hi
  2501 5DEE A5 89			lda Ptr_Hi
  2502 5DF0 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2503 5DF2 90 DF			bcc Info_Count_L1
  2504 5DF4 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2505 5DF6 85 89			sta Ptr_Hi
  2506 5DF8 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2507 5DFB AD 50 06			lda Nfo_WalkBank
  2508 5DFE 09 80			ora #MEMAC_GLOBAL_ENABLE
  2509 5E00				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5E00 A0 5F			ldy #<VBXE_MA_BSEL
     3 5E02 91 93			sta (VBXEBase),y
Source: ui.asm
  2510 5E04 4C D3 5D			jmp Info_Count_L1
  2511 5E07			Info_Count_Done
  2512 5E07 A9 00			lda #MEMAC_GLOBAL_DISABLE
  2513 5E09				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5E09 A0 5F			ldy #<VBXE_MA_BSEL
     3 5E0B 91 93			sta (VBXEBase),y
Source: ui.asm
  2514 5E0D 60				rts
