  2272 5ABB			Folder_Path_Push_Name
  2273 5ABB A0 00			ldy #$00
  2274 5ABD			Folder_Path_Push_L1
  2275 5ABD B9 CD 04			lda Name_Row_Buf,y
  2276 5AC0 F0 0D			beq Folder_Path_Push_Sep
  2277 5AC2 C9 20			cmp #' '
  2278 5AC4 F0 09			beq Folder_Path_Push_Sep
  2279 5AC6 9D 28 06			sta Scan_Path,x
  2280 5AC9 E8				inx
  2281 5ACA C8				iny
  2282 5ACB C0 08			cpy #$08
  2283 5ACD 90 EE			bcc Folder_Path_Push_L1
  2284 5ACF			Folder_Path_Push_Sep
  2285 5ACF A9 3E			lda #'>'
  2286 5AD1 9D 28 06			sta Scan_Path,x
  2287 5AD4 E8				inx
  2288 5AD5 A9 00			lda #$00
  2289 5AD7 9D 28 06			sta Scan_Path,x
  2290 5ADA 60				rts
