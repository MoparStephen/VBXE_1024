  1433 5553 AD C7 04			lda Sel_Index
  1434 5556 20 E9 50			jsr Selector_HiRow					; highlight the cell we moved to
  1435 5559			Sel_Key_Nav_Done
  1436 5559 20 A0 51			jsr Selector_DrawStatus				; row 20: source name of the new row
  1437 555C 4C B7 37			jmp Read_Key_Done
