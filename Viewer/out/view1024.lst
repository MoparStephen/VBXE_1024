  2934 				;=============================================================================
  2935 				; UI strings  (ATASCII; the text renderer maps to internal codes)
  2936 				;=============================================================================
  2937 				; TXT_PEN,<pen> switches colour mid-string and takes no column (text80.asm),
  2938 				; so these lay out exactly as their plain text.
  2939 629C 4C 6F 63 61 74 69 + UI_Str_Loc			dta c'Location: ',0	; drawn in UI_PEN_LOC, the same pen as the path
  2940 62A7 01 1B 2A 20 4E 6F + UI_Str_Empty		dta TXT_PEN,UI_PEN_EMPTY,c'* No images *',0
  2941 				; Status panel rows 20-22: each starts with a 3-letter tag + ':' in UI_PEN_LOC.
  2942 				; Row 21 = "Cfg:" (col 0) + the delay (cols 5-6) + UI_Str_DelayHint (col 7);
  2943 				; row 22 = UI_Str_Legend (col 0).  Both rows are exactly 80 cells.
  2944 62B7 01 7C 43 66 67 3A + UI_Str_Delay		dta TXT_PEN,UI_PEN_LOC,c'Cfg:',0
  2945 62BE 01 3A 20 73 65 63 + UI_Str_DelayHint	dta TXT_PEN,UI_PEN_VALUE,c' sec '
  2946 62C5 01 43 3C 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'<',TXT_PEN,UI_PEN_DESC,c' Less '
  2947 62D0 01 43 3E 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'>',TXT_PEN,UI_PEN_DESC,c' More                  Press '
  2948 62F2 01 43 48 45 4C 50 + 					dta TXT_PEN,UI_PEN_KEY,c'HELP',TXT_PEN,UI_PEN_DESC,c' for additional information',0
  2949 6316 01 7C 4E 61 76 3A + UI_Str_Legend		dta TXT_PEN,UI_PEN_LOC,c'Nav: ',TXT_PEN,UI_PEN_KEY
  2950 631F 18 19 1B 1A							dta $18,$19,$1B,$1A					; CP437 up down left right (both fonts)
  2951 6323 01 3A 20 53 65 6C + 					dta TXT_PEN,UI_PEN_DESC,c' Select '
  2952 632D 01 43 45 6E 74 65 + 					dta TXT_PEN,UI_PEN_KEY,c'Enter',TXT_PEN,UI_PEN_DESC,c' Choose '
  2953 633E 01 43 53 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'S',TXT_PEN,UI_PEN_DESC,c' Slideshow '
  2954 634E 01 43 44 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'D',TXT_PEN,UI_PEN_DESC,c' Drive '
  2955 635A 01 43 50 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'P',TXT_PEN,UI_PEN_DESC,c' Palette '
  2956 6368 01 43 49 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'I',TXT_PEN,UI_PEN_DESC,c' Info '
  2957 6373 01 43 46 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'F',TXT_PEN,UI_PEN_DESC,c' Font '
  2958 637E 01 43 51 01 3A 20 + 					dta TXT_PEN,UI_PEN_KEY,c'Q',TXT_PEN,UI_PEN_DESC,c' Quit',0
  2959 				; Info screen row 22 (col 0, 80 cells) - same scheme as UI_Str_Legend; the two
  2960 				; arrows are CP437 codes both fonts carry.
  2961 6389 01 7C 4E 61 76 3A + UI_Str_InfoHint		dta TXT_PEN,UI_PEN_LOC,c'Nav: ',TXT_PEN,UI_PEN_KEY,c'ESC'
  2962 6395 01 3A 20 47 6F 20 + 					dta TXT_PEN,UI_PEN_DESC,c' Go Back ',TXT_PEN,UI_PEN_KEY
  2963 63A2 18 19 01 3A 20 53 + 					dta $18,$19,TXT_PEN,UI_PEN_DESC,c' Scroll ',TXT_PEN,UI_PEN_KEY
  2964 63B0 1B 1A 01 3A 20 50 + 					dta $1B,$1A,TXT_PEN,UI_PEN_DESC,c' Page         Press '
  2965 63C8 01 43 48 45 4C 50 + 					dta TXT_PEN,UI_PEN_KEY,c'HELP',TXT_PEN,UI_PEN_DESC,c' for additional information',0
  2966 				; Help page (UI_Mode 7): title on row 0, nav hint on row 22.
  2967 				; Row 0 banner: 29 '=' + 22-char title + 29 '=' (80 cells).  The '=' sweep is
  2968 				; the .nfo report rule - Convertor/nfo_encode.py RULE_ATTRS, run-length coded
  2969 				; ($38 x5, $39 x5, $3A x6, $3B x5, $3C x5, $3D x3 each side, mirrored) - and
  2970 				; the title is its PEN_TITLE ($0F bright gold).  The version digits come from
  2971 				; V_0..V_3 (view1024.asm), so the title stays 22 cells whatever V_3 holds
  2972 				; (a letter, or $00 = a space).
  2973 63EC 01 38 3D 3D 3D 3D + UI_Str_HelpTitle	dta TXT_PEN,$38,c'=====',TXT_PEN,$39,c'=====',TXT_PEN,$3A,c'======'
  2974 6402 01 3B 3D 3D 3D 3D + 					dta TXT_PEN,$3B,c'=====',TXT_PEN,$3C,c'=====',TXT_PEN,$3D,c'==='
