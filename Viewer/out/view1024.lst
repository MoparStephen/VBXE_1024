  2749 				;=============================================================================
  2750 				; Shared directory helpers
  2751 				;-----------------------------------------------------------------------------
  2752 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2753 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2754 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2755 				; navigation lives in the selector itself.
  2756 				;=============================================================================
  2757
  2758 				;-----------------------------------------------------------------------------
  2759 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2760 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2761 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2762 				;-----------------------------------------------------------------------------
  2763 5EF7			Line_Has_Dir_Tag
  2764 5EF7 A2 00			ldx #$00
  2765 5EF9			Line_Has_Dir_Tag_L1
  2766 5EF9 BD 00 06			lda Dir_Line_Buf,x
  2767 5EFC C9 3C			cmp #'<'
  2768 5EFE D0 1F			bne Line_Has_Dir_Tag_Next
  2769 5F00 BD 01 06			lda Dir_Line_Buf+1,x
  2770 5F03 C9 44			cmp #'D'
  2771 5F05 D0 18			bne Line_Has_Dir_Tag_Next
  2772 5F07 BD 02 06			lda Dir_Line_Buf+2,x
  2773 5F0A C9 49			cmp #'I'
  2774 5F0C D0 11			bne Line_Has_Dir_Tag_Next
  2775 5F0E BD 03 06			lda Dir_Line_Buf+3,x
  2776 5F11 C9 52			cmp #'R'
  2777 5F13 D0 0A			bne Line_Has_Dir_Tag_Next
  2778 5F15 BD 04 06			lda Dir_Line_Buf+4,x
  2779 5F18 C9 3E			cmp #'>'
  2780 5F1A D0 03			bne Line_Has_Dir_Tag_Next
  2781 5F1C A9 01			lda #$01							; found
  2782 5F1E 60				rts
  2783 5F1F			Line_Has_Dir_Tag_Next
  2784 5F1F E8				inx
  2785 5F20 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2786 5F22 90 D5			bcc Line_Has_Dir_Tag_L1
  2787 5F24 A9 00			lda #$00							; not found
  2788 5F26 60				rts
  2789
  2790 				;-----------------------------------------------------------------------------
  2791 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2792 				; space-padded).  Refuses if the result would not fit.
  2793 				;-----------------------------------------------------------------------------
  2794 5F27			Folder_Path_Push
  2795 5F27 A2 00			ldx #$00
  2796 5F29			Folder_Path_Push_End
  2797 5F29 BD 28 06			lda Scan_Path,x
  2798 5F2C F0 06			beq Folder_Path_Push_Name
  2799 5F2E E8				inx
  2800 5F2F E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2801 5F31 90 F6			bcc Folder_Path_Push_End
  2802 5F33 60				rts									; path too long already - refuse
  2803 5F34			Folder_Path_Push_Name
  2804 5F34 A0 00			ldy #$00
  2805 5F36			Folder_Path_Push_L1
  2806 5F36 B9 CD 04			lda Name_Row_Buf,y
  2807 5F39 F0 0D			beq Folder_Path_Push_Sep
  2808 5F3B C9 20			cmp #' '
  2809 5F3D F0 09			beq Folder_Path_Push_Sep
  2810 5F3F 9D 28 06			sta Scan_Path,x
  2811 5F42 E8				inx
  2812 5F43 C8				iny
  2813 5F44 C0 08			cpy #$08
  2814 5F46 90 EE			bcc Folder_Path_Push_L1
  2815 5F48			Folder_Path_Push_Sep
  2816 5F48 A9 3E			lda #'>'
  2817 5F4A 9D 28 06			sta Scan_Path,x
  2818 5F4D E8				inx
  2819 5F4E A9 00			lda #$00
  2820 5F50 9D 28 06			sta Scan_Path,x
  2821 5F53 60				rts
  2822
  2823 				;-----------------------------------------------------------------------------
  2824 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2825 				;-----------------------------------------------------------------------------
  2826 5F54			Path_Pop_Segment
  2827 5F54 A2 00			ldx #$00
  2828 5F56			Path_Pop_End
  2829 5F56 BD 28 06			lda Scan_Path,x
  2830 5F59 F0 05			beq Path_Pop_Found
  2831 5F5B E8				inx
  2832 5F5C E0 28			cpx #$28
  2833 5F5E 90 F6			bcc Path_Pop_End
  2834 5F60			Path_Pop_Found							; X = index of the NUL
  2835 5F60 E0 00			cpx #$00
  2836 5F62 F0 13			beq Path_Pop_Done					; already empty
  2837 5F64 CA				dex									; step onto the trailing '>'
  2838 5F65			Path_Pop_L1
  2839 5F65 E0 00			cpx #$00
  2840 5F67 F0 09			beq Path_Pop_Cut
  2841 5F69 CA				dex
  2842 5F6A BD 28 06			lda Scan_Path,x
  2843 5F6D C9 3E			cmp #'>'
  2844 5F6F D0 F4			bne Path_Pop_L1
  2845 5F71 E8				inx									; keep this separator
  2846 5F72			Path_Pop_Cut
  2847 5F72 A9 00			lda #$00
  2848 5F74 9D 28 06			sta Scan_Path,x
  2849 5F77			Path_Pop_Done
  2850 5F77 60				rts
