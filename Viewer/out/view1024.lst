  1841 				;-----------------------------------------------------------------------------
  1842 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1843 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1844 				; equal) otherwise.
  1845 				;-----------------------------------------------------------------------------
  1846 3C52			Cmp_Records
  1847 3C52 A0 00			ldy #$00
  1848 3C54			Cmp_Records_L1
  1849 3C54 B1 8A			lda (Name_Ptr),y
  1850 3C56 D1 8C			cmp (Sort_Ptr),y
  1851 3C58 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1852 3C5A C8				iny
  1853 3C5B C0 08			cpy #$08
  1854 3C5D 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1855 3C5F			Cmp_Records_Done
  1856 3C5F 60				rts
