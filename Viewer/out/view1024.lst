  1538 				;-----------------------------------------------------------------------------
  1539 				; Sort_Range - in-place alphabetical selection sort of the records
  1540 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1541 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1542 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1543 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1544 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1545 				;-----------------------------------------------------------------------------
  1546 39A7			Sort_Range
  1547 39A7 E0 02			cpx #$02
  1548 39A9 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1549 39AB 85 81			sta Reg2							; Reg2 = i = start
  1550 39AD 86 82			stx Reg3							; Reg3 = count (temp)
  1551 39AF 18				clc
  1552 39B0 65 82			adc Reg3
  1553 39B2 85 84			sta Reg5							; Reg5 = end = start + count
  1554 39B4 38				sec
  1555 39B5 E9 01			sbc #$01
  1556 39B7 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1557
  1558 39B9 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1559 39BB				vbsta VBXE_MA_BSEL
