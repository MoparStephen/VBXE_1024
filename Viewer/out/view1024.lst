  2070 				;-----------------------------------------------------------------------------
  2071 				; Slideshow_Reload_Counter - Slide_FrameCtr = Slide_Secs * framerate
  2072 				;   framerate = 50 (PAL, Video_Flag = 0) or 60 (NTSC, Video_Flag = 1)
  2073 				;-----------------------------------------------------------------------------
  2074 5A92			Slideshow_Reload_Counter
  2075 5A92 A9 00			lda #$00
  2076 5A94 8D CA 04			sta Slide_FrameCtr
  2077 5A97 8D CB 04			sta Slide_FrameCtr+1
  2078 5A9A AE C9 04			ldx Slide_Secs
  2079 5A9D F0 1E			beq Slideshow_Reload_Done
  2080 5A9F AD 89 04			lda Video_Flag
  2081 5AA2 D0 04			bne Slideshow_Reload_NTSC
  2082 5AA4 A9 32			lda #50
  2083 5AA6 D0 02			bne Slideshow_Reload_Set
  2084 5AA8			Slideshow_Reload_NTSC
  2085 5AA8 A9 3C			lda #60
  2086 5AAA			Slideshow_Reload_Set
  2087 5AAA 85 80			sta Reg1							; Reg1 = frames to add per second
  2088 5AAC			Slideshow_Reload_L1
  2089 5AAC 18				clc
  2090 5AAD AD CA 04			lda Slide_FrameCtr
  2091 5AB0 65 80			adc Reg1
  2092 5AB2 8D CA 04			sta Slide_FrameCtr
  2093 5AB5 90 03			bcc Slideshow_Reload_NoCarry
  2094 5AB7 EE CB 04			inc Slide_FrameCtr+1
  2095 5ABA			Slideshow_Reload_NoCarry
  2096 5ABA CA				dex
  2097 5ABB D0 EF			bne Slideshow_Reload_L1
  2098 5ABD			Slideshow_Reload_Done
  2099 5ABD 60				rts
