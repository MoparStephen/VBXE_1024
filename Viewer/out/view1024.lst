   145 				;-----------------------------------------------------------------------------
   146 				; SDX_Con_PutByte - PUT the byte in A to IOCB #0 as a real 1-byte buffer (not
   147 				; the zero-length-outputs-A quirk), so it goes through the soft console's
   148 				; handler the same way it goes through the ROM editor.
   149 				;-----------------------------------------------------------------------------
   150 32F0			SDX_Con_PutByte
   151 32F0 8D 16 33			sta SDX_Con_OutChar
   152 32F3 A2 00			ldx #SDX_CON_IOCB
   153 32F5 A9 0B			lda #$0B								; PUT BYTES
   154 32F7 9D 42 03			sta ICCOM,x
   155 32FA A9 16			lda #<SDX_Con_OutChar
   156 32FC 9D 44 03			sta ICBAL,x
   157 32FF A9 33			lda #>SDX_Con_OutChar
   158 3301 9D 45 03			sta ICBAH,x
   159 3304 A9 01			lda #$01
   160 3306 9D 48 03			sta ICBLL,x
   161 3309 A9 00			lda #$00
   162 330B 9D 49 03			sta ICBLH,x
   163 330E 4C 56 E4			jmp CIOV
   164
   165 3311			SDX_Con_EDev
   166 3311 45 3A 9B			dta c"E:",$9B
