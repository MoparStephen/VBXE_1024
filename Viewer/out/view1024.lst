  2599 				;-----------------------------------------------------------------------------
  2600 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2601 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2602 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2603 				;-----------------------------------------------------------------------------
  2604 615C			Info_Body_Rows
