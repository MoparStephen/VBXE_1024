  2314 				;-----------------------------------------------------------------------------
  2315 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2316 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2317 				; the whole .NFO is shorter than the window, clear first and blit only the
  2318 				; records that exist.
  2319 				;-----------------------------------------------------------------------------
  2320 5BD6			Info_Draw
  2321 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2322 5BD6 38				sec
  2323 5BD7 AD DE 04			lda Nfo_LineCount
  2324 5BDA ED DC 04			sbc Nfo_Top
  2325 5BDD 85 84			sta Reg5
  2326 5BDF AD DF 04			lda Nfo_LineCount + $01
  2327 5BE2 ED DD 04			sbc Nfo_Top + $01
  2328 5BE5 85 85			sta Reg6
  2329 				; rows = min(available, NFO_VISROWS)
  2330 5BE7 A5 85			lda Reg6
  2331 5BE9 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2332 5BEB A5 84			lda Reg5
  2333 5BED C9 14			cmp #NFO_VISROWS
  2334 5BEF B0 10			bcs Info_Draw_Full
  2335 				; short document: clear, then blit only the records that exist
  2336 5BF1 A5 84			lda Reg5
  2337 5BF3 85 83			sta Reg4
  2338 5BF5 20 F9 3A			jsr Text_Clear
  2339 5BF8 A5 83			lda Reg4
  2340 5BFA F0 68			beq Info_Draw_Ret					; nothing to draw
  2341 5BFC C6 83			dec Reg4							; Reg4 = height-1
  2342 5BFE 4C 05 5C			jmp Info_Draw_Blit
  2343 5C01			Info_Draw_Full
  2344 5C01 A9 13			lda #NFO_VISROWS-1
  2345 5C03 85 83			sta Reg4
  2346 5C05			Info_Draw_Blit
  2347 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2348 5C05 A9 00			lda #$00
  2349 5C07 85 80			sta Reg1
  2350 5C09 85 81			sta Reg2
  2351 5C0B AE DC 04			ldx Nfo_Top
  2352 5C0E F0 0E			beq Info_Draw_Patch
  2353 5C10			Info_Draw_MulL
  2354 5C10 A5 80			lda Reg1
  2355 5C12 18				clc
  2356 5C13 69 A0			adc #TEXT_PITCH
  2357 5C15 85 80			sta Reg1
  2358 5C17 90 02			bcc Info_Draw_MulNC
  2359 5C19 E6 81			inc Reg2
  2360 5C1B			Info_Draw_MulNC
  2361 5C1B CA				dex
  2362 5C1C D0 F2			bne Info_Draw_MulL
  2363 5C1E			Info_Draw_Patch
  2364 5C1E A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2365 5C20				vbsta VBXE_MA_BSEL
