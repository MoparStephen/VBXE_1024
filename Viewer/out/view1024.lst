   135 3ACD AA				tax									; hold it - vbsta clobbers A (and Y)
   136 3ACE A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the $2000 window
   137 3AD0				vbsta VBXE_MA_BSEL
