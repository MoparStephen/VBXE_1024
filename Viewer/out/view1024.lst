  1870 3C4F 20 B9 3C			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1871 3C52 20 89 3C			jsr Cmp_Records						; rec(m) : rec(j)
  1872 3C55 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1873 3C57 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1874 3C59 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1875 3C5B 85 83			sta Reg4
  1876 3C5D A5 8C			lda Sort_Ptr
  1877 3C5F 85 8A			sta Name_Ptr
  1878 3C61 A5 8D			lda Sort_Ptr + $01
  1879 3C63 85 8B			sta Name_Ptr + $01
  1880 3C65			Sort_Range_Inner_Next
  1881 3C65 E6 82			inc Reg3
  1882 3C67 4C 47 3C			jmp Sort_Range_Inner
