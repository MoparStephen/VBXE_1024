  1706 3A60 B1 8C			lda (Sort_Ptr),y
  1707 3A62 91 8A			sta (Name_Ptr),y
  1708 3A64 B9 8D 04			lda Path_Buf,y
  1709 3A67 91 8C			sta (Sort_Ptr),y
  1710 3A69 C8				iny
  1711 3A6A C0 08			cpy #$08
  1712 3A6C 90 ED			bcc Swap_Records_L1
  1713 3A6E 60				rts
