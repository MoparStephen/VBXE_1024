   139 = FFFF0001		.def	__VBXE_AUTO__
   140 = 2000			.def	VBXE_WINDOW						= $2000
   141 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   142 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   143 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   144
   145 				; Image name list (built by Rescan_Images - see ui.asm)
   146 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   147 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   148 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   149 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   150 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   151
   152 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   153 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   154 				; ($21000), the name list ($40000) and the dir browser ($41000).
   155 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   156 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   157 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   158 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   159 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   160 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   161 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   162 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   163 = 0050			.def	TEXT_COLS						= 80
   164 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   165 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   166 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   167 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   168 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   169 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   170 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   171 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   172 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   173
   174 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   175 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   176 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   177 = 030000			.def	MENU_BANNER_VRAM				= $30000
   178 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   179 = 0024			.def	MENU_BANNER_ROWS				= 36
   180 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   181 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   182 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   183 = 00A0			.def	MENU_SEP_PITCH					= 160
   184 = 0007			.def	MENU_SEP_FILL_COLOUR			= $07		; white in the modified A8 palette (Palette 0)  Palette is modified so text can use all 128 colours
   185
   186 				; Banner palette + attribute map: loaded from disk ONCE at boot and never
   187 				; touched again (unlike the real image viewer's $21000/$017000 scratch, which
   188 				; Load_Image legitimately overwrites for every image view).  Dedicated,
   189 				; resident VRAM so the banner never needs a disk reload - see
   190 				; Load_Menu_Banner_Raw / Apply_Menu_Banner_Palette (below) and Setup_Menu_Cmap.
   191 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   192 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   193 																	; - palette register 0 is reserved for text
   194 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   195 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   196 																	; XDL_MainMenu's banner MAPADR points here, NOT
   197 																	; at the shared $017000 CRAM
   198
   199 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   200 				; converter emits it as this exact byte image of the text screen - fixed
   201 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   202 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   203 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   204 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   205 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   206 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   207
   208 				; Selector status-line long-name cache.  One NFO_NAME_SLOT-byte slot per image
   209 				; ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   210 				; Rescan_Images (the converter writes that file - 8-byte key + source name per
   211 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  64
   212 				; divides 4K so no slot straddles a bank; 255*64 = $3FC0 -> banks $2A-$2D.
   213 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   214 = 02A000			.def	NFO_NAME_VRAM					= $2A000
   215 = 002A			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $2A
   216 = 0040			.def	NFO_NAME_SLOT					= 64		; bytes per image slot
   217 = 0030			.def	NFO_NAME_CAP						= 48		; chars shown on the status line
   218
   219 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   220 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   221 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   222 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   223 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   224 = 0006			.def	DRIVE_WIN_ROW					= 6
   225 = 001E			.def	DRIVE_WIN_COL					= 30
   226 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   227 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   228
   229 				; Quit-confirm popup (UI_Mode 5) - "Are you sure to Quit" + (Y/N), Selector only.
   230 = 0008			.def	QUIT_WIN_ROW					= 8
   231 = 0016			.def	QUIT_WIN_COL					= 22
   232 = 0024			.def	QUIT_WIN_W						= 36		; cells wide  (border + text + border)
   233 = 0005			.def	QUIT_WIN_H						= 5		; rows        (border + text + hint + border, +1)
   234
   235 				; BCB field byte offsets
   236 = 0000			.def	Src_Adr0						= $00
   237 = 0001			.def	Src_Adr1						= $01
   238 = 0002			.def	Src_Adr2						= $02
   239 = 0006			.def	Dest_Adr0						= $06
   240 = 0007			.def	Dest_Adr1						= $07
   241 = 0008			.def	Dest_Adr2						= $08
   242 = 000C			.def	Blt_W0							= $0C	; Width-1  low byte
   243 = 000D			.def	Blt_W1							= $0D	; Width-1  bit 8
   244 = 000E			.def	Blt_H							= $0E	; Height-1
   245 = 000F			.def	Blt_And							= $0F	; And mask (0 = constant source)
   246 = 0010			.def	Blt_Xor							= $10	; Xor mask (= fill value when And = 0)
   247 = 0014			.def	Blt_Ctrl						= $14
   248
   249 				; Temp debug stuff
   250 = 0010			.def	V_0								= $10	; 0 (Screen code used for Version in loading screen)
   251 = 0011			.def	V_1								= $11	; 1 (Screen code used for Version in loading screen)
   252 = 0014			.def	V_2								= $14	; 3 (Screen code used for Version in loading screen)
   253 = 0000			.def	V_3								= $00	; 61=a (Screen code used for Version in loading screen)
