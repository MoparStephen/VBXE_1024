   311 				; FP ROM ($D800-$DFFF)
   312 = D800			AFP         equ $D800					; ASCII to FP
   313 = D8E6			FASC        equ $D8E6					; FP to ASCII
   314 = D9AA			IFP         equ $D9AA					; Integer to FP
   315 = D9D2			FPI         equ $D9D2					; FP to integer
   316 = DA44			ZFR0        equ $DA44					; Clear FR0
   317 = DA46			ZF1         equ $DA46					; Clear zero page FP buffer
   318 = DA60			FSUB        equ $DA60					; FR0 - FR1
   319 = DA66			FADD        equ $DA66					; FR0 + FR1
   320 = DADB			FMUL        equ $DADB					; FR0 * FR1
   321 = DB28			FDIV        equ $DB28					; FR0 / FR1
   322 = DD40			PLYEVL      equ $DD40					; Polynomial evaluation
   323 = DD89			FLD0R       equ $DD89					; Load FR0 by X,Y register pointer
   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    78
    79 				;-----------------------------------------------------------------------------
    80 				; Structure Declarations
    81 				;-----------------------------------------------------------------------------
    82
    83 				;-----------------------------------------------------------------------------
    84 				; Variables go here
    85 				;-----------------------------------------------------------------------------
    86 				; Page 0 user data ($80 to $FF with some reserved for OS)
    87 				.zpvar Reg1				.byte			; Multi-Use Variables
    88 				.zpvar Reg2				.byte			; Multi-Use Variables
    89 				.zpvar Reg3				.byte			; Multi-Use Variables
    90 				.zpvar Reg4				.byte			; Multi-Use Variables
    91 				.zpvar Reg5				.byte			; Multi-Use Variables
    92 				.zpvar Reg6				.byte			; Multi-Use Variables
    93 				.zpvar Reg7				.byte			; Multi-Use Variables
    94 				.zpvar Reg8				.byte			; Multi-Use Variables
    95 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    96 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    97 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    98 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    99
   100 				; Non Page-0 Variables
   101 				;	$480 to $4FF free
   102 				;	$600 to $6FF free
   103 				; When using PMG the 1st $300 bytes are always free
   104 				.var SDMCTL_OLD			.byte = $480	; Save DMA
   105 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
   106 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
   107 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
   108 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   109 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   110 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   111 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   112 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   113 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   114 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   115 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   116 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   117 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   118 				; --- viewer UI state (ui.asm) ---
   119 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 5 quit / 6 P-preview / 7 help
   120 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   121 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   122 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   123 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   124 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   125 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   126 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   127 				.var FileStart			.byte = $4DA	; selector list: index of the first *.V1K row (= upCount + Dir_Count)
   128 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   129 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   130 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   131 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   132 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   133 				; --- single-file .V1K image loader (Image_Open / Image_Read_Segment) ---
   134 				.var Load_IOCB			.byte = $4E2	; IOCB offset of the open .V1K file
   135 				.var Seg_Bank			.byte = $4E3	; VBXE bank the next 4K chunk lands in
   136 				.var Seg_Chunks			.byte = $4E4	; full 4K chunks left in this segment
   137 				.var Seg_Tail			.word = $4E5	; bytes in the segment's final partial chunk
   138 				.var Pal_Image			.byte = $4E7	; 1 = an image's palettes are in registers 0-3 (Enter_Selector must restore)
   139 				.var Help_Return_Mode	.byte = $4E8	; UI_Mode to go back to when Help closes (0 selector / 4 info)
   140 				.var Help_Page			.byte = $4E9	; help screen section 0..2
   141 				.var Help_Top			.byte = $4EA	; help screen: first visible row of the section (scroll)
   142 				.var Help_RowCount		.byte = $4EB	; help screen: rows in the current section (set by Help_Draw)
   143 				.var Up_Name			:8 .byte = $4EC	; folder being left by "..", space-padded ($4EC-$4F3)
   144 				.var Up_Idx				.byte = $4F4	; Sel_Find_Up_Name: list index being compared
   145 				.var Map_View			.byte = $4F5	; 1 = key-5 view: OVADR -> MAP_FILL_VRAM, entry 1 of palettes 0-3 recoloured
   146 				.var View_Normal		.byte = $4F6	; 1 = image shown through one palette (keys 0-3, XDL_Image_Normal)
   147 				.var Preview_From_Image	.byte = $4F7	; 1 = palette screen (UI_Mode 6) opened from the image - ESC goes back to it
   148 				;	$4F8 to $4FA: RAMTOP_OLD / COLOR1_OLD / COLOR4_OLD (init_vbxe.asm)
   149 				;	$4FB to $4FF free
   150 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   151 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   152 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.V1K",$9B ($650-$67F)
   153 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   154 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP description + $9B) for
   155 				; Nfo_Name_LoadManifest, and the padded status-line text Nfo_Name_Emit builds
   156 				; for Selector_DrawStatus.  8+75+1 = 84 bytes fits no free gap, so it OVERLAYS
   157 				; Scan_Spec + Txt_Line ($650-$6A3).  Safe because neither is live across
   158 				; either use: Scan_Spec is only read by the CIO OPEN before the record loop
   159 				; (and rebuilt before every scan), Txt_Line is per-draw scratch that
   160 				; Text_PutStrAt does not touch, and Nfo_WalkBank ($650) is only live inside
   161 				; Info_Count_Lines (UI_Mode 4, no status line).
   162 				.var Nfo_Name_Line		:84 .byte = $650	; 8 key + 75 desc + $9B ($650-$6A3)
   163 				;	$6B7 to $6FF free (text80.asm uses $6B0-$6B6)
   164 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   165 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   166 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   167 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   168 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   169
   170 				;-----------------------------------------------------------------------------
   171 				; Defines go here
   172 				;-----------------------------------------------------------------------------
   173 = FFFF0001		.def	__VBXE_AUTO__
   174 = 2000			.def	VBXE_WINDOW						= $2000
   175 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   176 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   177 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   178
   179 				; Image name list (built by Rescan_Images - see ui.asm)
   180 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   181 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   182 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   183 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   184 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   185
   186 				; Single-file image: <name>.V1K = .PAL block + .MAP block + .RAW block, no
   187 				; header - every block is fixed-size, so every offset is a constant.
   188 				; Load_Image streams each block to the same VRAM the old 3-file load used.
   189 = 0C00			.def	V1K_PAL_LEN						= $0C00		; 4 palettes x 768     = 3072
   190 = 2580			.def	V1K_MAP_LEN						= $2580		; 40 cells x 240 rows  = 9600
   191 = 012C00			.def	V1K_RAW_LEN						= $12C00	; 320 x 240 pixels     = 76800
   192 = 0021			.def	V1K_PAL_BANK					= $21		; -> $21000 (read back by Apply_Image_Palette)
   193 = 0014			.def	V1K_MAP_BANK					= $14		; -> $14000 (CRAM_Buffer, Setup_Cmap1 expands it)
   194 = 0001			.def	V1K_RAW_BANK					= $01		; -> $01000 (framebuffer)
   195
   196 				; Key-5 attribute-map view: a 320x240 block of solid $01 pixels, filled once
   197 				; by the blitter in clear_vbxe (init_vbxe.asm).  Key 5 points
   198 				; XDL_Image_Attribute's OVADR here, so each 8x1 cell shows palette entry 1.
   199 = 042000			.def	MAP_FILL_VRAM					= $42000	; $42000-$54BFF (same 320-byte step as $01000)
   200 = 1000			.def	IMAGE_VRAM						= $01000	; framebuffer = XDL_Image_Attribute's normal OVADR
   201 = 017000			.def	IMAGE_CRAM						= $17000	; expanded attribute map = its normal MAPADR
   202
   203 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   204 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   205 				; ($21000), the name list ($40000) and the dir browser ($41000).
   206 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   207 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   208 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   209 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   210 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   211 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   212 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   213 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   214 = 0050			.def	TEXT_COLS						= 80
   215 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   216 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   217 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   218 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   219 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   220 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   221 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   222 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   223 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   224 				; Off-screen back buffer, same layout as TEXT_SCREEN_VRAM.  Every text draw
   225 				; (Text_PutStrAt / Text_Clear / Text_FillColour / save-under / NFO blit) lands
   226 				; here; Text_Present copies it to the displayed buffer with one blit in vblank,
   227 				; so no partly-drawn screen is ever shown.  3680 bytes - fits one bank.
   228 = 02A000			.def	TEXT_BACK_VRAM					= $2A000
   229 = 002A			.def	TEXT_BACK_BANK					= TEXT_BACK_VRAM / $1000	; = $2A
   230
   231 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   232 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   233 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   234 = 030000			.def	MENU_BANNER_VRAM				= $30000
   235 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   236 = 0024			.def	MENU_BANNER_ROWS				= 36
   237 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   238 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   239 = 034000			.def	MENU_SEP_VRAM					= $34000	; next free bank after the banner (3 banks)
   240 = 00A0			.def	MENU_SEP_PITCH					= 160		; 160-byte pattern table, Palette 0 (modified) indices -
   241 																		; Assets/MENU_SEP.RAW, loaded once by Load_Menu_Sep (init_vbxe.asm)
   242
   243 				; Banner palette + attribute map: never touched at runtime (unlike the real
   244 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   245 				; overwrites for every image view).  Dedicated, resident VRAM - see
   246 				; Load_Menu_Logo1-3 (init_vbxe.asm) / Apply_Menu_Palettes (below).
   247 				; The palette is generated, not stored (Apply_Menu_Palettes).  The attribute map has no file either: it is left all
   248 				; zeros (= palette 0) by the boot-time clear_vbxe, and Set_Menu_Demo_Attrs
   249 				; sets just the ramp squares' cells.
   250 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   251 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   252 																	; XDL_MainMenu's banner MAPADR points here, NOT
   253 																	; at the shared $017000 CRAM
   254
   255 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   256 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   257 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   258 				; unchanged) but horizontally mirrored via the attribute map only -
   259 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   260 				; Squares, Set_Menu_Demo_Attrs (below).
   261 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   262 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   263 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   264 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   265 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   266 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   267 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   268 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   269 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   270 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   271 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   272 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   273 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   274 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   275
   276 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   277 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   278 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   279 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   280 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   281 = 055000			.def	PAL_PREVIEW_VRAM				= $055000	; own 320x240 frame, built once at boot (Pal_Preview_Init)
   282 = 068000			.def	PAL_PREVIEW_CRAM				= $068000	; own expanded attribute map (40x240 cells x 4 bytes, step $A0)
   283 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   284 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   285 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   286 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   287 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   288 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   289 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   290 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   291 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   292 = 0558F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   293 = 055960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   294 = 05E4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   295 = 05E560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   296 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   297 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   298 				; whole buffer, and palette 0 = $00 is the zero default).
   299 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   300 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   301 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   302 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   303 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   304 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   305 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   306 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   307
   308 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   309 				; converter emits it as this exact byte image of the text screen - fixed
   310 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   311 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   312 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   313 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   314 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   315 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   316
   317 				; Selector status-line description cache.  One NFO_NAME_SLOT-byte slot per
   318 				; image ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   319 				; Rescan_Images (the converter writes that file - 8-byte key + description per
   320 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  128
   321 				; divides 4K so no slot straddles a bank; 255*128 = $7F80 -> banks $37-$3E.
   322 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   323 = 037000			.def	NFO_NAME_VRAM					= $37000
   324 = 0037			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $37
   325 = 0080			.def	NFO_NAME_SLOT					= 128		; bytes per image slot
   326 = 004B			.def	NFO_NAME_CAP						= 75		; chars shown on the status line
   327 																		; ("Src: " + 75 = 80 cols; = the
   328 																		; converter's DESC_CAP)
   329
   330 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   331 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   332 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   333 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   334 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   335 = 0006			.def	DRIVE_WIN_ROW					= 6
   336 = 001E			.def	DRIVE_WIN_COL					= 30
   337 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   338 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   339
   340 				; Quit-confirm popup (UI_Mode 5) - "Are You Sure To Quit" + boxed Y / N buttons
   341 				; (Sel_Key_Quit / Quit_Draw, ui.asm), Selector only.
   342 = 0008			.def	QUIT_WIN_ROW					= 8
   343 = 001C			.def	QUIT_WIN_COL					= 28		; centred: (80 - QUIT_WIN_W) / 2
   344 = 0018			.def	QUIT_WIN_W						= 24		; cells wide  (border + " Are You Sure To Quit " + border)
   345 = 0006			.def	QUIT_WIN_H						= 6		; rows        (border + question + 3-row buttons + border)
   346 = 0005			.def	QUIT_BTN_W						= 5		; Y / N button boxes, 5 x 3 cells
   347 = 0022			.def	QUIT_BTN_Y_COL					= QUIT_WIN_COL+6	; buttons centred, 2 cells apart
   348 = 0029			.def	QUIT_BTN_N_COL					= QUIT_WIN_COL+13
   349
   350 				; BCB field byte offsets
   351 = 0000			.def	Src_Adr0						= $00
   352 = 0001			.def	Src_Adr1						= $01
   353 = 0002			.def	Src_Adr2						= $02
   354 = 0006			.def	Dest_Adr0						= $06
   355 = 0007			.def	Dest_Adr1						= $07
   356 = 0008			.def	Dest_Adr2						= $08
   357 = 0009			.def	Dest_Step_Y0					= $09	; Destination step y, low byte
   358 = 000A			.def	Dest_Step_Y1					= $0A	; Destination step y, high bits
   359 = 000C			.def	Blt_W0							= $0C	; Width-1  low byte
   360 = 000D			.def	Blt_W1							= $0D	; Width-1  bit 8
   361 = 000E			.def	Blt_H							= $0E	; Height-1
   362 = 000F			.def	Blt_And							= $0F	; And mask (0 = constant source)
   363 = 0010			.def	Blt_Xor							= $10	; Xor mask (= fill value when And = 0)
   364 = 0012			.def	Blt_Zoom						= $12	; X/Y zoom (bits 0-2=ZOOMX, 4-6=ZOOMY; factor = field+1)
   365 = 0014			.def	Blt_Ctrl						= $14
