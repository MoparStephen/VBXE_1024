  1883 5749 AD CB 04			lda Slide_FrameCtr+1
  1884 574C F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  1885 574E CE CB 04			dec Slide_FrameCtr+1
  1886 5751			Slideshow_Tick_Dec
  1887 5751 CE CA 04			dec Slide_FrameCtr
  1888 5754 60				rts
