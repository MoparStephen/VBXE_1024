  1642 				;-----------------------------------------------------------------------------
  1643 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1644 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1645 				; crosses the visible window, else just re-colours the old and new cells;
  1646 				; always repaints the status line, then returns to the key loop.
  1647 				;-----------------------------------------------------------------------------
  1648 5A7A			Sel_Nav_Apply
  1649 5A7A 48				pha									; stash the new index
  1650 5A7B AD C7 04			lda Sel_Index
  1651 5A7E 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1652 5A80 68				pla
  1653 5A81 8D C7 04			sta Sel_Index
  1654 5A84 20 A6 5A			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1655 5A87 CD C8 04			cmp Sel_Top
  1656 5A8A F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1657 5A8C 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1658 5A8F 20 C6 54			jsr Selector_DrawList
  1659 5A92 4C A0 5A			jmp Sel_Key_Nav_Done
  1660 5A95			Sel_Nav_Apply_Rows
  1661 5A95 A5 87			lda Reg8
  1662 5A97 20 6A 55			jsr Selector_HiRow					; un-highlight the cell we left
  1663 5A9A AD C7 04			lda Sel_Index
  1664 5A9D 20 6A 55			jsr Selector_HiRow					; highlight the cell we moved to
  1665 5AA0			Sel_Key_Nav_Done
  1666 5AA0 20 9E 56			jsr Selector_DrawStatus				; row 20: description of the new row
  1667 5AA3 4C F5 39			jmp Read_Key_Done
  1668
  1669 				;-----------------------------------------------------------------------------
  1670 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1671 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1672 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1673 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1674 				;-----------------------------------------------------------------------------
  1675 5AA6			Sel_Top_For_Index
  1676 5AA6 4A				lsr
  1677 5AA7 4A				lsr
  1678 5AA8 4A				lsr
  1679 5AA9 85 80			sta Reg1							; Reg1 = target item_row
  1680 5AAB AD C8 04			lda Sel_Top
  1681 5AAE 4A				lsr
  1682 5AAF 4A				lsr
