  1146 577F A9 50			lda #<Nfo_Name_Line
  1147 5781 9D 44 03			sta ICBAL,x
  1148 5784 A9 06			lda #>Nfo_Name_Line
  1149 5786 9D 45 03			sta ICBAH,x
  1150 5789 A9 54			lda #8+NFO_NAME_CAP+1				; buffer length (8 key + 75 desc + $9B = 84)
  1151 578B 9D 48 03			sta ICBLL,x
  1152 578E A9 00			lda #$00
  1153 5790 9D 49 03			sta ICBLH,x
  1154 5793 20 56 E4			jsr CIOV
