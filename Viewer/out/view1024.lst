   240 				;-----------------------------------------------------------------------------
   241 				; Build_Image_List - rebuild the selector list in IMAGE_BANK through the $2000
   242 				; window, grouped:  ".."  (only below the drive root)  |  sub-directories  |
   243 				; *.V1K files.  Rescan_Images sorts the two real groups A-Z afterwards.
   244 				; Sets ImageCount, Dir_Count and FileStart (index of the first *.V1K row).
   245 				;   - directory pass: OPEN "D[n]:PATH*.*" long DIR format (AUX2 = $80) and keep
   246 				;     only lines carrying SDX's "<DIR>" size-column tag (Line_Has_Dir_Tag).
   247 				;   - file pass:      OPEN "D[n]:PATH*.V1K" short format (AUX2 = $00) as before.
   248 				; One 8-byte write cursor (Name_Ptr) and one ImageNames_End guard span both.
   249 				;-----------------------------------------------------------------------------
   250 4F37			Build_Image_List
   251 4F37 A9 00			lda #$00
   252 4F39 8D 8B 04			sta ImageCount
   253 4F3C 8D 8C 04			sta ImageCount+1
   254 4F3F 8D D9 04			sta Dir_Count
   255
   256 4F42 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   257 4F44				vbsta VBXE_MA_BSEL
