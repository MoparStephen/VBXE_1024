   318 = DA60			FSUB        equ $DA60					; FR0 - FR1
   319 = DA66			FADD        equ $DA66					; FR0 + FR1
   320 = DADB			FMUL        equ $DADB					; FR0 * FR1
   321 = DB28			FDIV        equ $DB28					; FR0 / FR1
   322 = DD40			PLYEVL      equ $DD40					; Polynomial evaluation
   323 = DD89			FLD0R       equ $DD89					; Load FR0 by X,Y register pointer
   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    74
    75 				;-----------------------------------------------------------------------------
    76 				; Structure Declarations
    77 				;-----------------------------------------------------------------------------
    78
    79 				;-----------------------------------------------------------------------------
    80 				; Variables go here
    81 				;-----------------------------------------------------------------------------
    82 				; Page 0 user data ($80 to $FF with some reserved for OS)
    83 				.zpvar Reg1				.byte			; Multi-Use Variables
    84 				.zpvar Reg2				.byte			; Multi-Use Variables
    85 				.zpvar Reg3				.byte			; Multi-Use Variables
    86 				.zpvar Reg4				.byte			; Multi-Use Variables
    87 				.zpvar Reg5				.byte			; Multi-Use Variables
    88 				.zpvar Reg6				.byte			; Multi-Use Variables
    89 				.zpvar Reg7				.byte			; Multi-Use Variables
    90 				.zpvar Reg8				.byte			; Multi-Use Variables
    91 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    92 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    93 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    94 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    95
    96 				; Non Page-0 Variables
    97 				;	$480 to $4FF free
    98 				;	$600 to $6FF free
    99 				; When using PMG the 1st $300 bytes are always free
   100 				.var SDMCTL_OLD			.byte = $480	; Save DMA
   101 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
   102 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
   103 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
   104 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   105 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   106 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   107 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   108 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   109 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   110 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   111 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   112 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   113 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   114 				; --- viewer UI state (ui.asm) ---
   115 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 5 quit / 6 P-preview / 7 help
   116 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   117 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   118 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   119 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   120 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   121 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   122 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   123 				.var FileStart			.byte = $4DA	; selector list: index of the first *.V1K row (= upCount + Dir_Count)
   124 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   125 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   126 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   127 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   128 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   129 				; --- single-file .V1K image loader (Image_Open / Image_Read_Segment) ---
   130 				.var Load_IOCB			.byte = $4E2	; IOCB offset of the open .V1K file
   131 				.var Seg_Bank			.byte = $4E3	; VBXE bank the next 4K chunk lands in
   132 				.var Seg_Chunks			.byte = $4E4	; full 4K chunks left in this segment
   133 				.var Seg_Tail			.word = $4E5	; bytes in the segment's final partial chunk
   134 				.var Pal_Image			.byte = $4E7	; 1 = an image's palettes are in registers 0-3 (Enter_Selector must restore)
   135 				.var Help_Return_Mode	.byte = $4E8	; UI_Mode to go back to when Help closes (0 selector / 4 info)
   136 				.var Help_Page			.byte = $4E9	; help screen section 0..2
   137 				.var Help_Top			.byte = $4EA	; help screen: first visible row of the section (scroll)
   138 				.var Help_RowCount		.byte = $4EB	; help screen: rows in the current section (set by Help_Draw)
   139 				;	$4EC to $4FF free
   140 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   141 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   142 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.V1K",$9B ($650-$67F)
   143 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   144 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP description + $9B) for
   145 				; Nfo_Name_LoadManifest, and the padded status-line text Nfo_Name_Emit builds
   146 				; for Selector_DrawStatus.  8+75+1 = 84 bytes fits no free gap, so it OVERLAYS
   147 				; Scan_Spec + Txt_Line ($650-$6A3).  Safe because neither is live across
   148 				; either use: Scan_Spec is only read by the CIO OPEN before the record loop
   149 				; (and rebuilt before every scan), Txt_Line is per-draw scratch that
   150 				; Text_PutStrAt does not touch, and Nfo_WalkBank ($650) is only live inside
   151 				; Info_Count_Lines (UI_Mode 4, no status line).
   152 				.var Nfo_Name_Line		:84 .byte = $650	; 8 key + 75 desc + $9B ($650-$6A3)
   153 				;	$6B7 to $6FF free (text80.asm uses $6B0-$6B6)
   154 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   155 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   156 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   157 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   158 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   159
   160 				;-----------------------------------------------------------------------------
   161 				; Defines go here
   162 				;-----------------------------------------------------------------------------
   163 = FFFF0001		.def	__VBXE_AUTO__
   164 = 2000			.def	VBXE_WINDOW						= $2000
   165 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   166 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   167 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   168
   169 				; Image name list (built by Rescan_Images - see ui.asm)
   170 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   171 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   172 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   173 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   174 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   175
   176 				; Single-file image: <name>.V1K = .PAL block + .MAP block + .RAW block, no
   177 				; header - every block is fixed-size, so every offset is a constant.
   178 				; Load_Image streams each block to the same VRAM the old 3-file load used.
   179 = 0C00			.def	V1K_PAL_LEN						= $0C00		; 4 palettes x 768     = 3072
   180 = 2580			.def	V1K_MAP_LEN						= $2580		; 40 cells x 240 rows  = 9600
   181 = 012C00			.def	V1K_RAW_LEN						= $12C00	; 320 x 240 pixels     = 76800
   182 = 0021			.def	V1K_PAL_BANK					= $21		; -> $21000 (read back by Apply_Image_Palette)
   183 = 0014			.def	V1K_MAP_BANK					= $14		; -> $14000 (CRAM_Buffer, Setup_Cmap1 expands it)
   184 = 0001			.def	V1K_RAW_BANK					= $01		; -> $01000 (framebuffer)
   185
   186 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   187 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   188 				; ($21000), the name list ($40000) and the dir browser ($41000).
   189 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   190 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   191 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   192 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   193 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   194 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   195 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   196 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   197 = 0050			.def	TEXT_COLS						= 80
   198 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   199 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   200 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   201 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   202 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   203 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   204 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   205 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   206 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   207 				; Off-screen back buffer, same layout as TEXT_SCREEN_VRAM.  Every text draw
   208 				; (Text_PutStrAt / Text_Clear / Text_FillColour / save-under / NFO blit) lands
   209 				; here; Text_Present copies it to the displayed buffer with one blit in vblank,
   210 				; so no partly-drawn screen is ever shown.  3680 bytes - fits one bank.
   211 = 02A000			.def	TEXT_BACK_VRAM					= $2A000
   212 = 002A			.def	TEXT_BACK_BANK					= TEXT_BACK_VRAM / $1000	; = $2A
   213
   214 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   215 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   216 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   217 = 030000			.def	MENU_BANNER_VRAM				= $30000
   218 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   219 = 0024			.def	MENU_BANNER_ROWS				= 36
   220 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   221 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   222 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   223 = 00A0			.def	MENU_SEP_PITCH					= 160		; 160-byte pattern table, Palette 0 (modified) indices -
   224 																		; Assets/MENU_SEP.RAW, loaded once by Load_Menu_Sep (init_vbxe.asm)
   225
   226 				; Banner palette + attribute map: never touched at runtime (unlike the real
   227 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   228 				; overwrites for every image view).  Dedicated, resident VRAM - see
   229 				; Load_Menu_Banner_Raw / Apply_Menu_Palettes (below).
   230 				; The palette bytes are assembly-embedded (Load_Menu_Ramps, init_vbxe.asm),
   231 				; not disk-loaded.  The attribute map has no file either: it is left all
   232 				; zeros (= palette 0) by the boot-time clear_vbxe, and Set_Menu_Demo_Attrs
   233 				; sets just the ramp squares' cells.
   234 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   235 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   236 																	; - palette register 0 is reserved for text
   237 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   238 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   239 																	; XDL_MainMenu's banner MAPADR points here, NOT
   240 																	; at the shared $017000 CRAM
   241
   242 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   243 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   244 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   245 				; unchanged) but horizontally mirrored via the attribute map only -
   246 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   247 				; Squares, Set_Menu_Demo_Attrs (below).
   248 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   249 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   250 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   251 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   252 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   253 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   254 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   255 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   256 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   257 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   258 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   259 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   260 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   261 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   262
   263 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   264 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   265 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   266 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   267 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   268 = 1000			.def	PAL_PREVIEW_VRAM				= $001000	; image framebuffer (same target Load_Image's .RAW uses)
   269 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   270 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   271 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   272 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   273 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   274 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   275 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   276 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   277 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   278 = 18F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   279 = 1960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   280 = A4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   281 = A560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   282 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   283 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   284 				; whole buffer, and palette 0 = $00 is the zero default).
   285 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   286 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   287 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   288 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   289 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   290 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   291 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   292 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   293
   294 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   295 				; converter emits it as this exact byte image of the text screen - fixed
   296 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   297 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   298 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   299 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   300 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   301 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   302
   303 				; Selector status-line description cache.  One NFO_NAME_SLOT-byte slot per
   304 				; image ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   305 				; Rescan_Images (the converter writes that file - 8-byte key + description per
   306 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  128
   307 				; divides 4K so no slot straddles a bank; 255*128 = $7F80 -> banks $37-$3E.
   308 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   309 = 037000			.def	NFO_NAME_VRAM					= $37000
   310 = 0037			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $37
   311 = 0080			.def	NFO_NAME_SLOT					= 128		; bytes per image slot
   312 = 004B			.def	NFO_NAME_CAP						= 75		; chars shown on the status line
   313 																		; ("Src: " + 75 = 80 cols; = the
   314 																		; converter's DESC_CAP)
   315
   316 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   317 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   318 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   319 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   320 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   321 = 0006			.def	DRIVE_WIN_ROW					= 6
   322 = 001E			.def	DRIVE_WIN_COL					= 30
   323 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   324 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   325
   326 				; Quit-confirm popup (UI_Mode 5) - "Are You Sure To Quit" + boxed Y / N buttons
   327 				; (Sel_Key_Quit / Quit_Draw, ui.asm), Selector only.
   328 = 0008			.def	QUIT_WIN_ROW					= 8
   329 = 001C			.def	QUIT_WIN_COL					= 28		; centred: (80 - QUIT_WIN_W) / 2
   330 = 0018			.def	QUIT_WIN_W						= 24		; cells wide  (border + " Are You Sure To Quit " + border)
   331 = 0006			.def	QUIT_WIN_H						= 6		; rows        (border + question + 3-row buttons + border)
   332 = 0005			.def	QUIT_BTN_W						= 5		; Y / N button boxes, 5 x 3 cells
   333 = 0022			.def	QUIT_BTN_Y_COL					= QUIT_WIN_COL+6	; buttons centred, 2 cells apart
   334 = 0029			.def	QUIT_BTN_N_COL					= QUIT_WIN_COL+13
   335
