  1009 3639 03 07 0B 0F 93 97 + 	dta 3,7,11,15,147,151,155,159
  1010 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
  1011 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
  1012 				; copy reads as a flipped reflection of the left-hand one; the underlying
  1013 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
  1014 				; register each cell points at changes.
  1015 3641			Menu_Demo_Attr_Top_Vals
  1016 3641 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
