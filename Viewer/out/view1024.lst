  1602 5757 AD 8B 04			lda ImageCount
  1603 575A 0D 8C 04			ora ImageCount+1
  1604 575D F0 61			beq Sel_Key_Nav_Done				; empty list
  1605 575F AD C7 04			lda Sel_Index
  1606 5762 18				clc
  1607 5763 69 08			adc #UI_COLS
