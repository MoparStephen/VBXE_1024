  2522 				;-----------------------------------------------------------------------------
  2523 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2524 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2525 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2526 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2527 				; its 19 rows, clear first and blit only the records that exist.
  2528 				;-----------------------------------------------------------------------------
  2529 6028			Info_Draw
  2530 6028 A9 01			lda #$01
  2531 602A 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2532 602D AD DE 04			lda Nfo_LineCount
  2533 6030 0D DF 04			ora Nfo_LineCount + $01
  2534 6033 D0 03			bne Info_Draw_Some
  2535 6035 4C F2 3D			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2536 6038			Info_Draw_Some
  2537 6038 20 7D 60			jsr Info_Body_Rows
  2538 603B C9 13			cmp #NFO_VISROWS-1
  2539 603D B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2540 603F 20 F2 3D			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2541 6042			Info_Draw_Head
  2542 6042 A9 00			lda #$00							; record 0 -> row 0, one row
  2543 6044 85 80			sta Reg1
  2544 6046 85 81			sta Reg2
  2545 6048 85 83			sta Reg4
  2546 604A A9 00			lda #<TEXT_BACK_VRAM
  2547 604C 85 82			sta Reg3
  2548 604E 20 A6 60			jsr Info_Blit
  2549 6051 20 7D 60			jsr Info_Body_Rows
  2550 6054 F0 26			beq Info_Draw_Ret					; no body records
  2551 6056 85 83			sta Reg4
  2552 6058 C6 83			dec Reg4							; Reg4 = height-1
  2553 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2554 605A A9 A0			lda #TEXT_PITCH
  2555 605C 85 80			sta Reg1
  2556 605E A9 00			lda #$00
  2557 6060 85 81			sta Reg2
  2558 6062 AE DC 04			ldx Nfo_Top
  2559 6065 F0 0E			beq Info_Draw_Body
  2560 6067			Info_Draw_MulL
  2561 6067 A5 80			lda Reg1
  2562 6069 18				clc
  2563 606A 69 A0			adc #TEXT_PITCH
  2564 606C 85 80			sta Reg1
  2565 606E 90 02			bcc Info_Draw_MulNC
  2566 6070 E6 81			inc Reg2
  2567 6072			Info_Draw_MulNC
  2568 6072 CA				dex
  2569 6073 D0 F2			bne Info_Draw_MulL
  2570 6075			Info_Draw_Body
  2571 6075 A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2572 6077 85 82			sta Reg3
  2573 6079 4C A6 60			jmp Info_Blit						; (tail)
  2574 607C			Info_Draw_Ret
  2575 607C 60				rts
  2576
  2577 				;-----------------------------------------------------------------------------
  2578 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2579 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2580 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2581 				;-----------------------------------------------------------------------------
  2582 607D			Info_Body_Rows
  2583 607D 38				sec
  2584 607E AD DE 04			lda Nfo_LineCount
  2585 6081 ED DC 04			sbc Nfo_Top
  2586 6084 85 84			sta Reg5
  2587 6086 AD DF 04			lda Nfo_LineCount + $01
  2588 6089 ED DD 04			sbc Nfo_Top + $01
  2589 608C 85 85			sta Reg6
  2590 608E A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2591 6090 38				sec
  2592 6091 E9 01			sbc #$01
  2593 6093 85 84			sta Reg5
  2594 6095 A5 85			lda Reg6
  2595 6097 E9 00			sbc #$00
  2596 6099 D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2597 609B A5 84			lda Reg5
  2598 609D C9 13			cmp #NFO_VISROWS-1
  2599 609F 90 02			bcc Info_Body_Rows_Ret
  2600 60A1			Info_Body_Rows_Full
  2601 60A1 A9 13			lda #NFO_VISROWS-1
  2602 60A3			Info_Body_Rows_Ret
  2603 60A3 C9 00			cmp #$00							; Z = no rows
  2604 60A5 60				rts
  2605
  2606 				;-----------------------------------------------------------------------------
  2607 				; Info_Blit - one BLT_NFO_DRAW copy: Reg2:Reg1 = source offset into the NFO
  2608 				; buffer, Reg3 = destination lo byte (in the back buffer's first page),
  2609 				; Reg4 = height-1.  Waits for the copy to finish.
  2610 				;-----------------------------------------------------------------------------
  2611 60A6			Info_Blit
  2612 60A6 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2613 60A8				vbsta VBXE_MA_BSEL
