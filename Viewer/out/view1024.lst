   284 				;-----------------------------------------------------------------------------
   285 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   286 				; cells between the text screen and WIN_SAVE_VRAM (a save-under buffer held at
   287 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   288 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   289 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   290 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   291 				; caller can Save then Frame on the same geometry.)
   292 				;-----------------------------------------------------------------------------
   293 3AF3			Text_Window_Save
   294 3AF3 20 41 3B			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   295 3AF6 A5 83			lda Reg4
   296 3AF8 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   297 3AFB A5 84			lda Reg5
   298 3AFD 18				clc
   299 3AFE 69 30			adc #$30							; low 16 bits of TEXT_SCREEN_VRAM = $3000
   300 3B00 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   301 3B03 A9 02			lda #$02
   302 3B05 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   303 3B08 A9 00			lda #<WIN_SAVE_VRAM
   304 3B0A 8D 98 21			sta BLT_TEXT_RECT + Dest_Adr0
   305 3B0D A9 F0			lda #>WIN_SAVE_VRAM
   306 3B0F 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   307 3B12 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 3B14 8D 9A 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3B17 4C 81 3B			jmp Text_Window_Kick
   310
   311 3B1A			Text_Window_Restore
   312 3B1A 20 41 3B			jsr Text_Window_Setup
   313 3B1D A9 00			lda #<WIN_SAVE_VRAM
   314 3B1F 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3B22 A9 F0			lda #>WIN_SAVE_VRAM
   316 3B24 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3B27 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3B29 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3B2C A5 83			lda Reg4
   320 3B2E 8D 98 21			sta BLT_TEXT_RECT + Dest_Adr0
   321 3B31 A5 84			lda Reg5
   322 3B33 18				clc
   323 3B34 69 30			adc #$30
   324 3B36 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   325 3B39 A9 02			lda #$02
   326 3B3B 8D 9A 21			sta BLT_TEXT_RECT + Dest_Adr2
   327 3B3E 4C 81 3B			jmp Text_Window_Kick
