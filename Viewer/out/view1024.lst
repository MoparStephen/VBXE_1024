   722 4FD9 4A				lsr
   723 4FDA 4A				lsr
   724 4FDB 4A				lsr
   725 4FDC 85 82			sta Reg3							; Reg3 = item_row (index / UI_COLS)
   726 4FDE AD C8 04			lda Sel_Top
   727 4FE1 4A				lsr
   728 4FE2 4A				lsr
   729 4FE3 4A				lsr								; A = top_row (Sel_Top / UI_COLS)
