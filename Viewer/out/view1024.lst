   397 				;-----------------------------------------------------------------------------
   398 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   399 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   400 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   401 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   402 				;  Returns A = $01 if a name was written, $00 if not.
   403 				;-----------------------------------------------------------------------------
   404 4FB9			Parse_Dir_Line
   405 4FB9 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   406 4FBB			Parse_Skip_L1							; Skip leading spaces / protect flag
   407 4FBB BD 00 06			lda Dir_Line_Buf,x
   408 4FBE C9 9B			cmp #$9B
   409 4FC0 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   410 4FC2 C9 20			cmp #' '
   411 4FC4 F0 04			beq Parse_Skip_Next
   412 4FC6 C9 2A			cmp #'*'
   413 4FC8 D0 07			bne Parse_Skip_Done
   414 4FCA			Parse_Skip_Next
   415 4FCA E8				inx
   416 4FCB E0 28			cpx #Dir_Line_Len
   417 4FCD 90 EC			bcc Parse_Skip_L1
   418 4FCF B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   419 4FD1			Parse_Skip_Done
   420 4FD1 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   421 4FD3 A9 00			lda #$00
   422 4FD5 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   423
   424 4FD7			Parse_Copy_L1
   425 4FD7 BD 00 06			lda Dir_Line_Buf,x
   426 4FDA C9 9B			cmp #$9B
   427 4FDC F0 24			beq Parse_Copy_Done
   428 4FDE C9 20			cmp #' '
   429 4FE0 F0 20			beq Parse_Copy_Done
   430 4FE2 C9 2E			cmp #'.'
   431 4FE4 F0 1C			beq Parse_Copy_Done
   432 4FE6 C9 30			cmp #'0'
   433 4FE8 90 07			bcc Parse_Copy_Is_Name_Char
   434 4FEA C9 3A			cmp #'9'+1
   435 4FEC B0 03			bcs Parse_Copy_Is_Name_Char
   436 4FEE 4C F3 4F			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   437 4FF1			Parse_Copy_Is_Name_Char
   438 4FF1 E6 80			inc Reg1
   439 4FF3			Parse_Copy_Store
   440 4FF3 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   441 4FF5 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   442 4FF7 BD 00 06			lda Dir_Line_Buf,x
   443 4FFA 91 8A			sta (Name_Ptr),y
   444 4FFC C8				iny
   445 4FFD			Parse_Copy_Next
   446 4FFD E8				inx
   447 4FFE E0 28			cpx #Dir_Line_Len
   448 5000 90 D5			bcc Parse_Copy_L1
   449
   450 5002			Parse_Copy_Done
   451 5002 A5 80			lda Reg1
   452 5004 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   453
   454 5006			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   455 5006 C0 08			cpy #$08
   456 5008 B0 07			bcs Parse_Dir_Line_Accept
   457 500A A9 20			lda #' '
   458 500C 91 8A			sta (Name_Ptr),y
   459 500E C8				iny
   460 500F D0 F5			bne Parse_Pad_L1
   461
   462 5011			Parse_Dir_Line_Accept
   463 5011 A9 01			lda #$01							; Non-zero - a name was stored
   464 5013 60				rts
   465 5014			Parse_Dir_Line_Reject
   466 5014 A9 00			lda #$00
   467 5016 60				rts
