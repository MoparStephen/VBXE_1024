   143
   144 				; A = glyph code -> A/Y = lo/hi of that glyph's 8 bytes in the Atari font, as
   145 				; mapped at VBXE_WINDOW + $800.  X preserved.
   146 3B0F			Text_Glyph_Addr
   147 3B0F A0 05			ldy #>[[VBXE_WINDOW + $800] / 8]	; = $05 - becomes $28 after the x8 below
   148 3B11 84 82			sty Reg3
   149 3B13 0A				asl
   150 3B14 26 82			rol Reg3
   151 3B16 0A				asl
   152 3B17 26 82			rol Reg3
   153 3B19 0A				asl
   154 3B1A 26 82			rol Reg3							; Reg3:A = $2800 + code*8
   155 3B1C A4 82			ldy Reg3
   156 3B1E 60				rts
   157
   158 				; {source, destination} glyph pairs, applied in order.  Box lines first: $1A
   159 				; (ATASCII Ctrl-Z corner) is read here before the arrows overwrite it.
   160 				; CP437 double and single box sets both map onto the Atari single-line set.
   161 3B1F			Atari_Remap_Table
   162 3B1F 11 C9 12 CD 05 BB + 	dta $11,$C9, $12,$CD, $05,$BB, $7C,$BA, $1A,$C8, $03,$BC	; double: TL - TR | BL BR
   163 3B2B 11 DA 12 C4 05 BF + 	dta $11,$DA, $12,$C4, $05,$BF, $7C,$B3, $1A,$C0, $03,$D9	; single: TL - TR | BL BR
   164 3B37 1C 18 1D 19 1E 1B + 	dta $1C,$18, $1D,$19, $1E,$1B, $1F,$1A						; arrows: up down left right
   165 3B3F			Atari_Remap_Table_End
