   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 402A			Text_PutStrAt
   583 402A A9 01			lda #$01
   584 402C 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 402F A9 00			lda #$00
   587 4031 85 80			sta Reg1
   588 4033 85 81			sta Reg2
   589 4035 AE B0 06			ldx Txt_Row
   590 4038 F0 0E			beq Text_PutStrAt_Col
   591 403A			Text_PutStrAt_RowL
   592 403A A5 80			lda Reg1
   593 403C 18				clc
   594 403D 69 A0			adc #TEXT_PITCH
   595 403F 85 80			sta Reg1
   596 4041 90 02			bcc Text_PutStrAt_RowNC
   597 4043 E6 81			inc Reg2
   598 4045			Text_PutStrAt_RowNC
   599 4045 CA				dex
   600 4046 D0 F2			bne Text_PutStrAt_RowL
   601 4048			Text_PutStrAt_Col
   602 4048 AD B1 06			lda Txt_Col
   603 404B 0A				asl									; Txt_Col * 2 (max 158)
   604 404C 18				clc
   605 404D 65 80			adc Reg1
   606 404F 85 80			sta Reg1
   607 4051 90 02			bcc Text_PutStrAt_ColNC
   608 4053 E6 81			inc Reg2
   609 4055			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 4055 A5 81			lda Reg2
   612 4057 29 10			and #$10							; offset bit 12 = "second bank"
   613 4059 F0 04			beq Text_PutStrAt_Bank0
   614 405B A9 2B			lda #TEXT_BACK_BANK+1
   615 405D D0 02			bne Text_PutStrAt_SetBank
   616 405F			Text_PutStrAt_Bank0
   617 405F A9 2A			lda #TEXT_BACK_BANK
   618 4061			Text_PutStrAt_SetBank
   619 4061 8D B6 06			sta Txt_Bank
   620 4064 A5 80			lda Reg1
   621 4066 85 88			sta Ptr_Lo
   622 4068 A5 81			lda Reg2
   623 406A 29 0F			and #$0F
   624 406C 18				clc
   625 406D 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 406F 85 89			sta Ptr_Hi
   627 4071 AD B6 06			lda Txt_Bank
   628 4074 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 4076				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 4076 A0 5F			ldy #<VBXE_MA_BSEL
     3 4078 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 407A A9 00			lda #$00
   632 407C 85 82			sta Reg3							; Reg3 = source string index
   633 407E AD B1 06			lda Txt_Col
   634 4081 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 4083			Text_PutStrAt_Char
   636 4083 A5 83			lda Reg4
   637 4085 C9 50			cmp #TEXT_COLS
   638 4087 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 4089 A4 82			ldy Reg3
   640 408B B1 96			lda (Txt_Ptr),y
   641 408D F0 43			beq Text_PutStrAt_Done
   642 408F C9 01			cmp #TXT_PEN
   643 4091 D0 0C			bne Text_PutStrAt_Glyph
   644 4093 C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 4094 B1 96			lda (Txt_Ptr),y
   646 4096 8D B4 06			sta Txt_Attr
   647 4099 C8				iny
   648 409A 84 82			sty Reg3							; skip both bytes, column unchanged
   649 409C 4C 83 40			jmp Text_PutStrAt_Char
   650 409F			Text_PutStrAt_Glyph
   651 409F A0 00			ldy #$00
   652 40A1 91 88			sta (Ptr_Lo),y						; glyph byte
   653 40A3 C8				iny
   654 40A4 AD B4 06			lda Txt_Attr
   655 40A7 91 88			sta (Ptr_Lo),y						; attribute byte
   656 40A9 E6 82			inc Reg3
   657 40AB E6 83			inc Reg4
   658 40AD A5 88			lda Ptr_Lo							; window pointer += 2
   659 40AF 18				clc
   660 40B0 69 02			adc #$02
   661 40B2 85 88			sta Ptr_Lo
   662 40B4 90 02			bcc Text_PutStrAt_NoPage
   663 40B6 E6 89			inc Ptr_Hi
   664 40B8			Text_PutStrAt_NoPage
   665 40B8 A5 89			lda Ptr_Hi
   666 40BA C9 30			cmp #$30							; crossed out of the window -> next bank
   667 40BC 90 C5			bcc Text_PutStrAt_Char
   668 40BE 38				sec
   669 40BF E9 10			sbc #$10
   670 40C1 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 40C3 EE B6 06			inc Txt_Bank
   672 40C6 AD B6 06			lda Txt_Bank
