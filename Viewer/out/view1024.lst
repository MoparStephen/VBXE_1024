   235 3DA5 A9 A0			lda #>TEXT_BACK_VRAM
   236 3DA7 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   237 3DAA A9 02			lda #[TEXT_BACK_VRAM >> 16]
   238 3DAC 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   239 3DAF A9 00			lda #<TEXT_SCREEN_VRAM
