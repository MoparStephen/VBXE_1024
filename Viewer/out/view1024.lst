   121 				;-----------------------------------------------------------------------------
   122 				; TXT_AT row, col, strlabel  -  draw a string via the text API
   123 				;-----------------------------------------------------------------------------
   124 				.macro TXT_AT
   125 					lda #[:1]
   126 					sta Txt_Row
   127 					lda #[:2]
   128 					sta Txt_Col
   129 					lda #<[:3]
   130 					sta Txt_Ptr
   131 					lda #>[:3]
   132 					sta Txt_Ptr + $01
   133 					jsr Text_PutStrAt
   134 				.endm
   135
   136 				;-----------------------------------------------------------------------------
   137 				; DTA_SCR code  -  emit one Atari internal screen code (e.g. V_0..V_3, which
   138 				; the loader screen uses) as the ASCII byte the text mode's CP437 font wants.
   139 				;-----------------------------------------------------------------------------
   140 				.macro DTA_SCR
   141 					.if [:1] < $40
   142 					dta [:1]+$20						; $00-$3F: space, punctuation, digits, A-Z
   143 					.elseif [:1] < $60
   144 					dta [:1]-$40						; $40-$5F: control-glyph block
   145 					.else
   146 					dta [:1]							; $60-$7F: a-z - already ASCII
   147 					.endif
   148 				.endm
   149
   150 				;=============================================================================
   151 				; Directory scan  (moved here from init_vbxe.asm's Scan_Images - the scan
   152 				; location is now chosen at runtime, so it can't be decided in the loader)
   153 				;=============================================================================
   154
   155 				;-----------------------------------------------------------------------------
   156 				; Rescan_Images - scan Scan_Drive/Scan_Path for *.V1K, rebuild + sort the list.
   157 				; Tolerates zero matches (an ordinary state the selector shows).
   158 				;-----------------------------------------------------------------------------
   159 4EF2			Rescan_Images
   160 				; Show "Scanning directory..." where the path goes - the scan + IMAGES.LST
   161 				; name cache can take a while in a big folder.  Every caller repaints the
   162 				; whole selector (Selector_Draw) afterwards.
   163 4EF2 A9 9A			lda #<UI_Str_Scanning
   164 4EF4 A0 73			ldy #>UI_Str_Scanning
   165 4EF6 20 92 52			jsr UI_Show_Busy
   166
   167 4EF9 20 9C 4F			jsr Build_Image_List				; fills IMAGE_BANK; sets ImageCount/Dir_Count/FileStart
   168
   169 				; sort the two real groups independently: dirs [FileStart-Dir_Count .. FileStart)
   170 				; then files [FileStart .. ImageCount).  ".." (if present) stays pinned at 0.
   171 4EFC AD DA 04			lda FileStart
   172 4EFF 38				sec
   173 4F00 ED D9 04			sbc Dir_Count
   174 4F03 AE D9 04			ldx Dir_Count
   175 4F06 20 30 3A			jsr Sort_Range						; directories A-Z
   176 4F09 AD 8B 04			lda ImageCount
   177 4F0C 38				sec
   178 4F0D ED DA 04			sbc FileStart
   179 4F10 AA				tax									; X = file count
   180 4F11 AD DA 04			lda FileStart
   181 4F14 20 30 3A			jsr Sort_Range						; *.V1K files A-Z
   182
   183 4F17 20 00 54			jsr Nfo_Name_ClearCache				; drop the status-line name slots - list changed
   184 4F1A 20 54 55			jsr Nfo_Name_LoadManifest			; refill them from this folder's IMAGES.LST (if any)
   185
