  1829 				;-----------------------------------------------------------------------------
  1830 				; Sort_Range - in-place alphabetical selection sort of the records
  1831 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1832 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1833 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1834 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1835 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1836 				;-----------------------------------------------------------------------------
  1837 3C1D			Sort_Range
  1838 3C1D E0 02			cpx #$02
  1839 3C1F 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1840 3C21 85 81			sta Reg2							; Reg2 = i = start
  1841 3C23 86 82			stx Reg3							; Reg3 = count (temp)
  1842 3C25 18				clc
  1843 3C26 65 82			adc Reg3
  1844 3C28 85 84			sta Reg5							; Reg5 = end = start + count
  1845 3C2A 38				sec
  1846 3C2B E9 01			sbc #$01
  1847 3C2D 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1848
  1849 3C2F A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1850 3C31				vbsta VBXE_MA_BSEL
