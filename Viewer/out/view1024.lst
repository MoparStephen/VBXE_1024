   485 				;-----------------------------------------------------------------------------
   486 				; Enter_Selector - restore Palette 0 for text, refresh the menu banner's
   487 				; palette registers 1-3 (Load_Image overwrites them for every real image
   488 				; viewed in between - a cheap resident-VRAM-to-register copy, no disk access;
   489 				; see Apply_Menu_Banner_Palette in view1024.asm), show the text screen, draw
   490 				; it.  Reached from start: (jsr), Handle_Escape (jsr), Slide_Key_Stop (jsr)
   491 				; and Info_Key_Leave (jsr) - always returns.
   492 				;-----------------------------------------------------------------------------
   493 4F24			Enter_Selector
   494 4F24 20 15 32			jsr Restore_Palette0				; standard PAL/NTSC master palette -> set 0
   495 4F27 20 39 4F			jsr UI_Apply_TextPalette			; ...then de-interleave it for text mode
   496 4F2A 20 5D 34			jsr Apply_Menu_Banner_Palette		; refresh the banner's palette registers 1-3
   497 4F2D 20 0F 3A			jsr Text_Activate					; point the XDL at the menu/info screen
   498 4F30 A9 00			lda #$00
   499 4F32 8D C6 04			sta UI_Mode
   500 4F35 20 B8 4F			jsr Selector_Draw
   501 4F38 60				rts
   502
   503 				;-----------------------------------------------------------------------------
   504 				; UI_Apply_TextPalette - Restore_Palette0 has just put the standard Atari 256-
   505 				; colour master into palette set 0.  The VBXE text mode can only reach entries
   506 				; 0-127 as a foreground, and in the master that range is hues 0-7 (no green).
   507 				; De-interleave it so:
   508 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   509 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   510 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   511 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000) and re-upload it
   512 				; as set 0.  Runs only on entry to the selector - not per frame.
   513 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   514 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr, Y_Register.
   515 				;-----------------------------------------------------------------------------
   516 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   517
   518 4F39			UI_Apply_TextPalette
   519 4F39 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   520 4F3B				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 4F3B A0 5F			ldy #<VBXE_MA_BSEL
     3 4F3D 91 93			sta (VBXEBase),y
Source: ui.asm
   521
   522 				; --- pass 1: even master colours -> buf[0..127]
   523 4F3F 20 7A 4F			jsr UI_Apply_TP_SrcBase
   524 4F42 A9 00			lda #<UI_APPLY_TP_BUF
   525 4F44 85 8A			sta Name_Ptr
   526 4F46 A9 28			lda #>UI_APPLY_TP_BUF
   527 4F48 85 8B			sta Name_Ptr+1
   528 4F4A 20 91 4F			jsr UI_Apply_TP_Pass
   529
   530 				; --- pass 2: odd master colours -> buf[128..255]
   531 4F4D 20 7A 4F			jsr UI_Apply_TP_SrcBase
   532 4F50 A5 88			lda Ptr_Lo
   533 4F52 18				clc
   534 4F53 69 03			adc #$03									; step onto the first odd triplet
   535 4F55 85 88			sta Ptr_Lo
   536 4F57 90 02			bcc UI_Apply_TP_P2Dst
   537 4F59 E6 89			inc Ptr_Hi
   538 4F5B			UI_Apply_TP_P2Dst
   539 4F5B A9 80			lda #<[UI_APPLY_TP_BUF + $180]				; buf + 128*3
   540 4F5D 85 8A			sta Name_Ptr
   541 4F5F A9 29			lda #>[UI_APPLY_TP_BUF + $180]
   542 4F61 85 8B			sta Name_Ptr+1
   543 4F63 20 91 4F			jsr UI_Apply_TP_Pass
   544
   545 				; --- upload the de-interleaved image as palette set 0
   546 4F66 A9 00			lda #<UI_APPLY_TP_BUF
   547 4F68 85 95			sta Y_Register
   548 4F6A A9 28			lda #>UI_APPLY_TP_BUF
   549 4F6C 85 96			sta Y_Register+1
   550 4F6E A9 00			lda #$00
   551 4F70 20 5D 31			jsr VBXE_SetPalette2
   552
   553 4F73 A9 00			lda #MEMAC_GLOBAL_DISABLE
   554 4F75				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 4F75 A0 5F			ldy #<VBXE_MA_BSEL
     3 4F77 91 93			sta (VBXEBase),y
Source: ui.asm
   555 4F79 60				rts
