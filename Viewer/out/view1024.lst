   662 				;-----------------------------------------------------------------------------
   663 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
   664 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
   665 				; equal) otherwise.
   666 				;-----------------------------------------------------------------------------
   667 35AF			Cmp_Records
   668 35AF A0 00			ldy #$00
   669 35B1			Cmp_Records_L1
   670 35B1 B1 8A			lda (Name_Ptr),y
   671 35B3 D1 8C			cmp (Sort_Ptr),y
   672 35B5 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
   673 35B7 C8				iny
   674 35B8 C0 08			cpy #$08
   675 35BA 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
   676 35BC			Cmp_Records_Done
   677 35BC 60				rts
   678
   679 				;-----------------------------------------------------------------------------
   680 				; Swap_Records - exchange the 8-byte records at (Name_Ptr) and (Sort_Ptr),
   681 				; using Path_Buf as scratch.
   682 				;-----------------------------------------------------------------------------
   683 35BD			Swap_Records
   684 35BD A0 00			ldy #$00
   685 35BF			Swap_Records_L1
   686 35BF B1 8A			lda (Name_Ptr),y
   687 35C1 99 8D 04			sta Path_Buf,y
   688 35C4 B1 8C			lda (Sort_Ptr),y
   689 35C6 91 8A			sta (Name_Ptr),y
   690 35C8 B9 8D 04			lda Path_Buf,y
   691 35CB 91 8C			sta (Sort_Ptr),y
   692 35CD C8				iny
   693 35CE C0 08			cpy #$08
   694 35D0 90 ED			bcc Swap_Records_L1
   695 35D2 60				rts
   696
