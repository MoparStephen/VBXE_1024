  2036 5824 85 81			sta Reg2
  2037 5826 AE DC 04			ldx Nfo_Top
  2038 5829 F0 0E			beq Info_Draw_Patch
  2039 582B			Info_Draw_MulL
  2040 582B A5 80			lda Reg1
  2041 582D 18				clc
  2042 582E 69 A0			adc #TEXT_PITCH
  2043 5830 85 80			sta Reg1
  2044 5832 90 02			bcc Info_Draw_MulNC
  2045 5834 E6 81			inc Reg2
  2046 5836			Info_Draw_MulNC
  2047 5836 CA				dex
  2048 5837 D0 F2			bne Info_Draw_MulL
  2049 5839			Info_Draw_Patch
  2050 5839 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2051 583B				vbsta VBXE_MA_BSEL
