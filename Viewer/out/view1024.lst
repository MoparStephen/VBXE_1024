  1559 				; Sel_Key_Down/Up/Left/Right - each validates and clamps the move, then hands
  1560 				; the new index to Sel_Nav_Apply.  Because the list is one flat, row-major
  1561 				; array, Left/Right wrapping across a row boundary needs no extra logic -
  1562 				; it's just Sel_Index +/- 1.
  1563 56EF			Sel_Key_Down
  1564 56EF AD 8B 04			lda ImageCount
  1565 56F2 0D 8C 04			ora ImageCount+1
  1566 56F5 F0 61			beq Sel_Key_Nav_Done				; empty list
  1567 56F7 AD C7 04			lda Sel_Index
  1568 56FA 18				clc
  1569 56FB 69 08			adc #UI_COLS
  1570 56FD CD 8B 04			cmp ImageCount
  1571 5700 B0 56			bcs Sel_Key_Nav_Done				; no cell directly below - clamp
  1572 5702 4C 32 57			jmp Sel_Nav_Apply
  1573
  1574 5705			Sel_Key_Up
  1575 5705 AD C7 04			lda Sel_Index
  1576 5708 C9 08			cmp #UI_COLS
  1577 570A 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1578 570C 38				sec
  1579 570D E9 08			sbc #UI_COLS
  1580 570F 4C 32 57			jmp Sel_Nav_Apply
  1581
  1582 5712			Sel_Key_Left
  1583 5712 AD C7 04			lda Sel_Index
  1584 5715 F0 41			beq Sel_Key_Nav_Done				; already at the first item
  1585 5717 38				sec
  1586 5718 E9 01			sbc #$01
  1587 571A 4C 32 57			jmp Sel_Nav_Apply
  1588
  1589 571D			Sel_Key_Right
