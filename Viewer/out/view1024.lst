   115 				;-----------------------------------------------------------------------------
   116 				; TXT_AT row, col, strlabel  -  draw a string via the text API
   117 				;-----------------------------------------------------------------------------
   118 				.macro TXT_AT
   119 					lda #[:1]
   120 					sta Txt_Row
   121 					lda #[:2]
   122 					sta Txt_Col
   123 					lda #<[:3]
   124 					sta Txt_Ptr
   125 					lda #>[:3]
   126 					sta Txt_Ptr + $01
   127 					jsr Text_PutStrAt
   128 				.endm
