   502 				;-----------------------------------------------------------------------------
   503 				; UI_Apply_TextPalette - Restore_Palette0 has just put the standard Atari 256-
   504 				; colour master into palette set 0.  The VBXE text mode can only reach entries
   505 				; 0-127 as a foreground, and in the master that range is hues 0-7 (no green).
   506 				; De-interleave it so:
   507 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   508 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   509 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   510 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000) and re-upload it
   511 				; as set 0.  Runs only on entry to the selector - not per frame.
   512 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   513 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr, Y_Register.
   514 				;-----------------------------------------------------------------------------
   515 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   516
   517 4E22			UI_Apply_TextPalette
   518 4E22 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   519 4E24				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 4E24 A0 5F			ldy #<VBXE_MA_BSEL
     3 4E26 91 93			sta (VBXEBase),y
Source: ui.asm
