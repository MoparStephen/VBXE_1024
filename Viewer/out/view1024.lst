  1464 5965			Put_U8_Pad3_TDone
  1465 5965 98				tya
  1466 5966 20 6F 59			jsr Put_U8_Pad3_Digit
  1467 5969 A5 80			lda Reg1
  1468 596B 09 30			ora #'0'							; ones digit - always shown
