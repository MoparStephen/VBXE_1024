   380 				;-----------------------------------------------------------------------------
   381 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   382 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   383 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   384 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   385 				;  Returns A = $01 if a name was written, $00 if not.
   386 				;-----------------------------------------------------------------------------
   387 4E9E			Parse_Dir_Line
   388 4E9E A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   389 4EA0			Parse_Skip_L1							; Skip leading spaces / protect flag
   390 4EA0 BD 00 06			lda Dir_Line_Buf,x
   391 4EA3 C9 9B			cmp #$9B
   392 4EA5 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   393 4EA7 C9 20			cmp #' '
   394 4EA9 F0 04			beq Parse_Skip_Next
   395 4EAB C9 2A			cmp #'*'
   396 4EAD D0 07			bne Parse_Skip_Done
   397 4EAF			Parse_Skip_Next
   398 4EAF E8				inx
   399 4EB0 E0 28			cpx #Dir_Line_Len
   400 4EB2 90 EC			bcc Parse_Skip_L1
   401 4EB4 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   402 4EB6			Parse_Skip_Done
   403 4EB6 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   404 4EB8 A9 00			lda #$00
   405 4EBA 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   406
   407 4EBC			Parse_Copy_L1
   408 4EBC BD 00 06			lda Dir_Line_Buf,x
   409 4EBF C9 9B			cmp #$9B
   410 4EC1 F0 24			beq Parse_Copy_Done
   411 4EC3 C9 20			cmp #' '
   412 4EC5 F0 20			beq Parse_Copy_Done
   413 4EC7 C9 2E			cmp #'.'
   414 4EC9 F0 1C			beq Parse_Copy_Done
   415 4ECB C9 30			cmp #'0'
   416 4ECD 90 07			bcc Parse_Copy_Is_Name_Char
   417 4ECF C9 3A			cmp #'9'+1
   418 4ED1 B0 03			bcs Parse_Copy_Is_Name_Char
   419 4ED3 4C D8 4E			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   420 4ED6			Parse_Copy_Is_Name_Char
   421 4ED6 E6 80			inc Reg1
   422 4ED8			Parse_Copy_Store
   423 4ED8 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   424 4EDA B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   425 4EDC BD 00 06			lda Dir_Line_Buf,x
   426 4EDF 91 8A			sta (Name_Ptr),y
   427 4EE1 C8				iny
   428 4EE2			Parse_Copy_Next
   429 4EE2 E8				inx
   430 4EE3 E0 28			cpx #Dir_Line_Len
   431 4EE5 90 D5			bcc Parse_Copy_L1
   432
   433 4EE7			Parse_Copy_Done
   434 4EE7 A5 80			lda Reg1
   435 4EE9 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   436
   437 4EEB			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   438 4EEB C0 08			cpy #$08
   439 4EED B0 07			bcs Parse_Dir_Line_Accept
   440 4EEF A9 20			lda #' '
   441 4EF1 91 8A			sta (Name_Ptr),y
   442 4EF3 C8				iny
   443 4EF4 D0 F5			bne Parse_Pad_L1
   444
   445 4EF6			Parse_Dir_Line_Accept
   446 4EF6 A9 01			lda #$01							; Non-zero - a name was stored
   447 4EF8 60				rts
   448 4EF9			Parse_Dir_Line_Reject
   449 4EF9 A9 00			lda #$00
   450 4EFB 60				rts
