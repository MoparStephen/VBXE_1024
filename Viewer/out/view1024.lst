   759 				;-----------------------------------------------------------------------------
   760 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner (pixel data,
   761 				; attribute map) into dedicated, resident VRAM - never touched by Load_Image,
   762 				; and never reloaded from disk again after this one call, since the banner
   763 				; never changes at runtime.  Blank-fills any banner target whose file is
   764 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   765 				; no asset file at all - it is always a fixed-colour blitter fill
   766 				; (Menu_Sep_Blank).  The banner's palette (registers 1-3) is no longer a disk
   767 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   768 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   769 				; Enter_Selector.
   770 				;-----------------------------------------------------------------------------
   771 34FF			Load_Menu_Banner_Raw
   772 34FF A9 E5			lda #<Menu_Banner_Raw_Name
   773 3501 8D 28 31			sta FileNamePtr
   774 3504 A9 37			lda #>Menu_Banner_Raw_Name
   775 3506 8D 29 31			sta FileNamePtr + $01
   776 3509 A9 30			lda #MENU_BANNER_BANK
   777 350B 85 8E			sta BankIndex
   778 350D 20 AA 30			jsr LoadData
   779 3510 AD 2D 31			lda LoadStatus
   780 3513 D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   781 3515 20 88 37			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   782
   783 3518			Load_Menu_Banner_Raw_Sep
   784 3518 20 B1 37			jsr Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   785
   786 351B			Load_Menu_Banner_Raw_Map
   787 				; Load the banner's .MAP into $14000 (CRAM_Buffer, shared scratch - fine,
   788 				; this is a one-time boot step) and expand it into MENU_BANNER_MAP_VRAM (its
   789 				; own resident copy, NOT the shared CRAM $017000 - see Setup_Menu_Cmap).
   790 351B A9 DA			lda #<Menu_Banner_Map_Name
   791 351D 8D 28 31			sta FileNamePtr
   792 3520 A9 37			lda #>Menu_Banner_Map_Name
   793 3522 8D 29 31			sta FileNamePtr + $01
   794 3525 A9 14			lda #$14
   795 3527 85 8E			sta BankIndex
   796 3529 20 AA 30			jsr LoadData
   797 352C AD 2D 31			lda LoadStatus
   798 352F F0 03			beq Load_Menu_Banner_Raw_Done		; OPEN/load failed - leave MENU_BANNER_MAP_VRAM as-is
   799 3531 20 77 33			jsr Setup_Menu_Cmap
   800
   801 3534			Load_Menu_Banner_Raw_Done				; Apply_Menu_Banner_Palette isn't called here -
   802 3534 60				rts									; Enter_Selector always calls it before the first frame
   803
   804 				;-----------------------------------------------------------------------------
   805 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   806 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   807 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   808 				; for text).  Called once at boot (above) and from every Enter_Selector
   809 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   810 				; viewed in between and there is no way to avoid that hardware-register
   811 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   812 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
   813 				;-----------------------------------------------------------------------------
   814 3535			Apply_Menu_Banner_Palette
   815 3535 A9 B4			lda #(MENU_BANNER_PAL_VRAM / $1000) | MEMAC_GLOBAL_ENABLE
   816 3537				vbsta VBXE_MA_BSEL
