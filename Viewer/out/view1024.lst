   513 				; Called by Build_Filename (view1024.asm) before it appends base + "." + ext.
   514 				;-----------------------------------------------------------------------------
   515 52E8			Emit_Path_Prefix
   516 52E8 A2 00			ldx #$00
   517 52EA A9 44			lda #'D'
   518 52EC 9D 8D 04			sta Path_Buf,x
   519 52EF E8				inx
   520 52F0 AD CC 04			lda Scan_Drive
   521 52F3 F0 04			beq Emit_Path_Prefix_Colon
   522 52F5 9D 8D 04			sta Path_Buf,x
   523 52F8 E8				inx
   524 52F9			Emit_Path_Prefix_Colon
   525 52F9 A9 3A			lda #':'
   526 52FB 9D 8D 04			sta Path_Buf,x
   527 52FE E8				inx
   528 52FF A0 00			ldy #$00
   529 5301			Emit_Path_Prefix_L1
   530 5301 B9 28 06			lda Scan_Path,y
   531 5304 F0 09			beq Emit_Path_Prefix_Done
   532 5306 9D 8D 04			sta Path_Buf,x
   533 5309 E8				inx
   534 530A C8				iny
   535 530B C0 28			cpy #$28
   536 530D 90 F2			bcc Emit_Path_Prefix_L1
   537 530F			Emit_Path_Prefix_Done
   538 530F 60				rts
