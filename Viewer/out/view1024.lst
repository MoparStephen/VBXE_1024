   587 				;-----------------------------------------------------------------------------
   588 				; The IBM CGA font, embedded in the .xex.  256 glyphs x 8x8 1bpp = 2048 bytes,
   589 				; code page 437 order (glyph index = raw ASCII byte).  Text_Load_Font copies it
   590 				; into VRAM bank TEXT_FONT_BANK at boot.
   591 				;-----------------------------------------------------------------------------
   592 3DA9			Text_Font_Data
   593 3DA9 00 00 00 00 00 00 + 	ins 'Assets/CGA.F08'
   594 45A9			Text_Font_Data_End
   595 					.if Text_Font_Data_End - Text_Font_Data != 2048
   596 						.error "CGA.F08 must be exactly 2048 bytes"
   597 					.endif
   598
   599 				;-----------------------------------------------------------------------------
   600 				; The Atari OS character set, embedded in the .xex.  Re-ordered from the ROM's
   601 				; ATASCII/internal glyph order into ASCII order (glyph index = raw ASCII byte,
   602 				; matching CGA.F08 and Text_PutStrAt), with glyphs $80-$FF the bitwise inverse
   603 				; of $00-$7F.  256 glyphs x 8x8 1bpp = 2048 bytes.  ATARI-raw.F08 keeps the
   604 				; original 1024-byte ROM dump.  Loaded to VRAM $022800 by Text_Load_Fonts.
   605 				;-----------------------------------------------------------------------------
   606 45A9			Atari_Font_Data
   607 45A9 00 36 7F 7F 3E 1C + 	ins 'Assets/ATARI.F08'
   608 4DA9			Atari_Font_Data_End
   609 					.if Atari_Font_Data_End - Atari_Font_Data != 2048
   610 						.error "ATARI.F08 must be exactly 2048 bytes"
   611 					.endif
   611 = 0096			TXT_PTR
   611 = 06B0			TXT_ROW
   611 = 06B1			TXT_COL
   611 = 06B2			TXT_FG
   611 = 06B3			TXT_BG
   611 = 06B4			TXT_ATTR
   611 = 06B5			TXT_FRAMESTYLE
   611 = 06B6			TXT_BANK
