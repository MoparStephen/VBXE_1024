  2858 62EF CA				dex									; step onto the trailing '>'
  2859 62F0			Path_Pop_L1
  2860 62F0 E0 00			cpx #$00
  2861 62F2 F0 09			beq Path_Pop_Cut
  2862 62F4 CA				dex
