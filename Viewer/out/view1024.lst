   731 4FE6 A5 82			lda Reg3
   732 4FE8 38				sec
   733 4FE9 E5 80			sbc Reg1							; A = item_row - top_row
   734 4FEB 90 3A			bcc Selector_HiRow_Skip				; item_row < top_row - above the window
   735 4FED C9 0F			cmp #UI_VISROWS
