   523 4E2B A9 00			lda #<UI_APPLY_TP_BUF
   524 4E2D 85 8A			sta Name_Ptr
   525 4E2F A9 28			lda #>UI_APPLY_TP_BUF
   526 4E31 85 8B			sta Name_Ptr+1
   527 4E33 20 7A 4E			jsr UI_Apply_TP_Pass
   528
   529 				; --- pass 2: odd master colours -> buf[128..255]
   530 4E36 20 63 4E			jsr UI_Apply_TP_SrcBase
   531 4E39 A5 88			lda Ptr_Lo
   532 4E3B 18				clc
   533 4E3C 69 03			adc #$03									; step onto the first odd triplet
   534 4E3E 85 88			sta Ptr_Lo
   535 4E40 90 02			bcc UI_Apply_TP_P2Dst
   536 4E42 E6 89			inc Ptr_Hi
   537 4E44			UI_Apply_TP_P2Dst
   538 4E44 A9 80			lda #<[UI_APPLY_TP_BUF + $180]				; buf + 128*3
   539 4E46 85 8A			sta Name_Ptr
   540 4E48 A9 29			lda #>[UI_APPLY_TP_BUF + $180]
   541 4E4A 85 8B			sta Name_Ptr+1
   542 4E4C 20 7A 4E			jsr UI_Apply_TP_Pass
