  2257 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2258 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2259 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2260 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2261 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  2262 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  2263 				;=============================================================================
  2264
  2265 				;-----------------------------------------------------------------------------
  2266 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2267 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2268 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2269 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2270 				; off screen.
  2271 				;-----------------------------------------------------------------------------
  2272 5C50			Info_Load
  2273 5C50 A9 25			lda #NFO_BUF_BANK
  2274 5C52 85 8E			sta BankIndex
  2275 5C54 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2276 5C57 AD 2D 31			lda LoadStatus
  2277 5C5A F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2278 5C5C 20 60 5C			jsr Info_Count_Lines				; sets Nfo_LineCount
  2279 5C5F			Info_Load_Ret
  2280 5C5F 60				rts
  2281
  2282 				;-----------------------------------------------------------------------------
  2283 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2284 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2285 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2286 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2287 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2288 				;-----------------------------------------------------------------------------
  2289 5C60			Info_Count_Lines
  2290 5C60 A9 00			lda #$00
  2291 5C62 8D DE 04			sta Nfo_LineCount
  2292 5C65 8D DF 04			sta Nfo_LineCount + $01
  2293 5C68 A9 25			lda #NFO_BUF_BANK
  2294 5C6A 8D 50 06			sta Nfo_WalkBank
  2295 5C6D 09 80			ora #MEMAC_GLOBAL_ENABLE
  2296 5C6F				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5C6F A0 5F			ldy #<VBXE_MA_BSEL
     3 5C71 91 93			sta (VBXEBase),y
Source: ui.asm
  2297 5C73 A9 00			lda #<VBXE_WINDOW
  2298 5C75 85 88			sta Ptr_Lo
  2299 5C77 A9 20			lda #>VBXE_WINDOW
  2300 5C79 85 89			sta Ptr_Hi
  2301 5C7B			Info_Count_L1
  2302 5C7B A0 00			ldy #$00
  2303 5C7D B1 88			lda (Ptr_Lo),y
  2304 5C7F F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2305 5C81 EE DE 04			inc Nfo_LineCount
  2306 5C84 AD DE 04			lda Nfo_LineCount
  2307 5C87 C9 7F			cmp #NFO_MAX_LINES
  2308 5C89 B0 24			bcs Info_Count_Done					; hit the record cap
  2309 5C8B A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2310 5C8D 18				clc
  2311 5C8E 69 A0			adc #TEXT_PITCH
  2312 5C90 85 88			sta Ptr_Lo
  2313 5C92 90 E7			bcc Info_Count_L1
  2314 5C94 E6 89			inc Ptr_Hi
  2315 5C96 A5 89			lda Ptr_Hi
  2316 5C98 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2317 5C9A 90 DF			bcc Info_Count_L1
  2318 5C9C E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2319 5C9E 85 89			sta Ptr_Hi
  2320 5CA0 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2321 5CA3 AD 50 06			lda Nfo_WalkBank
  2322 5CA6 09 80			ora #MEMAC_GLOBAL_ENABLE
  2323 5CA8				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5CA8 A0 5F			ldy #<VBXE_MA_BSEL
     3 5CAA 91 93			sta (VBXEBase),y
Source: ui.asm
  2324 5CAC 4C 7B 5C			jmp Info_Count_L1
  2325 5CAF			Info_Count_Done
  2326 5CAF A9 00			lda #MEMAC_GLOBAL_DISABLE
  2327 5CB1				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5CB1 A0 5F			ldy #<VBXE_MA_BSEL
     3 5CB3 91 93			sta (VBXEBase),y
Source: ui.asm
  2328 5CB5 60				rts
