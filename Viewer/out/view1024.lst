  1542 3960			Sort_Range_Outer
  1543 3960 A5 81			lda Reg2
  1544 3962 C5 85			cmp Reg6
  1545 3964 B0 47			bcs Sort_Range_Unmap				; i >= end-1 -> done
  1546
  1547 3966 85 83			sta Reg4							; m = i
  1548 3968 20 D8 39			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1549
  1550 396B A5 81			lda Reg2
  1551 396D 18				clc
  1552 396E 69 01			adc #$01
  1553 3970 85 82			sta Reg3							; j = i + 1
  1554 3972			Sort_Range_Inner
  1555 3972 A5 82			lda Reg3
  1556 3974 C5 84			cmp Reg5
  1557 3976 B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1558
  1559 3978 A5 82			lda Reg3
  1560 397A 20 E4 39			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1561 397D 20 B4 39			jsr Cmp_Records						; rec(m) : rec(j)
  1562 3980 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1563 3982 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1564 3984 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1565 3986 85 83			sta Reg4
  1566 3988 A5 8C			lda Sort_Ptr
  1567 398A 85 8A			sta Name_Ptr
  1568 398C A5 8D			lda Sort_Ptr + $01
  1569 398E 85 8B			sta Name_Ptr + $01
  1570 3990			Sort_Range_Inner_Next
  1571 3990 E6 82			inc Reg3
  1572 3992 4C 72 39			jmp Sort_Range_Inner
  1573 3995			Sort_Range_Inner_Done
  1574 3995 A5 83			lda Reg4
  1575 3997 C5 81			cmp Reg2
  1576 3999 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1577 399B A5 81			lda Reg2
  1578 399D 20 E4 39			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1579 39A0 A5 83			lda Reg4
  1580 39A2 20 D8 39			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1581 39A5 20 C2 39			jsr Swap_Records
  1582 39A8			Sort_Range_Outer_Next
