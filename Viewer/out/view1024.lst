   675 3462 20 2D 30			jsr Find_First_IOCB
   676 3465 C0 01			cpy #$01
   677 3467 D0 28			bne Image_Open_Fail					; no free IOCB
   678 3469 8E E2 04			stx Load_IOCB
   679 346C A9 04			lda #CIO_read
   680 346E 9D 4A 03			sta ICAX1,x
   681 3471 A9 00			lda #$00
   682 3473 9D 4B 03			sta ICAX2,x
   683 3476 A9 03			lda #CIO_open
   684 3478 9D 42 03			sta ICCOM,x
   685 347B AD 28 31			lda FileNamePtr
   686 347E 9D 44 03			sta ICBAL,x
   687 3481 AD 29 31			lda FileNamePtr + $01
   688 3484 9D 45 03			sta ICBAH,x
   689 3487 20 56 E4			jsr CIOV
   690 348A 30 02			bmi Image_Open_Close
   691 348C 18				clc
   692 348D 60				rts
   693 348E			Image_Open_Close
   694 348E 20 EE 34			jsr Image_Close
   695 3491			Image_Open_Fail
   696 3491 38				sec
   697 3492 60				rts
