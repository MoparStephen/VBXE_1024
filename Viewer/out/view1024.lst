   697 				; Handle_Keys
   698 				;-----------------------------------------------------------------------------
   699 3539			Handle_Keys
   700 				; Dispatch on the current UI mode - the selector, slideshow, drive picker and
   701 				; info viewer each have their own key set (ui.asm); mode 1 (image view) uses
   702 				; the set below.
   703 3539 AD FC 02			lda CH
   704 353C C9 38			cmp #KEY_F							; F toggles the text font on every screen
   705 353E D0 06			bne Handle_Keys_Mode
   706 3540 20 0A 38			jsr Toggle_Font
   707 3543 4C D1 35			jmp Read_Key_Done
   708 3546			Handle_Keys_Mode
   709 3546 AD C6 04			lda UI_Mode
   710 3549 D0 03			bne Handle_Keys_NotSelector
   711 354B 4C AA 52			jmp Selector_Keys					; 0 = selector
   712 354E			Handle_Keys_NotSelector
   713 354E C9 02			cmp #$02
   714 3550 D0 03			bne Handle_Keys_NotSlide
   715 3552 4C 4A 56			jmp Slideshow_Keys					; 2 = slideshow
   716 3555			Handle_Keys_NotSlide
   717 3555 C9 03			cmp #$03
   718 3557 D0 03			bne Handle_Keys_NotFolder
   719 3559 4C D4 54			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
   720 355C			Handle_Keys_NotFolder
   721 355C C9 04			cmp #$04
   722 355E D0 03			bne Handle_Keys_NotInfo
   723 3560 4C D0 57			jmp Info_Keys						; 4 = info viewer (.nfo)
   724 3563			Handle_Keys_NotInfo
   725 3563 C9 05			cmp #$05
   726 3565 D0 03			bne Handle_Keys_ImageView
   727 3567 4C 9F 55			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
   728 356A			Handle_Keys_ImageView
   729
   730 				; Q does not quit from here - only from the Selector, via a Y/N confirmation.
   731 356A AD FC 02			lda CH
   732 356D C9 21			cmp #$21							; Space - next image
   733 356F F0 1F			beq Handle_Space
   734 3571 C9 34			cmp #$34							; Backspace - previous image
   735 3573 F0 24			beq Handle_Backspace
   736 3575 C9 1C			cmp #$1C							; Esc - back to the file selector
   737 3577 F0 29			beq Handle_Escape
   738 3579 C9 32			cmp #$32							; 0
   739 357B F0 2E			beq Handle_0
   740 357D C9 1F			cmp #$1F							; 1
   741 357F F0 32			beq Handle_1
   742 3581 C9 1E			cmp #$1E							; 2
   743 3583 F0 36			beq Handle_2
   744 3585 C9 1A			cmp #$1A							; 3
   745 3587 F0 3A			beq Handle_3
   746 3589 C9 18			cmp #$18							; 4
   747 358B F0 3E			beq Handle_4
   748 358D			Handle_Keys_Done						; No more keys to test
   749 358D 4C D1 35			jmp Read_Key_Done
