  2522 				;=============================================================================
  2523 				; Shared directory helpers
  2524 				;-----------------------------------------------------------------------------
  2525 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2526 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2527 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2528 				; navigation lives in the selector itself.
  2529 				;=============================================================================
  2530
  2531 				;-----------------------------------------------------------------------------
  2532 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2533 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2534 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2535 				;-----------------------------------------------------------------------------
  2536 5E00			Line_Has_Dir_Tag
  2537 5E00 A2 00			ldx #$00
  2538 5E02			Line_Has_Dir_Tag_L1
  2539 5E02 BD 00 06			lda Dir_Line_Buf,x
  2540 5E05 C9 3C			cmp #'<'
  2541 5E07 D0 1F			bne Line_Has_Dir_Tag_Next
  2542 5E09 BD 01 06			lda Dir_Line_Buf+1,x
  2543 5E0C C9 44			cmp #'D'
  2544 5E0E D0 18			bne Line_Has_Dir_Tag_Next
  2545 5E10 BD 02 06			lda Dir_Line_Buf+2,x
  2546 5E13 C9 49			cmp #'I'
  2547 5E15 D0 11			bne Line_Has_Dir_Tag_Next
  2548 5E17 BD 03 06			lda Dir_Line_Buf+3,x
  2549 5E1A C9 52			cmp #'R'
  2550 5E1C D0 0A			bne Line_Has_Dir_Tag_Next
  2551 5E1E BD 04 06			lda Dir_Line_Buf+4,x
  2552 5E21 C9 3E			cmp #'>'
  2553 5E23 D0 03			bne Line_Has_Dir_Tag_Next
  2554 5E25 A9 01			lda #$01							; found
  2555 5E27 60				rts
  2556 5E28			Line_Has_Dir_Tag_Next
  2557 5E28 E8				inx
  2558 5E29 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2559 5E2B 90 D5			bcc Line_Has_Dir_Tag_L1
  2560 5E2D A9 00			lda #$00							; not found
  2561 5E2F 60				rts
  2562
  2563 				;-----------------------------------------------------------------------------
  2564 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2565 				; space-padded).  Refuses if the result would not fit.
  2566 				;-----------------------------------------------------------------------------
  2567 5E30			Folder_Path_Push
  2568 5E30 A2 00			ldx #$00
  2569 5E32			Folder_Path_Push_End
  2570 5E32 BD 28 06			lda Scan_Path,x
  2571 5E35 F0 06			beq Folder_Path_Push_Name
  2572 5E37 E8				inx
  2573 5E38 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2574 5E3A 90 F6			bcc Folder_Path_Push_End
  2575 5E3C 60				rts									; path too long already - refuse
  2576 5E3D			Folder_Path_Push_Name
  2577 5E3D A0 00			ldy #$00
  2578 5E3F			Folder_Path_Push_L1
  2579 5E3F B9 CD 04			lda Name_Row_Buf,y
  2580 5E42 F0 0D			beq Folder_Path_Push_Sep
  2581 5E44 C9 20			cmp #' '
  2582 5E46 F0 09			beq Folder_Path_Push_Sep
  2583 5E48 9D 28 06			sta Scan_Path,x
  2584 5E4B E8				inx
  2585 5E4C C8				iny
  2586 5E4D C0 08			cpy #$08
  2587 5E4F 90 EE			bcc Folder_Path_Push_L1
  2588 5E51			Folder_Path_Push_Sep
  2589 5E51 A9 3E			lda #'>'
  2590 5E53 9D 28 06			sta Scan_Path,x
  2591 5E56 E8				inx
  2592 5E57 A9 00			lda #$00
  2593 5E59 9D 28 06			sta Scan_Path,x
  2594 5E5C 60				rts
  2595
  2596 				;-----------------------------------------------------------------------------
  2597 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2598 				;-----------------------------------------------------------------------------
  2599 5E5D			Path_Pop_Segment
  2600 5E5D A2 00			ldx #$00
  2601 5E5F			Path_Pop_End
  2602 5E5F BD 28 06			lda Scan_Path,x
  2603 5E62 F0 05			beq Path_Pop_Found
