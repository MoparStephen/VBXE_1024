  2330 				;-----------------------------------------------------------------------------
  2331 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2332 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2333 				; the whole .NFO is shorter than the window, clear first and blit only the
  2334 				; records that exist.
  2335 				;-----------------------------------------------------------------------------
  2336 5CB6			Info_Draw
  2337 5CB6 A9 01			lda #$01
  2338 5CB8 8D B7 06			sta Txt_Dirty						; the blit below writes the back buffer
  2339 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2340 5CBB 38				sec
  2341 5CBC AD DE 04			lda Nfo_LineCount
  2342 5CBF ED DC 04			sbc Nfo_Top
  2343 5CC2 85 84			sta Reg5
  2344 5CC4 AD DF 04			lda Nfo_LineCount + $01
  2345 5CC7 ED DD 04			sbc Nfo_Top + $01
  2346 5CCA 85 85			sta Reg6
  2347 				; rows = min(available, NFO_VISROWS)
  2348 5CCC A5 85			lda Reg6
  2349 5CCE D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2350 5CD0 A5 84			lda Reg5
  2351 5CD2 C9 14			cmp #NFO_VISROWS
  2352 5CD4 B0 10			bcs Info_Draw_Full
  2353 				; short document: clear, then blit only the records that exist
  2354 5CD6 A5 84			lda Reg5
  2355 5CD8 85 83			sta Reg4
  2356 5CDA 20 D7 3B			jsr Text_Clear
  2357 5CDD A5 83			lda Reg4
  2358 5CDF F0 68			beq Info_Draw_Ret					; nothing to draw
  2359 5CE1 C6 83			dec Reg4							; Reg4 = height-1
  2360 5CE3 4C EA 5C			jmp Info_Draw_Blit
  2361 5CE6			Info_Draw_Full
  2362 5CE6 A9 13			lda #NFO_VISROWS-1
  2363 5CE8 85 83			sta Reg4
  2364 5CEA			Info_Draw_Blit
  2365 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2366 5CEA A9 00			lda #$00
  2367 5CEC 85 80			sta Reg1
  2368 5CEE 85 81			sta Reg2
  2369 5CF0 AE DC 04			ldx Nfo_Top
  2370 5CF3 F0 0E			beq Info_Draw_Patch
  2371 5CF5			Info_Draw_MulL
  2372 5CF5 A5 80			lda Reg1
  2373 5CF7 18				clc
  2374 5CF8 69 A0			adc #TEXT_PITCH
  2375 5CFA 85 80			sta Reg1
  2376 5CFC 90 02			bcc Info_Draw_MulNC
  2377 5CFE E6 81			inc Reg2
  2378 5D00			Info_Draw_MulNC
  2379 5D00 CA				dex
  2380 5D01 D0 F2			bne Info_Draw_MulL
  2381 5D03			Info_Draw_Patch
  2382 5D03 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2383 5D05				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5D05 A0 5F			ldy #<VBXE_MA_BSEL
     3 5D07 91 93			sta (VBXEBase),y
Source: ui.asm
  2384 5D09 A5 80			lda Reg1
  2385 5D0B 8D 69 21			sta BLT_NFO_DRAW + Src_Adr0			; source lo  = offset lo
  2386 5D0E A5 81			lda Reg2
  2387 5D10 18				clc
  2388 5D11 69 50			adc #$50							; + $50  (low 16 bits of NFO_BUF_VRAM = $5000)
  2389 5D13 8D 6A 21			sta BLT_NFO_DRAW + Src_Adr1			; source mid ; source hi stays $02 (Reg2 max $3D, no carry)
  2390 5D16 A5 83			lda Reg4
  2391 5D18 8D 77 21			sta BLT_NFO_DRAW + Blt_H
  2392 5D1B A9 00			lda #MEMAC_GLOBAL_DISABLE
  2393 5D1D				vbsta VBXE_MA_BSEL
