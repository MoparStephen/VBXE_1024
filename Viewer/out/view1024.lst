   686 				;-----------------------------------------------------------------------------
   687 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   688 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   689 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   690 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   691 				;-----------------------------------------------------------------------------
   692 3472			Image_Read_Segment
   693 3472 8D E3 04			sta Seg_Bank
   694 3475 8E E4 04			stx Seg_Chunks
   695 3478			Image_Read_Segment_L1
   696 3478 AD E4 04			lda Seg_Chunks
   697 347B F0 0F			beq Image_Read_Segment_Tail
   698 347D A9 00			lda #<VBXE_WINDOW_SIZE_4k
   699 347F A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   700 3481 20 9F 34			jsr Image_Read_Chunk
   701 3484 B0 18			bcs Image_Read_Segment_Done
   702 3486 CE E4 04			dec Seg_Chunks
   703 3489 4C 78 34			jmp Image_Read_Segment_L1
   704
   705 348C			Image_Read_Segment_Tail
   706 348C AD E5 04			lda Seg_Tail
   707 348F 0D E6 04			ora Seg_Tail + $01
   708 3492 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   709 3494 AD E5 04			lda Seg_Tail
   710 3497 AC E6 04			ldy Seg_Tail + $01
   711 349A 4C 9F 34			jmp Image_Read_Chunk
   712
   713 349D			Image_Read_Segment_OK
   714 349D 18				clc
   715 349E			Image_Read_Segment_Done
   716 349E 60				rts
   717
   718 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   719 				; C=1 on a CIO error.
