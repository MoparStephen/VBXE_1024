  1869 3C6B B9 8D 04			lda Path_Buf,y
  1870 3C6E 91 8C			sta (Sort_Ptr),y
  1871 3C70 C8				iny
  1872 3C71 C0 08			cpy #$08
  1873 3C73 90 ED			bcc Swap_Records_L1
  1874 3C75 60				rts
