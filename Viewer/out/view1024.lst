   793 				;=============================================================================
   794 				; Selector status line (row 20) - the highlighted image's description (typed
   795 				; in the converter, default = source filename without extension; up to
   796 				; NFO_NAME_CAP = 75 chars).  Reading a file per row stuttered a fresh
   797 				; directory, so instead the converter writes all the descriptions once into
   798 				; "IMAGES.LST" (8-byte key + description per record) beside the images.  Nfo_Name_LoadManifest slurps that in one pass on every
   799 				; Rescan_Images into NFO_NAME_VRAM (NFO_NAME_SLOT bytes/ordinal); the draw path
   800 				; is then a pure VRAM read.  No IMAGES.LST -> every slot stays $00 -> the line
   801 				; is simply blank.
   802 				;=============================================================================
   803
   804 				;-----------------------------------------------------------------------------
   805 				; Nfo_Name_ClearCache - blitter-wipe NFO_NAME_VRAM to $00 (every slot "no
   806 				; name").  Kicks BLT_NFO_NAME_CLEAR and waits (Nfo_Name_LoadManifest fills
   807 				; after).
   808 				;-----------------------------------------------------------------------------
   809 5249			Nfo_Name_ClearCache
   810 5249 A9 E6			lda #BLT_NFO_NAME_CLEAR-BLT_CLEAR
   811 524B				vbsta VBXE_BL_ADR0
