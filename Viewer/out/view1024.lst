  2392 				;-----------------------------------------------------------------------------
  2393 				; Slideshow_Tick - called from main every frame.  Counts Slide_FrameCtr down
  2394 				; and advances to the next image at zero.  No-op unless UI_Mode = 2.
  2395 				;-----------------------------------------------------------------------------
  2396 5FAA			Slideshow_Tick
  2397 5FAA AD C6 04			lda UI_Mode
  2398 5FAD C9 02			cmp #$02
  2399 5FAF F0 01			beq Slideshow_Tick_Run
  2400 5FB1 60				rts
  2401 5FB2			Slideshow_Tick_Run
  2402 5FB2 AD CA 04			lda Slide_FrameCtr
  2403 5FB5 D0 08			bne Slideshow_Tick_Dec
  2404 5FB7 AD CB 04			lda Slide_FrameCtr+1
  2405 5FBA F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2406 5FBC CE CB 04			dec Slide_FrameCtr+1
  2407 5FBF			Slideshow_Tick_Dec
  2408 5FBF CE CA 04			dec Slide_FrameCtr
  2409 5FC2 60				rts
  2410 5FC3			Slideshow_Tick_Fire
  2411 5FC3 20 B4 34			jsr Clear_Screen
  2412 5FC6 20 0E 3A			jsr Increment_Image
  2413 5FC9 20 CD 5F			jsr Slideshow_Reload_Counter
