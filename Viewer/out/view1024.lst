    69 				;-----------------------------------------------------------------------------
    70 				; Text_Init - default pen, load the font, blank the screen.  Called once.
    71 				;-----------------------------------------------------------------------------
    72 3CAE			Text_Init
    73 3CAE A9 0F			lda #TEXT_DEF_FG
    74 3CB0 A2 00			ldx #TEXT_DEF_BG
    75 3CB2 20 D8 3D			jsr Text_SetPen						; sets Txt_Attr
    76
    77 3CB5 20 BE 3C			jsr Text_Load_Fonts					; embedded CGA.F08 + ATARI.F08 -> VRAM bank $22
    78 3CB8 20 F2 3D			jsr Text_Clear						; blank the back buffer...
    79 3CBB 4C 9A 3D			jmp Text_Present					; ...and the displayed screen, then rts
    80
    81 				;-----------------------------------------------------------------------------
    82 				; Text_Load_Fonts - copy both embedded 2048-byte fonts into VRAM bank
    83 				; TEXT_FONT_BANK ($22) through the $2000 window: CGA.F08 -> $022000 (CHBASE
    84 				; $44), ATARI.F08 -> $022800 (CHBASE $45).  Fonts are embedded rather than
    85 				; streamed from disk so the viewer never depends on a font file being on
    86 				; whatever disk it happens to boot from.  F (Handle_Keys) flips XDL_MainMenu's
    87 				; two CHBASE bytes (main + footer text blocks) between the two.
    88 				;-----------------------------------------------------------------------------
    89 3CBE			Text_Load_Fonts
    90 3CBE A9 A2			lda #TEXT_FONT_BANK | MEMAC_GLOBAL_ENABLE
    91 3CC0				vbsta VBXE_MA_BSEL					; map VRAM bank $22 into $2000-$2FFF
Macro: VBSTA [Source: vbxe_min.asm]
     2 3CC0 A0 5F			ldy #<VBXE_MA_BSEL
     3 3CC2 91 93			sta (VBXEBase),y
Source: text80.asm
    92
    93 3CC4 A9 A8			lda #<Text_Font_Data
    94 3CC6 85 88			sta Ptr_Lo
    95 3CC8 A9 40			lda #>Text_Font_Data
    96 3CCA 85 89			sta Ptr_Hi
    97 3CCC A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3CCE 85 80			sta Reg1
    99 3CD0 A9 20			lda #>VBXE_WINDOW
   100 3CD2 85 81			sta Reg2
   101 3CD4 20 46 3D			jsr Text_Copy_2K
   102
   103 3CD7 A9 A8			lda #<Atari_Font_Data
   104 3CD9 85 88			sta Ptr_Lo
   105 3CDB A9 48			lda #>Atari_Font_Data
   106 3CDD 85 89			sta Ptr_Hi
   107 3CDF A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3CE1 85 80			sta Reg1
   109 3CE3 A9 28			lda #>[VBXE_WINDOW + $800]
   110 3CE5 85 81			sta Reg2
   111 3CE7 20 46 3D			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3CEA A2 00			ldx #$00
   120 3CEC			Text_Load_Fonts_Remap
   121 3CEC BD 26 3D			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3CEF 20 16 3D			jsr Text_Glyph_Addr
   123 3CF2 85 88			sta Ptr_Lo
   124 3CF4 84 89			sty Ptr_Hi
   125 3CF6 BD 27 3D			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3CF9 20 16 3D			jsr Text_Glyph_Addr
   127 3CFC 85 80			sta Reg1
   128 3CFE 84 81			sty Reg2
   129 3D00 A0 07			ldy #$07
   130 3D02			Text_Load_Fonts_Glyph
   131 3D02 B1 88			lda (Ptr_Lo),y
   132 3D04 91 80			sta (Reg1),y
   133 3D06 88				dey
   134 3D07 10 F9			bpl Text_Load_Fonts_Glyph
   135 3D09 E8				inx
   136 3D0A E8				inx
   137 3D0B E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3D0D D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3D0F A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3D11				vbsta VBXE_MA_BSEL
