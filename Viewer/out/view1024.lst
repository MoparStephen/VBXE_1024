  1400 55F3 0D 8C 04			ora ImageCount+1
  1401 55F6 F0 33			beq Sel_Key_Nav_Done				; empty list
  1402 55F8 AE C7 04			ldx Sel_Index
  1403 55FB E8				inx
  1404 55FC EC 8B 04			cpx ImageCount
  1405 55FF B0 2A			bcs Sel_Key_Nav_Done				; already at the last item
  1406 5601 8A				txa
  1407 5602 4C 05 56			jmp Sel_Nav_Apply
