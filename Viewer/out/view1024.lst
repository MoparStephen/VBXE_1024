   641 				;-----------------------------------------------------------------------------
   642 				; Load_Image
   643 				; File_Index must be set before calling this!  No range checking is done!
   644 				; One OPEN of D:<name>.V1K, three sequential block reads:
   645 				;   .PAL block -> $21000, pushed to palette registers 0-3
   646 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   647 				;   .RAW block -> $01000 framebuffer
   648 				; A missing or short file stops at the failing block and closes the IOCB.
   649 				;-----------------------------------------------------------------------------
   650 3412			Load_Image
   651 3412 A9 00			lda #$00							; ext 0 = .V1K
   652 3414 20 C9 38			jsr Build_Filename
   653 3417 20 66 34			jsr Image_Open
   654 341A B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   655
   656 341C 20 55 34			jsr Image_Read_Pal
   657 341F B0 2A			bcs Load_Image_Close
   658 3421 20 D2 33			jsr Apply_Image_Palette
   659
   660 3424 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   661 3426 A2 02			ldx #V1K_MAP_LEN / $1000
   662 3428 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   663 342A 8C E5 04			sty Seg_Tail
   664 342D A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   665 342F 8C E6 04			sty Seg_Tail + $01
   666 3432 20 97 34			jsr Image_Read_Segment
   667 3435 B0 14			bcs Load_Image_Close
   668 3437 20 57 33			jsr Setup_Cmap1						; Expand the data out to $17000
   669
   670 343A A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   671 343C A2 12			ldx #V1K_RAW_LEN / $1000
   672 343E A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   673 3440 8C E5 04			sty Seg_Tail
   674 3443 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   675 3445 8C E6 04			sty Seg_Tail + $01
   676 3448 20 97 34			jsr Image_Read_Segment
   677
   678 344B			Load_Image_Close
   679 344B 20 F2 34			jsr Image_Close
   680
   681 344E			Load_Image_Done
   682 344E A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   683 3450				vbsta VBXE_MA_BSEL
