   683 				;-----------------------------------------------------------------------------
   684 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   685 				; write it space-padded to exactly 8 bytes at Name_Ptr. Skips leading spaces
   686 				; and the '*' protect flag; stops the name at space/'.'/EOL. Rejects an
   687 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   688 				;  returns A = $01 if a name was written, $00 if not.
   689 				; Ported verbatim from getdir.asm (Reg1 is already declared in view1024.asm).
   690 				;-----------------------------------------------------------------------------
   691 33D6			Parse_Dir_Line
   692 33D6 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   693 33D8			Parse_Skip_L1							; Skip leading spaces / protect flag
   694 33D8 BD 00 06			lda Dir_Line_Buf,x
   695 33DB C9 9B			cmp #$9B
   696 33DD F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   697 33DF C9 20			cmp #' '
   698 33E1 F0 04			beq Parse_Skip_Next
   699 33E3 C9 2A			cmp #'*'
   700 33E5 D0 07			bne Parse_Skip_Done
   701 33E7			Parse_Skip_Next
   702 33E7 E8				inx
   703 33E8 E0 28			cpx #Dir_Line_Len
   704 33EA 90 EC			bcc Parse_Skip_L1
   705 33EC B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   706 33EE			Parse_Skip_Done
   707 33EE A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   708 33F0 A9 00			lda #$00
   709 33F2 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   710
   711 33F4			Parse_Copy_L1
   712 33F4 BD 00 06			lda Dir_Line_Buf,x
   713 33F7 C9 9B			cmp #$9B
   714 33F9 F0 24			beq Parse_Copy_Done
   715 33FB C9 20			cmp #' '
   716 33FD F0 20			beq Parse_Copy_Done
   717 33FF C9 2E			cmp #'.'
   718 3401 F0 1C			beq Parse_Copy_Done
   719 3403 C9 30			cmp #'0'
   720 3405 90 07			bcc Parse_Copy_Is_Name_Char
   721 3407 C9 3A			cmp #'9'+1
   722 3409 B0 03			bcs Parse_Copy_Is_Name_Char
   723 340B 4C 10 34			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   724 340E			Parse_Copy_Is_Name_Char
   725 340E E6 80			inc Reg1
   726 3410			Parse_Copy_Store
   727 3410 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   728 3412 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
