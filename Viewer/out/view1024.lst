   922 511A F0 0A			beq Nfo_Name_Emit_Pad
   923 511C 99 8D 04			sta Path_Buf,y
   924 511F C8				iny
   925 5120 C0 30			cpy #NFO_NAME_CAP
   926 5122 90 F4			bcc Nfo_Name_Emit_Copy
