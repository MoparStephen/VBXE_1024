  2882 627F CA				dex
  2883 6280 BD 28 06			lda Scan_Path,x
  2884 6283 C9 3E			cmp #'>'
  2885 6285 D0 F4			bne Path_Save_Back
  2886 6287 E8				inx									; first char after the separator
  2887 6288			Path_Save_Copy
  2888 6288 A0 00			ldy #$00
  2889 628A			Path_Save_L1
  2890 628A BD 28 06			lda Scan_Path,x
  2891 628D C9 3E			cmp #'>'
  2892 628F F0 09			beq Path_Save_Done
  2893 6291 99 EC 04			sta Up_Name,y
  2894 6294 E8				inx
  2895 6295 C8				iny
  2896 6296 C0 08			cpy #$08
  2897 6298 90 F0			bcc Path_Save_L1
  2898 629A			Path_Save_Done
  2899 629A 60				rts
