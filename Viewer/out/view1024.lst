  1598 				; Sel_Key_Down/Up/Left/Right - each validates and clamps the move, then hands
  1599 				; the new index to Sel_Nav_Apply.  Because the list is one flat, row-major
  1600 				; array, Left/Right wrapping across a row boundary needs no extra logic -
  1601 				; it's just Sel_Index +/- 1.
  1602 5AB4			Sel_Key_Down
  1603 5AB4 AD 8B 04			lda ImageCount
  1604 5AB7 0D 8C 04			ora ImageCount+1
  1605 5ABA F0 61			beq Sel_Key_Nav_Done				; empty list
  1606 5ABC AD C7 04			lda Sel_Index
  1607 5ABF 18				clc
  1608 5AC0 69 08			adc #UI_COLS
  1609 5AC2 CD 8B 04			cmp ImageCount
  1610 5AC5 B0 56			bcs Sel_Key_Nav_Done				; no cell directly below - clamp
  1611 5AC7 4C F7 5A			jmp Sel_Nav_Apply
  1612
  1613 5ACA			Sel_Key_Up
  1614 5ACA AD C7 04			lda Sel_Index
  1615 5ACD C9 08			cmp #UI_COLS
  1616 5ACF 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1617 5AD1 38				sec
  1618 5AD2 E9 08			sbc #UI_COLS
  1619 5AD4 4C F7 5A			jmp Sel_Nav_Apply
  1620
  1621 5AD7			Sel_Key_Left
  1622 5AD7 AD C7 04			lda Sel_Index
  1623 5ADA F0 41			beq Sel_Key_Nav_Done				; already at the first item
  1624 5ADC 38				sec
  1625 5ADD E9 01			sbc #$01
  1626 5ADF 4C F7 5A			jmp Sel_Nav_Apply
  1627
  1628 5AE2			Sel_Key_Right
  1629 5AE2 AD 8B 04			lda ImageCount
  1630 5AE5 0D 8C 04			ora ImageCount+1
  1631 5AE8 F0 33			beq Sel_Key_Nav_Done				; empty list
  1632 5AEA AE C7 04			ldx Sel_Index
  1633 5AED E8				inx
  1634 5AEE EC 8B 04			cpx ImageCount
  1635 5AF1 B0 2A			bcs Sel_Key_Nav_Done				; already at the last item
  1636 5AF3 8A				txa
  1637 5AF4 4C F7 5A			jmp Sel_Nav_Apply
