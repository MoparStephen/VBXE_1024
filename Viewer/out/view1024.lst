  2410 				;-----------------------------------------------------------------------------
  2411 				; Slideshow_Reload_Counter - Slide_FrameCtr = Slide_Secs * framerate
  2412 				;   framerate = 50 (PAL, Video_Flag = 0) or 60 (NTSC, Video_Flag = 1)
  2413 				;-----------------------------------------------------------------------------
  2414 5D7C			Slideshow_Reload_Counter
  2415 5D7C A9 00			lda #$00
  2416 5D7E 8D CA 04			sta Slide_FrameCtr
  2417 5D81 8D CB 04			sta Slide_FrameCtr+1
  2418 5D84 AE C9 04			ldx Slide_Secs
  2419 5D87 F0 1E			beq Slideshow_Reload_Done
  2420 5D89 AD 89 04			lda Video_Flag
  2421 5D8C D0 04			bne Slideshow_Reload_NTSC
  2422 5D8E A9 32			lda #50
  2423 5D90 D0 02			bne Slideshow_Reload_Set
  2424 5D92			Slideshow_Reload_NTSC
  2425 5D92 A9 3C			lda #60
  2426 5D94			Slideshow_Reload_Set
  2427 5D94 85 80			sta Reg1							; Reg1 = frames to add per second
  2428 5D96			Slideshow_Reload_L1
  2429 5D96 18				clc
  2430 5D97 AD CA 04			lda Slide_FrameCtr
  2431 5D9A 65 80			adc Reg1
  2432 5D9C 8D CA 04			sta Slide_FrameCtr
  2433 5D9F 90 03			bcc Slideshow_Reload_NoCarry
  2434 5DA1 EE CB 04			inc Slide_FrameCtr+1
  2435 5DA4			Slideshow_Reload_NoCarry
  2436 5DA4 CA				dex
  2437 5DA5 D0 EF			bne Slideshow_Reload_L1
  2438 5DA7			Slideshow_Reload_Done
  2439 5DA7 60				rts
