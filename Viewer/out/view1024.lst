  2913 62AB B0 25			bcs Sel_Find_Up_Done				; past the last directory - not found
  2914 62AD A2 40			ldx #IMAGE_BANK
  2915 62AF 20 EB 58			jsr UI_ReadRec						; Name_Row_Buf = 8-byte record
  2916 62B2 A0 07			ldy #$07
  2917 62B4			Sel_Find_Up_Cmp
  2918 62B4 B9 CD 04			lda Name_Row_Buf,y
  2919 62B7 D9 EC 04			cmp Up_Name,y
