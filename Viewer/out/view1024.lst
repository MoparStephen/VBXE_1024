   983 362A 85 81			sta Reg2
   984 362C A9 09			lda #<Menu_Demo_Attr_Bot_Vals
   985 362E 85 88			sta Ptr_Lo
   986 3630 A9 36			lda #>Menu_Demo_Attr_Bot_Vals
   987 3632 85 89			sta Ptr_Hi
   988 3634 20 3E 36			jsr Set_Menu_Demo_Attr_Band
