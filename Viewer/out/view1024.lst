  2406 5F85 CE CB 04			dec Slide_FrameCtr+1
  2407 5F88			Slideshow_Tick_Dec
  2408 5F88 CE CA 04			dec Slide_FrameCtr
  2409 5F8B 60				rts
  2410 5F8C			Slideshow_Tick_Fire
  2411 5F8C 20 7D 34			jsr Clear_Screen
  2412 5F8F 20 D7 39			jsr Increment_Image
