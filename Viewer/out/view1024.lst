  2420 5D4E 69 14			adc #NFO_VISROWS
  2421 5D50 85 84			sta Reg5
  2422 5D52 AD DD 04			lda Nfo_Top + $01
  2423 5D55 69 00			adc #$00
  2424 5D57 85 85			sta Reg6
  2425 5D59 A5 84			lda Reg5
  2426 5D5B CD DE 04			cmp Nfo_LineCount
  2427 5D5E A5 85			lda Reg6
