  2518 				;-----------------------------------------------------------------------------
  2519 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2520 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2521 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2522 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2523 				; its 19 rows, clear first and blit only the records that exist.
  2524 				;-----------------------------------------------------------------------------
  2525 5E5F			Info_Draw
  2526 5E5F A9 01			lda #$01
  2527 5E61 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2528 5E64 AD DE 04			lda Nfo_LineCount
  2529 5E67 0D DF 04			ora Nfo_LineCount + $01
  2530 5E6A D0 03			bne Info_Draw_Some
  2531 5E6C 4C 3C 3C			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2532 5E6F			Info_Draw_Some
  2533 5E6F 20 B4 5E			jsr Info_Body_Rows
  2534 5E72 C9 13			cmp #NFO_VISROWS-1
  2535 5E74 B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2536 5E76 20 3C 3C			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2537 5E79			Info_Draw_Head
  2538 5E79 A9 00			lda #$00							; record 0 -> row 0, one row
  2539 5E7B 85 80			sta Reg1
  2540 5E7D 85 81			sta Reg2
  2541 5E7F 85 83			sta Reg4
  2542 5E81 A9 00			lda #<TEXT_BACK_VRAM
  2543 5E83 85 82			sta Reg3
  2544 5E85 20 DD 5E			jsr Info_Blit
  2545 5E88 20 B4 5E			jsr Info_Body_Rows
  2546 5E8B F0 26			beq Info_Draw_Ret					; no body records
  2547 5E8D 85 83			sta Reg4
  2548 5E8F C6 83			dec Reg4							; Reg4 = height-1
  2549 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2550 5E91 A9 A0			lda #TEXT_PITCH
  2551 5E93 85 80			sta Reg1
  2552 5E95 A9 00			lda #$00
  2553 5E97 85 81			sta Reg2
  2554 5E99 AE DC 04			ldx Nfo_Top
  2555 5E9C F0 0E			beq Info_Draw_Body
  2556 5E9E			Info_Draw_MulL
  2557 5E9E A5 80			lda Reg1
  2558 5EA0 18				clc
  2559 5EA1 69 A0			adc #TEXT_PITCH
  2560 5EA3 85 80			sta Reg1
  2561 5EA5 90 02			bcc Info_Draw_MulNC
  2562 5EA7 E6 81			inc Reg2
  2563 5EA9			Info_Draw_MulNC
  2564 5EA9 CA				dex
  2565 5EAA D0 F2			bne Info_Draw_MulL
  2566 5EAC			Info_Draw_Body
  2567 5EAC A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2568 5EAE 85 82			sta Reg3
  2569 5EB0 4C DD 5E			jmp Info_Blit						; (tail)
  2570 5EB3			Info_Draw_Ret
  2571 5EB3 60				rts
  2572
  2573 				;-----------------------------------------------------------------------------
  2574 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2575 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2576 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2577 				;-----------------------------------------------------------------------------
  2578 5EB4			Info_Body_Rows
  2579 5EB4 38				sec
  2580 5EB5 AD DE 04			lda Nfo_LineCount
  2581 5EB8 ED DC 04			sbc Nfo_Top
  2582 5EBB 85 84			sta Reg5
  2583 5EBD AD DF 04			lda Nfo_LineCount + $01
  2584 5EC0 ED DD 04			sbc Nfo_Top + $01
  2585 5EC3 85 85			sta Reg6
  2586 5EC5 A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2587 5EC7 38				sec
  2588 5EC8 E9 01			sbc #$01
  2589 5ECA 85 84			sta Reg5
  2590 5ECC A5 85			lda Reg6
  2591 5ECE E9 00			sbc #$00
  2592 5ED0 D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2593 5ED2 A5 84			lda Reg5
  2594 5ED4 C9 13			cmp #NFO_VISROWS-1
  2595 5ED6 90 02			bcc Info_Body_Rows_Ret
  2596 5ED8			Info_Body_Rows_Full
  2597 5ED8 A9 13			lda #NFO_VISROWS-1
  2598 5EDA			Info_Body_Rows_Ret
  2599 5EDA C9 00			cmp #$00							; Z = no rows
  2600 5EDC 60				rts
  2601
  2602 				;-----------------------------------------------------------------------------
  2603 				; Info_Blit - one BLT_NFO_DRAW copy: Reg2:Reg1 = source offset into the NFO
  2604 				; buffer, Reg3 = destination lo byte (in the back buffer's first page),
  2605 				; Reg4 = height-1.  Waits for the copy to finish.
  2606 				;-----------------------------------------------------------------------------
  2607 5EDD			Info_Blit
  2608 5EDD A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2609 5EDF				vbsta VBXE_MA_BSEL
