  2169 5E7F F0 06			beq Pal_Preview_Keys_Selector
  2170 5E81 20 F9 3A			jsr Return_To_Image					; opened from the image - back to it (view1024.asm)
  2171 5E84 4C 16 3A			jmp Read_Key_Done
