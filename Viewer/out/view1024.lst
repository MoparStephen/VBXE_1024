    83 3A82 A9 95			lda #<Text_Font_Data
    84 3A84 85 88			sta Ptr_Lo
    85 3A86 A9 3D			lda #>Text_Font_Data
    86 3A88 85 89			sta Ptr_Hi
    87 3A8A A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    88 3A8C 85 80			sta Reg1
    89 3A8E A9 20			lda #>VBXE_WINDOW
    90 3A90 85 81			sta Reg2
    91 3A92 20 AF 3A			jsr Text_Copy_2K
    92
    93 3A95 A9 95			lda #<Atari_Font_Data
    94 3A97 85 88			sta Ptr_Lo
