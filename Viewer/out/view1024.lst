  1592 				;-----------------------------------------------------------------------------
  1593 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1594 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1595 				; equal) otherwise.
  1596 				;-----------------------------------------------------------------------------
  1597 39B4			Cmp_Records
  1598 39B4 A0 00			ldy #$00
  1599 39B6			Cmp_Records_L1
  1600 39B6 B1 8A			lda (Name_Ptr),y
  1601 39B8 D1 8C			cmp (Sort_Ptr),y
  1602 39BA D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1603 39BC C8				iny
  1604 39BD C0 08			cpy #$08
  1605 39BF 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1606 39C1			Cmp_Records_Done
  1607 39C1 60				rts
