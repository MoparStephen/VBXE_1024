  1769 3BB3 26 83			rol Reg4							; Reg3/Reg4 = File_Index * 8
  1770 3BB5 A5 82			lda Reg3
  1771 3BB7 18				clc
  1772 3BB8 69 00			adc #<ImageNames
  1773 3BBA 85 8A			sta Name_Ptr
  1774 3BBC A5 83			lda Reg4
  1775 3BBE 69 20			adc #>ImageNames
