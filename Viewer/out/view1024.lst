   468 				;-----------------------------------------------------------------------------
   469 				; Reset_Handler - DOSINI points here once start has run.  The OS warm start
   470 				; (RESET key) calls it: let SDX do its own reinit through the saved DOSINI,
   471 				; then jump back into the viewer instead of returning to the OS (which would
   472 				; jmp (DOSVEC) to the SDX prompt with VBXE still showing the image).
   473 				; Resident because DOSINI is live for the program's whole run.
   474 				;-----------------------------------------------------------------------------
   475 3257			Reset_Handler
   476 3257 20 72 32			jsr Reset_Blank						; black before SDX's reinit gets going
   477 325A 20 6F 32			jsr Reset_Old_DOSINI				; SDX warm reinit (closes files, drivers)
   478 325D 20 72 32			jsr Reset_Blank						; ...and again - the reinit may have re-enabled them
   479 3260 A9 57			lda #<Reset_Handler
   480 3262 85 0C			sta DOSINI
   481 3264 A9 32			lda #>Reset_Handler
   482 3266 85 0D			sta DOSINI + 1						; re-arm, in case the reinit rewrote it
   483 3268 AE 84 04			ldx SP_REG_OLD
   484 326B 9A				txs									; abandon whatever was running
   485 326C 4C 54 34			jmp Reset_Reenter					; main segment - loaded long before DOSINI is hooked
   486 326F			Reset_Old_DOSINI
   487 326F 6C 87 04			jmp (DOSINIL_OLD)					; DOSINIL_OLD/H = $487/$488, a word vector
   488
   489 				; Reset_Blank - ANTIC DMA off now (DMACTL, not just the shadow) and the VBXE
   490 				; XDL off, so nothing shows until Enter_Selector's Display_On.
   491 3272			Reset_Blank
   492 3272 A9 00			lda #$00
   493 3274 8D 2F 02			sta SDMCTL							; shadow - stops the VBI turning it back on
   494 3277 8D 00 D4			sta DMACTL							; hardware - off this frame, not next VBI
   495 327A A9 02			lda #%00000010						; XDL off, XCOLOR on (= Display_Off)
   496 327C				vbsta VBXE_VIDEO_CONTROL
