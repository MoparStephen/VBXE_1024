  2120 5E22 20 F9 34			jsr Read_Image_Palette				; .PAL block -> $21000, registers untouched
  2121 5E25 90 03			bcc Selector_Handle_P_Loaded
  2122 5E27 4C 06 55			jmp Selector_Restore_LocRow			; failed - selector stays up (tail)
  2123
  2124 5E2A			Selector_Handle_P_Loaded
  2125 5E2A 20 A9 3A			jsr Set_Attr_Source_Preview			; prebuilt at boot (Pal_Preview_Init)
  2126 5E2D 20 E5 34			jsr Display_Off						; blank while the registers change
  2127 5E30 20 0C 35			jsr Apply_Image_Palette				; sets Pal_Image -> Enter_Selector restores
