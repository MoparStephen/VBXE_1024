   989 5197 B9 BF 06			lda Nfo_Name_Line + 8,y
   990 519A C9 9B			cmp #$9B
   991 519C F0 0B			beq Nfo_Name_LoadManifest_CopyEnd	; end of record
   992 519E C9 20			cmp #$20
   993 51A0 90 07			bcc Nfo_Name_LoadManifest_CopyEnd	; NUL / control -> stop
   994 51A2 91 88			sta (Ptr_Lo),y
   995 51A4 C8				iny
   996 51A5 C0 30			cpy #NFO_NAME_CAP
   997 51A7 90 EE			bcc Nfo_Name_LoadManifest_Copy
   998 51A9			Nfo_Name_LoadManifest_CopyEnd
   999 51A9 A9 00			lda #$00
  1000 51AB 91 88			sta (Ptr_Lo),y						; NUL-terminate (Y may be 0 -> "no name")
  1001 51AD A9 00			lda #MEMAC_GLOBAL_DISABLE
