   226 				;-----------------------------------------------------------------------------
   227 				; Restores VBXE Palette 0 based on NTSC/PAL test
   228 				;-----------------------------------------------------------------------------
   229 3372			Restore_Palette0
   230 3372 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE		; Bank $00 VBXE Window Enabled
   231 3374 8D 5F D6			sta VBXE_MA_BSEL
   232
   233 3377 AD 89 04			lda Video_Flag						; 0 = PAL, 1 = NTSC
   234 337A D0 0B			bne Restore_Palette0_Setup_NTSC
   235 337C			Restore_Palette0_Setup_PAL
   236 337C A9 00			lda <(VBXE_WINDOW + $0500)
   237 337E 85 91			sta Y_Register
   238 3380 A9 25			lda >(VBXE_WINDOW + $0500)			; PAL_Palette = $00500 - $006FF
   239 3382 85 92			sta Y_Register + $01
   240 3384 4C 8F 33			jmp Restore_Palette0_SetPalette
   241
   242 3387			Restore_Palette0_Setup_NTSC
   243 3387 A9 00			lda <(VBXE_WINDOW + $0200)
   244 3389 85 91			sta Y_Register
   245 338B A9 22			lda >(VBXE_WINDOW + $0200)			; NTSC_Palette = $00200 - $004FF
   246 338D 85 92			sta Y_Register + $01
   247
   248 338F			Restore_Palette0_SetPalette
   249 338F A9 00			lda #$00							; Set Palette 0
   250 3391 20 6C 31			jsr VBXE_SetPalette2
   251
   252 3394			Restore_Palette0_Done
   253 3394 A9 00			lda	#MEMAC_GLOBAL_DISABLE			; USE CPU address space
   254 3396 8D 5F D6			sta VBXE_MA_BSEL
   255
   256 3399 60				rts
   257
   258 				;-----------------------------------------------------------------------------
   259 				; Load_Image
   260 				; File_Index must be set before calling this!  No range checking is done!
   261 				;-----------------------------------------------------------------------------
   262 339A			Load_Image
   263 				; Load the Palettes
   264 339A A9 80			lda	#MEMAC_GLOBAL_ENABLE
   265 339C 8D 5F D6			sta	VBXE_MA_BSEL
   266 339F 18				clc
   267 33A0 A9 61			lda #<Palettes
   268 33A2 6D 8A 04			adc File_Index
   269 33A5 8D 33 31			sta FileNamePtr
   270 33A8 A9 34			lda #>Palettes
   271 33AA 69 00			adc #$00
   272 33AC 8D 34 31			sta FileNamePtr + $01
   273 33AF A9 21			lda	#$21
   274 33B1 85 8A			sta	BankIndex						; Load Colour Map data under $21000
   275 33B3 20 AA 30			jsr	LoadData
   276
   277 33B6 A9 A1			lda	#$21 | MEMAC_GLOBAL_ENABLE		; Bank $21 VBXE Window Enabled
   278 33B8 8D 5F D6			sta	VBXE_MA_BSEL
   279 33BB A9 00			lda <(VBXE_WINDOW + $0000)
   280 33BD 85 91			sta Y_Register
   281 33BF A9 20			lda >(VBXE_WINDOW + $0000)
   282 33C1 85 92			sta Y_Register + $01
   283 33C3 A9 00			lda #$00							; Set Palette 0
   284 33C5 20 6C 31			jsr VBXE_SetPalette2
   285
   286 33C8 A9 00			lda <(VBXE_WINDOW + $0300)
   287 33CA 85 91			sta Y_Register
   288 33CC A9 23			lda >(VBXE_WINDOW + $0300)
   289 33CE 85 92			sta Y_Register + $01
   290 33D0 A9 01			lda #$01							; Set Palette 1
   291 33D2 20 6C 31			jsr VBXE_SetPalette2
   292
   293 33D5 A9 00			lda <(VBXE_WINDOW + $0600)
   294 33D7 85 91			sta Y_Register
   295 33D9 A9 26			lda >(VBXE_WINDOW + $0600)
   296 33DB 85 92			sta Y_Register + $01
   297 33DD A9 02			lda #$02							; Set Palette 2
   298 33DF 20 6C 31			jsr VBXE_SetPalette2
   299
   300 33E2 A9 00			lda <(VBXE_WINDOW + $0900)
   301 33E4 85 91			sta Y_Register
   302 33E6 A9 29			lda >(VBXE_WINDOW + $0900)
   303 33E8 85 92			sta Y_Register + $01
   304 33EA A9 03			lda #$03							; Set Palette 3
   305 33EC 20 6C 31			jsr VBXE_SetPalette2
   306
   307 				; Load the Attribute Colour Map
   308 33EF A9 80			lda	#MEMAC_GLOBAL_ENABLE
   309 33F1 8D 5F D6			sta	VBXE_MA_BSEL
   310 33F4 18				clc
   311 33F5 A9 01			lda #<Colour
   312 33F7 6D 8A 04			adc File_Index
   313 33FA 8D 33 31			sta FileNamePtr
   314 33FD A9 35			lda #>Colour
   315 33FF 69 00			adc #$00
   316 3401 8D 34 31			sta FileNamePtr + $01
   317 3404 A9 14			lda	#$14
   318 3406 85 8A			sta	BankIndex						; Load Colour Map data under $14000
   319 3408 20 AA 30			jsr	LoadData
   320
   321 340B 20 36 33			jsr Setup_Cmap1						; Expand the data out to $17000
   322
   323 				; Load the Image
   324 340E A9 80			lda	#MEMAC_GLOBAL_ENABLE
   325 3410 8D 5F D6			sta	VBXE_MA_BSEL
   326 3413 18				clc
   327 3414 A9 A1			lda #<Image
   328 3416 6D 8A 04			adc File_Index
   329 3419 8D 33 31			sta FileNamePtr
   330 341C A9 35			lda #>Image
   331 341E 69 00			adc #$00
   332 3420 8D 34 31			sta FileNamePtr + $01
   333 3423 A9 01			lda	#$01
   334 3425 85 8A			sta	BankIndex						; Load Colour Map data under $01000
   335 3427 20 AA 30			jsr	LoadData
