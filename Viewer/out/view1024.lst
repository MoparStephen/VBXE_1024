   905 3642 A9 00			lda #$00
   906 3644 8D E7 04			sta Pal_Image
   907 3647 8D FB 04			sta Pal_Off							; every palette on
   908 364A A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE		; Bank $00 - the text palette at $00800
   909 364C				vbsta VBXE_MA_BSEL
