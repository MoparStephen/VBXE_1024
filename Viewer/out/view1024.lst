   484 3A5C			Text_PutStrAt_Col
   485 3A5C AD B1 06			lda Txt_Col
   486 3A5F 0A				asl									; Txt_Col * 2 (max 158)
   487 3A60 18				clc
   488 3A61 65 80			adc Reg1
   489 3A63 85 80			sta Reg1
   490 3A65 90 02			bcc Text_PutStrAt_ColNC
   491 3A67 E6 81			inc Reg2
   492 3A69			Text_PutStrAt_ColNC
   493 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   494 3A69 A5 81			lda Reg2
   495 3A6B 29 10			and #$10							; offset bit 12 = "second bank"
   496 3A6D F0 04			beq Text_PutStrAt_Bank0
   497 3A6F A9 24			lda #TEXT_SCREEN_BANK+1
   498 3A71 D0 02			bne Text_PutStrAt_SetBank
   499 3A73			Text_PutStrAt_Bank0
   500 3A73 A9 23			lda #TEXT_SCREEN_BANK
   501 3A75			Text_PutStrAt_SetBank
   502 3A75 8D B6 06			sta Txt_Bank
   503 3A78 A5 80			lda Reg1
   504 3A7A 85 88			sta Ptr_Lo
   505 3A7C A5 81			lda Reg2
   506 3A7E 29 0F			and #$0F
   507 3A80 18				clc
   508 3A81 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   509 3A83 85 89			sta Ptr_Hi
   510 3A85 AD B6 06			lda Txt_Bank
   511 3A88 09 80			ora #MEMAC_GLOBAL_ENABLE
   512 3A8A				vbsta VBXE_MA_BSEL
