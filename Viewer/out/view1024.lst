   581 4F99 C8				iny
   582 4F9A C0 03			cpy #$03
   583 4F9C 90 F7			bcc UI_Apply_TP_Pass_Cp
   584
   585 4F9E A5 88			lda Ptr_Lo
   586 4FA0 18				clc
