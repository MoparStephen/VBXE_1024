  1476 3A05 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1477 3A08			Decrement_Image_Step
  1478 3A08 CA				dex
  1479 3A09 8E 8A 04			stx File_Index
  1480 3A0C 20 15 35			jsr Load_Image
