   660 				;-----------------------------------------------------------------------------
   661 				; Image_Open - OPEN FileNamePtr for read on the first free IOCB (the same
   662 				; sequence LoadData uses, but the file stays open across several block reads).
   663 				;  Out: C=0 and Load_IOCB = IOCB offset, or C=1 (no IOCB / OPEN failed - the
   664 				;       IOCB is closed again so it doesn't leak).
   665 				;-----------------------------------------------------------------------------
   666 3462			Image_Open
   667 3462 20 2D 30			jsr Find_First_IOCB
   668 3465 C0 01			cpy #$01
   669 3467 D0 28			bne Image_Open_Fail					; no free IOCB
   670 3469 8E E2 04			stx Load_IOCB
   671 346C A9 04			lda #CIO_read
   672 346E 9D 4A 03			sta ICAX1,x
   673 3471 A9 00			lda #$00
   674 3473 9D 4B 03			sta ICAX2,x
   675 3476 A9 03			lda #CIO_open
   676 3478 9D 42 03			sta ICCOM,x
   677 347B AD 28 31			lda FileNamePtr
   678 347E 9D 44 03			sta ICBAL,x
   679 3481 AD 29 31			lda FileNamePtr + $01
   680 3484 9D 45 03			sta ICBAH,x
   681 3487 20 56 E4			jsr CIOV
   682 348A 30 02			bmi Image_Open_Close
   683 348C 18				clc
   684 348D 60				rts
   685 348E			Image_Open_Close
   686 348E 20 EE 34			jsr Image_Close
   687 3491			Image_Open_Fail
   688 3491 38				sec
   689 3492 60				rts
