   875 				;-----------------------------------------------------------------------------
   876 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
   877 				; address, its VBXE bank ($2A..$2D) mapped in.  slot byte offset = Ord * 64:
   878 				; bank = $2A + (Ord >> 6), window page = $20 + ((Ord >> 2) & 15),
   879 				; window low = (Ord & 3) << 6.  (64 divides 4K, so a slot never straddles.)
   880 				;-----------------------------------------------------------------------------
   881 52CF			Nfo_Name_MapSlot
   882 52CF AD E1 04			lda Nfo_Name_Ord
   883 52D2 0A				asl
   884 52D3 0A				asl
   885 52D4 0A				asl
   886 52D5 0A				asl
   887 52D6 0A				asl
   888 52D7 0A				asl									; A = (Ord & 3) << 6
   889 52D8 85 88			sta Ptr_Lo
   890 52DA AD E1 04			lda Nfo_Name_Ord
   891 52DD 4A				lsr
   892 52DE 4A				lsr
   893 52DF 29 0F			and #$0F							; (Ord >> 2) & 15
   894 52E1 18				clc
   895 52E2 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   896 52E4 85 89			sta Ptr_Hi
   897 52E6 AD E1 04			lda Nfo_Name_Ord
   898 52E9 4A				lsr
   899 52EA 4A				lsr
   900 52EB 4A				lsr
   901 52EC 4A				lsr
   902 52ED 4A				lsr
   903 52EE 4A				lsr									; Ord >> 6  (0..3)
   904 52EF 18				clc
   905 52F0 69 2A			adc #NFO_NAME_BANK
   906 52F2 09 80			ora #MEMAC_GLOBAL_ENABLE
   907 52F4				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 52F4 A0 5F			ldy #<VBXE_MA_BSEL
     3 52F6 91 93			sta (VBXEBase),y
Source: ui.asm
   908 52F8 60				rts
