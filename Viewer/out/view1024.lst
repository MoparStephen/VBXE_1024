   674 				; Load_Image
   675 				; File_Index must be set before calling this!  No range checking is done!
   676 				; One OPEN of D:<name>.V1K, three sequential block reads:
   677 				;   .PAL block -> $21000, pushed to palette registers 0-3
   678 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   679 				;   .RAW block -> $01000 framebuffer
   680 				; A missing or short file stops at the failing block and closes the IOCB.
   681 				;-----------------------------------------------------------------------------
   682 3515			Load_Image
   683 3515 A9 00			lda #$00							; ext 0 = .V1K
   684 3517 20 67 3B			jsr Build_Filename
   685 351A 20 69 35			jsr Image_Open
   686 351D B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   687
   688 351F 20 58 35			jsr Image_Read_Pal
   689 3522 B0 2A			bcs Load_Image_Close
   690 3524 20 D5 34			jsr Apply_Image_Palette
   691
   692 3527 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   693 3529 A2 02			ldx #V1K_MAP_LEN / $1000
   694 352B A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   695 352D 8C E5 04			sty Seg_Tail
   696 3530 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   697 3532 8C E6 04			sty Seg_Tail + $01
   698 3535 20 9A 35			jsr Image_Read_Segment
   699 3538 B0 14			bcs Load_Image_Close
   700 353A 20 5A 34			jsr Setup_Cmap1						; Expand the data out to $17000
   701
   702 353D A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   703 353F A2 12			ldx #V1K_RAW_LEN / $1000
   704 3541 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   705 3543 8C E5 04			sty Seg_Tail
   706 3546 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   707 3548 8C E6 04			sty Seg_Tail + $01
   708 354B 20 9A 35			jsr Image_Read_Segment
   709
   710 354E			Load_Image_Close
   711 354E 20 F5 35			jsr Image_Close
   712
   713 3551			Load_Image_Done
   714 3551 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   715 3553				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3553 A0 5F			ldy #<VBXE_MA_BSEL
     3 3555 91 93			sta (VBXEBase),y
