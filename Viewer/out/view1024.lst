   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   392 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   393 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   394 				; With the Atari font up (Font_Sel = 1) both switch to FRAME_ATARI - the
   395 				; ATASCII Ctrl-key line glyphs (Ctrl-Q/R/E/Z/C + '|'), single lines only -
   396 				; since the Atari font has other glyphs at the CP437 codes.  Uses Txt_Line as
   397 				; scratch.  Clobbers A/X/Y, Reg1..Reg8, Txt_FrameStyle.
   398 				;-----------------------------------------------------------------------------
   399 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   400 = 0009			.def	FRAME_SINGLE	= 9
   401 = 0012			.def	FRAME_ATARI		= 18			; picked automatically for the Atari font
   402
   403 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   404 3C5E			Text_Window_Frame_Chars
   405 3C5E C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   406 3C67 DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   407 3C70 11 12 05 7C 20 7C + 	dta $11,$12,$05, '|',' ','|', $1A,$12,$03	; FRAME_ATARI   (ATASCII Ctrl-Q R E / | / Ctrl-Z R C)
   408
   409 3C79			Text_Window_Frame
   410 3C79 AD E0 04			lda Font_Sel
   411 3C7C F0 05			beq Text_Window_Frame_Go			; CGA font - the style as asked
   412 3C7E A9 12			lda #FRAME_ATARI
   413 3C80 8D B5 06			sta Txt_FrameStyle
   414 3C83			Text_Window_Frame_Go
   415 3C83 A5 80			lda Reg1
   416 3C85 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   417 3C87 AD B1 06			lda Txt_Col
   418 3C8A 85 87			sta Reg8							; Reg8 = left column
   419 3C8C AD B0 06			lda Txt_Row
   420 3C8F 18				clc
   421 3C90 65 81			adc Reg2
   422 3C92 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   423 3C94 AD B0 06			lda Txt_Row
   424 3C97 85 84			sta Reg5							; Reg5 = current screen row
   425 3C99 AE B5 06			ldx Txt_FrameStyle
   426 3C9C 20 BB 3C			jsr Text_Window_Frame_Row			; top edge
   427 3C9F			Text_Window_Frame_Mid
   428 3C9F E6 84			inc Reg5
   429 3CA1 A5 84			lda Reg5
   430 3CA3 C5 85			cmp Reg6
   431 3CA5 B0 0D			bcs Text_Window_Frame_Bottom
   432 3CA7 AD B5 06			lda Txt_FrameStyle
   433 3CAA 18				clc
   434 3CAB 69 03			adc #$03
   435 3CAD AA				tax
   436 3CAE 20 BB 3C			jsr Text_Window_Frame_Row			; interior row
   437 3CB1 4C 9F 3C			jmp Text_Window_Frame_Mid
   438 3CB4			Text_Window_Frame_Bottom
   439 3CB4 AD B5 06			lda Txt_FrameStyle
   440 3CB7 18				clc
   441 3CB8 69 06			adc #$06
   442 3CBA AA				tax									; bottom edge (tail - returns to caller)
   443
   444 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   445 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   446 3CBB			Text_Window_Frame_Row
   447 3CBB BD 5E 3C			lda Text_Window_Frame_Chars,x
   448 3CBE 8D 80 06			sta Txt_Line+0
   449 3CC1 BD 5F 3C			lda Text_Window_Frame_Chars+1,x
   450 3CC4 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   451 3CC6 BD 60 3C			lda Text_Window_Frame_Chars+2,x
   452 3CC9 85 82			sta Reg3							; Reg3 = right char
   453 3CCB A2 01			ldx #$01
   454 3CCD			Text_Window_Frame_Row_L1
   455 3CCD E4 86			cpx Reg7
   456 3CCF B0 08			bcs Text_Window_Frame_Row_End
   457 3CD1 A5 83			lda Reg4
   458 3CD3 9D 80 06			sta Txt_Line,x
   459 3CD6 E8				inx
   460 3CD7 D0 F4			bne Text_Window_Frame_Row_L1
   461 3CD9			Text_Window_Frame_Row_End
   462 3CD9 A5 82			lda Reg3
   463 3CDB 9D 80 06			sta Txt_Line,x
   464 3CDE E8				inx
   465 3CDF			Text_Window_Frame_PutRow
   466 3CDF A9 00			lda #$00
   467 3CE1 9D 80 06			sta Txt_Line,x
   468 3CE4 A5 84			lda Reg5
   469 3CE6 8D B0 06			sta Txt_Row
   470 3CE9 A5 87			lda Reg8
   471 3CEB 8D B1 06			sta Txt_Col
   472 3CEE A9 80			lda #<Txt_Line
   473 3CF0 85 96			sta Txt_Ptr
   474 3CF2 A9 06			lda #>Txt_Line
   475 3CF4 85 97			sta Txt_Ptr + $01
   476 3CF6 4C F9 3C			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
