   195 21C0 10 00			dta $10,$00							; Source step y = 16
   196 21C2 01				dta $01								; Source step x (1)
   197 21C3 00 00 00			dta $00,$00,$00						; Destination address (PATCHED per kick)
   198 21C6 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320)
   199 21C8 01				dta $01								; Destination step x (1)
   200 21C9 0F 00			dta $0F,$00							; Width-1 = 15 (16 bytes wide)
   201 21CB 0F				dta $0F								; Height-1 = 15 (16 rows)
   202 21CC FF				dta $FF								; And mask (straight copy)
   203 21CD 00				dta $00								; Xor mask
   204 21CE 00				dta $00								; Collision mask
   205 21CF 00				dta $00								; Zoom
   206 21D0 00				dta $00								; Pattern feature
   207 21D1 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
