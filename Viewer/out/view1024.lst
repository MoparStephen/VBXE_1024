  1302 3811 D0 06			bne Handle_Keys_Mode
  1303 3813 20 3E 3B			jsr Toggle_Font						; (text80.asm) - a CHBASE flip, nothing is redrawn
  1304 3816 4C AB 38			jmp Read_Key_Done
  1305 3819			Handle_Keys_Mode
  1306 3819 AD C6 04			lda UI_Mode
  1307 381C D0 03			bne Handle_Keys_NotSelector
