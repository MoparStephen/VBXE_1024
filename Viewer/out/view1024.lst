   967 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
   968 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
   969 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
   970 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
   971 				;-----------------------------------------------------------------------------
   972 5394			Nfo_Name_MapSlot
   973 5394 AD E1 04			lda Nfo_Name_Ord
   974 5397 4A				lsr									; C = Ord & 1
   975 5398 A9 00			lda #$00
   976 539A 6A				ror									; A = (Ord & 1) << 7
   977 539B 85 88			sta Ptr_Lo
   978 539D AD E1 04			lda Nfo_Name_Ord
   979 53A0 4A				lsr
   980 53A1 29 0F			and #$0F							; (Ord >> 1) & 15
   981 53A3 18				clc
   982 53A4 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   983 53A6 85 89			sta Ptr_Hi
   984 53A8 AD E1 04			lda Nfo_Name_Ord
   985 53AB 4A				lsr
   986 53AC 4A				lsr
   987 53AD 4A				lsr
   988 53AE 4A				lsr
   989 53AF 4A				lsr									; Ord >> 5  (0..7)
   990 53B0 18				clc
   991 53B1 69 37			adc #NFO_NAME_BANK
   992 53B3 09 80			ora #MEMAC_GLOBAL_ENABLE
   993 53B5				vbsta VBXE_MA_BSEL
