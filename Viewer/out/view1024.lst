   643 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   644 				;  Out: C=1 on a read error / short file.
   645 				;-----------------------------------------------------------------------------
   646 3430			Image_Read_Pal
   647 3430 A9 21			lda #V1K_PAL_BANK
   648 3432 A2 00			ldx #V1K_PAL_LEN / $1000
   649 3434 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   650 3436 8C E5 04			sty Seg_Tail
   651 3439 A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   652 343B 8C E6 04			sty Seg_Tail + $01
   653 343E 4C 72 34			jmp Image_Read_Segment
