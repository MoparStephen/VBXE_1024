  1001 3648 85 85			sta Reg6							; dest ptr hi
  1002 364A A5 82			lda Reg3
  1003 364C 85 84			sta Reg5							; dest ptr lo
  1004
  1005 				; bank = MENU_BANNER_MAP_VRAM/$1000 + (total_offset >> 12)
  1006 364E A5 83			lda Reg4
  1007 3650 4A				lsr
  1008 3651 4A				lsr
  1009 3652 4A				lsr
  1010 3653 4A				lsr
  1011 3654 18				clc
  1012 3655 69 35			adc #[MENU_BANNER_MAP_VRAM/$1000]
  1013 3657 09 80			ora #MEMAC_GLOBAL_ENABLE
  1014 3659				vbsta VBXE_MA_BSEL					; clobbers Y - X (our loop counter) survives
