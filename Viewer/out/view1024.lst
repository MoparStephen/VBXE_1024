  2422 605D F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2423 605F CE CB 04			dec Slide_FrameCtr+1
  2424 6062			Slideshow_Tick_Dec
  2425 6062 CE CA 04			dec Slide_FrameCtr
  2426 6065 60				rts
  2427 6066			Slideshow_Tick_Fire
