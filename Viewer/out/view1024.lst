   591 5182 20 B0 51			jsr UI_Apply_TP_SrcBase
   592 5185 A9 00			lda #<UI_APPLY_TP_BUF
   593 5187 85 8A			sta Name_Ptr
   594 5189 A9 28			lda #>UI_APPLY_TP_BUF
