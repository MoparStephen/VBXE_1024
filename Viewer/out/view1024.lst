  2087 5B33 20 C2 33			jsr Read_Image_Palette				; .PAL block -> $21000, registers untouched
  2088 5B36 90 03			bcc Selector_Handle_P_Loaded
  2089 5B38 4C 27 52			jmp Selector_Restore_LocRow			; failed - selector stays up (tail)
  2090
  2091 5B3B			Selector_Handle_P_Loaded
  2092 5B3B 20 65 5B			jsr Pal_Preview_Build				; framebuffer + CRAM, all unseen
  2093 5B3E 20 AE 33			jsr Display_Off						; blank while the registers change
  2094 5B41 20 D5 33			jsr Apply_Image_Palette				; sets Pal_Image -> Enter_Selector restores
