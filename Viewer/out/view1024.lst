     3 2000-2014> 6A 0E			dta %01101010,%00001110				; XDLC (2 Bytes)        
     4 2002 EE				dta $EE								; XDLC_RPTL (1 byte)    No change for $EF(239) lines
     5 2003 00 10 00 40 01		dta $00,$10,$00,$40,$01				; XDLC_OVADR (5 bytes)  Start @ $001000, Step $0140, End @ $13BFF
