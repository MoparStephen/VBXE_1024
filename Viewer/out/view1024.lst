   755 35A2 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   756 35A4 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   757 35A6 20 C4 35			jsr Image_Read_Chunk
   758 35A9 B0 18			bcs Image_Read_Segment_Done
