  1742 				;-----------------------------------------------------------------------------
  1743 3A93				icl 'text80.asm'					; VBXE 80-column text screen + font + palette
Source: text80.asm
     1 				;=============================================================================
     2 				; text80.asm  -  VBXE 80-column text screen for the viewer UI
     3 				;-----------------------------------------------------------------------------
     4 				; VBXE FX *hardware text mode* (XDLC_TMON + XDLC_CHBASE + XDLC_ATT), ported from
     5 				; VBXE_APOD (ASM Samples/Mockup1 - Load_Font / the XDL text block; Mockup2's
     6 				; Load_Text_Print_Error_L1 string writer and Set_Status_Colour).
     7 				;
     8 				; The 2048-byte IBM CGA font (CGA.F08: 256 x 8x8 1bpp, code page 437 order -
     9 				; glyph index = raw ASCII byte, NO ATASCII remap) is streamed from disk into
    10 				; VRAM at TEXT_FONT_VRAM; the XDL's CHBASE points at it.  "Drawing text" = poking
    11 				; a {glyph, colour} byte pair per cell into the XDL's screen RAM
    12 				; (TEXT_SCREEN_VRAM) through the $2000 MEMAC window.  No glyph rasteriser, no
    13 				; bit-depth expansion.
    14 				;
    15 				; The colour byte: bits 0-6 select the palette entry (0-127) for the character;
    16 				; bit 7 = 0 -> transparent background, 1 -> opaque/coloured background.
    17 				;
    18 				; TEXT_FONT_VRAM / TEXT_SCREEN_VRAM / TEXT_PITCH / TEXT_CHBASE live in
    19 				; view1024.asm's .def block and are shared with XDL_MainMenu (xdl.asm) so the
    20 				; two halves cannot drift.
    21 				;
    22 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register hit goes through
    23 				; vbsta / vblda; writes to VBXE_WINDOW ($2000..$2FFF) are plain stores (real
    24 				; memory - the mapped MEMAC window).  vbsta clobbers Y in auto mode: no live Y
    25 				; is held across one below.
    26 				;
    27 				; PUBLIC API (called by ui.asm):
    28 				;   Text_Init        copy both fonts into VRAM once; blank the screen RAM.
    29 				;   Text_Activate    point VBXE_XDL_ADR0/1/2 at XDL_MainMenu.
    30 				;   Text_Deactivate  point them back at XDL_Image_Attribute (offset 0).
    31 				;   Text_Present     blit the back buffer onto the displayed screen, in vblank.
    32 				;   Text_Clear       blitter zero-fill of the 80 x TEXT_ROWS cells (blank +
    33 				;                    transparent) - ONE contiguous buffer backing both the
    34 				;                    XDL's main-content and footer text bands, see xdl.asm.
    35 				;   Text_FillColour  blitter recolour of a cell rectangle: Txt_Row/Txt_Col =
    36 				;                    top-left, Reg1 = width-1 (cells), Reg2 = height-1 (rows),
    37 				;                    A = attribute byte.  Floods the attribute bytes only.
    38 				;   Text_SetPen      A = fg palette entry (0-127), X = bg (0 transparent /
    39 				;                    non-zero opaque)  -> Make_Attr -> Txt_Attr.
    40 				;   Text_PutStrAt    draw the $00-terminated ASCII string at Txt_Ptr, from cell
    41 				;                    (Txt_Col, Txt_Row).
    42 				;
    43 				; INPUT VARIABLES (set by ui.asm before the call):
    44 				;   Txt_Row .byte  0..(TEXT_ROWS-1)    Txt_Col .byte  0..79    Txt_Ptr .word  -> string
    45 				;
    46 				; DOUBLE BUFFERED.  Every draw call below writes the BACK buffer
    47 				; (TEXT_BACK_VRAM), never the displayed one, and sets Txt_Dirty.  Nothing
    48 				; appears until Text_Present copies the whole back buffer across with one blit
    49 				; during vblank - Read_Key_Done does that after every key that drew anything,
    50 				; and the transitions (Enter_Selector, UI_Show_Busy before slow disk I/O) call
    51 				; it directly.  So a repaint, a dialog, a scroll is never seen half-built.
    52 				;=============================================================================
    53
    54 				; --- placeholder tuning knobs (Stephen finalises with Make_Attr / the XDL) ---
    55 = 000F			.def	TEXT_DEF_FG		= $0F			; default foreground (palette 0 index)
    56 = 0000			.def	TEXT_DEF_BG		= $00			; default background
    57
    58 3A93			.zpvar	Txt_Ptr			.word			; -> the string Text_PutStrAt is drawing
    59 3A93			.var	Txt_Row			.byte = $6B0
    60 3A93			.var	Txt_Col			.byte = $6B1
    61 3A93			.var	Txt_Fg			.byte = $6B2
    62 3A93			.var	Txt_Bg			.byte = $6B3
    63 3A93			.var	Txt_Attr		.byte = $6B4	; current pen, as one cell attribute byte
    64 3A93			.var	Txt_FrameStyle	.byte = $6B5	; Text_Window_Frame border: FRAME_DOUBLE / FRAME_SINGLE
    65 3A93			.var	Txt_Bank		.byte = $6B6	; VBXE bank currently mapped by the cell writer
    66 3A93			.var	Txt_Dirty		.byte = $6B7	; non-zero = back buffer changed since the last Text_Present
    67 				;	$6B8 to $6FF free
    68
    69 				;-----------------------------------------------------------------------------
    70 				; Text_Init - default pen, load the font, blank the screen.  Called once.
    71 				;-----------------------------------------------------------------------------
    72 3A93			Text_Init
    73 3A93 A9 0F			lda #TEXT_DEF_FG
    74 3A95 A2 00			ldx #TEXT_DEF_BG
    75 3A97 20 BD 3B			jsr Text_SetPen						; sets Txt_Attr
    76
    77 3A9A 20 A3 3A			jsr Text_Load_Fonts					; embedded CGA.F08 + ATARI.F08 -> VRAM bank $22
    78 3A9D 20 D7 3B			jsr Text_Clear						; blank the back buffer...
    79 3AA0 4C 7F 3B			jmp Text_Present					; ...and the displayed screen, then rts
    80
    81 				;-----------------------------------------------------------------------------
    82 				; Text_Load_Fonts - copy both embedded 2048-byte fonts into VRAM bank
    83 				; TEXT_FONT_BANK ($22) through the $2000 window: CGA.F08 -> $022000 (CHBASE
    84 				; $44), ATARI.F08 -> $022800 (CHBASE $45).  Fonts are embedded rather than
    85 				; streamed from disk so the viewer never depends on a font file being on
    86 				; whatever disk it happens to boot from.  F (Handle_Keys) flips XDL_MainMenu's
    87 				; two CHBASE bytes (main + footer text blocks) between the two.
    88 				;-----------------------------------------------------------------------------
    89 3AA3			Text_Load_Fonts
    90 3AA3 A9 A2			lda #TEXT_FONT_BANK | MEMAC_GLOBAL_ENABLE
    91 3AA5				vbsta VBXE_MA_BSEL					; map VRAM bank $22 into $2000-$2FFF
Macro: VBSTA [Source: vbxe_min.asm]
     2 3AA5 A0 5F			ldy #<VBXE_MA_BSEL
     3 3AA7 91 93			sta (VBXEBase),y
Source: text80.asm
    92
    93 3AA9 A9 8D			lda #<Text_Font_Data
    94 3AAB 85 88			sta Ptr_Lo
    95 3AAD A9 3E			lda #>Text_Font_Data
    96 3AAF 85 89			sta Ptr_Hi
    97 3AB1 A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3AB3 85 80			sta Reg1
    99 3AB5 A9 20			lda #>VBXE_WINDOW
   100 3AB7 85 81			sta Reg2
   101 3AB9 20 2B 3B			jsr Text_Copy_2K
   102
   103 3ABC A9 8D			lda #<Atari_Font_Data
   104 3ABE 85 88			sta Ptr_Lo
   105 3AC0 A9 46			lda #>Atari_Font_Data
   106 3AC2 85 89			sta Ptr_Hi
   107 3AC4 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3AC6 85 80			sta Reg1
   109 3AC8 A9 28			lda #>[VBXE_WINDOW + $800]
   110 3ACA 85 81			sta Reg2
   111 3ACC 20 2B 3B			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3ACF A2 00			ldx #$00
   120 3AD1			Text_Load_Fonts_Remap
   121 3AD1 BD 0B 3B			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3AD4 20 FB 3A			jsr Text_Glyph_Addr
   123 3AD7 85 88			sta Ptr_Lo
   124 3AD9 84 89			sty Ptr_Hi
   125 3ADB BD 0C 3B			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3ADE 20 FB 3A			jsr Text_Glyph_Addr
   127 3AE1 85 80			sta Reg1
   128 3AE3 84 81			sty Reg2
   129 3AE5 A0 07			ldy #$07
   130 3AE7			Text_Load_Fonts_Glyph
   131 3AE7 B1 88			lda (Ptr_Lo),y
   132 3AE9 91 80			sta (Reg1),y
   133 3AEB 88				dey
   134 3AEC 10 F9			bpl Text_Load_Fonts_Glyph
   135 3AEE E8				inx
   136 3AEF E8				inx
   137 3AF0 E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3AF2 D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3AF4 A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3AF6				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3AF6 A0 5F			ldy #<VBXE_MA_BSEL
     3 3AF8 91 93			sta (VBXEBase),y
Source: text80.asm
   142 3AFA 60				rts
   143
   144 				; A = glyph code -> A/Y = lo/hi of that glyph's 8 bytes in the Atari font, as
   145 				; mapped at VBXE_WINDOW + $800.  X preserved.
   146 3AFB			Text_Glyph_Addr
   147 3AFB A0 05			ldy #>[[VBXE_WINDOW + $800] / 8]	; = $05 - becomes $28 after the x8 below
   148 3AFD 84 82			sty Reg3
   149 3AFF 0A				asl
   150 3B00 26 82			rol Reg3
   151 3B02 0A				asl
   152 3B03 26 82			rol Reg3
   153 3B05 0A				asl
   154 3B06 26 82			rol Reg3							; Reg3:A = $2800 + code*8
   155 3B08 A4 82			ldy Reg3
   156 3B0A 60				rts
   157
   158 				; {source, destination} glyph pairs, applied in order.  Box lines first: $1A
   159 				; (ATASCII Ctrl-Z corner) is read here before the arrows overwrite it.
   160 				; CP437 double and single box sets both map onto the Atari single-line set.
   161 3B0B			Atari_Remap_Table
   162 3B0B 11 C9 12 CD 05 BB + 	dta $11,$C9, $12,$CD, $05,$BB, $7C,$BA, $1A,$C8, $03,$BC	; double: TL - TR | BL BR
   163 3B17 11 DA 12 C4 05 BF + 	dta $11,$DA, $12,$C4, $05,$BF, $7C,$B3, $1A,$C0, $03,$D9	; single: TL - TR | BL BR
   164 3B23 1C 18 1D 19 1E 1B + 	dta $1C,$18, $1D,$19, $1E,$1B, $1F,$1A						; arrows: up down left right
   165 3B2B			Atari_Remap_Table_End
   166
   167 				; Copy 2048 bytes (Ptr_Lo/Hi) -> (Reg1/Reg2), 8 pages.
   168 3B2B			Text_Copy_2K
   169 3B2B A2 08			ldx #$08
   170 3B2D A0 00			ldy #$00
   171 3B2F			Text_Copy_2K_L1
   172 3B2F B1 88			lda (Ptr_Lo),y
   173 3B31 91 80			sta (Reg1),y
   174 3B33 C8				iny
   175 3B34 D0 F9			bne Text_Copy_2K_L1
   176 3B36 E6 89			inc Ptr_Hi
   177 3B38 E6 81			inc Reg2
   178 3B3A CA				dex
   179 3B3B D0 F2			bne Text_Copy_2K_L1
   180 3B3D 60				rts
