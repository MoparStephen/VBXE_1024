   714 3473 A9 04			lda #CIO_read
   715 3475 9D 4A 03			sta ICAX1,x
   716 3478 A9 00			lda #$00
   717 347A 9D 4B 03			sta ICAX2,x
   718 347D A9 03			lda #CIO_open
   719 347F 9D 42 03			sta ICCOM,x
   720 3482 AD 28 31			lda FileNamePtr
   721 3485 9D 44 03			sta ICBAL,x
   722 3488 AD 29 31			lda FileNamePtr + $01
   723 348B 9D 45 03			sta ICBAH,x
