   504 				;-----------------------------------------------------------------------------
   505 				; Build_Filename
   506 				;  In:  A          = 0 -> .PAL, 1 -> .MAP, 2 -> .RAW
   507 				;       File_Index = image ordinal
   508 				;  Out: FileNamePtr -> Path_Buf holding  "D:" + base(<=8) + "." + ext + $00
   509 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
   510 				;  The base name is the space-padded 8-byte record Scan_Images stored in
   511 				;  IMAGE_BANK; copying stops at the first space.
   512 				;-----------------------------------------------------------------------------
   513 34B8			Build_Filename
   514 34B8 85 81			sta Reg2							; Reg2 = extension selector
   515
   516 				; Name_Ptr = ImageNames + File_Index * 8   (16-bit; File_Index up to 254)
   517 34BA AD 8A 04			lda File_Index
