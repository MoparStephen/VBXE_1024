  2518 				;-----------------------------------------------------------------------------
  2519 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2520 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2521 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2522 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2523 				; its 19 rows, clear first and blit only the records that exist.
  2524 				;-----------------------------------------------------------------------------
  2525 5D77			Info_Draw
  2526 5D77 A9 01			lda #$01
  2527 5D79 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2528 5D7C AD DE 04			lda Nfo_LineCount
  2529 5D7F 0D DF 04			ora Nfo_LineCount + $01
  2530 5D82 D0 03			bne Info_Draw_Some
  2531 5D84 4C 54 3B			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2532 5D87			Info_Draw_Some
  2533 5D87 20 CC 5D			jsr Info_Body_Rows
  2534 5D8A C9 13			cmp #NFO_VISROWS-1
  2535 5D8C B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2536 5D8E 20 54 3B			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2537 5D91			Info_Draw_Head
  2538 5D91 A9 00			lda #$00							; record 0 -> row 0, one row
  2539 5D93 85 80			sta Reg1
  2540 5D95 85 81			sta Reg2
  2541 5D97 85 83			sta Reg4
  2542 5D99 A9 00			lda #<TEXT_BACK_VRAM
  2543 5D9B 85 82			sta Reg3
  2544 5D9D 20 F5 5D			jsr Info_Blit
  2545 5DA0 20 CC 5D			jsr Info_Body_Rows
  2546 5DA3 F0 26			beq Info_Draw_Ret					; no body records
  2547 5DA5 85 83			sta Reg4
  2548 5DA7 C6 83			dec Reg4							; Reg4 = height-1
  2549 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2550 5DA9 A9 A0			lda #TEXT_PITCH
  2551 5DAB 85 80			sta Reg1
  2552 5DAD A9 00			lda #$00
  2553 5DAF 85 81			sta Reg2
  2554 5DB1 AE DC 04			ldx Nfo_Top
  2555 5DB4 F0 0E			beq Info_Draw_Body
  2556 5DB6			Info_Draw_MulL
  2557 5DB6 A5 80			lda Reg1
  2558 5DB8 18				clc
  2559 5DB9 69 A0			adc #TEXT_PITCH
  2560 5DBB 85 80			sta Reg1
  2561 5DBD 90 02			bcc Info_Draw_MulNC
  2562 5DBF E6 81			inc Reg2
  2563 5DC1			Info_Draw_MulNC
  2564 5DC1 CA				dex
  2565 5DC2 D0 F2			bne Info_Draw_MulL
  2566 5DC4			Info_Draw_Body
  2567 5DC4 A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2568 5DC6 85 82			sta Reg3
  2569 5DC8 4C F5 5D			jmp Info_Blit						; (tail)
  2570 5DCB			Info_Draw_Ret
  2571 5DCB 60				rts
  2572
  2573 				;-----------------------------------------------------------------------------
  2574 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2575 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2576 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2577 				;-----------------------------------------------------------------------------
  2578 5DCC			Info_Body_Rows
  2579 5DCC 38				sec
  2580 5DCD AD DE 04			lda Nfo_LineCount
  2581 5DD0 ED DC 04			sbc Nfo_Top
  2582 5DD3 85 84			sta Reg5
  2583 5DD5 AD DF 04			lda Nfo_LineCount + $01
  2584 5DD8 ED DD 04			sbc Nfo_Top + $01
  2585 5DDB 85 85			sta Reg6
  2586 5DDD A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2587 5DDF 38				sec
  2588 5DE0 E9 01			sbc #$01
  2589 5DE2 85 84			sta Reg5
  2590 5DE4 A5 85			lda Reg6
  2591 5DE6 E9 00			sbc #$00
  2592 5DE8 D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2593 5DEA A5 84			lda Reg5
  2594 5DEC C9 13			cmp #NFO_VISROWS-1
  2595 5DEE 90 02			bcc Info_Body_Rows_Ret
  2596 5DF0			Info_Body_Rows_Full
  2597 5DF0 A9 13			lda #NFO_VISROWS-1
  2598 5DF2			Info_Body_Rows_Ret
  2599 5DF2 C9 00			cmp #$00							; Z = no rows
  2600 5DF4 60				rts
  2601
