   601 				;-----------------------------------------------------------------------------
   602 				; Load_Image
   603 				; File_Index must be set before calling this!  No range checking is done!
   604 				; One OPEN of D:<name>.V1K, three sequential block reads:
   605 				;   .PAL block -> $21000, pushed to palette registers 0-3
   606 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   607 				;   .RAW block -> $01000 framebuffer
   608 				; A missing or short file stops at the failing block and closes the IOCB.
   609 				;-----------------------------------------------------------------------------
   610 340E			Load_Image
   611 340E A9 00			lda #$00							; ext 0 = .V1K
   612 3410 20 28 39			jsr Build_Filename
   613 3413 20 62 34			jsr Image_Open
   614 3416 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   615
   616 3418 20 51 34			jsr Image_Read_Pal
   617 341B B0 2A			bcs Load_Image_Close
   618 341D 20 D3 33			jsr Apply_Image_Palette
   619
   620 3420 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   621 3422 A2 02			ldx #V1K_MAP_LEN / $1000
   622 3424 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   623 3426 8C E5 04			sty Seg_Tail
   624 3429 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   625 342B 8C E6 04			sty Seg_Tail + $01
   626 342E 20 93 34			jsr Image_Read_Segment
   627 3431 B0 14			bcs Load_Image_Close
   628 3433 20 54 33			jsr Setup_Cmap1						; Expand the data out to $17000
   629
   630 3436 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   631 3438 A2 12			ldx #V1K_RAW_LEN / $1000
   632 343A A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   633 343C 8C E5 04			sty Seg_Tail
   634 343F A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   635 3441 8C E6 04			sty Seg_Tail + $01
   636 3444 20 93 34			jsr Image_Read_Segment
   637
   638 3447			Load_Image_Close
   639 3447 20 EE 34			jsr Image_Close
   640
   641 344A			Load_Image_Done
   642 344A A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   643 344C				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 344C A0 5F			ldy #<VBXE_MA_BSEL
     3 344E 91 93			sta (VBXEBase),y
Source: view1024.asm
   644
   645 3450 60				rts
