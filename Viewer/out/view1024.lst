  2044 				; to ImageNames + index*8. Sort_IndexToOffset does the 16-bit math in Reg7/Reg8.
  2045 				;-----------------------------------------------------------------------------
  2046 3D2C			Sort_SetNamePtr
  2047 3D2C 20 44 3D			jsr Sort_IndexToOffset
  2048 3D2F A5 86			lda Reg7
  2049 3D31 85 8A			sta Name_Ptr
  2050 3D33 A5 87			lda Reg8
  2051 3D35 85 8B			sta Name_Ptr + $01
  2052 3D37 60				rts
  2053
  2054 3D38			Sort_SetSortPtr
  2055 3D38 20 44 3D			jsr Sort_IndexToOffset
  2056 3D3B A5 86			lda Reg7
  2057 3D3D 85 8C			sta Sort_Ptr
  2058 3D3F A5 87			lda Reg8
  2059 3D41 85 8D			sta Sort_Ptr + $01
  2060 3D43 60				rts
  2061
  2062 3D44			Sort_IndexToOffset
  2063 3D44 85 86			sta Reg7
  2064 3D46 A9 00			lda #$00
  2065 3D48 85 87			sta Reg8
  2066 3D4A 06 86			asl Reg7
  2067 3D4C 26 87			rol Reg8
  2068 3D4E 06 86			asl Reg7
  2069 3D50 26 87			rol Reg8
  2070 3D52 06 86			asl Reg7
  2071 3D54 26 87			rol Reg8							; Reg7/Reg8 = index * 8
  2072 3D56 A5 86			lda Reg7
  2073 3D58 18				clc
  2074 3D59 69 00			adc #<ImageNames
  2075 3D5B 85 86			sta Reg7
  2076 3D5D A5 87			lda Reg8
  2077 3D5F 69 20			adc #>ImageNames
