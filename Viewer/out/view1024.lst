   200 3AD0 8E 64 20			stx XDL_MainMenu_CHBase2				; footer-block XDLC_CHBASE byte
   201 3AD3 A9 00			lda #MEMAC_GLOBAL_DISABLE
   202 3AD5				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3AD5 A0 5F			ldy #<VBXE_MA_BSEL
     3 3AD7 91 93			sta (VBXEBase),y
Source: text80.asm
