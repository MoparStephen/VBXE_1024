  1014 53CE B0 0C			bcs Nfo_Name_Emit_Term
  1015 53D0			Nfo_Name_Emit_Pad
  1016 53D0 A9 20			lda #$20
  1017 53D2			Nfo_Name_Emit_PadL
  1018 53D2 C0 4B			cpy #NFO_NAME_CAP
  1019 53D4 B0 06			bcs Nfo_Name_Emit_Term
  1020 53D6 99 50 06			sta Nfo_Name_Line,y
  1021 53D9 C8				iny
