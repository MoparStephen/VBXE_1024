  1535 				;-----------------------------------------------------------------------------
  1536 				; Key-5 attribute-map view.  XDL_Image_Attribute (VBXE $00000) has its OVADR
  1537 				; at bytes 3-5; key 5 points it at MAP_FILL_VRAM (all $01 pixels) and gives
  1538 				; entry 1 of palettes 0-3 a distinct colour, so every 8x1 cell shows which
  1539 				; palette it uses.  Leave_Map_View undoes both: OVADR back to the framebuffer
  1540 				; and entry 1 re-read from the .PAL block Load_Image left at $21000.
  1541 				;-----------------------------------------------------------------------------
  1542 3A52			Set_Attr_Source_Fill
  1543 3A52 A2 00			ldx #$00							; key 5: $01 pixels, the image's map
  1544 3A54 F0 06			beq Set_Attr_Source
  1545 3A56			Set_Attr_Source_Image
  1546 3A56 A2 06			ldx #$06							; the image
  1547 3A58 D0 02			bne Set_Attr_Source
  1548 3A5A			Set_Attr_Source_Preview
  1549 3A5A A2 0C			ldx #$0C							; the P key's palette screen
  1550 				; X = Attr_Source_Tab row (6 bytes): XDL_Image_Attribute's OVADR (bytes 3-5)
  1551 				; and MAPADR (bytes 8-10).  vbsta clobbers Y (__VBXE_AUTO__), so X only.
  1552 3A5C			Set_Attr_Source
  1553 3A5C A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE		; Bank $00 VBXE Window Enabled
  1554 3A5E				vbsta VBXE_MA_BSEL
