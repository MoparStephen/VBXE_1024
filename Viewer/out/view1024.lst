  1518 				;-----------------------------------------------------------------------------
  1519 				; Increment_Image - advance File_Index within the *.V1K file band
  1520 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1521 				; No-op when the list holds no files.  (The selector list may now also carry
  1522 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1523 				;-----------------------------------------------------------------------------
  1524 3A2A			Increment_Image
  1525 3A2A AD DA 04			lda FileStart
  1526 3A2D CD 8B 04			cmp ImageCount
  1527 3A30 B0 15			bcs Increment_Image_Done			; no *.V1K files in the list
  1528 3A32 AE 8A 04			ldx File_Index
  1529 3A35 E8				inx
  1530 3A36 EC 8B 04			cpx ImageCount
  1531 3A39 90 03			bcc Increment_Image_Store
  1532 3A3B AE DA 04			ldx FileStart						; wrap past the last file to the first
  1533 3A3E			Increment_Image_Store
  1534 3A3E 8E 8A 04			stx File_Index
  1535 3A41 20 51 35			jsr Load_Image
  1536 3A44 20 0F 3B			jsr Map_View_Reapply				; still in key-5 view? solid palettes back
  1537 3A47			Increment_Image_Done
  1538 3A47 60				rts
  1539
  1540 				;-----------------------------------------------------------------------------
  1541 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1542 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1543 				;-----------------------------------------------------------------------------
  1544 3A48			Decrement_Image
