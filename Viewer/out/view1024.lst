  1940 				; Sort_Range - in-place alphabetical selection sort of the records
  1941 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1942 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1943 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1944 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1945 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1946 				;-----------------------------------------------------------------------------
  1947 3CA5			Sort_Range
  1948 3CA5 E0 02			cpx #$02
  1949 3CA7 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1950 3CA9 85 81			sta Reg2							; Reg2 = i = start
  1951 3CAB 86 82			stx Reg3							; Reg3 = count (temp)
  1952 3CAD 18				clc
  1953 3CAE 65 82			adc Reg3
  1954 3CB0 85 84			sta Reg5							; Reg5 = end = start + count
  1955 3CB2 38				sec
  1956 3CB3 E9 01			sbc #$01
  1957 3CB5 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1958
  1959 3CB7 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1960 3CB9				vbsta VBXE_MA_BSEL
