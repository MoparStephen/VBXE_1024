  1206 37E0 AD DA 04			lda FileStart
  1207 37E3 CD 8B 04			cmp ImageCount
  1208 37E6 B0 12			bcs Increment_Image_Done			; no *.MAP files in the list
  1209 37E8 AE 8A 04			ldx File_Index
  1210 37EB E8				inx
  1211 37EC EC 8B 04			cpx ImageCount
  1212 37EF 90 03			bcc Increment_Image_Store
  1213 37F1 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1214 37F4			Increment_Image_Store
  1215 37F4 8E 8A 04			stx File_Index
  1216 37F7 20 02 34			jsr Load_Image
  1217 37FA			Increment_Image_Done
  1218 37FA 60				rts
