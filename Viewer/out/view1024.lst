   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a simple ASCII box ('+' '-' '|') with a blank
   392 				; interior over Txt_Row / Txt_Col / Reg1 (width-1) / Reg2 (height-1), using the
   393 				; current pen.  Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   394 				;-----------------------------------------------------------------------------
   395 3A99			Text_Window_Frame
   396 3A99 A5 80			lda Reg1
   397 3A9B 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   398 3A9D AD B1 06			lda Txt_Col
   399 3AA0 85 87			sta Reg8							; Reg8 = left column
   400 3AA2 AD B0 06			lda Txt_Row
   401 3AA5 18				clc
   402 3AA6 65 81			adc Reg2
   403 3AA8 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   404 3AAA AD B0 06			lda Txt_Row
   405 3AAD 85 84			sta Reg5							; Reg5 = current screen row
   406 3AAF 20 C3 3A			jsr Text_Window_Frame_EdgeRow		; top edge
   407 3AB2			Text_Window_Frame_Mid
   408 3AB2 E6 84			inc Reg5
   409 3AB4 A5 84			lda Reg5
   410 3AB6 C5 85			cmp Reg6
   411 3AB8 B0 06			bcs Text_Window_Frame_Bottom
   412 3ABA 20 DF 3A			jsr Text_Window_Frame_MidRow
   413 3ABD 4C B2 3A			jmp Text_Window_Frame_Mid
   414 3AC0			Text_Window_Frame_Bottom
   415 3AC0 4C C3 3A			jmp Text_Window_Frame_EdgeRow		; bottom edge (tail - returns to caller)
   416
   417 3AC3			Text_Window_Frame_EdgeRow
   418 3AC3 A9 2B			lda #'+'
   419 3AC5 8D 80 06			sta Txt_Line+0
   420 3AC8 A2 01			ldx #$01
   421 3ACA			Text_Window_Frame_EdgeL
   422 3ACA E4 86			cpx Reg7
   423 3ACC B0 08			bcs Text_Window_Frame_EdgeEnd
   424 3ACE A9 2D			lda #'-'
   425 3AD0 9D 80 06			sta Txt_Line,x
   426 3AD3 E8				inx
   427 3AD4 D0 F4			bne Text_Window_Frame_EdgeL
   428 3AD6			Text_Window_Frame_EdgeEnd
   429 3AD6 A9 2B			lda #'+'
   430 3AD8 9D 80 06			sta Txt_Line,x
   431 3ADB E8				inx
   432 3ADC 4C F8 3A			jmp Text_Window_Frame_PutRow
   433
   434 3ADF			Text_Window_Frame_MidRow
   435 3ADF A9 7C			lda #'|'
   436 3AE1 8D 80 06			sta Txt_Line+0
   437 3AE4 A2 01			ldx #$01
   438 3AE6			Text_Window_Frame_MidL
   439 3AE6 E4 86			cpx Reg7
   440 3AE8 B0 08			bcs Text_Window_Frame_MidEnd
   441 3AEA A9 20			lda #' '
   442 3AEC 9D 80 06			sta Txt_Line,x
   443 3AEF E8				inx
   444 3AF0 D0 F4			bne Text_Window_Frame_MidL
   445 3AF2			Text_Window_Frame_MidEnd
   446 3AF2 A9 7C			lda #'|'
   447 3AF4 9D 80 06			sta Txt_Line,x
   448 3AF7 E8				inx
   449 3AF8			Text_Window_Frame_PutRow
   450 3AF8 A9 00			lda #$00
   451 3AFA 9D 80 06			sta Txt_Line,x
   452 3AFD A5 84			lda Reg5
   453 3AFF 8D B0 06			sta Txt_Row
   454 3B02 A5 87			lda Reg8
   455 3B04 8D B1 06			sta Txt_Col
   456 3B07 A9 80			lda #<Txt_Line
   457 3B09 85 96			sta Txt_Ptr
   458 3B0B A9 06			lda #>Txt_Line
   459 3B0D 85 97			sta Txt_Ptr + $01
