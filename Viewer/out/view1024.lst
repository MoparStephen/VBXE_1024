Source: ui.asm
     1 				;=============================================================================
     2 				; ui.asm  -  viewer UI: file selector, slideshow, runtime directory scan
     3 				;-----------------------------------------------------------------------------
     4 				; This is the main segment (icl'd from view1024.asm at $3300+).  Everything
     5 				; here is entered only at runtime - from start: and from the key handlers -
     6 				; so NONE of it is reachable from an ini step (unlike the old Scan_Images).
     7 				;
     8 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register access here
     9 				; goes through vbsta / vblda, never a bare lda / sta VBXE_* (a bare access
    10 				; silently collapses to a zero-page hit - the $53 / VBXE_BLITTER_BUSY hang).
    11 				; vbsta/vblda clobber Y in auto mode: no live Y is held across one below.
    12 				;
    13 				; Screen model (text80.asm): 80 columns x TEXT_ROWS(23) rows, Palette 0 - the
    14 				; menu/info XDL (xdl.asm) displays this ONE buffer as two on-screen bands (a
    15 				; graphics banner sits above it, a 1-line separator between the bands, see
    16 				; xdl.asm for the full 240-scanline layout).  Selector row map:
    17 				;   row 0            Location: <path>  ...  image counter (cols 68-77,
    18 				;                    "nnn of NNN" / "NNN images" - Selector_DrawCount);
    19 				;                    "Scanning directory..." in the path's place while
    20 				;                    Rescan_Images runs
    21 				;   row 1            blank
    22 				;   rows 2-16 (15)   scrolling grid (UI_FIRSTROW/UI_VISROWS below)
    23 				;   rows 17-19       spare/margin (blank)
    24 				;   row 20 (TEXT_MAIN_ROWS+0)   status line (Nfo: ...)
    25 				;   row 21 (TEXT_MAIN_ROWS+1)   slideshow delay
    26 				;   row 22 (TEXT_MAIN_ROWS+2)   key legend
    27 				; The info viewer uses rows 0..TEXT_MAIN_ROWS-1 for scrollable content and
    28 				; row TEXT_MAIN_ROWS for a single fixed hint line - see NFO_VISROWS below.
    29 				;
    30 				; UI_Mode:  0 = selector   1 = image view   2 = slideshow
    31 				;           3 = drive picker (D-key save-under overlay)   4 = info viewer (.nfo)
    32 				;           5 = quit-confirm (Q-key save-under overlay, selector only)
    33 				;           6 = P-preview (P-key 4-palette ramp-square screen, Esc only)
    34 				;=============================================================================
    35
    36 = 0008			.def	UI_COLS			= 8				; grid columns (items/row) - a power of 2
    37 														; keeps row=index>>3 / col=index&7 cheap
    38 = 000F			.def	UI_VISROWS		= 15			; grid rows visible at once
    39 = 0002			.def	UI_FIRSTROW		= 2				; first screen row of the grid
    40 = 0000			.def	UI_GRIDCOL0		= 0				; first screen column of the grid (Sel_ColX base)
    41 = 0044			.def	UI_COUNT_COL	= 68			; row 0 image counter, 10 chars (cols 68-77,
    42 														; mirroring Location:'s 2-col left margin)
    43 				; UI_FIRSTROW / UI_GRIDCOL0 are the only placement knobs - see the row map
    44 				; above for the rest of the selector's chrome (status/delay/legend rows).
    45 = 0001			.def	UI_SLIDE_MIN	= 1
    46 = 001E			.def	UI_SLIDE_MAX	= 30
    47 				; VBXE text-mode colour byte: bits 0-6 = foreground palette-0 entry (0-127),
    48 				; bit 7 = 1 -> opaque background (hardware-forced to palette[fg+128]), 0 ->
    49 				; transparent.  UI_Apply_TextPalette de-interleaves the Atari master into set 0
    50 				; so entry e = master colour 2e: hue = e>>3 (all 16 hues), luma = (e&7)*2.
    51 				; The cursor row is marked by FOREGROUND colour only - no opaque bar - because
    52 				; after the de-interleave palette[e+128] is the adjacent-luma neighbour of
    53 				; palette[e] and gives no contrast.  Tune the three indices once on screen.
    54 = 0007			.def	UI_PEN_FG		= $07			; normal text   : hue 0 grey,  luma 14
    55 = 000F			.def	UI_PEN_HI		= $0F			; highlighted   : hue 1 gold,  luma 14
    56 = 0062			.def	UI_PEN_DIR		= $62			; directory/".." : hue $C green, luma 4
    57
    58 = 0000			.def	NFO_TOPROW		= 0				; info viewer: first screen row of the scroll region
    59 = 0014			.def	NFO_VISROWS		= TEXT_MAIN_ROWS	; info viewer: visible text rows (main band only)
    60 				; The logo band is real now (the menu XDL's graphics group, see xdl.asm) - it
    61 				; lives in its own VRAM, not stolen text rows, so NFO_TOPROW stays 0.
    62 				; NFO_VISROWS must equal TEXT_MAIN_ROWS (not the full TEXT_ROWS buffer): the
    63 				; blit overwrites every row it touches, and rows TEXT_MAIN_ROWS..TEXT_ROWS-1
    64 				; hold the separate static footer hint line - the NFO blit must not touch it.
    65 = 007F			.def	NFO_MAX_LINES	= 127			; cap on displayed .NFO records; NFO_BUF_VRAM (5 banks)
    66 													; holds 128 * 160, the 128th slot being the $00 sentinel
    67
    68 				; --- CH key codes (POKEY, no modifier).  Matches the bare-CH style in
    69 				;     Handle_Keys (Q $2F, Space $21, BkSp $34, Esc $1C, digits ...).
    70 				;     The 4 arrows are also accepted with CTRL held ($8E/$8F/$86/$87): each
    71 				;     handler ANDs CH with KEY_CTRL_OFF before the arrow compares, then
    72 				;     reloads the raw CH for everything else.
    73 = 007F			.def	KEY_CTRL_OFF	= $7F			; CH AND mask - clears the CTRL bit ($80)
    74 = 000E			.def	KEY_UP			= $0E			; "-" key (up-arrow;    Ctrl = $8E)
    75 = 000F			.def	KEY_DOWN		= $0F			; "=" key (down-arrow;  Ctrl = $8F)
    76 = 0006			.def	KEY_LEFT		= $06			; "+" key (left-arrow;  Ctrl = $86)
    77 = 0007			.def	KEY_RIGHT		= $07			; "*" key (right-arrow; Ctrl = $87)
    78 = 000C			.def	KEY_RETURN		= $0C
    79 = 001C			.def	KEY_ESC			= $1C
    80 = 0021			.def	KEY_SPACE		= $21
    81 = 002F			.def	KEY_Q			= $2F
    82 = 003E			.def	KEY_S			= $3E
    83 = 003A			.def	KEY_D			= $3A
    84 = 0038			.def	KEY_F			= $38			; toggle text font (CGA <-> Atari)
    85 = 000A			.def	KEY_P			= $0A
    86 = 000D			.def	KEY_I			= $0D
    87 = 0020			.def	KEY_COMMA		= $20			; "," - shorter slideshow delay
    88 = 0022			.def	KEY_DOT			= $22			; "." - longer slideshow delay
    89 = 002B			.def	KEY_Y			= $2B			; quit-confirm: yes (verified via Altirra CH readback)
    90 = 0023			.def	KEY_N			= $23			; quit-confirm: no  (verified via Altirra CH readback)
    91
    92 				;-----------------------------------------------------------------------------
    93 				; TXT_AT row, col, strlabel  -  draw a string via the text API
    94 				;-----------------------------------------------------------------------------
    95 				.macro TXT_AT
    96 					lda #[:1]
    97 					sta Txt_Row
    98 					lda #[:2]
    99 					sta Txt_Col
   100 					lda #<[:3]
   101 					sta Txt_Ptr
   102 					lda #>[:3]
   103 					sta Txt_Ptr + $01
   104 					jsr Text_PutStrAt
   105 				.endm
