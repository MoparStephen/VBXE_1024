   920 5049			Nfo_Name_Emit_Copy
   921 5049 B1 88			lda (Ptr_Lo),y
   922 504B F0 0A			beq Nfo_Name_Emit_Pad
   923 504D 99 8D 04			sta Path_Buf,y
   924 5050 C8				iny
   925 5051 C0 30			cpy #NFO_NAME_CAP
   926 5053 90 F4			bcc Nfo_Name_Emit_Copy
   927 5055 B0 0C			bcs Nfo_Name_Emit_Term
   928 5057			Nfo_Name_Emit_Pad
   929 5057 A9 20			lda #$20
   930 5059			Nfo_Name_Emit_PadL
   931 5059 C0 30			cpy #NFO_NAME_CAP
   932 505B B0 06			bcs Nfo_Name_Emit_Term
   933 505D 99 8D 04			sta Path_Buf,y
   934 5060 C8				iny
   935 5061 D0 F6			bne Nfo_Name_Emit_PadL				; always (Y < NFO_NAME_CAP)
   936 5063			Nfo_Name_Emit_Term
   937 5063 A9 00			lda #$00
   938 5065 8D BD 04			sta Path_Buf + NFO_NAME_CAP
   939 5068 A9 00			lda #MEMAC_GLOBAL_DISABLE
   940 506A				vbsta VBXE_MA_BSEL
