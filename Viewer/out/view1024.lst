  1627 3A04 B1 8C			lda (Sort_Ptr),y
  1628 3A06 91 8A			sta (Name_Ptr),y
  1629 3A08 B9 8D 04			lda Path_Buf,y
  1630 3A0B 91 8C			sta (Sort_Ptr),y
  1631 3A0D C8				iny
  1632 3A0E C0 08			cpy #$08
  1633 3A10 90 ED			bcc Swap_Records_L1
  1634 3A12 60				rts
