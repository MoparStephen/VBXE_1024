   485 				;-----------------------------------------------------------------------------
   486 				; Enter_Selector - restore Palette 0 for text, refresh the menu banner's
   487 				; palette registers 1-3 (Load_Image overwrites them for every real image
   488 				; viewed in between - a cheap resident-VRAM-to-register copy, no disk access;
   489 				; see Apply_Menu_Banner_Palette in view1024.asm), show the text screen, draw
   490 				; it.  Reached from start: (jsr), Handle_Escape (jsr), Slide_Key_Stop (jsr)
   491 				; and Info_Key_Leave (jsr) - always returns.
   492 				;-----------------------------------------------------------------------------
   493 4FF6			Enter_Selector
   494 4FF6 20 15 32			jsr Restore_Palette0				; standard PAL/NTSC master palette -> set 0
   495 4FF9 20 0B 50			jsr UI_Apply_TextPalette			; ...then de-interleave it for text mode
   496 4FFC 20 35 35			jsr Apply_Menu_Banner_Palette		; refresh the banner's palette registers 1-3
   497 4FFF 20 E1 3A			jsr Text_Activate					; point the XDL at the menu/info screen
   498 5002 A9 00			lda #$00
   499 5004 8D C6 04			sta UI_Mode
   500 5007 20 8A 50			jsr Selector_Draw
   501 500A 60				rts
   502
   503 				;-----------------------------------------------------------------------------
   504 				; UI_Apply_TextPalette - Restore_Palette0 has just put the standard Atari 256-
   505 				; colour master into palette set 0.  The VBXE text mode can only reach entries
   506 				; 0-127 as a foreground, and in the master that range is hues 0-7 (no green).
   507 				; De-interleave it so:
   508 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   509 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   510 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   511 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000) and re-upload it
   512 				; as set 0.  Runs only on entry to the selector - not per frame.
   513 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   514 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr, Y_Register.
   515 				;-----------------------------------------------------------------------------
   516 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   517
   518 500B			UI_Apply_TextPalette
   519 500B A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   520 500D				vbsta VBXE_MA_BSEL
