   956 3607 85 81			sta Reg2
   957 3609 A9 F1			lda #<Menu_Demo_Attr_Top_Vals
   958 360B 85 88			sta Ptr_Lo
   959 360D A9 35			lda #>Menu_Demo_Attr_Top_Vals
   960 360F 85 89			sta Ptr_Hi
