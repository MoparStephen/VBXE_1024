   764 35B4 0D E6 04			ora Seg_Tail + $01
   765 35B7 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   766 35B9 AD E5 04			lda Seg_Tail
   767 35BC AC E6 04			ldy Seg_Tail + $01
   768 35BF 4C C4 35			jmp Image_Read_Chunk
   769
   770 35C2			Image_Read_Segment_OK
   771 35C2 18				clc
   772 35C3			Image_Read_Segment_Done
   773 35C3 60				rts
