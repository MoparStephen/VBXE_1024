   653 				;-----------------------------------------------------------------------------
   654 				; Load_Image
   655 				; File_Index must be set before calling this!  No range checking is done!
   656 				; One OPEN of D:<name>.V1K, three sequential block reads:
   657 				;   .PAL block -> $21000, pushed to palette registers 0-3
   658 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   659 				;   .RAW block -> $01000 framebuffer
   660 				; A missing or short file stops at the failing block and closes the IOCB.
   661 				;-----------------------------------------------------------------------------
   662 3512			Load_Image
   663 3512 A9 00			lda #$00							; ext 0 = .V1K
   664 3514 20 B1 39			jsr Build_Filename
   665 3517 20 66 35			jsr Image_Open
   666 351A B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   667
   668 351C 20 55 35			jsr Image_Read_Pal
   669 351F B0 2A			bcs Load_Image_Close
   670 3521 20 D2 34			jsr Apply_Image_Palette
   671
   672 3524 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   673 3526 A2 02			ldx #V1K_MAP_LEN / $1000
   674 3528 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   675 352A 8C E5 04			sty Seg_Tail
   676 352D A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   677 352F 8C E6 04			sty Seg_Tail + $01
   678 3532 20 97 35			jsr Image_Read_Segment
   679 3535 B0 14			bcs Load_Image_Close
   680 3537 20 57 34			jsr Setup_Cmap1						; Expand the data out to $17000
   681
   682 353A A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   683 353C A2 12			ldx #V1K_RAW_LEN / $1000
   684 353E A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   685 3540 8C E5 04			sty Seg_Tail
   686 3543 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   687 3545 8C E6 04			sty Seg_Tail + $01
   688 3548 20 97 35			jsr Image_Read_Segment
   689
   690 354B			Load_Image_Close
   691 354B 20 F2 35			jsr Image_Close
   692
   693 354E			Load_Image_Done
   694 354E A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   695 3550				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3550 A0 5F			ldy #<VBXE_MA_BSEL
     3 3552 91 93			sta (VBXEBase),y
Source: view1024.asm
