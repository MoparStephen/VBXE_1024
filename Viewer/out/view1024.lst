   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3C8E			Text_Window_Save
   393 3C8E 20 E1 3C			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3C91 A5 83			lda Reg4
   395 3C93 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3C96 A5 84			lda Reg5
   397 3C98 18				clc
   398 3C99 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3C9B 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3C9E A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3CA0 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3CA3 A9 00			lda #<WIN_SAVE_VRAM
   403 3CA5 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3CA8 A9 F0			lda #>WIN_SAVE_VRAM
   405 3CAA 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3CAD A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3CAF 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3CB2 4C 21 3D			jmp Text_Window_Kick
   409
   410 3CB5			Text_Window_Restore
   411 3CB5 A9 01			lda #$01
   412 3CB7 8D B7 06			sta Txt_Dirty
   413 3CBA 20 E1 3C			jsr Text_Window_Setup
   414 3CBD A9 00			lda #<WIN_SAVE_VRAM
   415 3CBF 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3CC2 A9 F0			lda #>WIN_SAVE_VRAM
   417 3CC4 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3CC7 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3CC9 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3CCC A5 83			lda Reg4
   421 3CCE 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3CD1 A5 84			lda Reg5
   423 3CD3 18				clc
   424 3CD4 69 A0			adc #>TEXT_BACK_VRAM
   425 3CD6 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3CD9 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3CDB 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3CDE 4C 21 3D			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3CE1			Text_Window_Setup
   433 3CE1 A9 00			lda #$00
   434 3CE3 85 83			sta Reg4
   435 3CE5 85 84			sta Reg5
   436 3CE7 AE B0 06			ldx Txt_Row
   437 3CEA F0 0E			beq Text_Window_Setup_Col
   438 3CEC			Text_Window_Setup_RowL
   439 3CEC A5 83			lda Reg4
   440 3CEE 18				clc
   441 3CEF 69 A0			adc #TEXT_PITCH
   442 3CF1 85 83			sta Reg4
   443 3CF3 90 02			bcc Text_Window_Setup_RowNC
   444 3CF5 E6 84			inc Reg5
   445 3CF7			Text_Window_Setup_RowNC
   446 3CF7 CA				dex
   447 3CF8 D0 F2			bne Text_Window_Setup_RowL
   448 3CFA			Text_Window_Setup_Col
   449 3CFA AD B1 06			lda Txt_Col
   450 3CFD 0A				asl
   451 3CFE 18				clc
   452 3CFF 65 83			adc Reg4
   453 3D01 85 83			sta Reg4
   454 3D03 90 02			bcc Text_Window_Setup_ColNC
   455 3D05 E6 84			inc Reg5
   456 3D07			Text_Window_Setup_ColNC
   457 3D07 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3D09				vbsta VBXE_MA_BSEL
