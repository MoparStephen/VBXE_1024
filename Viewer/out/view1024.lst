  2031 				;-----------------------------------------------------------------------------
  2032 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2033 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2034 				; the whole .NFO is shorter than the window, clear first and blit only the
  2035 				; records that exist.
  2036 				;-----------------------------------------------------------------------------
  2037 593E			Info_Draw
  2038 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2039 593E 38				sec
  2040 593F AD DE 04			lda Nfo_LineCount
  2041 5942 ED DC 04			sbc Nfo_Top
  2042 5945 85 84			sta Reg5
  2043 5947 AD DF 04			lda Nfo_LineCount + $01
  2044 594A ED DD 04			sbc Nfo_Top + $01
  2045 594D 85 85			sta Reg6
  2046 				; rows = min(available, NFO_VISROWS)
  2047 594F A5 85			lda Reg6
  2048 5951 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2049 5953 A5 84			lda Reg5
  2050 5955 C9 14			cmp #NFO_VISROWS
  2051 5957 B0 10			bcs Info_Draw_Full
  2052 				; short document: clear, then blit only the records that exist
  2053 5959 A5 84			lda Reg5
  2054 595B 85 83			sta Reg4
  2055 595D 20 4B 3A			jsr Text_Clear
  2056 5960 A5 83			lda Reg4
  2057 5962 F0 68			beq Info_Draw_Ret					; nothing to draw
  2058 5964 C6 83			dec Reg4							; Reg4 = height-1
  2059 5966 4C 6D 59			jmp Info_Draw_Blit
  2060 5969			Info_Draw_Full
  2061 5969 A9 13			lda #NFO_VISROWS-1
  2062 596B 85 83			sta Reg4
  2063 596D			Info_Draw_Blit
  2064 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2065 596D A9 00			lda #$00
  2066 596F 85 80			sta Reg1
  2067 5971 85 81			sta Reg2
  2068 5973 AE DC 04			ldx Nfo_Top
  2069 5976 F0 0E			beq Info_Draw_Patch
  2070 5978			Info_Draw_MulL
  2071 5978 A5 80			lda Reg1
  2072 597A 18				clc
  2073 597B 69 A0			adc #TEXT_PITCH
  2074 597D 85 80			sta Reg1
  2075 597F 90 02			bcc Info_Draw_MulNC
  2076 5981 E6 81			inc Reg2
  2077 5983			Info_Draw_MulNC
  2078 5983 CA				dex
  2079 5984 D0 F2			bne Info_Draw_MulL
  2080 5986			Info_Draw_Patch
  2081 5986 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2082 5988				vbsta VBXE_MA_BSEL
