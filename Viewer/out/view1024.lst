   699 				;-----------------------------------------------------------------------------
   700 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   701 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   702 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   703 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   704 				;-----------------------------------------------------------------------------
   705 3493			Image_Read_Segment
   706 3493 8D E3 04			sta Seg_Bank
   707 3496 8E E4 04			stx Seg_Chunks
   708 3499			Image_Read_Segment_L1
   709 3499 AD E4 04			lda Seg_Chunks
   710 349C F0 0F			beq Image_Read_Segment_Tail
   711 349E A9 00			lda #<VBXE_WINDOW_SIZE_4k
   712 34A0 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   713 34A2 20 C0 34			jsr Image_Read_Chunk
   714 34A5 B0 18			bcs Image_Read_Segment_Done
   715 34A7 CE E4 04			dec Seg_Chunks
   716 34AA 4C 99 34			jmp Image_Read_Segment_L1
   717
   718 34AD			Image_Read_Segment_Tail
   719 34AD AD E5 04			lda Seg_Tail
   720 34B0 0D E6 04			ora Seg_Tail + $01
   721 34B3 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   722 34B5 AD E5 04			lda Seg_Tail
   723 34B8 AC E6 04			ldy Seg_Tail + $01
   724 34BB 4C C0 34			jmp Image_Read_Chunk
   725
   726 34BE			Image_Read_Segment_OK
   727 34BE 18				clc
   728 34BF			Image_Read_Segment_Done
   729 34BF 60				rts
   730
   731 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   732 				; C=1 on a CIO error.
   733 34C0			Image_Read_Chunk
   734 34C0 AE E2 04			ldx Load_IOCB
   735 34C3 9D 48 03			sta ICBLL,x
   736 34C6 98				tya
   737 34C7 9D 49 03			sta ICBLH,x							; length stored before vbsta clobbers Y
   738 34CA AD E3 04			lda Seg_Bank
   739 34CD 09 80			ora #MEMAC_GLOBAL_ENABLE
   740 34CF				vbsta VBXE_MA_BSEL
