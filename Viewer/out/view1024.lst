   202 21CD 00				dta $00								; Xor mask (fill value: $00)
   203 21CE 00				dta $00								; Collision and mask
   204 21CF 00				dta $00								; Zoom
   205 21D0 00				dta $00								; Pattern feature
   206 21D1 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
