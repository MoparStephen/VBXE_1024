   595 				;-----------------------------------------------------------------------------
   596 				; Read_Image_Palette - read just the .PAL block (the first one) of File_Index's
   597 				; .V1K into $21000.  Does NOT touch the palette registers - the caller applies
   598 				; it (Apply_Image_Palette) once the screen it belongs to is ready.  File_Index
   599 				; must be set before calling.  Used by Selector_Handle_P (P-preview, ui.asm).
   600 				;  Out: C=1 if the file is missing or short.
   601 				;-----------------------------------------------------------------------------
   602 34BF			Read_Image_Palette
   603 34BF A9 00			lda #$00							; ext 0 = .V1K
   604 34C1 20 B1 39			jsr Build_Filename
   605 34C4 20 66 35			jsr Image_Open
   606 34C7 B0 08			bcs Read_Image_Palette_Done			; OPEN failed (C=1)
   607 34C9 20 55 35			jsr Image_Read_Pal
   608 34CC 08				php
   609 34CD 20 F2 35			jsr Image_Close
   610 34D0 28				plp									; C from the read
   611 34D1			Read_Image_Palette_Done
   612 34D1 60				rts
   613
