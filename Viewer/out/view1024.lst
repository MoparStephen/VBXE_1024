  1582 39E0 20 4A 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1583 39E3 20 1A 3A			jsr Cmp_Records						; rec(m) : rec(j)
  1584 39E6 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1585 39E8 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1586 39EA A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1587 39EC 85 83			sta Reg4
  1588 39EE A5 8C			lda Sort_Ptr
  1589 39F0 85 8A			sta Name_Ptr
  1590 39F2 A5 8D			lda Sort_Ptr + $01
  1591 39F4 85 8B			sta Name_Ptr + $01
  1592 39F6			Sort_Range_Inner_Next
  1593 39F6 E6 82			inc Reg3
  1594 39F8 4C D8 39			jmp Sort_Range_Inner
  1595 39FB			Sort_Range_Inner_Done
  1596 39FB A5 83			lda Reg4
  1597 39FD C5 81			cmp Reg2
  1598 39FF F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1599 3A01 A5 81			lda Reg2
