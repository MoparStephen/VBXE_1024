  2386 				;-----------------------------------------------------------------------------
  2387 				; Slideshow_Tick - called from main every frame.  Counts Slide_FrameCtr down
  2388 				; and advances to the next image at zero.  No-op unless UI_Mode = 2.
  2389 				;-----------------------------------------------------------------------------
  2390 5D59			Slideshow_Tick
  2391 5D59 AD C6 04			lda UI_Mode
  2392 5D5C C9 02			cmp #$02
  2393 5D5E F0 01			beq Slideshow_Tick_Run
  2394 5D60 60				rts
  2395 5D61			Slideshow_Tick_Run
  2396 5D61 AD CA 04			lda Slide_FrameCtr
  2397 5D64 D0 08			bne Slideshow_Tick_Dec
  2398 5D66 AD CB 04			lda Slide_FrameCtr+1
  2399 5D69 F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2400 5D6B CE CB 04			dec Slide_FrameCtr+1
  2401 5D6E			Slideshow_Tick_Dec
  2402 5D6E CE CA 04			dec Slide_FrameCtr
  2403 5D71 60				rts
  2404 5D72			Slideshow_Tick_Fire
  2405 5D72 20 7D 33			jsr Clear_Screen
  2406 5D75 20 F0 38			jsr Increment_Image
  2407 5D78 20 7C 5D			jsr Slideshow_Reload_Counter
  2408 5D7B 60				rts
