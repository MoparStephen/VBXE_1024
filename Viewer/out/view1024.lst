   904 				;-----------------------------------------------------------------------------
   905 				; Build_Filename
   906 				;  In:  A          = 0 -> .PAL, 1 -> .MAP, 2 -> .RAW, 3 -> .NFO
   907 				;       File_Index = image ordinal
   908 				;  Out: FileNamePtr -> Path_Buf holding
   909 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
   910 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
