   119 				;-----------------------------------------------------------------------------
   120 				; TXT_AT row, col, strlabel  -  draw a string via the text API
   121 				;-----------------------------------------------------------------------------
   122 				.macro TXT_AT
   123 					lda #[:1]
   124 					sta Txt_Row
   125 					lda #[:2]
   126 					sta Txt_Col
   127 					lda #<[:3]
   128 					sta Txt_Ptr
   129 					lda #>[:3]
   130 					sta Txt_Ptr + $01
   131 					jsr Text_PutStrAt
   132 				.endm
   133
   134 				;-----------------------------------------------------------------------------
   135 				; DTA_SCR code  -  emit one Atari internal screen code (e.g. V_0..V_3, which
   136 				; the loader screen uses) as the ASCII byte the text mode's CP437 font wants.
   137 				;-----------------------------------------------------------------------------
   138 				.macro DTA_SCR
   139 					.if [:1] < $40
   140 					dta [:1]+$20						; $00-$3F: space, punctuation, digits, A-Z
   141 					.elseif [:1] < $60
   142 					dta [:1]-$40						; $40-$5F: control-glyph block
   143 					.else
   144 					dta [:1]							; $60-$7F: a-z - already ASCII
   145 					.endif
   146 				.endm
   147
   148 				;=============================================================================
   149 				; Directory scan  (moved here from init_vbxe.asm's Scan_Images - the scan
   150 				; location is now chosen at runtime, so it can't be decided in the loader)
   151 				;=============================================================================
   152
   153 				;-----------------------------------------------------------------------------
   154 				; Rescan_Images - scan Scan_Drive/Scan_Path for *.V1K, rebuild + sort the list.
   155 				; Tolerates zero matches (an ordinary state the selector shows).
   156 				;-----------------------------------------------------------------------------
   157 4EA1			Rescan_Images
   158 				; Show "Scanning directory..." where the path goes - the scan + IMAGES.LST
   159 				; name cache can take a while in a big folder.  Every caller repaints the
   160 				; whole selector (Selector_Draw) afterwards.
   161 4EA1 A9 1E			lda #<UI_Str_Scanning
   162 4EA3 A0 68			ldy #>UI_Str_Scanning
   163 4EA5 20 41 52			jsr UI_Show_Busy
   164
   165 4EA8 20 4B 4F			jsr Build_Image_List				; fills IMAGE_BANK; sets ImageCount/Dir_Count/FileStart
   166
   167 				; sort the two real groups independently: dirs [FileStart-Dir_Count .. FileStart)
   168 				; then files [FileStart .. ImageCount).  ".." (if present) stays pinned at 0.
   169 4EAB AD DA 04			lda FileStart
   170 4EAE 38				sec
   171 4EAF ED D9 04			sbc Dir_Count
   172 4EB2 AE D9 04			ldx Dir_Count
   173 4EB5 20 DF 39			jsr Sort_Range						; directories A-Z
   174 4EB8 AD 8B 04			lda ImageCount
   175 4EBB 38				sec
   176 4EBC ED DA 04			sbc FileStart
   177 4EBF AA				tax									; X = file count
   178 4EC0 AD DA 04			lda FileStart
   179 4EC3 20 DF 39			jsr Sort_Range						; *.V1K files A-Z
   180
   181 4EC6 20 AF 53			jsr Nfo_Name_ClearCache				; drop the status-line name slots - list changed
   182 4EC9 20 03 55			jsr Nfo_Name_LoadManifest			; refill them from this folder's IMAGES.LST (if any)
   183
   184 4ECC A9 00			lda #$00
   185 4ECE 8D C7 04			sta Sel_Index
   186 4ED1 8D C8 04			sta Sel_Top
   187 4ED4 8D 8A 04			sta File_Index
   188 4ED7 60				rts
   189
   190 				;-----------------------------------------------------------------------------
