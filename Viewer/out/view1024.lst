   531 				;-----------------------------------------------------------------------------
   532 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner (pixel data,
   533 				; palette, attribute map) into dedicated, resident VRAM - never touched by
   534 				; Load_Image, and never reloaded from disk again after this one call, since
   535 				; the banner never changes at runtime.  Blank-fills any banner target whose
   536 				; file is missing/fails so cold-boot VRAM garbage is never shown.  The
   537 				; separator has no asset file at all - it is always a fixed-colour blitter
   538 				; fill (Menu_Sep_Blank).  Called once from start:, before the first
   539 				; Enter_Selector.
   540 				;-----------------------------------------------------------------------------
   541 341A			Load_Menu_Banner_Raw
   542 341A A9 2E			lda #<Menu_Banner_Raw_Name
   543 341C 8D 28 31			sta FileNamePtr
   544 341F A9 35			lda #>Menu_Banner_Raw_Name
   545 3421 8D 29 31			sta FileNamePtr + $01
   546 3424 A9 30			lda #MENU_BANNER_BANK
   547 3426 85 8E			sta BankIndex
   548 3428 20 AA 30			jsr LoadData
   549 342B AD 2D 31			lda LoadStatus
   550 342E D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   551 3430 20 9D 34			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   552
   553 3433			Load_Menu_Banner_Raw_Sep
   554 3433 20 C6 34			jsr Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   555
   556 3436			Load_Menu_Banner_Raw_Pal
   557 				; Load the banner's .PAL DIRECTLY into its own resident bank (not the $21000
   558 				; scratch Load_Image uses) - same 4-slot layout Load_Image's .PAL files use
   559 				; ($0000/$0300/$0600/$0900); the $0000 slot is unused (palette register 0 is
   560 				; reserved for text, see Apply_Menu_Banner_Palette).
   561 3436 A9 18			lda #<Menu_Banner_Pal_Name
   562 3438 8D 28 31			sta FileNamePtr
   563 343B A9 35			lda #>Menu_Banner_Pal_Name
   564 343D 8D 29 31			sta FileNamePtr + $01
   565 3440 A9 34			lda #MENU_BANNER_PAL_VRAM / $1000
   566 3442 85 8E			sta BankIndex
   567 3444 20 AA 30			jsr LoadData
   568 3447 AD 2D 31			lda LoadStatus
   569 344A D0 03			bne Load_Menu_Banner_Raw_Map
   570 344C 20 EF 34			jsr Menu_Pal_Blank					; OPEN/load failed - blank to solid black
   571
   572 344F			Load_Menu_Banner_Raw_Map
   573 				; Load the banner's .MAP into $14000 (CRAM_Buffer, shared scratch - fine,
   574 				; this is a one-time boot step) and expand it into MENU_BANNER_MAP_VRAM (its
   575 				; own resident copy, NOT the shared CRAM $017000 - see Setup_Menu_Cmap).
   576 344F A9 23			lda #<Menu_Banner_Map_Name
   577 3451 8D 28 31			sta FileNamePtr
