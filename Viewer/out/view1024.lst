     5 2002 EE				dta $EE								; XDLC_RPTL (1 byte)    No change for $EF(239) lines
     6 2003 00 10 00 40 01		dta $00,$10,$00,$40,$01				; XDLC_OVADR (5 bytes)  Start @ $001000, Step $0140, End @ $13BFF
     7 2008 00 70 01 A0 00		dta $00,$70,$01,$A0,$00				; XDLC_MAPADR (5 bytes) Start @ $017000, Step $00A0, End @ $
     8 200D 00 00 07 00			dta $00,$00,$07,$00					; XDLC_MAPPAR (4 bytes) No Scroll, size 8x1
     9 2011 11 FF			dta %00010001,$FF					; XDLC_OVATT (2 bytes)
    10 				;		 76543210  76543210
