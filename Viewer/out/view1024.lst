  1416 3907 20 71 39			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1417 390A 20 41 39			jsr Cmp_Records						; rec(m) : rec(j)
  1418 390D 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1419 390F F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1420 3911 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1421 3913 85 83			sta Reg4
