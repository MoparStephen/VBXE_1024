  2443 				;=============================================================================
  2444 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2445 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2446 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2447 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2448 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits record 0 (the title rule,
  2449 				; pinned to row 0) plus a 19-row scrolling window of the rest - two
  2450 				; BLT_NFO_DRAW copies per scroll, no reformat, no re-walk.
  2451 				;=============================================================================
  2452
  2453 				;-----------------------------------------------------------------------------
  2454 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2455 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2456 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2457 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2458 				; off screen.
  2459 				;-----------------------------------------------------------------------------
  2460 5D11			Info_Load
  2461 5D11 A9 25			lda #NFO_BUF_BANK
  2462 5D13 85 8E			sta BankIndex
  2463 5D15 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2464 5D18 AD 2D 31			lda LoadStatus
  2465 5D1B F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2466 5D1D 20 21 5D			jsr Info_Count_Lines				; sets Nfo_LineCount
  2467 5D20			Info_Load_Ret
  2468 5D20 60				rts
  2469
  2470 				;-----------------------------------------------------------------------------
  2471 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2472 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2473 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2474 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2475 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2476 				;-----------------------------------------------------------------------------
  2477 5D21			Info_Count_Lines
  2478 5D21 A9 00			lda #$00
  2479 5D23 8D DE 04			sta Nfo_LineCount
  2480 5D26 8D DF 04			sta Nfo_LineCount + $01
  2481 5D29 A9 25			lda #NFO_BUF_BANK
  2482 5D2B 8D 50 06			sta Nfo_WalkBank
  2483 5D2E 09 80			ora #MEMAC_GLOBAL_ENABLE
  2484 5D30				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5D30 A0 5F			ldy #<VBXE_MA_BSEL
     3 5D32 91 93			sta (VBXEBase),y
Source: ui.asm
