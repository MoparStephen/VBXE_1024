   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a simple ASCII box ('+' '-' '|') with a blank
   392 				; interior over Txt_Row / Txt_Col / Reg1 (width-1) / Reg2 (height-1), using the
   393 				; current pen.  Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   394 				;-----------------------------------------------------------------------------
   395 3C82			Text_Window_Frame
   396 3C82 A5 80			lda Reg1
   397 3C84 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   398 3C86 AD B1 06			lda Txt_Col
   399 3C89 85 87			sta Reg8							; Reg8 = left column
   400 3C8B AD B0 06			lda Txt_Row
   401 3C8E 18				clc
   402 3C8F 65 81			adc Reg2
   403 3C91 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   404 3C93 AD B0 06			lda Txt_Row
   405 3C96 85 84			sta Reg5							; Reg5 = current screen row
   406 3C98 20 AC 3C			jsr Text_Window_Frame_EdgeRow		; top edge
   407 3C9B			Text_Window_Frame_Mid
   408 3C9B E6 84			inc Reg5
   409 3C9D A5 84			lda Reg5
   410 3C9F C5 85			cmp Reg6
   411 3CA1 B0 06			bcs Text_Window_Frame_Bottom
   412 3CA3 20 C8 3C			jsr Text_Window_Frame_MidRow
   413 3CA6 4C 9B 3C			jmp Text_Window_Frame_Mid
   414 3CA9			Text_Window_Frame_Bottom
   415 3CA9 4C AC 3C			jmp Text_Window_Frame_EdgeRow		; bottom edge (tail - returns to caller)
   416
   417 3CAC			Text_Window_Frame_EdgeRow
   418 3CAC A9 2B			lda #'+'
   419 3CAE 8D 80 06			sta Txt_Line+0
   420 3CB1 A2 01			ldx #$01
   421 3CB3			Text_Window_Frame_EdgeL
   422 3CB3 E4 86			cpx Reg7
   423 3CB5 B0 08			bcs Text_Window_Frame_EdgeEnd
   424 3CB7 A9 2D			lda #'-'
   425 3CB9 9D 80 06			sta Txt_Line,x
   426 3CBC E8				inx
   427 3CBD D0 F4			bne Text_Window_Frame_EdgeL
   428 3CBF			Text_Window_Frame_EdgeEnd
   429 3CBF A9 2B			lda #'+'
   430 3CC1 9D 80 06			sta Txt_Line,x
   431 3CC4 E8				inx
   432 3CC5 4C E1 3C			jmp Text_Window_Frame_PutRow
   433
   434 3CC8			Text_Window_Frame_MidRow
   435 3CC8 A9 7C			lda #'|'
   436 3CCA 8D 80 06			sta Txt_Line+0
   437 3CCD A2 01			ldx #$01
   438 3CCF			Text_Window_Frame_MidL
   439 3CCF E4 86			cpx Reg7
   440 3CD1 B0 08			bcs Text_Window_Frame_MidEnd
   441 3CD3 A9 20			lda #' '
   442 3CD5 9D 80 06			sta Txt_Line,x
   443 3CD8 E8				inx
   444 3CD9 D0 F4			bne Text_Window_Frame_MidL
   445 3CDB			Text_Window_Frame_MidEnd
   446 3CDB A9 7C			lda #'|'
   447 3CDD 9D 80 06			sta Txt_Line,x
   448 3CE0 E8				inx
   449 3CE1			Text_Window_Frame_PutRow
   450 3CE1 A9 00			lda #$00
   451 3CE3 9D 80 06			sta Txt_Line,x
   452 3CE6 A5 84			lda Reg5
   453 3CE8 8D B0 06			sta Txt_Row
   454 3CEB A5 87			lda Reg8
   455 3CED 8D B1 06			sta Txt_Col
   456 3CF0 A9 80			lda #<Txt_Line
   457 3CF2 85 96			sta Txt_Ptr
   458 3CF4 A9 06			lda #>Txt_Line
   459 3CF6 85 97			sta Txt_Ptr + $01
   460 3CF8 4C FB 3C			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
