   153 3300			.proc Check_RAMTOP
   154 				; Disable BASIC
   155 3300-33A3> A9 C0			lda #$C0							; Check if RAMTOP is already OK
   156 3302 C5 6A			cmp RAMTOP							; Prevent flickering if BASIC is already off
   157 3304 F0 38			beq Ram_Ok
   158
   159 3306 A9 01			lda #$01							; Set BASICF for OS
   160 3308 8D F8 03			sta BASICF							; So BASIC remains OFF after RESET
   161
   162 330B AD 01 D3			lda PORTB							; Disable BASIC bit in PORTB for MMU
   163 330E 09 02			ora #$02							; By Setting bit 2
   164 3310 8D 01 D3			sta PORTB
   165
   166 3313 AD 00 A0			lda $A000							; Check if BASIC ROM area is now RAM
   167 3316 EE 00 A0			inc $A000							; This will also catch SDX not launching
   168 3319 CD 00 A0			cmp $A000							; The app via X
   169 331C F0 21			beq Ram_Not_Ok						; If not, perform print error and exit
   170
   171 331E A9 0C			lda #$0C							; 12 = CLOSE
   172 3320 20 2E 33			jsr Do_CIOV							; Close editor
   173
   174 3323 A9 C0			lda #$C0
   175 3325 85 6A			sta RAMTOP							; Set RAMTOP to end of BASIC
   176 3327 8D E4 02			sta RAMSIZ							; Set RAMSIZ also
   177
   178 332A A2 00			ldx #$00							; Channel #0
   179 332C A9 04			lda #$04							; 4 = OPEN_READ
   180 332E			Do_CIOV
   181 332E 8D 42 03			sta ICCOM							; Store the Command
   182 3331 A9 68			lda #<Device_Name
   183 3333 8D 44 03			sta ICBAL							; Use channel #0
   184 3336 A9 33			lda #>Device_Name
   185 3338 8D 45 03			sta ICBAH
   186 333B 20 56 E4			jsr CIOV
   187
