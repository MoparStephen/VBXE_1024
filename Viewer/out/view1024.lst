   955 5331 8E C5 04			stx Dir_IOCB
   956 5334 A9 04			lda #CIO_read						; AUX1 = 4 : plain file, read
   957 5336 9D 4A 03			sta ICAX1,x
   958 5339 A9 00			lda #$00
   959 533B 9D 4B 03			sta ICAX2,x
   960 533E A9 50			lda #<Scan_Spec
   961 5340 9D 44 03			sta ICBAL,x
   962 5343 A9 06			lda #>Scan_Spec
   963 5345 9D 45 03			sta ICBAH,x
   964 5348 A9 03			lda #CIO_open
   965 534A 9D 42 03			sta ICCOM,x
   966 534D 20 56 E4			jsr CIOV
   967 5350 30 58			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
   968
   969 5352			Nfo_Name_LoadManifest_Line
   970 5352 AE C5 04			ldx Dir_IOCB
   971 5355 A9 05			lda #CIO_gettext
   972 5357 9D 42 03			sta ICCOM,x
   973 535A A9 B7			lda #<Nfo_Name_Line
   974 535C 9D 44 03			sta ICBAL,x
   975 535F A9 06			lda #>Nfo_Name_Line
   976 5361 9D 45 03			sta ICBAH,x
   977 5364 A9 3A			lda #58								; buffer length (8 key + 48 name + $9B, rounded)
   978 5366 9D 48 03			sta ICBLL,x
   979 5369 A9 00			lda #$00
   980 536B 9D 49 03			sta ICBLH,x
   981 536E 20 56 E4			jsr CIOV
