  1638 				;-----------------------------------------------------------------------------
  1639 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1640 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1641 				; crosses the visible window, else just re-colours the old and new cells;
  1642 				; always repaints the status line, then returns to the key loop.
  1643 				;-----------------------------------------------------------------------------
  1644 5882			Sel_Nav_Apply
  1645 5882 48				pha									; stash the new index
  1646 5883 AD C7 04			lda Sel_Index
  1647 5886 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1648 5888 68				pla
  1649 5889 8D C7 04			sta Sel_Index
  1650 588C 20 AE 58			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1651 588F CD C8 04			cmp Sel_Top
  1652 5892 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1653 5894 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1654 5897 20 CE 52			jsr Selector_DrawList
  1655 589A 4C A8 58			jmp Sel_Key_Nav_Done
  1656 589D			Sel_Nav_Apply_Rows
  1657 589D A5 87			lda Reg8
  1658 589F 20 72 53			jsr Selector_HiRow					; un-highlight the cell we left
  1659 58A2 AD C7 04			lda Sel_Index
  1660 58A5 20 72 53			jsr Selector_HiRow					; highlight the cell we moved to
  1661 58A8			Sel_Key_Nav_Done
  1662 58A8 20 A6 54			jsr Selector_DrawStatus				; row 20: description of the new row
  1663 58AB 4C 28 39			jmp Read_Key_Done
  1664
  1665 				;-----------------------------------------------------------------------------
  1666 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1667 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1668 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1669 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1670 				;-----------------------------------------------------------------------------
  1671 58AE			Sel_Top_For_Index
  1672 58AE 4A				lsr
  1673 58AF 4A				lsr
  1674 58B0 4A				lsr
  1675 58B1 85 80			sta Reg1							; Reg1 = target item_row
  1676 58B3 AD C8 04			lda Sel_Top
  1677 58B6 4A				lsr
  1678 58B7 4A				lsr
  1679 58B8 4A				lsr								; A = current top_row
  1680 58B9 C5 80			cmp Reg1
  1681 58BB 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1682 58BD F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1683 58BF A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1684 58C1 4C D0 58			jmp Sel_Top_FI_Scale
  1685 58C4			Sel_Top_FI_MaybeDown
  1686 58C4 18				clc
  1687 58C5 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1688 58C7 C5 80			cmp Reg1
  1689 58C9 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1690 58CB A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1691 58CD 38				sec
  1692 58CE E9 0E			sbc #[UI_VISROWS-1]
  1693 58D0			Sel_Top_FI_Scale
  1694 58D0 0A				asl
  1695 58D1 0A				asl
  1696 58D2 0A				asl								; row -> Sel_Top (* UI_COLS)
  1697 58D3 60				rts
  1698 58D4			Sel_Top_FI_Unchanged
  1699 58D4 AD C8 04			lda Sel_Top
  1700 58D7 60				rts
