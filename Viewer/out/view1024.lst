   519 50EC F0 04			beq Emit_Path_Prefix_Colon
   520 50EE 9D 8D 04			sta Path_Buf,x
   521 50F1 E8				inx
   522 50F2			Emit_Path_Prefix_Colon
   523 50F2 A9 3A			lda #':'
   524 50F4 9D 8D 04			sta Path_Buf,x
   525 50F7 E8				inx
   526 50F8 A0 00			ldy #$00
   527 50FA			Emit_Path_Prefix_L1
   528 50FA B9 28 06			lda Scan_Path,y
   529 50FD F0 09			beq Emit_Path_Prefix_Done
   530 50FF 9D 8D 04			sta Path_Buf,x
   531 5102 E8				inx
   532 5103 C8				iny
   533 5104 C0 28			cpy #$28
   534 5106 90 F2			bcc Emit_Path_Prefix_L1
   535 5108			Emit_Path_Prefix_Done
   536 5108 60				rts
