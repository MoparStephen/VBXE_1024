   182 				;-----------------------------------------------------------------------------
   183 				; Toggle_Font - flip the text screen between the CGA ($44) and Atari ($45)
   184 				; font by rewriting the two XDLC_CHBASE bytes (main + footer text blocks) in
   185 				; XDL_MainMenu.  The VBXE re-reads the XDL each frame, so the change shows on
   186 				; the next frame with no redraw - Text_Load_Fonts gave the Atari font the same
   187 				; box / arrow codes as CGA, so an open dialog or legend is right in either.
   188 				; Called from Handle_Keys on the F key, from any screen.
   189 				;-----------------------------------------------------------------------------
   190 3D59			Toggle_Font
   191 3D59 AD E0 04			lda Font_Sel
   192 3D5C 49 01			eor #$01
   193 3D5E 8D E0 04			sta Font_Sel
   194 3D61 18				clc
   195 3D62 69 44			adc #TEXT_CHBASE					; 0 -> $44 (CGA) / 1 -> $45 (Atari)
   196 3D64 AA				tax									; hold it - vbsta clobbers A (and Y)
   197 3D65 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the $2000 window
   198 3D67				vbsta VBXE_MA_BSEL
