  2400 5DB7 AD CB 04			lda Slide_FrameCtr+1
  2401 5DBA F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2402 5DBC CE CB 04			dec Slide_FrameCtr+1
  2403 5DBF			Slideshow_Tick_Dec
  2404 5DBF CE CA 04			dec Slide_FrameCtr
  2405 5DC2 60				rts
  2406 5DC3			Slideshow_Tick_Fire
  2407 5DC3 20 7A 34			jsr Clear_Screen
  2408 5DC6 20 41 39			jsr Increment_Image
