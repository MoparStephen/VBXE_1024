   453 3FDB 85 83			sta Reg4
   454 3FDD 90 02			bcc Text_Window_Setup_ColNC
   455 3FDF E6 84			inc Reg5
   456 3FE1			Text_Window_Setup_ColNC
   457 3FE1 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3FE3				vbsta VBXE_MA_BSEL
