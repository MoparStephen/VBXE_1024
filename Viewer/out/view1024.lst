   867 52BF A9 00			lda #$00
   868 52C1 8D B1 06			sta Txt_Col
   869 52C4 A9 B6			lda #<UI_Str_StatusBlank
   870 52C6 85 96			sta Txt_Ptr
   871 52C8 A9 5C			lda #>UI_Str_StatusBlank
