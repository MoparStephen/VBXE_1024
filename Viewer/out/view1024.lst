  1636 				;-----------------------------------------------------------------------------
  1637 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1638 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1639 				; crosses the visible window, else just re-colours the old and new cells;
  1640 				; always repaints the status line, then returns to the key loop.
  1641 				;-----------------------------------------------------------------------------
  1642 5831			Sel_Nav_Apply
  1643 5831 48				pha									; stash the new index
  1644 5832 AD C7 04			lda Sel_Index
  1645 5835 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1646 5837 68				pla
  1647 5838 8D C7 04			sta Sel_Index
  1648 583B 20 5D 58			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1649 583E CD C8 04			cmp Sel_Top
  1650 5841 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1651 5843 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1652 5846 20 7D 52			jsr Selector_DrawList
  1653 5849 4C 57 58			jmp Sel_Key_Nav_Done
  1654 584C			Sel_Nav_Apply_Rows
  1655 584C A5 87			lda Reg8
  1656 584E 20 21 53			jsr Selector_HiRow					; un-highlight the cell we left
  1657 5851 AD C7 04			lda Sel_Index
  1658 5854 20 21 53			jsr Selector_HiRow					; highlight the cell we moved to
  1659 5857			Sel_Key_Nav_Done
  1660 5857 20 55 54			jsr Selector_DrawStatus				; row 20: description of the new row
  1661 585A 4C BF 38			jmp Read_Key_Done
  1662
  1663 				;-----------------------------------------------------------------------------
  1664 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1665 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1666 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1667 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1668 				;-----------------------------------------------------------------------------
  1669 585D			Sel_Top_For_Index
