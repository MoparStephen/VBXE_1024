   462 				;-----------------------------------------------------------------------------
   463 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   464 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row).  Tracks bank + window
   465 				; offset explicitly (a row near the bottom straddles the $24000 boundary).
   466 				;-----------------------------------------------------------------------------
   467 3CFB			Text_PutStrAt
   468 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   469 3CFB A9 00			lda #$00
   470 3CFD 85 80			sta Reg1
   471 3CFF 85 81			sta Reg2
   472 3D01 AE B0 06			ldx Txt_Row
   473 3D04 F0 0E			beq Text_PutStrAt_Col
   474 3D06			Text_PutStrAt_RowL
   475 3D06 A5 80			lda Reg1
   476 3D08 18				clc
   477 3D09 69 A0			adc #TEXT_PITCH
   478 3D0B 85 80			sta Reg1
   479 3D0D 90 02			bcc Text_PutStrAt_RowNC
   480 3D0F E6 81			inc Reg2
   481 3D11			Text_PutStrAt_RowNC
   482 3D11 CA				dex
   483 3D12 D0 F2			bne Text_PutStrAt_RowL
   484 3D14			Text_PutStrAt_Col
   485 3D14 AD B1 06			lda Txt_Col
   486 3D17 0A				asl									; Txt_Col * 2 (max 158)
   487 3D18 18				clc
   488 3D19 65 80			adc Reg1
   489 3D1B 85 80			sta Reg1
   490 3D1D 90 02			bcc Text_PutStrAt_ColNC
   491 3D1F E6 81			inc Reg2
   492 3D21			Text_PutStrAt_ColNC
   493 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   494 3D21 A5 81			lda Reg2
   495 3D23 29 10			and #$10							; offset bit 12 = "second bank"
   496 3D25 F0 04			beq Text_PutStrAt_Bank0
   497 3D27 A9 24			lda #TEXT_SCREEN_BANK+1
   498 3D29 D0 02			bne Text_PutStrAt_SetBank
   499 3D2B			Text_PutStrAt_Bank0
   500 3D2B A9 23			lda #TEXT_SCREEN_BANK
   501 3D2D			Text_PutStrAt_SetBank
   502 3D2D 8D B6 06			sta Txt_Bank
   503 3D30 A5 80			lda Reg1
   504 3D32 85 88			sta Ptr_Lo
   505 3D34 A5 81			lda Reg2
   506 3D36 29 0F			and #$0F
   507 3D38 18				clc
   508 3D39 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   509 3D3B 85 89			sta Ptr_Hi
   510 3D3D AD B6 06			lda Txt_Bank
   511 3D40 09 80			ora #MEMAC_GLOBAL_ENABLE
   512 3D42				vbsta VBXE_MA_BSEL
