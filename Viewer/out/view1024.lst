   159 3139 F0 15			beq VBXE_Detected					; If so, then VBXE is detected
   160 313B A9 00			lda #$00
   161 313D E8				inx
   162 313E 8D 40 D7			sta $D740							; No such luck, try other location
   163 3141 AD 40 D7			lda $D740
   164 3144 C9 10			cmp #$10
