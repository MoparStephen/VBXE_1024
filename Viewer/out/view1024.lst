  2388 				;-----------------------------------------------------------------------------
  2389 				; Slideshow_Tick - called from main every frame.  Counts Slide_FrameCtr down
  2390 				; and advances to the next image at zero.  No-op unless UI_Mode = 2.
  2391 				;-----------------------------------------------------------------------------
  2392 5CC2			Slideshow_Tick
  2393 5CC2 AD C6 04			lda UI_Mode
  2394 5CC5 C9 02			cmp #$02
  2395 5CC7 F0 01			beq Slideshow_Tick_Run
  2396 5CC9 60				rts
  2397 5CCA			Slideshow_Tick_Run
  2398 5CCA AD CA 04			lda Slide_FrameCtr
  2399 5CCD D0 08			bne Slideshow_Tick_Dec
  2400 5CCF AD CB 04			lda Slide_FrameCtr+1
  2401 5CD2 F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2402 5CD4 CE CB 04			dec Slide_FrameCtr+1
  2403 5CD7			Slideshow_Tick_Dec
  2404 5CD7 CE CA 04			dec Slide_FrameCtr
  2405 5CDA 60				rts
  2406 5CDB			Slideshow_Tick_Fire
  2407 5CDB 20 7A 33			jsr Clear_Screen
  2408 5CDE 20 59 38			jsr Increment_Image
  2409 5CE1 20 E5 5C			jsr Slideshow_Reload_Counter
  2410 5CE4 60				rts
