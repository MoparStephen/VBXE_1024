   513 				; --- write the cells -------------------------------------------------------
   514 3A8E A9 00			lda #$00
   515 3A90 85 82			sta Reg3							; Reg3 = source string index
   516 3A92 AD B1 06			lda Txt_Col
   517 3A95 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   518 3A97			Text_PutStrAt_Char
   519 3A97 A5 83			lda Reg4
   520 3A99 C9 50			cmp #TEXT_COLS
   521 3A9B B0 39			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   522 3A9D A4 82			ldy Reg3
   523 3A9F B1 96			lda (Txt_Ptr),y
   524 3AA1 F0 33			beq Text_PutStrAt_Done
   525 3AA3 A0 00			ldy #$00
   526 3AA5 91 88			sta (Ptr_Lo),y						; glyph byte
   527 3AA7 C8				iny
   528 3AA8 AD B4 06			lda Txt_Attr
   529 3AAB 91 88			sta (Ptr_Lo),y						; attribute byte
   530 3AAD E6 82			inc Reg3
   531 3AAF E6 83			inc Reg4
   532 3AB1 A5 88			lda Ptr_Lo							; window pointer += 2
   533 3AB3 18				clc
   534 3AB4 69 02			adc #$02
   535 3AB6 85 88			sta Ptr_Lo
