   845 528C 8D E1 04			sta Nfo_Name_Ord
   846 528F 20 CF 52			jsr Nfo_Name_MapSlot				; Ptr_Lo/Hi -> slot, bank $2A..$2D mapped
   847 5292 20 F9 52			jsr Nfo_Name_Emit					; Path_Buf = name padded to NFO_NAME_CAP + NUL
