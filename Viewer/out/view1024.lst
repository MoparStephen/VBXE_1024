   308 				;-----------------------------------------------------------------------------
   309 				; Text_FillColour - recolour a rectangle of cells by flooding their attribute
   310 				; (odd) bytes.  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   311 				; (cells), Reg2 = height-1 (rows), A = attribute byte.  Patches BLT_FILL_COLOUR
   312 				; (dest address, Width-1, Height-1, Xor mask) then kicks it and waits.
   313 				;-----------------------------------------------------------------------------
   314 3C6A			Text_FillColour
   315 3C6A 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   316 3C6C A9 01			lda #$01
   317 3C6E 8D B7 06			sta Txt_Dirty
   318 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
   319 3C71 A9 00			lda #$00
   320 3C73 85 83			sta Reg4
   321 3C75 85 84			sta Reg5
   322 3C77 AE B0 06			ldx Txt_Row
   323 3C7A F0 0E			beq Text_FillColour_Col
   324 3C7C			Text_FillColour_RowL
   325 3C7C A5 83			lda Reg4
   326 3C7E 18				clc
   327 3C7F 69 A0			adc #TEXT_PITCH						; + 160 per row
   328 3C81 85 83			sta Reg4
   329 3C83 90 02			bcc Text_FillColour_RowNC
   330 3C85 E6 84			inc Reg5
   331 3C87			Text_FillColour_RowNC
   332 3C87 CA				dex
   333 3C88 D0 F2			bne Text_FillColour_RowL
   334 3C8A			Text_FillColour_Col
   335 3C8A AD B1 06			lda Txt_Col
   336 3C8D 0A				asl									; Txt_Col * 2
   337 3C8E 18				clc
   338 3C8F 65 83			adc Reg4
   339 3C91 85 83			sta Reg4
   340 3C93 90 02			bcc Text_FillColour_ColNC
   341 3C95 E6 84			inc Reg5
   342 3C97			Text_FillColour_ColNC
   343 3C97 E6 83			inc Reg4							; + 1  -> the attribute (odd) byte
   344 3C99 D0 02			bne Text_FillColour_Patch
   345 3C9B E6 84			inc Reg5
   346 3C9D			Text_FillColour_Patch
   347 3C9D A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   348 3C9F				vbsta VBXE_MA_BSEL
