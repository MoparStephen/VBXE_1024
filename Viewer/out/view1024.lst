   215 335E A9 01			lda	#$01
   216 3360 8D 51 D6			sta	VBXE_BL_ADR1
   217 3363 A9 00			lda	#0
   218 3365			Clear_Screen_L1
   219 3365 AD 53 D6			lda	VBXE_BLITTER_BUSY
   220 3368 C9 00			cmp	#0
   221 336A D0 F9			bne	Clear_Screen_L1					; Wait for blitter to finish
   222 336C A9 01			lda	#1
   223 336E 8D 53 D6			sta	VBXE_BLITTER_START				; Start the blit
   224 3371 60				rts
