   472 4D34 9D 8D 04			sta Path_Buf,x
   473 4D37 E8				inx
   474 4D38 C8				iny
   475 4D39 C0 28			cpy #$28
   476 4D3B 90 F2			bcc Emit_Path_Prefix_L1
   477 4D3D			Emit_Path_Prefix_Done
