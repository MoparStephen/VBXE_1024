  1333 383F 8D C5 02			sta COLOR1
  1334 3842 AD 83 04			lda COLOR2_OLD
  1335 3845 8D C6 02			sta COLOR2
  1336 3848 AD E4 04			lda COLOR4_OLD
  1337 384B 8D C8 02			sta COLOR4
