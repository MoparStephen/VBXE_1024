   964 3616 85 80			sta Reg1
   965 3618 A9 0A			lda #>[MENU_DEMO_ROW_BOT*MENU_ATTR_ROW_BYTES]
   966 361A 85 81			sta Reg2
   967 361C A9 F9			lda #<Menu_Demo_Attr_Bot_Vals
   968 361E 85 88			sta Ptr_Lo
   969 3620 A9 35			lda #>Menu_Demo_Attr_Bot_Vals
   970 3622 85 89			sta Ptr_Hi
   971 3624 20 2E 36			jsr Set_Menu_Demo_Attr_Band
