   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3CF3			Text_Window_Save
   393 3CF3 20 46 3D			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3CF6 A5 83			lda Reg4
   395 3CF8 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3CFB A5 84			lda Reg5
   397 3CFD 18				clc
   398 3CFE 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3D00 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3D03 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3D05 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3D08 A9 00			lda #<WIN_SAVE_VRAM
   403 3D0A 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3D0D A9 F0			lda #>WIN_SAVE_VRAM
   405 3D0F 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3D12 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3D14 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3D17 4C 86 3D			jmp Text_Window_Kick
   409
   410 3D1A			Text_Window_Restore
   411 3D1A A9 01			lda #$01
   412 3D1C 8D B7 06			sta Txt_Dirty
   413 3D1F 20 46 3D			jsr Text_Window_Setup
   414 3D22 A9 00			lda #<WIN_SAVE_VRAM
   415 3D24 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3D27 A9 F0			lda #>WIN_SAVE_VRAM
   417 3D29 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3D2C A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3D2E 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3D31 A5 83			lda Reg4
   421 3D33 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3D36 A5 84			lda Reg5
   423 3D38 18				clc
   424 3D39 69 A0			adc #>TEXT_BACK_VRAM
   425 3D3B 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3D3E A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3D40 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3D43 4C 86 3D			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3D46			Text_Window_Setup
   433 3D46 A9 00			lda #$00
   434 3D48 85 83			sta Reg4
   435 3D4A 85 84			sta Reg5
   436 3D4C AE B0 06			ldx Txt_Row
   437 3D4F F0 0E			beq Text_Window_Setup_Col
   438 3D51			Text_Window_Setup_RowL
   439 3D51 A5 83			lda Reg4
   440 3D53 18				clc
   441 3D54 69 A0			adc #TEXT_PITCH
   442 3D56 85 83			sta Reg4
   443 3D58 90 02			bcc Text_Window_Setup_RowNC
   444 3D5A E6 84			inc Reg5
   445 3D5C			Text_Window_Setup_RowNC
   446 3D5C CA				dex
   447 3D5D D0 F2			bne Text_Window_Setup_RowL
   448 3D5F			Text_Window_Setup_Col
   449 3D5F AD B1 06			lda Txt_Col
   450 3D62 0A				asl
   451 3D63 18				clc
   452 3D64 65 83			adc Reg4
   453 3D66 85 83			sta Reg4
   454 3D68 90 02			bcc Text_Window_Setup_ColNC
   455 3D6A E6 84			inc Reg5
   456 3D6C			Text_Window_Setup_ColNC
   457 3D6C A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3D6E				vbsta VBXE_MA_BSEL
