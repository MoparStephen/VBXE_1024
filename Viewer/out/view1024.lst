  2036 5755 85 81			sta Reg2
  2037 5757 AE DC 04			ldx Nfo_Top
  2038 575A F0 0E			beq Info_Draw_Patch
  2039 575C			Info_Draw_MulL
  2040 575C A5 80			lda Reg1
  2041 575E 18				clc
  2042 575F 69 A0			adc #TEXT_PITCH
  2043 5761 85 80			sta Reg1
  2044 5763 90 02			bcc Info_Draw_MulNC
  2045 5765 E6 81			inc Reg2
  2046 5767			Info_Draw_MulNC
  2047 5767 CA				dex
  2048 5768 D0 F2			bne Info_Draw_MulL
  2049 576A			Info_Draw_Patch
  2050 576A A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2051 576C				vbsta VBXE_MA_BSEL
