  2607 6160 ED DC 04			sbc Nfo_Top
  2608 6163 85 84			sta Reg5
  2609 6165 AD DF 04			lda Nfo_LineCount + $01
  2610 6168 ED DD 04			sbc Nfo_Top + $01
  2611 616B 85 85			sta Reg6
  2612 616D A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2613 616F 38				sec
  2614 6170 E9 01			sbc #$01
  2615 6172 85 84			sta Reg5
  2616 6174 A5 85			lda Reg6
  2617 6176 E9 00			sbc #$00
  2618 6178 D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2619 617A A5 84			lda Reg5
  2620 617C C9 13			cmp #NFO_VISROWS-1
  2621 617E 90 02			bcc Info_Body_Rows_Ret
  2622 6180			Info_Body_Rows_Full
  2623 6180 A9 13			lda #NFO_VISROWS-1
  2624 6182			Info_Body_Rows_Ret
  2625 6182 C9 00			cmp #$00							; Z = no rows
  2626 6184 60				rts
