   824 				;-----------------------------------------------------------------------------
   825 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   826 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   827 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   828 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   829 				;-----------------------------------------------------------------------------
   830 35D6			Image_Read_Segment
   831 35D6 8D E3 04			sta Seg_Bank
   832 35D9 8E E4 04			stx Seg_Chunks
   833 35DC			Image_Read_Segment_L1
   834 35DC AD E4 04			lda Seg_Chunks
   835 35DF F0 0F			beq Image_Read_Segment_Tail
   836 35E1 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   837 35E3 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   838 35E5 20 03 36			jsr Image_Read_Chunk
   839 35E8 B0 18			bcs Image_Read_Segment_Done
   840 35EA CE E4 04			dec Seg_Chunks
   841 35ED 4C DC 35			jmp Image_Read_Segment_L1
   842
   843 35F0			Image_Read_Segment_Tail
   844 35F0 AD E5 04			lda Seg_Tail
   845 35F3 0D E6 04			ora Seg_Tail + $01
   846 35F6 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   847 35F8 AD E5 04			lda Seg_Tail
   848 35FB AC E6 04			ldy Seg_Tail + $01
   849 35FE 4C 03 36			jmp Image_Read_Chunk
   850
   851 3601			Image_Read_Segment_OK
   852 3601 18				clc
   853 3602			Image_Read_Segment_Done
   854 3602 60				rts
   855
   856 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   857 				; C=1 on a CIO error.
   858 3603			Image_Read_Chunk
   859 3603 AE E2 04			ldx Load_IOCB
   860 3606 9D 48 03			sta ICBLL,x
   861 3609 98				tya
   862 360A 9D 49 03			sta ICBLH,x							; length stored before vbsta clobbers Y
   863 360D AD E3 04			lda Seg_Bank
   864 3610 09 80			ora #MEMAC_GLOBAL_ENABLE
   865 3612				vbsta VBXE_MA_BSEL
