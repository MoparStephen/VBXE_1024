   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    69
    70 				;-----------------------------------------------------------------------------
    71 				; Structure Declarations
    72 				;-----------------------------------------------------------------------------
    73
    74 				;-----------------------------------------------------------------------------
    75 				; Variables go here
    76 				;-----------------------------------------------------------------------------
    77 				; Page 0 user data ($80 to $FF with some reserved for OS)
    78 				.zpvar Reg1				.byte			; Multi-Use Variables
    79 				.zpvar Reg2				.byte			; Multi-Use Variables
    80 				.zpvar Reg3				.byte			; Multi-Use Variables
    81 				.zpvar Reg4				.byte			; Multi-Use Variables
    82 				.zpvar Reg5				.byte			; Multi-Use Variables
    83 				.zpvar Reg6				.byte			; Multi-Use Variables
    84 				.zpvar Reg7				.byte			; Multi-Use Variables
    85 				.zpvar Reg8				.byte			; Multi-Use Variables
    86 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    87 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    88 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    89 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    90
    91 				; Non Page-0 Variables
    92 				;	$480 to $4FF free
    93 				;	$600 to $6FF free
    94 				; When using PMG the 1st $300 bytes are always free
    95 				.var SDMCTL_OLD			.byte = $480	; Save DMA
    96 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
    97 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
    98 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
    99 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   100 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   101 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   102 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   103 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   104 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   105 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   106 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   107 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   108 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   109 				; --- viewer UI state (ui.asm) ---
   110 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 6 P-preview
   111 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   112 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   113 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   114 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   115 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   116 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   117 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   118 				.var FileStart			.byte = $4DA	; selector list: index of the first *.MAP row (= upCount + Dir_Count)
   119 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   120 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   121 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   122 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   123 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   124 				;	$4E2 to $4FF free
   125 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   126 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   127 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.MAP",$9B ($650-$67F)
   128 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   129 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP name + $9B) for
   130 				; Nfo_Name_LoadManifest.  Own buffer, not Dir_Line_Buf, because a record can
   131 				; run to 8+48+1 = 57 bytes - past that 40-byte line's end.
   132 				.var Nfo_Name_Line		:58 .byte = $6B7	; 8 key + 48 name + $9B, rounded ($6B7-$6F0)
   133 				;	$6F1 to $6FF free (text80.asm uses $6B0-$6B6)
   134 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   135 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   136 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   137 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   138 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   139
   140 				;-----------------------------------------------------------------------------
   141 				; Defines go here
   142 				;-----------------------------------------------------------------------------
   143 = FFFF0001		.def	__VBXE_AUTO__
   144 = 2000			.def	VBXE_WINDOW						= $2000
   145 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   146 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   147 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   148
   149 				; Image name list (built by Rescan_Images - see ui.asm)
   150 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   151 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   152 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   153 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   154 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   155
   156 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   157 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   158 				; ($21000), the name list ($40000) and the dir browser ($41000).
   159 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   160 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   161 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   162 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   163 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   164 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   165 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   166 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   167 = 0050			.def	TEXT_COLS						= 80
   168 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   169 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   170 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   171 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   172 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   173 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   174 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   175 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   176 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   177
   178 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   179 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   180 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   181 = 030000			.def	MENU_BANNER_VRAM				= $30000
   182 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   183 = 0024			.def	MENU_BANNER_ROWS				= 36
   184 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   185 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   186 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   187 = 00A0			.def	MENU_SEP_PITCH					= 160
   188 = 0007			.def	MENU_SEP_FILL_COLOUR			= $07		; white in the modified A8 palette (Palette 0)  Palette is modified so text can use all 128 colours
   189
   190 				; Banner palette + attribute map: never touched at runtime (unlike the real
   191 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   192 				; overwrites for every image view).  Dedicated, resident VRAM - see
   193 				; Load_Menu_Banner_Raw / Apply_Menu_Banner_Palette (below) and Setup_Menu_Cmap.
   194 				; The palette bytes are assembly-embedded (Load_Menu_Ramps, init_vbxe.asm),
   195 				; not disk-loaded; the attribute map is still loaded once from D:MENU.MAP.
   196 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   197 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   198 																	; - palette register 0 is reserved for text
   199 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   200 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   201 																	; XDL_MainMenu's banner MAPADR points here, NOT
   202 																	; at the shared $017000 CRAM
   203
   204 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   205 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   206 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   207 				; unchanged) but horizontally mirrored via the attribute map only -
   208 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   209 				; Squares, Set_Menu_Demo_Attrs (below).
   210 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   211 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   212 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   213 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   214 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   215 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   216 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   217 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   218 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   219 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   220 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   221 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   222 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   223 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   224
   225 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   226 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   227 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   228 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   229 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   230 = 1000			.def	PAL_PREVIEW_VRAM				= $001000	; image framebuffer (same target Load_Image's .RAW uses)
   231 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   232 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   233 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   234 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   235 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   236 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   237 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   238 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   239 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   240 = 18F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   241 = 1960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   242 = A4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   243 = A560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   244 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   245 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   246 				; whole buffer, and palette 0 = $00 is the zero default).
   247 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   248 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   249 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   250 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   251 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   252 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   253 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   254 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   255
   256 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   257 				; converter emits it as this exact byte image of the text screen - fixed
   258 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   259 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   260 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   261 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   262 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   263 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   264
   265 				; Selector status-line long-name cache.  One NFO_NAME_SLOT-byte slot per image
   266 				; ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   267 				; Rescan_Images (the converter writes that file - 8-byte key + source name per
   268 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  64
   269 				; divides 4K so no slot straddles a bank; 255*64 = $3FC0 -> banks $2A-$2D.
   270 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   271 = 02A000			.def	NFO_NAME_VRAM					= $2A000
   272 = 002A			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $2A
   273 = 0040			.def	NFO_NAME_SLOT					= 64		; bytes per image slot
   274 = 0030			.def	NFO_NAME_CAP						= 48		; chars shown on the status line
   275
   276 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   277 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   278 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   279 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   280 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   281 = 0006			.def	DRIVE_WIN_ROW					= 6
   282 = 001E			.def	DRIVE_WIN_COL					= 30
   283 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   284 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   285
   286 				; Quit-confirm popup (UI_Mode 5) - "Are you sure to Quit" + (Y/N), Selector only.
   287 = 0008			.def	QUIT_WIN_ROW					= 8
   288 = 0016			.def	QUIT_WIN_COL					= 22
   289 = 0024			.def	QUIT_WIN_W						= 36		; cells wide  (border + text + border)
   290 = 0005			.def	QUIT_WIN_H						= 5		; rows        (border + text + hint + border, +1)
   291
   292 				; BCB field byte offsets
   293 = 0000			.def	Src_Adr0						= $00
   294 = 0001			.def	Src_Adr1						= $01
   295 = 0002			.def	Src_Adr2						= $02
   296 = 0006			.def	Dest_Adr0						= $06
   297 = 0007			.def	Dest_Adr1						= $07
   298 = 0008			.def	Dest_Adr2						= $08
   299 = 0009			.def	Dest_Step_Y0					= $09	; Destination step y, low byte
   300 = 000A			.def	Dest_Step_Y1					= $0A	; Destination step y, high bits
   301 = 000C			.def	Blt_W0							= $0C	; Width-1  low byte
   302 = 000D			.def	Blt_W1							= $0D	; Width-1  bit 8
   303 = 000E			.def	Blt_H							= $0E	; Height-1
   304 = 000F			.def	Blt_And							= $0F	; And mask (0 = constant source)
   305 = 0010			.def	Blt_Xor							= $10	; Xor mask (= fill value when And = 0)
   306 = 0012			.def	Blt_Zoom						= $12	; X/Y zoom (bits 0-2=ZOOMX, 4-6=ZOOMY; factor = field+1)
   307 = 0014			.def	Blt_Ctrl						= $14
   308
   309 				; Temp debug stuff
   310 = 0010			.def	V_0								= $10	; 0 (Screen code used for Version in loading screen)
   311 = 0011			.def	V_1								= $11	; 1 (Screen code used for Version in loading screen)
   312 = 0015			.def	V_2								= $15	; 5 (Screen code used for Version in loading screen)
   313 = 0000			.def	V_3								= $00	; 61=a (Screen code used for Version in loading screen)
