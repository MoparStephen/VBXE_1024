  1466 59E7			Put_U8_Pad3_TDone
  1467 59E7 98				tya
  1468 59E8 20 F1 59			jsr Put_U8_Pad3_Digit
  1469 59EB A5 80			lda Reg1
  1470 59ED 09 30			ora #'0'							; ones digit - always shown
  1471 59EF D0 0E			bne Put_U8_Pad3_Store
