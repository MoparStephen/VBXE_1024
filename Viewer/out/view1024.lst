   158 3300			.proc Check_RAMTOP
   159 				; Disable BASIC
   160 3300-33A3> A9 C0			lda #$C0							; Check if RAMTOP is already OK
   161 3302 C5 6A			cmp RAMTOP							; Prevent flickering if BASIC is already off
   162 3304 F0 38			beq Ram_Ok
