   189 				;-----------------------------------------------------------------------------
   190 				; VBXE_SetPalette2 - sets palette
   191 				;	A			- palette number
   192 				;	Y_Register	- palette pointer - Data MUST be page aligned
   193 				; NOTE: This code can run from ROM
   194 				;       The palette is stored as 256 RGB triplets
   195 				; NOTE (__VBXE_AUTO__ mode): the CR/CG/CB stores below use plain sta.w, not
   196 				; vbsta - this loop needs Y as its data index every iteration, and vbsta's
   197 				; (VBXEBase),Y addressing would clobber it every store. Instead the high
   198 				; byte of all nine store operands is patched ONCE per call (self-modifying,
   199 				; but off the hot path) so the loop itself runs at plain absolute-store cost.
   200 315D			VBXE_SetPalette2
   201 315D				vbsta VBXE_PSEL						; Set Palette 1
Macro: VBSTA [Source: vbxe_min.asm]
     2 315D A0 45			ldy #<VBXE_PSEL
     3 315F 91 93			sta (VBXEBase),y
Source: vbxe_min.asm
   202 3161 A9 00			lda #$00
