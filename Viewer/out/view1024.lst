  1087 3770 B1 8C			lda (Sort_Ptr),y
  1088 3772 91 8A			sta (Name_Ptr),y
  1089 3774 B9 8D 04			lda Path_Buf,y
  1090 3777 91 8C			sta (Sort_Ptr),y
  1091 3779 C8				iny
  1092 377A C0 08			cpy #$08
  1093 377C 90 ED			bcc Swap_Records_L1
  1094 377E 60				rts
