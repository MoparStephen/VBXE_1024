     1 = 0004			.def	NUM_DOTS						= $04		; 6 stages x 4 + logo 3+3+2 = 32 dots, centred in the 38-col box (cols 4-35)
     2 = 00CC			.def	LOAD_DOTS_START					= $CC		; row 5, col 4 - first progress dot
     3 = 0079			.def	LOAD_MSG_ROW3					= $79		; row 3, col 1 - stage message (33 chars)
     4
     5 				; OS state Step_1 / Check_RAMTOP change and the Exit path restores (COLOR2_OLD
     6 				; is declared in view1024.asm alongside the other _OLD saves).
     7 3341			.var	RAMTOP_OLD		.byte = $4F8	; Check_RAMTOP forces RAMTOP to $C0; SDX soft console needs its own
     8 3341			.var	COLOR1_OLD		.byte = $4F9	; Step_1 recolours COLOR1 for the loader
     9 3341			.var	COLOR4_OLD		.byte = $4FA	; parity with the racer's exit path
