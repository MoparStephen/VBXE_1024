Source: vbxe_min.asm
   204
   205 				.ifdef	__VBXE_AUTO__
   206 3166 A5 94			lda VBXEBase+1
   207 3168 8D 8A 31			sta SP2_CR1							; SP2_xxN labels equ *-1 to the store's
   208 316B 8D 92 31			sta SP2_CG1							; high-byte position already - no +1
   209 316E 8D 98 31			sta SP2_CB1
   210 3171 8D A0 31			sta SP2_CR2
   211 3174 8D A8 31			sta SP2_CG2
   212 3177 8D B0 31			sta SP2_CB2
   213 317A 8D B8 31			sta SP2_CR3
   214 317D 8D BE 31			sta SP2_CG3
   215 3180 8D C4 31			sta SP2_CB3
   216 3183 A9 00			lda #$00							; Patching above clobbered A - restore it,
   217 				.endif									; tay below needs #$00 to zero the loop index
   218
   219 3185 A8				tay
   220 3186 B1 95		LoadPal1_1 lda (Y_Register),y
   221 3188 8D 46 00			sta.w VBXE_CR						; Set the red component
   222 = 318A			SP2_CR1	equ *-1
   223 318B C8				iny
   224 318C F0 3B			beq OverFlow1						; Since 256 / 3 is not even, we must skip to next section and resume at CG
   225 318E B1 95			lda (Y_Register),y
   226 3190 8D 47 00			sta.w VBXE_CG						; Set the green component
   227 = 3192			SP2_CG1	equ *-1
   228 3193 C8				iny
   229 3194 B1 95			lda (Y_Register),y
   230 3196 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   231 = 3198			SP2_CB1	equ *-1
   232 3199 C8				iny
   233 319A D0 EA			bne LoadPal1_1						; Copy a page
   234 319C B1 95		LoadPal1_2 lda (Y_Register),y
   235 319E 8D 46 00			sta.w VBXE_CR						; Set the red component
   236 = 31A0			SP2_CR2	equ *-1
   237 31A1 C8				iny
   238 31A2 F0 10			beq LoadPal1_3
   239 31A4			LP1_2_G
   240 31A4 B1 95			lda (Y_Register),y
   241 31A6 8D 47 00			sta.w VBXE_CG						; Set the green component
   242 = 31A8			SP2_CG2	equ *-1
   243 31A9 C8				iny
   244 31AA F0 22			beq OverFlow2						; Since 256 / 3 is not even, we must skip to next section and resume at CB
   245 31AC B1 95			lda (Y_Register),y
   246 31AE 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   247 = 31B0			SP2_CB2	equ *-1
   248 31B1 C8				iny
   249 31B2 D0 E8			bne LoadPal1_2						; Copy a page
   250 31B4 B1 95		LoadPal1_3 lda (Y_Register),y
   251 31B6 8D 46 00			sta.w VBXE_CR						; Set the red component
   252 = 31B8			SP2_CR3	equ *-1
   253 31B9 C8				iny
   254 31BA B1 95			lda (Y_Register),y
   255 31BC 8D 47 00			sta.w VBXE_CG						; Set the green component
   256 = 31BE			SP2_CG3	equ *-1
   257 31BF C8				iny
   258 31C0			LP1_3_B
   259 31C0 B1 95			lda (Y_Register),y
   260 31C2 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   261 = 31C4			SP2_CB3	equ *-1
   262 31C5 C8				iny
   263 31C6 D0 EC			bne LoadPal1_3						; Copy a page
   264 31C8 60				rts
   265
   266 31C9			OverFlow1
   267 31C9 E6 96			inc Y_Register + 1
   268 31CB 4C A4 31			jmp LP1_2_G
   269 31CE			OverFlow2
   270 31CE E6 96			inc Y_Register + 1
   271 31D0 4C C0 31			jmp LP1_3_B
