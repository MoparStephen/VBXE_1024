  1601 				;-----------------------------------------------------------------------------
  1602 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1603 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1604 				; equal) otherwise.
  1605 				;-----------------------------------------------------------------------------
  1606 39EF			Cmp_Records
  1607 39EF A0 00			ldy #$00
  1608 39F1			Cmp_Records_L1
  1609 39F1 B1 8A			lda (Name_Ptr),y
  1610 39F3 D1 8C			cmp (Sort_Ptr),y
  1611 39F5 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1612 39F7 C8				iny
  1613 39F8 C0 08			cpy #$08
  1614 39FA 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1615 39FC			Cmp_Records_Done
  1616 39FC 60				rts
