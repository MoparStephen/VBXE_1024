   633 337A			Build_Image_List_L1
   634 337A AE 9D 04			ldx Dir_IOCB
   635 337D A9 05			lda #CIO_gettext
   636 337F 9D 42 03			sta ICCOM,x
   637 3382 A9 00			lda #<Dir_Line_Buf
   638 3384 9D 44 03			sta ICBAL,x
   639 3387 A9 06			lda #>Dir_Line_Buf
   640 3389 9D 45 03			sta ICBAH,x
   641 338C A9 28			lda #<Dir_Line_Len
   642 338E 9D 48 03			sta ICBLL,x
   643 3391 A9 00			lda #>Dir_Line_Len
   644 3393 9D 49 03			sta ICBLH,x
   645 3396 20 56 E4			jsr CIOV
   646 3399 30 29			bmi Build_Image_List_Close			; Negative status (EOF or error) - done
   647
   648 				; Table full? Compare the write cursor to the end of the reserved space
   649 339B A5 8B			lda Name_Ptr+1
   650 339D C9 27			cmp #>ImageNames_End
   651 339F 90 08			bcc Build_Image_List_Room
   652 33A1 D0 D7			bne Build_Image_List_L1				; Hi byte over end - full, skip storing
   653 33A3 A5 8A			lda Name_Ptr
   654 33A5 C9 F8			cmp #<ImageNames_End
   655 33A7 B0 D1			bcs Build_Image_List_L1				; At/past end - full
   656 33A9			Build_Image_List_Room
   657 33A9 20 D6 33			jsr Parse_Dir_Line
   658 33AC F0 CC			beq Build_Image_List_L1				; A=0 - not a real filename
   659
   660 33AE EE 8B 04			inc ImageCount
   661 33B1 D0 03			bne Build_Image_List_Adv
   662 33B3 EE 8C 04			inc ImageCount+1
   663 33B6			Build_Image_List_Adv
   664 33B6 A5 8A			lda Name_Ptr
   665 33B8 18				clc
   666 33B9 69 08			adc #$08
   667 33BB 85 8A			sta Name_Ptr
   668 33BD 90 BB			bcc Build_Image_List_L1
   669 33BF E6 8B			inc Name_Ptr+1
   670 33C1 4C 7A 33			jmp Build_Image_List_L1
