Source: vbxe_min.asm
     1 				; BRACKETS ARE LOAD-BEARING.  MADS binds .not looser than .and, so the
     2 				; unbracketed form ".not .def A .and .not .def B" parses as
     3 				; ".not [.def A .and .not .def B]" - which is TRUE whenever __VBXE_AUTO__ is
     4 				; undefined, so the first branch always won and __VBXE_D700__ did nothing.
     5 				.if [.not .def __VBXE_AUTO__] .and [.not .def __VBXE_D700__]	; Default case - VBXE at $D640
     6 				VBXE_BASE		equ	$D600
     7 				.elseif [.not .def __VBXE_AUTO__] .and [.def __VBXE_D700__]	; VBXE is assumed to be under $D740
     8 				VBXE_BASE		equ	$D700
     9 				.else									; VBXE should be autodetected
    10 = 0000			VBXE_BASE		equ	$0000
    11 				.endif
    12
    13 = 0040			VBXE_VIDEO_CONTROL		equ	VBXE_BASE+$40	; Write
    14 = 0040			VBXE_CORE_VERSION		equ	VBXE_BASE+$40	; Read
    15 = 0041			VBXE_XDL_ADR0			equ	VBXE_BASE+$41	; Write
    16 = 0041			VBXE_MINOR				equ	VBXE_BASE+$41	; Read
    17 = 0042			VBXE_XDL_ADR1			equ	VBXE_BASE+$42
    18 = 0043			VBXE_XDL_ADR2			equ	VBXE_BASE+$43
    19 = 0044			VBXE_CSEL				equ	VBXE_BASE+$44
    20 = 0045			VBXE_PSEL				equ	VBXE_BASE+$45
    21 = 0046			VBXE_CR					equ	VBXE_BASE+$46
    22 = 0047			VBXE_CG					equ	VBXE_BASE+$47
    23 = 0048			VBXE_CB					equ	VBXE_BASE+$48
    24 = 0049			VBXE_COLMASK			equ	VBXE_BASE+$49
    25 = 004A			VBXE_COLCLR				equ	VBXE_BASE+$4A
    26 = 0050			VBXE_BL_ADR0			equ	VBXE_BASE+$50	; Write
    27 = 0050			VBXE_BLT_COLLISION_CODE	equ	VBXE_BASE+$50	; Read
    28 = 0051			VBXE_BL_ADR1			equ	VBXE_BASE+$51
    29 = 0052			VBXE_BL_ADR2			equ	VBXE_BASE+$52
    30 = 0053			VBXE_BLITTER_START		equ	VBXE_BASE+$53	; Write
    31 = 0053			VBXE_BLITTER_BUSY		equ	VBXE_BASE+$53	; Read
    32 = 0054			VBXE_IRQ_CONTROL		equ	VBXE_BASE+$54	; Write
    33 = 0054			VBXE_IRQ_STATUS			equ	VBXE_BASE+$54	; Read
    34 = 0055			VBXE_P0					equ	VBXE_BASE+$55	; the four OVERLAY PRIORITY registers.  P1-P3
    35 = 0056			VBXE_P1					equ	VBXE_BASE+$56	;   read $55 here until 2026-08-22; they are
    36 = 0057			VBXE_P2					equ	VBXE_BASE+$57	;   four consecutive registers, per Altirra's
    37 = 0058			VBXE_P3					equ	VBXE_BASE+$58	;   vbxe.cpp WriteControl.  Only an active
    38 																	;   ATTRIBUTE MAP uses P0-P3 (a cell's byte 3
    39 																	;   picks one); with the map off it is the
    40 																	;   XDL's OVATT byte 1 that decides.  They
    41 																	;   power up $00 on real hardware and $FF in
    42 																	;   Altirra - write P0 explicitly.
    43 = 005D			VBXE_MB_CTL				equ	VBXE_BASE+$5D
    44 = 005E			VBXE_MA_CTL				equ	VBXE_BASE+$5E
    45 = 005F			VBXE_MA_BSEL			equ	VBXE_BASE+$5F
    46
    47 				/* Renamed to match fx1.26-en
    48 				VBXE_VIDEO_CONTROL		equ	VBXE_BASE+$40	; Write
    49 				VBXE_CORE_VERSION		equ	VBXE_BASE+$40	; Read
    50 				VBXE_XDL_ADR0			equ	VBXE_BASE+$41	; Write
    51 				VBXE_MINOR_REVISION		equ	VBXE_BASE+$41	; Read
    52 				VBXE_XDL_ADR1			equ	VBXE_BASE+$42
    53 				VBXE_XDL_ADR2			equ	VBXE_BASE+$43
    54 				VBXE_CSEL				equ	VBXE_BASE+$44
    55 				VBXE_PSEL				equ	VBXE_BASE+$45
    56 				VBXE_CR					equ	VBXE_BASE+$46
    57 				VBXE_CG					equ	VBXE_BASE+$47
    58 				VBXE_CB					equ	VBXE_BASE+$48
    59 				VBXE_COLMASK			equ	VBXE_BASE+$49
    60 				VBXE_COLCLR				equ	VBXE_BASE+$4A	; Write
    61 				VBXE_COLDETECT			equ	VBXE_BASE+$4A	; Read
    62 				VBXE_BL_ADR0			equ	VBXE_BASE+$50	; Write
    63 				VBXE_BLT_COLLISION_CODE	equ	VBXE_BASE+$50	; Read
    64 				VBXE_BL_ADR1			equ	VBXE_BASE+$51
    65 				VBXE_BL_ADR2			equ	VBXE_BASE+$52
    66 				VBXE_BLITTER_START		equ	VBXE_BASE+$53	; Write
    67 				VBXE_BLITTER_BUSY		equ	VBXE_BASE+$53	; Read
    68 				VBXE_IRQ_CONTROL		equ	VBXE_BASE+$54	; Write
    69 				VBXE_IRQ_STATUS			equ	VBXE_BASE+$54	; Read
    70 				VBXE_P0					equ	VBXE_BASE+$55	; the four OVERLAY PRIORITY registers.  P1-P3
    71 				VBXE_P1					equ	VBXE_BASE+$56	;   read $55 here until 2026-08-22; they are
    72 				VBXE_P2					equ	VBXE_BASE+$57	;   four consecutive registers, per Altirra's
    73 				VBXE_P3					equ	VBXE_BASE+$58	;   vbxe.cpp WriteControl.  Only an active
    74 																	;   ATTRIBUTE MAP uses P0-P3 (a cell's byte 3
    75 																	;   picks one); with the map off it is the
    76 																	;   XDL's OVATT byte 1 that decides.  They
    77 																	;   power up $00 on real hardware and $FF in
    78 																	;   Altirra - write P0 explicitly.
    79 				VBXE_MEMAC_B_CONTROL	equ	VBXE_BASE+$5D
    80 				VBXE_MEMAC_CONTROL		equ	VBXE_BASE+$5E	; Write
    81 				VBXE_MEMAC_CONTROL		equ	VBXE_BASE+$5E	; Read
    82 				VBXE_MEMAC_BANK_SEL		equ	VBXE_BASE+$5F	; Write
    83 				VBXE_MEMAC_BANK_SEL		equ	VBXE_BASE+$5F	; Read
    84 				*/
