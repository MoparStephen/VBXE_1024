   195 				.ifdef	__VBXE_AUTO__
   196 3166 A5 90			lda VBXEBase+1
   197 3168 8D 8A 31			sta SP2_CR1							; SP2_xxN labels equ *-1 to the store's
   198 316B 8D 92 31			sta SP2_CG1							; high-byte position already - no +1
   199 316E 8D 98 31			sta SP2_CB1
   200 3171 8D A0 31			sta SP2_CR2
   201 3174 8D A8 31			sta SP2_CG2
   202 3177 8D B0 31			sta SP2_CB2
   203 317A 8D B8 31			sta SP2_CR3
   204 317D 8D BE 31			sta SP2_CG3
   205 3180 8D C4 31			sta SP2_CB3
   206 3183 A9 00			lda #$00							; Patching above clobbered A - restore it,
   207 				.endif									; tay below needs #$00 to zero the loop index
   208
   209 3185 A8				tay
   210 3186 B1 91		LoadPal1_1 lda (Y_Register),y
   211 3188 8D 46 00			sta.w VBXE_CR						; Set the red component
   212 = 318A			SP2_CR1	equ *-1
   213 318B C8				iny
   214 318C F0 3B			beq OverFlow1						; Since 256 / 3 is not even, we must skip to next section and resume at CG
   215 318E B1 91			lda (Y_Register),y
   216 3190 8D 47 00			sta.w VBXE_CG						; Set the green component
   217 = 3192			SP2_CG1	equ *-1
   218 3193 C8				iny
   219 3194 B1 91			lda (Y_Register),y
   220 3196 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   221 = 3198			SP2_CB1	equ *-1
   222 3199 C8				iny
   223 319A D0 EA			bne LoadPal1_1						; Copy a page
   224 319C B1 91		LoadPal1_2 lda (Y_Register),y
   225 319E 8D 46 00			sta.w VBXE_CR						; Set the red component
   226 = 31A0			SP2_CR2	equ *-1
   227 31A1 C8				iny
   228 31A2 F0 10			beq LoadPal1_3
   229 31A4			LP1_2_G
   230 31A4 B1 91			lda (Y_Register),y
   231 31A6 8D 47 00			sta.w VBXE_CG						; Set the green component
   232 = 31A8			SP2_CG2	equ *-1
   233 31A9 C8				iny
   234 31AA F0 22			beq OverFlow2						; Since 256 / 3 is not even, we must skip to next section and resume at CB
   235 31AC B1 91			lda (Y_Register),y
   236 31AE 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   237 = 31B0			SP2_CB2	equ *-1
   238 31B1 C8				iny
   239 31B2 D0 E8			bne LoadPal1_2						; Copy a page
   240 31B4 B1 91		LoadPal1_3 lda (Y_Register),y
   241 31B6 8D 46 00			sta.w VBXE_CR						; Set the red component
   242 = 31B8			SP2_CR3	equ *-1
   243 31B9 C8				iny
   244 31BA B1 91			lda (Y_Register),y
   245 31BC 8D 47 00			sta.w VBXE_CG						; Set the green component
   246 = 31BE			SP2_CG3	equ *-1
   247 31BF C8				iny
   248 31C0			LP1_3_B
   249 31C0 B1 91			lda (Y_Register),y
   250 31C2 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   251 = 31C4			SP2_CB3	equ *-1
   252 31C5 C8				iny
   253 31C6 D0 EC			bne LoadPal1_3						; Copy a page
   254 31C8 60				rts
