  1926 				;=============================================================================
  1927 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  1928 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  1929 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  1930 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  1931 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  1932 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  1933 				;=============================================================================
  1934
  1935 				;-----------------------------------------------------------------------------
  1936 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  1937 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  1938 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  1939 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  1940 				; off screen.
  1941 				;-----------------------------------------------------------------------------
  1942 578B			Info_Load
  1943 578B A9 25			lda #NFO_BUF_BANK
  1944 578D 85 8E			sta BankIndex
  1945 578F 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  1946 5792 AD 2D 31			lda LoadStatus
  1947 5795 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  1948 5797 20 9B 57			jsr Info_Count_Lines				; sets Nfo_LineCount
  1949 579A			Info_Load_Ret
  1950 579A 60				rts
  1951
  1952 				;-----------------------------------------------------------------------------
  1953 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  1954 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  1955 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  1956 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  1957 				; 160-byte step straddles a bank every ~25 records, handled inline.
  1958 				;-----------------------------------------------------------------------------
  1959 579B			Info_Count_Lines
  1960 579B A9 00			lda #$00
  1961 579D 8D DE 04			sta Nfo_LineCount
  1962 57A0 8D DF 04			sta Nfo_LineCount + $01
  1963 57A3 A9 25			lda #NFO_BUF_BANK
  1964 57A5 8D 50 06			sta Nfo_WalkBank
  1965 57A8 09 80			ora #MEMAC_GLOBAL_ENABLE
  1966 57AA				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 57AA A0 5F			ldy #<VBXE_MA_BSEL
     3 57AC 91 93			sta (VBXEBase),y
Source: ui.asm
  1967 57AE A9 00			lda #<VBXE_WINDOW
  1968 57B0 85 88			sta Ptr_Lo
  1969 57B2 A9 20			lda #>VBXE_WINDOW
  1970 57B4 85 89			sta Ptr_Hi
  1971 57B6			Info_Count_L1
  1972 57B6 A0 00			ldy #$00
  1973 57B8 B1 88			lda (Ptr_Lo),y
  1974 57BA F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  1975 57BC EE DE 04			inc Nfo_LineCount
  1976 57BF AD DE 04			lda Nfo_LineCount
  1977 57C2 C9 7F			cmp #NFO_MAX_LINES
  1978 57C4 B0 24			bcs Info_Count_Done					; hit the record cap
  1979 57C6 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  1980 57C8 18				clc
  1981 57C9 69 A0			adc #TEXT_PITCH
  1982 57CB 85 88			sta Ptr_Lo
  1983 57CD 90 E7			bcc Info_Count_L1
  1984 57CF E6 89			inc Ptr_Hi
  1985 57D1 A5 89			lda Ptr_Hi
  1986 57D3 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  1987 57D5 90 DF			bcc Info_Count_L1
  1988 57D7 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  1989 57D9 85 89			sta Ptr_Hi
  1990 57DB EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  1991 57DE AD 50 06			lda Nfo_WalkBank
  1992 57E1 09 80			ora #MEMAC_GLOBAL_ENABLE
  1993 57E3				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 57E3 A0 5F			ldy #<VBXE_MA_BSEL
     3 57E5 91 93			sta (VBXEBase),y
Source: ui.asm
  1994 57E7 4C B6 57			jmp Info_Count_L1
  1995 57EA			Info_Count_Done
  1996 57EA A9 00			lda #MEMAC_GLOBAL_DISABLE
  1997 57EC				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 57EC A0 5F			ldy #<VBXE_MA_BSEL
     3 57EE 91 93			sta (VBXEBase),y
Source: ui.asm
  1998 57F0 60				rts
