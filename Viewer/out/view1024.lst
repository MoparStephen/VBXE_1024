  2927 6370			Help_Text_2
  2928 6370 01 5D 4D 61 69 6E + 	dta TXT_PEN,UI_PEN_HELPHEAD,c'Main Menu Navigation:',0
  2929 6388 54 68 65 20 61 72 + 	dta c'The arrow keys move the selector (item will be shown in a brighter colour).',0
  2930 63D4 50 72 65 73 73 69 + 	dta c'Pressing Enter makes a selection (scan Subdirectory or Open image).',0
  2931 6418 00				dta 0
  2932 6419 50 72 65 73 73 69 + 	dta c'Pressing S starts a slideshow starting from the selected image.',0
  2933 6459 54 68 65 20 64 69 + 	dta c'The display time for each image is variable from 1 to 30 seconds via < > keys.',0
  2934 64A8 00				dta 0
  2935 64A9 50 72 65 73 73 69 + 	dta c'Pressing D will bring up the Drive Selector.  Use the ',$18,$19,c' arrows and Enter to',0
  2936 64F6 73 63 61 6E 20 61 + 	dta c'scan a different drive (note D: is the directory from which this program was',0
  2937 6543 6C 61 75 6E 63 68 + 	dta c'launched - it does NOT mean D1:)',0
  2938 6564 00				dta 0
  2939 6565 50 72 65 73 73 69 + 	dta c'Pressing P will display the 4 256 colour palettes of the highlighted image.',0
  2940 65B1 49 66 20 6E 6F 20 + 	dta c'If no image is highlighted, the 4 palettes used by the menu will be shown.',0
  2941 65FC 54 6F 70 20 72 6F + 	dta c'Top row displays P0 and P1 while the bottom row displays P2 and P3.',0
  2942 6640 00				dta 0
  2943 6641 50 72 65 73 73 69 + 	dta c'Pressing I will display the conversion report for the highlighted image.',0
  2944 668A 4A 75 6D 70 20 74 + 	dta c'Jump to section 3 of this Help screen for more details on this information.',0
  2945 66D6 00				dta 0
  2946 66D7 50 72 65 73 73 69 + 	dta c'Pressing F will switch between the CGA font and the Atari font',0
  2947 6716 00				dta 0
  2948 6717 50 72 65 73 73 69 + 	dta c"Pressing Q will display the exit confirmation dialog (Y quits, ESC or N doesn't)",0
