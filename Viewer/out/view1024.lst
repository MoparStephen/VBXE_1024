  2096 				; Selector_Handle_P - "P" key: show a 2x2 grid of ramp squares, one per
  2097 				; palette register, zoomed 7x and centered on the image screen (UI_Mode 6,
  2098 				; Esc-only - see Pal_Preview_Keys).
  2099 				;   * on a *.V1K row: "Reading palette..." in row 0, read the .PAL block to
  2100 				;     $21000 with the selector still up; a missing / short file leaves the
  2101 				;     selector up (row 0 restored).  Only once it has loaded is the screen
  2102 				;     (prebuilt at boot by Pal_Preview_Init) swapped in, with the registers
  2103 				;     rewritten under a blanked overlay.
  2104 				;   * on "..", a directory or an empty list: no disk access at all - the
  2105 				;     registers already hold the menu's own palettes 0-3, so just show them.
  2106 				;-----------------------------------------------------------------------------
  2107 5E05			Selector_Handle_P
  2108 5E05 AD 8B 04			lda ImageCount
  2109 5E08 0D 8C 04			ora ImageCount+1
  2110 5E0B F0 35			beq Selector_Handle_P_Menu			; empty list -> the menu palettes
  2111 5E0D AD C7 04			lda Sel_Index
  2112 5E10 20 BB 58			jsr UI_RowType
  2113 5E13 D0 2D			bne Selector_Handle_P_Menu			; dir / ".." -> the menu palettes
  2114
  2115 5E15 AD C7 04			lda Sel_Index
  2116 5E18 8D 8A 04			sta File_Index
