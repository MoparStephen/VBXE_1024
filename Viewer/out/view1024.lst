   313 3A06 A9 00			lda #<WIN_SAVE_VRAM
   314 3A08 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3A0B A9 F0			lda #>WIN_SAVE_VRAM
   316 3A0D 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3A10 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3A12 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3A15 A5 83			lda Reg4
   320 3A17 8D 98 21			sta BLT_TEXT_RECT + Dest_Adr0
   321 3A1A A5 84			lda Reg5
   322 3A1C 18				clc
   323 3A1D 69 30			adc #$30
   324 3A1F 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   325 3A22 A9 02			lda #$02
