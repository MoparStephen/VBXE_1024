    93 3D7A A9 5E			lda #<Text_Font_Data
    94 3D7C 85 88			sta Ptr_Lo
    95 3D7E A9 41			lda #>Text_Font_Data
    96 3D80 85 89			sta Ptr_Hi
    97 3D82 A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3D84 85 80			sta Reg1
    99 3D86 A9 20			lda #>VBXE_WINDOW
   100 3D88 85 81			sta Reg2
   101 3D8A 20 FC 3D			jsr Text_Copy_2K
   102
   103 3D8D A9 5E			lda #<Atari_Font_Data
   104 3D8F 85 88			sta Ptr_Lo
   105 3D91 A9 49			lda #>Atari_Font_Data
   106 3D93 85 89			sta Ptr_Hi
   107 3D95 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3D97 85 80			sta Reg1
   109 3D99 A9 28			lda #>[VBXE_WINDOW + $800]
   110 3D9B 85 81			sta Reg2
   111 3D9D 20 FC 3D			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3DA0 A2 00			ldx #$00
   120 3DA2			Text_Load_Fonts_Remap
   121 3DA2 BD DC 3D			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3DA5 20 CC 3D			jsr Text_Glyph_Addr
   123 3DA8 85 88			sta Ptr_Lo
   124 3DAA 84 89			sty Ptr_Hi
   125 3DAC BD DD 3D			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3DAF 20 CC 3D			jsr Text_Glyph_Addr
   127 3DB2 85 80			sta Reg1
   128 3DB4 84 81			sty Reg2
   129 3DB6 A0 07			ldy #$07
   130 3DB8			Text_Load_Fonts_Glyph
   131 3DB8 B1 88			lda (Ptr_Lo),y
   132 3DBA 91 80			sta (Reg1),y
   133 3DBC 88				dey
   134 3DBD 10 F9			bpl Text_Load_Fonts_Glyph
   135 3DBF E8				inx
   136 3DC0 E8				inx
   137 3DC1 E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3DC3 D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3DC5 A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3DC7				vbsta VBXE_MA_BSEL
