  2753 				;=============================================================================
  2754 				; Shared directory helpers
  2755 				;-----------------------------------------------------------------------------
  2756 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2757 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2758 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2759 				; navigation lives in the selector itself.
  2760 				;=============================================================================
  2761
  2762 				;-----------------------------------------------------------------------------
  2763 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2764 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2765 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2766 				;-----------------------------------------------------------------------------
  2767 61DF			Line_Has_Dir_Tag
  2768 61DF A2 00			ldx #$00
  2769 61E1			Line_Has_Dir_Tag_L1
  2770 61E1 BD 00 06			lda Dir_Line_Buf,x
  2771 61E4 C9 3C			cmp #'<'
  2772 61E6 D0 1F			bne Line_Has_Dir_Tag_Next
  2773 61E8 BD 01 06			lda Dir_Line_Buf+1,x
  2774 61EB C9 44			cmp #'D'
  2775 61ED D0 18			bne Line_Has_Dir_Tag_Next
  2776 61EF BD 02 06			lda Dir_Line_Buf+2,x
  2777 61F2 C9 49			cmp #'I'
  2778 61F4 D0 11			bne Line_Has_Dir_Tag_Next
  2779 61F6 BD 03 06			lda Dir_Line_Buf+3,x
  2780 61F9 C9 52			cmp #'R'
  2781 61FB D0 0A			bne Line_Has_Dir_Tag_Next
  2782 61FD BD 04 06			lda Dir_Line_Buf+4,x
  2783 6200 C9 3E			cmp #'>'
  2784 6202 D0 03			bne Line_Has_Dir_Tag_Next
  2785 6204 A9 01			lda #$01							; found
  2786 6206 60				rts
  2787 6207			Line_Has_Dir_Tag_Next
  2788 6207 E8				inx
  2789 6208 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2790 620A 90 D5			bcc Line_Has_Dir_Tag_L1
  2791 620C A9 00			lda #$00							; not found
  2792 620E 60				rts
  2793
  2794 				;-----------------------------------------------------------------------------
  2795 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2796 				; space-padded).  Refuses if the result would not fit.
  2797 				;-----------------------------------------------------------------------------
