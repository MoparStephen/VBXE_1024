   954 5148 8E C5 04			stx Dir_IOCB
   955 514B A9 04			lda #CIO_read						; AUX1 = 4 : plain file, read
   956 514D 9D 4A 03			sta ICAX1,x
   957 5150 A9 00			lda #$00
   958 5152 9D 4B 03			sta ICAX2,x
   959 5155 A9 50			lda #<Scan_Spec
   960 5157 9D 44 03			sta ICBAL,x
   961 515A A9 06			lda #>Scan_Spec
   962 515C 9D 45 03			sta ICBAH,x
   963 515F A9 03			lda #CIO_open
   964 5161 9D 42 03			sta ICCOM,x
   965 5164 20 56 E4			jsr CIOV
   966 5167 30 58			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
   967
   968 5169			Nfo_Name_LoadManifest_Line
   969 5169 AE C5 04			ldx Dir_IOCB
   970 516C A9 05			lda #CIO_gettext
   971 516E 9D 42 03			sta ICCOM,x
   972 5171 A9 B7			lda #<Nfo_Name_Line
   973 5173 9D 44 03			sta ICBAL,x
   974 5176 A9 06			lda #>Nfo_Name_Line
   975 5178 9D 45 03			sta ICBAH,x
   976 517B A9 3A			lda #58								; buffer length (8 key + 48 name + $9B, rounded)
   977 517D 9D 48 03			sta ICBLL,x
   978 5180 A9 00			lda #$00
   979 5182 9D 49 03			sta ICBLH,x
   980 5185 20 56 E4			jsr CIOV
   981 5188 30 2C			bmi Nfo_Name_LoadManifest_Close		; EOF / error / record over 58 bytes
   982
   983 518A 20 C2 51			jsr Nfo_Name_Match					; key = Nfo_Name_Line[0..7]  -> A = ordinal
