  2203 5EB4 20 1D 3C			jsr Build_Filename					; FileNamePtr -> "D[n]:PATH<base>.NFO",0
  2204 5EB7 20 A1 60			jsr Info_Load						; stream into NFO_BUF_VRAM, count records
  2205 5EBA AD 2D 31			lda LoadStatus
  2206 5EBD D0 03			bne Selector_Handle_I_Show
  2207 5EBF 4C 06 55			jmp Selector_Restore_LocRow			; OPEN failed (no .nfo) - selector stays up (tail)
  2208 5EC2			Selector_Handle_I_Show
