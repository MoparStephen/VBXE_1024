  1941 58C2 A9 3C			lda #60
  1942 58C4			Slideshow_Reload_Set
  1943 58C4 85 80			sta Reg1							; Reg1 = frames to add per second
  1944 58C6			Slideshow_Reload_L1
  1945 58C6 18				clc
  1946 58C7 AD CA 04			lda Slide_FrameCtr
  1947 58CA 65 80			adc Reg1
