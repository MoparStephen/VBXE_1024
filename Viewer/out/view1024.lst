   904 				;-----------------------------------------------------------------------------
   905 				; Nfo_Name_Emit - the slot Nfo_Name_MapSlot just mapped (at Ptr_Lo/Hi) in.
   906 				; Leaves Nfo_Name_Line[0..NFO_NAME_CAP-1] = the name (or all spaces if the
   907 				; slot byte 0 is < $21, i.e. "no name") + Nfo_Name_Line[NFO_NAME_CAP] = $00.
   908 				; Window unmapped on return.
   909 				;-----------------------------------------------------------------------------
   910 52F5			Nfo_Name_Emit
   911 52F5 A0 00			ldy #$00
   912 52F7 B1 88			lda (Ptr_Lo),y
   913 52F9 C9 21			cmp #$21
   914 52FB 90 0E			bcc Nfo_Name_Emit_Pad				; $00 -> all spaces
   915 52FD			Nfo_Name_Emit_Copy
   916 52FD B1 88			lda (Ptr_Lo),y
   917 52FF F0 0A			beq Nfo_Name_Emit_Pad
   918 5301 99 50 06			sta Nfo_Name_Line,y
   919 5304 C8				iny
   920 5305 C0 4B			cpy #NFO_NAME_CAP
   921 5307 90 F4			bcc Nfo_Name_Emit_Copy
   922 5309 B0 0C			bcs Nfo_Name_Emit_Term
   923 530B			Nfo_Name_Emit_Pad
   924 530B A9 20			lda #$20
   925 530D			Nfo_Name_Emit_PadL
   926 530D C0 4B			cpy #NFO_NAME_CAP
   927 530F B0 06			bcs Nfo_Name_Emit_Term
   928 5311 99 50 06			sta Nfo_Name_Line,y
