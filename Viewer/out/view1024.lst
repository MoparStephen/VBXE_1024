  2314 5AF8 E8				inx									; keep this separator
  2315 5AF9			Path_Pop_Cut
  2316 5AF9 A9 00			lda #$00
  2317 5AFB 9D 28 06			sta Scan_Path,x
  2318 5AFE			Path_Pop_Done
  2319 5AFE 60				rts
