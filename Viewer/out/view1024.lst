  2886 630C			Path_Save_Clr
  2887 630C 99 EC 04			sta Up_Name,y
  2888 630F 88				dey
  2889 6310 10 FA			bpl Path_Save_Clr
  2890 6312 A2 00			ldx #$00
  2891 6314			Path_Save_End
  2892 6314 BD 28 06			lda Scan_Path,x
  2893 6317 F0 05			beq Path_Save_Found
  2894 6319 E8				inx
  2895 631A E0 28			cpx #$28
