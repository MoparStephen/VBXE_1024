   284 				;-----------------------------------------------------------------------------
   285 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   286 				; cells between the text screen and WIN_SAVE_VRAM (a save-under buffer held at
   287 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   288 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   289 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   290 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   291 				; caller can Save then Frame on the same geometry.)
   292 				;-----------------------------------------------------------------------------
   293 3BC5			Text_Window_Save
   294 3BC5 20 13 3C			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   295 3BC8 A5 83			lda Reg4
   296 3BCA 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   297 3BCD A5 84			lda Reg5
   298 3BCF 18				clc
   299 3BD0 69 30			adc #$30							; low 16 bits of TEXT_SCREEN_VRAM = $3000
   300 3BD2 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   301 3BD5 A9 02			lda #$02
   302 3BD7 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   303 3BDA A9 00			lda #<WIN_SAVE_VRAM
   304 3BDC 8D 98 21			sta BLT_TEXT_RECT + Dest_Adr0
   305 3BDF A9 F0			lda #>WIN_SAVE_VRAM
   306 3BE1 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   307 3BE4 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 3BE6 8D 9A 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3BE9 4C 53 3C			jmp Text_Window_Kick
   310
   311 3BEC			Text_Window_Restore
   312 3BEC 20 13 3C			jsr Text_Window_Setup
   313 3BEF A9 00			lda #<WIN_SAVE_VRAM
   314 3BF1 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3BF4 A9 F0			lda #>WIN_SAVE_VRAM
   316 3BF6 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3BF9 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3BFB 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3BFE A5 83			lda Reg4
   320 3C00 8D 98 21			sta BLT_TEXT_RECT + Dest_Adr0
   321 3C03 A5 84			lda Reg5
   322 3C05 18				clc
   323 3C06 69 30			adc #$30
   324 3C08 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   325 3C0B A9 02			lda #$02
