  1530 				;-----------------------------------------------------------------------------
  1531 				; Sort_Range - in-place alphabetical selection sort of the records
  1532 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1533 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1534 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1535 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1536 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1537 				;-----------------------------------------------------------------------------
  1538 39A7			Sort_Range
  1539 39A7 E0 02			cpx #$02
  1540 39A9 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1541 39AB 85 81			sta Reg2							; Reg2 = i = start
  1542 39AD 86 82			stx Reg3							; Reg3 = count (temp)
  1543 39AF 18				clc
  1544 39B0 65 82			adc Reg3
  1545 39B2 85 84			sta Reg5							; Reg5 = end = start + count
  1546 39B4 38				sec
  1547 39B5 E9 01			sbc #$01
  1548 39B7 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1549
  1550 39B9 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1551 39BB				vbsta VBXE_MA_BSEL
