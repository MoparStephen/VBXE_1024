   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3F5F			Text_Window_Save
   393 3F5F 20 B2 3F			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3F62 A5 83			lda Reg4
   395 3F64 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3F67 A5 84			lda Reg5
   397 3F69 18				clc
   398 3F6A 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3F6C 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3F6F A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3F71 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3F74 A9 00			lda #<WIN_SAVE_VRAM
   403 3F76 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3F79 A9 F0			lda #>WIN_SAVE_VRAM
   405 3F7B 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3F7E A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3F80 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3F83 4C F2 3F			jmp Text_Window_Kick
   409
   410 3F86			Text_Window_Restore
   411 3F86 A9 01			lda #$01
   412 3F88 8D B7 06			sta Txt_Dirty
   413 3F8B 20 B2 3F			jsr Text_Window_Setup
   414 3F8E A9 00			lda #<WIN_SAVE_VRAM
   415 3F90 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3F93 A9 F0			lda #>WIN_SAVE_VRAM
   417 3F95 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3F98 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3F9A 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3F9D A5 83			lda Reg4
   421 3F9F 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3FA2 A5 84			lda Reg5
   423 3FA4 18				clc
   424 3FA5 69 A0			adc #>TEXT_BACK_VRAM
   425 3FA7 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3FAA A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3FAC 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3FAF 4C F2 3F			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3FB2			Text_Window_Setup
   433 3FB2 A9 00			lda #$00
