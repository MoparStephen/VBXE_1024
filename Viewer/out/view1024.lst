  1769 				; Sort_Range - in-place alphabetical selection sort of the records
  1770 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1771 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1772 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1773 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1774 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1775 				;-----------------------------------------------------------------------------
  1776 3BE6			Sort_Range
  1777 3BE6 E0 02			cpx #$02
  1778 3BE8 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1779 3BEA 85 81			sta Reg2							; Reg2 = i = start
  1780 3BEC 86 82			stx Reg3							; Reg3 = count (temp)
  1781 3BEE 18				clc
  1782 3BEF 65 82			adc Reg3
  1783 3BF1 85 84			sta Reg5							; Reg5 = end = start + count
  1784 3BF3 38				sec
  1785 3BF4 E9 01			sbc #$01
  1786 3BF6 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1787
  1788 3BF8 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1789 3BFA				vbsta VBXE_MA_BSEL
