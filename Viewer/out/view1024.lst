  1371 				; Sel_Key_Down/Up/Left/Right - each validates and clamps the move, then hands
  1372 				; the new index to Sel_Nav_Apply.  Because the list is one flat, row-major
  1373 				; array, Left/Right wrapping across a row boundary needs no extra logic -
  1374 				; it's just Sel_Index +/- 1.
  1375 55C2			Sel_Key_Down
  1376 55C2 AD 8B 04			lda ImageCount
  1377 55C5 0D 8C 04			ora ImageCount+1
  1378 55C8 F0 61			beq Sel_Key_Nav_Done				; empty list
  1379 55CA AD C7 04			lda Sel_Index
  1380 55CD 18				clc
  1381 55CE 69 08			adc #UI_COLS
  1382 55D0 CD 8B 04			cmp ImageCount
  1383 55D3 B0 56			bcs Sel_Key_Nav_Done				; no cell directly below - clamp
  1384 55D5 4C 05 56			jmp Sel_Nav_Apply
  1385
  1386 55D8			Sel_Key_Up
  1387 55D8 AD C7 04			lda Sel_Index
  1388 55DB C9 08			cmp #UI_COLS
  1389 55DD 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1390 55DF 38				sec
  1391 55E0 E9 08			sbc #UI_COLS
  1392 55E2 4C 05 56			jmp Sel_Nav_Apply
  1393
  1394 55E5			Sel_Key_Left
  1395 55E5 AD C7 04			lda Sel_Index
  1396 55E8 F0 41			beq Sel_Key_Nav_Done				; already at the first item
  1397 55EA 38				sec
  1398 55EB E9 01			sbc #$01
  1399 55ED 4C 05 56			jmp Sel_Nav_Apply
