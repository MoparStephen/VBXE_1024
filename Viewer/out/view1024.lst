   537 3ABA E6 89			inc Ptr_Hi
   538 3ABC			Text_PutStrAt_NoPage
   539 3ABC A5 89			lda Ptr_Hi
   540 3ABE C9 30			cmp #$30							; crossed out of the window -> next bank
