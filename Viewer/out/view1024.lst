  1614 				;-----------------------------------------------------------------------------
  1615 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1616 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1617 				; crosses the visible window, else just re-colours the old and new cells;
  1618 				; always repaints the status line, then returns to the key loop.
  1619 				;-----------------------------------------------------------------------------
  1620 5816			Sel_Nav_Apply
  1621 5816 48				pha									; stash the new index
  1622 5817 AD C7 04			lda Sel_Index
  1623 581A 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1624 581C 68				pla
  1625 581D 8D C7 04			sta Sel_Index
  1626 5820 20 42 58			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1627 5823 CD C8 04			cmp Sel_Top
  1628 5826 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1629 5828 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1630 582B 20 69 52			jsr Selector_DrawList
  1631 582E 4C 3C 58			jmp Sel_Key_Nav_Done
  1632 5831			Sel_Nav_Apply_Rows
  1633 5831 A5 87			lda Reg8
  1634 5833 20 0D 53			jsr Selector_HiRow					; un-highlight the cell we left
  1635 5836 AD C7 04			lda Sel_Index
  1636 5839 20 0D 53			jsr Selector_HiRow					; highlight the cell we moved to
  1637 583C			Sel_Key_Nav_Done
  1638 583C 20 41 54			jsr Selector_DrawStatus				; row 20: description of the new row
  1639 583F 4C AB 38			jmp Read_Key_Done
  1640
  1641 				;-----------------------------------------------------------------------------
  1642 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1643 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1644 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1645 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1646 				;-----------------------------------------------------------------------------
  1647 5842			Sel_Top_For_Index
  1648 5842 4A				lsr
  1649 5843 4A				lsr
  1650 5844 4A				lsr
