   363 3355			blit_clear
   364 					; clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
   365 					; 496x16 zoom 8x8 clear blit (this takes 2 frames)
   366
   367 					;	dta e($00000)	; Source address
   368 					;	dta a($0000)	; Source step y
   369 					;	dta 0			; Source step x
   370 					;	dta e($7BFFF)	; Destination address
   371 					;	dta a(-$0F80)	; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
   372 					;	dta -1			; Destination step x (backwards	1 byte)
   373 					;	dta a($01EF)	; Width-1  (495)	496 * 8 bytes wide
   374 					;	dta $0F			; Height-1 (15)		 16 * 8 bytes high
   375 					;	dta $00			; And mask (And mask equal to 0 so clear)
   376 					;	dta $00			; Xor mask (will be filled with xor mask)
   377 					;	dta $00			; Collision and mask
   378 					;	dta $77			; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
   379 					;	dta $00			; Pattern feature
   380 					;	dta $00			; Control (Mode 0 with NEXT bit Cleared)
   381
   382 3355 00 00 00 00 00 00 + 	dta e($00000), a($0000), 0, e($7BFFF), a(-$0F80), -1, a($01EF), $0F, $00, $00, $00, $77, $00, $00
