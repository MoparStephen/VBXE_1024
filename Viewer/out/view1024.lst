   110 				;-----------------------------------------------------------------------------
   111 				; Macro definitions for VBXE
   112 				;-----------------------------------------------------------------------------
   113
   114 				;-----------------------------------------------------------------------------
   115 				;vblda	- loads accumulator with VBXE register value
   116 				;	  use:	vblda	VBXE_REGISTER
   117
   118 				; NOTE (__VBXE_AUTO__ mode only): VBXE_BASE is $0000 in this mode, so every
   119 				; VBXE_xxx equate is already just its register offset ($40-$5F). VBXEBase is
   120 				; set ONCE by VBXE_Detect (lo=$00, hi=$D6/$D7), so indexing through it costs
   121 				; a flat 8 cycles/access regardless of which page VBXE lives on - no per-call
   122 				; self-modifying code. This clobbers Y - callers must not rely on Y surviving
   123 				; a vblda/vbsta call in auto mode.
   124 				vblda	.macro
   125 				.ifdef	__VBXE_AUTO__
   126 					ldy #<:1
   127 					lda (VBXEBase),y
   128 				.else
   129 					lda :1
   130 				.endif
   131 				.endm
   132
   133 				;-----------------------------------------------------------------------------
   134 				;vbsta	- stores accumulator in VBXE register
   135 				;	  use:	vbvbsta	VBXE_REGISTER
   136
   137 				vbsta	.macro
   138 				.ifdef	__VBXE_AUTO__
   139 					ldy #<:1
   140 					sta (VBXEBase),y
   141 				.else
   142 					sta.w :1
   143 				.endif
   144 				.endm
