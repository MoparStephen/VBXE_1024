  1418 534D 48				pha									; stash the new index
  1419 534E AD C7 04			lda Sel_Index
  1420 5351 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1421 5353 68				pla
  1422 5354 8D C7 04			sta Sel_Index
