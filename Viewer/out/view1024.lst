  1206 				; UI_Format_Row - A = row type (from UI_RowType).  Rewrites Name_Row_Buf (which
  1207 				; holds the raw 8-byte record from UI_ReadRec) as a fixed 10-char space-padded
  1208 				; field + NUL:  file -> "NAME    " ; dir -> "<NAME....>" ; ".." -> ".."  .
