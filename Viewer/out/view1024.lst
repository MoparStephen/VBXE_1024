   462 				;-----------------------------------------------------------------------------
   463 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   464 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row).  Tracks bank + window
   465 				; offset explicitly (a row near the bottom straddles the $24000 boundary).
   466 				;-----------------------------------------------------------------------------
   467 3C29			Text_PutStrAt
   468 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   469 3C29 A9 00			lda #$00
   470 3C2B 85 80			sta Reg1
   471 3C2D 85 81			sta Reg2
   472 3C2F AE B0 06			ldx Txt_Row
   473 3C32 F0 0E			beq Text_PutStrAt_Col
   474 3C34			Text_PutStrAt_RowL
   475 3C34 A5 80			lda Reg1
   476 3C36 18				clc
   477 3C37 69 A0			adc #TEXT_PITCH
   478 3C39 85 80			sta Reg1
   479 3C3B 90 02			bcc Text_PutStrAt_RowNC
   480 3C3D E6 81			inc Reg2
   481 3C3F			Text_PutStrAt_RowNC
   482 3C3F CA				dex
   483 3C40 D0 F2			bne Text_PutStrAt_RowL
   484 3C42			Text_PutStrAt_Col
   485 3C42 AD B1 06			lda Txt_Col
   486 3C45 0A				asl									; Txt_Col * 2 (max 158)
   487 3C46 18				clc
   488 3C47 65 80			adc Reg1
   489 3C49 85 80			sta Reg1
   490 3C4B 90 02			bcc Text_PutStrAt_ColNC
   491 3C4D E6 81			inc Reg2
   492 3C4F			Text_PutStrAt_ColNC
   493 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   494 3C4F A5 81			lda Reg2
   495 3C51 29 10			and #$10							; offset bit 12 = "second bank"
   496 3C53 F0 04			beq Text_PutStrAt_Bank0
   497 3C55 A9 24			lda #TEXT_SCREEN_BANK+1
   498 3C57 D0 02			bne Text_PutStrAt_SetBank
   499 3C59			Text_PutStrAt_Bank0
   500 3C59 A9 23			lda #TEXT_SCREEN_BANK
   501 3C5B			Text_PutStrAt_SetBank
   502 3C5B 8D B6 06			sta Txt_Bank
   503 3C5E A5 80			lda Reg1
   504 3C60 85 88			sta Ptr_Lo
   505 3C62 A5 81			lda Reg2
   506 3C64 29 0F			and #$0F
   507 3C66 18				clc
   508 3C67 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   509 3C69 85 89			sta Ptr_Hi
   510 3C6B AD B6 06			lda Txt_Bank
   511 3C6E 09 80			ora #MEMAC_GLOBAL_ENABLE
   512 3C70				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3C70 A0 5F			ldy #<VBXE_MA_BSEL
     3 3C72 91 93			sta (VBXEBase),y
Source: text80.asm
   513 				; --- write the cells -------------------------------------------------------
   514 3C74 A9 00			lda #$00
   515 3C76 85 82			sta Reg3							; Reg3 = source string index
   516 3C78 AD B1 06			lda Txt_Col
   517 3C7B 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   518 3C7D			Text_PutStrAt_Char
   519 3C7D A5 83			lda Reg4
   520 3C7F C9 50			cmp #TEXT_COLS
   521 3C81 B0 39			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   522 3C83 A4 82			ldy Reg3
   523 3C85 B1 96			lda (Txt_Ptr),y
   524 3C87 F0 33			beq Text_PutStrAt_Done
   525 3C89 A0 00			ldy #$00
   526 3C8B 91 88			sta (Ptr_Lo),y						; glyph byte
   527 3C8D C8				iny
   528 3C8E AD B4 06			lda Txt_Attr
   529 3C91 91 88			sta (Ptr_Lo),y						; attribute byte
   530 3C93 E6 82			inc Reg3
   531 3C95 E6 83			inc Reg4
   532 3C97 A5 88			lda Ptr_Lo							; window pointer += 2
   533 3C99 18				clc
   534 3C9A 69 02			adc #$02
   535 3C9C 85 88			sta Ptr_Lo
   536 3C9E 90 02			bcc Text_PutStrAt_NoPage
   537 3CA0 E6 89			inc Ptr_Hi
   538 3CA2			Text_PutStrAt_NoPage
   539 3CA2 A5 89			lda Ptr_Hi
   540 3CA4 C9 30			cmp #$30							; crossed out of the window -> next bank
   541 3CA6 90 D5			bcc Text_PutStrAt_Char
   542 3CA8 38				sec
   543 3CA9 E9 10			sbc #$10
   544 3CAB 85 89			sta Ptr_Hi							; wrap back to $20xx
   545 3CAD EE B6 06			inc Txt_Bank
   546 3CB0 AD B6 06			lda Txt_Bank
   547 3CB3 09 80			ora #MEMAC_GLOBAL_ENABLE
   548 3CB5				vbsta VBXE_MA_BSEL
