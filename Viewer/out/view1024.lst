   226 3427 8D E4 02			sta RAMSIZ							; Set RAMSIZ also
   227
   228 342A A2 00			ldx #$00							; Channel #0
   229 342C A9 04			lda #$04							; 4 = OPEN_READ
   230 342E			Do_CIOV
