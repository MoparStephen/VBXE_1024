   174 21AB 10 00			dta $10,$00							; Source step y = 16
   175 21AD 01				dta $01								; Source step x (1)
   176 21AE 00 00 00			dta $00,$00,$00						; Destination address (PATCHED per kick)
   177 21B1 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320)
   178 21B3 01				dta $01								; Destination step x (1)
   179 21B4 0F 00			dta $0F,$00							; Width-1 = 15 (16 bytes wide)
   180 21B6 0F				dta $0F								; Height-1 = 15 (16 rows)
   181 21B7 FF				dta $FF								; And mask (straight copy)
   182 21B8 00				dta $00								; Xor mask
   183 21B9 00				dta $00								; Collision mask
   184 21BA 00				dta $00								; Zoom
   185 21BB 00				dta $00								; Pattern feature
   186 21BC 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
