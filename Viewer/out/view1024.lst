  1343 				;-----------------------------------------------------------------------------
  1344 				; Increment_Image - advance File_Index within the *.V1K file band
  1345 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1346 				; No-op when the list holds no files.  (The selector list may now also carry
  1347 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1348 				;-----------------------------------------------------------------------------
  1349 3859			Increment_Image
  1350 3859 AD DA 04			lda FileStart
  1351 385C CD 8B 04			cmp ImageCount
  1352 385F B0 12			bcs Increment_Image_Done			; no *.V1K files in the list
  1353 3861 AE 8A 04			ldx File_Index
  1354 3864 E8				inx
  1355 3865 EC 8B 04			cpx ImageCount
  1356 3868 90 03			bcc Increment_Image_Store
  1357 386A AE DA 04			ldx FileStart						; wrap past the last file to the first
  1358 386D			Increment_Image_Store
  1359 386D 8E 8A 04			stx File_Index
  1360 3870 20 12 34			jsr Load_Image
  1361 3873			Increment_Image_Done
  1362 3873 60				rts
  1363
  1364 				;-----------------------------------------------------------------------------
  1365 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1366 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1367 				;-----------------------------------------------------------------------------
  1368 3874			Decrement_Image
  1369 3874 AD DA 04			lda FileStart
  1370 3877 CD 8B 04			cmp ImageCount
  1371 387A B0 12			bcs Decrement_Image_Done
  1372 387C AE 8A 04			ldx File_Index
  1373 387F EC DA 04			cpx FileStart
  1374 3882 D0 03			bne Decrement_Image_Step
  1375 3884 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1376 3887			Decrement_Image_Step
  1377 3887 CA				dex
  1378 3888 8E 8A 04			stx File_Index
  1379 388B 20 12 34			jsr Load_Image
  1380 388E			Decrement_Image_Done
  1381 388E 60				rts
