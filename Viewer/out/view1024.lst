  2429 5C97			InfK_1a
  2430 5C97 C9 06			cmp #KEY_LEFT						; Left/Right page ("LR Page" on the footer)
  2431 5C99 D0 03			bne InfK_1b
  2432 5C9B 4C E5 5C			jmp Info_Key_PageUp
  2433 5C9E			InfK_1b
  2434 5C9E C9 07			cmp #KEY_RIGHT
  2435 5CA0 D0 03			bne InfK_2
  2436 5CA2 4C 03 5D			jmp Info_Key_PageDown
  2437 5CA5			InfK_2
  2438 5CA5 AD FC 02			lda CH								; raw CH for the non-arrow keys
  2439 5CA8			InfK_4							; Q does not quit here - Selector only
  2440 5CA8 C9 1C			cmp #KEY_ESC
  2441 5CAA F0 07			beq Info_Key_Leave
  2442 5CAC C9 0D			cmp #KEY_I
  2443 5CAE F0 03			beq Info_Key_Leave
  2444 5CB0 4C 6B 38			jmp Read_Key_Done
  2445 5CB3			Info_Key_Leave
  2446 5CB3 20 4C 50			jsr Enter_Selector
  2447 5CB6 4C 6B 38			jmp Read_Key_Done
  2448
  2449 5CB9			Info_Key_Up
  2450 5CB9 AD DC 04			lda Nfo_Top
  2451 5CBC 0D DD 04			ora Nfo_Top + $01
  2452 5CBF F0 0E			beq Info_Key_RKD					; already at the top
  2453 5CC1 AD DC 04			lda Nfo_Top
  2454 5CC4 D0 03			bne Info_Key_Up_NB
  2455 5CC6 CE DD 04			dec Nfo_Top + $01
  2456 5CC9			Info_Key_Up_NB
  2457 5CC9 CE DC 04			dec Nfo_Top
  2458 5CCC 20 D6 5B			jsr Info_Draw
  2459 5CCF			Info_Key_RKD
  2460 5CCF 4C 6B 38			jmp Read_Key_Done
  2461
  2462 5CD2			Info_Key_Down
  2463 5CD2 20 65 5C			jsr Info_Can_Scroll_Down
  2464 5CD5 90 F8			bcc Info_Key_RKD
  2465 5CD7 EE DC 04			inc Nfo_Top
  2466 5CDA D0 03			bne Info_Key_Down_NC
  2467 5CDC EE DD 04			inc Nfo_Top + $01
  2468 5CDF			Info_Key_Down_NC
  2469 5CDF 20 D6 5B			jsr Info_Draw
  2470 5CE2 4C 6B 38			jmp Read_Key_Done
  2471
  2472 5CE5			Info_Key_PageUp
  2473 5CE5 A2 14			ldx #NFO_VISROWS
  2474 5CE7			Info_Key_PageUp_L1
  2475 5CE7 AD DC 04			lda Nfo_Top
  2476 5CEA 0D DD 04			ora Nfo_Top + $01
  2477 5CED F0 0E			beq Info_Key_PageUp_Draw
  2478 5CEF AD DC 04			lda Nfo_Top
  2479 5CF2 D0 03			bne Info_Key_PageUp_NB
  2480 5CF4 CE DD 04			dec Nfo_Top + $01
  2481 5CF7			Info_Key_PageUp_NB
  2482 5CF7 CE DC 04			dec Nfo_Top
  2483 5CFA CA				dex
  2484 5CFB D0 EA			bne Info_Key_PageUp_L1
  2485 5CFD			Info_Key_PageUp_Draw
  2486 5CFD 20 D6 5B			jsr Info_Draw
  2487 5D00 4C 6B 38			jmp Read_Key_Done
  2488
  2489 5D03			Info_Key_PageDown
  2490 5D03 A2 14			ldx #NFO_VISROWS
  2491 5D05			Info_Key_PageDown_L1
  2492 5D05 20 65 5C			jsr Info_Can_Scroll_Down
  2493 5D08 90 0B			bcc Info_Key_PageDown_Draw
  2494 5D0A EE DC 04			inc Nfo_Top
  2495 5D0D D0 03			bne Info_Key_PageDown_NC
  2496 5D0F EE DD 04			inc Nfo_Top + $01
  2497 5D12			Info_Key_PageDown_NC
  2498 5D12 CA				dex
  2499 5D13 D0 F0			bne Info_Key_PageDown_L1
  2500 5D15			Info_Key_PageDown_Draw
  2501 5D15 20 D6 5B			jsr Info_Draw
  2502 5D18 4C 6B 38			jmp Read_Key_Done
