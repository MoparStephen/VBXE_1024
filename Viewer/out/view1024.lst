   734 				;-----------------------------------------------------------------------------
   735 				; Load_Image
   736 				; File_Index must be set before calling this!  No range checking is done!
   737 				; One OPEN of D:<name>.V1K, three sequential block reads:
   738 				;   .PAL block -> $21000, pushed to palette registers 0-3
   739 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   740 				;   .RAW block -> $01000 framebuffer
   741 				; A missing or short file stops at the failing block and closes the IOCB.
   742 				;-----------------------------------------------------------------------------
   743 354C			Load_Image
   744 354C A9 00			lda #$00							; ext 0 = .V1K
   745 354E 20 9E 3B			jsr Build_Filename
   746 3551 20 A0 35			jsr Image_Open
   747 3554 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   748
   749 3556 20 8F 35			jsr Image_Read_Pal
   750 3559 B0 2A			bcs Load_Image_Close
   751 355B 20 0C 35			jsr Apply_Image_Palette
   752
   753 355E A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   754 3560 A2 02			ldx #V1K_MAP_LEN / $1000
   755 3562 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   756 3564 8C E5 04			sty Seg_Tail
   757 3567 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   758 3569 8C E6 04			sty Seg_Tail + $01
   759 356C 20 D1 35			jsr Image_Read_Segment
   760 356F B0 14			bcs Load_Image_Close
   761 3571 20 91 34			jsr Setup_Cmap1						; Expand the data out to $17000
   762
   763 3574 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   764 3576 A2 12			ldx #V1K_RAW_LEN / $1000
   765 3578 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   766 357A 8C E5 04			sty Seg_Tail
   767 357D A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   768 357F 8C E6 04			sty Seg_Tail + $01
   769 3582 20 D1 35			jsr Image_Read_Segment
   770
   771 3585			Load_Image_Close
   772 3585 20 2C 36			jsr Image_Close
   773
   774 3588			Load_Image_Done
   775 3588 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   776 358A				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 358A A0 5F			ldy #<VBXE_MA_BSEL
     3 358C 91 93			sta (VBXEBase),y
Source: view1024.asm
