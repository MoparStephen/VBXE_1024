   499 				; SpartaDOS X 40/80-column soft-console control (lives in the always-resident
   500 				; block so Step_1's ini-time call resolves to loaded code)
   501 3281				icl 'sdx_con.asm'
Source: sdx_con.asm
     1 				;-----------------------------------------------------------------------------
     2 				; sdx_con.asm - SpartaDOS X CON: soft-console 40/80-column control
     3 				;-----------------------------------------------------------------------------
     4 				; When the user boots SpartaDOS X with the 64/80-column soft console active
     5 				; (CON.SYS or CON64.SYS - the extended "E:" driver - layered on a base such as
     6 				; S_VBXE.SYS), that console fights a program that drives the VBXE directly.
     7 				;
     8 				; SDX_Console_Save_And_40  - call once at startup. Detects the soft console,
     9 				;                            remembers whether it was in extended mode, and
    10 				;                            drops it to the standard 40-column OS editor.
    11 				; SDX_Console_Restore      - call once just before jmp (DOSVEC). Homes the
    12 				;                            cursor and clears the screen so DOS gets a clean
    13 				;                            editor.  If a soft console was present at startup,
    14 				;                            first put it back in its startup mode and issue
    15 				;                            XIO 32 so it rebuilds its display list, screen
    16 				;                            memory and internal pointers - without that the
    17 				;                            cursor stays dark until a DIR / the BREAK key
    18 				;                            (both of which trigger the same driver rebuild).
    19 				;                            The caller must have restored RAMTOP first.
    20 				;
    21 				; Mechanism - SDX 4.50 Programmer's/User Guide, section 6.9 "Using the CON:
    22 				; Drivers in Own Programs":
    23 				;   XIO 33,#0,12,0,"E:"    - detect. Success (status 1) means CON.SYS/CON64.SYS
    24 				;                            is loaded; the call also returns
    25 				;                              ICAX5 = activity flag ($80 = extended mode on)
    26 				;                              ICAX6 = max columns / function code (64 or 80)
    27 				;                            An error (esp. 146) means no soft console -> no-op.
    28 				;   XIO nc,#0,12,0,"E:"    - nc = the ICAX6 value; AUX2 = 0 disables the
    29 				;                            extended console (back to 40 columns).
    30 				;   XIO nc,#0,12,128,"E:"  - AUX2 = 128 re-enables it.
    31 				;
    32 				; Operates on IOCB #0, which the OS keeps open to E:/CON:. Needs the CIO equates
    33 				; plus ROWCRS/COLCRS/OLDROW/OLDCOL from equates.asm. No other dependencies -
    34 				; safe to icl from any build.
    35 				;-----------------------------------------------------------------------------
    36
    37 = 0000			SDX_CON_IOCB	equ $00						; IOCB #0 - OS editor / CON:
    38 = 0021			SDX_CON_QUERY	equ $21						; XIO 33 - detect / query extension
    39 = 000C			SDX_CON_RW		equ $0C						; AUX1 = read + write
    40 = 0080			SDX_CON_ENABLE	equ $80						; AUX2 value that enables extended mode
    41
    42 3281			.var SDX_Con_Func		.byte				; function code from ICAX6 (64 or 80)
    43 3281			.var SDX_Con_WasExt		.byte				; $80 = extended mode active at startup
    44
    45 				;-----------------------------------------------------------------------------
    46 				; SDX_Console_Save_And_40
    47 				;-----------------------------------------------------------------------------
    48 3281			SDX_Console_Save_And_40
    49 3281 A9 00			lda #$00
    50 3283 8D 3E 33			sta SDX_Con_Func
    51 3286 8D 3F 33			sta SDX_Con_WasExt
    52
    53 3289 A2 00			ldx #SDX_CON_IOCB
    54 328B A9 21			lda #SDX_CON_QUERY
    55 328D 9D 42 03			sta ICCOM,x
    56 3290 A9 3B			lda #<SDX_Con_EDev
    57 3292 9D 44 03			sta ICBAL,x
    58 3295 A9 33			lda #>SDX_Con_EDev
    59 3297 9D 45 03			sta ICBAH,x
    60 329A A9 0C			lda #SDX_CON_RW
    61 329C 9D 4A 03			sta ICAX1,x
    62 329F A9 00			lda #$00
    63 32A1 9D 4B 03			sta ICAX2,x
    64 32A4 20 56 E4			jsr CIOV
    65 32A7 30 22			bmi SDX_Console_Save_Done				; error 146 etc - no soft console
    66
    67 32A9 BD 4F 03			lda ICAX6,x								; max columns / function code
    68 32AC C9 40			cmp #64
    69 32AE F0 04			beq SDX_Console_Save_FuncOK
    70 32B0 C9 50			cmp #80
    71 32B2 D0 17			bne SDX_Console_Save_Done				; unexpected - leave well alone
    72 32B4			SDX_Console_Save_FuncOK
    73 32B4 8D 3E 33			sta SDX_Con_Func
    74
    75 32B7 BD 4E 03			lda ICAX5,x								; activity flag: $80 = extended mode on
    76 32BA 29 80			and #$80
    77 32BC 8D 3F 33			sta SDX_Con_WasExt
    78 32BF F0 0A			beq SDX_Console_Save_Done				; already 40-col - nothing to force
    79
    80 32C1 A9 00			lda #$00								; AUX2 = 0 -> disable extended console
    81 32C3 20 FD 32			jsr SDX_Con_ModeCall
    82 32C6 A9 7D			lda #$7D								; Clear Screen
    83 32C8 20 1A 33			jsr SDX_Con_PutByte
    84 32CB			SDX_Console_Save_Done
    85 32CB 60				rts
    86
    87 				;-----------------------------------------------------------------------------
    88 				; SDX_Console_Restore
    89 				;-----------------------------------------------------------------------------
    90 32CC			SDX_Console_Restore
    91 32CC AD 3E 33			lda SDX_Con_Func						; soft console present at startup?
    92 32CF F0 09			beq SDX_Console_Restore_Clear			; no - just clear the screen for DOS
    93
    94 32D1 AD 3F 33			lda SDX_Con_WasExt						; yes - back to the startup mode (0=40, $80=64/80)
    95 32D4 20 FD 32			jsr SDX_Con_ModeCall
    96
    97 32D7 20 EE 32			jsr SDX_Con_Xio32						; the driver relocates its display list + screen
    98 															;   memory and rebuilds its internal pointers.
    99 															;   This is what a DIR / the BREAK key trigger,
   100 															;   and the only thing that repaints the cursor
   101 															;   after the demo ran (RAMTOP is back by now).
   102
   103 32DA			SDX_Console_Restore_Clear
   104 					; SDX 4.50 User Guide 6.9.3: home the cursor coords, THEN send Clear Screen.
   105 32DA A9 00			lda #$00
   106 32DC 85 54			sta ROWCRS
   107 32DE 85 55			sta COLCRS
   108 32E0 85 56			sta COLCRS+1
   109 32E2 85 5A			sta OLDROW
   110 32E4 85 5B			sta OLDCOL
   111 32E6 85 5C			sta OLDCOL+1
   112 32E8 A9 7D			lda #$7D								; Clear Screen
   113 32EA 20 1A 33			jsr SDX_Con_PutByte
   114 32ED			SDX_Console_Restore_Done
   115 32ED 60				rts
   116
   117 				;-----------------------------------------------------------------------------
   118 				; SDX_Con_Xio32   - XIO 32,#0,12,0,"E:"  - tell the soft console to move its
   119 				;                   display list + screen memory and fix its internal pointers.
   120 				; SDX_Con_ModeCall - XIO <SDX_Con_Func>,#0,12,A,"E:"   A = AUX2 (0 disable
   121 				;                   extended console, 128 enable).  Shares the CIO tail.
   122 				;-----------------------------------------------------------------------------
   123 32EE			SDX_Con_Xio32
   124 32EE A2 00			ldx #SDX_CON_IOCB
   125 32F0 A9 20			lda #$20								; XIO 32
   126 32F2 9D 42 03			sta ICCOM,x
   127 32F5 A9 00			lda #$00
   128 32F7 9D 4B 03			sta ICAX2,x
   129 32FA 4C 08 33			jmp SDX_Con_XioTail
   130
   131 32FD			SDX_Con_ModeCall
   132 32FD A2 00			ldx #SDX_CON_IOCB
   133 32FF 9D 4B 03			sta ICAX2,x
   134 3302 AD 3E 33			lda SDX_Con_Func
   135 3305 9D 42 03			sta ICCOM,x
   136 3308			SDX_Con_XioTail
   137 3308 A9 0C			lda #SDX_CON_RW
   138 330A 9D 4A 03			sta ICAX1,x
   139 330D A9 3B			lda #<SDX_Con_EDev
   140 330F 9D 44 03			sta ICBAL,x
   141 3312 A9 33			lda #>SDX_Con_EDev
   142 3314 9D 45 03			sta ICBAH,x
   143 3317 4C 56 E4			jmp CIOV
   144
   145 				;-----------------------------------------------------------------------------
   146 				; SDX_Con_PutByte - PUT the byte in A to IOCB #0 as a real 1-byte buffer (not
   147 				; the zero-length-outputs-A quirk), so it goes through the soft console's
   148 				; handler the same way it goes through the ROM editor.
   149 				;-----------------------------------------------------------------------------
   150 331A			SDX_Con_PutByte
   151 331A 8D 40 33			sta SDX_Con_OutChar
   152 331D A2 00			ldx #SDX_CON_IOCB
   153 331F A9 0B			lda #$0B								; PUT BYTES
   154 3321 9D 42 03			sta ICCOM,x
   155 3324 A9 40			lda #<SDX_Con_OutChar
   156 3326 9D 44 03			sta ICBAL,x
   157 3329 A9 33			lda #>SDX_Con_OutChar
   158 332B 9D 45 03			sta ICBAH,x
   159 332E A9 01			lda #$01
   160 3330 9D 48 03			sta ICBLL,x
   161 3333 A9 00			lda #$00
   162 3335 9D 49 03			sta ICBLH,x
   163 3338 4C 56 E4			jmp CIOV
   164
   165 333B			SDX_Con_EDev
   166 333B 45 3A 9B			dta c"E:",$9B
   167
   168 333E			.var SDX_Con_OutChar	.byte				; 1-byte PUT buffer for SDX_Con_PutByte
   168 = 333E 00		SDX_CON_FUNC
   168 = 333F 00		SDX_CON_WASEXT
   168 = 3340 00		SDX_CON_OUTCHAR
   502 3341			.endpg
