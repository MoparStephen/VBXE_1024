  1419 5533 48				pha									; stash the new index
  1420 5534 AD C7 04			lda Sel_Index
  1421 5537 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1422 5539 68				pla
  1423 553A 8D C7 04			sta Sel_Index
  1424 553D 20 5F 55			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1425 5540 CD C8 04			cmp Sel_Top
  1426 5543 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1427 5545 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1428 5548 20 36 50			jsr Selector_DrawList
  1429 554B 4C 59 55			jmp Sel_Key_Nav_Done
  1430 554E			Sel_Nav_Apply_Rows
  1431 554E A5 87			lda Reg8
