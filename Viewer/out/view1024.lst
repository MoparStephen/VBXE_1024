  1596 				;-----------------------------------------------------------------------------
  1597 				; Key-5 attribute-map view.  XDL_Image_Attribute (VBXE $00000) has its OVADR
  1598 				; at bytes 3-5; key 5 points it at MAP_FILL_VRAM (all $01 pixels) and gives
  1599 				; entry 1 of palettes 0-3 a distinct colour, so every 8x1 cell shows which
  1600 				; palette it uses.  Leave_Map_View undoes both: OVADR back to the framebuffer
  1601 				; and entry 1 re-read from the .PAL block Load_Image left at $21000.
  1602 				;-----------------------------------------------------------------------------
  1603 3A89			Set_Attr_Source_Fill
  1604 3A89 A2 00			ldx #$00							; key 5: $01 pixels, the image's map
  1605 3A8B F0 06			beq Set_Attr_Source
  1606 3A8D			Set_Attr_Source_Image
  1607 3A8D A2 06			ldx #$06							; the image
  1608 3A8F D0 02			bne Set_Attr_Source
  1609 3A91			Set_Attr_Source_Preview
  1610 3A91 A2 0C			ldx #$0C							; the P key's palette screen
  1611 				; X = Attr_Source_Tab row (6 bytes): XDL_Image_Attribute's OVADR (bytes 3-5)
  1612 				; and MAPADR (bytes 8-10).  vbsta clobbers Y (__VBXE_AUTO__), so X only.
  1613 3A93			Set_Attr_Source
  1614 3A93 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE		; Bank $00 VBXE Window Enabled
  1615 3A95				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3A95 A0 5F			ldy #<VBXE_MA_BSEL
     3 3A97 91 93			sta (VBXEBase),y
Source: view1024.asm
