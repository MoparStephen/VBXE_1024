  1608 5A3D F0 61			beq Sel_Key_Nav_Done				; empty list
  1609 5A3F AD C7 04			lda Sel_Index
  1610 5A42 18				clc
  1611 5A43 69 08			adc #UI_COLS
  1612 5A45 CD 8B 04			cmp ImageCount
