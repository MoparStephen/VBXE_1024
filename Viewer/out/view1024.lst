  1377 38AF			Decrement_Image
  1378 38AF AD DA 04			lda FileStart
  1379 38B2 CD 8B 04			cmp ImageCount
  1380 38B5 B0 12			bcs Decrement_Image_Done
  1381 38B7 AE 8A 04			ldx File_Index
  1382 38BA EC DA 04			cpx FileStart
  1383 38BD D0 03			bne Decrement_Image_Step
  1384 38BF AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1385 38C2			Decrement_Image_Step
  1386 38C2 CA				dex
  1387 38C3 8E 8A 04			stx File_Index
  1388 38C6 20 ED 33			jsr Load_Image
  1389 38C9			Decrement_Image_Done
  1390 38C9 60				rts
