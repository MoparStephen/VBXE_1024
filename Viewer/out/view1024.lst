  2077 5D2E CD 8B 04			cmp ImageCount
  2078 5D31 90 06			bcc Selector_Sync_Set
  2079 5D33 AD 8B 04			lda ImageCount						; out of range (shouldn't happen) - clamp
  2080 5D36 38				sec
  2081 5D37 E9 01			sbc #$01
  2082 5D39			Selector_Sync_Set
