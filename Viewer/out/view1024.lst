   484 				;-----------------------------------------------------------------------------
   485 				; Enter_Selector - restore Palette 0 for text, refresh the menu banner's
   486 				; palette registers 1-3 (Load_Image overwrites them for every real image
   487 				; viewed in between - a cheap resident-VRAM-to-register copy, no disk access;
   488 				; see Apply_Menu_Banner_Palette in view1024.asm), show the text screen, draw
   489 				; it.  Reached from start: (jsr), Handle_Escape (jsr), Slide_Key_Stop (jsr)
   490 				; and Info_Key_Leave (jsr) - always returns.
   491 				;-----------------------------------------------------------------------------
   492 4D3E			Enter_Selector
   493 4D3E 20 15 32			jsr Restore_Palette0				; standard PAL/NTSC master palette -> set 0
   494 4D41 20 53 4D			jsr UI_Apply_TextPalette			; ...then de-interleave it for text mode
   495 4D44 20 69 34			jsr Apply_Menu_Banner_Palette		; refresh the banner's palette registers 1-3
   496 4D47 20 29 38			jsr Text_Activate					; point the XDL at the menu/info screen
   497 4D4A A9 00			lda #$00
