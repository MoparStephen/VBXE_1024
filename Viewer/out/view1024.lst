  1567 3A6A F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1568 3A6C A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1569 3A6E 85 83			sta Reg4
  1570 3A70 A5 8C			lda Sort_Ptr
