     1 				 ; .loadsym "C:\Users\Stephen\source\Claude\VBXE_1024\Viewer\out\view1024.lab"
     2 				 
     3 				;-----------------------------------------------------------------------------
     4 				; Memory Map
     5 				;-----------------------------------------------------------------------------
     6 				; Load Address = 
     7 				; Run Address = 
     8 				; VBXE:
     9 				;    XDLs            = $00000 - $00068 (image attribute + image normal +
    10 				;                      XDL_MainMenu's 8 chained blocks, well clear of $00100)
    11 				;    BCBs            = $00100 - $001FF
    12 				;    NTSC_Palette    = $00200 - $004FF (256 RGB triplets; restores Palette 0 on exit)
    13 				;    PAL_Palette     = $00500 - $007FF (256 RGB triplets; restores Palette 0 on exit)
    14 				;    Text pal buffer = $00800 - $00AFF (UI_Apply_TextPalette de-interleave scratch)
    15 				;    VRAM            = $01000 - $13BFF (Video Ram)
    16 				;    CRAM_Buffer     = $14000 - $1657F (Compressed palette bytes)
    17 				;    CRAM            = $17000 - $205FF (Colour Ram)
    18 				;    Palette_Buffers = $21000 - $21FFF (Temp 4kB buffer for loading palettes)
    19 				;    Text fonts      = $22000 - $22FFF (CGA.F08 @ $22000 / ATARI.F08 @ $22800;
    20 				;                      F toggles XDL_MainMenu's two CHBASE bytes between them -
    21 				;                      see text80.asm)
    22 				;    Text screen RAM = $23000 - $23E5F (23 rows x 160 {glyph,attr} bytes = 3680;
    23 				;                      ONE contiguous buffer for both text bands of the menu/
    24 				;                      info XDL - rows 0-19 = main content, rows 20-22 = footer,
    25 				;                      the on-screen gap between them is a display-time-only XDL
    26 				;                      gap, not a VRAM gap - see TEXT_MAIN_ROWS/TEXT_FOOTER_ROWS)
    27 				;    Menu banner     = $30000 - $32CFF (banks $30-$32: MENU_BANNER_VRAM, 36 rows
    28 				;                      x 320 bytes, attribute-mapped, static logo/banner for the
    29 				;                      Main Menu + Info XDL's graphics band)
    30 				;    Menu separator  = $33000 - $3309F (MENU_SEP_VRAM: 1 row x 160 bytes, lo-res
    31 				;                      no-attribute-map divider line, shared by both separator
    32 				;                      bands of the menu/info XDL)
    33 				;    Menu banner pal = $34000 - $34BFF (MENU_BANNER_PAL_VRAM: the banner's
    34 				;                      palette bytes, resident and assembly-embedded (Load_
    35 				;                      Menu_Ramps, init_vbxe.asm) - registers 1-3 are
    36 				;                      refreshed from here on every Enter_Selector with no
    37 				;                      disk access; see Apply_Menu_Banner_Palette)
    38 				;    Menu banner map = $35000 - $3667F (MENU_BANNER_MAP_VRAM: the banner's
    39 				;                      expanded attribute map, resident, dedicated - NOT the
    40 				;                      shared CRAM $017000, so it's never clobbered by Load_
    41 				;                      Image and never needs a reload)
    42 				;    NFO display buf = $25000 - $29FFF (banks $25-$29: the <name>.NFO file loaded
    43 				;                      verbatim - up to NFO_MAX_LINES fixed 160-byte {glyph,attr}
    44 				;                      line records, TEXT_PITCH stride; blitted to the text
    45 				;                      screen a window at a time by BLT_NFO_DRAW)
    46 				;    (banks $2A-$2D are free - the NFO name cache moved to $37000 when it grew)
    47 				;    Menu demo ramp  = $2E000 - $2E0FF (MENU_RAMP_VRAM: 256-byte ascending
    48 				;                      0..255 pixel-source square for the banner's 4-palette
    49 				;                      demo overlay, built at boot by Build_Menu_Ramp_Table;
    50 				;                      rest of bank $2E free)
    51 				;    Text win save   = $2F000 - $2FFFF (WIN_SAVE_VRAM: save-under for the D
    52 				;                      window and the Q quit-confirm window)
    53 				;    NFO name cache  = $37000 - $3EFFF (banks $37-$3E: the selector status line's
    54 				;                      image descriptions, NFO_NAME_SLOT bytes/image, loaded
    55 				;                      once from D:IMAGES.LST per dir rescan, wiped before each)
    56 				;    (bank $3F is free)
    57 				;    Image name list = $40000 - $40FFF (bank $40: up to MAX_IMAGES=255 rows -
    58 				;                      "..", sub-dirs and *.V1K files, 8 bytes each; + a 10-char
    59 				;                      display field is formatted in place at draw time)
    60 				;    (bank $41 is free - the old folder browser used it)
    61 				;
    62 				; MAX_IMAGES is a hard design ceiling of 255 - each image is a ~90kB
    63 				; .V1K file, so 255 far exceeds any real slideshow, and a one-byte
    64 				; count keeps every nav/sort loop small. Not intended to ever be raised.
    65
    66 				;-----------------------------------------------------------------------------
    67 				;  HARDWARE EQUATES
    68 				;-----------------------------------------------------------------------------
