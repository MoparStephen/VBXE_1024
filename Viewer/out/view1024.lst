   871 52E4 A5 86			lda Reg7
   872 52E6 20 D7 55			jsr Put_U8_Pad3
   873 52E9 A9 00			lda #$00
   874 52EB 9D 80 06			sta Txt_Line,x
   875 52EE 4C 0A 53			jmp Selector_DrawCount_Put
   876 52F1			Selector_DrawCount_Total
   877 52F1 A2 00			ldx #$00
   878 52F3 A5 86			lda Reg7
   879 52F5 20 D7 55			jsr Put_U8_Pad3
   880 52F8 A9 3B			lda #<UI_Str_Images
   881 52FA A0 5E			ldy #>UI_Str_Images
   882 52FC A6 86			ldx Reg7
   883 52FE CA				dex
   884 52FF D0 04			bne Selector_DrawCount_Plural
   885 5301 A9 43			lda #<UI_Str_Image1
