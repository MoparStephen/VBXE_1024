  1593 5725 AE C7 04			ldx Sel_Index
  1594 5728 E8				inx
  1595 5729 EC 8B 04			cpx ImageCount
  1596 572C B0 2A			bcs Sel_Key_Nav_Done				; already at the last item
  1597 572E 8A				txa
  1598 572F 4C 32 57			jmp Sel_Nav_Apply
