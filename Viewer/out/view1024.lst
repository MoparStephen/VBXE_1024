  1457 59DB E9 0A			sbc #10
  1458 59DD 85 80			sta Reg1
  1459 59DF C8				iny
  1460 59E0 D0 F3			bne Put_U8_Pad3_T
  1461 59E2			Put_U8_Pad3_TDone
  1462 59E2 98				tya
  1463 59E3 20 EC 59			jsr Put_U8_Pad3_Digit
  1464 59E6 A5 80			lda Reg1
  1465 59E8 09 30			ora #'0'							; ones digit - always shown
  1466 59EA D0 0E			bne Put_U8_Pad3_Store
