   308 				;-----------------------------------------------------------------------------
   309 				; Text_FillColour - recolour a rectangle of cells by flooding their attribute
   310 				; (odd) bytes.  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   311 				; (cells), Reg2 = height-1 (rows), A = attribute byte.  Patches BLT_FILL_COLOUR
   312 				; (dest address, Width-1, Height-1, Xor mask) then kicks it and waits.
   313 				;-----------------------------------------------------------------------------
   314 3C05			Text_FillColour
   315 3C05 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   316 3C07 A9 01			lda #$01
   317 3C09 8D B7 06			sta Txt_Dirty
   318 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
   319 3C0C A9 00			lda #$00
   320 3C0E 85 83			sta Reg4
   321 3C10 85 84			sta Reg5
   322 3C12 AE B0 06			ldx Txt_Row
   323 3C15 F0 0E			beq Text_FillColour_Col
   324 3C17			Text_FillColour_RowL
   325 3C17 A5 83			lda Reg4
   326 3C19 18				clc
   327 3C1A 69 A0			adc #TEXT_PITCH						; + 160 per row
   328 3C1C 85 83			sta Reg4
   329 3C1E 90 02			bcc Text_FillColour_RowNC
   330 3C20 E6 84			inc Reg5
   331 3C22			Text_FillColour_RowNC
   332 3C22 CA				dex
   333 3C23 D0 F2			bne Text_FillColour_RowL
   334 3C25			Text_FillColour_Col
   335 3C25 AD B1 06			lda Txt_Col
   336 3C28 0A				asl									; Txt_Col * 2
   337 3C29 18				clc
   338 3C2A 65 83			adc Reg4
   339 3C2C 85 83			sta Reg4
   340 3C2E 90 02			bcc Text_FillColour_ColNC
   341 3C30 E6 84			inc Reg5
   342 3C32			Text_FillColour_ColNC
   343 3C32 E6 83			inc Reg4							; + 1  -> the attribute (odd) byte
   344 3C34 D0 02			bne Text_FillColour_Patch
   345 3C36 E6 84			inc Reg5
   346 3C38			Text_FillColour_Patch
   347 3C38 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
