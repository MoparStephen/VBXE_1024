   712 				;-----------------------------------------------------------------------------
   713 				; Image_Open - OPEN FileNamePtr for read on the first free IOCB (the same
   714 				; sequence LoadData uses, but the file stays open across several block reads).
   715 				;  Out: C=0 and Load_IOCB = IOCB offset, or C=1 (no IOCB / OPEN failed - the
   716 				;       IOCB is closed again so it doesn't leak).
   717 				;-----------------------------------------------------------------------------
   718 3566			Image_Open
   719 3566 20 2D 30			jsr Find_First_IOCB
   720 3569 C0 01			cpy #$01
