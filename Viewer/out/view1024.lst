   699 				;-----------------------------------------------------------------------------
   700 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   701 				;  Out: C=1 on a read error / short file.
   702 				;-----------------------------------------------------------------------------
   703 3555			Image_Read_Pal
   704 3555 A9 21			lda #V1K_PAL_BANK
   705 3557 A2 00			ldx #V1K_PAL_LEN / $1000
   706 3559 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   707 355B 8C E5 04			sty Seg_Tail
   708 355E A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   709 3560 8C E6 04			sty Seg_Tail + $01
   710 3563 4C 97 35			jmp Image_Read_Segment
