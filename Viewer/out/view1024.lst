  2602 615B ED DC 04			sbc Nfo_Top
  2603 615E 85 84			sta Reg5
  2604 6160 AD DF 04			lda Nfo_LineCount + $01
  2605 6163 ED DD 04			sbc Nfo_Top + $01
  2606 6166 85 85			sta Reg6
  2607 6168 A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2608 616A 38				sec
  2609 616B E9 01			sbc #$01
  2610 616D 85 84			sta Reg5
  2611 616F A5 85			lda Reg6
  2612 6171 E9 00			sbc #$00
  2613 6173 D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2614 6175 A5 84			lda Reg5
  2615 6177 C9 13			cmp #NFO_VISROWS-1
  2616 6179 90 02			bcc Info_Body_Rows_Ret
  2617 617B			Info_Body_Rows_Full
  2618 617B A9 13			lda #NFO_VISROWS-1
  2619 617D			Info_Body_Rows_Ret
  2620 617D C9 00			cmp #$00							; Z = no rows
  2621 617F 60				rts
