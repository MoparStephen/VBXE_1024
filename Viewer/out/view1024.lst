  1245 37FA 4C 8F 38			jmp Read_Key_Done
  1246 37FD			Handle_Keys_Mode
  1247 37FD AD C6 04			lda UI_Mode
  1248 3800 D0 03			bne Handle_Keys_NotSelector
  1249 3802 4C 62 55			jmp Selector_Keys					; 0 = selector
  1250 3805			Handle_Keys_NotSelector
  1251 3805 C9 02			cmp #$02
  1252 3807 D0 03			bne Handle_Keys_NotSlide
  1253 3809 4C 38 59			jmp Slideshow_Keys					; 2 = slideshow
  1254 380C			Handle_Keys_NotSlide
  1255 380C C9 03			cmp #$03
