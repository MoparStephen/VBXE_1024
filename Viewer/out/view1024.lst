   655 				;-----------------------------------------------------------------------------
   656 				; Image_Open - OPEN FileNamePtr for read on the first free IOCB (the same
   657 				; sequence LoadData uses, but the file stays open across several block reads).
   658 				;  Out: C=0 and Load_IOCB = IOCB offset, or C=1 (no IOCB / OPEN failed - the
   659 				;       IOCB is closed again so it doesn't leak).
   660 				;-----------------------------------------------------------------------------
   661 3441			Image_Open
   662 3441 20 2D 30			jsr Find_First_IOCB
   663 3444 C0 01			cpy #$01
   664 3446 D0 28			bne Image_Open_Fail					; no free IOCB
   665 3448 8E E2 04			stx Load_IOCB
   666 344B A9 04			lda #CIO_read
   667 344D 9D 4A 03			sta ICAX1,x
   668 3450 A9 00			lda #$00
   669 3452 9D 4B 03			sta ICAX2,x
   670 3455 A9 03			lda #CIO_open
   671 3457 9D 42 03			sta ICCOM,x
   672 345A AD 28 31			lda FileNamePtr
   673 345D 9D 44 03			sta ICBAL,x
   674 3460 AD 29 31			lda FileNamePtr + $01
   675 3463 9D 45 03			sta ICBAH,x
   676 3466 20 56 E4			jsr CIOV
   677 3469 30 02			bmi Image_Open_Close
   678 346B 18				clc
   679 346C 60				rts
   680 346D			Image_Open_Close
   681 346D 20 CD 34			jsr Image_Close
   682 3470			Image_Open_Fail
   683 3470 38				sec
   684 3471 60				rts
