  1013 3709 C5 85			cmp Reg6
  1014 370B B0 47			bcs Sort_Range_Unmap				; i >= end-1 -> done
  1015
  1016 370D 85 83			sta Reg4							; m = i
  1017 370F 20 7F 37			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1018
  1019 3712 A5 81			lda Reg2
  1020 3714 18				clc
  1021 3715 69 01			adc #$01
  1022 3717 85 82			sta Reg3							; j = i + 1
  1023 3719			Sort_Range_Inner
  1024 3719 A5 82			lda Reg3
  1025 371B C5 84			cmp Reg5
  1026 371D B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1027
  1028 371F A5 82			lda Reg3
  1029 3721 20 8B 37			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1030 3724 20 5B 37			jsr Cmp_Records						; rec(m) : rec(j)
  1031 3727 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1032 3729 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1033 372B A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1034 372D 85 83			sta Reg4
  1035 372F A5 8C			lda Sort_Ptr
  1036 3731 85 8A			sta Name_Ptr
  1037 3733 A5 8D			lda Sort_Ptr + $01
  1038 3735 85 8B			sta Name_Ptr + $01
  1039 3737			Sort_Range_Inner_Next
  1040 3737 E6 82			inc Reg3
  1041 3739 4C 19 37			jmp Sort_Range_Inner
  1042 373C			Sort_Range_Inner_Done
  1043 373C A5 83			lda Reg4
  1044 373E C5 81			cmp Reg2
  1045 3740 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1046 3742 A5 81			lda Reg2
