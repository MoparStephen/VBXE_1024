     1 				; Clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
     2 				; 496x16 zoom 8x8 clear blit (this takes 2 frames)
     3 2100			BLT_CLEAR
     4 2100-21D1> 00 00 00		dta $00,$00,$00						; Source address
     5 2103 00 00			dta $00,$00							; Source step y
     6 2105 00				dta $00								; Source step x
     7 2106 FF BF 07			dta $FF,$BF,$07						; Destination address
     8 2109 80 F0			dta a(-$0F80)						; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
     9 210B FF				dta -$01							; Destination step x (backwards	1 byte)
    10 210C EF 01			dta $EF,$01							; Width-1  (495)	496 * 8 bytes wide
    11 210E 0F				dta $0F								; Height-1 (15)		 16 * 8 bytes high
    12 210F 00				dta $00								; And mask (And mask equal to 0 so clear)
    13 2110 00				dta $00								; Xor mask (will be filled with xor mask)
    14 2111 00				dta $00								; Collision and mask
    15 2112 77				dta $77								; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
    16 2113 00				dta $00								; Pattern feature
    17 2114 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    18
    19 				; Copy 9600 attrib bytes from $14000, placing each at every 4th dest byte from $17003
    20 				; 40 cells/row * 240 rows = 9600 bytes; dest stride 4 writes to $17003,$17007,$1700B...
    21 				; The 3 zero bytes before each data byte are left intact from BLT_SETUP_CMAP_1
    22 2115			BLT_SETUP_CMAP_1
    23 2115 00 40 01			dta $00,$40,$01						; Source address ($14000)
    24 2118 28 00			dta $28,$00							; Source step y = 40 (advance to next row: 40 cells * 1 byte)
    25 211A 01				dta $01								; Source step x (1)
    26 211B 03 70 01			dta $03,$70,$01						; Destination address ($17003)
    27 211E A0 00			dta $A0,$00							; Destination step y = 160 (advance to next row: 40 cells * 4 bytes)
    28 2120 04				dta $04								; Destination step x (4)
    29 2121 27 00			dta $27,$00							; Width-1 = 39   (40 cells/row)
    30 2123 EF				dta $EF								; Height-1 = 239 (240 rows; 40*240 = 9600)
    31 2124 FF				dta $FF								; And mask ($FF - pass-through, copies zero values too)
    32 2125 00				dta $00								; Xor mask (no inversion)
    33 2126 00				dta $00								; Collision mask
    34 2127 00				dta $00								; Zoom
    35 2128 00				dta $00								; Pattern feature
    36 2129 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    37
    38 				; Clears the screen RAM and CMAP data ($01000 - $21FFF or 128kB)
    39 212A			BLT_CLEAR_SCREEN
    40 212A 00 00 00			dta $00,$00,$00						; Source address
    41 212D 00 00			dta $00,$00							; Source step y
    42 212F 00				dta $00								; Source step x
    43 2130 00 10 00			dta $00,$10,$00						; Destination address
    44 2133 00 04			dta $00,$04							; Destination step y (1024 bytes) - NOTE: this equals 128 * zoom factor of 8
    45 2135 01				dta $01								; Destination step x (1 byte) - NOTE: this equals 1 * zoom factor of 8
    46 2136 7F 00			dta $7F,$00							; Width-1  (127)	128 * 8 bytes wide
    47 2138 0F				dta $0F								; Height-1 (15)		 16 * 8 bytes high
    48 2139 00				dta $00								; And mask (And mask equal to 0 so clear)
    49 213A 00				dta $00								; Xor mask (will be filled with xor mask)
    50 213B 00				dta $00								; Collision and mask
    51 213C 77				dta $77								; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
    52 213D 00				dta $00								; Pattern feature
    53 213E 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    54
    55 				; Zero-fill the 80 x TEXT_ROWS VBXE text back buffer (TEXT_BACK_VRAM, TEXT_SCREEN_
    56 				; BYTES bytes - ONE contiguous buffer backing both the menu XDL's main-content
    57 				; and footer text bands).  Constant-source fast fill: And mask 0 makes the
    58 				; source a constant equal to the Xor mask and the blitter skips the source
    59 				; fetch - about 2x faster than a copy (FX manual "The Blitter and constant
    60 				; source data").  Xor $00 -> blank glyph + transparent attribute in every
    61 				; cell.  MODE 0, NEXT clear.  Kicked by Text_Clear.
    62 213F			BLT_CLEAR_TEXT
    63 213F 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
    64 2142 00 00			dta $00,$00							; Source step y (unused)
    65 2144 00				dta $00								; Source step x (unused)
    66 2145 00 A0 02			dta <TEXT_BACK_VRAM,>TEXT_BACK_VRAM,TEXT_BACK_VRAM>>16	; Destination address (back buffer)
    67 2148 A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
    68 214A 01				dta $01								; Destination step x (1)
    69 214B 9F 00			dta a(TEXT_PITCH-1)					; Width-1  (159 -> 160 bytes per row)
    70 214D 16				dta TEXT_ROWS-1						; Height-1 (22 -> 23 rows)
    71 214E 00				dta $00								; And mask (0 -> constant source)
    72 214F 00				dta $00								; Xor mask (fill value: $00)
    73 2150 00				dta $00								; Collision and mask
    74 2151 00				dta $00								; Zoom
    75 2152 00				dta $00								; Pattern feature
    76 2153 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    77
    78 				; Recolour a rectangular region of the text back buffer - floods the attribute (odd)
    79 				; bytes only (Destination step x = 2).  Constant-source fast fill (And 0).
    80 				; Text_FillColour patches Destination address, Width-1, Height-1 and Xor mask
    81 				; before each kick.
    82 2154			BLT_FILL_COLOUR
    83 2154 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
    84 2157 00 00			dta $00,$00							; Source step y (unused)
    85 2159 00				dta $00								; Source step x (unused)
    86 215A 01 A0 02			dta <[TEXT_BACK_VRAM+1],>[TEXT_BACK_VRAM+1],TEXT_BACK_VRAM>>16	; Destination address (attr byte of cell; PATCHED)
    87 215D A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
    88 215F 02				dta $02								; Destination step x (2 - attribute bytes only)
    89 2160 4F 00			dta a(TEXT_COLS-1)					; Width-1  (79 -> 80 cells; PATCHED)
    90 2162 16				dta TEXT_ROWS-1						; Height-1 (29; PATCHED)
    91 2163 00				dta $00								; And mask (0 -> constant source)
    92 2164 00				dta $00								; Xor mask (attribute value; PATCHED)
    93 2165 00				dta $00								; Collision and mask
    94 2166 00				dta $00								; Zoom
    95 2167 00				dta $00								; Pattern feature
    96 2168 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    97
    98 				; Draw a window of the NFO display buffer (NFO_BUF_VRAM: fixed 160-byte
    99 				; {glyph,attr} line records - the same interleaved layout as the text screen)
   100 				; onto the text back buffer's main-content band only (TEXT_MAIN_ROWS rows - the
   101 				; footer band below it holds separate static text the NFO blit must not
   102 				; touch).  A plain rectangular copy (And $FF, MODE 0, step x = 1): the buffer
   103 				; already carries the attribute bytes, so no fill link is needed.  Info_Draw
   104 				; patches Source address (lo/mid/hi) and Height-1 before each kick; the
   105 				; destination is always the top-left of the text screen.
   106 2169			BLT_NFO_DRAW
   107 2169 00 50 02			dta $00,$50,$02						; Source address ($025000 = NFO_BUF_VRAM; PATCHED)
   108 216C A0 00			dta a(TEXT_PITCH)					; Source step y (160 - next line record)
   109 216E 01				dta $01								; Source step x (1)
   110 216F 00 A0 02			dta <TEXT_BACK_VRAM,>TEXT_BACK_VRAM,TEXT_BACK_VRAM>>16	; Destination address (back buffer; lo byte PATCHED - row 0 / row 1)
   111 2172 A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
   112 2174 01				dta $01								; Destination step x (1)
   113 2175 9F 00			dta a(TEXT_PITCH-1)					; Width-1  (159 -> 160 bytes = 80 cells)
   114 2177 13				dta TEXT_MAIN_ROWS-1					; Height-1 (PATCHED by Info_Blit: 0 for the title row, up to 18 for the body)
   115 2178 FF				dta $FF								; And mask ($FF -> straight copy)
   116 2179 00				dta $00								; Xor mask
   117 217A 00				dta $00								; Collision and mask
   118 217B 00				dta $00								; Zoom
   119 217C 00				dta $00								; Pattern feature
   120 217D 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   121
   122 				; Save-under rectangle copy for the text-window primitive (Text_Window_Save /
   123 				; Text_Window_Restore), and the full-screen back -> front copy (Text_Present).  A plain {glyph,attr} rect copy at screen pitch: step x
   124 				; = 1, step y = TEXT_PITCH, MODE 0, And $FF.  Both address triplets plus Width-1
   125 				; and Height-1 are patched per call; the two directions just swap Src <-> Dest.
   126 217E			BLT_TEXT_RECT
   127 217E 00 00 02			dta $00,$00,$02						; Source address (PATCHED)
   128 2181 A0 00			dta a(TEXT_PITCH)					; Source step y (160 - next row)
   129 2183 01				dta $01								; Source step x (1)
   130 2184 00 00 02			dta $00,$00,$02						; Destination address (PATCHED)
   131 2187 A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next row)
   132 2189 01				dta $01								; Destination step x (1)
   133 218A 00 00			dta a($0000)						; Width-1  in BYTES (PATCHED = cells*2 - 1)
   134 218C 00				dta $00								; Height-1 (PATCHED = rows - 1)
   135 218D FF				dta $FF								; And mask ($FF -> straight copy)
   136 218E 00				dta $00								; Xor mask
   137 218F 00				dta $00								; Collision and mask
   138 2190 00				dta $00								; Zoom
   139 2191 00				dta $00								; Pattern feature
   140 2192 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   141
   142 				; Constant-source fill for the menu separator row - unused at boot now (the
   143 				; separator is assembly-embedded, see Load_Menu_Sep in init_vbxe.asm), so
   144 				; Fill_Pal_Preview_Cmap (view1024.asm) repurposes it for the P-preview's
   145 				; CRAM_Buffer attribute fills (patching Dest_Adr, Dest_Step_Y0/1, Blt_W0/1,
   146 				; Blt_H, Blt_Xor).  BCB budget: everything in this file must fit $100-$1FF
   147 				; of VBXE VRAM (see the memory-map comment at the top of view1024.asm) - an
   148 				; overflow past $200 runs into the NTSC_Palette load and corrupts it (this
   149 				; happened once).  Removing the old banner blank-fill BCB freed one 21-byte
   150 				; slot; check the .lab before adding another.
   151 2193			BLT_MENU_SEP_CLEAR
   152 2193 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   153 2196 00 00			dta $00,$00							; Source step y (unused)
   154 2198 00				dta $00								; Source step x (unused)
   155 2199 00 40 03			dta <MENU_SEP_VRAM,>MENU_SEP_VRAM,MENU_SEP_VRAM>>16			; Destination address
   156 219C A0 00			dta a(MENU_SEP_PITCH)				; Destination step y (unused - 1 row)
   157 219E 01				dta $01								; Destination step x (1)
   158 219F 9F 00			dta a(MENU_SEP_PITCH-1)				; Width-1  (159 -> 160 bytes/row)
   159 21A1 00				dta $00								; Height-1 (1 row)
   160 21A2 00				dta $00								; And mask (0 -> constant source)
   161 21A3 00				dta $00								; Xor mask (fill value - set at runtime by Fill_Pal_Preview_Cmap)
   162 21A4 00				dta $00								; Collision and mask
   163 21A5 00				dta $00								; Zoom
   164 21A6 00				dta $00								; Pattern feature
   165 21A7 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   166
   167 				; Menu banner palette-demo overlay - blit Build_Menu_Ramp_Table's 256-byte
   168 				; ascending source ($2E000, bank $2E - fixed, never patched) as a flat 16x16
   169 				; block into one of the demo's 8 squares.  Draw_Menu_Demo_Squares (view1024.
   170 				; asm) patches Dest_Adr0-2 from Menu_Demo_Dest_Table before each of the 8
   171 				; kicks; every other field is fixed.
   172 21A8			BLT_MENU_DEMO_SQUARE
   173 21A8 00 E0 02			dta <MENU_RAMP_VRAM,>MENU_RAMP_VRAM,MENU_RAMP_VRAM>>16	; Source address ($2E000, fixed)
   174 21AB 10 00			dta $10,$00							; Source step y = 16
   175 21AD 01				dta $01								; Source step x (1)
   176 21AE 00 00 00			dta $00,$00,$00						; Destination address (PATCHED per kick)
   177 21B1 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320)
   178 21B3 01				dta $01								; Destination step x (1)
   179 21B4 0F 00			dta $0F,$00							; Width-1 = 15 (16 bytes wide)
   180 21B6 0F				dta $0F								; Height-1 = 15 (16 rows)
   181 21B7 FF				dta $FF								; And mask (straight copy)
   182 21B8 00				dta $00								; Xor mask
   183 21B9 00				dta $00								; Collision mask
   184 21BA 00				dta $00								; Zoom
   185 21BB 00				dta $00								; Pattern feature
   186 21BC 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   187
   188 				; Wipe the selector description cache ($037000-$03EFFF = NFO_NAME_VRAM, banks
   189 				; $37-$3E) to $00, marking every image slot "not loaded".  Constant-source fast
   190 				; fill (And 0 -> source is the $00 Xor mask, no fetch).  256 bytes/row * 128
   191 				; rows = 32768 = 8 banks.  Kicked by Nfo_Name_ClearCache from Rescan_Images.
   192 21BD			BLT_NFO_NAME_CLEAR
   193 21BD 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   194 21C0 00 00			dta $00,$00							; Source step y (unused)
   195 21C2 00				dta $00								; Source step x (unused)
   196 21C3 00 70 03			dta <NFO_NAME_VRAM,>NFO_NAME_VRAM,NFO_NAME_VRAM>>16	; Destination address ($037000)
   197 21C6 00 01			dta a($0100)						; Destination step y (256 - next row)
   198 21C8 01				dta $01								; Destination step x (1)
   199 21C9 FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   200 21CB 7F				dta $7F								; Height-1 (127 -> 128 rows; 128*256 = 32768 = 8 banks)
   201 21CC 00				dta $00								; And mask (0 -> constant source)
   202 21CD 00				dta $00								; Xor mask (fill value: $00)
   203 21CE 00				dta $00								; Collision and mask
   204 21CF 00				dta $00								; Zoom
   205 21D0 00				dta $00								; Pattern feature
   206 21D1 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
