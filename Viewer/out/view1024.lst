   822 55EE 4A				lsr
   823 55EF 4A				lsr
   824 55F0 4A				lsr
   825 55F1 85 82			sta Reg3							; Reg3 = item_row (index / UI_COLS)
   826 55F3 AD C8 04			lda Sel_Top
   827 55F6 4A				lsr
   828 55F7 4A				lsr
   829 55F8 4A				lsr								; A = top_row (Sel_Top / UI_COLS)
   830 55F9 85 80			sta Reg1							; Reg1 = top_row
   831 55FB A5 82			lda Reg3
   832 55FD 38				sec
   833 55FE E5 80			sbc Reg1							; A = item_row - top_row
   834 5600 90 25			bcc Selector_HiRow_Skip				; item_row < top_row - above the window
   835 5602 C9 0F			cmp #UI_VISROWS
   836 5604 B0 21			bcs Selector_HiRow_Skip				; below the window
   837 5606 18				clc
   838 5607 69 02			adc #UI_FIRSTROW
