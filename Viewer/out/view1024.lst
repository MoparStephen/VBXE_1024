  1593 				;-----------------------------------------------------------------------------
  1594 				; Sort_Range - in-place alphabetical selection sort of the records
  1595 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1596 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1597 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1598 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1599 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1600 				;-----------------------------------------------------------------------------
  1601 39CB			Sort_Range
  1602 39CB E0 02			cpx #$02
  1603 39CD 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1604 39CF 85 81			sta Reg2							; Reg2 = i = start
  1605 39D1 86 82			stx Reg3							; Reg3 = count (temp)
  1606 39D3 18				clc
  1607 39D4 65 82			adc Reg3
  1608 39D6 85 84			sta Reg5							; Reg5 = end = start + count
  1609 39D8 38				sec
  1610 39D9 E9 01			sbc #$01
  1611 39DB 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1612
  1613 39DD A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1614 39DF				vbsta VBXE_MA_BSEL
