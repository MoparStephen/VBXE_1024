  1603 				; Sel_Key_Down/Up/Left/Right - each validates and clamps the move, then hands
  1604 				; the new index to Sel_Nav_Apply.  Because the list is one flat, row-major
  1605 				; array, Left/Right wrapping across a row boundary needs no extra logic -
  1606 				; it's just Sel_Index +/- 1.
  1607 5AB9			Sel_Key_Down
  1608 5AB9 AD 8B 04			lda ImageCount
  1609 5ABC 0D 8C 04			ora ImageCount+1
  1610 5ABF F0 61			beq Sel_Key_Nav_Done				; empty list
  1611 5AC1 AD C7 04			lda Sel_Index
  1612 5AC4 18				clc
  1613 5AC5 69 08			adc #UI_COLS
  1614 5AC7 CD 8B 04			cmp ImageCount
  1615 5ACA B0 56			bcs Sel_Key_Nav_Done				; no cell directly below - clamp
  1616 5ACC 4C FC 5A			jmp Sel_Nav_Apply
  1617
  1618 5ACF			Sel_Key_Up
  1619 5ACF AD C7 04			lda Sel_Index
  1620 5AD2 C9 08			cmp #UI_COLS
  1621 5AD4 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1622 5AD6 38				sec
  1623 5AD7 E9 08			sbc #UI_COLS
  1624 5AD9 4C FC 5A			jmp Sel_Nav_Apply
  1625
  1626 5ADC			Sel_Key_Left
  1627 5ADC AD C7 04			lda Sel_Index
