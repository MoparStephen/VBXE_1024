   981 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
   982 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
   983 				; copy reads as a flipped reflection of the left-hand one; the underlying
   984 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
   985 				; register each cell points at changes.
   986 36E1			Menu_Demo_Attr_Top_Vals
   987 36E1 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
