   647 				;-----------------------------------------------------------------------------
   648 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   649 				;  Out: C=1 on a read error / short file.
   650 				;-----------------------------------------------------------------------------
   651 3451			Image_Read_Pal
   652 3451 A9 21			lda #V1K_PAL_BANK
   653 3453 A2 00			ldx #V1K_PAL_LEN / $1000
   654 3455 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   655 3457 8C E5 04			sty Seg_Tail
   656 345A A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   657 345C 8C E6 04			sty Seg_Tail + $01
   658 345F 4C 93 34			jmp Image_Read_Segment
