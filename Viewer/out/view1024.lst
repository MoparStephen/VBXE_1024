Source: vbxe_min.asm
     1 				; BRACKETS ARE LOAD-BEARING.  MADS binds .not looser than .and, so the
     2 				; unbracketed form ".not .def A .and .not .def B" parses as
     3 				; ".not [.def A .and .not .def B]" - which is TRUE whenever __VBXE_AUTO__ is
     4 				; undefined, so the first branch always won and __VBXE_D700__ did nothing.
     5 				.if [.not .def __VBXE_AUTO__] .and [.not .def __VBXE_D700__]	; Default case - VBXE at $D640
     6 				VBXE_BASE		equ	$D600
     7 				.elseif [.not .def __VBXE_AUTO__] .and [.def __VBXE_D700__]	; VBXE is assumed to be under $D740
     8 				VBXE_BASE		equ	$D700
     9 				.else									; VBXE should be autodetected
    10 = 0000			VBXE_BASE		equ	$0000
    11 				.endif
    12
    13 = 0040			VBXE_VIDEO_CONTROL		equ	VBXE_BASE+$40	; Write
    14 = 0040			VBXE_CORE_VERSION		equ	VBXE_BASE+$40	; Read
    15 = 0041			VBXE_XDL_ADR0			equ	VBXE_BASE+$41	; Write
    16 = 0041			VBXE_MINOR				equ	VBXE_BASE+$41	; Read
    17 = 0042			VBXE_XDL_ADR1			equ	VBXE_BASE+$42
    18 = 0043			VBXE_XDL_ADR2			equ	VBXE_BASE+$43
    19 = 0044			VBXE_CSEL				equ	VBXE_BASE+$44
    20 = 0045			VBXE_PSEL				equ	VBXE_BASE+$45
    21 = 0046			VBXE_CR					equ	VBXE_BASE+$46
    22 = 0047			VBXE_CG					equ	VBXE_BASE+$47
    23 = 0048			VBXE_CB					equ	VBXE_BASE+$48
    24 = 0049			VBXE_COLMASK			equ	VBXE_BASE+$49
    25 = 004A			VBXE_COLCLR				equ	VBXE_BASE+$4A
    26 = 0050			VBXE_BL_ADR0			equ	VBXE_BASE+$50	; Write
    27 = 0050			VBXE_BLT_COLLISION_CODE	equ	VBXE_BASE+$50	; Read
    28 = 0051			VBXE_BL_ADR1			equ	VBXE_BASE+$51
    29 = 0052			VBXE_BL_ADR2			equ	VBXE_BASE+$52
