  1575 5734 AD C7 04			lda Sel_Index
  1576 5737 20 04 52			jsr Selector_HiRow					; highlight the cell we moved to
  1577 573A			Sel_Key_Nav_Done
  1578 573A 20 34 53			jsr Selector_DrawStatus				; row 20: description of the new row
  1579 573D 4C 96 38			jmp Read_Key_Done
