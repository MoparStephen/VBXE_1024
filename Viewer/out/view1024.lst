   189 				; Text_Clear - blitter zero-fill of TEXT_SCREEN_VRAM .. +TEXT_SCREEN_BYTES.
   190 				; Kicks BLT_CLEAR_TEXT (constant-source fast fill, MODE 0) and waits for it to
   191 				; finish - callers poke glyphs into the same VRAM immediately after.  The blit
   192 				; crosses the $24000 bank boundary on its own (24-bit destination address).
   193 				;-----------------------------------------------------------------------------
   194 3A4B			Text_Clear
   195 3A4B A9 53			lda #BLT_CLEAR_TEXT-BLT_CLEAR
   196 3A4D				vbsta VBXE_BL_ADR0					; Point the blitter at BLT_CLEAR_TEXT
