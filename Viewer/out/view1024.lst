  1680 				;-----------------------------------------------------------------------------
  1681 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1682 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1683 				; equal) otherwise.
  1684 				;-----------------------------------------------------------------------------
  1685 3A4B			Cmp_Records
  1686 3A4B A0 00			ldy #$00
  1687 3A4D			Cmp_Records_L1
  1688 3A4D B1 8A			lda (Name_Ptr),y
  1689 3A4F D1 8C			cmp (Sort_Ptr),y
  1690 3A51 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1691 3A53 C8				iny
  1692 3A54 C0 08			cpy #$08
  1693 3A56 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1694 3A58			Cmp_Records_Done
  1695 3A58 60				rts
