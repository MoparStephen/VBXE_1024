  2539 				;-----------------------------------------------------------------------------
  2540 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2541 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2542 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2543 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2544 				; its 19 rows, clear first and blit only the records that exist.
  2545 				;-----------------------------------------------------------------------------
  2546 6102			Info_Draw
  2547 6102 A9 01			lda #$01
  2548 6104 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2549 6107 AD DE 04			lda Nfo_LineCount
  2550 610A 0D DF 04			ora Nfo_LineCount + $01
  2551 610D D0 03			bne Info_Draw_Some
  2552 610F 4C B1 3E			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2553 6112			Info_Draw_Some
  2554 6112 20 57 61			jsr Info_Body_Rows
  2555 6115 C9 13			cmp #NFO_VISROWS-1
  2556 6117 B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2557 6119 20 B1 3E			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2558 611C			Info_Draw_Head
  2559 611C A9 00			lda #$00							; record 0 -> row 0, one row
  2560 611E 85 80			sta Reg1
  2561 6120 85 81			sta Reg2
  2562 6122 85 83			sta Reg4
  2563 6124 A9 00			lda #<TEXT_BACK_VRAM
  2564 6126 85 82			sta Reg3
  2565 6128 20 80 61			jsr Info_Blit
  2566 612B 20 57 61			jsr Info_Body_Rows
  2567 612E F0 26			beq Info_Draw_Ret					; no body records
  2568 6130 85 83			sta Reg4
  2569 6132 C6 83			dec Reg4							; Reg4 = height-1
  2570 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2571 6134 A9 A0			lda #TEXT_PITCH
  2572 6136 85 80			sta Reg1
  2573 6138 A9 00			lda #$00
  2574 613A 85 81			sta Reg2
  2575 613C AE DC 04			ldx Nfo_Top
  2576 613F F0 0E			beq Info_Draw_Body
  2577 6141			Info_Draw_MulL
  2578 6141 A5 80			lda Reg1
  2579 6143 18				clc
  2580 6144 69 A0			adc #TEXT_PITCH
  2581 6146 85 80			sta Reg1
  2582 6148 90 02			bcc Info_Draw_MulNC
  2583 614A E6 81			inc Reg2
  2584 614C			Info_Draw_MulNC
  2585 614C CA				dex
  2586 614D D0 F2			bne Info_Draw_MulL
  2587 614F			Info_Draw_Body
  2588 614F A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2589 6151 85 82			sta Reg3
  2590 6153 4C 80 61			jmp Info_Blit						; (tail)
  2591 6156			Info_Draw_Ret
  2592 6156 60				rts
  2593
  2594 				;-----------------------------------------------------------------------------
  2595 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2596 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2597 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2598 				;-----------------------------------------------------------------------------
  2599 6157			Info_Body_Rows
  2600 6157 38				sec
