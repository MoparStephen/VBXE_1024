   760 5022			Selector_HiRow_Hi
   761 5022 A9 0F			lda #UI_PEN_HI						; highlighted: gold foreground, no bar
   762 5024 4C 5D 39			jmp Text_FillColour					; tail
   763 5027			Selector_HiRow_Skip
   764 5027 60				rts
