  1851 				; Build_Filename
  1852 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1853 				;       File_Index = image ordinal
  1854 				;  Out: FileNamePtr -> Path_Buf holding
  1855 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1856 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1857 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1858 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1859 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
