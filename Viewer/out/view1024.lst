   162 				; Constant-source fast fills for the menu banner/separator VRAM.  The banner
   163 				; fill is a blank-fill fallback when its .RAW asset fails to load at boot, so
   164 				; cold-boot garbage never shows.  Fixed geometry, no patching needed - kicked
   165 				; once each from Load_Menu_Banner_Raw.
   166 21A7			BLT_MENU_BANNER_CLEAR
   167 21A7 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   168 21AA 00 00			dta $00,$00							; Source step y (unused)
   169 21AC 00				dta $00								; Source step x (unused)
   170 21AD 00 00 03			dta <MENU_BANNER_VRAM,>MENU_BANNER_VRAM,MENU_BANNER_VRAM>>16	; Destination address
   171 21B0 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320 - next row)
   172 21B2 01				dta $01								; Destination step x (1)
   173 21B3 3F 01			dta a(MENU_BANNER_PITCH-1)			; Width-1  (319 -> 320 bytes/row)
   174 21B5 23				dta MENU_BANNER_ROWS-1				; Height-1 (35 -> 36 rows)
   175 21B6 00				dta $00								; And mask (0 -> constant source)
   176 21B7 00				dta $00								; Xor mask (fill value: $00)
   177 21B8 00				dta $00								; Collision and mask
   178 21B9 00				dta $00								; Zoom
   179 21BA 00				dta $00								; Pattern feature
   180 21BB 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   181
   182 				; The separator is never loaded from disk - it is always this fixed-colour
   183 				; constant-source fill, kicked once from Load_Menu_Banner_Raw.
   184 21BC			BLT_MENU_SEP_CLEAR
   185 21BC 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   186 21BF 00 00			dta $00,$00							; Source step y (unused)
   187 21C1 00				dta $00								; Source step x (unused)
   188 21C2 00 30 03			dta <MENU_SEP_VRAM,>MENU_SEP_VRAM,MENU_SEP_VRAM>>16			; Destination address
   189 21C5 A0 00			dta a(MENU_SEP_PITCH)				; Destination step y (unused - 1 row)
   190 21C7 01				dta $01								; Destination step x (1)
   191 21C8 9F 00			dta a(MENU_SEP_PITCH-1)				; Width-1  (159 -> 160 bytes/row)
   192 21CA 00				dta $00								; Height-1 (1 row)
   193 21CB 00				dta $00								; And mask (0 -> constant source)
   194 21CC 07				dta MENU_SEP_FILL_COLOUR			; Xor mask (fill value: white, Palette 0)
   195 21CD 00				dta $00								; Collision and mask
   196 21CE 00				dta $00								; Zoom
   197 21CF 00				dta $00								; Pattern feature
   198 21D0 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   199
   200 				; Menu banner palette-demo overlay - blit Build_Menu_Ramp_Table's 256-byte
   201 				; ascending source ($2E000, bank $2E - fixed, never patched) as a flat 16x16
   202 				; block into one of the demo's 8 squares.  Draw_Menu_Demo_Squares (view1024.
   203 				; asm) patches Dest_Adr0-2 from Menu_Demo_Dest_Table before each of the 8
   204 				; kicks; every other field is fixed.
   205 21D1			BLT_MENU_DEMO_SQUARE
   206 21D1 00 E0 02			dta <MENU_RAMP_VRAM,>MENU_RAMP_VRAM,MENU_RAMP_VRAM>>16	; Source address ($2E000, fixed)
   207 21D4 10 00			dta $10,$00							; Source step y = 16
   208 21D6 01				dta $01								; Source step x (1)
   209 21D7 00 00 00			dta $00,$00,$00						; Destination address (PATCHED per kick)
   210 21DA 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320)
   211 21DC 01				dta $01								; Destination step x (1)
   212 21DD 0F 00			dta $0F,$00							; Width-1 = 15 (16 bytes wide)
   213 21DF 0F				dta $0F								; Height-1 = 15 (16 rows)
   214 21E0 FF				dta $FF								; And mask (straight copy)
   215 21E1 00				dta $00								; Xor mask
   216 21E2 00				dta $00								; Collision mask
   217 21E3 00				dta $00								; Zoom
   218 21E4 00				dta $00								; Pattern feature
   219 21E5 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   220
   221 				; Wipe the selector long-name cache ($02A000-$02DFFF = NFO_NAME_VRAM, banks
   222 				; $2A-$2D) to $00, marking every image slot "not loaded".  Constant-source fast
   223 				; fill (And 0 -> source is the $00 Xor mask, no fetch).  256 bytes/row * 64 rows
   224 				; = 16384 = 4 banks.  Kicked by Nfo_Name_ClearCache from Rescan_Images.
   225 21E6			BLT_NFO_NAME_CLEAR
   226 21E6 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   227 21E9 00 00			dta $00,$00							; Source step y (unused)
   228 21EB 00				dta $00								; Source step x (unused)
   229 21EC 00 A0 02			dta $00,$A0,$02						; Destination address ($02A000 = NFO_NAME_VRAM)
   230 21EF 00 01			dta a($0100)						; Destination step y (256 - next row)
   231 21F1 01				dta $01								; Destination step x (1)
   232 21F2 FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   233 21F4 3F				dta $3F								; Height-1 (63 -> 64 rows; 64*256 = 16384 = 4 banks)
   234 21F5 00				dta $00								; And mask (0 -> constant source)
   235 21F6 00				dta $00								; Xor mask (fill value: $00)
   236 21F7 00				dta $00								; Collision and mask
   237 21F8 00				dta $00								; Zoom
   238 21F9 00				dta $00								; Pattern feature
   239 21FA 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   473 = 00FB			BLT_Length	equ *-BCB_START
