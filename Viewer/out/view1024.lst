   555 				;-----------------------------------------------------------------------------
   556 				; The IBM CGA font, embedded in the .xex.  256 glyphs x 8x8 1bpp = 2048 bytes,
   557 				; code page 437 order (glyph index = raw ASCII byte).  Text_Load_Font copies it
   558 				; into VRAM bank TEXT_FONT_BANK at boot.
   559 				;-----------------------------------------------------------------------------
   560 3BAC			Text_Font_Data
   561 3BAC 00 00 00 00 00 00 + 	ins 'Assets/CGA.F08'
   562 43AC			Text_Font_Data_End
   563 					.if Text_Font_Data_End - Text_Font_Data != 2048
   564 						.error "CGA.F08 must be exactly 2048 bytes"
   565 					.endif
   566
   567 				;-----------------------------------------------------------------------------
   568 				; The Atari OS character set, embedded in the .xex.  Re-ordered from the ROM's
   569 				; ATASCII/internal glyph order into ASCII order (glyph index = raw ASCII byte,
   570 				; matching CGA.F08 and Text_PutStrAt), with glyphs $80-$FF the bitwise inverse
   571 				; of $00-$7F.  256 glyphs x 8x8 1bpp = 2048 bytes.  ATARI-raw.F08 keeps the
   572 				; original 1024-byte ROM dump.  Loaded to VRAM $022800 by Text_Load_Fonts.
   573 				;-----------------------------------------------------------------------------
   574 43AC			Atari_Font_Data
   575 43AC 00 36 7F 7F 3E 1C + 	ins 'Assets/ATARI.F08'
   576 4BAC			Atari_Font_Data_End
   577 					.if Atari_Font_Data_End - Atari_Font_Data != 2048
   578 						.error "ATARI.F08 must be exactly 2048 bytes"
   579 					.endif
