  1866 3C22 85 82			sta Reg3
  1867 3C24 A9 00			lda #$00
  1868 3C26 85 83			sta Reg4
  1869 3C28 06 82			asl Reg3
  1870 3C2A 26 83			rol Reg4
  1871 3C2C 06 82			asl Reg3
  1872 3C2E 26 83			rol Reg4
  1873 3C30 06 82			asl Reg3
  1874 3C32 26 83			rol Reg4							; Reg3/Reg4 = File_Index * 8
  1875 3C34 A5 82			lda Reg3
