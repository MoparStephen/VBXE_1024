  1579 57D6 0D 8C 04			ora ImageCount+1
  1580 57D9 F0 61			beq Sel_Key_Nav_Done				; empty list
  1581 57DB AD C7 04			lda Sel_Index
  1582 57DE 18				clc
  1583 57DF 69 08			adc #UI_COLS
