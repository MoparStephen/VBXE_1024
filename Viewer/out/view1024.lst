  2152 5E5B C9 80			cmp #$80
  2153 5E5D F0 2E			beq Pal_Preview_Keys_None			; Ctrl - no single-palette view here
  2154 5E5F 20 1D 3B			jsr Pal_Solo						; X = palette 0-3 (view1024.asm)
  2155 5E62 4C 16 3A			jmp Read_Key_Done
