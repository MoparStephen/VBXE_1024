  2469 				;=============================================================================
  2470 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2471 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2472 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2473 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2474 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits record 0 (the title rule,
  2475 				; pinned to row 0) plus a 19-row scrolling window of the rest - two
  2476 				; BLT_NFO_DRAW copies per scroll, no reformat, no re-walk.
  2477 				;=============================================================================
  2478
  2479 				;-----------------------------------------------------------------------------
  2480 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2481 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2482 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2483 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2484 				; off screen.
  2485 				;-----------------------------------------------------------------------------
  2486 60A1			Info_Load
  2487 60A1 A9 25			lda #NFO_BUF_BANK
  2488 60A3 85 8E			sta BankIndex
  2489 60A5 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2490 60A8 AD 2D 31			lda LoadStatus
  2491 60AB F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2492 60AD 20 B1 60			jsr Info_Count_Lines				; sets Nfo_LineCount
  2493 60B0			Info_Load_Ret
  2494 60B0 60				rts
  2495
  2496 				;-----------------------------------------------------------------------------
  2497 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2498 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2499 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2500 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2501 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2502 				;-----------------------------------------------------------------------------
  2503 60B1			Info_Count_Lines
  2504 60B1 A9 00			lda #$00
  2505 60B3 8D DE 04			sta Nfo_LineCount
  2506 60B6 8D DF 04			sta Nfo_LineCount + $01
  2507 60B9 A9 25			lda #NFO_BUF_BANK
  2508 60BB 8D 50 06			sta Nfo_WalkBank
  2509 60BE 09 80			ora #MEMAC_GLOBAL_ENABLE
  2510 60C0				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 60C0 A0 5F			ldy #<VBXE_MA_BSEL
     3 60C2 91 93			sta (VBXEBase),y
Source: ui.asm
  2511 60C4 A9 00			lda #<VBXE_WINDOW
  2512 60C6 85 88			sta Ptr_Lo
  2513 60C8 A9 20			lda #>VBXE_WINDOW
  2514 60CA 85 89			sta Ptr_Hi
  2515 60CC			Info_Count_L1
  2516 60CC A0 00			ldy #$00
  2517 60CE B1 88			lda (Ptr_Lo),y
  2518 60D0 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2519 60D2 EE DE 04			inc Nfo_LineCount
  2520 60D5 AD DE 04			lda Nfo_LineCount
  2521 60D8 C9 7F			cmp #NFO_MAX_LINES
  2522 60DA B0 24			bcs Info_Count_Done					; hit the record cap
  2523 60DC A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2524 60DE 18				clc
  2525 60DF 69 A0			adc #TEXT_PITCH
  2526 60E1 85 88			sta Ptr_Lo
  2527 60E3 90 E7			bcc Info_Count_L1
  2528 60E5 E6 89			inc Ptr_Hi
  2529 60E7 A5 89			lda Ptr_Hi
  2530 60E9 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2531 60EB 90 DF			bcc Info_Count_L1
  2532 60ED E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2533 60EF 85 89			sta Ptr_Hi
  2534 60F1 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2535 60F4 AD 50 06			lda Nfo_WalkBank
  2536 60F7 09 80			ora #MEMAC_GLOBAL_ENABLE
  2537 60F9				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 60F9 A0 5F			ldy #<VBXE_MA_BSEL
     3 60FB 91 93			sta (VBXEBase),y
Source: ui.asm
  2538 60FD 4C CC 60			jmp Info_Count_L1
  2539 6100			Info_Count_Done
  2540 6100 A9 00			lda #MEMAC_GLOBAL_DISABLE
  2541 6102				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 6102 A0 5F			ldy #<VBXE_MA_BSEL
     3 6104 91 93			sta (VBXEBase),y
Source: ui.asm
  2542 6106 60				rts
