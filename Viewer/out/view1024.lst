  1528 				;-----------------------------------------------------------------------------
  1529 				; Sort_Range - in-place alphabetical selection sort of the records
  1530 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1531 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1532 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1533 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1534 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1535 				;-----------------------------------------------------------------------------
  1536 3983			Sort_Range
  1537 3983 E0 02			cpx #$02
  1538 3985 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1539 3987 85 81			sta Reg2							; Reg2 = i = start
  1540 3989 86 82			stx Reg3							; Reg3 = count (temp)
  1541 398B 18				clc
  1542 398C 65 82			adc Reg3
  1543 398E 85 84			sta Reg5							; Reg5 = end = start + count
  1544 3990 38				sec
  1545 3991 E9 01			sbc #$01
  1546 3993 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1547
  1548 3995 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1549 3997				vbsta VBXE_MA_BSEL
