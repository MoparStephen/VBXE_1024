  1504 				;-----------------------------------------------------------------------------
  1505 				; Increment_Image - advance File_Index within the *.V1K file band
  1506 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1507 				; No-op when the list holds no files.  (The selector list may now also carry
  1508 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1509 				;-----------------------------------------------------------------------------
  1510 3A0E			Increment_Image
  1511 3A0E AD DA 04			lda FileStart
  1512 3A11 CD 8B 04			cmp ImageCount
  1513 3A14 B0 15			bcs Increment_Image_Done			; no *.V1K files in the list
  1514 3A16 AE 8A 04			ldx File_Index
  1515 3A19 E8				inx
  1516 3A1A EC 8B 04			cpx ImageCount
  1517 3A1D 90 03			bcc Increment_Image_Store
  1518 3A1F AE DA 04			ldx FileStart						; wrap past the last file to the first
  1519 3A22			Increment_Image_Store
  1520 3A22 8E 8A 04			stx File_Index
  1521 3A25 20 4C 35			jsr Load_Image
  1522 3A28 20 96 3B			jsr Map_View_Reapply				; still in key-5 view? recolour entry 1
  1523 3A2B			Increment_Image_Done
  1524 3A2B 60				rts
  1525
  1526 				;-----------------------------------------------------------------------------
  1527 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1528 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1529 				;-----------------------------------------------------------------------------
  1530 3A2C			Decrement_Image
  1531 3A2C AD DA 04			lda FileStart
  1532 3A2F CD 8B 04			cmp ImageCount
  1533 3A32 B0 15			bcs Decrement_Image_Done
  1534 3A34 AE 8A 04			ldx File_Index
  1535 3A37 EC DA 04			cpx FileStart
  1536 3A3A D0 03			bne Decrement_Image_Step
  1537 3A3C AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1538 3A3F			Decrement_Image_Step
  1539 3A3F CA				dex
  1540 3A40 8E 8A 04			stx File_Index
  1541 3A43 20 4C 35			jsr Load_Image
  1542 3A46 20 96 3B			jsr Map_View_Reapply
  1543 3A49			Decrement_Image_Done
