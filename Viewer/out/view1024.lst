   440 				;-----------------------------------------------------------------------------
   441 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   442 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   443 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   444 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   445 				;  Returns A = $01 if a name was written, $00 if not.
   446 				;-----------------------------------------------------------------------------
   447 5349			Parse_Dir_Line
   448 5349 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   449 534B			Parse_Skip_L1							; Skip leading spaces / protect flag
   450 534B BD 00 06			lda Dir_Line_Buf,x
   451 534E C9 9B			cmp #$9B
   452 5350 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   453 5352 C9 20			cmp #' '
   454 5354 F0 04			beq Parse_Skip_Next
   455 5356 C9 2A			cmp #'*'
   456 5358 D0 07			bne Parse_Skip_Done
   457 535A			Parse_Skip_Next
   458 535A E8				inx
   459 535B E0 28			cpx #Dir_Line_Len
   460 535D 90 EC			bcc Parse_Skip_L1
   461 535F B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   462 5361			Parse_Skip_Done
   463 5361 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   464 5363 A9 00			lda #$00
   465 5365 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   466
   467 5367			Parse_Copy_L1
   468 5367 BD 00 06			lda Dir_Line_Buf,x
   469 536A C9 9B			cmp #$9B
   470 536C F0 24			beq Parse_Copy_Done
   471 536E C9 20			cmp #' '
   472 5370 F0 20			beq Parse_Copy_Done
   473 5372 C9 2E			cmp #'.'
   474 5374 F0 1C			beq Parse_Copy_Done
   475 5376 C9 30			cmp #'0'
   476 5378 90 07			bcc Parse_Copy_Is_Name_Char
   477 537A C9 3A			cmp #'9'+1
   478 537C B0 03			bcs Parse_Copy_Is_Name_Char
   479 537E 4C 83 53			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   480 5381			Parse_Copy_Is_Name_Char
   481 5381 E6 80			inc Reg1
   482 5383			Parse_Copy_Store
   483 5383 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   484 5385 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   485 5387 BD 00 06			lda Dir_Line_Buf,x
   486 538A 91 8A			sta (Name_Ptr),y
   487 538C C8				iny
   488 538D			Parse_Copy_Next
   489 538D E8				inx
   490 538E E0 28			cpx #Dir_Line_Len
   491 5390 90 D5			bcc Parse_Copy_L1
   492
   493 5392			Parse_Copy_Done
   494 5392 A5 80			lda Reg1
   495 5394 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   496
   497 5396			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   498 5396 C0 08			cpy #$08
   499 5398 B0 07			bcs Parse_Dir_Line_Accept
   500 539A A9 20			lda #' '
   501 539C 91 8A			sta (Name_Ptr),y
   502 539E C8				iny
   503 539F D0 F5			bne Parse_Pad_L1
   504
   505 53A1			Parse_Dir_Line_Accept
   506 53A1 A9 01			lda #$01							; Non-zero - a name was stored
   507 53A3 60				rts
   508 53A4			Parse_Dir_Line_Reject
   509 53A4 A9 00			lda #$00
   510 53A6 60				rts
   511
