   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 3FF3			Text_PutStrAt
   583 3FF3 A9 01			lda #$01
   584 3FF5 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 3FF8 A9 00			lda #$00
   587 3FFA 85 80			sta Reg1
   588 3FFC 85 81			sta Reg2
   589 3FFE AE B0 06			ldx Txt_Row
   590 4001 F0 0E			beq Text_PutStrAt_Col
   591 4003			Text_PutStrAt_RowL
   592 4003 A5 80			lda Reg1
   593 4005 18				clc
   594 4006 69 A0			adc #TEXT_PITCH
   595 4008 85 80			sta Reg1
   596 400A 90 02			bcc Text_PutStrAt_RowNC
   597 400C E6 81			inc Reg2
   598 400E			Text_PutStrAt_RowNC
   599 400E CA				dex
   600 400F D0 F2			bne Text_PutStrAt_RowL
   601 4011			Text_PutStrAt_Col
   602 4011 AD B1 06			lda Txt_Col
   603 4014 0A				asl									; Txt_Col * 2 (max 158)
   604 4015 18				clc
   605 4016 65 80			adc Reg1
   606 4018 85 80			sta Reg1
   607 401A 90 02			bcc Text_PutStrAt_ColNC
   608 401C E6 81			inc Reg2
   609 401E			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 401E A5 81			lda Reg2
   612 4020 29 10			and #$10							; offset bit 12 = "second bank"
   613 4022 F0 04			beq Text_PutStrAt_Bank0
   614 4024 A9 2B			lda #TEXT_BACK_BANK+1
   615 4026 D0 02			bne Text_PutStrAt_SetBank
   616 4028			Text_PutStrAt_Bank0
   617 4028 A9 2A			lda #TEXT_BACK_BANK
   618 402A			Text_PutStrAt_SetBank
   619 402A 8D B6 06			sta Txt_Bank
   620 402D A5 80			lda Reg1
   621 402F 85 88			sta Ptr_Lo
   622 4031 A5 81			lda Reg2
   623 4033 29 0F			and #$0F
   624 4035 18				clc
   625 4036 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 4038 85 89			sta Ptr_Hi
   627 403A AD B6 06			lda Txt_Bank
   628 403D 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 403F				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 403F A0 5F			ldy #<VBXE_MA_BSEL
     3 4041 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 4043 A9 00			lda #$00
   632 4045 85 82			sta Reg3							; Reg3 = source string index
   633 4047 AD B1 06			lda Txt_Col
   634 404A 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 404C			Text_PutStrAt_Char
   636 404C A5 83			lda Reg4
   637 404E C9 50			cmp #TEXT_COLS
   638 4050 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 4052 A4 82			ldy Reg3
   640 4054 B1 96			lda (Txt_Ptr),y
   641 4056 F0 43			beq Text_PutStrAt_Done
   642 4058 C9 01			cmp #TXT_PEN
   643 405A D0 0C			bne Text_PutStrAt_Glyph
   644 405C C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 405D B1 96			lda (Txt_Ptr),y
   646 405F 8D B4 06			sta Txt_Attr
   647 4062 C8				iny
   648 4063 84 82			sty Reg3							; skip both bytes, column unchanged
   649 4065 4C 4C 40			jmp Text_PutStrAt_Char
   650 4068			Text_PutStrAt_Glyph
   651 4068 A0 00			ldy #$00
   652 406A 91 88			sta (Ptr_Lo),y						; glyph byte
   653 406C C8				iny
   654 406D AD B4 06			lda Txt_Attr
   655 4070 91 88			sta (Ptr_Lo),y						; attribute byte
   656 4072 E6 82			inc Reg3
   657 4074 E6 83			inc Reg4
   658 4076 A5 88			lda Ptr_Lo							; window pointer += 2
   659 4078 18				clc
   660 4079 69 02			adc #$02
   661 407B 85 88			sta Ptr_Lo
   662 407D 90 02			bcc Text_PutStrAt_NoPage
   663 407F E6 89			inc Ptr_Hi
   664 4081			Text_PutStrAt_NoPage
   665 4081 A5 89			lda Ptr_Hi
   666 4083 C9 30			cmp #$30							; crossed out of the window -> next bank
   667 4085 90 C5			bcc Text_PutStrAt_Char
   668 4087 38				sec
   669 4088 E9 10			sbc #$10
   670 408A 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 408C EE B6 06			inc Txt_Bank
   672 408F AD B6 06			lda Txt_Bank
   673 4092 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 4094				vbsta VBXE_MA_BSEL
