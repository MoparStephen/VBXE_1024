  2065 				;-----------------------------------------------------------------------------
  2066 				; Selector_Sync_Cursor - pull the selector highlight back onto File_Index.
  2067 				; Space / Backspace (image view) and the slideshow move File_Index while an
  2068 				; image is on screen; call this before returning to the selector so its
  2069 				; highlight follows the picture you were actually looking at, scrolling the
  2070 				; grid if the entry is off-screen.  Shares Sel_Top_For_Index with the nav keys.
  2071 				;-----------------------------------------------------------------------------
  2072 5D5A			Selector_Sync_Cursor
  2073 5D5A AD 8B 04			lda ImageCount
  2074 5D5D 0D 8C 04			ora ImageCount+1
  2075 5D60 F0 18			beq Selector_Sync_Zero				; empty list - keep 0 / 0
  2076 5D62 AD 8A 04			lda File_Index
  2077 5D65 CD 8B 04			cmp ImageCount
  2078 5D68 90 06			bcc Selector_Sync_Set
  2079 5D6A AD 8B 04			lda ImageCount						; out of range (shouldn't happen) - clamp
  2080 5D6D 38				sec
  2081 5D6E E9 01			sbc #$01
  2082 5D70			Selector_Sync_Set
  2083 5D70 8D C7 04			sta Sel_Index
  2084 5D73 20 A6 5A			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  2085 5D76 8D C8 04			sta Sel_Top
  2086 5D79 60				rts
  2087 5D7A			Selector_Sync_Zero
  2088 5D7A A9 00			lda #$00
  2089 5D7C 8D C7 04			sta Sel_Index
  2090 5D7F 8D C8 04			sta Sel_Top
  2091 5D82 60				rts
