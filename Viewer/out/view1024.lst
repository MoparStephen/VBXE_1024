  1970 3CC6 A5 82			lda Reg3
  1971 3CC8 C5 84			cmp Reg5
  1972 3CCA B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1973
  1974 3CCC A5 82			lda Reg3
  1975 3CCE 20 38 3D			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1976 3CD1 20 08 3D			jsr Cmp_Records						; rec(m) : rec(j)
  1977 3CD4 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1978 3CD6 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1979 3CD8 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1980 3CDA 85 83			sta Reg4
  1981 3CDC A5 8C			lda Sort_Ptr
  1982 3CDE 85 8A			sta Name_Ptr
  1983 3CE0 A5 8D			lda Sort_Ptr + $01
  1984 3CE2 85 8B			sta Name_Ptr + $01
  1985 3CE4			Sort_Range_Inner_Next
  1986 3CE4 E6 82			inc Reg3
  1987 3CE6 4C C6 3C			jmp Sort_Range_Inner
  1988 3CE9			Sort_Range_Inner_Done
  1989 3CE9 A5 83			lda Reg4
  1990 3CEB C5 81			cmp Reg2
  1991 3CED F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1992 3CEF A5 81			lda Reg2
  1993 3CF1 20 38 3D			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1994 3CF4 A5 83			lda Reg4
  1995 3CF6 20 2C 3D			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1996 3CF9 20 16 3D			jsr Swap_Records
  1997 3CFC			Sort_Range_Outer_Next
  1998 3CFC E6 81			inc Reg2
  1999 3CFE 4C B4 3C			jmp Sort_Range_Outer
  2000
  2001 3D01			Sort_Range_Unmap
  2002 3D01 A9 00			lda #MEMAC_GLOBAL_DISABLE
