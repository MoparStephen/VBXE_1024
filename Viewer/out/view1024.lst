  1278 				;-----------------------------------------------------------------------------
  1279 				; UI_Format_Row - A = row type (from UI_RowType).  Rewrites Name_Row_Buf (which
  1280 				; holds the raw 8-byte record from UI_ReadRec) as a fixed 10-char space-padded
  1281 				; field + NUL:  file -> "NAME    " ; dir -> "<NAME....>" ; ".." -> ".."  .
  1282 				; A fixed width means scrolling onto a shorter entry leaves no stale glyphs.
  1283 				; Uses Txt_Line as scratch for the directory case.
  1284 				;-----------------------------------------------------------------------------
