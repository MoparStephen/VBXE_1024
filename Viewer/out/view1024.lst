   200 				;-----------------------------------------------------------------------------
   201 				; Build_Image_List - rebuild the selector list in IMAGE_BANK through the $2000
   202 				; window, grouped:  ".."  (only below the drive root)  |  sub-directories  |
   203 				; *.MAP files.  Rescan_Images sorts the two real groups A-Z afterwards.
   204 				; Sets ImageCount, Dir_Count and FileStart (index of the first *.MAP row).
   205 				;   - directory pass: OPEN "D[n]:PATH*.*" long DIR format (AUX2 = $80) and keep
   206 				;     only lines carrying SDX's "<DIR>" size-column tag (Line_Has_Dir_Tag).
   207 				;   - file pass:      OPEN "D[n]:PATH*.MAP" short format (AUX2 = $00) as before.
   208 				; One 8-byte write cursor (Name_Ptr) and one ImageNames_End guard span both.
   209 				;-----------------------------------------------------------------------------
   210 4B80			Build_Image_List
   211 4B80 A9 00			lda #$00
   212 4B82 8D 8B 04			sta ImageCount
   213 4B85 8D 8C 04			sta ImageCount+1
   214 4B88 8D D9 04			sta Dir_Count
   215
   216 4B8B A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   217 4B8D				vbsta VBXE_MA_BSEL
