  1561 5714 48				pha									; stash the new index
  1562 5715 AD C7 04			lda Sel_Index
  1563 5718 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1564 571A 68				pla
  1565 571B 8D C7 04			sta Sel_Index
  1566 571E 20 40 57			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1567 5721 CD C8 04			cmp Sel_Top
  1568 5724 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1569 5726 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1570 5729 20 51 51			jsr Selector_DrawList
  1571 572C 4C 3A 57			jmp Sel_Key_Nav_Done
  1572 572F			Sel_Nav_Apply_Rows
  1573 572F A5 87			lda Reg8
