  1117 				; UI_Format_Row - A = row type (from UI_RowType).  Rewrites Name_Row_Buf (which
  1118 				; holds the raw 8-byte record from UI_ReadRec) as a fixed 10-char space-padded
  1119 				; field + NUL:  file -> "NAME    " ; dir -> "<NAME....>" ; ".." -> ".."  .
