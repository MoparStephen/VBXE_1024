    93 3D83 A9 67			lda #<Text_Font_Data
    94 3D85 85 88			sta Ptr_Lo
    95 3D87 A9 41			lda #>Text_Font_Data
    96 3D89 85 89			sta Ptr_Hi
    97 3D8B A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3D8D 85 80			sta Reg1
    99 3D8F A9 20			lda #>VBXE_WINDOW
   100 3D91 85 81			sta Reg2
   101 3D93 20 05 3E			jsr Text_Copy_2K
   102
   103 3D96 A9 67			lda #<Atari_Font_Data
   104 3D98 85 88			sta Ptr_Lo
   105 3D9A A9 49			lda #>Atari_Font_Data
   106 3D9C 85 89			sta Ptr_Hi
   107 3D9E A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3DA0 85 80			sta Reg1
   109 3DA2 A9 28			lda #>[VBXE_WINDOW + $800]
   110 3DA4 85 81			sta Reg2
   111 3DA6 20 05 3E			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3DA9 A2 00			ldx #$00
   120 3DAB			Text_Load_Fonts_Remap
   121 3DAB BD E5 3D			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3DAE 20 D5 3D			jsr Text_Glyph_Addr
   123 3DB1 85 88			sta Ptr_Lo
   124 3DB3 84 89			sty Ptr_Hi
   125 3DB5 BD E6 3D			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3DB8 20 D5 3D			jsr Text_Glyph_Addr
   127 3DBB 85 80			sta Reg1
   128 3DBD 84 81			sty Reg2
   129 3DBF A0 07			ldy #$07
   130 3DC1			Text_Load_Fonts_Glyph
   131 3DC1 B1 88			lda (Ptr_Lo),y
   132 3DC3 91 80			sta (Reg1),y
   133 3DC5 88				dey
   134 3DC6 10 F9			bpl Text_Load_Fonts_Glyph
   135 3DC8 E8				inx
   136 3DC9 E8				inx
   137 3DCA E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3DCC D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3DCE A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3DD0				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
