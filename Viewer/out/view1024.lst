  1251 				;-----------------------------------------------------------------------------
  1252 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1253 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1254 				; equal) otherwise.
  1255 				;-----------------------------------------------------------------------------
  1256 382A			Cmp_Records
  1257 382A A0 00			ldy #$00
  1258 382C			Cmp_Records_L1
  1259 382C B1 8A			lda (Name_Ptr),y
  1260 382E D1 8C			cmp (Sort_Ptr),y
  1261 3830 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1262 3832 C8				iny
  1263 3833 C0 08			cpy #$08
  1264 3835 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1265 3837			Cmp_Records_Done
  1266 3837 60				rts
  1267
  1268 				;-----------------------------------------------------------------------------
  1269 				; Swap_Records - exchange the 8-byte records at (Name_Ptr) and (Sort_Ptr),
  1270 				; using Path_Buf as scratch.
  1271 				;-----------------------------------------------------------------------------
  1272 3838			Swap_Records
  1273 3838 A0 00			ldy #$00
  1274 383A			Swap_Records_L1
  1275 383A B1 8A			lda (Name_Ptr),y
  1276 383C 99 8D 04			sta Path_Buf,y
  1277 383F B1 8C			lda (Sort_Ptr),y
  1278 3841 91 8A			sta (Name_Ptr),y
  1279 3843 B9 8D 04			lda Path_Buf,y
  1280 3846 91 8C			sta (Sort_Ptr),y
  1281 3848 C8				iny
  1282 3849 C0 08			cpy #$08
  1283 384B 90 ED			bcc Swap_Records_L1
  1284 384D 60				rts
