  1954 				;=============================================================================
  1955 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  1956 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  1957 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  1958 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  1959 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  1960 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  1961 				;=============================================================================
  1962
  1963 				;-----------------------------------------------------------------------------
  1964 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  1965 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  1966 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  1967 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  1968 				; off screen.
  1969 				;-----------------------------------------------------------------------------
  1970 59AA			Info_Load
  1971 59AA A9 25			lda #NFO_BUF_BANK
  1972 59AC 85 8E			sta BankIndex
  1973 59AE 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  1974 59B1 AD 2D 31			lda LoadStatus
  1975 59B4 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  1976 59B6 20 BA 59			jsr Info_Count_Lines				; sets Nfo_LineCount
  1977 59B9			Info_Load_Ret
  1978 59B9 60				rts
  1979
  1980 				;-----------------------------------------------------------------------------
  1981 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  1982 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  1983 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  1984 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  1985 				; 160-byte step straddles a bank every ~25 records, handled inline.
  1986 				;-----------------------------------------------------------------------------
  1987 59BA			Info_Count_Lines
  1988 59BA A9 00			lda #$00
  1989 59BC 8D DE 04			sta Nfo_LineCount
  1990 59BF 8D DF 04			sta Nfo_LineCount + $01
  1991 59C2 A9 25			lda #NFO_BUF_BANK
  1992 59C4 8D 50 06			sta Nfo_WalkBank
  1993 59C7 09 80			ora #MEMAC_GLOBAL_ENABLE
  1994 59C9				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 59C9 A0 5F			ldy #<VBXE_MA_BSEL
     3 59CB 91 93			sta (VBXEBase),y
Source: ui.asm
  1995 59CD A9 00			lda #<VBXE_WINDOW
  1996 59CF 85 88			sta Ptr_Lo
  1997 59D1 A9 20			lda #>VBXE_WINDOW
  1998 59D3 85 89			sta Ptr_Hi
  1999 59D5			Info_Count_L1
  2000 59D5 A0 00			ldy #$00
  2001 59D7 B1 88			lda (Ptr_Lo),y
  2002 59D9 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2003 59DB EE DE 04			inc Nfo_LineCount
  2004 59DE AD DE 04			lda Nfo_LineCount
  2005 59E1 C9 7F			cmp #NFO_MAX_LINES
  2006 59E3 B0 24			bcs Info_Count_Done					; hit the record cap
  2007 59E5 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2008 59E7 18				clc
  2009 59E8 69 A0			adc #TEXT_PITCH
  2010 59EA 85 88			sta Ptr_Lo
  2011 59EC 90 E7			bcc Info_Count_L1
  2012 59EE E6 89			inc Ptr_Hi
  2013 59F0 A5 89			lda Ptr_Hi
  2014 59F2 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2015 59F4 90 DF			bcc Info_Count_L1
  2016 59F6 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2017 59F8 85 89			sta Ptr_Hi
  2018 59FA EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2019 59FD AD 50 06			lda Nfo_WalkBank
  2020 5A00 09 80			ora #MEMAC_GLOBAL_ENABLE
  2021 5A02				vbsta VBXE_MA_BSEL
