   171 3B43			Text_Copy_2K_L1
   172 3B43 B1 88			lda (Ptr_Lo),y
   173 3B45 91 80			sta (Reg1),y
   174 3B47 C8				iny
   175 3B48 D0 F9			bne Text_Copy_2K_L1
   176 3B4A E6 89			inc Ptr_Hi
   177 3B4C E6 81			inc Reg2
   178 3B4E CA				dex
   179 3B4F D0 F2			bne Text_Copy_2K_L1
   180 3B51 60				rts
