   754 				;-----------------------------------------------------------------------------
   755 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner pixel data
   756 				; (D:MENU.RAW - the logo) into dedicated, resident VRAM - never touched by Load_Image,
   757 				; and never reloaded from disk again after this one call, since the banner
   758 				; never changes at runtime.  Blank-fills any banner target whose file is
   759 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   760 				; no disk file - its 160-byte pattern table is assembly-embedded straight into
   761 				; MENU_SEP_VRAM at load time (Load_Menu_Sep, init_vbxe.asm).  The banner's palette (registers 1-3) is no longer a disk
   762 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   763 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   764 				; Enter_Selector.
   765 				;-----------------------------------------------------------------------------
   766 34DE			Load_Menu_Banner_Raw
   767 				; The ANTIC loading screen is still up (start: turns DMA off afterwards), so
   768 				; this load reports on it like the init stages: message on row 3, then the
   769 				; 8th stage's progress dots.  Reg1 (the init stages' dot pointer) doesn't
   770 				; survive Text_Init, so the dots go at the fixed position after the 7 init
   771 				; stages.  There is no MENU.MAP: the banner is all palette 0, and its
   772 				; attribute map (MENU_BANNER_MAP_VRAM) is already all zeros from the boot-time
   773 				; clear_vbxe - Set_Menu_Demo_Attrs sets just the ramp squares' cells.
   774 34DE A5 58			lda SAVMSC
   775 34E0 85 88			sta Ptr_Lo
   776 34E2 A5 59			lda SAVMSC+1
   777 34E4 85 89			sta Ptr_Hi
   778 34E6 A0 79			ldy #LOAD_MSG_ROW3
   779 34E8 A2 00			ldx #$00
   780 34EA			Load_Menu_Banner_Msg_L1
   781 34EA BD 23 35			lda Load_Menu_Banner_Message,x
   782 34ED 91 88			sta (Ptr_Lo),y
   783 34EF E8				inx
   784 34F0 C8				iny
   785 34F1 E0 21			cpx #$21							; Copy $21 characters
   786 34F3 D0 F5			bne Load_Menu_Banner_Msg_L1
   787
   788 34F5 A9 C1			lda #<Menu_Banner_Raw_Name
   789 34F7 8D 28 31			sta FileNamePtr
   790 34FA A9 37			lda #>Menu_Banner_Raw_Name
   791 34FC 8D 29 31			sta FileNamePtr + $01
   792 34FF A9 30			lda #MENU_BANNER_BANK
   793 3501 85 8E			sta BankIndex
   794 3503 20 AA 30			jsr LoadData
   795 3506 AD 2D 31			lda LoadStatus
   796 3509 D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   797 350B 20 98 37			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   798
   799 350E			Load_Menu_Banner_Raw_Sep
   800 				; Progress dots - re-read SAVMSC, since LoadData doesn't preserve Ptr_Lo/Hi
   801 350E A5 58			lda SAVMSC
   802 3510 85 88			sta Ptr_Lo
   803 3512 A5 59			lda SAVMSC+1
   804 3514 85 89			sta Ptr_Hi
   805 3516 A0 E8			ldy #LOAD_DOTS_START + (7 * NUM_DOTS)
   806 3518 A9 54			lda #$54							; Screen RAM code for Ctrl+T
   807 351A A2 04			ldx #NUM_DOTS						; Number of dots to write
   808 351C			Load_Menu_Banner_Dots_L1
   809 351C 91 88			sta (Ptr_Lo),y
   810 351E C8				iny
   811 351F CA				dex
   812 3520 D0 FA			bne Load_Menu_Banner_Dots_L1
   813
   814 3522 60				rts									; The separator is already in VRAM (Load_Menu_Sep).
   815 														; Apply_Menu_Banner_Palette isn't called here -
   816 														; Enter_Selector always calls it before the first frame
   817
   818 3523			Load_Menu_Banner_Message
   819 3523 2C 6F 61 64 69 6E + 	.sb 'Loading menu logo MENU.RAW        '
   820
   821 				;-----------------------------------------------------------------------------
   822 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   823 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   824 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   825 				; for text).  Called once at boot (above) and from every Enter_Selector
   826 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   827 				; viewed in between and there is no way to avoid that hardware-register
   828 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   829 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
   830 				;-----------------------------------------------------------------------------
   831 3545			Apply_Menu_Banner_Palette
   832 3545 A9 B4			lda #(MENU_BANNER_PAL_VRAM / $1000) | MEMAC_GLOBAL_ENABLE
