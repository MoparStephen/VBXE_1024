  2215 				;=============================================================================
  2216 				; Shared directory helpers
  2217 				;-----------------------------------------------------------------------------
  2218 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2219 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2220 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2221 				; navigation lives in the selector itself.
  2222 				;=============================================================================
  2223
  2224 				;-----------------------------------------------------------------------------
  2225 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2226 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2227 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2228 				;-----------------------------------------------------------------------------
  2229 5B50			Line_Has_Dir_Tag
  2230 5B50 A2 00			ldx #$00
  2231 5B52			Line_Has_Dir_Tag_L1
  2232 5B52 BD 00 06			lda Dir_Line_Buf,x
  2233 5B55 C9 3C			cmp #'<'
  2234 5B57 D0 1F			bne Line_Has_Dir_Tag_Next
  2235 5B59 BD 01 06			lda Dir_Line_Buf+1,x
  2236 5B5C C9 44			cmp #'D'
  2237 5B5E D0 18			bne Line_Has_Dir_Tag_Next
  2238 5B60 BD 02 06			lda Dir_Line_Buf+2,x
  2239 5B63 C9 49			cmp #'I'
  2240 5B65 D0 11			bne Line_Has_Dir_Tag_Next
  2241 5B67 BD 03 06			lda Dir_Line_Buf+3,x
  2242 5B6A C9 52			cmp #'R'
  2243 5B6C D0 0A			bne Line_Has_Dir_Tag_Next
  2244 5B6E BD 04 06			lda Dir_Line_Buf+4,x
  2245 5B71 C9 3E			cmp #'>'
  2246 5B73 D0 03			bne Line_Has_Dir_Tag_Next
  2247 5B75 A9 01			lda #$01							; found
  2248 5B77 60				rts
  2249 5B78			Line_Has_Dir_Tag_Next
  2250 5B78 E8				inx
  2251 5B79 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2252 5B7B 90 D5			bcc Line_Has_Dir_Tag_L1
  2253 5B7D A9 00			lda #$00							; not found
  2254 5B7F 60				rts
  2255
  2256 				;-----------------------------------------------------------------------------
  2257 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2258 				; space-padded).  Refuses if the result would not fit.
  2259 				;-----------------------------------------------------------------------------
  2260 5B80			Folder_Path_Push
  2261 5B80 A2 00			ldx #$00
  2262 5B82			Folder_Path_Push_End
  2263 5B82 BD 28 06			lda Scan_Path,x
  2264 5B85 F0 06			beq Folder_Path_Push_Name
  2265 5B87 E8				inx
  2266 5B88 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2267 5B8A 90 F6			bcc Folder_Path_Push_End
  2268 5B8C 60				rts									; path too long already - refuse
  2269 5B8D			Folder_Path_Push_Name
  2270 5B8D A0 00			ldy #$00
  2271 5B8F			Folder_Path_Push_L1
  2272 5B8F B9 CD 04			lda Name_Row_Buf,y
  2273 5B92 F0 0D			beq Folder_Path_Push_Sep
  2274 5B94 C9 20			cmp #' '
  2275 5B96 F0 09			beq Folder_Path_Push_Sep
  2276 5B98 9D 28 06			sta Scan_Path,x
  2277 5B9B E8				inx
  2278 5B9C C8				iny
  2279 5B9D C0 08			cpy #$08
  2280 5B9F 90 EE			bcc Folder_Path_Push_L1
  2281 5BA1			Folder_Path_Push_Sep
  2282 5BA1 A9 3E			lda #'>'
  2283 5BA3 9D 28 06			sta Scan_Path,x
  2284 5BA6 E8				inx
  2285 5BA7 A9 00			lda #$00
  2286 5BA9 9D 28 06			sta Scan_Path,x
  2287 5BAC 60				rts
  2288
  2289 				;-----------------------------------------------------------------------------
  2290 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2291 				;-----------------------------------------------------------------------------
  2292 5BAD			Path_Pop_Segment
  2293 5BAD A2 00			ldx #$00
  2294 5BAF			Path_Pop_End
  2295 5BAF BD 28 06			lda Scan_Path,x
  2296 5BB2 F0 05			beq Path_Pop_Found
  2297 5BB4 E8				inx
  2298 5BB5 E0 28			cpx #$28
  2299 5BB7 90 F6			bcc Path_Pop_End
  2300 5BB9			Path_Pop_Found							; X = index of the NUL
  2301 5BB9 E0 00			cpx #$00
  2302 5BBB F0 13			beq Path_Pop_Done					; already empty
  2303 5BBD CA				dex									; step onto the trailing '>'
  2304 5BBE			Path_Pop_L1
  2305 5BBE E0 00			cpx #$00
  2306 5BC0 F0 09			beq Path_Pop_Cut
  2307 5BC2 CA				dex
  2308 5BC3 BD 28 06			lda Scan_Path,x
  2309 5BC6 C9 3E			cmp #'>'
  2310 5BC8 D0 F4			bne Path_Pop_L1
  2311 5BCA E8				inx									; keep this separator
  2312 5BCB			Path_Pop_Cut
  2313 5BCB A9 00			lda #$00
  2314 5BCD 9D 28 06			sta Scan_Path,x
  2315 5BD0			Path_Pop_Done
  2316 5BD0 60				rts
  2317
  2318 				;=============================================================================
  2319 				; UI strings  (ATASCII; the text renderer maps to internal codes)
  2320 				;=============================================================================
  2321 5BD1 4C 6F 63 61 74 69 + UI_Str_Loc			dta c'Location: ',0
  2322 5BDC 28 6E 6F 20 69 6D + UI_Str_Empty		dta c'(no images found here)',0
  2323 5BF3 53 6C 69 64 65 73 + UI_Str_Delay		dta c'Slideshow delay: ',0
  2324 5C05 73 20 20 20 20 2C + UI_Str_DelayHint	dta c's    , shorter    . longer',0
  2325 5C20 55 70 2F 44 6E 20 + UI_Str_Legend		dta c'Up/Dn move  ENTER open  S slide  D drive  P pal  I info  F font  Q quit',0
  2326 5C68 45 73 63 20 74 6F + UI_Str_InfoHint		dta c'Esc to go back, Up/Down to scroll',0
  2327 5C8A 53 63 61 6E 20 64 + UI_Str_DriveTitle	dta c'Scan drive',0
  2328 5C95 41 72 65 20 79 6F + UI_Str_QuitConfirm	dta c'Are you sure to Quit',0
  2329 5CAA 28 59 2F 4E 29 00	UI_Str_QuitHint		dta c'(Y/N)',0
  2330 5CB0 53 72 63 3A 20 00	UI_Str_Src			dta c'Src: ',0
  2331 5CB6 20 20 20 20 20 20 + UI_Str_StatusBlank	dta c'                                                                                ',0	; 80 spaces (Src: + NFO_NAME_CAP)
  2332
  2333 				;-----------------------------------------------------------------------------
  2334 				; Sel_ColX - screen column for grid column c (0..UI_COLS-1), 10-char cells.
  2335 				; Indexed by (list index AND [UI_COLS-1]).  Relocate the whole grid by
  2336 				; changing UI_GRIDCOL0 alone.
  2337 				;-----------------------------------------------------------------------------
  2338 5D07 00 0A 14 1E		Sel_ColX	dta UI_GRIDCOL0+0, UI_GRIDCOL0+10, UI_GRIDCOL0+20, UI_GRIDCOL0+30
  2339 5D0B 28 32 3C 46					dta UI_GRIDCOL0+40, UI_GRIDCOL0+50, UI_GRIDCOL0+60, UI_GRIDCOL0+70
