   258 				;-----------------------------------------------------------------------------
   259 				; Build_Image_List - rebuild the selector list in IMAGE_BANK through the $2000
   260 				; window, grouped:  ".."  (only below the drive root)  |  sub-directories  |
   261 				; *.V1K files.  Rescan_Images sorts the two real groups A-Z afterwards.
   262 				; Sets ImageCount, Dir_Count and FileStart (index of the first *.V1K row).
   263 				;   - directory pass: OPEN "D[n]:PATH*.*" long DIR format (AUX2 = $80) and keep
   264 				;     only lines carrying SDX's "<DIR>" size-column tag (Line_Has_Dir_Tag).
   265 				;   - file pass:      OPEN "D[n]:PATH*.V1K" short format (AUX2 = $00) as before.
   266 				; One 8-byte write cursor (Name_Ptr) and one ImageNames_End guard span both.
   267 				;-----------------------------------------------------------------------------
   268 4F4B			Build_Image_List
   269 4F4B A9 00			lda #$00
   270 4F4D 8D 8B 04			sta ImageCount
   271 4F50 8D 8C 04			sta ImageCount+1
   272 4F53 8D D9 04			sta Dir_Count
   273
   274 4F56 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   275 4F58				vbsta VBXE_MA_BSEL
