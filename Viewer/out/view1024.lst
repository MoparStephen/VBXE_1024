  2199 5EB2 20 9C 60			jsr Info_Load						; stream into NFO_BUF_VRAM, count records
  2200 5EB5 AD 2D 31			lda LoadStatus
  2201 5EB8 D0 03			bne Selector_Handle_I_Show
  2202 5EBA 4C 01 55			jmp Selector_Restore_LocRow			; OPEN failed (no .nfo) - selector stays up (tail)
  2203 5EBD			Selector_Handle_I_Show
  2204 5EBD A9 00			lda #$00
