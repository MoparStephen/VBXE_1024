   180 3927 AD B2 06			lda Txt_Fg
   181 392A 29 7F			and #$7F
   182 392C AE B3 06			ldx Txt_Bg
   183 392F F0 02			beq Make_Attr_Done
   184 3931 09 80			ora #$80
   185 3933			Make_Attr_Done
   186 3933 60				rts
