   161 				;VBXE_Detect - detects VBXE FX core version 1.07 and above,
   162 				; and stores VBXE Base address in VBXEBase
   163 312E			VBXE_Detect
   164 312E A9 00			lda #$00
   165 3130 A2 D6			ldx #$D6
   166 3132 8D 40 D6			sta $D640							; Make sure it isn't coincidence
   167 3135 AD 40 D6			lda $D640
   168 3138 C9 10			cmp #$10							; Do we have major version here?
   169 313A F0 15			beq VBXE_Detected					; If so, then VBXE is detected
   170 313C A9 00			lda #$00
   171 313E E8				inx
   172 313F 8D 40 D7			sta $D740							; No such luck, try other location
   173 3142 AD 40 D7			lda $D740
   174 3145 C9 10			cmp #$10
   175 3147 F0 08			beq VBXE_Detected
   176 3149 A2 00			ldx #$00							; Not here, so not present or FX core version too low
   177 314B 86 94			stx VBXEBase+1
   178 314D 86 93			stx VBXEBase
   179 314F 38				sec
   180 3150 60				rts
   181 3151			VBXE_Detected:
   182 3151 86 94			stx VBXEBase+1
   183 3153 A9 00			lda #$00
   184 3155 85 93			sta VBXEBase
   185 3157				vblda VBXE_MINOR					; Get core minor version
Macro: VBLDA [Source: vbxe_min.asm]
