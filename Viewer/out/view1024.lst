   315 3ED6 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   316 3ED8 A9 01			lda #$01
   317 3EDA 8D B7 06			sta Txt_Dirty
   318 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
