  2218 				;=============================================================================
  2219 				; Shared directory helpers
  2220 				;-----------------------------------------------------------------------------
  2221 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2222 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2223 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2224 				; navigation lives in the selector itself.
  2225 				;=============================================================================
  2226
  2227 				;-----------------------------------------------------------------------------
  2228 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2229 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2230 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2231 				;-----------------------------------------------------------------------------
  2232 5A7E			Line_Has_Dir_Tag
  2233 5A7E A2 00			ldx #$00
  2234 5A80			Line_Has_Dir_Tag_L1
  2235 5A80 BD 00 06			lda Dir_Line_Buf,x
  2236 5A83 C9 3C			cmp #'<'
  2237 5A85 D0 1F			bne Line_Has_Dir_Tag_Next
  2238 5A87 BD 01 06			lda Dir_Line_Buf+1,x
  2239 5A8A C9 44			cmp #'D'
  2240 5A8C D0 18			bne Line_Has_Dir_Tag_Next
  2241 5A8E BD 02 06			lda Dir_Line_Buf+2,x
  2242 5A91 C9 49			cmp #'I'
  2243 5A93 D0 11			bne Line_Has_Dir_Tag_Next
  2244 5A95 BD 03 06			lda Dir_Line_Buf+3,x
  2245 5A98 C9 52			cmp #'R'
  2246 5A9A D0 0A			bne Line_Has_Dir_Tag_Next
  2247 5A9C BD 04 06			lda Dir_Line_Buf+4,x
  2248 5A9F C9 3E			cmp #'>'
  2249 5AA1 D0 03			bne Line_Has_Dir_Tag_Next
  2250 5AA3 A9 01			lda #$01							; found
  2251 5AA5 60				rts
  2252 5AA6			Line_Has_Dir_Tag_Next
  2253 5AA6 E8				inx
  2254 5AA7 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2255 5AA9 90 D5			bcc Line_Has_Dir_Tag_L1
  2256 5AAB A9 00			lda #$00							; not found
  2257 5AAD 60				rts
  2258
  2259 				;-----------------------------------------------------------------------------
  2260 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2261 				; space-padded).  Refuses if the result would not fit.
  2262 				;-----------------------------------------------------------------------------
  2263 5AAE			Folder_Path_Push
