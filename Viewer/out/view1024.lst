  2253 58B3			Folder_Path_Push_Sep
  2254 58B3 A9 3E			lda #'>'
  2255 58B5 9D 28 06			sta Scan_Path,x
  2256 58B8 E8				inx
  2257 58B9 A9 00			lda #$00
  2258 58BB 9D 28 06			sta Scan_Path,x
  2259 58BE 60				rts
