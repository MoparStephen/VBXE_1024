  2412 				;-----------------------------------------------------------------------------
  2413 				; Slideshow_Reload_Counter - Slide_FrameCtr = Slide_Secs * framerate
  2414 				;   framerate = 50 (PAL, Video_Flag = 0) or 60 (NTSC, Video_Flag = 1)
  2415 				;-----------------------------------------------------------------------------
  2416 5CE5			Slideshow_Reload_Counter
  2417 5CE5 A9 00			lda #$00
  2418 5CE7 8D CA 04			sta Slide_FrameCtr
  2419 5CEA 8D CB 04			sta Slide_FrameCtr+1
  2420 5CED AE C9 04			ldx Slide_Secs
  2421 5CF0 F0 1E			beq Slideshow_Reload_Done
  2422 5CF2 AD 89 04			lda Video_Flag
  2423 5CF5 D0 04			bne Slideshow_Reload_NTSC
  2424 5CF7 A9 32			lda #50
  2425 5CF9 D0 02			bne Slideshow_Reload_Set
  2426 5CFB			Slideshow_Reload_NTSC
  2427 5CFB A9 3C			lda #60
  2428 5CFD			Slideshow_Reload_Set
  2429 5CFD 85 80			sta Reg1							; Reg1 = frames to add per second
  2430 5CFF			Slideshow_Reload_L1
  2431 5CFF 18				clc
  2432 5D00 AD CA 04			lda Slide_FrameCtr
  2433 5D03 65 80			adc Reg1
  2434 5D05 8D CA 04			sta Slide_FrameCtr
  2435 5D08 90 03			bcc Slideshow_Reload_NoCarry
  2436 5D0A EE CB 04			inc Slide_FrameCtr+1
  2437 5D0D			Slideshow_Reload_NoCarry
  2438 5D0D CA				dex
  2439 5D0E D0 EF			bne Slideshow_Reload_L1
  2440 5D10			Slideshow_Reload_Done
  2441 5D10 60				rts
