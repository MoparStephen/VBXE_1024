   123 				; Toggle_Font - flip the text screen between the CGA ($44) and Atari ($45)
   124 				; font by rewriting the two XDLC_CHBASE bytes (main + footer text blocks) in
   125 				; XDL_MainMenu.  The VBXE re-reads the XDL each frame, so the change shows on
   126 				; the next frame with no redraw.  Called from Handle_Keys on the F key, from
   127 				; any screen.
   128 				;-----------------------------------------------------------------------------
   129 380A			Toggle_Font
   130 380A AD E0 04			lda Font_Sel
   131 380D 49 01			eor #$01
   132 380F 8D E0 04			sta Font_Sel
   133 3812 18				clc
   134 3813 69 44			adc #TEXT_CHBASE					; 0 -> $44 (CGA) / 1 -> $45 (Atari)
   135 3815 AA				tax									; hold it - vbsta clobbers A (and Y)
   136 3816 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the $2000 window
   137 3818				vbsta VBXE_MA_BSEL
