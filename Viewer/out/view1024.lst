  1041 51E8 18				clc
  1042 51E9 69 00			adc #<ImageNames
  1043 51EB 85 88			sta Ptr_Lo
  1044 51ED A5 89			lda Ptr_Hi
  1045 51EF 69 20			adc #>ImageNames
  1046 51F1 85 89			sta Ptr_Hi
  1047 51F3 A0 00			ldy #$00
  1048 51F5			Nfo_Name_Match_Cmp
  1049 51F5 B1 88			lda (Ptr_Lo),y
  1050 51F7 D9 B7 06			cmp Nfo_Name_Line,y
