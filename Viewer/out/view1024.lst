   193 4EE5 E8				inx
   194 4EE6 C8				iny
   195 4EE7 C0 28			cpy #$28
   196 4EE9 90 F2			bcc Build_Spec_Prefix_L1
   197 4EEB			Build_Spec_Prefix_Done
   198 4EEB 60				rts
   199
   200 4EEC			Build_Spec								; ... + "*.V1K" + EOL
   201 4EEC 20 C4 4E			jsr Build_Spec_Prefix
   202 4EEF A0 00			ldy #$00
   203 4EF1			Build_Spec_L1
   204 4EF1 B9 22 4F			lda Build_Spec_ImgWild,y
   205 4EF4 9D 50 06			sta Scan_Spec,x
   206 4EF7 E8				inx
   207 4EF8 C8				iny
