  2628 				; TXT_PEN,<pen> switches colour mid-string and takes no column (text80.asm),
  2629 				; so these lay out exactly as their plain text.
  2630 5E81 4C 6F 63 61 74 69 + UI_Str_Loc			dta c'Location: ',0	; drawn in UI_PEN_LOC, the same pen as the path
