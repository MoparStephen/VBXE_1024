  2747 				;=============================================================================
  2748 				; Shared directory helpers
  2749 				;-----------------------------------------------------------------------------
  2750 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2751 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2752 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2753 				; navigation lives in the selector itself.
  2754 				;=============================================================================
  2755
  2756 				;-----------------------------------------------------------------------------
  2757 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2758 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2759 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2760 				;-----------------------------------------------------------------------------
  2761 5F8E			Line_Has_Dir_Tag
  2762 5F8E A2 00			ldx #$00
  2763 5F90			Line_Has_Dir_Tag_L1
  2764 5F90 BD 00 06			lda Dir_Line_Buf,x
  2765 5F93 C9 3C			cmp #'<'
  2766 5F95 D0 1F			bne Line_Has_Dir_Tag_Next
  2767 5F97 BD 01 06			lda Dir_Line_Buf+1,x
  2768 5F9A C9 44			cmp #'D'
  2769 5F9C D0 18			bne Line_Has_Dir_Tag_Next
  2770 5F9E BD 02 06			lda Dir_Line_Buf+2,x
  2771 5FA1 C9 49			cmp #'I'
  2772 5FA3 D0 11			bne Line_Has_Dir_Tag_Next
  2773 5FA5 BD 03 06			lda Dir_Line_Buf+3,x
  2774 5FA8 C9 52			cmp #'R'
  2775 5FAA D0 0A			bne Line_Has_Dir_Tag_Next
  2776 5FAC BD 04 06			lda Dir_Line_Buf+4,x
  2777 5FAF C9 3E			cmp #'>'
  2778 5FB1 D0 03			bne Line_Has_Dir_Tag_Next
  2779 5FB3 A9 01			lda #$01							; found
  2780 5FB5 60				rts
  2781 5FB6			Line_Has_Dir_Tag_Next
  2782 5FB6 E8				inx
  2783 5FB7 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2784 5FB9 90 D5			bcc Line_Has_Dir_Tag_L1
  2785 5FBB A9 00			lda #$00							; not found
  2786 5FBD 60				rts
  2787
  2788 				;-----------------------------------------------------------------------------
  2789 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2790 				; space-padded).  Refuses if the result would not fit.
  2791 				;-----------------------------------------------------------------------------
  2792 5FBE			Folder_Path_Push
  2793 5FBE A2 00			ldx #$00
  2794 5FC0			Folder_Path_Push_End
  2795 5FC0 BD 28 06			lda Scan_Path,x
  2796 5FC3 F0 06			beq Folder_Path_Push_Name
  2797 5FC5 E8				inx
  2798 5FC6 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2799 5FC8 90 F6			bcc Folder_Path_Push_End
  2800 5FCA 60				rts									; path too long already - refuse
  2801 5FCB			Folder_Path_Push_Name
  2802 5FCB A0 00			ldy #$00
  2803 5FCD			Folder_Path_Push_L1
  2804 5FCD B9 CD 04			lda Name_Row_Buf,y
  2805 5FD0 F0 0D			beq Folder_Path_Push_Sep
  2806 5FD2 C9 20			cmp #' '
  2807 5FD4 F0 09			beq Folder_Path_Push_Sep
  2808 5FD6 9D 28 06			sta Scan_Path,x
  2809 5FD9 E8				inx
  2810 5FDA C8				iny
  2811 5FDB C0 08			cpy #$08
  2812 5FDD 90 EE			bcc Folder_Path_Push_L1
  2813 5FDF			Folder_Path_Push_Sep
  2814 5FDF A9 3E			lda #'>'
  2815 5FE1 9D 28 06			sta Scan_Path,x
  2816 5FE4 E8				inx
  2817 5FE5 A9 00			lda #$00
  2818 5FE7 9D 28 06			sta Scan_Path,x
  2819 5FEA 60				rts
  2820
  2821 				;-----------------------------------------------------------------------------
  2822 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2823 				;-----------------------------------------------------------------------------
  2824 5FEB			Path_Pop_Segment
  2825 5FEB A2 00			ldx #$00
  2826 5FED			Path_Pop_End
  2827 5FED BD 28 06			lda Scan_Path,x
  2828 5FF0 F0 05			beq Path_Pop_Found
  2829 5FF2 E8				inx
  2830 5FF3 E0 28			cpx #$28
  2831 5FF5 90 F6			bcc Path_Pop_End
  2832 5FF7			Path_Pop_Found							; X = index of the NUL
  2833 5FF7 E0 00			cpx #$00
  2834 5FF9 F0 13			beq Path_Pop_Done					; already empty
  2835 5FFB CA				dex									; step onto the trailing '>'
  2836 5FFC			Path_Pop_L1
  2837 5FFC E0 00			cpx #$00
  2838 5FFE F0 09			beq Path_Pop_Cut
  2839 6000 CA				dex
  2840 6001 BD 28 06			lda Scan_Path,x
  2841 6004 C9 3E			cmp #'>'
  2842 6006 D0 F4			bne Path_Pop_L1
  2843 6008 E8				inx									; keep this separator
  2844 6009			Path_Pop_Cut
  2845 6009 A9 00			lda #$00
  2846 600B 9D 28 06			sta Scan_Path,x
  2847 600E			Path_Pop_Done
  2848 600E 60				rts
