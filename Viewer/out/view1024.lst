  2841 624C CA				dex									; step onto the trailing '>'
  2842 624D			Path_Pop_L1
  2843 624D E0 00			cpx #$00
  2844 624F F0 09			beq Path_Pop_Cut
  2845 6251 CA				dex
  2846 6252 BD 28 06			lda Scan_Path,x
