  2489 5FE5 A9 00			lda #<VBXE_WINDOW
  2490 5FE7 85 88			sta Ptr_Lo
  2491 5FE9 A9 20			lda #>VBXE_WINDOW
  2492 5FEB 85 89			sta Ptr_Hi
  2493 5FED			Info_Count_L1
  2494 5FED A0 00			ldy #$00
  2495 5FEF B1 88			lda (Ptr_Lo),y
  2496 5FF1 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2497 5FF3 EE DE 04			inc Nfo_LineCount
  2498 5FF6 AD DE 04			lda Nfo_LineCount
  2499 5FF9 C9 7F			cmp #NFO_MAX_LINES
  2500 5FFB B0 24			bcs Info_Count_Done					; hit the record cap
  2501 5FFD A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2502 5FFF 18				clc
  2503 6000 69 A0			adc #TEXT_PITCH
  2504 6002 85 88			sta Ptr_Lo
  2505 6004 90 E7			bcc Info_Count_L1
  2506 6006 E6 89			inc Ptr_Hi
  2507 6008 A5 89			lda Ptr_Hi
  2508 600A C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2509 600C 90 DF			bcc Info_Count_L1
  2510 600E E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2511 6010 85 89			sta Ptr_Hi
  2512 6012 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2513 6015 AD 50 06			lda Nfo_WalkBank
  2514 6018 09 80			ora #MEMAC_GLOBAL_ENABLE
  2515 601A				vbsta VBXE_MA_BSEL
