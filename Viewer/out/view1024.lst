  1411 				;-----------------------------------------------------------------------------
  1412 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1413 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1414 				; crosses the visible window, else just re-colours the old and new cells;
  1415 				; always repaints the status line, then returns to the key loop.
  1416 				;-----------------------------------------------------------------------------
  1417 541C			Sel_Nav_Apply
  1418 541C 48				pha									; stash the new index
  1419 541D AD C7 04			lda Sel_Index
  1420 5420 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1421 5422 68				pla
  1422 5423 8D C7 04			sta Sel_Index
  1423 5426 20 48 54			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1424 5429 CD C8 04			cmp Sel_Top
  1425 542C F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1426 542E 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1427 5431 20 1F 4F			jsr Selector_DrawList
  1428 5434 4C 42 54			jmp Sel_Key_Nav_Done
  1429 5437			Sel_Nav_Apply_Rows
  1430 5437 A5 87			lda Reg8
  1431 5439 20 D2 4F			jsr Selector_HiRow					; un-highlight the cell we left
  1432 543C AD C7 04			lda Sel_Index
  1433 543F 20 D2 4F			jsr Selector_HiRow					; highlight the cell we moved to
  1434 5442			Sel_Key_Nav_Done
  1435 5442 20 89 50			jsr Selector_DrawStatus				; row 20: source name of the new row
  1436 5445 4C A0 36			jmp Read_Key_Done
