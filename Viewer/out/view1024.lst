   638 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   639 				;  Out: C=1 on a read error / short file.
   640 				;-----------------------------------------------------------------------------
   641 3430			Image_Read_Pal
   642 3430 A9 21			lda #V1K_PAL_BANK
   643 3432 A2 00			ldx #V1K_PAL_LEN / $1000
   644 3434 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   645 3436 8C E5 04			sty Seg_Tail
   646 3439 A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   647 343B 8C E6 04			sty Seg_Tail + $01
   648 343E 4C 72 34			jmp Image_Read_Segment
