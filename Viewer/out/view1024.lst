  1178 				;-----------------------------------------------------------------------------
  1179 				; Sort_Range - in-place alphabetical selection sort of the records
  1180 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1181 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1182 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1183 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1184 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1185 				;-----------------------------------------------------------------------------
  1186 37BE			Sort_Range
  1187 37BE E0 02			cpx #$02
  1188 37C0 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1189 37C2 85 81			sta Reg2							; Reg2 = i = start
  1190 37C4 86 82			stx Reg3							; Reg3 = count (temp)
  1191 37C6 18				clc
  1192 37C7 65 82			adc Reg3
  1193 37C9 85 84			sta Reg5							; Reg5 = end = start + count
  1194 37CB 38				sec
  1195 37CC E9 01			sbc #$01
  1196 37CE 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1197
  1198 37D0 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1199 37D2				vbsta VBXE_MA_BSEL
