   874 				;-----------------------------------------------------------------------------
   875 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
   876 				; address, its VBXE bank ($2A..$2D) mapped in.  slot byte offset = Ord * 64:
   877 				; bank = $2A + (Ord >> 6), window page = $20 + ((Ord >> 2) & 15),
   878 				; window low = (Ord & 3) << 6.  (64 divides 4K, so a slot never straddles.)
   879 				;-----------------------------------------------------------------------------
   880 5017			Nfo_Name_MapSlot
   881 5017 AD E1 04			lda Nfo_Name_Ord
   882 501A 0A				asl
   883 501B 0A				asl
   884 501C 0A				asl
   885 501D 0A				asl
   886 501E 0A				asl
   887 501F 0A				asl									; A = (Ord & 3) << 6
   888 5020 85 88			sta Ptr_Lo
   889 5022 AD E1 04			lda Nfo_Name_Ord
   890 5025 4A				lsr
   891 5026 4A				lsr
   892 5027 29 0F			and #$0F							; (Ord >> 2) & 15
   893 5029 18				clc
   894 502A 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   895 502C 85 89			sta Ptr_Hi
   896 502E AD E1 04			lda Nfo_Name_Ord
   897 5031 4A				lsr
   898 5032 4A				lsr
   899 5033 4A				lsr
   900 5034 4A				lsr
   901 5035 4A				lsr
   902 5036 4A				lsr									; Ord >> 6  (0..3)
   903 5037 18				clc
   904 5038 69 2A			adc #NFO_NAME_BANK
   905 503A 09 80			ora #MEMAC_GLOBAL_ENABLE
   906 503C				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 503C A0 5F			ldy #<VBXE_MA_BSEL
     3 503E 91 93			sta (VBXEBase),y
Source: ui.asm
