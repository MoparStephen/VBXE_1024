   712 3472 9D 4A 03			sta ICAX1,x
   713 3475 A9 00			lda #$00
   714 3477 9D 4B 03			sta ICAX2,x
   715 347A A9 03			lda #CIO_open
   716 347C 9D 42 03			sta ICCOM,x
   717 347F AD 28 31			lda FileNamePtr
