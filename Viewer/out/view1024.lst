   171 3313 AD 00 A0			lda $A000							; Check if BASIC ROM area is now RAM
   172 3316 EE 00 A0			inc $A000							; This will also catch SDX not launching
   173 3319 CD 00 A0			cmp $A000							; The app via X
   174 331C F0 21			beq Ram_Not_Ok						; If not, perform print error and exit
   175
   176 331E A9 0C			lda #$0C							; 12 = CLOSE
   177 3320 20 2E 33			jsr Do_CIOV							; Close editor
