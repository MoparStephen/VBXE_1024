   648 				;-----------------------------------------------------------------------------
   649 				; Load_Image
   650 				; File_Index must be set before calling this!  No range checking is done!
   651 				; One OPEN of D:<name>.V1K, three sequential block reads:
   652 				;   .PAL block -> $21000, pushed to palette registers 0-3
   653 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   654 				;   .RAW block -> $01000 framebuffer
   655 				; A missing or short file stops at the failing block and closes the IOCB.
   656 				;-----------------------------------------------------------------------------
   657 3415			Load_Image
   658 3415 A9 00			lda #$00							; ext 0 = .V1K
   659 3417 20 60 39			jsr Build_Filename
   660 341A 20 69 34			jsr Image_Open
   661 341D B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   662
   663 341F 20 58 34			jsr Image_Read_Pal
   664 3422 B0 2A			bcs Load_Image_Close
   665 3424 20 D5 33			jsr Apply_Image_Palette
   666
   667 3427 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   668 3429 A2 02			ldx #V1K_MAP_LEN / $1000
   669 342B A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   670 342D 8C E5 04			sty Seg_Tail
   671 3430 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   672 3432 8C E6 04			sty Seg_Tail + $01
   673 3435 20 9A 34			jsr Image_Read_Segment
   674 3438 B0 14			bcs Load_Image_Close
   675 343A 20 5A 33			jsr Setup_Cmap1						; Expand the data out to $17000
   676
   677 343D A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   678 343F A2 12			ldx #V1K_RAW_LEN / $1000
   679 3441 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   680 3443 8C E5 04			sty Seg_Tail
   681 3446 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   682 3448 8C E6 04			sty Seg_Tail + $01
   683 344B 20 9A 34			jsr Image_Read_Segment
   684
   685 344E			Load_Image_Close
   686 344E 20 F5 34			jsr Image_Close
   687
   688 3451			Load_Image_Done
   689 3451 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   690 3453				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3453 A0 5F			ldy #<VBXE_MA_BSEL
     3 3455 91 93			sta (VBXEBase),y
Source: view1024.asm
