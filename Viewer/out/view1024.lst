  2889 6314 E8				inx
  2890 6315 E0 28			cpx #$28
  2891 6317 90 F6			bcc Path_Save_End
  2892 6319			Path_Save_Found							; X = index of the NUL
  2893 6319 E0 00			cpx #$00
  2894 631B F0 20			beq Path_Save_Done					; empty path
  2895 631D CA				dex									; step onto the trailing '>'
  2896 631E			Path_Save_Back
  2897 631E E0 00			cpx #$00
  2898 6320 F0 09			beq Path_Save_Copy					; segment starts the path
  2899 6322 CA				dex
  2900 6323 BD 28 06			lda Scan_Path,x
  2901 6326 C9 3E			cmp #'>'
  2902 6328 D0 F4			bne Path_Save_Back
  2903 632A E8				inx									; first char after the separator
  2904 632B			Path_Save_Copy
  2905 632B A0 00			ldy #$00
  2906 632D			Path_Save_L1
  2907 632D BD 28 06			lda Scan_Path,x
  2908 6330 C9 3E			cmp #'>'
  2909 6332 F0 09			beq Path_Save_Done
  2910 6334 99 EC 04			sta Up_Name,y
  2911 6337 E8				inx
  2912 6338 C8				iny
  2913 6339 C0 08			cpy #$08
  2914 633B 90 F0			bcc Path_Save_L1
  2915 633D			Path_Save_Done
  2916 633D 60				rts
