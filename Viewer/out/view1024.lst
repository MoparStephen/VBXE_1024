   579 = 06B0			TXT_ROW
   579 = 06B1			TXT_COL
   579 = 06B2			TXT_FG
   579 = 06B3			TXT_BG
   579 = 06B4			TXT_ATTR
   579 = 06B6			TXT_BANK
