   169 				; LoadData - Loads file into banked memory
   170 				; bankindex - first bank number to load to
   171 				; This is slighty modified code provided by Mono (AtariArea)
   172 				; visit http://atariarea.krap.pl/forum/viewtopic.php?id=6781
   173 				; to see the original version
   174 30AA			LoadData
   175 30AA A9 01			lda #1
   176 30AC 8D 2D 31			sta LoadStatus						; Indicate Failure
   177 30AF 20 2D 30			jsr Find_First_IOCB
   178 30B2 C0 01			cpy #1
   179 30B4 D0 6E			bne LoadData_Error
   180 30B6 A9 04			lda #CIO_read
   181 30B8 9D 4A 03			sta ICAX1,x
   182 30BB A9 03			lda #CIO_open
   183 30BD 9D 42 03			sta iccmd,x
   184 30C0 AD 28 31			lda FileNamePtr
   185 30C3 9D 44 03			sta ICBAL,x
   186 30C6 AD 29 31			lda FileNamePtr+1
   187 30C9 9D 45 03			sta ICBAL+1,x
   188 30CC AD 2A 31			lda FileNameLng
   189 30CF 9D 48 03			sta ICBLL,x
   190 30D2 A9 00			lda #0
   191 30D4 9D 49 03			sta ICBLL+1,x
   192 30D7 20 56 E4			jsr ciov
   193 30DA 30 34			bmi LoadData_Open_Error
   194 30DC A4 8E			ldy BankIndex
   195 30DE			LoadData_l1
   196 30DE 98				tya
   197 30DF 09 80			ora #0x80
   198 30E1				vbsta VBXE_MA_BSEL
