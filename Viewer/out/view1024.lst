   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a simple ASCII box ('+' '-' '|') with a blank
   392 				; interior over Txt_Row / Txt_Col / Reg1 (width-1) / Reg2 (height-1), using the
   393 				; current pen.  Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   394 				;-----------------------------------------------------------------------------
   395 3BB0			Text_Window_Frame
   396 3BB0 A5 80			lda Reg1
   397 3BB2 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   398 3BB4 AD B1 06			lda Txt_Col
   399 3BB7 85 87			sta Reg8							; Reg8 = left column
   400 3BB9 AD B0 06			lda Txt_Row
   401 3BBC 18				clc
   402 3BBD 65 81			adc Reg2
   403 3BBF 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   404 3BC1 AD B0 06			lda Txt_Row
   405 3BC4 85 84			sta Reg5							; Reg5 = current screen row
   406 3BC6 20 DA 3B			jsr Text_Window_Frame_EdgeRow		; top edge
   407 3BC9			Text_Window_Frame_Mid
   408 3BC9 E6 84			inc Reg5
   409 3BCB A5 84			lda Reg5
   410 3BCD C5 85			cmp Reg6
   411 3BCF B0 06			bcs Text_Window_Frame_Bottom
   412 3BD1 20 F6 3B			jsr Text_Window_Frame_MidRow
   413 3BD4 4C C9 3B			jmp Text_Window_Frame_Mid
   414 3BD7			Text_Window_Frame_Bottom
   415 3BD7 4C DA 3B			jmp Text_Window_Frame_EdgeRow		; bottom edge (tail - returns to caller)
   416
   417 3BDA			Text_Window_Frame_EdgeRow
   418 3BDA A9 2B			lda #'+'
   419 3BDC 8D 80 06			sta Txt_Line+0
   420 3BDF A2 01			ldx #$01
   421 3BE1			Text_Window_Frame_EdgeL
   422 3BE1 E4 86			cpx Reg7
   423 3BE3 B0 08			bcs Text_Window_Frame_EdgeEnd
   424 3BE5 A9 2D			lda #'-'
   425 3BE7 9D 80 06			sta Txt_Line,x
   426 3BEA E8				inx
   427 3BEB D0 F4			bne Text_Window_Frame_EdgeL
   428 3BED			Text_Window_Frame_EdgeEnd
   429 3BED A9 2B			lda #'+'
   430 3BEF 9D 80 06			sta Txt_Line,x
   431 3BF2 E8				inx
   432 3BF3 4C 0F 3C			jmp Text_Window_Frame_PutRow
   433
   434 3BF6			Text_Window_Frame_MidRow
   435 3BF6 A9 7C			lda #'|'
   436 3BF8 8D 80 06			sta Txt_Line+0
   437 3BFB A2 01			ldx #$01
   438 3BFD			Text_Window_Frame_MidL
   439 3BFD E4 86			cpx Reg7
   440 3BFF B0 08			bcs Text_Window_Frame_MidEnd
   441 3C01 A9 20			lda #' '
   442 3C03 9D 80 06			sta Txt_Line,x
   443 3C06 E8				inx
   444 3C07 D0 F4			bne Text_Window_Frame_MidL
   445 3C09			Text_Window_Frame_MidEnd
   446 3C09 A9 7C			lda #'|'
   447 3C0B 9D 80 06			sta Txt_Line,x
   448 3C0E E8				inx
   449 3C0F			Text_Window_Frame_PutRow
   450 3C0F A9 00			lda #$00
   451 3C11 9D 80 06			sta Txt_Line,x
   452 3C14 A5 84			lda Reg5
   453 3C16 8D B0 06			sta Txt_Row
   454 3C19 A5 87			lda Reg8
   455 3C1B 8D B1 06			sta Txt_Col
   456 3C1E A9 80			lda #<Txt_Line
   457 3C20 85 96			sta Txt_Ptr
   458 3C22 A9 06			lda #>Txt_Line
   459 3C24 85 97			sta Txt_Ptr + $01
   460 3C26 4C 29 3C			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
