  1511 				; in the resident Cleanup_Exit, which is page-fenced below $3400 and full - the
  1512 				; init-time abort paths that jmp straight to Cleanup_Exit simply skip this.
  1513 3A1F AD F8 04			lda RAMTOP_OLD						; Give the SDX soft console its top-of-RAM back
  1514 3A22 85 6A			sta RAMTOP
