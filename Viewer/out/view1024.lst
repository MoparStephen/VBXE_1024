   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3CCD			Text_Window_Frame_Chars
   504 3CCD C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3CD6 DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3CDF			Text_Window_Frame
   508 3CDF A5 80			lda Reg1
   509 3CE1 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3CE3 AD B1 06			lda Txt_Col
   511 3CE6 85 87			sta Reg8							; Reg8 = left column
   512 3CE8 AD B0 06			lda Txt_Row
   513 3CEB 18				clc
   514 3CEC 65 81			adc Reg2
   515 3CEE 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3CF0 AD B0 06			lda Txt_Row
   517 3CF3 85 84			sta Reg5							; Reg5 = current screen row
   518 3CF5 AE B5 06			ldx Txt_FrameStyle
   519 3CF8 20 17 3D			jsr Text_Window_Frame_Row			; top edge
   520 3CFB			Text_Window_Frame_Mid
   521 3CFB E6 84			inc Reg5
   522 3CFD A5 84			lda Reg5
   523 3CFF C5 85			cmp Reg6
   524 3D01 B0 0D			bcs Text_Window_Frame_Bottom
   525 3D03 AD B5 06			lda Txt_FrameStyle
   526 3D06 18				clc
   527 3D07 69 03			adc #$03
   528 3D09 AA				tax
   529 3D0A 20 17 3D			jsr Text_Window_Frame_Row			; interior row
   530 3D0D 4C FB 3C			jmp Text_Window_Frame_Mid
   531 3D10			Text_Window_Frame_Bottom
   532 3D10 AD B5 06			lda Txt_FrameStyle
   533 3D13 18				clc
   534 3D14 69 06			adc #$06
   535 3D16 AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3D17			Text_Window_Frame_Row
   540 3D17 BD CD 3C			lda Text_Window_Frame_Chars,x
   541 3D1A 8D 80 06			sta Txt_Line+0
   542 3D1D BD CE 3C			lda Text_Window_Frame_Chars+1,x
   543 3D20 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3D22 BD CF 3C			lda Text_Window_Frame_Chars+2,x
   545 3D25 85 82			sta Reg3							; Reg3 = right char
   546 3D27 A2 01			ldx #$01
   547 3D29			Text_Window_Frame_Row_L1
   548 3D29 E4 86			cpx Reg7
   549 3D2B B0 08			bcs Text_Window_Frame_Row_End
   550 3D2D A5 83			lda Reg4
   551 3D2F 9D 80 06			sta Txt_Line,x
   552 3D32 E8				inx
   553 3D33 D0 F4			bne Text_Window_Frame_Row_L1
   554 3D35			Text_Window_Frame_Row_End
   555 3D35 A5 82			lda Reg3
   556 3D37 9D 80 06			sta Txt_Line,x
   557 3D3A E8				inx
   558 3D3B			Text_Window_Frame_PutRow
   559 3D3B A9 00			lda #$00
   560 3D3D 9D 80 06			sta Txt_Line,x
   561 3D40 A5 84			lda Reg5
   562 3D42 8D B0 06			sta Txt_Row
   563 3D45 A5 87			lda Reg8
   564 3D47 8D B1 06			sta Txt_Col
   565 3D4A A9 80			lda #<Txt_Line
   566 3D4C 85 96			sta Txt_Ptr
   567 3D4E A9 06			lda #>Txt_Line
   568 3D50 85 97			sta Txt_Ptr + $01
   569 3D52 4C 55 3D			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 3D55			Text_PutStrAt
   583 3D55 A9 01			lda #$01
   584 3D57 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 3D5A A9 00			lda #$00
   587 3D5C 85 80			sta Reg1
   588 3D5E 85 81			sta Reg2
   589 3D60 AE B0 06			ldx Txt_Row
   590 3D63 F0 0E			beq Text_PutStrAt_Col
   591 3D65			Text_PutStrAt_RowL
   592 3D65 A5 80			lda Reg1
   593 3D67 18				clc
   594 3D68 69 A0			adc #TEXT_PITCH
   595 3D6A 85 80			sta Reg1
   596 3D6C 90 02			bcc Text_PutStrAt_RowNC
   597 3D6E E6 81			inc Reg2
   598 3D70			Text_PutStrAt_RowNC
   599 3D70 CA				dex
   600 3D71 D0 F2			bne Text_PutStrAt_RowL
   601 3D73			Text_PutStrAt_Col
   602 3D73 AD B1 06			lda Txt_Col
   603 3D76 0A				asl									; Txt_Col * 2 (max 158)
   604 3D77 18				clc
   605 3D78 65 80			adc Reg1
   606 3D7A 85 80			sta Reg1
   607 3D7C 90 02			bcc Text_PutStrAt_ColNC
   608 3D7E E6 81			inc Reg2
   609 3D80			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 3D80 A5 81			lda Reg2
   612 3D82 29 10			and #$10							; offset bit 12 = "second bank"
   613 3D84 F0 04			beq Text_PutStrAt_Bank0
   614 3D86 A9 2B			lda #TEXT_BACK_BANK+1
   615 3D88 D0 02			bne Text_PutStrAt_SetBank
   616 3D8A			Text_PutStrAt_Bank0
   617 3D8A A9 2A			lda #TEXT_BACK_BANK
   618 3D8C			Text_PutStrAt_SetBank
   619 3D8C 8D B6 06			sta Txt_Bank
   620 3D8F A5 80			lda Reg1
   621 3D91 85 88			sta Ptr_Lo
   622 3D93 A5 81			lda Reg2
   623 3D95 29 0F			and #$0F
   624 3D97 18				clc
   625 3D98 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 3D9A 85 89			sta Ptr_Hi
   627 3D9C AD B6 06			lda Txt_Bank
   628 3D9F 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 3DA1				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3DA1 A0 5F			ldy #<VBXE_MA_BSEL
     3 3DA3 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 3DA5 A9 00			lda #$00
   632 3DA7 85 82			sta Reg3							; Reg3 = source string index
   633 3DA9 AD B1 06			lda Txt_Col
   634 3DAC 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 3DAE			Text_PutStrAt_Char
   636 3DAE A5 83			lda Reg4
   637 3DB0 C9 50			cmp #TEXT_COLS
   638 3DB2 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 3DB4 A4 82			ldy Reg3
   640 3DB6 B1 96			lda (Txt_Ptr),y
   641 3DB8 F0 43			beq Text_PutStrAt_Done
   642 3DBA C9 01			cmp #TXT_PEN
   643 3DBC D0 0C			bne Text_PutStrAt_Glyph
   644 3DBE C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 3DBF B1 96			lda (Txt_Ptr),y
   646 3DC1 8D B4 06			sta Txt_Attr
   647 3DC4 C8				iny
   648 3DC5 84 82			sty Reg3							; skip both bytes, column unchanged
   649 3DC7 4C AE 3D			jmp Text_PutStrAt_Char
   650 3DCA			Text_PutStrAt_Glyph
   651 3DCA A0 00			ldy #$00
   652 3DCC 91 88			sta (Ptr_Lo),y						; glyph byte
   653 3DCE C8				iny
   654 3DCF AD B4 06			lda Txt_Attr
   655 3DD2 91 88			sta (Ptr_Lo),y						; attribute byte
   656 3DD4 E6 82			inc Reg3
   657 3DD6 E6 83			inc Reg4
   658 3DD8 A5 88			lda Ptr_Lo							; window pointer += 2
   659 3DDA 18				clc
   660 3DDB 69 02			adc #$02
   661 3DDD 85 88			sta Ptr_Lo
   662 3DDF 90 02			bcc Text_PutStrAt_NoPage
   663 3DE1 E6 89			inc Ptr_Hi
   664 3DE3			Text_PutStrAt_NoPage
   665 3DE3 A5 89			lda Ptr_Hi
   666 3DE5 C9 30			cmp #$30							; crossed out of the window -> next bank
   667 3DE7 90 C5			bcc Text_PutStrAt_Char
   668 3DE9 38				sec
   669 3DEA E9 10			sbc #$10
   670 3DEC 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 3DEE EE B6 06			inc Txt_Bank
   672 3DF1 AD B6 06			lda Txt_Bank
   673 3DF4 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 3DF6				vbsta VBXE_MA_BSEL
