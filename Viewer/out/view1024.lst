  1351 38F8			Handle_Keys
  1352 				; Dispatch on the current UI mode - the selector, slideshow, drive picker and
  1353 				; info viewer each have their own key set (ui.asm); mode 1 (image view) uses
  1354 				; the set below.
  1355 38F8 AD DC 02			lda HELPFLG							; Help isn't in CH - the OS sets HELPFLG ($11/$51/$91)
  1356 38FB F0 08			beq Handle_Keys_NoHelp
  1357 38FD A9 00			lda #$00
  1358 38FF 8D DC 02			sta HELPFLG							; Clear Help key press
  1359 3902 4C ED 5E			jmp Help_Key						; (ui.asm)
  1360 3905			Handle_Keys_NoHelp
  1361 3905 AD FF 02			lda SSFLAG							; Ctrl+1 isn't in CH either - the OS keyboard IRQ
  1362 3908 F0 0A			beq Handle_Keys_NoCtrl1				;   toggles SSFLAG instead...
  1363 390A A9 00			lda #$00
  1364 390C 8D FF 02			sta SSFLAG
  1365 390F A9 9F			lda #$9F							; ...so hand it on as Ctrl+1
  1366 3911 8D FC 02			sta CH
  1367 3914			Handle_Keys_NoCtrl1
  1368 3914 AD FC 02			lda CH
