   211 3355 A2 00			ldx #$00
   212 3357			RAM_Failure_Message_L2
   213 3357 BD 8E 33			lda RAM_Failure_Message_Line2,x
   214 335A 91 88			sta (Ptr_Lo),y
   215 335C E8				inx
   216 335D C8				iny
   217 335E E0 15			cpx #$15							; Copy $15 characters
   218 3360 D0 F5			bne RAM_Failure_Message_L2
