   889 3608			Handle_Keys
   890 				; Dispatch on the current UI mode - the selector, slideshow, drive picker and
   891 				; info viewer each have their own key set (ui.asm); mode 1 (image view) uses
   892 				; the set below.
   893 3608 AD FC 02			lda CH
   894 360B C9 38			cmp #KEY_F							; F toggles the text font on every screen
   895 360D D0 06			bne Handle_Keys_Mode
   896 360F 20 D9 38			jsr Toggle_Font
   897 3612 4C A0 36			jmp Read_Key_Done
   898 3615			Handle_Keys_Mode
   899 3615 AD C6 04			lda UI_Mode
   900 3618 D0 03			bne Handle_Keys_NotSelector
   901 361A 4C 79 53			jmp Selector_Keys					; 0 = selector
   902 361D			Handle_Keys_NotSelector
   903 361D C9 02			cmp #$02
   904 361F D0 03			bne Handle_Keys_NotSlide
   905 3621 4C 19 57			jmp Slideshow_Keys					; 2 = slideshow
   906 3624			Handle_Keys_NotSlide
   907 3624 C9 03			cmp #$03
   908 3626 D0 03			bne Handle_Keys_NotFolder
   909 3628 4C A3 55			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
   910 362B			Handle_Keys_NotFolder
   911 362B C9 04			cmp #$04
   912 362D D0 03			bne Handle_Keys_NotInfo
   913 362F 4C 9F 58			jmp Info_Keys						; 4 = info viewer (.nfo)
   914 3632			Handle_Keys_NotInfo
   915 3632 C9 05			cmp #$05
   916 3634 D0 03			bne Handle_Keys_ImageView
   917 3636 4C 6E 56			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
   918 3639			Handle_Keys_ImageView
