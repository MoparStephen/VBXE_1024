   143
   144 				; A = glyph code -> A/Y = lo/hi of that glyph's 8 bytes in the Atari font, as
   145 				; mapped at VBXE_WINDOW + $800.  X preserved.
   146 3DCC			Text_Glyph_Addr
   147 3DCC A0 05			ldy #>[[VBXE_WINDOW + $800] / 8]	; = $05 - becomes $28 after the x8 below
   148 3DCE 84 82			sty Reg3
   149 3DD0 0A				asl
   150 3DD1 26 82			rol Reg3
   151 3DD3 0A				asl
   152 3DD4 26 82			rol Reg3
   153 3DD6 0A				asl
   154 3DD7 26 82			rol Reg3							; Reg3:A = $2800 + code*8
   155 3DD9 A4 82			ldy Reg3
   156 3DDB 60				rts
   157
   158 				; {source, destination} glyph pairs, applied in order.  Box lines first: $1A
   159 				; (ATASCII Ctrl-Z corner) is read here before the arrows overwrite it.
   160 				; CP437 double and single box sets both map onto the Atari single-line set.
   161 3DDC			Atari_Remap_Table
   162 3DDC 11 C9 12 CD 05 BB + 	dta $11,$C9, $12,$CD, $05,$BB, $7C,$BA, $1A,$C8, $03,$BC	; double: TL - TR | BL BR
   163 3DE8 11 DA 12 C4 05 BF + 	dta $11,$DA, $12,$C4, $05,$BF, $7C,$B3, $1A,$C0, $03,$D9	; single: TL - TR | BL BR
   164 3DF4 1C 18 1D 19 1E 1B + 	dta $1C,$18, $1D,$19, $1E,$1B, $1F,$1A						; arrows: up down left right
   165 3DFC			Atari_Remap_Table_End
   166
   167 				; Copy 2048 bytes (Ptr_Lo/Hi) -> (Reg1/Reg2), 8 pages.
   168 3DFC			Text_Copy_2K
   169 3DFC A2 08			ldx #$08
   170 3DFE A0 00			ldy #$00
   171 3E00			Text_Copy_2K_L1
   172 3E00 B1 88			lda (Ptr_Lo),y
   173 3E02 91 80			sta (Reg1),y
   174 3E04 C8				iny
   175 3E05 D0 F9			bne Text_Copy_2K_L1
   176 3E07 E6 89			inc Ptr_Hi
   177 3E09 E6 81			inc Reg2
   178 3E0B CA				dex
   179 3E0C D0 F2			bne Text_Copy_2K_L1
   180 3E0E 60				rts
