  1094 				;-----------------------------------------------------------------------------
  1095 				; Build_Filename
  1096 				;  In:  A          = 0 -> .PAL, 1 -> .MAP, 2 -> .RAW, 3 -> .NFO
  1097 				;       File_Index = image ordinal
  1098 				;  Out: FileNamePtr -> Path_Buf holding
  1099 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1100 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1101 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1102 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1103 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1104 				;-----------------------------------------------------------------------------
  1105 3739			Build_Filename
  1106 3739 85 81			sta Reg2							; Reg2 = extension selector
  1107
  1108 				; Name_Ptr = ImageNames + File_Index * 8   (16-bit; File_Index up to 254)
  1109 373B AD 8A 04			lda File_Index
  1110 373E 85 82			sta Reg3
  1111 3740 A9 00			lda #$00
  1112 3742 85 83			sta Reg4
  1113 3744 06 82			asl Reg3
  1114 3746 26 83			rol Reg4
  1115 3748 06 82			asl Reg3
  1116 374A 26 83			rol Reg4
  1117 374C 06 82			asl Reg3
  1118 374E 26 83			rol Reg4							; Reg3/Reg4 = File_Index * 8
  1119 3750 A5 82			lda Reg3
  1120 3752 18				clc
  1121 3753 69 00			adc #<ImageNames
  1122 3755 85 8A			sta Name_Ptr
  1123 3757 A5 83			lda Reg4
  1124 3759 69 20			adc #>ImageNames
  1125 375B 85 8B			sta Name_Ptr + $01
  1126
  1127 375D 20 E5 4D			jsr Emit_Path_Prefix				; Path_Buf = "D[n]:" + Scan_Path, X = cursor
  1128
  1129 3760 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1130 3762				vbsta VBXE_MA_BSEL					; Map the name list into the $2000 window
