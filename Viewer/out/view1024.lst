  1370 3919 D0 06			bne Handle_Keys_Mode
  1371 391B 20 18 3E			jsr Toggle_Font						; (text80.asm) - a CHBASE flip, nothing is redrawn
  1372 391E 4C 16 3A			jmp Read_Key_Done
  1373 3921			Handle_Keys_Mode
  1374 3921 AD C6 04			lda UI_Mode
  1375 3924 D0 03			bne Handle_Keys_NotSelector
  1376 3926 4C 4F 5A			jmp Selector_Keys					; 0 = selector
  1377 3929			Handle_Keys_NotSelector
  1378 3929 C9 02			cmp #$02
  1379 392B D0 03			bne Handle_Keys_NotSlide
  1380 392D 4C 2A 60			jmp Slideshow_Keys					; 2 = slideshow
  1381 3930			Handle_Keys_NotSlide
  1382 3930 C9 03			cmp #$03
  1383 3932 D0 03			bne Handle_Keys_NotFolder
  1384 3934 4C 92 5C			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
  1385 3937			Handle_Keys_NotFolder
  1386 3937 C9 04			cmp #$04
  1387 3939 D0 03			bne Handle_Keys_NotInfo
  1388 393B 4C EB 61			jmp Info_Keys						; 4 = info viewer (.nfo)
  1389 393E			Handle_Keys_NotInfo
  1390 393E C9 05			cmp #$05
  1391 3940 D0 03			bne Handle_Keys_NotQuit
  1392 3942 4C 9F 5D			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
  1393 3945			Handle_Keys_NotQuit
