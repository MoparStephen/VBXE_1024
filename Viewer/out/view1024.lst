   657 3441 20 2D 30			jsr Find_First_IOCB
   658 3444 C0 01			cpy #$01
   659 3446 D0 28			bne Image_Open_Fail					; no free IOCB
   660 3448 8E E2 04			stx Load_IOCB
   661 344B A9 04			lda #CIO_read
   662 344D 9D 4A 03			sta ICAX1,x
   663 3450 A9 00			lda #$00
   664 3452 9D 4B 03			sta ICAX2,x
   665 3455 A9 03			lda #CIO_open
   666 3457 9D 42 03			sta ICCOM,x
   667 345A AD 28 31			lda FileNamePtr
   668 345D 9D 44 03			sta ICBAL,x
   669 3460 AD 29 31			lda FileNamePtr + $01
   670 3463 9D 45 03			sta ICBAH,x
   671 3466 20 56 E4			jsr CIOV
   672 3469 30 02			bmi Image_Open_Close
   673 346B 18				clc
   674 346C 60				rts
   675 346D			Image_Open_Close
   676 346D 20 CD 34			jsr Image_Close
   677 3470			Image_Open_Fail
   678 3470 38				sec
   679 3471 60				rts
