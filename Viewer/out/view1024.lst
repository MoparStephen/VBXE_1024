    96 39C9 85 89			sta Ptr_Hi
    97 39CB A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
    98 39CD 85 80			sta Reg1
    99 39CF A9 28			lda #>[VBXE_WINDOW + $800]
   100 39D1 85 81			sta Reg2
   101 39D3 20 DD 39			jsr Text_Copy_2K
