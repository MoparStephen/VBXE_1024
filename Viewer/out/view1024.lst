    62 				VBXE_BL_ADR0			equ	VBXE_BASE+$50	; Write
    63 				VBXE_BLT_COLLISION_CODE	equ	VBXE_BASE+$50	; Read
    64 				VBXE_BL_ADR1			equ	VBXE_BASE+$51
    65 				VBXE_BL_ADR2			equ	VBXE_BASE+$52
    66 				VBXE_BLITTER_START		equ	VBXE_BASE+$53	; Write
    67 				VBXE_BLITTER_BUSY		equ	VBXE_BASE+$53	; Read
    68 				VBXE_IRQ_CONTROL		equ	VBXE_BASE+$54	; Write
    69 				VBXE_IRQ_STATUS			equ	VBXE_BASE+$54	; Read
    70 				VBXE_P0					equ	VBXE_BASE+$55	; the four OVERLAY PRIORITY registers.  P1-P3
    71 				VBXE_P1					equ	VBXE_BASE+$56	;   read $55 here until 2026-08-22; they are
    72 				VBXE_P2					equ	VBXE_BASE+$57	;   four consecutive registers, per Altirra's
    73 				VBXE_P3					equ	VBXE_BASE+$58	;   vbxe.cpp WriteControl.  Only an active
    74 																	;   ATTRIBUTE MAP uses P0-P3 (a cell's byte 3
    75 																	;   picks one); with the map off it is the
    76 																	;   XDL's OVATT byte 1 that decides.  They
    77 																	;   power up $00 on real hardware and $FF in
    78 																	;   Altirra - write P0 explicitly.
    79 				VBXE_MEMAC_B_CONTROL	equ	VBXE_BASE+$5D
    80 				VBXE_MEMAC_CONTROL		equ	VBXE_BASE+$5E	; Write
    81 				VBXE_MEMAC_CONTROL		equ	VBXE_BASE+$5E	; Read
    82 				VBXE_MEMAC_BANK_SEL		equ	VBXE_BASE+$5F	; Write
    83 				VBXE_MEMAC_BANK_SEL		equ	VBXE_BASE+$5F	; Read
    84 				*/
    84
