  1968 3CC5 20 35 3D			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1969
  1970 3CC8 A5 81			lda Reg2
  1971 3CCA 18				clc
  1972 3CCB 69 01			adc #$01
  1973 3CCD 85 82			sta Reg3							; j = i + 1
  1974 3CCF			Sort_Range_Inner
  1975 3CCF A5 82			lda Reg3
  1976 3CD1 C5 84			cmp Reg5
  1977 3CD3 B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1978
  1979 3CD5 A5 82			lda Reg3
  1980 3CD7 20 41 3D			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1981 3CDA 20 11 3D			jsr Cmp_Records						; rec(m) : rec(j)
  1982 3CDD 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1983 3CDF F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1984 3CE1 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1985 3CE3 85 83			sta Reg4
  1986 3CE5 A5 8C			lda Sort_Ptr
  1987 3CE7 85 8A			sta Name_Ptr
  1988 3CE9 A5 8D			lda Sort_Ptr + $01
  1989 3CEB 85 8B			sta Name_Ptr + $01
  1990 3CED			Sort_Range_Inner_Next
  1991 3CED E6 82			inc Reg3
  1992 3CEF 4C CF 3C			jmp Sort_Range_Inner
  1993 3CF2			Sort_Range_Inner_Done
  1994 3CF2 A5 83			lda Reg4
  1995 3CF4 C5 81			cmp Reg2
  1996 3CF6 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1997 3CF8 A5 81			lda Reg2
  1998 3CFA 20 41 3D			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1999 3CFD A5 83			lda Reg4
  2000 3CFF 20 35 3D			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  2001 3D02 20 1F 3D			jsr Swap_Records
  2002 3D05			Sort_Range_Outer_Next
  2003 3D05 E6 81			inc Reg2
  2004 3D07 4C BD 3C			jmp Sort_Range_Outer
  2005
  2006 3D0A			Sort_Range_Unmap
  2007 3D0A A9 00			lda #MEMAC_GLOBAL_DISABLE
