   219 21DD 01				dta $01								; Destination step x (1)
   220 21DE FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   221 21E0 7F				dta $7F								; Height-1 (127 -> 128 rows; 128*256 = 32768 = 8 banks)
   222 21E1 00				dta $00								; And mask (0 -> constant source)
   223 21E2 00				dta $00								; Xor mask (fill value: $00)
   224 21E3 00				dta $00								; Collision and mask
   225 21E4 00				dta $00								; Zoom
   226 21E5 00				dta $00								; Pattern feature
