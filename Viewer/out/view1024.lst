   734 				;-----------------------------------------------------------------------------
   735 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   736 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   737 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   738 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   739 				;-----------------------------------------------------------------------------
   740 349A			Image_Read_Segment
   741 349A 8D E3 04			sta Seg_Bank
   742 349D 8E E4 04			stx Seg_Chunks
   743 34A0			Image_Read_Segment_L1
   744 34A0 AD E4 04			lda Seg_Chunks
   745 34A3 F0 0F			beq Image_Read_Segment_Tail
   746 34A5 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   747 34A7 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   748 34A9 20 C7 34			jsr Image_Read_Chunk
   749 34AC B0 18			bcs Image_Read_Segment_Done
   750 34AE CE E4 04			dec Seg_Chunks
   751 34B1 4C A0 34			jmp Image_Read_Segment_L1
   752
   753 34B4			Image_Read_Segment_Tail
   754 34B4 AD E5 04			lda Seg_Tail
   755 34B7 0D E6 04			ora Seg_Tail + $01
   756 34BA F0 09			beq Image_Read_Segment_OK			; no partial chunk
   757 34BC AD E5 04			lda Seg_Tail
   758 34BF AC E6 04			ldy Seg_Tail + $01
   759 34C2 4C C7 34			jmp Image_Read_Chunk
   760
   761 34C5			Image_Read_Segment_OK
   762 34C5 18				clc
   763 34C6			Image_Read_Segment_Done
   764 34C6 60				rts
   765
