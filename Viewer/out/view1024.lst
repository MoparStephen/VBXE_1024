   419 				;-----------------------------------------------------------------------------
   420 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   421 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   422 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   423 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   424 				;  Returns A = $01 if a name was written, $00 if not.
   425 				;-----------------------------------------------------------------------------
   426 506F			Parse_Dir_Line
   427 506F A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   428 5071			Parse_Skip_L1							; Skip leading spaces / protect flag
   429 5071 BD 00 06			lda Dir_Line_Buf,x
   430 5074 C9 9B			cmp #$9B
   431 5076 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   432 5078 C9 20			cmp #' '
   433 507A F0 04			beq Parse_Skip_Next
   434 507C C9 2A			cmp #'*'
   435 507E D0 07			bne Parse_Skip_Done
   436 5080			Parse_Skip_Next
   437 5080 E8				inx
   438 5081 E0 28			cpx #Dir_Line_Len
   439 5083 90 EC			bcc Parse_Skip_L1
   440 5085 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   441 5087			Parse_Skip_Done
   442 5087 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   443 5089 A9 00			lda #$00
   444 508B 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   445
   446 508D			Parse_Copy_L1
   447 508D BD 00 06			lda Dir_Line_Buf,x
   448 5090 C9 9B			cmp #$9B
   449 5092 F0 24			beq Parse_Copy_Done
   450 5094 C9 20			cmp #' '
   451 5096 F0 20			beq Parse_Copy_Done
   452 5098 C9 2E			cmp #'.'
   453 509A F0 1C			beq Parse_Copy_Done
   454 509C C9 30			cmp #'0'
   455 509E 90 07			bcc Parse_Copy_Is_Name_Char
   456 50A0 C9 3A			cmp #'9'+1
   457 50A2 B0 03			bcs Parse_Copy_Is_Name_Char
   458 50A4 4C A9 50			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   459 50A7			Parse_Copy_Is_Name_Char
   460 50A7 E6 80			inc Reg1
   461 50A9			Parse_Copy_Store
   462 50A9 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   463 50AB B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   464 50AD BD 00 06			lda Dir_Line_Buf,x
   465 50B0 91 8A			sta (Name_Ptr),y
   466 50B2 C8				iny
   467 50B3			Parse_Copy_Next
   468 50B3 E8				inx
   469 50B4 E0 28			cpx #Dir_Line_Len
   470 50B6 90 D5			bcc Parse_Copy_L1
   471
   472 50B8			Parse_Copy_Done
   473 50B8 A5 80			lda Reg1
   474 50BA F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   475
   476 50BC			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   477 50BC C0 08			cpy #$08
   478 50BE B0 07			bcs Parse_Dir_Line_Accept
   479 50C0 A9 20			lda #' '
   480 50C2 91 8A			sta (Name_Ptr),y
   481 50C4 C8				iny
   482 50C5 D0 F5			bne Parse_Pad_L1
   483
   484 50C7			Parse_Dir_Line_Accept
   485 50C7 A9 01			lda #$01							; Non-zero - a name was stored
   486 50C9 60				rts
   487 50CA			Parse_Dir_Line_Reject
   488 50CA A9 00			lda #$00
   489 50CC 60				rts
