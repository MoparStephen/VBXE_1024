  2753 				;=============================================================================
  2754 				; Shared directory helpers
  2755 				;-----------------------------------------------------------------------------
  2756 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2757 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2758 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2759 				; navigation lives in the selector itself.
  2760 				;=============================================================================
  2761
  2762 				;-----------------------------------------------------------------------------
  2763 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2764 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2765 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2766 				;-----------------------------------------------------------------------------
  2767 61A8			Line_Has_Dir_Tag
  2768 61A8 A2 00			ldx #$00
  2769 61AA			Line_Has_Dir_Tag_L1
  2770 61AA BD 00 06			lda Dir_Line_Buf,x
  2771 61AD C9 3C			cmp #'<'
  2772 61AF D0 1F			bne Line_Has_Dir_Tag_Next
  2773 61B1 BD 01 06			lda Dir_Line_Buf+1,x
  2774 61B4 C9 44			cmp #'D'
  2775 61B6 D0 18			bne Line_Has_Dir_Tag_Next
  2776 61B8 BD 02 06			lda Dir_Line_Buf+2,x
  2777 61BB C9 49			cmp #'I'
  2778 61BD D0 11			bne Line_Has_Dir_Tag_Next
  2779 61BF BD 03 06			lda Dir_Line_Buf+3,x
  2780 61C2 C9 52			cmp #'R'
  2781 61C4 D0 0A			bne Line_Has_Dir_Tag_Next
  2782 61C6 BD 04 06			lda Dir_Line_Buf+4,x
  2783 61C9 C9 3E			cmp #'>'
  2784 61CB D0 03			bne Line_Has_Dir_Tag_Next
  2785 61CD A9 01			lda #$01							; found
  2786 61CF 60				rts
  2787 61D0			Line_Has_Dir_Tag_Next
  2788 61D0 E8				inx
  2789 61D1 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2790 61D3 90 D5			bcc Line_Has_Dir_Tag_L1
  2791 61D5 A9 00			lda #$00							; not found
  2792 61D7 60				rts
  2793
  2794 				;-----------------------------------------------------------------------------
  2795 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2796 				; space-padded).  Refuses if the result would not fit.
  2797 				;-----------------------------------------------------------------------------
  2798 61D8			Folder_Path_Push
  2799 61D8 A2 00			ldx #$00
  2800 61DA			Folder_Path_Push_End
  2801 61DA BD 28 06			lda Scan_Path,x
  2802 61DD F0 06			beq Folder_Path_Push_Name
  2803 61DF E8				inx
  2804 61E0 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2805 61E2 90 F6			bcc Folder_Path_Push_End
  2806 61E4 60				rts									; path too long already - refuse
  2807 61E5			Folder_Path_Push_Name
  2808 61E5 A0 00			ldy #$00
  2809 61E7			Folder_Path_Push_L1
  2810 61E7 B9 CD 04			lda Name_Row_Buf,y
  2811 61EA F0 0D			beq Folder_Path_Push_Sep
  2812 61EC C9 20			cmp #' '
  2813 61EE F0 09			beq Folder_Path_Push_Sep
  2814 61F0 9D 28 06			sta Scan_Path,x
  2815 61F3 E8				inx
  2816 61F4 C8				iny
  2817 61F5 C0 08			cpy #$08
  2818 61F7 90 EE			bcc Folder_Path_Push_L1
  2819 61F9			Folder_Path_Push_Sep
  2820 61F9 A9 3E			lda #'>'
  2821 61FB 9D 28 06			sta Scan_Path,x
  2822 61FE E8				inx
  2823 61FF A9 00			lda #$00
  2824 6201 9D 28 06			sta Scan_Path,x
  2825 6204 60				rts
  2826
  2827 				;-----------------------------------------------------------------------------
  2828 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2829 				;-----------------------------------------------------------------------------
  2830 6205			Path_Pop_Segment
  2831 6205 A2 00			ldx #$00
  2832 6207			Path_Pop_End
  2833 6207 BD 28 06			lda Scan_Path,x
  2834 620A F0 05			beq Path_Pop_Found
  2835 620C E8				inx
  2836 620D E0 28			cpx #$28
  2837 620F 90 F6			bcc Path_Pop_End
  2838 6211			Path_Pop_Found							; X = index of the NUL
  2839 6211 E0 00			cpx #$00
  2840 6213 F0 13			beq Path_Pop_Done					; already empty
  2841 6215 CA				dex									; step onto the trailing '>'
  2842 6216			Path_Pop_L1
  2843 6216 E0 00			cpx #$00
  2844 6218 F0 09			beq Path_Pop_Cut
  2845 621A CA				dex
  2846 621B BD 28 06			lda Scan_Path,x
  2847 621E C9 3E			cmp #'>'
  2848 6220 D0 F4			bne Path_Pop_L1
  2849 6222 E8				inx									; keep this separator
  2850 6223			Path_Pop_Cut
  2851 6223 A9 00			lda #$00
  2852 6225 9D 28 06			sta Scan_Path,x
  2853 6228			Path_Pop_Done
  2854 6228 60				rts
  2855
  2856 				;-----------------------------------------------------------------------------
  2857 				; Path_Save_Last_Segment - Up_Name = Scan_Path's last "SEG>", space-padded to
  2858 				; 8 like an IMAGE_BANK record (all spaces if Scan_Path is empty).  Called just
  2859 				; before Path_Pop_Segment so Sel_Find_Up_Name can re-highlight that folder.
  2860 				;-----------------------------------------------------------------------------
  2861 6229			Path_Save_Last_Segment
  2862 6229 A0 07			ldy #$07
  2863 622B A9 20			lda #' '
  2864 622D			Path_Save_Clr
  2865 622D 99 EC 04			sta Up_Name,y
  2866 6230 88				dey
  2867 6231 10 FA			bpl Path_Save_Clr
  2868 6233 A2 00			ldx #$00
  2869 6235			Path_Save_End
  2870 6235 BD 28 06			lda Scan_Path,x
  2871 6238 F0 05			beq Path_Save_Found
  2872 623A E8				inx
  2873 623B E0 28			cpx #$28
  2874 623D 90 F6			bcc Path_Save_End
  2875 623F			Path_Save_Found							; X = index of the NUL
  2876 623F E0 00			cpx #$00
  2877 6241 F0 20			beq Path_Save_Done					; empty path
  2878 6243 CA				dex									; step onto the trailing '>'
  2879 6244			Path_Save_Back
  2880 6244 E0 00			cpx #$00
  2881 6246 F0 09			beq Path_Save_Copy					; segment starts the path
  2882 6248 CA				dex
  2883 6249 BD 28 06			lda Scan_Path,x
  2884 624C C9 3E			cmp #'>'
  2885 624E D0 F4			bne Path_Save_Back
  2886 6250 E8				inx									; first char after the separator
  2887 6251			Path_Save_Copy
  2888 6251 A0 00			ldy #$00
  2889 6253			Path_Save_L1
  2890 6253 BD 28 06			lda Scan_Path,x
  2891 6256 C9 3E			cmp #'>'
  2892 6258 F0 09			beq Path_Save_Done
  2893 625A 99 EC 04			sta Up_Name,y
  2894 625D E8				inx
  2895 625E C8				iny
  2896 625F C0 08			cpy #$08
  2897 6261 90 F0			bcc Path_Save_L1
  2898 6263			Path_Save_Done
  2899 6263 60				rts
  2900
  2901 				;-----------------------------------------------------------------------------
  2902 				; Sel_Find_Up_Name - after a Rescan_Images, move the highlight (Sel_Index /
  2903 				; Sel_Top) onto the directory row named Up_Name.  Leaves 0 / 0 if not found.
  2904 				;-----------------------------------------------------------------------------
  2905 6264			Sel_Find_Up_Name
  2906 6264 AD DA 04			lda FileStart
  2907 6267 38				sec
  2908 6268 ED D9 04			sbc Dir_Count
  2909 626B 8D F4 04			sta Up_Idx							; first directory row
  2910 626E			Sel_Find_Up_L1
  2911 626E AD F4 04			lda Up_Idx
  2912 6271 CD DA 04			cmp FileStart
  2913 6274 B0 25			bcs Sel_Find_Up_Done				; past the last directory - not found
  2914 6276 A2 40			ldx #IMAGE_BANK
  2915 6278 20 B4 58			jsr UI_ReadRec						; Name_Row_Buf = 8-byte record
  2916 627B A0 07			ldy #$07
  2917 627D			Sel_Find_Up_Cmp
  2918 627D B9 CD 04			lda Name_Row_Buf,y
  2919 6280 D9 EC 04			cmp Up_Name,y
  2920 6283 D0 10			bne Sel_Find_Up_Next
  2921 6285 88				dey
  2922 6286 10 F5			bpl Sel_Find_Up_Cmp
  2923 6288 AD F4 04			lda Up_Idx							; match
  2924 628B 8D C7 04			sta Sel_Index
  2925 628E 20 6F 5A			jsr Sel_Top_For_Index				; from Sel_Top = 0 (set by the rescan)
  2926 6291 8D C8 04			sta Sel_Top
  2927 6294 60				rts
  2928 6295			Sel_Find_Up_Next
  2929 6295 EE F4 04			inc Up_Idx
  2930 6298 4C 6E 62			jmp Sel_Find_Up_L1
  2931 629B			Sel_Find_Up_Done
  2932 629B 60				rts
