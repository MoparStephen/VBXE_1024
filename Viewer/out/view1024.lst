   193 21BD 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   194 21C0 00 00			dta $00,$00							; Source step y (unused)
   195 21C2 00				dta $00								; Source step x (unused)
   196 21C3 00 70 03			dta <NFO_NAME_VRAM,>NFO_NAME_VRAM,NFO_NAME_VRAM>>16	; Destination address ($037000)
   197 21C6 00 01			dta a($0100)						; Destination step y (256 - next row)
   198 21C8 01				dta $01								; Destination step x (1)
   199 21C9 FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   200 21CB 7F				dta $7F								; Height-1 (127 -> 128 rows; 128*256 = 32768 = 8 banks)
