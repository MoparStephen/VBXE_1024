   691 				;-----------------------------------------------------------------------------
   692 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   693 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   694 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   695 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   696 				;-----------------------------------------------------------------------------
   697 3493			Image_Read_Segment
   698 3493 8D E3 04			sta Seg_Bank
   699 3496 8E E4 04			stx Seg_Chunks
   700 3499			Image_Read_Segment_L1
   701 3499 AD E4 04			lda Seg_Chunks
   702 349C F0 0F			beq Image_Read_Segment_Tail
   703 349E A9 00			lda #<VBXE_WINDOW_SIZE_4k
   704 34A0 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   705 34A2 20 C0 34			jsr Image_Read_Chunk
   706 34A5 B0 18			bcs Image_Read_Segment_Done
   707 34A7 CE E4 04			dec Seg_Chunks
   708 34AA 4C 99 34			jmp Image_Read_Segment_L1
   709
   710 34AD			Image_Read_Segment_Tail
   711 34AD AD E5 04			lda Seg_Tail
   712 34B0 0D E6 04			ora Seg_Tail + $01
   713 34B3 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   714 34B5 AD E5 04			lda Seg_Tail
   715 34B8 AC E6 04			ldy Seg_Tail + $01
   716 34BB 4C C0 34			jmp Image_Read_Chunk
   717
   718 34BE			Image_Read_Segment_OK
   719 34BE 18				clc
   720 34BF			Image_Read_Segment_Done
   721 34BF 60				rts
   722
   723 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   724 				; C=1 on a CIO error.
   725 34C0			Image_Read_Chunk
   726 34C0 AE E2 04			ldx Load_IOCB
   727 34C3 9D 48 03			sta ICBLL,x
   728 34C6 98				tya
   729 34C7 9D 49 03			sta ICBLH,x							; length stored before vbsta clobbers Y
   730 34CA AD E3 04			lda Seg_Bank
   731 34CD 09 80			ora #MEMAC_GLOBAL_ENABLE
   732 34CF				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
