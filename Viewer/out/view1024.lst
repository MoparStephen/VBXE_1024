   810 				;=============================================================================
   811 				; Selector status line (row 20) - the highlighted image's description (typed
   812 				; in the converter, default = source filename without extension; up to
   813 				; NFO_NAME_CAP = 75 chars).  Reading a file per row stuttered a fresh
   814 				; directory, so instead the converter writes all the descriptions once into
   815 				; "IMAGES.LST" (8-byte key + description per record) beside the images.  Nfo_Name_LoadManifest slurps that in one pass on every
   816 				; Rescan_Images into NFO_NAME_VRAM (NFO_NAME_SLOT bytes/ordinal); the draw path
   817 				; is then a pure VRAM read.  No IMAGES.LST -> every slot stays $00 -> the line
   818 				; is simply blank.
   819 				;=============================================================================
   820
   821 				;-----------------------------------------------------------------------------
   822 				; Nfo_Name_ClearCache - blitter-wipe NFO_NAME_VRAM to $00 (every slot "no
   823 				; name").  Kicks BLT_NFO_NAME_CLEAR and waits (Nfo_Name_LoadManifest fills
   824 				; after).
   825 				;-----------------------------------------------------------------------------
   826 5292			Nfo_Name_ClearCache
   827 5292 A9 D2			lda #BLT_NFO_NAME_CLEAR-BLT_CLEAR
   828 5294				vbsta VBXE_BL_ADR0
