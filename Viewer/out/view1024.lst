  2073 5DDF AD 8A 04			lda File_Index
  2074 5DE2 CD 8B 04			cmp ImageCount
  2075 5DE5 90 06			bcc Selector_Sync_Set
  2076 5DE7 AD 8B 04			lda ImageCount						; out of range (shouldn't happen) - clamp
  2077 5DEA 38				sec
  2078 5DEB E9 01			sbc #$01
