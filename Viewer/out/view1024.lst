   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3DB5			Text_Window_Frame_Chars
   504 3DB5 C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3DBE DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3DC7			Text_Window_Frame
   508 3DC7 A5 80			lda Reg1
   509 3DC9 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3DCB AD B1 06			lda Txt_Col
   511 3DCE 85 87			sta Reg8							; Reg8 = left column
   512 3DD0 AD B0 06			lda Txt_Row
   513 3DD3 18				clc
   514 3DD4 65 81			adc Reg2
   515 3DD6 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3DD8 AD B0 06			lda Txt_Row
   517 3DDB 85 84			sta Reg5							; Reg5 = current screen row
   518 3DDD AE B5 06			ldx Txt_FrameStyle
   519 3DE0 20 FF 3D			jsr Text_Window_Frame_Row			; top edge
   520 3DE3			Text_Window_Frame_Mid
   521 3DE3 E6 84			inc Reg5
   522 3DE5 A5 84			lda Reg5
   523 3DE7 C5 85			cmp Reg6
   524 3DE9 B0 0D			bcs Text_Window_Frame_Bottom
   525 3DEB AD B5 06			lda Txt_FrameStyle
   526 3DEE 18				clc
   527 3DEF 69 03			adc #$03
   528 3DF1 AA				tax
   529 3DF2 20 FF 3D			jsr Text_Window_Frame_Row			; interior row
   530 3DF5 4C E3 3D			jmp Text_Window_Frame_Mid
   531 3DF8			Text_Window_Frame_Bottom
   532 3DF8 AD B5 06			lda Txt_FrameStyle
   533 3DFB 18				clc
   534 3DFC 69 06			adc #$06
   535 3DFE AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3DFF			Text_Window_Frame_Row
   540 3DFF BD B5 3D			lda Text_Window_Frame_Chars,x
   541 3E02 8D 80 06			sta Txt_Line+0
   542 3E05 BD B6 3D			lda Text_Window_Frame_Chars+1,x
   543 3E08 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3E0A BD B7 3D			lda Text_Window_Frame_Chars+2,x
   545 3E0D 85 82			sta Reg3							; Reg3 = right char
   546 3E0F A2 01			ldx #$01
   547 3E11			Text_Window_Frame_Row_L1
   548 3E11 E4 86			cpx Reg7
   549 3E13 B0 08			bcs Text_Window_Frame_Row_End
   550 3E15 A5 83			lda Reg4
   551 3E17 9D 80 06			sta Txt_Line,x
   552 3E1A E8				inx
   553 3E1B D0 F4			bne Text_Window_Frame_Row_L1
   554 3E1D			Text_Window_Frame_Row_End
   555 3E1D A5 82			lda Reg3
   556 3E1F 9D 80 06			sta Txt_Line,x
   557 3E22 E8				inx
   558 3E23			Text_Window_Frame_PutRow
   559 3E23 A9 00			lda #$00
   560 3E25 9D 80 06			sta Txt_Line,x
   561 3E28 A5 84			lda Reg5
   562 3E2A 8D B0 06			sta Txt_Row
   563 3E2D A5 87			lda Reg8
   564 3E2F 8D B1 06			sta Txt_Col
   565 3E32 A9 80			lda #<Txt_Line
   566 3E34 85 96			sta Txt_Ptr
   567 3E36 A9 06			lda #>Txt_Line
   568 3E38 85 97			sta Txt_Ptr + $01
   569 3E3A 4C 3D 3E			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 3E3D			Text_PutStrAt
   583 3E3D A9 01			lda #$01
   584 3E3F 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 3E42 A9 00			lda #$00
   587 3E44 85 80			sta Reg1
   588 3E46 85 81			sta Reg2
   589 3E48 AE B0 06			ldx Txt_Row
   590 3E4B F0 0E			beq Text_PutStrAt_Col
   591 3E4D			Text_PutStrAt_RowL
   592 3E4D A5 80			lda Reg1
   593 3E4F 18				clc
   594 3E50 69 A0			adc #TEXT_PITCH
   595 3E52 85 80			sta Reg1
   596 3E54 90 02			bcc Text_PutStrAt_RowNC
   597 3E56 E6 81			inc Reg2
   598 3E58			Text_PutStrAt_RowNC
   599 3E58 CA				dex
   600 3E59 D0 F2			bne Text_PutStrAt_RowL
   601 3E5B			Text_PutStrAt_Col
   602 3E5B AD B1 06			lda Txt_Col
   603 3E5E 0A				asl									; Txt_Col * 2 (max 158)
   604 3E5F 18				clc
   605 3E60 65 80			adc Reg1
   606 3E62 85 80			sta Reg1
   607 3E64 90 02			bcc Text_PutStrAt_ColNC
   608 3E66 E6 81			inc Reg2
   609 3E68			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 3E68 A5 81			lda Reg2
   612 3E6A 29 10			and #$10							; offset bit 12 = "second bank"
   613 3E6C F0 04			beq Text_PutStrAt_Bank0
   614 3E6E A9 2B			lda #TEXT_BACK_BANK+1
   615 3E70 D0 02			bne Text_PutStrAt_SetBank
   616 3E72			Text_PutStrAt_Bank0
   617 3E72 A9 2A			lda #TEXT_BACK_BANK
   618 3E74			Text_PutStrAt_SetBank
   619 3E74 8D B6 06			sta Txt_Bank
   620 3E77 A5 80			lda Reg1
   621 3E79 85 88			sta Ptr_Lo
   622 3E7B A5 81			lda Reg2
   623 3E7D 29 0F			and #$0F
   624 3E7F 18				clc
   625 3E80 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 3E82 85 89			sta Ptr_Hi
   627 3E84 AD B6 06			lda Txt_Bank
   628 3E87 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 3E89				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E89 A0 5F			ldy #<VBXE_MA_BSEL
     3 3E8B 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 3E8D A9 00			lda #$00
   632 3E8F 85 82			sta Reg3							; Reg3 = source string index
   633 3E91 AD B1 06			lda Txt_Col
   634 3E94 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 3E96			Text_PutStrAt_Char
   636 3E96 A5 83			lda Reg4
   637 3E98 C9 50			cmp #TEXT_COLS
   638 3E9A B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 3E9C A4 82			ldy Reg3
   640 3E9E B1 96			lda (Txt_Ptr),y
   641 3EA0 F0 43			beq Text_PutStrAt_Done
   642 3EA2 C9 01			cmp #TXT_PEN
   643 3EA4 D0 0C			bne Text_PutStrAt_Glyph
   644 3EA6 C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 3EA7 B1 96			lda (Txt_Ptr),y
   646 3EA9 8D B4 06			sta Txt_Attr
   647 3EAC C8				iny
   648 3EAD 84 82			sty Reg3							; skip both bytes, column unchanged
   649 3EAF 4C 96 3E			jmp Text_PutStrAt_Char
   650 3EB2			Text_PutStrAt_Glyph
   651 3EB2 A0 00			ldy #$00
   652 3EB4 91 88			sta (Ptr_Lo),y						; glyph byte
   653 3EB6 C8				iny
   654 3EB7 AD B4 06			lda Txt_Attr
   655 3EBA 91 88			sta (Ptr_Lo),y						; attribute byte
   656 3EBC E6 82			inc Reg3
   657 3EBE E6 83			inc Reg4
   658 3EC0 A5 88			lda Ptr_Lo							; window pointer += 2
   659 3EC2 18				clc
   660 3EC3 69 02			adc #$02
   661 3EC5 85 88			sta Ptr_Lo
   662 3EC7 90 02			bcc Text_PutStrAt_NoPage
   663 3EC9 E6 89			inc Ptr_Hi
   664 3ECB			Text_PutStrAt_NoPage
   665 3ECB A5 89			lda Ptr_Hi
   666 3ECD C9 30			cmp #$30							; crossed out of the window -> next bank
   667 3ECF 90 C5			bcc Text_PutStrAt_Char
   668 3ED1 38				sec
   669 3ED2 E9 10			sbc #$10
   670 3ED4 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 3ED6 EE B6 06			inc Txt_Bank
   672 3ED9 AD B6 06			lda Txt_Bank
   673 3EDC 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 3EDE				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3EDE A0 5F			ldy #<VBXE_MA_BSEL
     3 3EE0 91 93			sta (VBXEBase),y
Source: text80.asm
   675 3EE2 4C 96 3E			jmp Text_PutStrAt_Char
   676 3EE5			Text_PutStrAt_Done
   677 3EE5 A9 00			lda #MEMAC_GLOBAL_DISABLE
   678 3EE7				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3EE7 A0 5F			ldy #<VBXE_MA_BSEL
     3 3EE9 91 93			sta (VBXEBase),y
Source: text80.asm
   679 3EEB 20 2F 3C			jsr Make_Attr						; restore the caller's pen (a TXT_PEN escape
   680 3EEE 8D B4 06			sta Txt_Attr						; may have changed it) - clobbers X
   681 3EF1 60				rts
