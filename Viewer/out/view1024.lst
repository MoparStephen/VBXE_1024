   696 345A A2 00			ldx #V1K_PAL_LEN / $1000
   697 345C A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   698 345E 8C E5 04			sty Seg_Tail
   699 3461 A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
