   343 				;-----------------------------------------------------------------------------
   344 				; Handle_Keys
   345 				;-----------------------------------------------------------------------------
   346 34B5			Handle_Keys
   347 				; If present, the next 3 lines will allow a "jump to exit" on a specific key press
   348 34B5 AD FC 02			lda CH
   349 34B8 C9 2F			cmp #$2F							; Press Q to quit
   350 34BA F0 50			beq Exit
   351 34BC C9 21			cmp #$21							; Space
   352 34BE F0 17			beq Handle_Space
   353 34C0 C9 32			cmp #$32							; 0
   354 34C2 F0 1C			beq Handle_0
   355 34C4 C9 1F			cmp #$1F							; 1
   356 34C6 F0 20			beq Handle_1
   357 34C8 C9 1E			cmp #$1E							; 2
   358 34CA F0 24			beq Handle_2
   359 34CC C9 1A			cmp #$1A							; 3
   360 34CE F0 28			beq Handle_3
   361 34D0 C9 18			cmp #$18							; 4
   362 34D2 F0 2C			beq Handle_4
   363 34D4			Handle_Keys_Done						; No more keys to test
   364 34D4 4C 06 35			jmp Read_Key_Done
   365
