  1541 				;-----------------------------------------------------------------------------
  1542 				; Sort_Range - in-place alphabetical selection sort of the records
  1543 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1544 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1545 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1546 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1547 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1548 				;-----------------------------------------------------------------------------
  1549 39AE			Sort_Range
  1550 39AE E0 02			cpx #$02
  1551 39B0 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1552 39B2 85 81			sta Reg2							; Reg2 = i = start
  1553 39B4 86 82			stx Reg3							; Reg3 = count (temp)
  1554 39B6 18				clc
  1555 39B7 65 82			adc Reg3
  1556 39B9 85 84			sta Reg5							; Reg5 = end = start + count
  1557 39BB 38				sec
  1558 39BC E9 01			sbc #$01
  1559 39BE 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1560
  1561 39C0 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1562 39C2				vbsta VBXE_MA_BSEL
