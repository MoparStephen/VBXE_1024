   174 				;-----------------------------------------------------------------------------
   175 				; Make_Attr - Txt_Fg / Txt_Bg -> A = the VBXE text-mode colour byte:
   176 				;   bits 0-6 = foreground palette entry (0-127)
   177 				;   bit 7    = 1 when the background is opaque (Txt_Bg != 0), 0 = transparent
   178 				;-----------------------------------------------------------------------------
   179 3A3E			Make_Attr
   180 3A3E AD B2 06			lda Txt_Fg
   181 3A41 29 7F			and #$7F
   182 3A43 AE B3 06			ldx Txt_Bg
   183 3A46 F0 02			beq Make_Attr_Done
   184 3A48 09 80			ora #$80
   185 3A4A			Make_Attr_Done
   186 3A4A 60				rts
   187
