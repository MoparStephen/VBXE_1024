   743 3573 A9 04			lda #CIO_read
   744 3575 9D 4A 03			sta ICAX1,x
   745 3578 A9 00			lda #$00
   746 357A 9D 4B 03			sta ICAX2,x
   747 357D A9 03			lda #CIO_open
