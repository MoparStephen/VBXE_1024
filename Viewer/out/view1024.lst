  1620
  1621 39E9 85 83			sta Reg4							; m = i
  1622 39EB 20 5B 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1623
  1624 39EE A5 81			lda Reg2
  1625 39F0 18				clc
