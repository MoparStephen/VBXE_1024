  1902 				;-----------------------------------------------------------------------------
  1903 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1904 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1905 				; equal) otherwise.
  1906 				;-----------------------------------------------------------------------------
  1907 3C89			Cmp_Records
  1908 3C89 A0 00			ldy #$00
  1909 3C8B			Cmp_Records_L1
  1910 3C8B B1 8A			lda (Name_Ptr),y
  1911 3C8D D1 8C			cmp (Sort_Ptr),y
  1912 3C8F D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1913 3C91 C8				iny
  1914 3C92 C0 08			cpy #$08
  1915 3C94 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1916 3C96			Cmp_Records_Done
  1917 3C96 60				rts
