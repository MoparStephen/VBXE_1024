     3 				;-----------------------------------------------------------------------------
     4 				; Memory Map
     5 				;-----------------------------------------------------------------------------
     6 				; Load Address = 
     7 				; Run Address = 
     8 				; VBXE:
     9 				;    XDLs            = $00000 - $00020
    10 				;    BCBs            = $00100 - $001FF
    11 				;    NTSC_Palette    = $00200 - $004FF (Used to restore Palette 0 on program exit)
    12 				;    PAL_Palette     = $00500 - $006FF (Used to restore Palette 0 on program exit)
    13 				;    VRAM            = $01000 - $13BFF (Video Ram)
    14 				;    CRAM_Buffer     = $14000 - $1657F (Compressed palette bytes)
    15 				;    CRAM            = $17000 - $205FF (Colour Ram)
    16 				;    Palette_Buffers = $21000 - $21FFF (Temp 4kB buffer for loading palettes)
    17 				;    Image name list = $40000 - $40FFF (bank $40: up to MAX_IMAGES=255 base
    18 				;                      names, 8 bytes each, built at startup by Scan_Images)
    19 				;
    20 				; MAX_IMAGES is a hard design ceiling of 255 - each image is a ~90kB
    21 				; .PAL/.MAP/.RAW set, so 255 far exceeds any real slideshow, and a one-byte
    22 				; count keeps every nav/sort loop small. Not intended to ever be raised.
    23
