  2000 				;-----------------------------------------------------------------------------
  2001 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2002 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2003 				; the whole .NFO is shorter than the window, clear first and blit only the
  2004 				; records that exist.
  2005 				;-----------------------------------------------------------------------------
  2006 57F1			Info_Draw
  2007 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2008 57F1 38				sec
  2009 57F2 AD DE 04			lda Nfo_LineCount
  2010 57F5 ED DC 04			sbc Nfo_Top
  2011 57F8 85 84			sta Reg5
  2012 57FA AD DF 04			lda Nfo_LineCount + $01
  2013 57FD ED DD 04			sbc Nfo_Top + $01
  2014 5800 85 85			sta Reg6
  2015 				; rows = min(available, NFO_VISROWS)
  2016 5802 A5 85			lda Reg6
  2017 5804 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2018 5806 A5 84			lda Reg5
  2019 5808 C9 14			cmp #NFO_VISROWS
  2020 580A B0 10			bcs Info_Draw_Full
  2021 				; short document: clear, then blit only the records that exist
