   153 2196 00 00			dta $00,$00							; Source step y (unused)
   154 2198 00				dta $00								; Source step x (unused)
   155 2199 00 40 03			dta <MENU_SEP_VRAM,>MENU_SEP_VRAM,MENU_SEP_VRAM>>16			; Destination address
   156 219C A0 00			dta a(MENU_SEP_PITCH)				; Destination step y (unused - 1 row)
   157 219E 01				dta $01								; Destination step x (1)
   158 219F 9F 00			dta a(MENU_SEP_PITCH-1)				; Width-1  (159 -> 160 bytes/row)
   159 21A1 00				dta $00								; Height-1 (1 row)
   160 21A2 00				dta $00								; And mask (0 -> constant source)
   161 21A3 00				dta $00								; Xor mask (fill value - set at runtime by Fill_Pal_Preview_Cmap)
   162 21A4 00				dta $00								; Collision and mask
   163 21A5 00				dta $00								; Zoom
   164 21A6 00				dta $00								; Pattern feature
   165 21A7 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   166
   167 				; Menu banner palette-demo overlay - blit Build_Menu_Ramp_Table's 256-byte
   168 				; ascending source ($2E000, bank $2E - fixed, never patched) as a flat 16x16
   169 				; block into one of the demo's 8 squares.  Draw_Menu_Demo_Squares (view1024.
   170 				; asm) patches Dest_Adr0-2 from Menu_Demo_Dest_Table before each of the 8
   171 				; kicks; every other field is fixed.
   172 21A8			BLT_MENU_DEMO_SQUARE
