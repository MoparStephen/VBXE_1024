  1042 53D1 18				clc
  1043 53D2 69 00			adc #<ImageNames
  1044 53D4 85 88			sta Ptr_Lo
  1045 53D6 A5 89			lda Ptr_Hi
  1046 53D8 69 20			adc #>ImageNames
  1047 53DA 85 89			sta Ptr_Hi
  1048 53DC A0 00			ldy #$00
