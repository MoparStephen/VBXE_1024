  2770 				;=============================================================================
  2771 				; Shared directory helpers
  2772 				;-----------------------------------------------------------------------------
  2773 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2774 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2775 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2776 				; navigation lives in the selector itself.
  2777 				;=============================================================================
  2778
  2779 				;-----------------------------------------------------------------------------
  2780 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2781 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2782 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2783 				;-----------------------------------------------------------------------------
  2784 6282			Line_Has_Dir_Tag
  2785 6282 A2 00			ldx #$00
  2786 6284			Line_Has_Dir_Tag_L1
  2787 6284 BD 00 06			lda Dir_Line_Buf,x
  2788 6287 C9 3C			cmp #'<'
  2789 6289 D0 1F			bne Line_Has_Dir_Tag_Next
  2790 628B BD 01 06			lda Dir_Line_Buf+1,x
  2791 628E C9 44			cmp #'D'
  2792 6290 D0 18			bne Line_Has_Dir_Tag_Next
  2793 6292 BD 02 06			lda Dir_Line_Buf+2,x
  2794 6295 C9 49			cmp #'I'
  2795 6297 D0 11			bne Line_Has_Dir_Tag_Next
  2796 6299 BD 03 06			lda Dir_Line_Buf+3,x
  2797 629C C9 52			cmp #'R'
  2798 629E D0 0A			bne Line_Has_Dir_Tag_Next
  2799 62A0 BD 04 06			lda Dir_Line_Buf+4,x
  2800 62A3 C9 3E			cmp #'>'
  2801 62A5 D0 03			bne Line_Has_Dir_Tag_Next
  2802 62A7 A9 01			lda #$01							; found
  2803 62A9 60				rts
  2804 62AA			Line_Has_Dir_Tag_Next
  2805 62AA E8				inx
  2806 62AB E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2807 62AD 90 D5			bcc Line_Has_Dir_Tag_L1
  2808 62AF A9 00			lda #$00							; not found
  2809 62B1 60				rts
