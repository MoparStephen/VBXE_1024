   256 5174 2A 2E 56 31 4B 9B	Build_Spec_ImgWild		dta c'*.V1K',$9B
   257 517A 2A 2E 2A 9B		Build_Spec_AnyWild		dta c'*.*',$9B
   258 517E 49 4D 41 47 45 53 + Build_Spec_ManifestName	dta c'IMAGES.LST',$9B
