   203 				; Setup_Cmap1 - Sets byte 4 for all cmap entries via blitter
   204 				;-----------------------------------------------------------------------------
   205 3368			Setup_Cmap1
   206 3368 A9 15			lda	#BLT_SETUP_CMAP_1-BLT_CLEAR
   207 336A 8D 50 D6			sta	VBXE_BL_ADR0					; Setup the blitter for memory fill operation
   208 336D A9 00			lda	#0
   209 336F 8D 52 D6			sta	VBXE_BL_ADR2					; See the description of BCB at the end of this
   210 3372 A9 01			lda	#$01							; Source
   211 3374 8D 51 D6			sta	VBXE_BL_ADR1
   212 3377 A9 00			lda	#0
   213 3379			Setup_Cmap1_L1
   214 3379 AD 53 D6			lda	VBXE_BLITTER_BUSY
   215 337C C9 00			cmp	#0
   216 337E D0 F9			bne	Setup_Cmap1_L1					; Wait for blitter to finish
   217 3380 A9 01			lda	#1
   218 3382 8D 53 D6			sta	VBXE_BLITTER_START				; Start the blit
   219 3385 60				rts
