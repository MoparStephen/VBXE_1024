  1600 				;-----------------------------------------------------------------------------
  1601 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1602 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1603 				; crosses the visible window, else just re-colours the old and new cells;
  1604 				; always repaints the status line, then returns to the key loop.
  1605 				;-----------------------------------------------------------------------------
  1606 5732			Sel_Nav_Apply
  1607 5732 48				pha									; stash the new index
  1608 5733 AD C7 04			lda Sel_Index
  1609 5736 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1610 5738 68				pla
  1611 5739 8D C7 04			sta Sel_Index
  1612 573C 20 5E 57			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1613 573F CD C8 04			cmp Sel_Top
  1614 5742 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1615 5744 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1616 5747 20 85 51			jsr Selector_DrawList
  1617 574A 4C 58 57			jmp Sel_Key_Nav_Done
  1618 574D			Sel_Nav_Apply_Rows
  1619 574D A5 87			lda Reg8
  1620 574F 20 29 52			jsr Selector_HiRow					; un-highlight the cell we left
  1621 5752 AD C7 04			lda Sel_Index
  1622 5755 20 29 52			jsr Selector_HiRow					; highlight the cell we moved to
  1623 5758			Sel_Key_Nav_Done
  1624 5758 20 5D 53			jsr Selector_DrawStatus				; row 20: description of the new row
  1625 575B 4C 6B 38			jmp Read_Key_Done
  1626
  1627 				;-----------------------------------------------------------------------------
  1628 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1629 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1630 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1631 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1632 				;-----------------------------------------------------------------------------
  1633 575E			Sel_Top_For_Index
  1634 575E 4A				lsr
  1635 575F 4A				lsr
  1636 5760 4A				lsr
  1637 5761 85 80			sta Reg1							; Reg1 = target item_row
  1638 5763 AD C8 04			lda Sel_Top
  1639 5766 4A				lsr
  1640 5767 4A				lsr
  1641 5768 4A				lsr								; A = current top_row
  1642 5769 C5 80			cmp Reg1
  1643 576B 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1644 576D F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1645 576F A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1646 5771 4C 80 57			jmp Sel_Top_FI_Scale
  1647 5774			Sel_Top_FI_MaybeDown
  1648 5774 18				clc
  1649 5775 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1650 5777 C5 80			cmp Reg1
  1651 5779 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1652 577B A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1653 577D 38				sec
  1654 577E E9 0E			sbc #[UI_VISROWS-1]
  1655 5780			Sel_Top_FI_Scale
