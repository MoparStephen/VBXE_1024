  2046 				;-----------------------------------------------------------------------------
  2047 				; Slideshow_Tick - called from main every frame.  Counts Slide_FrameCtr down
  2048 				; and advances to the next image at zero.  No-op unless UI_Mode = 2.
  2049 				;-----------------------------------------------------------------------------
  2050 5A6F			Slideshow_Tick
  2051 5A6F AD C6 04			lda UI_Mode
  2052 5A72 C9 02			cmp #$02
  2053 5A74 F0 01			beq Slideshow_Tick_Run
  2054 5A76 60				rts
  2055 5A77			Slideshow_Tick_Run
  2056 5A77 AD CA 04			lda Slide_FrameCtr
  2057 5A7A D0 08			bne Slideshow_Tick_Dec
  2058 5A7C AD CB 04			lda Slide_FrameCtr+1
  2059 5A7F F0 07			beq Slideshow_Tick_Fire				; counter reached 0
  2060 5A81 CE CB 04			dec Slide_FrameCtr+1
  2061 5A84			Slideshow_Tick_Dec
  2062 5A84 CE CA 04			dec Slide_FrameCtr
  2063 5A87 60				rts
  2064 5A88			Slideshow_Tick_Fire
  2065 5A88 20 77 33			jsr Clear_Screen
  2066 5A8B 20 BF 38			jsr Increment_Image
