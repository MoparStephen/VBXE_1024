  2441 5FBE			Slideshow_Reload_NoCarry
  2442 5FBE CA				dex
  2443 5FBF D0 EF			bne Slideshow_Reload_L1
  2444 5FC1			Slideshow_Reload_Done
  2445 5FC1 60				rts
