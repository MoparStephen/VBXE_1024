   123
   124 				;-----------------------------------------------------------------------------
   125 				;vblda	- loads accumulator with VBXE register value
   126 				;	  use:	vblda	VBXE_REGISTER
   127
   128 				; NOTE (__VBXE_AUTO__ mode only): VBXE_BASE is $0000 in this mode, so every
   129 				; VBXE_xxx equate is already just its register offset ($40-$5F). VBXEBase is
   130 				; set ONCE by VBXE_Detect (lo=$00, hi=$D6/$D7), so indexing through it costs
   131 				; a flat 8 cycles/access regardless of which page VBXE lives on - no per-call
   132 				; self-modifying code. This clobbers Y - callers must not rely on Y surviving
   133 				; a vblda/vbsta call in auto mode.
   134 				vblda	.macro
   135 				.ifdef	__VBXE_AUTO__
   136 					ldy #<:1
   137 					lda (VBXEBase),y
   138 				.else
   139 					lda :1
   140 				.endif
   141 				.endm
   142
   143 				;-----------------------------------------------------------------------------
   144 				;vbsta	- stores accumulator in VBXE register
   145 				;	  use:	vbvbsta	VBXE_REGISTER
   146
   147 				vbsta	.macro
   148 				.ifdef	__VBXE_AUTO__
   149 					ldy #<:1
   150 					sta (VBXEBase),y
   151 				.else
   152 					sta.w :1
   153 				.endif
   154 				.endm
