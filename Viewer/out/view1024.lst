   454 3FD4 90 02			bcc Text_Window_Setup_ColNC
   455 3FD6 E6 84			inc Reg5
   456 3FD8			Text_Window_Setup_ColNC
   457 3FD8 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
