  1762 3BA5 A9 00			lda #$00
  1763 3BA7 85 83			sta Reg4
  1764 3BA9 06 82			asl Reg3
  1765 3BAB 26 83			rol Reg4
  1766 3BAD 06 82			asl Reg3
  1767 3BAF 26 83			rol Reg4
