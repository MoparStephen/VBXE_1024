  1638 3A07 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1639 3A09 85 83			sta Reg4
  1640 3A0B A5 8C			lda Sort_Ptr
  1641 3A0D 85 8A			sta Name_Ptr
  1642 3A0F A5 8D			lda Sort_Ptr + $01
  1643 3A11 85 8B			sta Name_Ptr + $01
  1644 3A13			Sort_Range_Inner_Next
