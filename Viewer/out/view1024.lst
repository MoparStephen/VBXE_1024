   324 3C2B			Text_FillColour_RowL
   325 3C2B A5 83			lda Reg4
   326 3C2D 18				clc
   327 3C2E 69 A0			adc #TEXT_PITCH						; + 160 per row
   328 3C30 85 83			sta Reg4
   329 3C32 90 02			bcc Text_FillColour_RowNC
   330 3C34 E6 84			inc Reg5
   331 3C36			Text_FillColour_RowNC
   332 3C36 CA				dex
   333 3C37 D0 F2			bne Text_FillColour_RowL
   334 3C39			Text_FillColour_Col
   335 3C39 AD B1 06			lda Txt_Col
   336 3C3C 0A				asl									; Txt_Col * 2
   337 3C3D 18				clc
   338 3C3E 65 83			adc Reg4
   339 3C40 85 83			sta Reg4
   340 3C42 90 02			bcc Text_FillColour_ColNC
   341 3C44 E6 84			inc Reg5
   342 3C46			Text_FillColour_ColNC
   343 3C46 E6 83			inc Reg4							; + 1  -> the attribute (odd) byte
   344 3C48 D0 02			bne Text_FillColour_Patch
   345 3C4A E6 84			inc Reg5
   346 3C4C			Text_FillColour_Patch
   347 3C4C A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
