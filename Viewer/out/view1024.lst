   182 3331 A9 68			lda #<Device_Name
   183 3333 8D 44 03			sta ICBAL							; Use channel #0
   184 3336 A9 33			lda #>Device_Name
   185 3338 8D 45 03			sta ICBAH
   186 333B 20 56 E4			jsr CIOV
