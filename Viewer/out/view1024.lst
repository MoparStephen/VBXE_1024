  2101 				;=============================================================================
  2102 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2103 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2104 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2105 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2106 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  2107 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  2108 				;=============================================================================
  2109
  2110 				;-----------------------------------------------------------------------------
  2111 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2112 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2113 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2114 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2115 				; off screen.
  2116 				;-----------------------------------------------------------------------------
  2117 5ABE			Info_Load
  2118 5ABE A9 25			lda #NFO_BUF_BANK
  2119 5AC0 85 8E			sta BankIndex
  2120 5AC2 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2121 5AC5 AD 2D 31			lda LoadStatus
  2122 5AC8 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2123 5ACA 20 CE 5A			jsr Info_Count_Lines				; sets Nfo_LineCount
  2124 5ACD			Info_Load_Ret
  2125 5ACD 60				rts
  2126
  2127 				;-----------------------------------------------------------------------------
  2128 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2129 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2130 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2131 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2132 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2133 				;-----------------------------------------------------------------------------
  2134 5ACE			Info_Count_Lines
  2135 5ACE A9 00			lda #$00
  2136 5AD0 8D DE 04			sta Nfo_LineCount
  2137 5AD3 8D DF 04			sta Nfo_LineCount + $01
  2138 5AD6 A9 25			lda #NFO_BUF_BANK
  2139 5AD8 8D 50 06			sta Nfo_WalkBank
  2140 5ADB 09 80			ora #MEMAC_GLOBAL_ENABLE
  2141 5ADD				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5ADD A0 5F			ldy #<VBXE_MA_BSEL
     3 5ADF 91 93			sta (VBXEBase),y
Source: ui.asm
  2142 5AE1 A9 00			lda #<VBXE_WINDOW
  2143 5AE3 85 88			sta Ptr_Lo
  2144 5AE5 A9 20			lda #>VBXE_WINDOW
  2145 5AE7 85 89			sta Ptr_Hi
  2146 5AE9			Info_Count_L1
  2147 5AE9 A0 00			ldy #$00
  2148 5AEB B1 88			lda (Ptr_Lo),y
  2149 5AED F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2150 5AEF EE DE 04			inc Nfo_LineCount
  2151 5AF2 AD DE 04			lda Nfo_LineCount
  2152 5AF5 C9 7F			cmp #NFO_MAX_LINES
  2153 5AF7 B0 24			bcs Info_Count_Done					; hit the record cap
  2154 5AF9 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2155 5AFB 18				clc
  2156 5AFC 69 A0			adc #TEXT_PITCH
