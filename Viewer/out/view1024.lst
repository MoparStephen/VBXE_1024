   424 346C			blit_clear
   425 					; clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
   426 					; 496x16 zoom 8x8 clear blit (this takes 2 frames)
   427
   428 					;	dta e($00000)	; Source address
   429 					;	dta a($0000)	; Source step y
   430 					;	dta 0			; Source step x
   431 					;	dta e($7BFFF)	; Destination address
   432 					;	dta a(-$0F80)	; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
   433 					;	dta -1			; Destination step x (backwards	1 byte)
   434 					;	dta a($01EF)	; Width-1  (495)	496 * 8 bytes wide
   435 					;	dta $0F			; Height-1 (15)		 16 * 8 bytes high
   436 					;	dta $00			; And mask (And mask equal to 0 so clear)
   437 					;	dta $00			; Xor mask (will be filled with xor mask)
   438 					;	dta $00			; Collision and mask
   439 					;	dta $77			; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
   440 					;	dta $00			; Pattern feature
   441 					;	dta $00			; Control (Mode 0 with NEXT bit Cleared)
   442
   443 346C 00 00 00 00 00 00 + 	dta e($00000), a($0000), 0, e($7BFFF), a(-$0F80), -1, a($01EF), $0F, $00, $00, $00, $77, $00, $00
   444
   445 3481			blit_fill_map
   446 					; 320 x 240 constant-source fill of $01 at MAP_FILL_VRAM (AND 0, XOR $01)
   447 3481 00 00 00 00 00 00 + 	dta e($00000), a($0000), 0, e(MAP_FILL_VRAM), a($0140), 1, a($013F), $EF, $00, $01, $00, $00, $00, $00
