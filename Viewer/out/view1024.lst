  1212 3775			Handle_Keys
  1213 				; Dispatch on the current UI mode - the selector, slideshow, drive picker and
  1214 				; info viewer each have their own key set (ui.asm); mode 1 (image view) uses
  1215 				; the set below.
  1216 3775 AD DC 02			lda HELPFLG							; Help isn't in CH - the OS sets HELPFLG ($11/$51/$91)
  1217 3778 F0 08			beq Handle_Keys_NoHelp
  1218 377A A9 00			lda #$00
