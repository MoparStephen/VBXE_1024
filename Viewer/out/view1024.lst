  1236 3887 D0 06			bne Handle_Keys_Mode
  1237 3889 20 A3 3B			jsr Toggle_Font						; (text80.asm) - a CHBASE flip, nothing is redrawn
  1238 388C 4C 28 39			jmp Read_Key_Done
  1239 388F			Handle_Keys_Mode
  1240 388F AD C6 04			lda UI_Mode
  1241 3892 D0 03			bne Handle_Keys_NotSelector
