  2749 				;=============================================================================
  2750 				; Shared directory helpers
  2751 				;-----------------------------------------------------------------------------
  2752 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2753 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2754 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2755 				; navigation lives in the selector itself.
  2756 				;=============================================================================
  2757
  2758 				;-----------------------------------------------------------------------------
  2759 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2760 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2761 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2762 				;-----------------------------------------------------------------------------
  2763 5FDF			Line_Has_Dir_Tag
  2764 5FDF A2 00			ldx #$00
  2765 5FE1			Line_Has_Dir_Tag_L1
  2766 5FE1 BD 00 06			lda Dir_Line_Buf,x
  2767 5FE4 C9 3C			cmp #'<'
  2768 5FE6 D0 1F			bne Line_Has_Dir_Tag_Next
  2769 5FE8 BD 01 06			lda Dir_Line_Buf+1,x
  2770 5FEB C9 44			cmp #'D'
  2771 5FED D0 18			bne Line_Has_Dir_Tag_Next
  2772 5FEF BD 02 06			lda Dir_Line_Buf+2,x
  2773 5FF2 C9 49			cmp #'I'
  2774 5FF4 D0 11			bne Line_Has_Dir_Tag_Next
  2775 5FF6 BD 03 06			lda Dir_Line_Buf+3,x
  2776 5FF9 C9 52			cmp #'R'
  2777 5FFB D0 0A			bne Line_Has_Dir_Tag_Next
  2778 5FFD BD 04 06			lda Dir_Line_Buf+4,x
  2779 6000 C9 3E			cmp #'>'
  2780 6002 D0 03			bne Line_Has_Dir_Tag_Next
  2781 6004 A9 01			lda #$01							; found
  2782 6006 60				rts
  2783 6007			Line_Has_Dir_Tag_Next
  2784 6007 E8				inx
  2785 6008 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2786 600A 90 D5			bcc Line_Has_Dir_Tag_L1
  2787 600C A9 00			lda #$00							; not found
  2788 600E 60				rts
  2789
  2790 				;-----------------------------------------------------------------------------
  2791 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2792 				; space-padded).  Refuses if the result would not fit.
  2793 				;-----------------------------------------------------------------------------
  2794 600F			Folder_Path_Push
  2795 600F A2 00			ldx #$00
  2796 6011			Folder_Path_Push_End
  2797 6011 BD 28 06			lda Scan_Path,x
  2798 6014 F0 06			beq Folder_Path_Push_Name
  2799 6016 E8				inx
  2800 6017 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2801 6019 90 F6			bcc Folder_Path_Push_End
  2802 601B 60				rts									; path too long already - refuse
  2803 601C			Folder_Path_Push_Name
  2804 601C A0 00			ldy #$00
  2805 601E			Folder_Path_Push_L1
  2806 601E B9 CD 04			lda Name_Row_Buf,y
  2807 6021 F0 0D			beq Folder_Path_Push_Sep
  2808 6023 C9 20			cmp #' '
  2809 6025 F0 09			beq Folder_Path_Push_Sep
  2810 6027 9D 28 06			sta Scan_Path,x
  2811 602A E8				inx
  2812 602B C8				iny
  2813 602C C0 08			cpy #$08
  2814 602E 90 EE			bcc Folder_Path_Push_L1
  2815 6030			Folder_Path_Push_Sep
  2816 6030 A9 3E			lda #'>'
  2817 6032 9D 28 06			sta Scan_Path,x
  2818 6035 E8				inx
  2819 6036 A9 00			lda #$00
  2820 6038 9D 28 06			sta Scan_Path,x
  2821 603B 60				rts
  2822
  2823 				;-----------------------------------------------------------------------------
  2824 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2825 				;-----------------------------------------------------------------------------
  2826 603C			Path_Pop_Segment
  2827 603C A2 00			ldx #$00
  2828 603E			Path_Pop_End
  2829 603E BD 28 06			lda Scan_Path,x
  2830 6041 F0 05			beq Path_Pop_Found
  2831 6043 E8				inx
  2832 6044 E0 28			cpx #$28
  2833 6046 90 F6			bcc Path_Pop_End
  2834 6048			Path_Pop_Found							; X = index of the NUL
  2835 6048 E0 00			cpx #$00
  2836 604A F0 13			beq Path_Pop_Done					; already empty
  2837 604C CA				dex									; step onto the trailing '>'
  2838 604D			Path_Pop_L1
  2839 604D E0 00			cpx #$00
  2840 604F F0 09			beq Path_Pop_Cut
  2841 6051 CA				dex
  2842 6052 BD 28 06			lda Scan_Path,x
  2843 6055 C9 3E			cmp #'>'
  2844 6057 D0 F4			bne Path_Pop_L1
  2845 6059 E8				inx									; keep this separator
  2846 605A			Path_Pop_Cut
  2847 605A A9 00			lda #$00
  2848 605C 9D 28 06			sta Scan_Path,x
  2849 605F			Path_Pop_Done
  2850 605F 60				rts
  2851
