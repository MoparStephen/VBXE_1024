   592 				;-----------------------------------------------------------------------------
   593 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   594 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   595 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   596 				; for text).  Called once at boot (above) and from every Enter_Selector
   597 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   598 				; viewed in between and there is no way to avoid that hardware-register
   599 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   600 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
   601 				;-----------------------------------------------------------------------------
   602 3469			Apply_Menu_Banner_Palette
   603 3469 A9 B4			lda #(MENU_BANNER_PAL_VRAM / $1000) | MEMAC_GLOBAL_ENABLE
   604 346B				vbsta VBXE_MA_BSEL
