  1791 56AC AD 8A 04			lda File_Index
  1792 56AF CD 8B 04			cmp ImageCount
  1793 56B2 90 06			bcc Selector_Sync_Set
  1794 56B4 AD 8B 04			lda ImageCount						; out of range (shouldn't happen) - clamp
  1795 56B7 38				sec
  1796 56B8 E9 01			sbc #$01
  1797 56BA			Selector_Sync_Set
  1798 56BA 8D C7 04			sta Sel_Index
  1799 56BD 20 48 54			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
