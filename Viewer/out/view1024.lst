  1458 				; Build_Filename
  1459 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1460 				;       File_Index = image ordinal
  1461 				;  Out: FileNamePtr -> Path_Buf holding
  1462 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1463 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1464 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1465 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1466 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1467 				;-----------------------------------------------------------------------------
