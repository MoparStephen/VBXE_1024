  1464 3931 85 83			sta Reg4
  1465 3933 06 82			asl Reg3
  1466 3935 26 83			rol Reg4
  1467 3937 06 82			asl Reg3
  1468 3939 26 83			rol Reg4
  1469 393B 06 82			asl Reg3
  1470 393D 26 83			rol Reg4							; Reg3/Reg4 = File_Index * 8
  1471 393F A5 82			lda Reg3
  1472 3941 18				clc
  1473 3942 69 00			adc #<ImageNames
  1474 3944 85 8A			sta Name_Ptr
  1475 3946 A5 83			lda Reg4
  1476 3948 69 20			adc #>ImageNames
