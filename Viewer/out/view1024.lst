  1354 				;-----------------------------------------------------------------------------
  1355 				; Increment_Image - advance File_Index within the *.V1K file band
  1356 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1357 				; No-op when the list holds no files.  (The selector list may now also carry
  1358 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1359 				;-----------------------------------------------------------------------------
  1360 38B8			Increment_Image
  1361 38B8 AD DA 04			lda FileStart
  1362 38BB CD 8B 04			cmp ImageCount
  1363 38BE B0 12			bcs Increment_Image_Done			; no *.V1K files in the list
  1364 38C0 AE 8A 04			ldx File_Index
  1365 38C3 E8				inx
  1366 38C4 EC 8B 04			cpx ImageCount
  1367 38C7 90 03			bcc Increment_Image_Store
  1368 38C9 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1369 38CC			Increment_Image_Store
  1370 38CC 8E 8A 04			stx File_Index
  1371 38CF 20 0E 34			jsr Load_Image
  1372 38D2			Increment_Image_Done
  1373 38D2 60				rts
  1374
  1375 				;-----------------------------------------------------------------------------
  1376 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1377 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1378 				;-----------------------------------------------------------------------------
  1379 38D3			Decrement_Image
  1380 38D3 AD DA 04			lda FileStart
  1381 38D6 CD 8B 04			cmp ImageCount
  1382 38D9 B0 12			bcs Decrement_Image_Done
  1383 38DB AE 8A 04			ldx File_Index
  1384 38DE EC DA 04			cpx FileStart
  1385 38E1 D0 03			bne Decrement_Image_Step
  1386 38E3 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1387 38E6			Decrement_Image_Step
  1388 38E6 CA				dex
  1389 38E7 8E 8A 04			stx File_Index
  1390 38EA 20 0E 34			jsr Load_Image
  1391 38ED			Decrement_Image_Done
  1392 38ED 60				rts
