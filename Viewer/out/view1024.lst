  2827 				;-----------------------------------------------------------------------------
  2828 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2829 				;-----------------------------------------------------------------------------
  2830 623C			Path_Pop_Segment
  2831 623C A2 00			ldx #$00
  2832 623E			Path_Pop_End
