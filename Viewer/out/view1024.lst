  1029 				;-----------------------------------------------------------------------------
  1030 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1031 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1032 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1033 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1034 				;-----------------------------------------------------------------------------
  1035 549B			Nfo_Name_MapSlot
  1036 549B AD E1 04			lda Nfo_Name_Ord
  1037 549E 4A				lsr									; C = Ord & 1
  1038 549F A9 00			lda #$00
  1039 54A1 6A				ror									; A = (Ord & 1) << 7
  1040 54A2 85 88			sta Ptr_Lo
  1041 54A4 AD E1 04			lda Nfo_Name_Ord
  1042 54A7 4A				lsr
  1043 54A8 29 0F			and #$0F							; (Ord >> 1) & 15
  1044 54AA 18				clc
  1045 54AB 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1046 54AD 85 89			sta Ptr_Hi
  1047 54AF AD E1 04			lda Nfo_Name_Ord
  1048 54B2 4A				lsr
  1049 54B3 4A				lsr
  1050 54B4 4A				lsr
  1051 54B5 4A				lsr
  1052 54B6 4A				lsr									; Ord >> 5  (0..7)
  1053 54B7 18				clc
  1054 54B8 69 37			adc #NFO_NAME_BANK
