   722 				; Attribute-cell byte offsets (within a 160-byte expanded map row) for the 8
   723 				; columns the demo overlay covers - cell*4+3 (the real attribute byte; the
   724 				; other 3 bytes/cell are always zero - see Setup_Menu_Cmap/BLT_SETUP_MENU_
   725 				; CMAP).  Left-edge block = cells 0-3 (pixels 0-31); right-edge block = cells
   726 				; 36-39 (pixels 288-319, since MENU_BANNER_PITCH/8 = 40 cells/row).
   727 350D			Menu_Demo_Attr_Cols
   728 350D 03 07 0B 0F 93 97 + 	dta 3,7,11,15,147,151,155,159
   729 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
   730 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
   731 				; copy reads as a flipped reflection of the left-hand one; the underlying
   732 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
   733 				; register each cell points at changes.
   734 3515			Menu_Demo_Attr_Top_Vals
   735 3515 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
   736 				; Same column order: BL/BR pal ids (<<4), left edge then right edge (mirrored:
   737 				; pal 3,2 instead of 2,3 - see note above).
   738 351D			Menu_Demo_Attr_Bot_Vals
   739 351D 20 20 30 30 30 30 + 	dta $20,$20,$30,$30,$30,$30,$20,$20
