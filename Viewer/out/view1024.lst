   439 				;-----------------------------------------------------------------------------
   440 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   441 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   442 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   443 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   444 				;  Returns A = $01 if a name was written, $00 if not.
   445 				;-----------------------------------------------------------------------------
   446 50D4			Parse_Dir_Line
   447 50D4 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   448 50D6			Parse_Skip_L1							; Skip leading spaces / protect flag
   449 50D6 BD 00 06			lda Dir_Line_Buf,x
   450 50D9 C9 9B			cmp #$9B
   451 50DB F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   452 50DD C9 20			cmp #' '
   453 50DF F0 04			beq Parse_Skip_Next
   454 50E1 C9 2A			cmp #'*'
   455 50E3 D0 07			bne Parse_Skip_Done
   456 50E5			Parse_Skip_Next
   457 50E5 E8				inx
   458 50E6 E0 28			cpx #Dir_Line_Len
   459 50E8 90 EC			bcc Parse_Skip_L1
   460 50EA B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   461 50EC			Parse_Skip_Done
   462 50EC A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   463 50EE A9 00			lda #$00
   464 50F0 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   465
   466 50F2			Parse_Copy_L1
   467 50F2 BD 00 06			lda Dir_Line_Buf,x
   468 50F5 C9 9B			cmp #$9B
   469 50F7 F0 24			beq Parse_Copy_Done
   470 50F9 C9 20			cmp #' '
   471 50FB F0 20			beq Parse_Copy_Done
   472 50FD C9 2E			cmp #'.'
   473 50FF F0 1C			beq Parse_Copy_Done
   474 5101 C9 30			cmp #'0'
   475 5103 90 07			bcc Parse_Copy_Is_Name_Char
   476 5105 C9 3A			cmp #'9'+1
   477 5107 B0 03			bcs Parse_Copy_Is_Name_Char
   478 5109 4C 0E 51			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   479 510C			Parse_Copy_Is_Name_Char
   480 510C E6 80			inc Reg1
   481 510E			Parse_Copy_Store
   482 510E C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   483 5110 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   484 5112 BD 00 06			lda Dir_Line_Buf,x
   485 5115 91 8A			sta (Name_Ptr),y
   486 5117 C8				iny
   487 5118			Parse_Copy_Next
   488 5118 E8				inx
   489 5119 E0 28			cpx #Dir_Line_Len
   490 511B 90 D5			bcc Parse_Copy_L1
   491
   492 511D			Parse_Copy_Done
   493 511D A5 80			lda Reg1
   494 511F F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   495
   496 5121			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   497 5121 C0 08			cpy #$08
   498 5123 B0 07			bcs Parse_Dir_Line_Accept
   499 5125 A9 20			lda #' '
   500 5127 91 8A			sta (Name_Ptr),y
   501 5129 C8				iny
   502 512A D0 F5			bne Parse_Pad_L1
   503
   504 512C			Parse_Dir_Line_Accept
   505 512C A9 01			lda #$01							; Non-zero - a name was stored
   506 512E 60				rts
   507 512F			Parse_Dir_Line_Reject
   508 512F A9 00			lda #$00
   509 5131 60				rts
