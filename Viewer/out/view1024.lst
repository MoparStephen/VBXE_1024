   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3F6B			Text_Window_Frame_Chars
   504 3F6B C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3F74 DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3F7D			Text_Window_Frame
   508 3F7D A5 80			lda Reg1
   509 3F7F 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3F81 AD B1 06			lda Txt_Col
   511 3F84 85 87			sta Reg8							; Reg8 = left column
   512 3F86 AD B0 06			lda Txt_Row
   513 3F89 18				clc
   514 3F8A 65 81			adc Reg2
   515 3F8C 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3F8E AD B0 06			lda Txt_Row
   517 3F91 85 84			sta Reg5							; Reg5 = current screen row
   518 3F93 AE B5 06			ldx Txt_FrameStyle
   519 3F96 20 B5 3F			jsr Text_Window_Frame_Row			; top edge
   520 3F99			Text_Window_Frame_Mid
   521 3F99 E6 84			inc Reg5
   522 3F9B A5 84			lda Reg5
   523 3F9D C5 85			cmp Reg6
   524 3F9F B0 0D			bcs Text_Window_Frame_Bottom
   525 3FA1 AD B5 06			lda Txt_FrameStyle
   526 3FA4 18				clc
   527 3FA5 69 03			adc #$03
   528 3FA7 AA				tax
   529 3FA8 20 B5 3F			jsr Text_Window_Frame_Row			; interior row
   530 3FAB 4C 99 3F			jmp Text_Window_Frame_Mid
   531 3FAE			Text_Window_Frame_Bottom
   532 3FAE AD B5 06			lda Txt_FrameStyle
   533 3FB1 18				clc
   534 3FB2 69 06			adc #$06
   535 3FB4 AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3FB5			Text_Window_Frame_Row
   540 3FB5 BD 6B 3F			lda Text_Window_Frame_Chars,x
   541 3FB8 8D 80 06			sta Txt_Line+0
   542 3FBB BD 6C 3F			lda Text_Window_Frame_Chars+1,x
   543 3FBE 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3FC0 BD 6D 3F			lda Text_Window_Frame_Chars+2,x
   545 3FC3 85 82			sta Reg3							; Reg3 = right char
   546 3FC5 A2 01			ldx #$01
   547 3FC7			Text_Window_Frame_Row_L1
   548 3FC7 E4 86			cpx Reg7
   549 3FC9 B0 08			bcs Text_Window_Frame_Row_End
   550 3FCB A5 83			lda Reg4
   551 3FCD 9D 80 06			sta Txt_Line,x
   552 3FD0 E8				inx
   553 3FD1 D0 F4			bne Text_Window_Frame_Row_L1
   554 3FD3			Text_Window_Frame_Row_End
   555 3FD3 A5 82			lda Reg3
   556 3FD5 9D 80 06			sta Txt_Line,x
   557 3FD8 E8				inx
   558 3FD9			Text_Window_Frame_PutRow
   559 3FD9 A9 00			lda #$00
   560 3FDB 9D 80 06			sta Txt_Line,x
   561 3FDE A5 84			lda Reg5
   562 3FE0 8D B0 06			sta Txt_Row
   563 3FE3 A5 87			lda Reg8
   564 3FE5 8D B1 06			sta Txt_Col
   565 3FE8 A9 80			lda #<Txt_Line
   566 3FEA 85 96			sta Txt_Ptr
   567 3FEC A9 06			lda #>Txt_Line
   568 3FEE 85 97			sta Txt_Ptr + $01
   569 3FF0 4C F3 3F			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
