   191 3B52 AD E0 04			lda Font_Sel
   192 3B55 49 01			eor #$01
   193 3B57 8D E0 04			sta Font_Sel
   194 3B5A 18				clc
   195 3B5B 69 44			adc #TEXT_CHBASE					; 0 -> $44 (CGA) / 1 -> $45 (Atari)
   196 3B5D AA				tax									; hold it - vbsta clobbers A (and Y)
   197 3B5E A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the $2000 window
   198 3B60				vbsta VBXE_MA_BSEL
