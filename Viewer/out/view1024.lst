  1061 				;-----------------------------------------------------------------------------
  1062 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1063 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1064 				; equal) otherwise.
  1065 				;-----------------------------------------------------------------------------
  1066 375B			Cmp_Records
  1067 375B A0 00			ldy #$00
  1068 375D			Cmp_Records_L1
  1069 375D B1 8A			lda (Name_Ptr),y
  1070 375F D1 8C			cmp (Sort_Ptr),y
  1071 3761 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1072 3763 C8				iny
  1073 3764 C0 08			cpy #$08
  1074 3766 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1075 3768			Cmp_Records_Done
  1076 3768 60				rts
  1077
