   462 				;-----------------------------------------------------------------------------
   463 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   464 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row).  Tracks bank + window
   465 				; offset explicitly (a row near the bottom straddles the $24000 boundary).
   466 				;-----------------------------------------------------------------------------
   467 3B12			Text_PutStrAt
   468 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   469 3B12 A9 00			lda #$00
   470 3B14 85 80			sta Reg1
   471 3B16 85 81			sta Reg2
   472 3B18 AE B0 06			ldx Txt_Row
   473 3B1B F0 0E			beq Text_PutStrAt_Col
   474 3B1D			Text_PutStrAt_RowL
   475 3B1D A5 80			lda Reg1
   476 3B1F 18				clc
   477 3B20 69 A0			adc #TEXT_PITCH
   478 3B22 85 80			sta Reg1
   479 3B24 90 02			bcc Text_PutStrAt_RowNC
   480 3B26 E6 81			inc Reg2
   481 3B28			Text_PutStrAt_RowNC
   482 3B28 CA				dex
   483 3B29 D0 F2			bne Text_PutStrAt_RowL
   484 3B2B			Text_PutStrAt_Col
   485 3B2B AD B1 06			lda Txt_Col
   486 3B2E 0A				asl									; Txt_Col * 2 (max 158)
   487 3B2F 18				clc
   488 3B30 65 80			adc Reg1
   489 3B32 85 80			sta Reg1
   490 3B34 90 02			bcc Text_PutStrAt_ColNC
   491 3B36 E6 81			inc Reg2
   492 3B38			Text_PutStrAt_ColNC
   493 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   494 3B38 A5 81			lda Reg2
   495 3B3A 29 10			and #$10							; offset bit 12 = "second bank"
   496 3B3C F0 04			beq Text_PutStrAt_Bank0
   497 3B3E A9 24			lda #TEXT_SCREEN_BANK+1
   498 3B40 D0 02			bne Text_PutStrAt_SetBank
   499 3B42			Text_PutStrAt_Bank0
   500 3B42 A9 23			lda #TEXT_SCREEN_BANK
   501 3B44			Text_PutStrAt_SetBank
   502 3B44 8D B6 06			sta Txt_Bank
   503 3B47 A5 80			lda Reg1
   504 3B49 85 88			sta Ptr_Lo
   505 3B4B A5 81			lda Reg2
   506 3B4D 29 0F			and #$0F
   507 3B4F 18				clc
   508 3B50 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   509 3B52 85 89			sta Ptr_Hi
   510 3B54 AD B6 06			lda Txt_Bank
   511 3B57 09 80			ora #MEMAC_GLOBAL_ENABLE
   512 3B59				vbsta VBXE_MA_BSEL
