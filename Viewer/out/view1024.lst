  1639 				;-----------------------------------------------------------------------------
  1640 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1641 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1642 				; crosses the visible window, else just re-colours the old and new cells;
  1643 				; always repaints the status line, then returns to the key loop.
  1644 				;-----------------------------------------------------------------------------
  1645 5AF7			Sel_Nav_Apply
  1646 5AF7 48				pha									; stash the new index
  1647 5AF8 AD C7 04			lda Sel_Index
  1648 5AFB 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1649 5AFD 68				pla
  1650 5AFE 8D C7 04			sta Sel_Index
  1651 5B01 20 23 5B			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1652 5B04 CD C8 04			cmp Sel_Top
  1653 5B07 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1654 5B09 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1655 5B0C 20 43 55			jsr Selector_DrawList
  1656 5B0F 4C 1D 5B			jmp Sel_Key_Nav_Done
  1657 5B12			Sel_Nav_Apply_Rows
  1658 5B12 A5 87			lda Reg8
  1659 5B14 20 E7 55			jsr Selector_HiRow					; un-highlight the cell we left
  1660 5B17 AD C7 04			lda Sel_Index
  1661 5B1A 20 E7 55			jsr Selector_HiRow					; highlight the cell we moved to
  1662 5B1D			Sel_Key_Nav_Done
  1663 5B1D 20 1B 57			jsr Selector_DrawStatus				; row 20: description of the new row
  1664 5B20 4C 16 3A			jmp Read_Key_Done
  1665
  1666 				;-----------------------------------------------------------------------------
  1667 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1668 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1669 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1670 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1671 				;-----------------------------------------------------------------------------
  1672 5B23			Sel_Top_For_Index
  1673 5B23 4A				lsr
  1674 5B24 4A				lsr
  1675 5B25 4A				lsr
  1676 5B26 85 80			sta Reg1							; Reg1 = target item_row
  1677 5B28 AD C8 04			lda Sel_Top
  1678 5B2B 4A				lsr
  1679 5B2C 4A				lsr
  1680 5B2D 4A				lsr								; A = current top_row
