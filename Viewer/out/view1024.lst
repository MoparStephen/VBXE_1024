  2632 				; Status panel rows 20-22: each starts with a 3-letter tag + ':' in UI_PEN_LOC.
  2633 				; Row 21 = "Cfg:" (col 0) + the delay (cols 5-6) + UI_Str_DelayHint (col 7);
  2634 				; row 22 = UI_Str_Legend (col 0).  Both rows are exactly 80 cells.
  2635 5E9C 01 7C 43 66 67 3A + UI_Str_Delay		dta TXT_PEN,UI_PEN_LOC,c'Cfg:',0
