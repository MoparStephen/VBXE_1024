    86 39B6 85 89			sta Ptr_Hi
    87 39B8 A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    88 39BA 85 80			sta Reg1
    89 39BC A9 20			lda #>VBXE_WINDOW
    90 39BE 85 81			sta Reg2
    91 39C0 20 DD 39			jsr Text_Copy_2K
    92
