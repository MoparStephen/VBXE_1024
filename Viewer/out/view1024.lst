  1365 				;-----------------------------------------------------------------------------
  1366 				; Increment_Image - advance File_Index within the *.V1K file band
  1367 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1368 				; No-op when the list holds no files.  (The selector list may now also carry
  1369 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1370 				;-----------------------------------------------------------------------------
  1371 38BF			Increment_Image
  1372 38BF AD DA 04			lda FileStart
  1373 38C2 CD 8B 04			cmp ImageCount
  1374 38C5 B0 12			bcs Increment_Image_Done			; no *.V1K files in the list
  1375 38C7 AE 8A 04			ldx File_Index
  1376 38CA E8				inx
  1377 38CB EC 8B 04			cpx ImageCount
  1378 38CE 90 03			bcc Increment_Image_Store
  1379 38D0 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1380 38D3			Increment_Image_Store
  1381 38D3 8E 8A 04			stx File_Index
  1382 38D6 20 ED 33			jsr Load_Image
  1383 38D9			Increment_Image_Done
  1384 38D9 60				rts
  1385
  1386 				;-----------------------------------------------------------------------------
  1387 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1388 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1389 				;-----------------------------------------------------------------------------
  1390 38DA			Decrement_Image
  1391 38DA AD DA 04			lda FileStart
  1392 38DD CD 8B 04			cmp ImageCount
  1393 38E0 B0 12			bcs Decrement_Image_Done
  1394 38E2 AE 8A 04			ldx File_Index
  1395 38E5 EC DA 04			cpx FileStart
  1396 38E8 D0 03			bne Decrement_Image_Step
  1397 38EA AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1398 38ED			Decrement_Image_Step
  1399 38ED CA				dex
  1400 38EE 8E 8A 04			stx File_Index
  1401 38F1 20 ED 33			jsr Load_Image
  1402 38F4			Decrement_Image_Done
  1403 38F4 60				rts
