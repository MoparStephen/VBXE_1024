  1102 5734			Nfo_Name_Emit_Pad
  1103 5734 A9 20			lda #$20
  1104 5736			Nfo_Name_Emit_PadL
  1105 5736 C0 4B			cpy #NFO_NAME_CAP
  1106 5738 B0 06			bcs Nfo_Name_Emit_Term
