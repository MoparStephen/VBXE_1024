Source: ui.asm
     1 				;=============================================================================
     2 				; ui.asm  -  viewer UI: file selector, slideshow, runtime directory scan
     3 				;-----------------------------------------------------------------------------
     4 				; This is the main segment (icl'd from view1024.asm at $3300+).  Everything
     5 				; here is entered only at runtime - from start: and from the key handlers -
     6 				; so NONE of it is reachable from an ini step (unlike the old Scan_Images).
     7 				;
     8 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register access here
     9 				; goes through vbsta / vblda, never a bare lda / sta VBXE_* (a bare access
    10 				; silently collapses to a zero-page hit - the $53 / VBXE_BLITTER_BUSY hang).
    11 				; vbsta/vblda clobber Y in auto mode: no live Y is held across one below.
    12 				;
    13 				; Screen model (text80.asm): 80 columns x TEXT_ROWS(23) rows, Palette 0 - the
    14 				; menu/info XDL (xdl.asm) displays this ONE buffer as two on-screen bands (a
    15 				; graphics banner sits above it, a 1-line separator between the bands, see
    16 				; xdl.asm for the full 240-scanline layout).  Selector row map:
    17 				;   row 0            Location: <path>
    18 				;   row 1            blank
    19 				;   rows 2-16 (15)   scrolling grid (UI_FIRSTROW/UI_VISROWS below)
    20 				;   rows 17-19       spare/margin (blank)
    21 				;   row 20 (TEXT_MAIN_ROWS+0)   status line (Src: ...)
    22 				;   row 21 (TEXT_MAIN_ROWS+1)   slideshow delay
    23 				;   row 22 (TEXT_MAIN_ROWS+2)   key legend
    24 				; The info viewer uses rows 0..TEXT_MAIN_ROWS-1 for scrollable content and
    25 				; row TEXT_MAIN_ROWS for a single fixed hint line - see NFO_VISROWS below.
    26 				;
    27 				; UI_Mode:  0 = selector   1 = image view   2 = slideshow
    28 				;           3 = drive picker (D-key save-under overlay)   4 = info viewer (.nfo)
    29 				;           5 = quit-confirm (Q-key save-under overlay, selector only)
    30 				;=============================================================================
    31
    32 = 0008			.def	UI_COLS			= 8				; grid columns (items/row) - a power of 2
    33 														; keeps row=index>>3 / col=index&7 cheap
    34 = 000F			.def	UI_VISROWS		= 15			; grid rows visible at once
    35 = 0002			.def	UI_FIRSTROW		= 2				; first screen row of the grid
    36 = 0000			.def	UI_GRIDCOL0		= 0				; first screen column of the grid (Sel_ColX base)
    37 				; UI_FIRSTROW / UI_GRIDCOL0 are the only placement knobs - see the row map
    38 				; above for the rest of the selector's chrome (status/delay/legend rows).
    39 = 0001			.def	UI_SLIDE_MIN	= 1
    40 = 001E			.def	UI_SLIDE_MAX	= 30
    41 				; VBXE text-mode colour byte: bits 0-6 = foreground palette-0 entry (0-127),
    42 				; bit 7 = 1 -> opaque background (hardware-forced to palette[fg+128]), 0 ->
    43 				; transparent.  UI_Apply_TextPalette de-interleaves the Atari master into set 0
    44 				; so entry e = master colour 2e: hue = e>>3 (all 16 hues), luma = (e&7)*2.
    45 				; The cursor row is marked by FOREGROUND colour only - no opaque bar - because
    46 				; after the de-interleave palette[e+128] is the adjacent-luma neighbour of
    47 				; palette[e] and gives no contrast.  Tune the three indices once on screen.
    48 = 0007			.def	UI_PEN_FG		= $07			; normal text   : hue 0 grey,  luma 14
    49 = 000F			.def	UI_PEN_HI		= $0F			; highlighted   : hue 1 gold,  luma 14
    50 = 0062			.def	UI_PEN_DIR		= $62			; directory/".." : hue $C green, luma 4
    51
    52 = 0000			.def	NFO_TOPROW		= 0				; info viewer: first screen row of the scroll region
    53 = 0014			.def	NFO_VISROWS		= TEXT_MAIN_ROWS	; info viewer: visible text rows (main band only)
    54 				; The logo band is real now (the menu XDL's graphics group, see xdl.asm) - it
    55 				; lives in its own VRAM, not stolen text rows, so NFO_TOPROW stays 0.
    56 				; NFO_VISROWS must equal TEXT_MAIN_ROWS (not the full TEXT_ROWS buffer): the
    57 				; blit overwrites every row it touches, and rows TEXT_MAIN_ROWS..TEXT_ROWS-1
    58 				; hold the separate static footer hint line - the NFO blit must not touch it.
    59 = 007F			.def	NFO_MAX_LINES	= 127			; cap on displayed .NFO records; NFO_BUF_VRAM (5 banks)
    60 													; holds 128 * 160, the 128th slot being the $00 sentinel
    61
    62 				; --- CH key codes (POKEY, no modifier).  Matches the bare-CH style in
    63 				;     Handle_Keys (Q $2F, Space $21, BkSp $34, Esc $1C, digits ...).
    64 = 000E			.def	KEY_UP			= $0E			; "-" key (up-arrow, unshifted)
    65 = 000F			.def	KEY_DOWN		= $0F			; "=" key (down-arrow, unshifted)
    66 = 000C			.def	KEY_RETURN		= $0C
    67 = 001C			.def	KEY_ESC			= $1C
    68 = 0021			.def	KEY_SPACE		= $21
    69 = 002F			.def	KEY_Q			= $2F
    70 = 003E			.def	KEY_S			= $3E
    71 = 003A			.def	KEY_D			= $3A
    72 = 0038			.def	KEY_F			= $38			; toggle text font (CGA <-> Atari)
    73 = 000A			.def	KEY_P			= $0A
    74 = 000D			.def	KEY_I			= $0D
    75 = 0020			.def	KEY_COMMA		= $20			; "," - shorter slideshow delay
    76 = 0022			.def	KEY_DOT			= $22			; "." - longer slideshow delay
    77 = 002B			.def	KEY_Y			= $2B			; quit-confirm: yes (verified via Altirra CH readback)
    78 = 0023			.def	KEY_N			= $23			; quit-confirm: no  (verified via Altirra CH readback)
    79 = 008E			.def	KEY_LEFT		= $8E			; Ctrl+"-" (bare KEY_UP $0E | CTRL bit $80)
    80 = 008F			.def	KEY_RIGHT		= $8F			; Ctrl+"=" (bare KEY_DOWN $0F | CTRL bit $80)
    81
    82 				;-----------------------------------------------------------------------------
    83 				; TXT_AT row, col, strlabel  -  draw a string via the text API
    84 				;-----------------------------------------------------------------------------
    85 				.macro TXT_AT
    86 					lda #[:1]
    87 					sta Txt_Row
    88 					lda #[:2]
    89 					sta Txt_Col
    90 					lda #<[:3]
    91 					sta Txt_Ptr
    92 					lda #>[:3]
    93 					sta Txt_Ptr + $01
    94 					jsr Text_PutStrAt
    95 				.endm
