  2189 5B1C AD DC 04			lda Nfo_Top
  2190 5B1F 0D DD 04			ora Nfo_Top + $01
  2191 5B22 F0 0E			beq Info_Key_PageUp_Draw
  2192 5B24 AD DC 04			lda Nfo_Top
  2193 5B27 D0 03			bne Info_Key_PageUp_NB
  2194 5B29 CE DD 04			dec Nfo_Top + $01
  2195 5B2C			Info_Key_PageUp_NB
  2196 5B2C CE DC 04			dec Nfo_Top
  2197 5B2F CA				dex
