  1682 5870 4C 7F 58			jmp Sel_Top_FI_Scale
  1683 5873			Sel_Top_FI_MaybeDown
  1684 5873 18				clc
  1685 5874 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1686 5876 C5 80			cmp Reg1
  1687 5878 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1688 587A A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1689 587C 38				sec
  1690 587D E9 0E			sbc #[UI_VISROWS-1]
  1691 587F			Sel_Top_FI_Scale
  1692 587F 0A				asl
  1693 5880 0A				asl
  1694 5881 0A				asl								; row -> Sel_Top (* UI_COLS)
  1695 5882 60				rts
