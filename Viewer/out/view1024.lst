  1580 39DC 20 13 3A			jsr Cmp_Records						; rec(m) : rec(j)
  1581 39DF 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1582 39E1 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1583 39E3 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1584 39E5 85 83			sta Reg4
  1585 39E7 A5 8C			lda Sort_Ptr
  1586 39E9 85 8A			sta Name_Ptr
  1587 39EB A5 8D			lda Sort_Ptr + $01
  1588 39ED 85 8B			sta Name_Ptr + $01
  1589 39EF			Sort_Range_Inner_Next
