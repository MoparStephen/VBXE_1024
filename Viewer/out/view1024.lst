   478 				;-----------------------------------------------------------------------------
   479 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   480 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row).  Tracks bank + window
   481 				; offset explicitly (a row near the bottom straddles the $24000 boundary).
   482 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   483 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   484 				; is restored on exit, so an escape never leaks into the next draw.
   485 				;-----------------------------------------------------------------------------
   486 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   487
   488 3CF9			Text_PutStrAt
   489 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   490 3CF9 A9 00			lda #$00
   491 3CFB 85 80			sta Reg1
   492 3CFD 85 81			sta Reg2
   493 3CFF AE B0 06			ldx Txt_Row
   494 3D02 F0 0E			beq Text_PutStrAt_Col
   495 3D04			Text_PutStrAt_RowL
   496 3D04 A5 80			lda Reg1
   497 3D06 18				clc
   498 3D07 69 A0			adc #TEXT_PITCH
   499 3D09 85 80			sta Reg1
   500 3D0B 90 02			bcc Text_PutStrAt_RowNC
   501 3D0D E6 81			inc Reg2
   502 3D0F			Text_PutStrAt_RowNC
   503 3D0F CA				dex
   504 3D10 D0 F2			bne Text_PutStrAt_RowL
   505 3D12			Text_PutStrAt_Col
   506 3D12 AD B1 06			lda Txt_Col
   507 3D15 0A				asl									; Txt_Col * 2 (max 158)
   508 3D16 18				clc
   509 3D17 65 80			adc Reg1
   510 3D19 85 80			sta Reg1
   511 3D1B 90 02			bcc Text_PutStrAt_ColNC
   512 3D1D E6 81			inc Reg2
   513 3D1F			Text_PutStrAt_ColNC
   514 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   515 3D1F A5 81			lda Reg2
   516 3D21 29 10			and #$10							; offset bit 12 = "second bank"
   517 3D23 F0 04			beq Text_PutStrAt_Bank0
   518 3D25 A9 24			lda #TEXT_SCREEN_BANK+1
   519 3D27 D0 02			bne Text_PutStrAt_SetBank
   520 3D29			Text_PutStrAt_Bank0
   521 3D29 A9 23			lda #TEXT_SCREEN_BANK
   522 3D2B			Text_PutStrAt_SetBank
   523 3D2B 8D B6 06			sta Txt_Bank
   524 3D2E A5 80			lda Reg1
   525 3D30 85 88			sta Ptr_Lo
   526 3D32 A5 81			lda Reg2
   527 3D34 29 0F			and #$0F
   528 3D36 18				clc
   529 3D37 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   530 3D39 85 89			sta Ptr_Hi
   531 3D3B AD B6 06			lda Txt_Bank
   532 3D3E 09 80			ora #MEMAC_GLOBAL_ENABLE
   533 3D40				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3D40 A0 5F			ldy #<VBXE_MA_BSEL
     3 3D42 91 93			sta (VBXEBase),y
Source: text80.asm
   534 				; --- write the cells -------------------------------------------------------
   535 3D44 A9 00			lda #$00
   536 3D46 85 82			sta Reg3							; Reg3 = source string index
   537 3D48 AD B1 06			lda Txt_Col
   538 3D4B 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   539 3D4D			Text_PutStrAt_Char
   540 3D4D A5 83			lda Reg4
   541 3D4F C9 50			cmp #TEXT_COLS
   542 3D51 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   543 3D53 A4 82			ldy Reg3
   544 3D55 B1 96			lda (Txt_Ptr),y
   545 3D57 F0 43			beq Text_PutStrAt_Done
   546 3D59 C9 01			cmp #TXT_PEN
   547 3D5B D0 0C			bne Text_PutStrAt_Glyph
   548 3D5D C8				iny									; TXT_PEN, attr - next byte is the new pen
   549 3D5E B1 96			lda (Txt_Ptr),y
   550 3D60 8D B4 06			sta Txt_Attr
   551 3D63 C8				iny
   552 3D64 84 82			sty Reg3							; skip both bytes, column unchanged
   553 3D66 4C 4D 3D			jmp Text_PutStrAt_Char
   554 3D69			Text_PutStrAt_Glyph
   555 3D69 A0 00			ldy #$00
   556 3D6B 91 88			sta (Ptr_Lo),y						; glyph byte
   557 3D6D C8				iny
   558 3D6E AD B4 06			lda Txt_Attr
   559 3D71 91 88			sta (Ptr_Lo),y						; attribute byte
   560 3D73 E6 82			inc Reg3
   561 3D75 E6 83			inc Reg4
   562 3D77 A5 88			lda Ptr_Lo							; window pointer += 2
   563 3D79 18				clc
   564 3D7A 69 02			adc #$02
   565 3D7C 85 88			sta Ptr_Lo
   566 3D7E 90 02			bcc Text_PutStrAt_NoPage
   567 3D80 E6 89			inc Ptr_Hi
   568 3D82			Text_PutStrAt_NoPage
   569 3D82 A5 89			lda Ptr_Hi
   570 3D84 C9 30			cmp #$30							; crossed out of the window -> next bank
   571 3D86 90 C5			bcc Text_PutStrAt_Char
   572 3D88 38				sec
   573 3D89 E9 10			sbc #$10
   574 3D8B 85 89			sta Ptr_Hi							; wrap back to $20xx
   575 3D8D EE B6 06			inc Txt_Bank
   576 3D90 AD B6 06			lda Txt_Bank
   577 3D93 09 80			ora #MEMAC_GLOBAL_ENABLE
   578 3D95				vbsta VBXE_MA_BSEL
