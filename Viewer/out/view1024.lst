  1644 				;-----------------------------------------------------------------------------
  1645 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1646 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1647 				; crosses the visible window, else just re-colours the old and new cells;
  1648 				; always repaints the status line, then returns to the key loop.
  1649 				;-----------------------------------------------------------------------------
  1650 5AFC			Sel_Nav_Apply
  1651 5AFC 48				pha									; stash the new index
  1652 5AFD AD C7 04			lda Sel_Index
  1653 5B00 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1654 5B02 68				pla
  1655 5B03 8D C7 04			sta Sel_Index
  1656 5B06 20 28 5B			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1657 5B09 CD C8 04			cmp Sel_Top
  1658 5B0C F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1659 5B0E 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1660 5B11 20 48 55			jsr Selector_DrawList
  1661 5B14 4C 22 5B			jmp Sel_Key_Nav_Done
  1662 5B17			Sel_Nav_Apply_Rows
  1663 5B17 A5 87			lda Reg8
  1664 5B19 20 EC 55			jsr Selector_HiRow					; un-highlight the cell we left
  1665 5B1C AD C7 04			lda Sel_Index
  1666 5B1F 20 EC 55			jsr Selector_HiRow					; highlight the cell we moved to
  1667 5B22			Sel_Key_Nav_Done
  1668 5B22 20 20 57			jsr Selector_DrawStatus				; row 20: description of the new row
  1669 5B25 4C 11 3A			jmp Read_Key_Done
  1670
  1671 				;-----------------------------------------------------------------------------
  1672 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1673 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1674 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1675 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1676 				;-----------------------------------------------------------------------------
  1677 5B28			Sel_Top_For_Index
  1678 5B28 4A				lsr
  1679 5B29 4A				lsr
  1680 5B2A 4A				lsr
  1681 5B2B 85 80			sta Reg1							; Reg1 = target item_row
  1682 5B2D AD C8 04			lda Sel_Top
  1683 5B30 4A				lsr
  1684 5B31 4A				lsr
  1685 5B32 4A				lsr								; A = current top_row
