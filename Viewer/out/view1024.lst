   459 3D72 A5 80			lda Reg1							; Width-1 (bytes) = (cells-1)*2 + 1 = Reg1*2 + 1
   460 3D74 0A				asl
   461 3D75 18				clc
   462 3D76 69 01			adc #$01
   463 3D78 8D 8A 21			sta BLT_TEXT_RECT + Blt_W0
   464 3D7B A9 00			lda #$00
   465 3D7D 8D 8B 21			sta BLT_TEXT_RECT + Blt_W1
   466 3D80 A5 81			lda Reg2
   467 3D82 8D 8C 21			sta BLT_TEXT_RECT + Blt_H
   468 3D85 60				rts
