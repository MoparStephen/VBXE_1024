   213 				;-----------------------------------------------------------------------------
   214 				; Text_FillColour - recolour a rectangle of cells by flooding their attribute
   215 				; (odd) bytes.  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   216 				; (cells), Reg2 = height-1 (rows), A = attribute byte.  Patches BLT_FILL_COLOUR
   217 				; (dest address, Width-1, Height-1, Xor mask) then kicks it and waits.
   218 				;-----------------------------------------------------------------------------
   219 3A74			Text_FillColour
   220 3A74 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   221 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
   222 3A76 A9 00			lda #$00
   223 3A78 85 83			sta Reg4
   224 3A7A 85 84			sta Reg5
   225 3A7C AE B0 06			ldx Txt_Row
   226 3A7F F0 0E			beq Text_FillColour_Col
   227 3A81			Text_FillColour_RowL
   228 3A81 A5 83			lda Reg4
   229 3A83 18				clc
   230 3A84 69 A0			adc #TEXT_PITCH						; + 160 per row
   231 3A86 85 83			sta Reg4
   232 3A88 90 02			bcc Text_FillColour_RowNC
   233 3A8A E6 84			inc Reg5
   234 3A8C			Text_FillColour_RowNC
   235 3A8C CA				dex
   236 3A8D D0 F2			bne Text_FillColour_RowL
   237 3A8F			Text_FillColour_Col
   238 3A8F AD B1 06			lda Txt_Col
   239 3A92 0A				asl									; Txt_Col * 2
   240 3A93 18				clc
