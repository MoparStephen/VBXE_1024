   284 				;-----------------------------------------------------------------------------
   285 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   286 				; cells between the text screen and WIN_SAVE_VRAM (a save-under buffer held at
   287 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   288 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   289 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   290 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   291 				; caller can Save then Frame on the same geometry.)
   292 				;-----------------------------------------------------------------------------
   293 3BCC			Text_Window_Save
   294 3BCC 20 1A 3C			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   295 3BCF A5 83			lda Reg4
   296 3BD1 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   297 3BD4 A5 84			lda Reg5
   298 3BD6 18				clc
   299 3BD7 69 30			adc #$30							; low 16 bits of TEXT_SCREEN_VRAM = $3000
   300 3BD9 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   301 3BDC A9 02			lda #$02
   302 3BDE 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   303 3BE1 A9 00			lda #<WIN_SAVE_VRAM
   304 3BE3 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   305 3BE6 A9 F0			lda #>WIN_SAVE_VRAM
   306 3BE8 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   307 3BEB A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 3BED 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3BF0 4C 5A 3C			jmp Text_Window_Kick
   310
   311 3BF3			Text_Window_Restore
   312 3BF3 20 1A 3C			jsr Text_Window_Setup
   313 3BF6 A9 00			lda #<WIN_SAVE_VRAM
   314 3BF8 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3BFB A9 F0			lda #>WIN_SAVE_VRAM
   316 3BFD 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3C00 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3C02 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3C05 A5 83			lda Reg4
   320 3C07 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   321 3C0A A5 84			lda Reg5
   322 3C0C 18				clc
   323 3C0D 69 30			adc #$30
   324 3C0F 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   325 3C12 A9 02			lda #$02
   326 3C14 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   327 3C17 4C 5A 3C			jmp Text_Window_Kick
   328
   329 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   330 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   331 3C1A			Text_Window_Setup
   332 3C1A A9 00			lda #$00
   333 3C1C 85 83			sta Reg4
   334 3C1E 85 84			sta Reg5
   335 3C20 AE B0 06			ldx Txt_Row
   336 3C23 F0 0E			beq Text_Window_Setup_Col
   337 3C25			Text_Window_Setup_RowL
   338 3C25 A5 83			lda Reg4
   339 3C27 18				clc
