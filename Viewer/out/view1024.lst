  2240 				;=============================================================================
  2241 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2242 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2243 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2244 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2245 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  2246 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  2247 				;=============================================================================
  2248
  2249 				;-----------------------------------------------------------------------------
  2250 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2251 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2252 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2253 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2254 				; off screen.
  2255 				;-----------------------------------------------------------------------------
  2256 5B70			Info_Load
  2257 5B70 A9 25			lda #NFO_BUF_BANK
  2258 5B72 85 8E			sta BankIndex
  2259 5B74 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2260 5B77 AD 2D 31			lda LoadStatus
  2261 5B7A F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2262 5B7C 20 80 5B			jsr Info_Count_Lines				; sets Nfo_LineCount
  2263 5B7F			Info_Load_Ret
  2264 5B7F 60				rts
  2265
  2266 				;-----------------------------------------------------------------------------
  2267 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2268 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2269 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2270 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2271 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2272 				;-----------------------------------------------------------------------------
  2273 5B80			Info_Count_Lines
  2274 5B80 A9 00			lda #$00
  2275 5B82 8D DE 04			sta Nfo_LineCount
  2276 5B85 8D DF 04			sta Nfo_LineCount + $01
  2277 5B88 A9 25			lda #NFO_BUF_BANK
  2278 5B8A 8D 50 06			sta Nfo_WalkBank
  2279 5B8D 09 80			ora #MEMAC_GLOBAL_ENABLE
  2280 5B8F				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5B8F A0 5F			ldy #<VBXE_MA_BSEL
     3 5B91 91 93			sta (VBXEBase),y
Source: ui.asm
  2281 5B93 A9 00			lda #<VBXE_WINDOW
  2282 5B95 85 88			sta Ptr_Lo
  2283 5B97 A9 20			lda #>VBXE_WINDOW
  2284 5B99 85 89			sta Ptr_Hi
  2285 5B9B			Info_Count_L1
  2286 5B9B A0 00			ldy #$00
  2287 5B9D B1 88			lda (Ptr_Lo),y
  2288 5B9F F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2289 5BA1 EE DE 04			inc Nfo_LineCount
  2290 5BA4 AD DE 04			lda Nfo_LineCount
  2291 5BA7 C9 7F			cmp #NFO_MAX_LINES
  2292 5BA9 B0 24			bcs Info_Count_Done					; hit the record cap
  2293 5BAB A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2294 5BAD 18				clc
  2295 5BAE 69 A0			adc #TEXT_PITCH
  2296 5BB0 85 88			sta Ptr_Lo
  2297 5BB2 90 E7			bcc Info_Count_L1
  2298 5BB4 E6 89			inc Ptr_Hi
  2299 5BB6 A5 89			lda Ptr_Hi
  2300 5BB8 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2301 5BBA 90 DF			bcc Info_Count_L1
  2302 5BBC E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2303 5BBE 85 89			sta Ptr_Hi
  2304 5BC0 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2305 5BC3 AD 50 06			lda Nfo_WalkBank
  2306 5BC6 09 80			ora #MEMAC_GLOBAL_ENABLE
  2307 5BC8				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
