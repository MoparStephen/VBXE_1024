  2364 				;=============================================================================
  2365 				; Shared directory helpers
  2366 				;-----------------------------------------------------------------------------
  2367 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2368 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2369 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2370 				; navigation lives in the selector itself.
  2371 				;=============================================================================
  2372
  2373 				;-----------------------------------------------------------------------------
  2374 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2375 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2376 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2377 				;-----------------------------------------------------------------------------
  2378 5C69			Line_Has_Dir_Tag
  2379 5C69 A2 00			ldx #$00
  2380 5C6B			Line_Has_Dir_Tag_L1
  2381 5C6B BD 00 06			lda Dir_Line_Buf,x
  2382 5C6E C9 3C			cmp #'<'
  2383 5C70 D0 1F			bne Line_Has_Dir_Tag_Next
  2384 5C72 BD 01 06			lda Dir_Line_Buf+1,x
  2385 5C75 C9 44			cmp #'D'
  2386 5C77 D0 18			bne Line_Has_Dir_Tag_Next
  2387 5C79 BD 02 06			lda Dir_Line_Buf+2,x
  2388 5C7C C9 49			cmp #'I'
  2389 5C7E D0 11			bne Line_Has_Dir_Tag_Next
  2390 5C80 BD 03 06			lda Dir_Line_Buf+3,x
  2391 5C83 C9 52			cmp #'R'
  2392 5C85 D0 0A			bne Line_Has_Dir_Tag_Next
  2393 5C87 BD 04 06			lda Dir_Line_Buf+4,x
  2394 5C8A C9 3E			cmp #'>'
  2395 5C8C D0 03			bne Line_Has_Dir_Tag_Next
  2396 5C8E A9 01			lda #$01							; found
  2397 5C90 60				rts
  2398 5C91			Line_Has_Dir_Tag_Next
  2399 5C91 E8				inx
  2400 5C92 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2401 5C94 90 D5			bcc Line_Has_Dir_Tag_L1
  2402 5C96 A9 00			lda #$00							; not found
  2403 5C98 60				rts
  2404
  2405 				;-----------------------------------------------------------------------------
  2406 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2407 				; space-padded).  Refuses if the result would not fit.
  2408 				;-----------------------------------------------------------------------------
  2409 5C99			Folder_Path_Push
  2410 5C99 A2 00			ldx #$00
  2411 5C9B			Folder_Path_Push_End
  2412 5C9B BD 28 06			lda Scan_Path,x
  2413 5C9E F0 06			beq Folder_Path_Push_Name
  2414 5CA0 E8				inx
  2415 5CA1 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2416 5CA3 90 F6			bcc Folder_Path_Push_End
  2417 5CA5 60				rts									; path too long already - refuse
  2418 5CA6			Folder_Path_Push_Name
  2419 5CA6 A0 00			ldy #$00
  2420 5CA8			Folder_Path_Push_L1
  2421 5CA8 B9 CD 04			lda Name_Row_Buf,y
  2422 5CAB F0 0D			beq Folder_Path_Push_Sep
  2423 5CAD C9 20			cmp #' '
  2424 5CAF F0 09			beq Folder_Path_Push_Sep
  2425 5CB1 9D 28 06			sta Scan_Path,x
  2426 5CB4 E8				inx
  2427 5CB5 C8				iny
  2428 5CB6 C0 08			cpy #$08
  2429 5CB8 90 EE			bcc Folder_Path_Push_L1
  2430 5CBA			Folder_Path_Push_Sep
  2431 5CBA A9 3E			lda #'>'
  2432 5CBC 9D 28 06			sta Scan_Path,x
  2433 5CBF E8				inx
  2434 5CC0 A9 00			lda #$00
  2435 5CC2 9D 28 06			sta Scan_Path,x
  2436 5CC5 60				rts
