   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3D50			Text_Window_Frame_Chars
   504 3D50 C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3D59 DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3D62			Text_Window_Frame
   508 3D62 A5 80			lda Reg1
   509 3D64 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3D66 AD B1 06			lda Txt_Col
   511 3D69 85 87			sta Reg8							; Reg8 = left column
   512 3D6B AD B0 06			lda Txt_Row
   513 3D6E 18				clc
   514 3D6F 65 81			adc Reg2
   515 3D71 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3D73 AD B0 06			lda Txt_Row
   517 3D76 85 84			sta Reg5							; Reg5 = current screen row
   518 3D78 AE B5 06			ldx Txt_FrameStyle
   519 3D7B 20 9A 3D			jsr Text_Window_Frame_Row			; top edge
   520 3D7E			Text_Window_Frame_Mid
   521 3D7E E6 84			inc Reg5
   522 3D80 A5 84			lda Reg5
   523 3D82 C5 85			cmp Reg6
   524 3D84 B0 0D			bcs Text_Window_Frame_Bottom
   525 3D86 AD B5 06			lda Txt_FrameStyle
   526 3D89 18				clc
   527 3D8A 69 03			adc #$03
   528 3D8C AA				tax
   529 3D8D 20 9A 3D			jsr Text_Window_Frame_Row			; interior row
   530 3D90 4C 7E 3D			jmp Text_Window_Frame_Mid
   531 3D93			Text_Window_Frame_Bottom
   532 3D93 AD B5 06			lda Txt_FrameStyle
   533 3D96 18				clc
   534 3D97 69 06			adc #$06
   535 3D99 AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3D9A			Text_Window_Frame_Row
   540 3D9A BD 50 3D			lda Text_Window_Frame_Chars,x
   541 3D9D 8D 80 06			sta Txt_Line+0
   542 3DA0 BD 51 3D			lda Text_Window_Frame_Chars+1,x
   543 3DA3 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3DA5 BD 52 3D			lda Text_Window_Frame_Chars+2,x
   545 3DA8 85 82			sta Reg3							; Reg3 = right char
   546 3DAA A2 01			ldx #$01
   547 3DAC			Text_Window_Frame_Row_L1
   548 3DAC E4 86			cpx Reg7
   549 3DAE B0 08			bcs Text_Window_Frame_Row_End
   550 3DB0 A5 83			lda Reg4
   551 3DB2 9D 80 06			sta Txt_Line,x
   552 3DB5 E8				inx
   553 3DB6 D0 F4			bne Text_Window_Frame_Row_L1
   554 3DB8			Text_Window_Frame_Row_End
   555 3DB8 A5 82			lda Reg3
   556 3DBA 9D 80 06			sta Txt_Line,x
   557 3DBD E8				inx
   558 3DBE			Text_Window_Frame_PutRow
   559 3DBE A9 00			lda #$00
   560 3DC0 9D 80 06			sta Txt_Line,x
   561 3DC3 A5 84			lda Reg5
   562 3DC5 8D B0 06			sta Txt_Row
   563 3DC8 A5 87			lda Reg8
   564 3DCA 8D B1 06			sta Txt_Col
   565 3DCD A9 80			lda #<Txt_Line
   566 3DCF 85 96			sta Txt_Ptr
   567 3DD1 A9 06			lda #>Txt_Line
   568 3DD3 85 97			sta Txt_Ptr + $01
   569 3DD5 4C D8 3D			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 3DD8			Text_PutStrAt
   583 3DD8 A9 01			lda #$01
   584 3DDA 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 3DDD A9 00			lda #$00
   587 3DDF 85 80			sta Reg1
   588 3DE1 85 81			sta Reg2
   589 3DE3 AE B0 06			ldx Txt_Row
   590 3DE6 F0 0E			beq Text_PutStrAt_Col
   591 3DE8			Text_PutStrAt_RowL
   592 3DE8 A5 80			lda Reg1
   593 3DEA 18				clc
   594 3DEB 69 A0			adc #TEXT_PITCH
   595 3DED 85 80			sta Reg1
   596 3DEF 90 02			bcc Text_PutStrAt_RowNC
   597 3DF1 E6 81			inc Reg2
   598 3DF3			Text_PutStrAt_RowNC
   599 3DF3 CA				dex
   600 3DF4 D0 F2			bne Text_PutStrAt_RowL
   601 3DF6			Text_PutStrAt_Col
   602 3DF6 AD B1 06			lda Txt_Col
   603 3DF9 0A				asl									; Txt_Col * 2 (max 158)
   604 3DFA 18				clc
   605 3DFB 65 80			adc Reg1
   606 3DFD 85 80			sta Reg1
   607 3DFF 90 02			bcc Text_PutStrAt_ColNC
   608 3E01 E6 81			inc Reg2
   609 3E03			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 3E03 A5 81			lda Reg2
   612 3E05 29 10			and #$10							; offset bit 12 = "second bank"
   613 3E07 F0 04			beq Text_PutStrAt_Bank0
   614 3E09 A9 2B			lda #TEXT_BACK_BANK+1
   615 3E0B D0 02			bne Text_PutStrAt_SetBank
   616 3E0D			Text_PutStrAt_Bank0
   617 3E0D A9 2A			lda #TEXT_BACK_BANK
   618 3E0F			Text_PutStrAt_SetBank
   619 3E0F 8D B6 06			sta Txt_Bank
   620 3E12 A5 80			lda Reg1
   621 3E14 85 88			sta Ptr_Lo
   622 3E16 A5 81			lda Reg2
   623 3E18 29 0F			and #$0F
   624 3E1A 18				clc
   625 3E1B 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 3E1D 85 89			sta Ptr_Hi
   627 3E1F AD B6 06			lda Txt_Bank
   628 3E22 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 3E24				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E24 A0 5F			ldy #<VBXE_MA_BSEL
     3 3E26 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 3E28 A9 00			lda #$00
   632 3E2A 85 82			sta Reg3							; Reg3 = source string index
   633 3E2C AD B1 06			lda Txt_Col
   634 3E2F 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 3E31			Text_PutStrAt_Char
   636 3E31 A5 83			lda Reg4
   637 3E33 C9 50			cmp #TEXT_COLS
   638 3E35 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 3E37 A4 82			ldy Reg3
   640 3E39 B1 96			lda (Txt_Ptr),y
   641 3E3B F0 43			beq Text_PutStrAt_Done
   642 3E3D C9 01			cmp #TXT_PEN
   643 3E3F D0 0C			bne Text_PutStrAt_Glyph
   644 3E41 C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 3E42 B1 96			lda (Txt_Ptr),y
   646 3E44 8D B4 06			sta Txt_Attr
   647 3E47 C8				iny
   648 3E48 84 82			sty Reg3							; skip both bytes, column unchanged
   649 3E4A 4C 31 3E			jmp Text_PutStrAt_Char
   650 3E4D			Text_PutStrAt_Glyph
   651 3E4D A0 00			ldy #$00
   652 3E4F 91 88			sta (Ptr_Lo),y						; glyph byte
   653 3E51 C8				iny
   654 3E52 AD B4 06			lda Txt_Attr
   655 3E55 91 88			sta (Ptr_Lo),y						; attribute byte
   656 3E57 E6 82			inc Reg3
   657 3E59 E6 83			inc Reg4
   658 3E5B A5 88			lda Ptr_Lo							; window pointer += 2
   659 3E5D 18				clc
   660 3E5E 69 02			adc #$02
   661 3E60 85 88			sta Ptr_Lo
   662 3E62 90 02			bcc Text_PutStrAt_NoPage
   663 3E64 E6 89			inc Ptr_Hi
   664 3E66			Text_PutStrAt_NoPage
   665 3E66 A5 89			lda Ptr_Hi
   666 3E68 C9 30			cmp #$30							; crossed out of the window -> next bank
   667 3E6A 90 C5			bcc Text_PutStrAt_Char
   668 3E6C 38				sec
   669 3E6D E9 10			sbc #$10
   670 3E6F 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 3E71 EE B6 06			inc Txt_Bank
   672 3E74 AD B6 06			lda Txt_Bank
   673 3E77 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 3E79				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E79 A0 5F			ldy #<VBXE_MA_BSEL
     3 3E7B 91 93			sta (VBXEBase),y
Source: text80.asm
   675 3E7D 4C 31 3E			jmp Text_PutStrAt_Char
   676 3E80			Text_PutStrAt_Done
   677 3E80 A9 00			lda #MEMAC_GLOBAL_DISABLE
   678 3E82				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E82 A0 5F			ldy #<VBXE_MA_BSEL
     3 3E84 91 93			sta (VBXEBase),y
Source: text80.asm
   679 3E86 20 CA 3B			jsr Make_Attr						; restore the caller's pen (a TXT_PEN escape
   680 3E89 8D B4 06			sta Txt_Attr						; may have changed it) - clobbers X
   681 3E8C 60				rts
