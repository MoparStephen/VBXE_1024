   541 				; Selector screen
   542 				;=============================================================================
   543
   544 				;-----------------------------------------------------------------------------
   545 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   546 				; menu palettes back ONLY if an image replaced them (Pal_Image - after Info,
   547 				; Drive, Quit or a directory P-preview the registers are already right), then
   548 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   549 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   550 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   551 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   552 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   553 				; always returns.
   554 				;-----------------------------------------------------------------------------
   555 5072			Enter_Selector
   556 5072 A9 00			lda #$00
   557 5074 8D C6 04			sta UI_Mode
   558 5077 20 06 51			jsr Selector_Draw					; back buffer only - nothing visible yet
   559 507A AD E7 04			lda Pal_Image
   560 507D F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   561 507F 20 AB 33			jsr Display_Off						; blank while the registers are rewritten
   562 5082 20 03 35			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   563 5085 20 FC 3A			jsr Text_Present
   564 5088 20 DA 3A			jsr Text_Activate
   565 508B 4C B5 33			jmp Display_On						; (tail)
   566 508E			Enter_Selector_Show
   567 508E 20 FC 3A			jsr Text_Present					; the finished screen, in one blit
   568 5091 4C DA 3A			jmp Text_Activate					; (tail) a pure XDL swap
   569
   570 				;-----------------------------------------------------------------------------
   571 				; UI_Build_TextPalette - the standard Atari 256-colour master (NTSC $00200 /
   572 				; PAL $00500, per Video_Flag) has its entries 0-127 in hues 0-7 only (no
   573 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   574 				; De-interleave it so:
   575 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   576 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   577 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   578 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   579 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   580 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   581 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   582 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   583 				;-----------------------------------------------------------------------------
   584 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   585
   586 5094			UI_Build_TextPalette
   587 5094 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   588 5096				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5096 A0 5F			ldy #<VBXE_MA_BSEL
     3 5098 91 93			sta (VBXEBase),y
Source: ui.asm
   589
   590 				; --- pass 1: even master colours -> buf[0..127]
   591 509A 20 C8 50			jsr UI_Apply_TP_SrcBase
   592 509D A9 00			lda #<UI_APPLY_TP_BUF
   593 509F 85 8A			sta Name_Ptr
   594 50A1 A9 28			lda #>UI_APPLY_TP_BUF
   595 50A3 85 8B			sta Name_Ptr+1
   596 50A5 20 DF 50			jsr UI_Apply_TP_Pass
   597
   598 				; --- pass 2: odd master colours -> buf[128..255]
   599 50A8 20 C8 50			jsr UI_Apply_TP_SrcBase
   600 50AB A5 88			lda Ptr_Lo
   601 50AD 18				clc
   602 50AE 69 03			adc #$03									; step onto the first odd triplet
   603 50B0 85 88			sta Ptr_Lo
   604 50B2 90 02			bcc UI_Apply_TP_P2Dst
   605 50B4 E6 89			inc Ptr_Hi
   606 50B6			UI_Apply_TP_P2Dst
   607 50B6 A9 80			lda #<[UI_APPLY_TP_BUF + $180]				; buf + 128*3
   608 50B8 85 8A			sta Name_Ptr
   609 50BA A9 29			lda #>[UI_APPLY_TP_BUF + $180]
   610 50BC 85 8B			sta Name_Ptr+1
   611 50BE 20 DF 50			jsr UI_Apply_TP_Pass
   612
   613 50C1 A9 00			lda #MEMAC_GLOBAL_DISABLE
   614 50C3				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 50C3 A0 5F			ldy #<VBXE_MA_BSEL
     3 50C5 91 93			sta (VBXEBase),y
Source: ui.asm
   615 50C7 60				rts
   616
   617 				; Ptr_Lo/Hi = active master base ($2500 PAL / $2200 NTSC), mirrors Restore_Palette0
   618 50C8			UI_Apply_TP_SrcBase
   619 50C8 AD 89 04			lda Video_Flag						; 0 = PAL, non-zero = NTSC
   620 50CB D0 09			bne UI_Apply_TP_SrcNTSC
   621 50CD A9 00			lda #<(VBXE_WINDOW + $500)
