  1120 				;-----------------------------------------------------------------------------
  1121 				; Fill_Pal_Preview_Cmap - stage the P-preview's 2x2 grid into CRAM_Buffer
  1122 				; (TL is left at the buffer's zero default = palette 0) then expand the
  1123 				; whole buffer into real CRAM via the existing Setup_Cmap1.  Called once
  1124 				; from Selector_Handle_P (ui.asm).
  1125 				;
