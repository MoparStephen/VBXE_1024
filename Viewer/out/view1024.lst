    96 3AA2 85 89			sta Ptr_Hi
    97 3AA4 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
    98 3AA6 85 80			sta Reg1
    99 3AA8 A9 28			lda #>[VBXE_WINDOW + $800]
   100 3AAA 85 81			sta Reg2
