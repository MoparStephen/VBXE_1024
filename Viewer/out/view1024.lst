   462 				;-----------------------------------------------------------------------------
   463 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   464 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row).  Tracks bank + window
   465 				; offset explicitly (a row near the bottom straddles the $24000 boundary).
   466 				;-----------------------------------------------------------------------------
   467 3D02			Text_PutStrAt
   468 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   469 3D02 A9 00			lda #$00
   470 3D04 85 80			sta Reg1
   471 3D06 85 81			sta Reg2
   472 3D08 AE B0 06			ldx Txt_Row
   473 3D0B F0 0E			beq Text_PutStrAt_Col
   474 3D0D			Text_PutStrAt_RowL
   475 3D0D A5 80			lda Reg1
   476 3D0F 18				clc
   477 3D10 69 A0			adc #TEXT_PITCH
   478 3D12 85 80			sta Reg1
   479 3D14 90 02			bcc Text_PutStrAt_RowNC
   480 3D16 E6 81			inc Reg2
   481 3D18			Text_PutStrAt_RowNC
   482 3D18 CA				dex
   483 3D19 D0 F2			bne Text_PutStrAt_RowL
   484 3D1B			Text_PutStrAt_Col
   485 3D1B AD B1 06			lda Txt_Col
   486 3D1E 0A				asl									; Txt_Col * 2 (max 158)
   487 3D1F 18				clc
   488 3D20 65 80			adc Reg1
   489 3D22 85 80			sta Reg1
   490 3D24 90 02			bcc Text_PutStrAt_ColNC
   491 3D26 E6 81			inc Reg2
   492 3D28			Text_PutStrAt_ColNC
   493 				; --- fold in TEXT_SCREEN_VRAM: offset (0..$12BF) -> bank + window pointer -----
   494 3D28 A5 81			lda Reg2
   495 3D2A 29 10			and #$10							; offset bit 12 = "second bank"
   496 3D2C F0 04			beq Text_PutStrAt_Bank0
   497 3D2E A9 24			lda #TEXT_SCREEN_BANK+1
   498 3D30 D0 02			bne Text_PutStrAt_SetBank
   499 3D32			Text_PutStrAt_Bank0
   500 3D32 A9 23			lda #TEXT_SCREEN_BANK
   501 3D34			Text_PutStrAt_SetBank
   502 3D34 8D B6 06			sta Txt_Bank
   503 3D37 A5 80			lda Reg1
   504 3D39 85 88			sta Ptr_Lo
   505 3D3B A5 81			lda Reg2
   506 3D3D 29 0F			and #$0F
   507 3D3F 18				clc
   508 3D40 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   509 3D42 85 89			sta Ptr_Hi
   510 3D44 AD B6 06			lda Txt_Bank
   511 3D47 09 80			ora #MEMAC_GLOBAL_ENABLE
   512 3D49				vbsta VBXE_MA_BSEL
