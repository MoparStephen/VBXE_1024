   390 				;-----------------------------------------------------------------------------
   391 				; Text_Window_Frame - draw a simple ASCII box ('+' '-' '|') with a blank
   392 				; interior over Txt_Row / Txt_Col / Reg1 (width-1) / Reg2 (height-1), using the
   393 				; current pen.  Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   394 				;-----------------------------------------------------------------------------
   395 3C89			Text_Window_Frame
   396 3C89 A5 80			lda Reg1
   397 3C8B 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   398 3C8D AD B1 06			lda Txt_Col
   399 3C90 85 87			sta Reg8							; Reg8 = left column
   400 3C92 AD B0 06			lda Txt_Row
   401 3C95 18				clc
   402 3C96 65 81			adc Reg2
   403 3C98 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   404 3C9A AD B0 06			lda Txt_Row
   405 3C9D 85 84			sta Reg5							; Reg5 = current screen row
   406 3C9F 20 B3 3C			jsr Text_Window_Frame_EdgeRow		; top edge
   407 3CA2			Text_Window_Frame_Mid
   408 3CA2 E6 84			inc Reg5
   409 3CA4 A5 84			lda Reg5
   410 3CA6 C5 85			cmp Reg6
   411 3CA8 B0 06			bcs Text_Window_Frame_Bottom
   412 3CAA 20 CF 3C			jsr Text_Window_Frame_MidRow
   413 3CAD 4C A2 3C			jmp Text_Window_Frame_Mid
   414 3CB0			Text_Window_Frame_Bottom
   415 3CB0 4C B3 3C			jmp Text_Window_Frame_EdgeRow		; bottom edge (tail - returns to caller)
   416
   417 3CB3			Text_Window_Frame_EdgeRow
   418 3CB3 A9 2B			lda #'+'
   419 3CB5 8D 80 06			sta Txt_Line+0
   420 3CB8 A2 01			ldx #$01
   421 3CBA			Text_Window_Frame_EdgeL
   422 3CBA E4 86			cpx Reg7
   423 3CBC B0 08			bcs Text_Window_Frame_EdgeEnd
   424 3CBE A9 2D			lda #'-'
   425 3CC0 9D 80 06			sta Txt_Line,x
   426 3CC3 E8				inx
   427 3CC4 D0 F4			bne Text_Window_Frame_EdgeL
   428 3CC6			Text_Window_Frame_EdgeEnd
