   518 53A2 9D 8D 04			sta Path_Buf,x
   519 53A5 E8				inx
   520 53A6 AD CC 04			lda Scan_Drive
   521 53A9 F0 04			beq Emit_Path_Prefix_Colon
   522 53AB 9D 8D 04			sta Path_Buf,x
   523 53AE E8				inx
   524 53AF			Emit_Path_Prefix_Colon
   525 53AF A9 3A			lda #':'
   526 53B1 9D 8D 04			sta Path_Buf,x
   527 53B4 E8				inx
   528 53B5 A0 00			ldy #$00
   529 53B7			Emit_Path_Prefix_L1
   530 53B7 B9 28 06			lda Scan_Path,y
   531 53BA F0 09			beq Emit_Path_Prefix_Done
   532 53BC 9D 8D 04			sta Path_Buf,x
   533 53BF E8				inx
   534 53C0 C8				iny
   535 53C1 C0 28			cpy #$28
   536 53C3 90 F2			bcc Emit_Path_Prefix_L1
   537 53C5			Emit_Path_Prefix_Done
   538 53C5 60				rts
