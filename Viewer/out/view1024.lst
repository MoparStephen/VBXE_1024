   988 				;-----------------------------------------------------------------------------
   989 				; Sort_Range - in-place alphabetical selection sort of the records
   990 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
   991 				;   In:  A = start index, X = count.  count < 2 -> no-op.
   992 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
   993 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
   994 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
   995 				;-----------------------------------------------------------------------------
   996 36EF			Sort_Range
   997 36EF E0 02			cpx #$02
   998 36F1 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
   999 36F3 85 81			sta Reg2							; Reg2 = i = start
  1000 36F5 86 82			stx Reg3							; Reg3 = count (temp)
  1001 36F7 18				clc
  1002 36F8 65 82			adc Reg3
  1003 36FA 85 84			sta Reg5							; Reg5 = end = start + count
  1004 36FC 38				sec
  1005 36FD E9 01			sbc #$01
  1006 36FF 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1007
  1008 3701 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1009 3703				vbsta VBXE_MA_BSEL
