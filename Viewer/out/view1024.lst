   209 21D7 00 40 03			dta <MENU_BANNER_PAL_VRAM,>MENU_BANNER_PAL_VRAM,MENU_BANNER_PAL_VRAM>>16	; Destination address
   210 21DA 00 01			dta a($0100)						; Destination step y (256 - next row)
   211 21DC 01				dta $01								; Destination step x (1)
   212 21DD FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   213 21DF 0F				dta $0F								; Height-1 (15 -> 16 rows; 16*256 = 4096 = 1 bank)
   214 21E0 00				dta $00								; And mask (0 -> constant source)
   215 21E1 00				dta $00								; Xor mask (fill value: $00)
   216 21E2 00				dta $00								; Collision and mask
   217 21E3 00				dta $00								; Zoom
   218 21E4 00				dta $00								; Pattern feature
   219 21E5 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   220
   221 				; Wipe the selector long-name cache ($02A000-$02DFFF = NFO_NAME_VRAM, banks
   222 				; $2A-$2D) to $00, marking every image slot "not loaded".  Constant-source fast
   223 				; fill (And 0 -> source is the $00 Xor mask, no fetch).  256 bytes/row * 64 rows
   224 				; = 16384 = 4 banks.  Kicked by Nfo_Name_ClearCache from Rescan_Images.
   225 21E6			BLT_NFO_NAME_CLEAR
   226 21E6 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   227 21E9 00 00			dta $00,$00							; Source step y (unused)
   228 21EB 00				dta $00								; Source step x (unused)
   229 21EC 00 A0 02			dta $00,$A0,$02						; Destination address ($02A000 = NFO_NAME_VRAM)
   230 21EF 00 01			dta a($0100)						; Destination step y (256 - next row)
   231 21F1 01				dta $01								; Destination step x (1)
   232 21F2 FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   233 21F4 3F				dta $3F								; Height-1 (63 -> 64 rows; 64*256 = 16384 = 4 banks)
   234 21F5 00				dta $00								; And mask (0 -> constant source)
   235 21F6 00				dta $00								; Xor mask (fill value: $00)
   236 21F7 00				dta $00								; Collision and mask
   237 21F8 00				dta $00								; Zoom
   238 21F9 00				dta $00								; Pattern feature
   239 21FA 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   473 = 00FB			BLT_Length	equ *-BCB_START
