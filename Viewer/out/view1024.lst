   754 3525 A9 00			lda #<[MENU_DEMO_ROW_TOP*MENU_ATTR_ROW_BYTES]
   755 3527 85 80			sta Reg1
   756 3529 A9 00			lda #>[MENU_DEMO_ROW_TOP*MENU_ATTR_ROW_BYTES]
   757 352B 85 81			sta Reg2
   758 352D A9 15			lda #<Menu_Demo_Attr_Top_Vals
   759 352F 85 88			sta Ptr_Lo
   760 3531 A9 35			lda #>Menu_Demo_Attr_Top_Vals
   761 3533 85 89			sta Ptr_Hi
   762 3535 20 52 35			jsr Set_Menu_Demo_Attr_Band
   763
   764 3538 A9 A0			lda #<[MENU_DEMO_ROW_BOT*MENU_ATTR_ROW_BYTES]
   765 353A 85 80			sta Reg1
   766 353C A9 0A			lda #>[MENU_DEMO_ROW_BOT*MENU_ATTR_ROW_BYTES]
   767 353E 85 81			sta Reg2
   768 3540 A9 1D			lda #<Menu_Demo_Attr_Bot_Vals
   769 3542 85 88			sta Ptr_Lo
   770 3544 A9 35			lda #>Menu_Demo_Attr_Bot_Vals
   771 3546 85 89			sta Ptr_Hi
   772 3548 20 52 35			jsr Set_Menu_Demo_Attr_Band
   773
   774 354B A9 00			lda #MEMAC_GLOBAL_DISABLE
   775 354D				vbsta VBXE_MA_BSEL
