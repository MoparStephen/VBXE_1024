     3 				;-----------------------------------------------------------------------------
     4 				; Memory Map
     5 				;-----------------------------------------------------------------------------
     6 				; Load Address = 
     7 				; Run Address = 
     8 				; VBXE:
     9 				;    XDLs            = $00000 - $00068 (image attribute + image normal +
    10 				;                      XDL_MainMenu's 8 chained blocks, well clear of $00100)
    11 				;    BCBs            = $00100 - $001FF
    12 				;    NTSC_Palette    = $00200 - $004FF (256 RGB triplets; restores Palette 0 on exit)
    13 				;    PAL_Palette     = $00500 - $007FF (256 RGB triplets; restores Palette 0 on exit)
    14 				;    Text pal buffer = $00800 - $00AFF (UI_Build_TextPalette de-interleaved text palette, resident)
    15 				;    VRAM            = $01000 - $13BFF (Video Ram)
    16 				;    CRAM_Buffer     = $14000 - $1657F (Compressed palette bytes)
    17 				;    CRAM            = $17000 - $205FF (Colour Ram)
    18 				;    Palette_Buffers = $21000 - $21FFF (Temp 4kB buffer for loading palettes)
    19 				;    Text fonts      = $22000 - $22FFF (CGA.F08 @ $22000 / ATARI.F08 @ $22800;
    20 				;                      F toggles XDL_MainMenu's two CHBASE bytes between them -
    21 				;                      see text80.asm)
    22 				;    Text screen RAM = $23000 - $23E5F (23 rows x 160 {glyph,attr} bytes = 3680;
    23 				;                      ONE contiguous buffer for both text bands of the menu/
    24 				;                      info XDL - rows 0-19 = main content, rows 20-22 = footer,
    25 				;                      the on-screen gap between them is a display-time-only XDL
    26 				;                      gap, not a VRAM gap - see TEXT_MAIN_ROWS/TEXT_FOOTER_ROWS)
    27 				;    Menu banner     = $30000 - $32CFF (banks $30-$32: MENU_BANNER_VRAM, 36 rows
    28 				;                      x 320 bytes, attribute-mapped, static logo/banner for the
    29 				;                      Main Menu + Info XDL's graphics band; assembly-embedded
    30 				;                      from Assets/MENU.RAW - see Load_Menu_Logo1-3, init_vbxe.asm)
    31 				;    Menu separator  = $33000 - $3309F (MENU_SEP_VRAM: 1 row x 160 bytes, lo-res
    32 				;                      no-attribute-map divider line, shared by all three separator
    33 				;                      bands of the menu/info XDL; a pattern table loaded at load
    34 				;                      time from Assets/MENU_SEP.RAW - see Load_Menu_Sep)
    35 				;    (free)          = $34000 - $34FFF (was the banner's ramp palettes - sets
    36 				;                      1-3 are now generated by Apply_Menu_Palettes)
    37 				;    Menu banner map = $35000 - $3667F (MENU_BANNER_MAP_VRAM: the banner's
    38 				;                      expanded attribute map, resident, dedicated - NOT the
    39 				;                      shared CRAM $017000, so it's never clobbered by Load_
    40 				;                      Image and never needs a reload)
    41 				;    NFO display buf = $25000 - $29FFF (banks $25-$29: the <name>.NFO file loaded
    42 				;                      verbatim - up to NFO_MAX_LINES fixed 160-byte {glyph,attr}
    43 				;                      line records, TEXT_PITCH stride; blitted to the text
    44 				;                      screen a window at a time by BLT_NFO_DRAW)
    45 				;    Text back buf   = $2A000 - $2AE5F (TEXT_BACK_VRAM: every text draw lands here,
    46 				;                      off screen; Text_Present blits it to $23000 in one copy
    47 				;                      during vblank - see text80.asm)
    48 				;    (banks $2B-$2D are free - the NFO name cache moved to $37000 when it grew)
    49 				;    Menu demo ramp  = $2E000 - $2E0FF (MENU_RAMP_VRAM: 256-byte ascending
    50 				;                      0..255 pixel-source square for the banner's 4-palette
    51 				;                      demo overlay, built at boot by Build_Menu_Ramp_Table;
    52 				;                      rest of bank $2E free)
    53 				;    Text win save   = $2F000 - $2FFFF (WIN_SAVE_VRAM: save-under for the D
    54 				;                      window and the Q quit-confirm window)
    55 				;    NFO name cache  = $37000 - $3EFFF (banks $37-$3E: the selector status line's
    56 				;                      image descriptions, NFO_NAME_SLOT bytes/image, loaded
    57 				;                      once from D:IMAGES.LST per dir rescan, wiped before each)
    58 				;    (bank $3F is free)
    59 				;    Image name list = $40000 - $40FFF (bank $40: up to MAX_IMAGES=255 rows -
    60 				;                      "..", sub-dirs and *.V1K files, 8 bytes each; + a 10-char
    61 				;                      display field is formatted in place at draw time)
    62 				;    (bank $41 is free - the old folder browser used it)
    63 				;
    64 				; MAX_IMAGES is a hard design ceiling of 255 - each image is a ~90kB
    65 				; .V1K file, so 255 far exceeds any real slideshow, and a one-byte
    66 				; count keeps every nav/sort loop small. Not intended to ever be raised.
    67
