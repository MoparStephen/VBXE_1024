   546 33A4 20 30 34			jsr Image_Read_Pal
   547 33A7 08				php
   548 33A8 20 CD 34			jsr Image_Close
   549 33AB 28				plp
   550 33AC B0 03			bcs Load_Image_Palette_Done			; short read - don't push a half palette
   551 33AE 4C B2 33			jmp Apply_Image_Palette
   552 33B1			Load_Image_Palette_Done
   553 33B1 60				rts
