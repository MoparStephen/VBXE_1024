    70 				;-----------------------------------------------------------------------------
    71 				; Structure Declarations
    72 				;-----------------------------------------------------------------------------
    73
    74 				;-----------------------------------------------------------------------------
    75 				; Variables go here
    76 				;-----------------------------------------------------------------------------
    77 				; Page 0 user data ($80 to $FF with some reserved for OS)
    78 				.zpvar Reg1				.byte			; Multi-Use Variables
    79 				.zpvar Reg2				.byte			; Multi-Use Variables
    80 				.zpvar Reg3				.byte			; Multi-Use Variables
    81 				.zpvar Reg4				.byte			; Multi-Use Variables
    82 				.zpvar Reg5				.byte			; Multi-Use Variables
    83 				.zpvar Reg6				.byte			; Multi-Use Variables
    84 				.zpvar Reg7				.byte			; Multi-Use Variables
    85 				.zpvar Reg8				.byte			; Multi-Use Variables
    86 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    87 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    88 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    89 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    90
    91 				; Non Page-0 Variables
    92 				;	$480 to $4FF free
    93 				;	$600 to $6FF free
    94 				; When using PMG the 1st $300 bytes are always free
    95 				.var SDMCTL_OLD			.byte = $480	; Save DMA
    96 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
    97 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
    98 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
    99 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   100 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   101 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   102 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   103 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   104 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   105 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   106 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   107 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   108 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   109 				; --- viewer UI state (ui.asm) ---
   110 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info
   111 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   112 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   113 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   114 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   115 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   116 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   117 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   118 				.var FileStart			.byte = $4DA	; selector list: index of the first *.MAP row (= upCount + Dir_Count)
   119 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   120 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   121 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   122 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   123 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   124 				;	$4E2 to $4FF free
   125 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   126 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   127 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.MAP",$9B ($650-$67F)
   128 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   129 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP name + $9B) for
   130 				; Nfo_Name_LoadManifest.  Own buffer, not Dir_Line_Buf, because a record can
   131 				; run to 8+48+1 = 57 bytes - past that 40-byte line's end.
   132 				.var Nfo_Name_Line		:58 .byte = $6B7	; 8 key + 48 name + $9B, rounded ($6B7-$6F0)
   133 				;	$6F1 to $6FF free (text80.asm uses $6B0-$6B6)
   134 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   135 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   136 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   137 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   138 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
