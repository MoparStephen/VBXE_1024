   184 				; SpartaDOS X 40/80-column soft-console control (lives in the always-resident
   185 				; page-3 block so Step_1's ini-time call resolves to loaded code)
   186 323E				icl 'sdx_con.asm'
Source: sdx_con.asm
     1 				;-----------------------------------------------------------------------------
     2 				; sdx_con.asm - SpartaDOS X CON: soft-console 40/80-column control
     3 				;-----------------------------------------------------------------------------
     4 				; When the user boots SpartaDOS X with the 64/80-column soft console active
     5 				; (CON.SYS or CON64.SYS - the extended "E:" driver - layered on a base such as
     6 				; S_VBXE.SYS), that console fights a program that drives the VBXE directly.
     7 				;
     8 				; SDX_Console_Save_And_40  - call once at startup. Detects the soft console,
     9 				;                            remembers whether it was in extended mode, and
    10 				;                            drops it to the standard 40-column OS editor.
    11 				; SDX_Console_Restore      - call once just before jmp (DOSVEC). If the soft
    12 				;                            console was in 64/80-column mode at startup, it is
    13 				;                            put back; otherwise nothing happens.
    14 				;
    15 				; Mechanism - SDX 4.50 Programmer's/User Guide, section 6.9 "Using the CON:
    16 				; Drivers in Own Programs":
    17 				;   XIO 33,#0,12,0,"E:"    - detect. Success (status 1) means CON.SYS/CON64.SYS
    18 				;                            is loaded; the call also returns
    19 				;                              ICAX5 = activity flag ($80 = extended mode on)
    20 				;                              ICAX6 = max columns / function code (64 or 80)
    21 				;                            An error (esp. 146) means no soft console -> no-op.
    22 				;   XIO nc,#0,12,0,"E:"    - nc = the ICAX6 value; AUX2 = 0 disables the
    23 				;                            extended console (back to 40 columns).
    24 				;   XIO nc,#0,12,128,"E:"  - AUX2 = 128 re-enables it.
    25 				;
    26 				; Operates on IOCB #0, which the OS keeps open to E:/CON:. Needs the CIO
    27 				; equates from equates.asm. No other dependencies - safe to icl from any build.
    28 				;-----------------------------------------------------------------------------
    29
    30 = 0000			SDX_CON_IOCB	equ $00						; IOCB #0 - OS editor / CON:
    31 = 0021			SDX_CON_QUERY	equ $21						; XIO 33 - detect / query extension
    32 = 000C			SDX_CON_RW		equ $0C						; AUX1 = read + write
    33 = 0080			SDX_CON_ENABLE	equ $80						; AUX2 value that enables extended mode
    34
    35 323E			.var SDX_Con_Func		.byte				; function code from ICAX6 (64 or 80)
    36 323E			.var SDX_Con_WasExt		.byte				; $80 = extended mode active at startup
    37
    38 				;-----------------------------------------------------------------------------
    39 				; SDX_Console_Save_And_40
    40 				;-----------------------------------------------------------------------------
    41 323E			SDX_Console_Save_And_40
    42 323E A9 00			lda #$00
    43 3240 8D C9 32			sta SDX_Con_Func
    44 3243 8D CA 32			sta SDX_Con_WasExt
    45
    46 3246 A2 00			ldx #SDX_CON_IOCB
    47 3248 A9 21			lda #SDX_CON_QUERY
    48 324A 9D 42 03			sta ICCOM,x
    49 324D A9 C6			lda #<SDX_Con_EDev
    50 324F 9D 44 03			sta ICBAL,x
    51 3252 A9 32			lda #>SDX_Con_EDev
    52 3254 9D 45 03			sta ICBAH,x
    53 3257 A9 0C			lda #SDX_CON_RW
    54 3259 9D 4A 03			sta ICAX1,x
    55 325C A9 00			lda #$00
    56 325E 9D 4B 03			sta ICAX2,x
    57 3261 20 56 E4			jsr CIOV
    58 3264 30 20			bmi SDX_Console_Save_Done				; error 146 etc - no soft console
    59
    60 3266 BD 4F 03			lda ICAX6,x								; max columns / function code
    61 3269 C9 40			cmp #64
    62 326B F0 04			beq SDX_Console_Save_FuncOK
    63 326D C9 50			cmp #80
    64 326F D0 15			bne SDX_Console_Save_Done				; unexpected - leave well alone
    65 3271			SDX_Console_Save_FuncOK
    66 3271 8D C9 32			sta SDX_Con_Func
    67
    68 3274 BD 4E 03			lda ICAX5,x								; activity flag: $80 = extended mode on
    69 3277 29 80			and #$80
    70 3279 8D CA 32			sta SDX_Con_WasExt
    71 327C F0 08			beq SDX_Console_Save_Done				; already 40-col - nothing to force
    72
    73 327E A9 00			lda #$00								; AUX2 = 0 -> disable extended console
    74 3280 20 95 32			jsr SDX_Con_ModeCall
    75 3283 20 B2 32			jsr SDX_Con_ClearScreen
    76 3286			SDX_Console_Save_Done
    77 3286 60				rts
    78
    79 				;-----------------------------------------------------------------------------
    80 				; SDX_Console_Restore
    81 				;-----------------------------------------------------------------------------
    82 3287			SDX_Console_Restore
    83 3287 AD CA 32			lda SDX_Con_WasExt
    84 328A F0 08			beq SDX_Console_Restore_Done			; started in 40-col / no soft console
    85 328C A9 80			lda #SDX_CON_ENABLE						; AUX2 = 128 -> re-enable extended mode
    86 328E 20 95 32			jsr SDX_Con_ModeCall
    87 3291 20 B2 32			jsr SDX_Con_ClearScreen
    88 3294			SDX_Console_Restore_Done
    89 3294 60				rts
    90
    91 				;-----------------------------------------------------------------------------
    92 				; SDX_Con_ModeCall - issue XIO <SDX_Con_Func>,#0,12,A,"E:"
    93 				;   A = AUX2 (0 = disable extended console, 128 = enable)
    94 				;-----------------------------------------------------------------------------
    95 3295			SDX_Con_ModeCall
    96 3295 A2 00			ldx #SDX_CON_IOCB
    97 3297 9D 4B 03			sta ICAX2,x
    98 329A AD C9 32			lda SDX_Con_Func
    99 329D 9D 42 03			sta ICCOM,x
   100 32A0 A9 0C			lda #SDX_CON_RW
   101 32A2 9D 4A 03			sta ICAX1,x
   102 32A5 A9 C6			lda #<SDX_Con_EDev
   103 32A7 9D 44 03			sta ICBAL,x
   104 32AA A9 32			lda #>SDX_Con_EDev
   105 32AC 9D 45 03			sta ICBAH,x
   106 32AF 4C 56 E4			jmp CIOV
   107
   108 				;-----------------------------------------------------------------------------
   109 				; SDX_Con_ClearScreen - send CLEAR (125) to IOCB #0 so the editor resyncs.
   110 				; PUT BYTES with a zero buffer length makes CIO output the char in A.
   111 				;-----------------------------------------------------------------------------
   112 32B2			SDX_Con_ClearScreen
   113 32B2 A2 00			ldx #SDX_CON_IOCB
   114 32B4 A9 0B			lda #$0B								; PUT BYTES
   115 32B6 9D 42 03			sta ICCOM,x
   116 32B9 A9 00			lda #$00
   117 32BB 9D 48 03			sta ICBLL,x
   118 32BE 9D 49 03			sta ICBLH,x
   119 32C1 A9 7D			lda #$7D								; ATASCII clear screen
   120 32C3 4C 56 E4			jmp CIOV
   121
   122 32C6			SDX_Con_EDev
   123 32C6 45 3A 9B			dta c"E:",$9B
   123 = 32C9 00		SDX_CON_FUNC
   123 = 32CA 00		SDX_CON_WASEXT
   187 32CB			.endpg
   188
