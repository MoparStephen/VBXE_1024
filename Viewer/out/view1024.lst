  2464 				;=============================================================================
  2465 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2466 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2467 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2468 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2469 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits record 0 (the title rule,
  2470 				; pinned to row 0) plus a 19-row scrolling window of the rest - two
  2471 				; BLT_NFO_DRAW copies per scroll, no reformat, no re-walk.
  2472 				;=============================================================================
  2473
  2474 				;-----------------------------------------------------------------------------
  2475 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2476 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2477 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2478 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2479 				; off screen.
  2480 				;-----------------------------------------------------------------------------
  2481 609C			Info_Load
  2482 609C A9 25			lda #NFO_BUF_BANK
  2483 609E 85 8E			sta BankIndex
  2484 60A0 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2485 60A3 AD 2D 31			lda LoadStatus
  2486 60A6 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2487 60A8 20 AC 60			jsr Info_Count_Lines				; sets Nfo_LineCount
  2488 60AB			Info_Load_Ret
  2489 60AB 60				rts
  2490
  2491 				;-----------------------------------------------------------------------------
  2492 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2493 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2494 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2495 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2496 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2497 				;-----------------------------------------------------------------------------
  2498 60AC			Info_Count_Lines
  2499 60AC A9 00			lda #$00
  2500 60AE 8D DE 04			sta Nfo_LineCount
  2501 60B1 8D DF 04			sta Nfo_LineCount + $01
  2502 60B4 A9 25			lda #NFO_BUF_BANK
  2503 60B6 8D 50 06			sta Nfo_WalkBank
  2504 60B9 09 80			ora #MEMAC_GLOBAL_ENABLE
  2505 60BB				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 60BB A0 5F			ldy #<VBXE_MA_BSEL
     3 60BD 91 93			sta (VBXEBase),y
Source: ui.asm
  2506 60BF A9 00			lda #<VBXE_WINDOW
  2507 60C1 85 88			sta Ptr_Lo
  2508 60C3 A9 20			lda #>VBXE_WINDOW
  2509 60C5 85 89			sta Ptr_Hi
  2510 60C7			Info_Count_L1
  2511 60C7 A0 00			ldy #$00
  2512 60C9 B1 88			lda (Ptr_Lo),y
  2513 60CB F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2514 60CD EE DE 04			inc Nfo_LineCount
  2515 60D0 AD DE 04			lda Nfo_LineCount
  2516 60D3 C9 7F			cmp #NFO_MAX_LINES
  2517 60D5 B0 24			bcs Info_Count_Done					; hit the record cap
  2518 60D7 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2519 60D9 18				clc
  2520 60DA 69 A0			adc #TEXT_PITCH
  2521 60DC 85 88			sta Ptr_Lo
  2522 60DE 90 E7			bcc Info_Count_L1
  2523 60E0 E6 89			inc Ptr_Hi
  2524 60E2 A5 89			lda Ptr_Hi
  2525 60E4 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2526 60E6 90 DF			bcc Info_Count_L1
  2527 60E8 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2528 60EA 85 89			sta Ptr_Hi
  2529 60EC EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2530 60EF AD 50 06			lda Nfo_WalkBank
  2531 60F2 09 80			ora #MEMAC_GLOBAL_ENABLE
  2532 60F4				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 60F4 A0 5F			ldy #<VBXE_MA_BSEL
     3 60F6 91 93			sta (VBXEBase),y
Source: ui.asm
  2533 60F8 4C C7 60			jmp Info_Count_L1
  2534 60FB			Info_Count_Done
  2535 60FB A9 00			lda #MEMAC_GLOBAL_DISABLE
  2536 60FD				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 60FD A0 5F			ldy #<VBXE_MA_BSEL
     3 60FF 91 93			sta (VBXEBase),y
Source: ui.asm
  2537 6101 60				rts
