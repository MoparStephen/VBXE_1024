  1445 				; Build_Filename
  1446 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1447 				;       File_Index = image ordinal
  1448 				;  Out: FileNamePtr -> Path_Buf holding
  1449 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1450 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1451 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1452 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1453 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1454 				;-----------------------------------------------------------------------------
