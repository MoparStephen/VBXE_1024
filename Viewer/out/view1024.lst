    96 3A9B 85 89			sta Ptr_Hi
    97 3A9D A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
    98 3A9F 85 80			sta Reg1
    99 3AA1 A9 28			lda #>[VBXE_WINDOW + $800]
   100 3AA3 85 81			sta Reg2
   101 3AA5 20 AF 3A			jsr Text_Copy_2K
