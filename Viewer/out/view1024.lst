  2175 				;-----------------------------------------------------------------------------
  2176 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2177 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2178 				; the whole .NFO is shorter than the window, clear first and blit only the
  2179 				; records that exist.
  2180 				;-----------------------------------------------------------------------------
  2181 5B24			Info_Draw
  2182 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2183 5B24 38				sec
  2184 5B25 AD DE 04			lda Nfo_LineCount
  2185 5B28 ED DC 04			sbc Nfo_Top
  2186 5B2B 85 84			sta Reg5
  2187 5B2D AD DF 04			lda Nfo_LineCount + $01
  2188 5B30 ED DD 04			sbc Nfo_Top + $01
  2189 5B33 85 85			sta Reg6
  2190 				; rows = min(available, NFO_VISROWS)
  2191 5B35 A5 85			lda Reg6
  2192 5B37 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2193 5B39 A5 84			lda Reg5
  2194 5B3B C9 14			cmp #NFO_VISROWS
  2195 5B3D B0 10			bcs Info_Draw_Full
  2196 				; short document: clear, then blit only the records that exist
  2197 5B3F A5 84			lda Reg5
  2198 5B41 85 83			sta Reg4
  2199 5B43 20 24 3B			jsr Text_Clear
  2200 5B46 A5 83			lda Reg4
  2201 5B48 F0 68			beq Info_Draw_Ret					; nothing to draw
  2202 5B4A C6 83			dec Reg4							; Reg4 = height-1
  2203 5B4C 4C 53 5B			jmp Info_Draw_Blit
  2204 5B4F			Info_Draw_Full
  2205 5B4F A9 13			lda #NFO_VISROWS-1
  2206 5B51 85 83			sta Reg4
  2207 5B53			Info_Draw_Blit
  2208 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2209 5B53 A9 00			lda #$00
  2210 5B55 85 80			sta Reg1
  2211 5B57 85 81			sta Reg2
  2212 5B59 AE DC 04			ldx Nfo_Top
  2213 5B5C F0 0E			beq Info_Draw_Patch
  2214 5B5E			Info_Draw_MulL
  2215 5B5E A5 80			lda Reg1
  2216 5B60 18				clc
  2217 5B61 69 A0			adc #TEXT_PITCH
  2218 5B63 85 80			sta Reg1
  2219 5B65 90 02			bcc Info_Draw_MulNC
  2220 5B67 E6 81			inc Reg2
  2221 5B69			Info_Draw_MulNC
  2222 5B69 CA				dex
  2223 5B6A D0 F2			bne Info_Draw_MulL
  2224 5B6C			Info_Draw_Patch
  2225 5B6C A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window (patch the BCB)
  2226 5B6E				vbsta VBXE_MA_BSEL
