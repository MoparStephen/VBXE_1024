   379 				;-----------------------------------------------------------------------------
   380 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   381 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   382 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   383 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   384 				;  Returns A = $01 if a name was written, $00 if not.
   385 				;-----------------------------------------------------------------------------
   386 4D87			Parse_Dir_Line
   387 4D87 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   388 4D89			Parse_Skip_L1							; Skip leading spaces / protect flag
   389 4D89 BD 00 06			lda Dir_Line_Buf,x
   390 4D8C C9 9B			cmp #$9B
   391 4D8E F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   392 4D90 C9 20			cmp #' '
   393 4D92 F0 04			beq Parse_Skip_Next
   394 4D94 C9 2A			cmp #'*'
   395 4D96 D0 07			bne Parse_Skip_Done
   396 4D98			Parse_Skip_Next
   397 4D98 E8				inx
   398 4D99 E0 28			cpx #Dir_Line_Len
   399 4D9B 90 EC			bcc Parse_Skip_L1
   400 4D9D B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   401 4D9F			Parse_Skip_Done
   402 4D9F A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   403 4DA1 A9 00			lda #$00
   404 4DA3 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   405
   406 4DA5			Parse_Copy_L1
   407 4DA5 BD 00 06			lda Dir_Line_Buf,x
   408 4DA8 C9 9B			cmp #$9B
   409 4DAA F0 24			beq Parse_Copy_Done
   410 4DAC C9 20			cmp #' '
   411 4DAE F0 20			beq Parse_Copy_Done
   412 4DB0 C9 2E			cmp #'.'
   413 4DB2 F0 1C			beq Parse_Copy_Done
   414 4DB4 C9 30			cmp #'0'
   415 4DB6 90 07			bcc Parse_Copy_Is_Name_Char
   416 4DB8 C9 3A			cmp #'9'+1
   417 4DBA B0 03			bcs Parse_Copy_Is_Name_Char
   418 4DBC 4C C1 4D			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   419 4DBF			Parse_Copy_Is_Name_Char
   420 4DBF E6 80			inc Reg1
   421 4DC1			Parse_Copy_Store
   422 4DC1 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   423 4DC3 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   424 4DC5 BD 00 06			lda Dir_Line_Buf,x
   425 4DC8 91 8A			sta (Name_Ptr),y
   426 4DCA C8				iny
   427 4DCB			Parse_Copy_Next
   428 4DCB E8				inx
   429 4DCC E0 28			cpx #Dir_Line_Len
   430 4DCE 90 D5			bcc Parse_Copy_L1
   431
   432 4DD0			Parse_Copy_Done
   433 4DD0 A5 80			lda Reg1
   434 4DD2 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   435
   436 4DD4			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   437 4DD4 C0 08			cpy #$08
   438 4DD6 B0 07			bcs Parse_Dir_Line_Accept
   439 4DD8 A9 20			lda #' '
   440 4DDA 91 8A			sta (Name_Ptr),y
   441 4DDC C8				iny
   442 4DDD D0 F5			bne Parse_Pad_L1
   443
   444 4DDF			Parse_Dir_Line_Accept
   445 4DDF A9 01			lda #$01							; Non-zero - a name was stored
   446 4DE1 60				rts
   447 4DE2			Parse_Dir_Line_Reject
   448 4DE2 A9 00			lda #$00
   449 4DE4 60				rts
