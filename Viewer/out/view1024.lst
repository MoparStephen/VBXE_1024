  1957 				;=============================================================================
  1958 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  1959 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  1960 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  1961 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  1962 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  1963 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  1964 				;=============================================================================
  1965
  1966 				;-----------------------------------------------------------------------------
  1967 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  1968 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  1969 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  1970 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  1971 				; off screen.
  1972 				;-----------------------------------------------------------------------------
  1973 58D8			Info_Load
  1974 58D8 A9 25			lda #NFO_BUF_BANK
  1975 58DA 85 8E			sta BankIndex
  1976 58DC 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  1977 58DF AD 2D 31			lda LoadStatus
  1978 58E2 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  1979 58E4 20 E8 58			jsr Info_Count_Lines				; sets Nfo_LineCount
  1980 58E7			Info_Load_Ret
  1981 58E7 60				rts
  1982
  1983 				;-----------------------------------------------------------------------------
  1984 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  1985 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  1986 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  1987 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  1988 				; 160-byte step straddles a bank every ~25 records, handled inline.
  1989 				;-----------------------------------------------------------------------------
  1990 58E8			Info_Count_Lines
  1991 58E8 A9 00			lda #$00
  1992 58EA 8D DE 04			sta Nfo_LineCount
  1993 58ED 8D DF 04			sta Nfo_LineCount + $01
  1994 58F0 A9 25			lda #NFO_BUF_BANK
  1995 58F2 8D 50 06			sta Nfo_WalkBank
  1996 58F5 09 80			ora #MEMAC_GLOBAL_ENABLE
  1997 58F7				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 58F7 A0 5F			ldy #<VBXE_MA_BSEL
     3 58F9 91 93			sta (VBXEBase),y
Source: ui.asm
  1998 58FB A9 00			lda #<VBXE_WINDOW
  1999 58FD 85 88			sta Ptr_Lo
  2000 58FF A9 20			lda #>VBXE_WINDOW
  2001 5901 85 89			sta Ptr_Hi
  2002 5903			Info_Count_L1
  2003 5903 A0 00			ldy #$00
  2004 5905 B1 88			lda (Ptr_Lo),y
  2005 5907 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2006 5909 EE DE 04			inc Nfo_LineCount
  2007 590C AD DE 04			lda Nfo_LineCount
  2008 590F C9 7F			cmp #NFO_MAX_LINES
  2009 5911 B0 24			bcs Info_Count_Done					; hit the record cap
  2010 5913 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2011 5915 18				clc
  2012 5916 69 A0			adc #TEXT_PITCH
  2013 5918 85 88			sta Ptr_Lo
  2014 591A 90 E7			bcc Info_Count_L1
  2015 591C E6 89			inc Ptr_Hi
  2016 591E A5 89			lda Ptr_Hi
  2017 5920 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2018 5922 90 DF			bcc Info_Count_L1
  2019 5924 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2020 5926 85 89			sta Ptr_Hi
  2021 5928 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2022 592B AD 50 06			lda Nfo_WalkBank
  2023 592E 09 80			ora #MEMAC_GLOBAL_ENABLE
  2024 5930				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5930 A0 5F			ldy #<VBXE_MA_BSEL
     3 5932 91 93			sta (VBXEBase),y
Source: ui.asm
  2025 5934 4C 03 59			jmp Info_Count_L1
  2026 5937			Info_Count_Done
  2027 5937 A9 00			lda #MEMAC_GLOBAL_DISABLE
  2028 5939				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5939 A0 5F			ldy #<VBXE_MA_BSEL
     3 593B 91 93			sta (VBXEBase),y
Source: ui.asm
