  1048 366A 85 81			sta Reg2
  1049 366C A9 49			lda #<Menu_Demo_Attr_Bot_Vals
  1050 366E 85 88			sta Ptr_Lo
  1051 3670 A9 36			lda #>Menu_Demo_Attr_Bot_Vals
  1052 3672 85 89			sta Ptr_Hi
  1053 3674 20 7E 36			jsr Set_Menu_Demo_Attr_Band
