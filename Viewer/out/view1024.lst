  1551 399B			Sort_Range_Outer
  1552 399B A5 81			lda Reg2
  1553 399D C5 85			cmp Reg6
  1554 399F B0 47			bcs Sort_Range_Unmap				; i >= end-1 -> done
  1555
  1556 39A1 85 83			sta Reg4							; m = i
  1557 39A3 20 13 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1558
  1559 39A6 A5 81			lda Reg2
  1560 39A8 18				clc
  1561 39A9 69 01			adc #$01
  1562 39AB 85 82			sta Reg3							; j = i + 1
  1563 39AD			Sort_Range_Inner
  1564 39AD A5 82			lda Reg3
  1565 39AF C5 84			cmp Reg5
  1566 39B1 B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1567
  1568 39B3 A5 82			lda Reg3
  1569 39B5 20 1F 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1570 39B8 20 EF 39			jsr Cmp_Records						; rec(m) : rec(j)
  1571 39BB 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1572 39BD F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1573 39BF A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1574 39C1 85 83			sta Reg4
  1575 39C3 A5 8C			lda Sort_Ptr
  1576 39C5 85 8A			sta Name_Ptr
  1577 39C7 A5 8D			lda Sort_Ptr + $01
  1578 39C9 85 8B			sta Name_Ptr + $01
  1579 39CB			Sort_Range_Inner_Next
  1580 39CB E6 82			inc Reg3
  1581 39CD 4C AD 39			jmp Sort_Range_Inner
  1582 39D0			Sort_Range_Inner_Done
  1583 39D0 A5 83			lda Reg4
  1584 39D2 C5 81			cmp Reg2
  1585 39D4 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1586 39D6 A5 81			lda Reg2
  1587 39D8 20 1F 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1588 39DB A5 83			lda Reg4
  1589 39DD 20 13 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1590 39E0 20 FD 39			jsr Swap_Records
  1591 39E3			Sort_Range_Outer_Next
  1592 39E3 E6 81			inc Reg2
  1593 39E5 4C 9B 39			jmp Sort_Range_Outer
  1594
  1595 39E8			Sort_Range_Unmap
  1596 39E8 A9 00			lda #MEMAC_GLOBAL_DISABLE
