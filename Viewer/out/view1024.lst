   600 				;-----------------------------------------------------------------------------
   601 				; Build_Image_List - OPEN D:*.MAP as a directory (the wildcard filters), GET
   602 				; each line, and pack every base name as an 8-byte space-padded record into
   603 				; IMAGE_BANK (mapped through the $2000 window). ImageCount = entries stored.
   604 				; Ported from getdir.asm, minus the per-line screen echo.
   605 				;-----------------------------------------------------------------------------
   606 3340			Build_Image_List
   607 3340 A9 00			lda #$00
   608 3342 8D 8B 04			sta ImageCount
   609 3345 8D 8C 04			sta ImageCount+1
   610
   611 3348 20 2D 30			jsr Find_First_IOCB
   612 334B C0 01			cpy #$01
   613 334D F0 01			beq Build_Image_List_Have_IOCB
   614 334F 60				rts									; No free IOCB - ImageCount stays 0
   615 3350			Build_Image_List_Have_IOCB
   616 3350 8E 9D 04			stx Dir_IOCB
   617
   618 3353 A9 06			lda #CIO_dir
   619 3355 9D 4A 03			sta ICAX1,x
   620 3358 A9 34			lda #<Dir_Spec
   621 335A 9D 44 03			sta ICBAL,x
   622 335D A9 34			lda #>Dir_Spec
   623 335F 9D 45 03			sta ICBAH,x
   624 3362 A9 03			lda #CIO_open
   625 3364 9D 42 03			sta ICCOM,x
   626 3367 20 56 E4			jsr CIOV
   627 336A 30 69			bmi Build_Image_List_Done			; OPEN failed - nothing to scan
   628
   629 336C A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   630 336E				vbsta VBXE_MA_BSEL
