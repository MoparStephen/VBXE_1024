   121 206A 72				dta %01110010
   122 206B 28				dta %00101000
   123 206C 00				dta $00								; XDLC_RPTL = 1-1
   124 206D 00 30 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
   125 2072 01 FE			dta %00000001,$FE
