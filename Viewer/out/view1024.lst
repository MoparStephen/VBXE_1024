  1247 389E			Handle_Keys_NotSlide
  1248 389E C9 03			cmp #$03
  1249 38A0 D0 03			bne Handle_Keys_NotFolder
  1250 38A2 4C 17 5A			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
  1251 38A5			Handle_Keys_NotFolder
  1252 38A5 C9 04			cmp #$04
  1253 38A7 D0 03			bne Handle_Keys_NotInfo
  1254 38A9 4C 48 5F			jmp Info_Keys						; 4 = info viewer (.nfo)
  1255 38AC			Handle_Keys_NotInfo
  1256 38AC C9 05			cmp #$05
