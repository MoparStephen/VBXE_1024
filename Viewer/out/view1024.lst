  2906 632B C9 3E			cmp #'>'
  2907 632D D0 F4			bne Path_Save_Back
  2908 632F E8				inx									; first char after the separator
  2909 6330			Path_Save_Copy
  2910 6330 A0 00			ldy #$00
  2911 6332			Path_Save_L1
  2912 6332 BD 28 06			lda Scan_Path,x
  2913 6335 C9 3E			cmp #'>'
  2914 6337 F0 09			beq Path_Save_Done
  2915 6339 99 EC 04			sta Up_Name,y
  2916 633C E8				inx
  2917 633D C8				iny
  2918 633E C0 08			cpy #$08
  2919 6340 90 F0			bcc Path_Save_L1
  2920 6342			Path_Save_Done
  2921 6342 60				rts
