   161 3306 A9 01			lda #$01							; Set BASICF for OS
   162 3308 8D F8 03			sta BASICF							; So BASIC remains OFF after RESET
   163
   164 330B AD 01 D3			lda PORTB							; Disable BASIC bit in PORTB for MMU
   165 330E 09 02			ora #$02							; By Setting bit 2
   166 3310 8D 01 D3			sta PORTB
   167
   168 3313 AD 00 A0			lda $A000							; Check if BASIC ROM area is now RAM
   169 3316 EE 00 A0			inc $A000							; This will also catch SDX not launching
   170 3319 CD 00 A0			cmp $A000							; The app via X
   171 331C F0 21			beq Ram_Not_Ok						; If not, perform print error and exit
   172
   173 331E A9 0C			lda #$0C							; 12 = CLOSE
   174 3320 20 2E 33			jsr Do_CIOV							; Close editor
   175
   176 3323 A9 C0			lda #$C0
   177 3325 85 6A			sta RAMTOP							; Set RAMTOP to end of BASIC
   178 3327 8D E4 02			sta RAMSIZ							; Set RAMSIZ also
   179
   180 332A A2 00			ldx #$00							; Channel #0
   181 332C A9 04			lda #$04							; 4 = OPEN_READ
   182 332E			Do_CIOV
