   974 361A 85 81			sta Reg2
   975 361C A9 F9			lda #<Menu_Demo_Attr_Bot_Vals
   976 361E 85 88			sta Ptr_Lo
   977 3620 A9 35			lda #>Menu_Demo_Attr_Bot_Vals
   978 3622 85 89			sta Ptr_Hi
   979 3624 20 2E 36			jsr Set_Menu_Demo_Attr_Band
