   122 				;-----------------------------------------------------------------------------
   123 				; Toggle_Font - flip the text screen between the CGA ($44) and Atari ($45)
   124 				; font by rewriting the two XDLC_CHBASE bytes (main + footer text blocks) in
   125 				; XDL_MainMenu.  The VBXE re-reads the XDL each frame, so the change shows on
   126 				; the next frame with no redraw.  Called from Handle_Keys on the F key, from
   127 				; any screen.
   128 				;-----------------------------------------------------------------------------
   129 3AC9			Toggle_Font
   130 3AC9 AD E0 04			lda Font_Sel
   131 3ACC 49 01			eor #$01
   132 3ACE 8D E0 04			sta Font_Sel
   133 3AD1 18				clc
   134 3AD2 69 44			adc #TEXT_CHBASE					; 0 -> $44 (CGA) / 1 -> $45 (Atari)
   135 3AD4 AA				tax									; hold it - vbsta clobbers A (and Y)
