   141 				; Defines go here
   142 				;-----------------------------------------------------------------------------
   143 = FFFF0001		.def	__VBXE_AUTO__
   144 = 2000			.def	VBXE_WINDOW						= $2000
   145 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   146 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   147 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   148
   149 				; Image name list (built by Rescan_Images - see ui.asm)
   150 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   151 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   152 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   153 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   154 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   155
   156 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   157 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   158 				; ($21000), the name list ($40000) and the dir browser ($41000).
   159 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   160 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   161 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   162 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   163 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   164 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   165 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   166 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   167 = 0050			.def	TEXT_COLS						= 80
   168 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   169 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   170 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   171 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   172 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   173 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   174 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   175 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   176 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   177
   178 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   179 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   180 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   181 = 030000			.def	MENU_BANNER_VRAM				= $30000
   182 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   183 = 0024			.def	MENU_BANNER_ROWS				= 36
   184 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   185 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   186 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   187 = 00A0			.def	MENU_SEP_PITCH					= 160
   188 = 0007			.def	MENU_SEP_FILL_COLOUR			= $07		; white in the modified A8 palette (Palette 0)  Palette is modified so text can use all 128 colours
   189
   190 				; Banner palette + attribute map: never touched at runtime (unlike the real
   191 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   192 				; overwrites for every image view).  Dedicated, resident VRAM - see
   193 				; Load_Menu_Banner_Raw / Apply_Menu_Banner_Palette (below) and Setup_Menu_Cmap.
   194 				; The palette bytes are assembly-embedded (Load_Menu_Ramps, init_vbxe.asm),
   195 				; not disk-loaded; the attribute map is still loaded once from D:MENU.MAP.
   196 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   197 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   198 																	; - palette register 0 is reserved for text
   199 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   200 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   201 																	; XDL_MainMenu's banner MAPADR points here, NOT
   202 																	; at the shared $017000 CRAM
   203
   204 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   205 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   206 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   207 				; unchanged) but horizontally mirrored via the attribute map only -
   208 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   209 				; Squares, Set_Menu_Demo_Attrs (below).
   210 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   211 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   212 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   213 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   214 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   215 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   216 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   217 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   218 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   219 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   220 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   221 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   222 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   223 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   224
   225 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   226 				; converter emits it as this exact byte image of the text screen - fixed
   227 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   228 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   229 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   230 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   231 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   232 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   233
   234 				; Selector status-line long-name cache.  One NFO_NAME_SLOT-byte slot per image
   235 				; ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   236 				; Rescan_Images (the converter writes that file - 8-byte key + source name per
   237 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  64
   238 				; divides 4K so no slot straddles a bank; 255*64 = $3FC0 -> banks $2A-$2D.
   239 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   240 = 02A000			.def	NFO_NAME_VRAM					= $2A000
   241 = 002A			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $2A
   242 = 0040			.def	NFO_NAME_SLOT					= 64		; bytes per image slot
   243 = 0030			.def	NFO_NAME_CAP						= 48		; chars shown on the status line
   244
   245 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   246 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   247 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   248 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   249 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   250 = 0006			.def	DRIVE_WIN_ROW					= 6
   251 = 001E			.def	DRIVE_WIN_COL					= 30
   252 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   253 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   254
   255 				; Quit-confirm popup (UI_Mode 5) - "Are you sure to Quit" + (Y/N), Selector only.
   256 = 0008			.def	QUIT_WIN_ROW					= 8
   257 = 0016			.def	QUIT_WIN_COL					= 22
   258 = 0024			.def	QUIT_WIN_W						= 36		; cells wide  (border + text + border)
   259 = 0005			.def	QUIT_WIN_H						= 5		; rows        (border + text + hint + border, +1)
   260
   261 				; BCB field byte offsets
   262 = 0000			.def	Src_Adr0						= $00
   263 = 0001			.def	Src_Adr1						= $01
   264 = 0002			.def	Src_Adr2						= $02
   265 = 0006			.def	Dest_Adr0						= $06
   266 = 0007			.def	Dest_Adr1						= $07
   267 = 0008			.def	Dest_Adr2						= $08
   268 = 000C			.def	Blt_W0							= $0C	; Width-1  low byte
   269 = 000D			.def	Blt_W1							= $0D	; Width-1  bit 8
   270 = 000E			.def	Blt_H							= $0E	; Height-1
   271 = 000F			.def	Blt_And							= $0F	; And mask (0 = constant source)
   272 = 0010			.def	Blt_Xor							= $10	; Xor mask (= fill value when And = 0)
   273 = 0014			.def	Blt_Ctrl						= $14
   274
   275 				; Temp debug stuff
   276 = 0010			.def	V_0								= $10	; 0 (Screen code used for Version in loading screen)
   277 = 0011			.def	V_1								= $11	; 1 (Screen code used for Version in loading screen)
   278 = 0014			.def	V_2								= $14	; 3 (Screen code used for Version in loading screen)
   279 = 0000			.def	V_3								= $00	; 61=a (Screen code used for Version in loading screen)
