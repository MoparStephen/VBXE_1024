   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3C0B			Text_Window_Save
   393 3C0B 20 5E 3C			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3C0E A5 83			lda Reg4
   395 3C10 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3C13 A5 84			lda Reg5
   397 3C15 18				clc
   398 3C16 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3C18 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3C1B A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3C1D 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3C20 A9 00			lda #<WIN_SAVE_VRAM
   403 3C22 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3C25 A9 F0			lda #>WIN_SAVE_VRAM
   405 3C27 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
