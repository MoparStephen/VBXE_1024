  1934 				;-----------------------------------------------------------------------------
  1935 				; Sort_Range - in-place alphabetical selection sort of the records
  1936 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1937 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1938 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1939 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1940 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1941 				;-----------------------------------------------------------------------------
  1942 3C9C			Sort_Range
  1943 3C9C E0 02			cpx #$02
  1944 3C9E 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1945 3CA0 85 81			sta Reg2							; Reg2 = i = start
  1946 3CA2 86 82			stx Reg3							; Reg3 = count (temp)
  1947 3CA4 18				clc
  1948 3CA5 65 82			adc Reg3
  1949 3CA7 85 84			sta Reg5							; Reg5 = end = start + count
  1950 3CA9 38				sec
  1951 3CAA E9 01			sbc #$01
  1952 3CAC 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1953
  1954 3CAE A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1955 3CB0				vbsta VBXE_MA_BSEL
