  1615 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1616 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1617 				; equal) otherwise.
  1618 				;-----------------------------------------------------------------------------
  1619 3A1A			Cmp_Records
  1620 3A1A A0 00			ldy #$00
  1621 3A1C			Cmp_Records_L1
  1622 3A1C B1 8A			lda (Name_Ptr),y
  1623 3A1E D1 8C			cmp (Sort_Ptr),y
  1624 3A20 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1625 3A22 C8				iny
  1626 3A23 C0 08			cpy #$08
  1627 3A25 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1628 3A27			Cmp_Records_Done
  1629 3A27 60				rts
