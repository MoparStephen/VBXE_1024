  1403 				; Set_Palette
  1404 				;  X register contains Palette #
  1405 				;  XDL_Image_Normal + $08 = the byte we need to change
  1406 				;  XDL OV PALETTE bits 5,4 need changed (00 to 11), bit 0 always needs on
  1407 				;-----------------------------------------------------------------------------
  1408 38EE			Set_Palette
