   816 				;-----------------------------------------------------------------------------
   817 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   818 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   819 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   820 				; for text).  Called once at boot (above) and from every Enter_Selector
   821 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   822 				; viewed in between and there is no way to avoid that hardware-register
   823 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   824 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
   825 				;-----------------------------------------------------------------------------
   826 3547			Apply_Menu_Banner_Palette
   827 3547 A9 B4			lda #(MENU_BANNER_PAL_VRAM / $1000) | MEMAC_GLOBAL_ENABLE
   828 3549				vbsta VBXE_MA_BSEL
