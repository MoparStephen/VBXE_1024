  2416 				;-----------------------------------------------------------------------------
  2417 				; Slideshow_Reload_Counter - Slide_FrameCtr = Slide_Secs * framerate
  2418 				;   framerate = 50 (PAL, Video_Flag = 0) or 60 (NTSC, Video_Flag = 1)
  2419 				;-----------------------------------------------------------------------------
  2420 5FCD			Slideshow_Reload_Counter
  2421 5FCD A9 00			lda #$00
  2422 5FCF 8D CA 04			sta Slide_FrameCtr
  2423 5FD2 8D CB 04			sta Slide_FrameCtr+1
  2424 5FD5 AE C9 04			ldx Slide_Secs
  2425 5FD8 F0 1E			beq Slideshow_Reload_Done
  2426 5FDA AD 89 04			lda Video_Flag
  2427 5FDD D0 04			bne Slideshow_Reload_NTSC
  2428 5FDF A9 32			lda #50
  2429 5FE1 D0 02			bne Slideshow_Reload_Set
  2430 5FE3			Slideshow_Reload_NTSC
  2431 5FE3 A9 3C			lda #60
  2432 5FE5			Slideshow_Reload_Set
  2433 5FE5 85 80			sta Reg1							; Reg1 = frames to add per second
  2434 5FE7			Slideshow_Reload_L1
  2435 5FE7 18				clc
  2436 5FE8 AD CA 04			lda Slide_FrameCtr
  2437 5FEB 65 80			adc Reg1
  2438 5FED 8D CA 04			sta Slide_FrameCtr
  2439 5FF0 90 03			bcc Slideshow_Reload_NoCarry
  2440 5FF2 EE CB 04			inc Slide_FrameCtr+1
  2441 5FF5			Slideshow_Reload_NoCarry
  2442 5FF5 CA				dex
  2443 5FF6 D0 EF			bne Slideshow_Reload_L1
  2444 5FF8			Slideshow_Reload_Done
  2445 5FF8 60				rts
