   188 				;-----------------------------------------------------------------------------
   189 				; Wait For VSync (locks to the refresh rate, PAL=50Hz, NTSC=60Hz)  Thanks tebe
   190 				;-----------------------------------------------------------------------------
   191 3356			Wait_For_Sync							; Hold until VCOUNT == 0
   192 3356 2C 0B D4			bit	VCOUNT
   193 3359 30 FB			bmi *-3
   194 335B 2C 0B D4			bit	VCOUNT
   195 335E 10 FB			bpl *-3
   196 				; If present, the next 3 lines will allow a "jump to exit" on a specific key press
   197 3360 AD FC 02			lda CH
   198 3363 C9 2F			cmp #$2F							; Press Q to quit
   199 3365 F0 E7			beq	Exit
   200 3367 60				rts									; Else return to caller
