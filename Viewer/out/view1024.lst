  1090 54DF F0 0A			beq Nfo_Name_Emit_Pad
  1091 54E1 99 50 06			sta Nfo_Name_Line,y
  1092 54E4 C8				iny
  1093 54E5 C0 4B			cpy #NFO_NAME_CAP
  1094 54E7 90 F4			bcc Nfo_Name_Emit_Copy
  1095 54E9 B0 0C			bcs Nfo_Name_Emit_Term
  1096 54EB			Nfo_Name_Emit_Pad
  1097 54EB A9 20			lda #$20
  1098 54ED			Nfo_Name_Emit_PadL
  1099 54ED C0 4B			cpy #NFO_NAME_CAP
  1100 54EF B0 06			bcs Nfo_Name_Emit_Term
  1101 54F1 99 50 06			sta Nfo_Name_Line,y
  1102 54F4 C8				iny
  1103 54F5 D0 F6			bne Nfo_Name_Emit_PadL				; always (Y < NFO_NAME_CAP)
  1104 54F7			Nfo_Name_Emit_Term
  1105 54F7 A9 00			lda #$00
  1106 54F9 8D 9B 06			sta Nfo_Name_Line + NFO_NAME_CAP
  1107 54FC A9 00			lda #MEMAC_GLOBAL_DISABLE
  1108 54FE				vbsta VBXE_MA_BSEL
