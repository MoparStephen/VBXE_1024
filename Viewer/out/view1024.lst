  1568
  1569 39CC 85 83			sta Reg4							; m = i
  1570 39CE 20 3E 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1571
  1572 39D1 A5 81			lda Reg2
  1573 39D3 18				clc
