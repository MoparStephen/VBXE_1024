  1684 5AB1 C5 80			cmp Reg1
  1685 5AB3 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1686 5AB5 F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1687 5AB7 A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1688 5AB9 4C C8 5A			jmp Sel_Top_FI_Scale
  1689 5ABC			Sel_Top_FI_MaybeDown
  1690 5ABC 18				clc
  1691 5ABD 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1692 5ABF C5 80			cmp Reg1
  1693 5AC1 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1694 5AC3 A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1695 5AC5 38				sec
  1696 5AC6 E9 0E			sbc #[UI_VISROWS-1]
  1697 5AC8			Sel_Top_FI_Scale
  1698 5AC8 0A				asl
  1699 5AC9 0A				asl
  1700 5ACA 0A				asl								; row -> Sel_Top (* UI_COLS)
  1701 5ACB 60				rts
  1702 5ACC			Sel_Top_FI_Unchanged
  1703 5ACC AD C8 04			lda Sel_Top
  1704 5ACF 60				rts
