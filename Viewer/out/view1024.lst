  2486 5E1E 85 88			sta Ptr_Lo
  2487 5E20 A9 20			lda #>VBXE_WINDOW
  2488 5E22 85 89			sta Ptr_Hi
  2489 5E24			Info_Count_L1
  2490 5E24 A0 00			ldy #$00
  2491 5E26 B1 88			lda (Ptr_Lo),y
  2492 5E28 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2493 5E2A EE DE 04			inc Nfo_LineCount
  2494 5E2D AD DE 04			lda Nfo_LineCount
  2495 5E30 C9 7F			cmp #NFO_MAX_LINES
  2496 5E32 B0 24			bcs Info_Count_Done					; hit the record cap
  2497 5E34 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2498 5E36 18				clc
  2499 5E37 69 A0			adc #TEXT_PITCH
  2500 5E39 85 88			sta Ptr_Lo
  2501 5E3B 90 E7			bcc Info_Count_L1
  2502 5E3D E6 89			inc Ptr_Hi
  2503 5E3F A5 89			lda Ptr_Hi
  2504 5E41 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2505 5E43 90 DF			bcc Info_Count_L1
  2506 5E45 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2507 5E47 85 89			sta Ptr_Hi
  2508 5E49 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2509 5E4C AD 50 06			lda Nfo_WalkBank
  2510 5E4F 09 80			ora #MEMAC_GLOBAL_ENABLE
  2511 5E51				vbsta VBXE_MA_BSEL
