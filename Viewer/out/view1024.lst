   243 3DB9 A9 02			lda #[TEXT_SCREEN_VRAM >> 16]
   244 3DBB 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   245 3DBE A9 9F			lda #<[TEXT_PITCH-1]
   246 3DC0 8D 8A 21			sta BLT_TEXT_RECT + Blt_W0			; Width-1  = 159 bytes (80 cells)
   247 3DC3 A9 00			lda #>[TEXT_PITCH-1]
   248 3DC5 8D 8B 21			sta BLT_TEXT_RECT + Blt_W1
   249 3DC8 A9 16			lda #TEXT_ROWS-1
   250 3DCA 8D 8C 21			sta BLT_TEXT_RECT + Blt_H			; Height-1 = every row, both bands
   251 3DCD A9 00			lda #$00
