   420 				;-----------------------------------------------------------------------------
   421 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   422 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   423 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   424 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   425 				;  Returns A = $01 if a name was written, $00 if not.
   426 				;-----------------------------------------------------------------------------
   427 4FC6			Parse_Dir_Line
   428 4FC6 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   429 4FC8			Parse_Skip_L1							; Skip leading spaces / protect flag
   430 4FC8 BD 00 06			lda Dir_Line_Buf,x
   431 4FCB C9 9B			cmp #$9B
   432 4FCD F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   433 4FCF C9 20			cmp #' '
   434 4FD1 F0 04			beq Parse_Skip_Next
   435 4FD3 C9 2A			cmp #'*'
   436 4FD5 D0 07			bne Parse_Skip_Done
   437 4FD7			Parse_Skip_Next
   438 4FD7 E8				inx
   439 4FD8 E0 28			cpx #Dir_Line_Len
   440 4FDA 90 EC			bcc Parse_Skip_L1
   441 4FDC B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   442 4FDE			Parse_Skip_Done
   443 4FDE A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   444 4FE0 A9 00			lda #$00
   445 4FE2 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   446
   447 4FE4			Parse_Copy_L1
   448 4FE4 BD 00 06			lda Dir_Line_Buf,x
   449 4FE7 C9 9B			cmp #$9B
   450 4FE9 F0 24			beq Parse_Copy_Done
   451 4FEB C9 20			cmp #' '
   452 4FED F0 20			beq Parse_Copy_Done
   453 4FEF C9 2E			cmp #'.'
   454 4FF1 F0 1C			beq Parse_Copy_Done
   455 4FF3 C9 30			cmp #'0'
   456 4FF5 90 07			bcc Parse_Copy_Is_Name_Char
   457 4FF7 C9 3A			cmp #'9'+1
   458 4FF9 B0 03			bcs Parse_Copy_Is_Name_Char
   459 4FFB 4C 00 50			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   460 4FFE			Parse_Copy_Is_Name_Char
   461 4FFE E6 80			inc Reg1
   462 5000			Parse_Copy_Store
   463 5000 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   464 5002 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   465 5004 BD 00 06			lda Dir_Line_Buf,x
   466 5007 91 8A			sta (Name_Ptr),y
   467 5009 C8				iny
   468 500A			Parse_Copy_Next
   469 500A E8				inx
   470 500B E0 28			cpx #Dir_Line_Len
   471 500D 90 D5			bcc Parse_Copy_L1
   472
   473 500F			Parse_Copy_Done
   474 500F A5 80			lda Reg1
   475 5011 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   476
   477 5013			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   478 5013 C0 08			cpy #$08
   479 5015 B0 07			bcs Parse_Dir_Line_Accept
   480 5017 A9 20			lda #' '
   481 5019 91 8A			sta (Name_Ptr),y
   482 501B C8				iny
   483 501C D0 F5			bne Parse_Pad_L1
   484
   485 501E			Parse_Dir_Line_Accept
   486 501E A9 01			lda #$01							; Non-zero - a name was stored
   487 5020 60				rts
   488 5021			Parse_Dir_Line_Reject
   489 5021 A9 00			lda #$00
   490 5023 60				rts
   491
