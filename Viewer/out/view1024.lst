  1375 				;-----------------------------------------------------------------------------
  1376 				; Sort_Range - in-place alphabetical selection sort of the records
  1377 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1378 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1379 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1380 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1381 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1382 				;-----------------------------------------------------------------------------
  1383 38D5			Sort_Range
  1384 38D5 E0 02			cpx #$02
  1385 38D7 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1386 38D9 85 81			sta Reg2							; Reg2 = i = start
  1387 38DB 86 82			stx Reg3							; Reg3 = count (temp)
  1388 38DD 18				clc
  1389 38DE 65 82			adc Reg3
  1390 38E0 85 84			sta Reg5							; Reg5 = end = start + count
  1391 38E2 38				sec
  1392 38E3 E9 01			sbc #$01
  1393 38E5 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1394
  1395 38E7 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1396 38E9				vbsta VBXE_MA_BSEL
