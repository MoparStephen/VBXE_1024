  1380 392D 4C 2F 60			jmp Slideshow_Keys					; 2 = slideshow
  1381 3930			Handle_Keys_NotSlide
  1382 3930 C9 03			cmp #$03
  1383 3932 D0 03			bne Handle_Keys_NotFolder
  1384 3934 4C 97 5C			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
  1385 3937			Handle_Keys_NotFolder
  1386 3937 C9 04			cmp #$04
