   780 				;-----------------------------------------------------------------------------
   781 				; Image_Read_Pal - read the .V1K's leading .PAL block into $21000.
   782 				;  Out: C=1 on a read error / short file.
   783 				;-----------------------------------------------------------------------------
   784 3594			Image_Read_Pal
   785 3594 A9 21			lda #V1K_PAL_BANK
   786 3596 A2 00			ldx #V1K_PAL_LEN / $1000
   787 3598 A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   788 359A 8C E5 04			sty Seg_Tail
   789 359D A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   790 359F 8C E6 04			sty Seg_Tail + $01
   791 35A2 4C D6 35			jmp Image_Read_Segment
