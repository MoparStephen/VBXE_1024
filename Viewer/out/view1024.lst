    93 3ABD A9 A1			lda #<Text_Font_Data
    94 3ABF 85 88			sta Ptr_Lo
    95 3AC1 A9 3E			lda #>Text_Font_Data
    96 3AC3 85 89			sta Ptr_Hi
    97 3AC5 A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    98 3AC7 85 80			sta Reg1
    99 3AC9 A9 20			lda #>VBXE_WINDOW
   100 3ACB 85 81			sta Reg2
   101 3ACD 20 3F 3B			jsr Text_Copy_2K
   102
   103 3AD0 A9 A1			lda #<Atari_Font_Data
   104 3AD2 85 88			sta Ptr_Lo
   105 3AD4 A9 46			lda #>Atari_Font_Data
   106 3AD6 85 89			sta Ptr_Hi
   107 3AD8 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
   108 3ADA 85 80			sta Reg1
   109 3ADC A9 28			lda #>[VBXE_WINDOW + $800]
   110 3ADE 85 81			sta Reg2
   111 3AE0 20 3F 3B			jsr Text_Copy_2K
   112
   113 				; Make the Atari font answer to the CP437 codes the UI draws with: copy its own
   114 				; line / arrow glyphs into those slots (VRAM copy only - ATARI.F08 itself is
   115 				; untouched).  Both fonts then render the same bytes, so F is a pure CHBASE
   116 				; flip and nothing on screen ever needs redrawing for it.  The overwritten
   117 				; slots are only inverse-video copies ($80+) and ATASCII Ctrl glyphs no UI
   118 				; string or .NFO (plain ASCII) uses.
   119 3AE3 A2 00			ldx #$00
   120 3AE5			Text_Load_Fonts_Remap
   121 3AE5 BD 1F 3B			lda Atari_Remap_Table,x				; source glyph -> Ptr = $2800 + src*8
   122 3AE8 20 0F 3B			jsr Text_Glyph_Addr
   123 3AEB 85 88			sta Ptr_Lo
   124 3AED 84 89			sty Ptr_Hi
   125 3AEF BD 20 3B			lda Atari_Remap_Table+1,x			; dest glyph   -> Reg1/2 = $2800 + dst*8
   126 3AF2 20 0F 3B			jsr Text_Glyph_Addr
   127 3AF5 85 80			sta Reg1
   128 3AF7 84 81			sty Reg2
   129 3AF9 A0 07			ldy #$07
   130 3AFB			Text_Load_Fonts_Glyph
   131 3AFB B1 88			lda (Ptr_Lo),y
   132 3AFD 91 80			sta (Reg1),y
   133 3AFF 88				dey
   134 3B00 10 F9			bpl Text_Load_Fonts_Glyph
   135 3B02 E8				inx
   136 3B03 E8				inx
   137 3B04 E0 20			cpx #[Atari_Remap_Table_End-Atari_Remap_Table]
   138 3B06 D0 DD			bne Text_Load_Fonts_Remap
   139
   140 3B08 A9 00			lda #MEMAC_GLOBAL_DISABLE
   141 3B0A				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
