  1368 				; Sel_Key_Down/Up/Left/Right - each validates and clamps the move, then hands
  1369 				; the new index to Sel_Nav_Apply.  Because the list is one flat, row-major
  1370 				; array, Left/Right wrapping across a row boundary needs no extra logic -
  1371 				; it's just Sel_Index +/- 1.
  1372 55C2			Sel_Key_Down
  1373 55C2 AD 8B 04			lda ImageCount
  1374 55C5 0D 8C 04			ora ImageCount+1
  1375 55C8 F0 61			beq Sel_Key_Nav_Done				; empty list
  1376 55CA AD C7 04			lda Sel_Index
  1377 55CD 18				clc
  1378 55CE 69 08			adc #UI_COLS
  1379 55D0 CD 8B 04			cmp ImageCount
  1380 55D3 B0 56			bcs Sel_Key_Nav_Done				; no cell directly below - clamp
  1381 55D5 4C 05 56			jmp Sel_Nav_Apply
  1382
  1383 55D8			Sel_Key_Up
  1384 55D8 AD C7 04			lda Sel_Index
  1385 55DB C9 08			cmp #UI_COLS
  1386 55DD 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1387 55DF 38				sec
  1388 55E0 E9 08			sbc #UI_COLS
  1389 55E2 4C 05 56			jmp Sel_Nav_Apply
  1390
  1391 55E5			Sel_Key_Left
  1392 55E5 AD C7 04			lda Sel_Index
  1393 55E8 F0 41			beq Sel_Key_Nav_Done				; already at the first item
  1394 55EA 38				sec
  1395 55EB E9 01			sbc #$01
  1396 55ED 4C 05 56			jmp Sel_Nav_Apply
  1397
  1398 55F0			Sel_Key_Right
