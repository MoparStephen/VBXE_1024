  1618 39C9 B1 8C			lda (Sort_Ptr),y
  1619 39CB 91 8A			sta (Name_Ptr),y
  1620 39CD B9 8D 04			lda Path_Buf,y
  1621 39D0 91 8C			sta (Sort_Ptr),y
  1622 39D2 C8				iny
  1623 39D3 C0 08			cpy #$08
  1624 39D5 90 ED			bcc Swap_Records_L1
  1625 39D7 60				rts
