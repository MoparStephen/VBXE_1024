   323 = DD89			FLD0R       equ $DD89					; Load FR0 by X,Y register pointer
   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    70
    71 				;-----------------------------------------------------------------------------
    72 				; Structure Declarations
    73 				;-----------------------------------------------------------------------------
    74
    75 				;-----------------------------------------------------------------------------
    76 				; Variables go here
    77 				;-----------------------------------------------------------------------------
    78 				; Page 0 user data ($80 to $FF with some reserved for OS)
    79 				.zpvar Reg1				.byte			; Multi-Use Variables
    80 				.zpvar Reg2				.byte			; Multi-Use Variables
    81 				.zpvar Reg3				.byte			; Multi-Use Variables
    82 				.zpvar Reg4				.byte			; Multi-Use Variables
    83 				.zpvar Reg5				.byte			; Multi-Use Variables
    84 				.zpvar Reg6				.byte			; Multi-Use Variables
    85 				.zpvar Reg7				.byte			; Multi-Use Variables
    86 				.zpvar Reg8				.byte			; Multi-Use Variables
    87 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    88 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    89 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    90 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    91
    92 				; Non Page-0 Variables
    93 				;	$480 to $4FF free
    94 				;	$600 to $6FF free
    95 				; When using PMG the 1st $300 bytes are always free
    96 				.var SDMCTL_OLD			.byte = $480	; Save DMA
    97 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
    98 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
    99 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
   100 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   101 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   102 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   103 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   104 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   105 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   106 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   107 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   108 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   109 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   110 				; --- viewer UI state (ui.asm) ---
   111 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 6 P-preview
   112 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   113 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   114 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   115 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   116 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   117 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   118 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   119 				.var FileStart			.byte = $4DA	; selector list: index of the first *.V1K row (= upCount + Dir_Count)
   120 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   121 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   122 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   123 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   124 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   125 				; --- single-file .V1K image loader (Image_Open / Image_Read_Segment) ---
   126 				.var Load_IOCB			.byte = $4E2	; IOCB offset of the open .V1K file
   127 				.var Seg_Bank			.byte = $4E3	; VBXE bank the next 4K chunk lands in
   128 				.var Seg_Chunks			.byte = $4E4	; full 4K chunks left in this segment
   129 				.var Seg_Tail			.word = $4E5	; bytes in the segment's final partial chunk
   130 				;	$4E7 to $4FF free
   131 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   132 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   133 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.V1K",$9B ($650-$67F)
   134 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   135 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP description + $9B) for
   136 				; Nfo_Name_LoadManifest, and the padded status-line text Nfo_Name_Emit builds
   137 				; for Selector_DrawStatus.  8+75+1 = 84 bytes fits no free gap, so it OVERLAYS
   138 				; Scan_Spec + Txt_Line ($650-$6A3).  Safe because neither is live across
   139 				; either use: Scan_Spec is only read by the CIO OPEN before the record loop
   140 				; (and rebuilt before every scan), Txt_Line is per-draw scratch that
   141 				; Text_PutStrAt does not touch, and Nfo_WalkBank ($650) is only live inside
   142 				; Info_Count_Lines (UI_Mode 4, no status line).
   143 				.var Nfo_Name_Line		:84 .byte = $650	; 8 key + 75 desc + $9B ($650-$6A3)
   144 				;	$6B7 to $6FF free (text80.asm uses $6B0-$6B6)
   145 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   146 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   147 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   148 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   149 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   150
   151 				;-----------------------------------------------------------------------------
   152 				; Defines go here
   153 				;-----------------------------------------------------------------------------
   154 = FFFF0001		.def	__VBXE_AUTO__
   155 = 2000			.def	VBXE_WINDOW						= $2000
   156 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   157 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   158 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   159
   160 				; Image name list (built by Rescan_Images - see ui.asm)
   161 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   162 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   163 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   164 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   165 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   166
   167 				; Single-file image: <name>.V1K = .PAL block + .MAP block + .RAW block, no
   168 				; header - every block is fixed-size, so every offset is a constant.
   169 				; Load_Image streams each block to the same VRAM the old 3-file load used.
   170 = 0C00			.def	V1K_PAL_LEN						= $0C00		; 4 palettes x 768     = 3072
   171 = 2580			.def	V1K_MAP_LEN						= $2580		; 40 cells x 240 rows  = 9600
   172 = 012C00			.def	V1K_RAW_LEN						= $12C00	; 320 x 240 pixels     = 76800
   173 = 0021			.def	V1K_PAL_BANK					= $21		; -> $21000 (read back by Apply_Image_Palette)
   174 = 0014			.def	V1K_MAP_BANK					= $14		; -> $14000 (CRAM_Buffer, Setup_Cmap1 expands it)
   175 = 0001			.def	V1K_RAW_BANK					= $01		; -> $01000 (framebuffer)
   176
   177 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   178 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   179 				; ($21000), the name list ($40000) and the dir browser ($41000).
   180 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   181 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   182 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   183 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   184 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   185 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   186 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   187 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   188 = 0050			.def	TEXT_COLS						= 80
   189 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   190 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   191 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   192 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   193 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   194 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   195 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   196 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   197 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   198
   199 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   200 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   201 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   202 = 030000			.def	MENU_BANNER_VRAM				= $30000
   203 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   204 = 0024			.def	MENU_BANNER_ROWS				= 36
   205 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   206 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   207 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   208 = 00A0			.def	MENU_SEP_PITCH					= 160
   209 = 0007			.def	MENU_SEP_FILL_COLOUR			= $07		; white in the modified A8 palette (Palette 0)  Palette is modified so text can use all 128 colours
   210
   211 				; Banner palette + attribute map: never touched at runtime (unlike the real
   212 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   213 				; overwrites for every image view).  Dedicated, resident VRAM - see
   214 				; Load_Menu_Banner_Raw / Apply_Menu_Banner_Palette (below).
   215 				; The palette bytes are assembly-embedded (Load_Menu_Ramps, init_vbxe.asm),
   216 				; not disk-loaded.  The attribute map has no file either: it is left all
   217 				; zeros (= palette 0) by the boot-time clear_vbxe, and Set_Menu_Demo_Attrs
   218 				; sets just the ramp squares' cells.
   219 = 034000			.def	MENU_BANNER_PAL_VRAM			= $34000	; same 4x768-byte .PAL layout Load_Image
   220 																	; uses ($0000/$0300/$0600/$0900); slot 0 unused
   221 																	; - palette register 0 is reserved for text
   222 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   223 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   224 																	; XDL_MainMenu's banner MAPADR points here, NOT
   225 																	; at the shared $017000 CRAM
   226
   227 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   228 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   229 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   230 				; unchanged) but horizontally mirrored via the attribute map only -
   231 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   232 				; Squares, Set_Menu_Demo_Attrs (below).
   233 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   234 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   235 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   236 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   237 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   238 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   239 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   240 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   241 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   242 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   243 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   244 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   245 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   246 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   247
   248 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   249 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   250 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   251 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   252 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   253 = 1000			.def	PAL_PREVIEW_VRAM				= $001000	; image framebuffer (same target Load_Image's .RAW uses)
   254 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   255 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   256 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   257 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   258 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   259 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   260 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   261 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   262 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   263 = 18F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   264 = 1960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   265 = A4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   266 = A560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   267 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   268 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   269 				; whole buffer, and palette 0 = $00 is the zero default).
   270 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   271 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   272 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   273 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   274 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   275 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   276 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   277 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   278
   279 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   280 				; converter emits it as this exact byte image of the text screen - fixed
   281 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   282 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   283 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   284 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   285 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   286 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   287
   288 				; Selector status-line description cache.  One NFO_NAME_SLOT-byte slot per
   289 				; image ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   290 				; Rescan_Images (the converter writes that file - 8-byte key + description per
   291 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  128
   292 				; divides 4K so no slot straddles a bank; 255*128 = $7F80 -> banks $37-$3E.
   293 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   294 = 037000			.def	NFO_NAME_VRAM					= $37000
   295 = 0037			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $37
   296 = 0080			.def	NFO_NAME_SLOT					= 128		; bytes per image slot
   297 = 004B			.def	NFO_NAME_CAP						= 75		; chars shown on the status line
   298 																		; ("Src: " + 75 = 80 cols; = the
   299 																		; converter's DESC_CAP)
   300
   301 				; Save-under text window (Text_Window_Save/Restore/Frame in text80.asm).  The
   302 				; covered {glyph,attr} rectangle is blit-copied here at screen pitch (160) and
   303 				; blitted back on close.  $2F000 sits above the NFO buffer + its free tail.
   304 = 02F000			.def	WIN_SAVE_VRAM					= $2F000
   305 				; Drive picker (UI_Mode 3) geometry - a small overlay of "D:" + "D1:".."D8:".
   306 = 0006			.def	DRIVE_WIN_ROW					= 6
   307 = 001E			.def	DRIVE_WIN_COL					= 30
   308 = 000C			.def	DRIVE_WIN_W						= 12		; cells wide  (border + "  Dn:  ")
   309 = 000D			.def	DRIVE_WIN_H						= 13		; rows        (border + title + 9 + border)
   310
   311 				; Quit-confirm popup (UI_Mode 5) - "Are you sure to Quit" + (Y/N), Selector only.
