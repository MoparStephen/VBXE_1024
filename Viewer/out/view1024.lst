   166 3400			.proc Check_SDX
   167 3400-3453> AD 00 07		lda $0700							; sparta_flag
   168 3403 C9 53			cmp #$53							; ASCII S = SpartaDOS (or BW-DOS)
   169 3405 D0 08			bne SDX_No
