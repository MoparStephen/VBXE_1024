   793 				;-----------------------------------------------------------------------------
   794 				; Image_Open - OPEN FileNamePtr for read on the first free IOCB (the same
   795 				; sequence LoadData uses, but the file stays open across several block reads).
   796 				;  Out: C=0 and Load_IOCB = IOCB offset, or C=1 (no IOCB / OPEN failed - the
   797 				;       IOCB is closed again so it doesn't leak).
   798 				;-----------------------------------------------------------------------------
   799 35A5			Image_Open
   800 35A5 20 2D 30			jsr Find_First_IOCB
   801 35A8 C0 01			cpy #$01
   802 35AA D0 28			bne Image_Open_Fail					; no free IOCB
   803 35AC 8E E2 04			stx Load_IOCB
   804 35AF A9 04			lda #CIO_read
   805 35B1 9D 4A 03			sta ICAX1,x
   806 35B4 A9 00			lda #$00
   807 35B6 9D 4B 03			sta ICAX2,x
   808 35B9 A9 03			lda #CIO_open
   809 35BB 9D 42 03			sta ICCOM,x
   810 35BE AD 28 31			lda FileNamePtr
   811 35C1 9D 44 03			sta ICBAL,x
   812 35C4 AD 29 31			lda FileNamePtr + $01
   813 35C7 9D 45 03			sta ICBAH,x
   814 35CA 20 56 E4			jsr CIOV
   815 35CD 30 02			bmi Image_Open_Close
   816 35CF 18				clc
   817 35D0 60				rts
   818 35D1			Image_Open_Close
   819 35D1 20 31 36			jsr Image_Close
   820 35D4			Image_Open_Fail
   821 35D4 38				sec
   822 35D5 60				rts
