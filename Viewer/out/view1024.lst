   472 4E03 9D 8D 04			sta Path_Buf,x
   473 4E06 E8				inx
   474 4E07 C8				iny
   475 4E08 C0 28			cpy #$28
   476 4E0A 90 F2			bcc Emit_Path_Prefix_L1
   477 4E0C			Emit_Path_Prefix_Done
   478 4E0C 60				rts
