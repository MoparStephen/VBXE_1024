   604 				;-----------------------------------------------------------------------------
   605 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner (pixel data,
   606 				; attribute map) into dedicated, resident VRAM - never touched by Load_Image,
   607 				; and never reloaded from disk again after this one call, since the banner
   608 				; never changes at runtime.  Blank-fills any banner target whose file is
   609 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   610 				; no asset file at all - it is always a fixed-colour blitter fill
   611 				; (Menu_Sep_Blank).  The banner's palette (registers 1-3) is no longer a disk
   612 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   613 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   614 				; Enter_Selector.
   615 				;-----------------------------------------------------------------------------
   616 3427			Load_Menu_Banner_Raw
   617 3427 A9 0D			lda #<Menu_Banner_Raw_Name
   618 3429 8D 28 31			sta FileNamePtr
   619 342C A9 37			lda #>Menu_Banner_Raw_Name
   620 342E 8D 29 31			sta FileNamePtr + $01
   621 3431 A9 30			lda #MENU_BANNER_BANK
   622 3433 85 8E			sta BankIndex
   623 3435 20 AA 30			jsr LoadData
   624 3438 AD 2D 31			lda LoadStatus
   625 343B D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   626 343D 20 B0 36			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   627
   628 3440			Load_Menu_Banner_Raw_Sep
   629 3440 20 D9 36			jsr Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   630
   631 3443			Load_Menu_Banner_Raw_Map
   632 				; Load the banner's .MAP into $14000 (CRAM_Buffer, shared scratch - fine,
   633 				; this is a one-time boot step) and expand it into MENU_BANNER_MAP_VRAM (its
   634 				; own resident copy, NOT the shared CRAM $017000 - see Setup_Menu_Cmap).
   635 3443 A9 02			lda #<Menu_Banner_Map_Name
   636 3445 8D 28 31			sta FileNamePtr
   637 3448 A9 37			lda #>Menu_Banner_Map_Name
   638 344A 8D 29 31			sta FileNamePtr + $01
   639 344D A9 14			lda #$14
   640 344F 85 8E			sta BankIndex
   641 3451 20 AA 30			jsr LoadData
   642 3454 AD 2D 31			lda LoadStatus
   643 3457 F0 03			beq Load_Menu_Banner_Raw_Done		; OPEN/load failed - leave MENU_BANNER_MAP_VRAM as-is
   644 3459 20 77 33			jsr Setup_Menu_Cmap
   645
   646 345C			Load_Menu_Banner_Raw_Done				; Apply_Menu_Banner_Palette isn't called here -
   647 345C 60				rts									; Enter_Selector always calls it before the first frame
   648
   649 				;-----------------------------------------------------------------------------
   650 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   651 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   652 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   653 				; for text).  Called once at boot (above) and from every Enter_Selector
   654 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   655 				; viewed in between and there is no way to avoid that hardware-register
   656 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   657 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
   658 				;-----------------------------------------------------------------------------
   659 345D			Apply_Menu_Banner_Palette
   660 345D A9 B4			lda #(MENU_BANNER_PAL_VRAM / $1000) | MEMAC_GLOBAL_ENABLE
   661 345F				vbsta VBXE_MA_BSEL
