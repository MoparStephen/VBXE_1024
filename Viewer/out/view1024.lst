   999 				; Attribute-cell byte offsets (within a 160-byte expanded map row) for the 8
  1000 				; columns the demo overlay covers - cell*4+3 (the real attribute byte; the
  1001 				; other 3 bytes/cell are always zero - the whole map is zeroed at boot by
  1002 				; clear_vbxe).  Left-edge block = cells 0-3 (pixels 0-31); right-edge block = cells
  1003 				; 36-39 (pixels 288-319, since MENU_BANNER_PITCH/8 = 40 cells/row).
  1004 3639			Menu_Demo_Attr_Cols
  1005 3639 03 07 0B 0F 93 97 + 	dta 3,7,11,15,147,151,155,159
  1006 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
  1007 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
  1008 				; copy reads as a flipped reflection of the left-hand one; the underlying
  1009 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
  1010 				; register each cell points at changes.
  1011 3641			Menu_Demo_Attr_Top_Vals
  1012 3641 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
  1013 				; Same column order: BL/BR pal ids (<<4), left edge then right edge (mirrored:
  1014 				; pal 3,2 instead of 2,3 - see note above).
  1015 3649			Menu_Demo_Attr_Bot_Vals
  1016 3649 20 20 30 30 30 30 + 	dta $20,$20,$30,$30,$30,$30,$20,$20
