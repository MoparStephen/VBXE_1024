   465 				;-----------------------------------------------------------------------------
   466 				; Reset_Handler - DOSINI points here once start has run.  The OS warm start
   467 				; (RESET key) calls it: let SDX do its own reinit through the saved DOSINI,
   468 				; then jump back into the viewer instead of returning to the OS (which would
   469 				; jmp (DOSVEC) to the SDX prompt with VBXE still showing the image).
   470 				; Resident because DOSINI is live for the program's whole run.
   471 				;-----------------------------------------------------------------------------
   472 3257			Reset_Handler
   473 3257 20 72 32			jsr Reset_Blank						; black before SDX's reinit gets going
   474 325A 20 6F 32			jsr Reset_Old_DOSINI				; SDX warm reinit (closes files, drivers)
   475 325D 20 72 32			jsr Reset_Blank						; ...and again - the reinit may have re-enabled them
   476 3260 A9 57			lda #<Reset_Handler
   477 3262 85 0C			sta DOSINI
   478 3264 A9 32			lda #>Reset_Handler
   479 3266 85 0D			sta DOSINI + 1						; re-arm, in case the reinit rewrote it
   480 3268 AE 84 04			ldx SP_REG_OLD
   481 326B 9A				txs									; abandon whatever was running
   482 326C 4C 54 34			jmp Reset_Reenter					; main segment - loaded long before DOSINI is hooked
   483 326F			Reset_Old_DOSINI
   484 326F 6C 87 04			jmp (DOSINIL_OLD)					; DOSINIL_OLD/H = $487/$488, a word vector
   485
   486 				; Reset_Blank - ANTIC DMA off now (DMACTL, not just the shadow) and the VBXE
   487 				; XDL off, so nothing shows until Enter_Selector's Display_On.
   488 3272			Reset_Blank
   489 3272 A9 00			lda #$00
   490 3274 8D 2F 02			sta SDMCTL							; shadow - stops the VBI turning it back on
   491 3277 8D 00 D4			sta DMACTL							; hardware - off this frame, not next VBI
   492 327A A9 02			lda #%00000010						; XDL off, XCOLOR on (= Display_Off)
   493 327C				vbsta VBXE_VIDEO_CONTROL
