   541 				; Selector screen
   542 				;=============================================================================
   543
   544 				;-----------------------------------------------------------------------------
   545 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   546 				; menu palettes back ONLY if an image replaced them (Pal_Image - after Info,
   547 				; Drive, Quit or a directory P-preview the registers are already right), then
   548 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   549 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   550 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   551 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   552 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   553 				; always returns.
   554 				;-----------------------------------------------------------------------------
   555 5310			Enter_Selector
   556 5310 A9 00			lda #$00							; forget the image view's key-5 / 0-3 / P state.
   557 5312 8D F5 04			sta Map_View						; XDL_Image_Attribute's source is NOT reset here -
   558 5315 8D F6 04			sta View_Normal						; it may still be on screen (a stale image would
   559 5318 8D F7 04			sta Preview_From_Image				; flash); View_Selected resets it, unseen
   560 531B A9 00			lda #$00
   561 531D 8D C6 04			sta UI_Mode
   562 5320 20 AF 53			jsr Selector_Draw					; back buffer only - nothing visible yet
   563 5323 AD E7 04			lda Pal_Image
   564 5326 F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   565 5328 20 AE 34			jsr Display_Off						; blank while the registers are rewritten
   566 532B 20 06 36			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   567 532E 20 9A 3D			jsr Text_Present
   568 5331 20 78 3D			jsr Text_Activate
   569 5334 4C B8 34			jmp Display_On						; (tail)
   570 5337			Enter_Selector_Show
   571 5337 20 9A 3D			jsr Text_Present					; the finished screen, in one blit
   572 533A 4C 78 3D			jmp Text_Activate					; (tail) a pure XDL swap
   573
   574 				;-----------------------------------------------------------------------------
   575 				; UI_Build_TextPalette - the standard Atari 256-colour master (NTSC $00200 /
   576 				; PAL $00500, per Video_Flag) has its entries 0-127 in hues 0-7 only (no
   577 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   578 				; De-interleave it so:
   579 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   580 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   581 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   582 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   583 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   584 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   585 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   586 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   587 				;-----------------------------------------------------------------------------
   588 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   589
   590 533D			UI_Build_TextPalette
   591 533D A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   592 533F				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 533F A0 5F			ldy #<VBXE_MA_BSEL
     3 5341 91 93			sta (VBXEBase),y
Source: ui.asm
