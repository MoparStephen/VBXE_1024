   203 3400			.proc Check_RAMTOP
   204 				; Disable BASIC
   205 3400-34A8> A9 C0			lda #$C0							; Check if RAMTOP is already OK
   206 3402 C5 6A			cmp RAMTOP							; Prevent flickering if BASIC is already off
   207 3404 F0 38			beq Ram_Ok
   208
   209 3406 A9 01			lda #$01							; Set BASICF for OS
   210 3408 8D F8 03			sta BASICF							; So BASIC remains OFF after RESET
   211
   212 340B AD 01 D3			lda PORTB							; Disable BASIC bit in PORTB for MMU
   213 340E 09 02			ora #$02							; By Setting bit 2
   214 3410 8D 01 D3			sta PORTB
   215
   216 3413 AD 00 A0			lda $A000							; Check if BASIC ROM area is now RAM
   217 3416 EE 00 A0			inc $A000							; This will also catch SDX not launching
   218 3419 CD 00 A0			cmp $A000							; The app via X
   219 341C F0 21			beq Ram_Not_Ok						; If not, perform print error and exit
   220
   221 341E A9 0C			lda #$0C							; 12 = CLOSE
   222 3420 20 2E 34			jsr Do_CIOV							; Close editor
   223
   224 3423 A9 C0			lda #$C0
