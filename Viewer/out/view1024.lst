  1519 				;-----------------------------------------------------------------------------
  1520 				; Sort_Range - in-place alphabetical selection sort of the records
  1521 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1522 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1523 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1524 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1525 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1526 				;-----------------------------------------------------------------------------
  1527 3948			Sort_Range
  1528 3948 E0 02			cpx #$02
  1529 394A 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1530 394C 85 81			sta Reg2							; Reg2 = i = start
  1531 394E 86 82			stx Reg3							; Reg3 = count (temp)
  1532 3950 18				clc
  1533 3951 65 82			adc Reg3
  1534 3953 85 84			sta Reg5							; Reg5 = end = start + count
  1535 3955 38				sec
  1536 3956 E9 01			sbc #$01
  1537 3958 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1538
  1539 395A A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1540 395C				vbsta VBXE_MA_BSEL
