   107 				; Copy 2048 bytes (Ptr_Lo/Hi) -> (Reg1/Reg2), 8 pages.
   108 39DD			Text_Copy_2K
   109 39DD A2 08			ldx #$08
   110 39DF A0 00			ldy #$00
   111 39E1			Text_Copy_2K_L1
   112 39E1 B1 88			lda (Ptr_Lo),y
   113 39E3 91 80			sta (Reg1),y
   114 39E5 C8				iny
