   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 3D64			Text_Window_Frame_Chars
   504 3D64 C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 3D6D DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 3D76			Text_Window_Frame
   508 3D76 A5 80			lda Reg1
   509 3D78 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 3D7A AD B1 06			lda Txt_Col
   511 3D7D 85 87			sta Reg8							; Reg8 = left column
   512 3D7F AD B0 06			lda Txt_Row
   513 3D82 18				clc
   514 3D83 65 81			adc Reg2
   515 3D85 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 3D87 AD B0 06			lda Txt_Row
   517 3D8A 85 84			sta Reg5							; Reg5 = current screen row
   518 3D8C AE B5 06			ldx Txt_FrameStyle
   519 3D8F 20 AE 3D			jsr Text_Window_Frame_Row			; top edge
   520 3D92			Text_Window_Frame_Mid
   521 3D92 E6 84			inc Reg5
   522 3D94 A5 84			lda Reg5
   523 3D96 C5 85			cmp Reg6
   524 3D98 B0 0D			bcs Text_Window_Frame_Bottom
   525 3D9A AD B5 06			lda Txt_FrameStyle
   526 3D9D 18				clc
   527 3D9E 69 03			adc #$03
   528 3DA0 AA				tax
   529 3DA1 20 AE 3D			jsr Text_Window_Frame_Row			; interior row
   530 3DA4 4C 92 3D			jmp Text_Window_Frame_Mid
   531 3DA7			Text_Window_Frame_Bottom
   532 3DA7 AD B5 06			lda Txt_FrameStyle
   533 3DAA 18				clc
   534 3DAB 69 06			adc #$06
   535 3DAD AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 3DAE			Text_Window_Frame_Row
   540 3DAE BD 64 3D			lda Text_Window_Frame_Chars,x
   541 3DB1 8D 80 06			sta Txt_Line+0
   542 3DB4 BD 65 3D			lda Text_Window_Frame_Chars+1,x
   543 3DB7 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 3DB9 BD 66 3D			lda Text_Window_Frame_Chars+2,x
   545 3DBC 85 82			sta Reg3							; Reg3 = right char
   546 3DBE A2 01			ldx #$01
   547 3DC0			Text_Window_Frame_Row_L1
   548 3DC0 E4 86			cpx Reg7
   549 3DC2 B0 08			bcs Text_Window_Frame_Row_End
   550 3DC4 A5 83			lda Reg4
   551 3DC6 9D 80 06			sta Txt_Line,x
   552 3DC9 E8				inx
   553 3DCA D0 F4			bne Text_Window_Frame_Row_L1
   554 3DCC			Text_Window_Frame_Row_End
   555 3DCC A5 82			lda Reg3
   556 3DCE 9D 80 06			sta Txt_Line,x
   557 3DD1 E8				inx
   558 3DD2			Text_Window_Frame_PutRow
   559 3DD2 A9 00			lda #$00
   560 3DD4 9D 80 06			sta Txt_Line,x
   561 3DD7 A5 84			lda Reg5
   562 3DD9 8D B0 06			sta Txt_Row
   563 3DDC A5 87			lda Reg8
   564 3DDE 8D B1 06			sta Txt_Col
   565 3DE1 A9 80			lda #<Txt_Line
   566 3DE3 85 96			sta Txt_Ptr
   567 3DE5 A9 06			lda #>Txt_Line
   568 3DE7 85 97			sta Txt_Ptr + $01
   569 3DE9 4C EC 3D			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 3DEC			Text_PutStrAt
   583 3DEC A9 01			lda #$01
   584 3DEE 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 3DF1 A9 00			lda #$00
   587 3DF3 85 80			sta Reg1
   588 3DF5 85 81			sta Reg2
   589 3DF7 AE B0 06			ldx Txt_Row
   590 3DFA F0 0E			beq Text_PutStrAt_Col
   591 3DFC			Text_PutStrAt_RowL
   592 3DFC A5 80			lda Reg1
   593 3DFE 18				clc
   594 3DFF 69 A0			adc #TEXT_PITCH
   595 3E01 85 80			sta Reg1
   596 3E03 90 02			bcc Text_PutStrAt_RowNC
   597 3E05 E6 81			inc Reg2
   598 3E07			Text_PutStrAt_RowNC
   599 3E07 CA				dex
   600 3E08 D0 F2			bne Text_PutStrAt_RowL
   601 3E0A			Text_PutStrAt_Col
   602 3E0A AD B1 06			lda Txt_Col
   603 3E0D 0A				asl									; Txt_Col * 2 (max 158)
   604 3E0E 18				clc
   605 3E0F 65 80			adc Reg1
   606 3E11 85 80			sta Reg1
   607 3E13 90 02			bcc Text_PutStrAt_ColNC
   608 3E15 E6 81			inc Reg2
   609 3E17			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 3E17 A5 81			lda Reg2
   612 3E19 29 10			and #$10							; offset bit 12 = "second bank"
   613 3E1B F0 04			beq Text_PutStrAt_Bank0
   614 3E1D A9 2B			lda #TEXT_BACK_BANK+1
   615 3E1F D0 02			bne Text_PutStrAt_SetBank
   616 3E21			Text_PutStrAt_Bank0
   617 3E21 A9 2A			lda #TEXT_BACK_BANK
   618 3E23			Text_PutStrAt_SetBank
   619 3E23 8D B6 06			sta Txt_Bank
   620 3E26 A5 80			lda Reg1
   621 3E28 85 88			sta Ptr_Lo
   622 3E2A A5 81			lda Reg2
   623 3E2C 29 0F			and #$0F
   624 3E2E 18				clc
   625 3E2F 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 3E31 85 89			sta Ptr_Hi
   627 3E33 AD B6 06			lda Txt_Bank
   628 3E36 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 3E38				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E38 A0 5F			ldy #<VBXE_MA_BSEL
     3 3E3A 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 3E3C A9 00			lda #$00
   632 3E3E 85 82			sta Reg3							; Reg3 = source string index
   633 3E40 AD B1 06			lda Txt_Col
   634 3E43 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 3E45			Text_PutStrAt_Char
   636 3E45 A5 83			lda Reg4
   637 3E47 C9 50			cmp #TEXT_COLS
   638 3E49 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 3E4B A4 82			ldy Reg3
   640 3E4D B1 96			lda (Txt_Ptr),y
   641 3E4F F0 43			beq Text_PutStrAt_Done
   642 3E51 C9 01			cmp #TXT_PEN
   643 3E53 D0 0C			bne Text_PutStrAt_Glyph
   644 3E55 C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 3E56 B1 96			lda (Txt_Ptr),y
   646 3E58 8D B4 06			sta Txt_Attr
   647 3E5B C8				iny
   648 3E5C 84 82			sty Reg3							; skip both bytes, column unchanged
   649 3E5E 4C 45 3E			jmp Text_PutStrAt_Char
   650 3E61			Text_PutStrAt_Glyph
   651 3E61 A0 00			ldy #$00
   652 3E63 91 88			sta (Ptr_Lo),y						; glyph byte
   653 3E65 C8				iny
   654 3E66 AD B4 06			lda Txt_Attr
   655 3E69 91 88			sta (Ptr_Lo),y						; attribute byte
   656 3E6B E6 82			inc Reg3
   657 3E6D E6 83			inc Reg4
   658 3E6F A5 88			lda Ptr_Lo							; window pointer += 2
   659 3E71 18				clc
   660 3E72 69 02			adc #$02
   661 3E74 85 88			sta Ptr_Lo
   662 3E76 90 02			bcc Text_PutStrAt_NoPage
   663 3E78 E6 89			inc Ptr_Hi
   664 3E7A			Text_PutStrAt_NoPage
   665 3E7A A5 89			lda Ptr_Hi
   666 3E7C C9 30			cmp #$30							; crossed out of the window -> next bank
   667 3E7E 90 C5			bcc Text_PutStrAt_Char
   668 3E80 38				sec
   669 3E81 E9 10			sbc #$10
   670 3E83 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 3E85 EE B6 06			inc Txt_Bank
   672 3E88 AD B6 06			lda Txt_Bank
   673 3E8B 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 3E8D				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3E8D A0 5F			ldy #<VBXE_MA_BSEL
     3 3E8F 91 93			sta (VBXEBase),y
