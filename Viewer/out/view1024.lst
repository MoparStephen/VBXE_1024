  2453 5CD7			Path_Pop_L1
  2454 5CD7 E0 00			cpx #$00
  2455 5CD9 F0 09			beq Path_Pop_Cut
  2456 5CDB CA				dex
  2457 5CDC BD 28 06			lda Scan_Path,x
  2458 5CDF C9 3E			cmp #'>'
  2459 5CE1 D0 F4			bne Path_Pop_L1
  2460 5CE3 E8				inx									; keep this separator
  2461 5CE4			Path_Pop_Cut
  2462 5CE4 A9 00			lda #$00
  2463 5CE6 9D 28 06			sta Scan_Path,x
  2464 5CE9			Path_Pop_Done
  2465 5CE9 60				rts
