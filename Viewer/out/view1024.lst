   910 				;-----------------------------------------------------------------------------
   911 				; Nfo_Name_Emit - the slot Nfo_Name_MapSlot just mapped (at Ptr_Lo/Hi) in.
   912 				; Leaves Path_Buf[0..NFO_NAME_CAP-1] = the name (or all spaces if the slot
   913 				; byte 0 is < $21, i.e. "no name") + Path_Buf[NFO_NAME_CAP] = $00.  Window
   914 				; unmapped on return.
   915 				;-----------------------------------------------------------------------------
   916 52F9			Nfo_Name_Emit
   917 52F9 A0 00			ldy #$00
   918 52FB B1 88			lda (Ptr_Lo),y
   919 52FD C9 21			cmp #$21
   920 52FF 90 0E			bcc Nfo_Name_Emit_Pad				; $00 -> all spaces
   921 5301			Nfo_Name_Emit_Copy
   922 5301 B1 88			lda (Ptr_Lo),y
   923 5303 F0 0A			beq Nfo_Name_Emit_Pad
   924 5305 99 8D 04			sta Path_Buf,y
   925 5308 C8				iny
   926 5309 C0 30			cpy #NFO_NAME_CAP
   927 530B 90 F4			bcc Nfo_Name_Emit_Copy
   928 530D B0 0C			bcs Nfo_Name_Emit_Term
   929 530F			Nfo_Name_Emit_Pad
   930 530F A9 20			lda #$20
   931 5311			Nfo_Name_Emit_PadL
   932 5311 C0 30			cpy #NFO_NAME_CAP
   933 5313 B0 06			bcs Nfo_Name_Emit_Term
   934 5315 99 8D 04			sta Path_Buf,y
   935 5318 C8				iny
   936 5319 D0 F6			bne Nfo_Name_Emit_PadL				; always (Y < NFO_NAME_CAP)
   937 531B			Nfo_Name_Emit_Term
   938 531B A9 00			lda #$00
   939 531D 8D BD 04			sta Path_Buf + NFO_NAME_CAP
   940 5320 A9 00			lda #MEMAC_GLOBAL_DISABLE
   941 5322				vbsta VBXE_MA_BSEL
