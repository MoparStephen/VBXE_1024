   163 				;-----------------------------------------------------------------------------
   164 				; Text_SetPen - A = foreground palette entry (0-127),
   165 				;               X = background: 0 = transparent, non-zero = opaque.
   166 				;-----------------------------------------------------------------------------
   167 3A31			Text_SetPen
   168 3A31 8D B2 06			sta Txt_Fg
