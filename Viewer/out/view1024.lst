   760 34BA F0 09			beq Image_Read_Segment_OK			; no partial chunk
   761 34BC AD E5 04			lda Seg_Tail
   762 34BF AC E6 04			ldy Seg_Tail + $01
   763 34C2 4C C7 34			jmp Image_Read_Chunk
   764
   765 34C5			Image_Read_Segment_OK
   766 34C5 18				clc
   767 34C6			Image_Read_Segment_Done
   768 34C6 60				rts
