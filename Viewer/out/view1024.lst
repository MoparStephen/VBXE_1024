   609 				;-----------------------------------------------------------------------------
   610 				; Load_Image
   611 				; File_Index must be set before calling this!  No range checking is done!
   612 				; One OPEN of D:<name>.V1K, three sequential block reads:
   613 				;   .PAL block -> $21000, pushed to palette registers 0-3
   614 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   615 				;   .RAW block -> $01000 framebuffer
   616 				; A missing or short file stops at the failing block and closes the IOCB.
   617 				;-----------------------------------------------------------------------------
   618 340E			Load_Image
   619 340E A9 00			lda #$00							; ext 0 = .V1K
   620 3410 20 28 39			jsr Build_Filename
   621 3413 20 62 34			jsr Image_Open
   622 3416 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   623
   624 3418 20 51 34			jsr Image_Read_Pal
   625 341B B0 2A			bcs Load_Image_Close
   626 341D 20 D3 33			jsr Apply_Image_Palette
   627
   628 3420 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   629 3422 A2 02			ldx #V1K_MAP_LEN / $1000
   630 3424 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   631 3426 8C E5 04			sty Seg_Tail
   632 3429 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   633 342B 8C E6 04			sty Seg_Tail + $01
   634 342E 20 93 34			jsr Image_Read_Segment
   635 3431 B0 14			bcs Load_Image_Close
   636 3433 20 54 33			jsr Setup_Cmap1						; Expand the data out to $17000
   637
   638 3436 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   639 3438 A2 12			ldx #V1K_RAW_LEN / $1000
   640 343A A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   641 343C 8C E5 04			sty Seg_Tail
   642 343F A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   643 3441 8C E6 04			sty Seg_Tail + $01
   644 3444 20 93 34			jsr Image_Read_Segment
   645
   646 3447			Load_Image_Close
   647 3447 20 EE 34			jsr Image_Close
   648
   649 344A			Load_Image_Done
   650 344A A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   651 344C				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 344C A0 5F			ldy #<VBXE_MA_BSEL
     3 344E 91 93			sta (VBXEBase),y
Source: view1024.asm
   652
   653 3450 60				rts
