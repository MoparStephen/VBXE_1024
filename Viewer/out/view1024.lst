   946 5326 20 2D 30			jsr Find_First_IOCB
   947 5329 C0 01			cpy #$01
   948 532B D0 7D			bne Nfo_Name_LoadManifest_Done		; no free IOCB
   949 532D 8E C5 04			stx Dir_IOCB
   950 5330 A9 04			lda #CIO_read						; AUX1 = 4 : plain file, read
   951 5332 9D 4A 03			sta ICAX1,x
   952 5335 A9 00			lda #$00
   953 5337 9D 4B 03			sta ICAX2,x
   954 533A A9 50			lda #<Scan_Spec
   955 533C 9D 44 03			sta ICBAL,x
   956 533F A9 06			lda #>Scan_Spec
   957 5341 9D 45 03			sta ICBAH,x
   958 5344 A9 03			lda #CIO_open
   959 5346 9D 42 03			sta ICCOM,x
   960 5349 20 56 E4			jsr CIOV
   961 534C 30 5C			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
   962
   963 534E			Nfo_Name_LoadManifest_Line
   964 534E AE C5 04			ldx Dir_IOCB
   965 5351 A9 05			lda #CIO_gettext
   966 5353 9D 42 03			sta ICCOM,x
   967 5356 A9 50			lda #<Nfo_Name_Line
   968 5358 9D 44 03			sta ICBAL,x
   969 535B A9 06			lda #>Nfo_Name_Line
   970 535D 9D 45 03			sta ICBAH,x
   971 5360 A9 54			lda #8+NFO_NAME_CAP+1				; buffer length (8 key + 75 desc + $9B = 84)
   972 5362 9D 48 03			sta ICBLL,x
   973 5365 A9 00			lda #$00
   974 5367 9D 49 03			sta ICBLH,x
   975 536A 20 56 E4			jsr CIOV
   976 536D 10 04			bpl Nfo_Name_LoadManifest_Got
   977 536F C0 89			cpy #$89							; 137 = record over 84 bytes: CIO kept the first 84
   978 5371 D0 2C			bne Nfo_Name_LoadManifest_Close		; EOF / real error -> stop
   979 5373			Nfo_Name_LoadManifest_Got				; (a long record is cut to NFO_NAME_CAP below, not dropped)
   980
   981 5373 20 AB 53			jsr Nfo_Name_Match					; key = Nfo_Name_Line[0..7]  -> A = ordinal
   982 5376 B0 D6			bcs Nfo_Name_LoadManifest_Line		; no matching *.V1K row - drop the line
   983 5378 8D E1 04			sta Nfo_Name_Ord
   984 537B 20 CF 52			jsr Nfo_Name_MapSlot				; Ptr_Lo/Hi -> slot, bank $2A..$2D mapped
   985 537E A0 00			ldy #$00
   986 5380			Nfo_Name_LoadManifest_Copy
   987 5380 B9 58 06			lda Nfo_Name_Line + 8,y
   988 5383 C9 9B			cmp #$9B
   989 5385 F0 0B			beq Nfo_Name_LoadManifest_CopyEnd	; end of record
   990 5387 C9 20			cmp #$20
   991 5389 90 07			bcc Nfo_Name_LoadManifest_CopyEnd	; NUL / control -> stop
   992 538B 91 88			sta (Ptr_Lo),y
   993 538D C8				iny
   994 538E C0 4B			cpy #NFO_NAME_CAP
   995 5390 90 EE			bcc Nfo_Name_LoadManifest_Copy
   996 5392			Nfo_Name_LoadManifest_CopyEnd
   997 5392 A9 00			lda #$00
   998 5394 91 88			sta (Ptr_Lo),y						; NUL-terminate (Y may be 0 -> "no name")
   999 5396 A9 00			lda #MEMAC_GLOBAL_DISABLE
