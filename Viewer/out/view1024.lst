   439 				;-----------------------------------------------------------------------------
   440 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   441 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   442 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   443 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   444 				;  Returns A = $01 if a name was written, $00 if not.
   445 				;-----------------------------------------------------------------------------
   446 4FEC			Parse_Dir_Line
   447 4FEC A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   448 4FEE			Parse_Skip_L1							; Skip leading spaces / protect flag
   449 4FEE BD 00 06			lda Dir_Line_Buf,x
   450 4FF1 C9 9B			cmp #$9B
   451 4FF3 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   452 4FF5 C9 20			cmp #' '
   453 4FF7 F0 04			beq Parse_Skip_Next
   454 4FF9 C9 2A			cmp #'*'
   455 4FFB D0 07			bne Parse_Skip_Done
   456 4FFD			Parse_Skip_Next
   457 4FFD E8				inx
   458 4FFE E0 28			cpx #Dir_Line_Len
   459 5000 90 EC			bcc Parse_Skip_L1
   460 5002 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   461 5004			Parse_Skip_Done
   462 5004 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   463 5006 A9 00			lda #$00
   464 5008 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   465
   466 500A			Parse_Copy_L1
   467 500A BD 00 06			lda Dir_Line_Buf,x
   468 500D C9 9B			cmp #$9B
   469 500F F0 24			beq Parse_Copy_Done
   470 5011 C9 20			cmp #' '
   471 5013 F0 20			beq Parse_Copy_Done
   472 5015 C9 2E			cmp #'.'
   473 5017 F0 1C			beq Parse_Copy_Done
   474 5019 C9 30			cmp #'0'
   475 501B 90 07			bcc Parse_Copy_Is_Name_Char
   476 501D C9 3A			cmp #'9'+1
   477 501F B0 03			bcs Parse_Copy_Is_Name_Char
   478 5021 4C 26 50			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   479 5024			Parse_Copy_Is_Name_Char
   480 5024 E6 80			inc Reg1
   481 5026			Parse_Copy_Store
   482 5026 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   483 5028 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   484 502A BD 00 06			lda Dir_Line_Buf,x
   485 502D 91 8A			sta (Name_Ptr),y
   486 502F C8				iny
   487 5030			Parse_Copy_Next
   488 5030 E8				inx
   489 5031 E0 28			cpx #Dir_Line_Len
   490 5033 90 D5			bcc Parse_Copy_L1
   491
   492 5035			Parse_Copy_Done
   493 5035 A5 80			lda Reg1
   494 5037 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   495
   496 5039			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   497 5039 C0 08			cpy #$08
   498 503B B0 07			bcs Parse_Dir_Line_Accept
   499 503D A9 20			lda #' '
   500 503F 91 8A			sta (Name_Ptr),y
   501 5041 C8				iny
   502 5042 D0 F5			bne Parse_Pad_L1
   503
   504 5044			Parse_Dir_Line_Accept
   505 5044 A9 01			lda #$01							; Non-zero - a name was stored
   506 5046 60				rts
   507 5047			Parse_Dir_Line_Reject
   508 5047 A9 00			lda #$00
   509 5049 60				rts
   510
   511 				;-----------------------------------------------------------------------------
   512 				; Emit_Path_Prefix - Path_Buf = "D[n]:" + Scan_Path.  Returns X = next index.
   513 				; Called by Build_Filename (view1024.asm) before it appends base + "." + ext.
   514 				;-----------------------------------------------------------------------------
   515 504A			Emit_Path_Prefix
   516 504A A2 00			ldx #$00
   517 504C A9 44			lda #'D'
   518 504E 9D 8D 04			sta Path_Buf,x
   519 5051 E8				inx
   520 5052 AD CC 04			lda Scan_Drive
   521 5055 F0 04			beq Emit_Path_Prefix_Colon
   522 5057 9D 8D 04			sta Path_Buf,x
   523 505A E8				inx
   524 505B			Emit_Path_Prefix_Colon
   525 505B A9 3A			lda #':'
   526 505D 9D 8D 04			sta Path_Buf,x
   527 5060 E8				inx
   528 5061 A0 00			ldy #$00
   529 5063			Emit_Path_Prefix_L1
   530 5063 B9 28 06			lda Scan_Path,y
   531 5066 F0 09			beq Emit_Path_Prefix_Done
   532 5068 9D 8D 04			sta Path_Buf,x
   533 506B E8				inx
   534 506C C8				iny
   535 506D C0 28			cpy #$28
   536 506F 90 F2			bcc Emit_Path_Prefix_L1
   537 5071			Emit_Path_Prefix_Done
   538 5071 60				rts
