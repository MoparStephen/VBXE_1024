  2872 6271 E8				inx
  2873 6272 E0 28			cpx #$28
  2874 6274 90 F6			bcc Path_Save_End
  2875 6276			Path_Save_Found							; X = index of the NUL
  2876 6276 E0 00			cpx #$00
  2877 6278 F0 20			beq Path_Save_Done					; empty path
  2878 627A CA				dex									; step onto the trailing '>'
  2879 627B			Path_Save_Back
