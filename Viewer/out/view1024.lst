  1447 				; Build_Filename
  1448 				;  In:  A          = 0 -> .V1K, 1 -> .NFO
  1449 				;       File_Index = image ordinal
  1450 				;  Out: FileNamePtr -> Path_Buf holding
  1451 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1452 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1453 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1454 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1455 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1456 				;-----------------------------------------------------------------------------
