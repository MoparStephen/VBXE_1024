   379 				;-----------------------------------------------------------------------------
   380 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   381 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   382 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   383 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   384 				;  Returns A = $01 if a name was written, $00 if not.
   385 				;-----------------------------------------------------------------------------
   386 4CB8			Parse_Dir_Line
   387 4CB8 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   388 4CBA			Parse_Skip_L1							; Skip leading spaces / protect flag
   389 4CBA BD 00 06			lda Dir_Line_Buf,x
   390 4CBD C9 9B			cmp #$9B
   391 4CBF F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   392 4CC1 C9 20			cmp #' '
   393 4CC3 F0 04			beq Parse_Skip_Next
   394 4CC5 C9 2A			cmp #'*'
   395 4CC7 D0 07			bne Parse_Skip_Done
   396 4CC9			Parse_Skip_Next
   397 4CC9 E8				inx
   398 4CCA E0 28			cpx #Dir_Line_Len
   399 4CCC 90 EC			bcc Parse_Skip_L1
   400 4CCE B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   401 4CD0			Parse_Skip_Done
   402 4CD0 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   403 4CD2 A9 00			lda #$00
   404 4CD4 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   405
   406 4CD6			Parse_Copy_L1
   407 4CD6 BD 00 06			lda Dir_Line_Buf,x
   408 4CD9 C9 9B			cmp #$9B
   409 4CDB F0 24			beq Parse_Copy_Done
   410 4CDD C9 20			cmp #' '
   411 4CDF F0 20			beq Parse_Copy_Done
   412 4CE1 C9 2E			cmp #'.'
   413 4CE3 F0 1C			beq Parse_Copy_Done
   414 4CE5 C9 30			cmp #'0'
   415 4CE7 90 07			bcc Parse_Copy_Is_Name_Char
   416 4CE9 C9 3A			cmp #'9'+1
   417 4CEB B0 03			bcs Parse_Copy_Is_Name_Char
   418 4CED 4C F2 4C			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   419 4CF0			Parse_Copy_Is_Name_Char
   420 4CF0 E6 80			inc Reg1
   421 4CF2			Parse_Copy_Store
   422 4CF2 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   423 4CF4 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   424 4CF6 BD 00 06			lda Dir_Line_Buf,x
   425 4CF9 91 8A			sta (Name_Ptr),y
   426 4CFB C8				iny
   427 4CFC			Parse_Copy_Next
   428 4CFC E8				inx
   429 4CFD E0 28			cpx #Dir_Line_Len
   430 4CFF 90 D5			bcc Parse_Copy_L1
   431
   432 4D01			Parse_Copy_Done
   433 4D01 A5 80			lda Reg1
   434 4D03 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   435
   436 4D05			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   437 4D05 C0 08			cpy #$08
   438 4D07 B0 07			bcs Parse_Dir_Line_Accept
   439 4D09 A9 20			lda #' '
   440 4D0B 91 8A			sta (Name_Ptr),y
   441 4D0D C8				iny
   442 4D0E D0 F5			bne Parse_Pad_L1
   443
   444 4D10			Parse_Dir_Line_Accept
   445 4D10 A9 01			lda #$01							; Non-zero - a name was stored
   446 4D12 60				rts
   447 4D13			Parse_Dir_Line_Reject
   448 4D13 A9 00			lda #$00
   449 4D15 60				rts
