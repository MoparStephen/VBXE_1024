  1607 				;-----------------------------------------------------------------------------
  1608 				; Sort_Range - in-place alphabetical selection sort of the records
  1609 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1610 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1611 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1612 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1613 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1614 				;-----------------------------------------------------------------------------
  1615 39DF			Sort_Range
  1616 39DF E0 02			cpx #$02
  1617 39E1 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1618 39E3 85 81			sta Reg2							; Reg2 = i = start
  1619 39E5 86 82			stx Reg3							; Reg3 = count (temp)
  1620 39E7 18				clc
  1621 39E8 65 82			adc Reg3
  1622 39EA 85 84			sta Reg5							; Reg5 = end = start + count
  1623 39EC 38				sec
  1624 39ED E9 01			sbc #$01
  1625 39EF 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1626
  1627 39F1 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1628 39F3				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 39F3 A0 5F			ldy #<VBXE_MA_BSEL
     3 39F5 91 93			sta (VBXEBase),y
Source: view1024.asm
