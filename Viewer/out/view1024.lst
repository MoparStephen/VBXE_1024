Source: bcbs.asm
     1 				; Clear 496kB (leave bottom 16kB for the SVBXE.SYS driver)
     2 				; 496x16 zoom 8x8 clear blit (this takes 2 frames)
     3 2100			BLT_CLEAR
     4 2100-21FA> 00 00 00		dta $00,$00,$00						; Source address
     5 2103 00 00			dta $00,$00							; Source step y
     6 2105 00				dta $00								; Source step x
     7 2106 FF BF 07			dta $FF,$BF,$07						; Destination address
     8 2109 80 F0			dta a(-$0F80)						; Destination step y (backwards 3968 bytes) - NOTE: this equals 496 * zoom factor of 8
     9 210B FF				dta -$01							; Destination step x (backwards	1 byte)
    10 210C EF 01			dta $EF,$01							; Width-1  (495)	496 * 8 bytes wide
    11 210E 0F				dta $0F								; Height-1 (15)		 16 * 8 bytes high
    12 210F 00				dta $00								; And mask (And mask equal to 0 so clear)
    13 2110 00				dta $00								; Xor mask (will be filled with xor mask)
    14 2111 00				dta $00								; Collision and mask
    15 2112 77				dta $77								; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
    16 2113 00				dta $00								; Pattern feature
    17 2114 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    18
    19 				; Copy 9600 attrib bytes from $14000, placing each at every 4th dest byte from $17003
    20 				; 40 cells/row * 240 rows = 9600 bytes; dest stride 4 writes to $17003,$17007,$1700B...
    21 				; The 3 zero bytes before each data byte are left intact from BLT_SETUP_CMAP_1
    22 2115			BLT_SETUP_CMAP_1
    23 2115 00 40 01			dta $00,$40,$01						; Source address ($14000)
    24 2118 28 00			dta $28,$00							; Source step y = 40 (advance to next row: 40 cells * 1 byte)
    25 211A 01				dta $01								; Source step x (1)
    26 211B 03 70 01			dta $03,$70,$01						; Destination address ($17003)
    27 211E A0 00			dta $A0,$00							; Destination step y = 160 (advance to next row: 40 cells * 4 bytes)
    28 2120 04				dta $04								; Destination step x (4)
    29 2121 27 00			dta $27,$00							; Width-1 = 39   (40 cells/row)
    30 2123 EF				dta $EF								; Height-1 = 239 (240 rows; 40*240 = 9600)
    31 2124 FF				dta $FF								; And mask ($FF - pass-through, copies zero values too)
    32 2125 00				dta $00								; Xor mask (no inversion)
    33 2126 00				dta $00								; Collision mask
    34 2127 00				dta $00								; Zoom
    35 2128 00				dta $00								; Pattern feature
    36
    37 				; Same expansion as BLT_SETUP_CMAP_1, but for the menu banner: 40 cells/row *
    38 				; MENU_BANNER_ROWS(36) rows = 1440 source bytes, dest stride 4 starting at
    39 				; MENU_BANNER_MAP_VRAM+3 - a dedicated, resident copy (NOT the shared CRAM
    40 				; $017000), so the banner's attribute map never needs to be reloaded.  Kicked
    41 				; once, at boot, by Setup_Menu_Cmap.
    42 2129			BLT_SETUP_MENU_CMAP
    43 2129 00 40 01			dta $00,$40,$01						; Source address ($14000 = CRAM_Buffer, reused as scratch)
    44 212C 28 00			dta $28,$00							; Source step y = 40
    45 212E 01				dta $01								; Source step x (1)
    46 212F 03 50 03			dta <[MENU_BANNER_MAP_VRAM+3], >[MENU_BANNER_MAP_VRAM+3], [MENU_BANNER_MAP_VRAM+3]>>16	; Destination address
    47 2132 A0 00			dta $A0,$00							; Destination step y = 160 (40 cells * 4 bytes)
    48 2134 04				dta $04								; Destination step x (4)
    49 2135 27 00			dta $27,$00							; Width-1 = 39   (40 cells/row)
    50 2137 23				dta MENU_BANNER_ROWS-1				; Height-1 = 35  (36 rows; 40*36 = 1440)
    51 2138 FF				dta $FF								; And mask ($FF - pass-through, copies zero values too)
    52 2139 00				dta $00								; Xor mask (no inversion)
    53 213A 00				dta $00								; Collision mask
    54 213B 00				dta $00								; Zoom
    55 213C 00				dta $00								; Pattern feature
    56 213D 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    57
    58 				; Clears the screen RAM and CMAP data ($01000 - $21FFF or 128kB)
    59 213E			BLT_CLEAR_SCREEN
    60 213E 00 00 00			dta $00,$00,$00						; Source address
    61 2141 00 00			dta $00,$00							; Source step y
    62 2143 00				dta $00								; Source step x
    63 2144 00 10 00			dta $00,$10,$00						; Destination address
    64 2147 00 04			dta $00,$04							; Destination step y (1024 bytes) - NOTE: this equals 128 * zoom factor of 8
    65 2149 01				dta $01								; Destination step x (1 byte) - NOTE: this equals 1 * zoom factor of 8
    66 214A 7F 00			dta $7F,$00							; Width-1  (127)	128 * 8 bytes wide
    67 214C 0F				dta $0F								; Height-1 (15)		 16 * 8 bytes high
    68 214D 00				dta $00								; And mask (And mask equal to 0 so clear)
    69 214E 00				dta $00								; Xor mask (will be filled with xor mask)
    70 214F 00				dta $00								; Collision and mask
    71 2150 77				dta $77								; Zoom (BLT_ZOOMY = 7, BLT_ZOOMX = 7 so 8Y*8X)
    72 2151 00				dta $00								; Pattern feature
    73 2152 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    74
    75 				; Zero-fill the 80 x TEXT_ROWS VBXE text screen (TEXT_SCREEN_VRAM, TEXT_SCREEN_
    76 				; BYTES bytes - ONE contiguous buffer backing both the menu XDL's main-content
    77 				; and footer text bands).  Constant-source fast fill: And mask 0 makes the
    78 				; source a constant equal to the Xor mask and the blitter skips the source
    79 				; fetch - about 2x faster than a copy (FX manual "The Blitter and constant
    80 				; source data").  Xor $00 -> blank glyph + transparent attribute in every
    81 				; cell.  MODE 0, NEXT clear.  Kicked by Text_Clear.
    82 2153			BLT_CLEAR_TEXT
    83 2153 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
    84 2156 00 00			dta $00,$00							; Source step y (unused)
    85 2158 00				dta $00								; Source step x (unused)
    86 2159 00 30 02			dta $00,$30,$02						; Destination address ($023000 = TEXT_SCREEN_VRAM)
    87 215C A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
    88 215E 01				dta $01								; Destination step x (1)
    89 215F 9F 00			dta a(TEXT_PITCH-1)					; Width-1  (159 -> 160 bytes per row)
    90 2161 16				dta TEXT_ROWS-1						; Height-1 (29 -> 30 rows)
    91 2162 00				dta $00								; And mask (0 -> constant source)
    92 2163 00				dta $00								; Xor mask (fill value: $00)
    93 2164 00				dta $00								; Collision and mask
    94 2165 00				dta $00								; Zoom
    95 2166 00				dta $00								; Pattern feature
    96 2167 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
    97
    98 				; Recolour a rectangular region of the text screen - floods the attribute (odd)
    99 				; bytes only (Destination step x = 2).  Constant-source fast fill (And 0).
   100 				; Text_FillColour patches Destination address, Width-1, Height-1 and Xor mask
   101 				; before each kick.
   102 2168			BLT_FILL_COLOUR
   103 2168 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   104 216B 00 00			dta $00,$00							; Source step y (unused)
   105 216D 00				dta $00								; Source step x (unused)
   106 216E 01 30 02			dta $01,$30,$02						; Destination address ($023001; PATCHED - attr byte of cell)
   107 2171 A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
   108 2173 02				dta $02								; Destination step x (2 - attribute bytes only)
   109 2174 4F 00			dta a(TEXT_COLS-1)					; Width-1  (79 -> 80 cells; PATCHED)
   110 2176 16				dta TEXT_ROWS-1						; Height-1 (29; PATCHED)
   111 2177 00				dta $00								; And mask (0 -> constant source)
   112 2178 00				dta $00								; Xor mask (attribute value; PATCHED)
   113 2179 00				dta $00								; Collision and mask
   114 217A 00				dta $00								; Zoom
   115 217B 00				dta $00								; Pattern feature
   116 217C 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   117
   118 				; Draw a window of the NFO display buffer (NFO_BUF_VRAM: fixed 160-byte
   119 				; {glyph,attr} line records - the same interleaved layout as the text screen)
   120 				; onto the text screen's main-content band only (TEXT_MAIN_ROWS rows - the
   121 				; footer band below it holds separate static text the NFO blit must not
   122 				; touch).  A plain rectangular copy (And $FF, MODE 0, step x = 1): the buffer
   123 				; already carries the attribute bytes, so no fill link is needed.  Info_Draw
   124 				; patches Source address (lo/mid/hi) and Height-1 before each kick; the
   125 				; destination is always the top-left of the text screen.
   126 217D			BLT_NFO_DRAW
   127 217D 00 50 02			dta $00,$50,$02						; Source address ($025000 = NFO_BUF_VRAM; PATCHED)
   128 2180 A0 00			dta a(TEXT_PITCH)					; Source step y (160 - next line record)
   129 2182 01				dta $01								; Source step x (1)
   130 2183 00 30 02			dta $00,$30,$02						; Destination address ($023000 = TEXT_SCREEN_VRAM)
   131 2186 A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next text row)
   132 2188 01				dta $01								; Destination step x (1)
   133 2189 9F 00			dta a(TEXT_PITCH-1)					; Width-1  (159 -> 160 bytes = 80 cells)
   134 218B 13				dta TEXT_MAIN_ROWS-1					; Height-1 (19 -> 20 rows; PATCHED by Info_Draw)
   135 218C FF				dta $FF								; And mask ($FF -> straight copy)
   136 218D 00				dta $00								; Xor mask
   137 218E 00				dta $00								; Collision and mask
   138 218F 00				dta $00								; Zoom
   139 2190 00				dta $00								; Pattern feature
   140 2191 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   141
   142 				; Save-under rectangle copy for the text-window primitive (Text_Window_Save /
   143 				; Text_Window_Restore).  A plain {glyph,attr} rect copy at screen pitch: step x
   144 				; = 1, step y = TEXT_PITCH, MODE 0, And $FF.  Both address triplets plus Width-1
   145 				; and Height-1 are patched per call; the two directions just swap Src <-> Dest.
   146 2192			BLT_TEXT_RECT
   147 2192 00 00 02			dta $00,$00,$02						; Source address (PATCHED)
   148 2195 A0 00			dta a(TEXT_PITCH)					; Source step y (160 - next row)
   149 2197 01				dta $01								; Source step x (1)
   150 2198 00 00 02			dta $00,$00,$02						; Destination address (PATCHED)
   151 219B A0 00			dta a(TEXT_PITCH)					; Destination step y (160 - next row)
   152 219D 01				dta $01								; Destination step x (1)
   153 219E 00 00			dta a($0000)						; Width-1  in BYTES (PATCHED = cells*2 - 1)
   154 21A0 00				dta $00								; Height-1 (PATCHED = rows - 1)
   155 21A1 FF				dta $FF								; And mask ($FF -> straight copy)
   156 21A2 00				dta $00								; Xor mask
   157 21A3 00				dta $00								; Collision and mask
   158 21A4 00				dta $00								; Zoom
   159 21A5 00				dta $00								; Pattern feature
   160 21A6 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   161
   162 				; Constant-source fast fills for the menu banner/separator VRAM.  The banner
   163 				; fill is a blank-fill fallback when its .RAW asset fails to load at boot, so
   164 				; cold-boot garbage never shows.  Fixed geometry, no patching needed - kicked
   165 				; once each from Load_Menu_Banner_Raw.
   166 21A7			BLT_MENU_BANNER_CLEAR
   167 21A7 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   168 21AA 00 00			dta $00,$00							; Source step y (unused)
   169 21AC 00				dta $00								; Source step x (unused)
   170 21AD 00 00 03			dta <MENU_BANNER_VRAM,>MENU_BANNER_VRAM,MENU_BANNER_VRAM>>16	; Destination address
   171 21B0 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320 - next row)
   172 21B2 01				dta $01								; Destination step x (1)
   173 21B3 3F 01			dta a(MENU_BANNER_PITCH-1)			; Width-1  (319 -> 320 bytes/row)
   174 21B5 23				dta MENU_BANNER_ROWS-1				; Height-1 (35 -> 36 rows)
   175 21B6 00				dta $00								; And mask (0 -> constant source)
   176 21B7 00				dta $00								; Xor mask (fill value: $00)
   177 21B8 00				dta $00								; Collision and mask
   178 21B9 00				dta $00								; Zoom
   179 21BA 00				dta $00								; Pattern feature
   180 21BB 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   181
   182 				; The separator is never loaded from disk - it is always this fixed-colour
   183 				; constant-source fill, kicked once from Load_Menu_Banner_Raw.  Dead after
   184 				; boot, so Fill_Pal_Preview_Cmap (view1024.asm) also repurposes it for the
   185 				; P-preview's CRAM_Buffer attribute fills (patching Dest_Adr, Dest_Step_Y0/1,
   186 				; Blt_W0/1, Blt_H, Blt_Xor) rather than spending a 13th BCB - the 12 BCBs in
   187 				; this file already fill the $100-$1FF VBXE VRAM budget (see the memory-map
   188 				; comment at the top of view1024.asm); a 13th BCB overflows BLT_NFO_NAME_
   189 				; CLEAR (the last one) across the $200 boundary into the NTSC_Palette load,
   190 				; corrupting it - this happened once, do not add a new BCB here again
   191 				; without also moving that budget.
   192 21BC			BLT_MENU_SEP_CLEAR
   193 21BC 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   194 21BF 00 00			dta $00,$00							; Source step y (unused)
   195 21C1 00				dta $00								; Source step x (unused)
   196 21C2 00 30 03			dta <MENU_SEP_VRAM,>MENU_SEP_VRAM,MENU_SEP_VRAM>>16			; Destination address
   197 21C5 A0 00			dta a(MENU_SEP_PITCH)				; Destination step y (unused - 1 row)
   198 21C7 01				dta $01								; Destination step x (1)
   199 21C8 9F 00			dta a(MENU_SEP_PITCH-1)				; Width-1  (159 -> 160 bytes/row)
   200 21CA 00				dta $00								; Height-1 (1 row)
   201 21CB 00				dta $00								; And mask (0 -> constant source)
   202 21CC 07				dta MENU_SEP_FILL_COLOUR			; Xor mask (fill value: white, Palette 0)
   203 21CD 00				dta $00								; Collision and mask
   204 21CE 00				dta $00								; Zoom
   205 21CF 00				dta $00								; Pattern feature
   206 21D0 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   207
   208 				; Menu banner palette-demo overlay - blit Build_Menu_Ramp_Table's 256-byte
   209 				; ascending source ($2E000, bank $2E - fixed, never patched) as a flat 16x16
   210 				; block into one of the demo's 8 squares.  Draw_Menu_Demo_Squares (view1024.
   211 				; asm) patches Dest_Adr0-2 from Menu_Demo_Dest_Table before each of the 8
   212 				; kicks; every other field is fixed.
   213 21D1			BLT_MENU_DEMO_SQUARE
   214 21D1 00 E0 02			dta <MENU_RAMP_VRAM,>MENU_RAMP_VRAM,MENU_RAMP_VRAM>>16	; Source address ($2E000, fixed)
   215 21D4 10 00			dta $10,$00							; Source step y = 16
   216 21D6 01				dta $01								; Source step x (1)
   217 21D7 00 00 00			dta $00,$00,$00						; Destination address (PATCHED per kick)
   218 21DA 40 01			dta a(MENU_BANNER_PITCH)			; Destination step y (320)
   219 21DC 01				dta $01								; Destination step x (1)
   220 21DD 0F 00			dta $0F,$00							; Width-1 = 15 (16 bytes wide)
   221 21DF 0F				dta $0F								; Height-1 = 15 (16 rows)
   222 21E0 FF				dta $FF								; And mask (straight copy)
   223 21E1 00				dta $00								; Xor mask
   224 21E2 00				dta $00								; Collision mask
   225 21E3 00				dta $00								; Zoom
   226 21E4 00				dta $00								; Pattern feature
   227 21E5 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
   228
   229 				; Wipe the selector description cache ($037000-$03EFFF = NFO_NAME_VRAM, banks
   230 				; $37-$3E) to $00, marking every image slot "not loaded".  Constant-source fast
   231 				; fill (And 0 -> source is the $00 Xor mask, no fetch).  256 bytes/row * 128
   232 				; rows = 32768 = 8 banks.  Kicked by Nfo_Name_ClearCache from Rescan_Images.
   233 21E6			BLT_NFO_NAME_CLEAR
   234 21E6 00 00 00			dta $00,$00,$00						; Source address (unused - constant source)
   235 21E9 00 00			dta $00,$00							; Source step y (unused)
   236 21EB 00				dta $00								; Source step x (unused)
   237 21EC 00 70 03			dta <NFO_NAME_VRAM,>NFO_NAME_VRAM,NFO_NAME_VRAM>>16	; Destination address ($037000)
   238 21EF 00 01			dta a($0100)						; Destination step y (256 - next row)
   239 21F1 01				dta $01								; Destination step x (1)
   240 21F2 FF 00			dta $FF,$00							; Width-1  (255 -> 256 bytes per row)
   241 21F4 7F				dta $7F								; Height-1 (127 -> 128 rows; 128*256 = 32768 = 8 banks)
   242 21F5 00				dta $00								; And mask (0 -> constant source)
   243 21F6 00				dta $00								; Xor mask (fill value: $00)
   244 21F7 00				dta $00								; Collision and mask
   245 21F8 00				dta $00								; Zoom
   246 21F9 00				dta $00								; Pattern feature
   247 21FA 00				dta $00								; Control (Mode 0 with NEXT bit Cleared)
