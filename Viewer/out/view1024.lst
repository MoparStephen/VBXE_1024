  1224 3875			Handle_Keys
  1225 				; Dispatch on the current UI mode - the selector, slideshow, drive picker and
  1226 				; info viewer each have their own key set (ui.asm); mode 1 (image view) uses
  1227 				; the set below.
  1228 3875 AD DC 02			lda HELPFLG							; Help isn't in CH - the OS sets HELPFLG ($11/$51/$91)
  1229 3878 F0 08			beq Handle_Keys_NoHelp
  1230 387A A9 00			lda #$00
