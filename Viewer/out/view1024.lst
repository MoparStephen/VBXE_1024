  1229 3806 EC DA 04			cpx FileStart
  1230 3809 D0 03			bne Decrement_Image_Step
  1231 380B AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1232 380E			Decrement_Image_Step
  1233 380E CA				dex
  1234 380F 8E 8A 04			stx File_Index
  1235 3812 20 02 34			jsr Load_Image
  1236 3815			Decrement_Image_Done
  1237 3815 60				rts
