  1448 				;-----------------------------------------------------------------------------
  1449 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1450 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1451 				; equal) otherwise.
  1452 				;-----------------------------------------------------------------------------
  1453 3941			Cmp_Records
  1454 3941 A0 00			ldy #$00
  1455 3943			Cmp_Records_L1
  1456 3943 B1 8A			lda (Name_Ptr),y
  1457 3945 D1 8C			cmp (Sort_Ptr),y
  1458 3947 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1459 3949 C8				iny
  1460 394A C0 08			cpy #$08
  1461 394C 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1462 394E			Cmp_Records_Done
  1463 394E 60				rts
  1464
  1465 				;-----------------------------------------------------------------------------
  1466 				; Swap_Records - exchange the 8-byte records at (Name_Ptr) and (Sort_Ptr),
  1467 				; using Path_Buf as scratch.
  1468 				;-----------------------------------------------------------------------------
  1469 394F			Swap_Records
  1470 394F A0 00			ldy #$00
  1471 3951			Swap_Records_L1
  1472 3951 B1 8A			lda (Name_Ptr),y
  1473 3953 99 8D 04			sta Path_Buf,y
  1474 3956 B1 8C			lda (Sort_Ptr),y
  1475 3958 91 8A			sta (Name_Ptr),y
  1476 395A B9 8D 04			lda Path_Buf,y
  1477 395D 91 8C			sta (Sort_Ptr),y
  1478 395F C8				iny
  1479 3960 C0 08			cpy #$08
  1480 3962 90 ED			bcc Swap_Records_L1
  1481 3964 60				rts
  1482
