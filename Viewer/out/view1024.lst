   999 3707 85 81			sta Reg2
  1000 3709 A9 E6			lda #<Menu_Demo_Attr_Bot_Vals
  1001 370B 85 88			sta Ptr_Lo
  1002 370D A9 36			lda #>Menu_Demo_Attr_Bot_Vals
  1003 370F 85 89			sta Ptr_Hi
  1004 3711 20 1B 37			jsr Set_Menu_Demo_Attr_Band
