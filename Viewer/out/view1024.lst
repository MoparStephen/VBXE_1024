  2805 6219 90 F6			bcc Folder_Path_Push_End
  2806 621B 60				rts									; path too long already - refuse
  2807 621C			Folder_Path_Push_Name
  2808 621C A0 00			ldy #$00
  2809 621E			Folder_Path_Push_L1
  2810 621E B9 CD 04			lda Name_Row_Buf,y
