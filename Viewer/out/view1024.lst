  1666 				;-----------------------------------------------------------------------------
  1667 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1668 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1669 				; equal) otherwise.
  1670 				;-----------------------------------------------------------------------------
  1671 3A37			Cmp_Records
  1672 3A37 A0 00			ldy #$00
  1673 3A39			Cmp_Records_L1
  1674 3A39 B1 8A			lda (Name_Ptr),y
  1675 3A3B D1 8C			cmp (Sort_Ptr),y
  1676 3A3D D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1677 3A3F C8				iny
  1678 3A40 C0 08			cpy #$08
  1679 3A42 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1680 3A44			Cmp_Records_Done
  1681 3A44 60				rts
