   812 				;-----------------------------------------------------------------------------
   813 				; Increment_Image - advance File_Index within the *.MAP file band
   814 				; [FileStart, ImageCount), wrapping past the last file to the first.
   815 				; No-op when the list holds no files.  (The selector list may now also carry
   816 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
   817 				;-----------------------------------------------------------------------------
   818 35FA			Increment_Image
   819 35FA AD DA 04			lda FileStart
   820 35FD CD 8B 04			cmp ImageCount
   821 3600 B0 12			bcs Increment_Image_Done			; no *.MAP files in the list
   822 3602 AE 8A 04			ldx File_Index
   823 3605 E8				inx
   824 3606 EC 8B 04			cpx ImageCount
   825 3609 90 03			bcc Increment_Image_Store
   826 360B AE DA 04			ldx FileStart						; wrap past the last file to the first
   827 360E			Increment_Image_Store
   828 360E 8E 8A 04			stx File_Index
   829 3611 20 B2 33			jsr Load_Image
   830 3614			Increment_Image_Done
   831 3614 60				rts
   832
   833 				;-----------------------------------------------------------------------------
   834 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
   835 				; wrapping from the first file to the last.  No-op when the list holds no files.
   836 				;-----------------------------------------------------------------------------
   837 3615			Decrement_Image
   838 3615 AD DA 04			lda FileStart
   839 3618 CD 8B 04			cmp ImageCount
   840 361B B0 12			bcs Decrement_Image_Done
   841 361D AE 8A 04			ldx File_Index
   842 3620 EC DA 04			cpx FileStart
   843 3623 D0 03			bne Decrement_Image_Step
   844 3625 AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
   845 3628			Decrement_Image_Step
   846 3628 CA				dex
   847 3629 8E 8A 04			stx File_Index
   848 362C 20 B2 33			jsr Load_Image
   849 362F			Decrement_Image_Done
   850 362F 60				rts
   851
