  2045 5AF5 AD 8A 04			lda File_Index
  2046 5AF8 CD 8B 04			cmp ImageCount
  2047 5AFB 90 06			bcc Selector_Sync_Set
  2048 5AFD AD 8B 04			lda ImageCount						; out of range (shouldn't happen) - clamp
  2049 5B00 38				sec
  2050 5B01 E9 01			sbc #$01
  2051 5B03			Selector_Sync_Set
  2052 5B03 8D C7 04			sta Sel_Index
  2053 5B06 20 42 58			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  2054 5B09 8D C8 04			sta Sel_Top
  2055 5B0C 60				rts
  2056 5B0D			Selector_Sync_Zero
  2057 5B0D A9 00			lda #$00
  2058 5B0F 8D C7 04			sta Sel_Index
  2059 5B12 8D C8 04			sta Sel_Top
  2060 5B15 60				rts
