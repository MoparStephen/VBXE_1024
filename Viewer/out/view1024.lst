  2062 				;-----------------------------------------------------------------------------
  2063 				; Selector_Handle_P - "P" key: show a 2x2 grid of ramp squares, one per
  2064 				; palette register, zoomed 7x and centered on the image screen (UI_Mode 6,
  2065 				; Esc-only - see Pal_Preview_Keys).
  2066 				;   * on a *.V1K row: "Reading palette..." in row 0, read the .PAL block to
  2067 				;     $21000 with the selector still up; a missing / short file leaves the
  2068 				;     selector up (row 0 restored).  Only once it has loaded is the preview
  2069 				;     built (unseen) and swapped in, with the registers rewritten under a
  2070 				;     blanked overlay.
  2071 				;   * on "..", a directory or an empty list: no disk access at all - the
  2072 				;     registers already hold the menu's own palettes 0-3, so just show them.
  2073 				;-----------------------------------------------------------------------------
  2074 5B16			Selector_Handle_P
  2075 5B16 AD 8B 04			lda ImageCount
  2076 5B19 0D 8C 04			ora ImageCount+1
  2077 5B1C F0 35			beq Selector_Handle_P_Menu			; empty list -> the menu palettes
  2078 5B1E AD C7 04			lda Sel_Index
  2079 5B21 20 DC 55			jsr UI_RowType
  2080 5B24 D0 2D			bne Selector_Handle_P_Menu			; dir / ".." -> the menu palettes
  2081
  2082 5B26 AD C7 04			lda Sel_Index
