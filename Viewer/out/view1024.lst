   130 				;=============================================================================
   131 				; Directory scan  (moved here from init_vbxe.asm's Scan_Images - the scan
   132 				; location is now chosen at runtime, so it can't be decided in the loader)
   133 				;=============================================================================
   134
   135 				;-----------------------------------------------------------------------------
   136 				; Rescan_Images - scan Scan_Drive/Scan_Path for *.V1K, rebuild + sort the list.
   137 				; Tolerates zero matches (an ordinary state the selector shows).
   138 				;-----------------------------------------------------------------------------
   139 4E8D			Rescan_Images
   140 				; Show "Scanning directory..." where the path goes - the scan + IMAGES.LST
   141 				; name cache can take a while in a big folder.  Every caller repaints the
   142 				; whole selector (Selector_Draw) afterwards.
   143 4E8D A9 55			lda #<UI_Str_Scanning
   144 4E8F A0 60			ldy #>UI_Str_Scanning
   145 4E91 20 2D 52			jsr UI_Show_Busy
   146
   147 4E94 20 37 4F			jsr Build_Image_List				; fills IMAGE_BANK; sets ImageCount/Dir_Count/FileStart
   148
   149 				; sort the two real groups independently: dirs [FileStart-Dir_Count .. FileStart)
   150 				; then files [FileStart .. ImageCount).  ".." (if present) stays pinned at 0.
   151 4E97 AD DA 04			lda FileStart
   152 4E9A 38				sec
   153 4E9B ED D9 04			sbc Dir_Count
   154 4E9E AE D9 04			ldx Dir_Count
   155 4EA1 20 CB 39			jsr Sort_Range						; directories A-Z
   156 4EA4 AD 8B 04			lda ImageCount
   157 4EA7 38				sec
   158 4EA8 ED DA 04			sbc FileStart
   159 4EAB AA				tax									; X = file count
   160 4EAC AD DA 04			lda FileStart
   161 4EAF 20 CB 39			jsr Sort_Range						; *.V1K files A-Z
   162
   163 4EB2 20 9B 53			jsr Nfo_Name_ClearCache				; drop the status-line name slots - list changed
   164 4EB5 20 EF 54			jsr Nfo_Name_LoadManifest			; refill them from this folder's IMAGES.LST (if any)
   165
   166 4EB8 A9 00			lda #$00
   167 4EBA 8D C7 04			sta Sel_Index
   168 4EBD 8D C8 04			sta Sel_Top
   169 4EC0 8D 8A 04			sta File_Index
   170 4EC3 60				rts
   171
   172 				;-----------------------------------------------------------------------------
   173 				; Build_Spec_Prefix - Scan_Spec = "D[n]:" + Scan_Path.  Returns X = cursor.
   174 				;-----------------------------------------------------------------------------
   175 4EC4			Build_Spec_Prefix
   176 4EC4 A2 00			ldx #$00
   177 4EC6 A9 44			lda #'D'
   178 4EC8 9D 50 06			sta Scan_Spec,x
   179 4ECB E8				inx
   180 4ECC AD CC 04			lda Scan_Drive
   181 4ECF F0 04			beq Build_Spec_Prefix_Colon			; $00 -> bare "D:"
   182 4ED1 9D 50 06			sta Scan_Spec,x
   183 4ED4 E8				inx
   184 4ED5			Build_Spec_Prefix_Colon
   185 4ED5 A9 3A			lda #':'
   186 4ED7 9D 50 06			sta Scan_Spec,x
   187 4EDA E8				inx
   188 4EDB A0 00			ldy #$00
   189 4EDD			Build_Spec_Prefix_L1
   190 4EDD B9 28 06			lda Scan_Path,y
   191 4EE0 F0 09			beq Build_Spec_Prefix_Done
