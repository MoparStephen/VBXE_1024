  2447 				;=============================================================================
  2448 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  2449 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  2450 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  2451 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  2452 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits record 0 (the title rule,
  2453 				; pinned to row 0) plus a 19-row scrolling window of the rest - two
  2454 				; BLT_NFO_DRAW copies per scroll, no reformat, no re-walk.
  2455 				;=============================================================================
  2456
  2457 				;-----------------------------------------------------------------------------
  2458 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  2459 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  2460 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  2461 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  2462 				; off screen.
  2463 				;-----------------------------------------------------------------------------
  2464 5FF9			Info_Load
  2465 5FF9 A9 25			lda #NFO_BUF_BANK
  2466 5FFB 85 8E			sta BankIndex
  2467 5FFD 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  2468 6000 AD 2D 31			lda LoadStatus
  2469 6003 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  2470 6005 20 09 60			jsr Info_Count_Lines				; sets Nfo_LineCount
  2471 6008			Info_Load_Ret
  2472 6008 60				rts
  2473
  2474 				;-----------------------------------------------------------------------------
  2475 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  2476 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  2477 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  2478 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  2479 				; 160-byte step straddles a bank every ~25 records, handled inline.
  2480 				;-----------------------------------------------------------------------------
  2481 6009			Info_Count_Lines
  2482 6009 A9 00			lda #$00
  2483 600B 8D DE 04			sta Nfo_LineCount
  2484 600E 8D DF 04			sta Nfo_LineCount + $01
  2485 6011 A9 25			lda #NFO_BUF_BANK
  2486 6013 8D 50 06			sta Nfo_WalkBank
  2487 6016 09 80			ora #MEMAC_GLOBAL_ENABLE
  2488 6018				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 6018 A0 5F			ldy #<VBXE_MA_BSEL
     3 601A 91 93			sta (VBXEBase),y
Source: ui.asm
  2489 601C A9 00			lda #<VBXE_WINDOW
  2490 601E 85 88			sta Ptr_Lo
  2491 6020 A9 20			lda #>VBXE_WINDOW
  2492 6022 85 89			sta Ptr_Hi
  2493 6024			Info_Count_L1
  2494 6024 A0 00			ldy #$00
  2495 6026 B1 88			lda (Ptr_Lo),y
  2496 6028 F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  2497 602A EE DE 04			inc Nfo_LineCount
  2498 602D AD DE 04			lda Nfo_LineCount
  2499 6030 C9 7F			cmp #NFO_MAX_LINES
  2500 6032 B0 24			bcs Info_Count_Done					; hit the record cap
  2501 6034 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  2502 6036 18				clc
  2503 6037 69 A0			adc #TEXT_PITCH
  2504 6039 85 88			sta Ptr_Lo
  2505 603B 90 E7			bcc Info_Count_L1
  2506 603D E6 89			inc Ptr_Hi
  2507 603F A5 89			lda Ptr_Hi
  2508 6041 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  2509 6043 90 DF			bcc Info_Count_L1
  2510 6045 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  2511 6047 85 89			sta Ptr_Hi
  2512 6049 EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  2513 604C AD 50 06			lda Nfo_WalkBank
  2514 604F 09 80			ora #MEMAC_GLOBAL_ENABLE
  2515 6051				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 6051 A0 5F			ldy #<VBXE_MA_BSEL
