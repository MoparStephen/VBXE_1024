   521 				;=============================================================================
   522 				; Selector screen
   523 				;=============================================================================
   524
   525 				;-----------------------------------------------------------------------------
   526 				; Enter_Selector - restore Palette 0 for text, refresh the menu banner's
   527 				; palette registers 1-3 (Load_Image overwrites them for every real image
   528 				; viewed in between - a cheap resident-VRAM-to-register copy, no disk access;
   529 				; see Apply_Menu_Banner_Palette in view1024.asm), show the text screen, draw
   530 				; it.  Reached from start: (jsr), Handle_Escape (jsr), Slide_Key_Stop (jsr)
   531 				; and Info_Key_Leave (jsr) - always returns.
   532 				;-----------------------------------------------------------------------------
   533 504C			Enter_Selector
   534 504C 20 15 32			jsr Restore_Palette0				; standard PAL/NTSC master palette -> set 0
   535 504F 20 61 50			jsr UI_Apply_TextPalette			; ...then de-interleave it for text mode
   536 5052 20 45 35			jsr Apply_Menu_Banner_Palette		; refresh the banner's palette registers 1-3
   537 5055 20 BD 3A			jsr Text_Activate					; point the XDL at the menu/info screen
   538 5058 A9 00			lda #$00
   539 505A 8D C6 04			sta UI_Mode
   540 505D 20 E0 50			jsr Selector_Draw
   541 5060 60				rts
   542
   543 				;-----------------------------------------------------------------------------
   544 				; UI_Apply_TextPalette - Restore_Palette0 has just put the standard Atari 256-
   545 				; colour master into palette set 0.  The VBXE text mode can only reach entries
   546 				; 0-127 as a foreground, and in the master that range is hues 0-7 (no green).
   547 				; De-interleave it so:
   548 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   549 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   550 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   551 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000) and re-upload it
   552 				; as set 0.  Runs only on entry to the selector - not per frame.
   553 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   554 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr, Y_Register.
   555 				;-----------------------------------------------------------------------------
   556 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   557
   558 5061			UI_Apply_TextPalette
   559 5061 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   560 5063				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5063 A0 5F			ldy #<VBXE_MA_BSEL
     3 5065 91 93			sta (VBXEBase),y
Source: ui.asm
