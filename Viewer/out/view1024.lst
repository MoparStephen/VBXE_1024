   875 				;-----------------------------------------------------------------------------
   876 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
   877 				; address, its VBXE bank ($2A..$2D) mapped in.  slot byte offset = Ord * 64:
   878 				; bank = $2A + (Ord >> 6), window page = $20 + ((Ord >> 2) & 15),
   879 				; window low = (Ord & 3) << 6.  (64 divides 4K, so a slot never straddles.)
   880 				;-----------------------------------------------------------------------------
   881 51FD			Nfo_Name_MapSlot
   882 51FD AD E1 04			lda Nfo_Name_Ord
   883 5200 0A				asl
   884 5201 0A				asl
   885 5202 0A				asl
   886 5203 0A				asl
   887 5204 0A				asl
   888 5205 0A				asl									; A = (Ord & 3) << 6
   889 5206 85 88			sta Ptr_Lo
   890 5208 AD E1 04			lda Nfo_Name_Ord
   891 520B 4A				lsr
   892 520C 4A				lsr
   893 520D 29 0F			and #$0F							; (Ord >> 2) & 15
   894 520F 18				clc
   895 5210 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   896 5212 85 89			sta Ptr_Hi
   897 5214 AD E1 04			lda Nfo_Name_Ord
   898 5217 4A				lsr
   899 5218 4A				lsr
   900 5219 4A				lsr
   901 521A 4A				lsr
   902 521B 4A				lsr
   903 521C 4A				lsr									; Ord >> 6  (0..3)
   904 521D 18				clc
   905 521E 69 2A			adc #NFO_NAME_BANK
   906 5220 09 80			ora #MEMAC_GLOBAL_ENABLE
   907 5222				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 5222 A0 5F			ldy #<VBXE_MA_BSEL
     3 5224 91 93			sta (VBXEBase),y
