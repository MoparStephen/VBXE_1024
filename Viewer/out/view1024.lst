  1649 5A43 48				pha									; stash the new index
  1650 5A44 AD C7 04			lda Sel_Index
  1651 5A47 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1652 5A49 68				pla
  1653 5A4A 8D C7 04			sta Sel_Index
  1654 5A4D 20 6F 5A			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1655 5A50 CD C8 04			cmp Sel_Top
  1656 5A53 F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1657 5A55 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1658 5A58 20 8F 54			jsr Selector_DrawList
  1659 5A5B 4C 69 5A			jmp Sel_Key_Nav_Done
  1660 5A5E			Sel_Nav_Apply_Rows
  1661 5A5E A5 87			lda Reg8
