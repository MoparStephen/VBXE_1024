  1257 3810 4C 8C 57			jmp Drive_Keys						; 3 = drive picker (D-key overlay)
  1258 3813			Handle_Keys_NotFolder
  1259 3813 C9 04			cmp #$04
  1260 3815 D0 03			bne Handle_Keys_NotInfo
  1261 3817 4C BE 5A			jmp Info_Keys						; 4 = info viewer (.nfo)
  1262 381A			Handle_Keys_NotInfo
  1263 381A C9 05			cmp #$05
  1264 381C D0 03			bne Handle_Keys_NotQuit
  1265 381E 4C 57 58			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
  1266 3821			Handle_Keys_NotQuit
  1267 3821 C9 06			cmp #$06
