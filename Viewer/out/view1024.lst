   687 3501 B0 08			bcs Read_Image_Palette_Done			; OPEN failed (C=1)
   688 3503 20 8F 35			jsr Image_Read_Pal
   689 3506 08				php
   690 3507 20 2C 36			jsr Image_Close
   691 350A 28				plp									; C from the read
   692 350B			Read_Image_Palette_Done
   693 350B 60				rts
