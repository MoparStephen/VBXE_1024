   749 				;-----------------------------------------------------------------------------
   750 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner pixel data
   751 				; (D:MENU.RAW - the logo) into dedicated, resident VRAM - never touched by Load_Image,
   752 				; and never reloaded from disk again after this one call, since the banner
   753 				; never changes at runtime.  Blank-fills any banner target whose file is
   754 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   755 				; no asset file at all - it is always a fixed-colour blitter fill
   756 				; (Menu_Sep_Blank).  The banner's palette (registers 1-3) is no longer a disk
   757 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   758 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   759 				; Enter_Selector.
   760 				;-----------------------------------------------------------------------------
   761 34DE			Load_Menu_Banner_Raw
   762 				; The ANTIC loading screen is still up (start: turns DMA off afterwards), so
   763 				; this load reports on it like the init stages: message on row 3, then the
   764 				; 8th stage's progress dots.  Reg1 (the init stages' dot pointer) doesn't
   765 				; survive Text_Init, so the dots go at the fixed position after the 7 init
   766 				; stages.  There is no MENU.MAP: the banner is all palette 0, and its
   767 				; attribute map (MENU_BANNER_MAP_VRAM) is already all zeros from the boot-time
   768 				; clear_vbxe - Set_Menu_Demo_Attrs sets just the ramp squares' cells.
   769 34DE A5 58			lda SAVMSC
   770 34E0 85 88			sta Ptr_Lo
   771 34E2 A5 59			lda SAVMSC+1
   772 34E4 85 89			sta Ptr_Hi
   773 34E6 A0 79			ldy #LOAD_MSG_ROW3
   774 34E8 A2 00			ldx #$00
   775 34EA			Load_Menu_Banner_Msg_L1
   776 34EA BD 25 35			lda Load_Menu_Banner_Message,x
   777 34ED 91 88			sta (Ptr_Lo),y
   778 34EF E8				inx
   779 34F0 C8				iny
   780 34F1 E0 21			cpx #$21							; Copy $21 characters
   781 34F3 D0 F5			bne Load_Menu_Banner_Msg_L1
   782
   783 34F5 A9 EC			lda #<Menu_Banner_Raw_Name
   784 34F7 8D 28 31			sta FileNamePtr
   785 34FA A9 37			lda #>Menu_Banner_Raw_Name
   786 34FC 8D 29 31			sta FileNamePtr + $01
   787 34FF A9 30			lda #MENU_BANNER_BANK
   788 3501 85 8E			sta BankIndex
   789 3503 20 AA 30			jsr LoadData
   790 3506 AD 2D 31			lda LoadStatus
   791 3509 D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   792 350B 20 9A 37			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   793
   794 350E			Load_Menu_Banner_Raw_Sep
   795 				; Progress dots - re-read SAVMSC, since LoadData doesn't preserve Ptr_Lo/Hi
   796 350E A5 58			lda SAVMSC
   797 3510 85 88			sta Ptr_Lo
   798 3512 A5 59			lda SAVMSC+1
   799 3514 85 89			sta Ptr_Hi
   800 3516 A0 E8			ldy #LOAD_DOTS_START + (7 * NUM_DOTS)
   801 3518 A9 54			lda #$54							; Screen RAM code for Ctrl+T
   802 351A A2 04			ldx #NUM_DOTS						; Number of dots to write
   803 351C			Load_Menu_Banner_Dots_L1
   804 351C 91 88			sta (Ptr_Lo),y
   805 351E C8				iny
   806 351F CA				dex
   807 3520 D0 FA			bne Load_Menu_Banner_Dots_L1
   808
   809 3522 4C C3 37			jmp Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   810 														; Apply_Menu_Banner_Palette isn't called here -
   811 														; Enter_Selector always calls it before the first frame
   812
   813 3525			Load_Menu_Banner_Message
   814 3525 2C 6F 61 64 69 6E + 	.sb 'Loading menu logo MENU.RAW        '
