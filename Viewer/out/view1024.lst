  2218 				;=============================================================================
  2219 				; Shared directory helpers
  2220 				;-----------------------------------------------------------------------------
  2221 				; Line_Has_Dir_Tag classifies a CIO directory line; Folder_Path_Push /
  2222 				; Path_Pop_Segment maintain the Scan_Path segment stack ("NAME>NAME2>").  All
  2223 				; three are driven from Build_Image_List and Sel_Key_Enter now that directory
  2224 				; navigation lives in the selector itself.
  2225 				;=============================================================================
  2226
  2227 				;-----------------------------------------------------------------------------
  2228 				; Line_Has_Dir_Tag - Z=0 (A=$01) if Dir_Line_Buf holds the "<DIR>" token that
  2229 				; SpartaDOS X prints in the size column for a sub-directory; Z=1 (A=$00) if
  2230 				; not.  Reads CPU RAM only - safe to call with a VBXE bank in the $2000 window.
  2231 				;-----------------------------------------------------------------------------
  2232 5B50			Line_Has_Dir_Tag
  2233 5B50 A2 00			ldx #$00
  2234 5B52			Line_Has_Dir_Tag_L1
  2235 5B52 BD 00 06			lda Dir_Line_Buf,x
  2236 5B55 C9 3C			cmp #'<'
  2237 5B57 D0 1F			bne Line_Has_Dir_Tag_Next
  2238 5B59 BD 01 06			lda Dir_Line_Buf+1,x
  2239 5B5C C9 44			cmp #'D'
  2240 5B5E D0 18			bne Line_Has_Dir_Tag_Next
  2241 5B60 BD 02 06			lda Dir_Line_Buf+2,x
  2242 5B63 C9 49			cmp #'I'
  2243 5B65 D0 11			bne Line_Has_Dir_Tag_Next
  2244 5B67 BD 03 06			lda Dir_Line_Buf+3,x
  2245 5B6A C9 52			cmp #'R'
  2246 5B6C D0 0A			bne Line_Has_Dir_Tag_Next
  2247 5B6E BD 04 06			lda Dir_Line_Buf+4,x
  2248 5B71 C9 3E			cmp #'>'
  2249 5B73 D0 03			bne Line_Has_Dir_Tag_Next
  2250 5B75 A9 01			lda #$01							; found
  2251 5B77 60				rts
  2252 5B78			Line_Has_Dir_Tag_Next
  2253 5B78 E8				inx
  2254 5B79 E0 24			cpx #[Dir_Line_Len-4]				; keep 5 bytes of headroom
  2255 5B7B 90 D5			bcc Line_Has_Dir_Tag_L1
  2256 5B7D A9 00			lda #$00							; not found
  2257 5B7F 60				rts
  2258
  2259 				;-----------------------------------------------------------------------------
  2260 				; Folder_Path_Push - append "<name>>" to Scan_Path (name from Name_Row_Buf,
  2261 				; space-padded).  Refuses if the result would not fit.
  2262 				;-----------------------------------------------------------------------------
  2263 5B80			Folder_Path_Push
  2264 5B80 A2 00			ldx #$00
  2265 5B82			Folder_Path_Push_End
  2266 5B82 BD 28 06			lda Scan_Path,x
  2267 5B85 F0 06			beq Folder_Path_Push_Name
  2268 5B87 E8				inx
  2269 5B88 E0 20			cpx #$20							; keep room for name(8) + '>' + NUL
  2270 5B8A 90 F6			bcc Folder_Path_Push_End
  2271 5B8C 60				rts									; path too long already - refuse
  2272 5B8D			Folder_Path_Push_Name
  2273 5B8D A0 00			ldy #$00
  2274 5B8F			Folder_Path_Push_L1
  2275 5B8F B9 CD 04			lda Name_Row_Buf,y
  2276 5B92 F0 0D			beq Folder_Path_Push_Sep
  2277 5B94 C9 20			cmp #' '
  2278 5B96 F0 09			beq Folder_Path_Push_Sep
  2279 5B98 9D 28 06			sta Scan_Path,x
  2280 5B9B E8				inx
  2281 5B9C C8				iny
  2282 5B9D C0 08			cpy #$08
  2283 5B9F 90 EE			bcc Folder_Path_Push_L1
  2284 5BA1			Folder_Path_Push_Sep
  2285 5BA1 A9 3E			lda #'>'
  2286 5BA3 9D 28 06			sta Scan_Path,x
  2287 5BA6 E8				inx
  2288 5BA7 A9 00			lda #$00
  2289 5BA9 9D 28 06			sta Scan_Path,x
  2290 5BAC 60				rts
  2291
  2292 				;-----------------------------------------------------------------------------
  2293 				; Path_Pop_Segment - "...>SEG>" -> "...>"  (or -> "" for the last segment)
  2294 				;-----------------------------------------------------------------------------
  2295 5BAD			Path_Pop_Segment
  2296 5BAD A2 00			ldx #$00
  2297 5BAF			Path_Pop_End
  2298 5BAF BD 28 06			lda Scan_Path,x
  2299 5BB2 F0 05			beq Path_Pop_Found
  2300 5BB4 E8				inx
  2301 5BB5 E0 28			cpx #$28
  2302 5BB7 90 F6			bcc Path_Pop_End
  2303 5BB9			Path_Pop_Found							; X = index of the NUL
  2304 5BB9 E0 00			cpx #$00
  2305 5BBB F0 13			beq Path_Pop_Done					; already empty
  2306 5BBD CA				dex									; step onto the trailing '>'
  2307 5BBE			Path_Pop_L1
  2308 5BBE E0 00			cpx #$00
  2309 5BC0 F0 09			beq Path_Pop_Cut
  2310 5BC2 CA				dex
  2311 5BC3 BD 28 06			lda Scan_Path,x
  2312 5BC6 C9 3E			cmp #'>'
  2313 5BC8 D0 F4			bne Path_Pop_L1
  2314 5BCA E8				inx									; keep this separator
  2315 5BCB			Path_Pop_Cut
  2316 5BCB A9 00			lda #$00
  2317 5BCD 9D 28 06			sta Scan_Path,x
  2318 5BD0			Path_Pop_Done
  2319 5BD0 60				rts
  2320
  2321 				;=============================================================================
  2322 				; UI strings  (ATASCII; the text renderer maps to internal codes)
  2323 				;=============================================================================
  2324 5BD1 4C 6F 63 61 74 69 + UI_Str_Loc			dta c'Location: ',0
  2325 5BDC 28 6E 6F 20 69 6D + UI_Str_Empty		dta c'(no images found here)',0
  2326 5BF3 53 6C 69 64 65 73 + UI_Str_Delay		dta c'Slideshow delay: ',0
  2327 5C05 73 20 20 20 20 2C + UI_Str_DelayHint	dta c's    , shorter    . longer',0
  2328 5C20 55 70 2F 44 6E 20 + UI_Str_Legend		dta c'Up/Dn move  ENTER open  S slide  D drive  P pal  I info  F font  Q quit',0
  2329 5C68 45 73 63 20 74 6F + UI_Str_InfoHint		dta c'Esc to go back, Up/Down to scroll',0
  2330 5C8A 53 63 61 6E 20 64 + UI_Str_DriveTitle	dta c'Scan drive',0
  2331 5C95 41 72 65 20 79 6F + UI_Str_QuitConfirm	dta c'Are you sure to Quit',0
  2332 5CAA 28 59 2F 4E 29 00	UI_Str_QuitHint		dta c'(Y/N)',0
  2333 5CB0 53 72 63 3A 20 00	UI_Str_Src			dta c'Src: ',0
  2334 5CB6 20 20 20 20 20 20 + UI_Str_StatusBlank	dta c'                                                     ',0	; 53 spaces (Src: + NFO_NAME_CAP)
  2335
  2336 				;-----------------------------------------------------------------------------
  2337 				; Sel_ColX - screen column for grid column c (0..UI_COLS-1), 10-char cells.
  2338 				; Indexed by (list index AND [UI_COLS-1]).  Relocate the whole grid by
  2339 				; changing UI_GRIDCOL0 alone.
  2340 				;-----------------------------------------------------------------------------
  2341 5CEC 00 0A 14 1E		Sel_ColX	dta UI_GRIDCOL0+0, UI_GRIDCOL0+10, UI_GRIDCOL0+20, UI_GRIDCOL0+30
  2342 5CF0 28 32 3C 46					dta UI_GRIDCOL0+40, UI_GRIDCOL0+50, UI_GRIDCOL0+60, UI_GRIDCOL0+70
  1682
