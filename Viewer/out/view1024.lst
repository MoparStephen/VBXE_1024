   726 355C A0 00			ldy #<[V1K_PAL_LEN & $0FFF]
   727 355E 8C E5 04			sty Seg_Tail
   728 3561 A0 0C			ldy #>[V1K_PAL_LEN & $0FFF]
   729 3563 8C E6 04			sty Seg_Tail + $01
   730 3566 4C 9A 35			jmp Image_Read_Segment
