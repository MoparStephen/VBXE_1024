   280 				; --- ".." at slot 0 whenever we are below the drive root
   281 51A2 AD 28 06			lda Scan_Path
   282 51A5 F0 19			beq Build_Image_List_Dirs
   283 51A7 A0 00			ldy #$00
   284 51A9 A9 2E			lda #'.'
   285 51AB 91 8A			sta (Name_Ptr),y
