  1754 				;-----------------------------------------------------------------------------
  1755 				; Viewer UI (main segment)
  1756 				;-----------------------------------------------------------------------------
  1757 3AA7				icl 'text80.asm'					; VBXE 80-column text screen + font + palette
Source: text80.asm
     1 				;=============================================================================
     2 				; text80.asm  -  VBXE 80-column text screen for the viewer UI
     3 				;-----------------------------------------------------------------------------
     4 				; VBXE FX *hardware text mode* (XDLC_TMON + XDLC_CHBASE + XDLC_ATT), ported from
     5 				; VBXE_APOD (ASM Samples/Mockup1 - Load_Font / the XDL text block; Mockup2's
     6 				; Load_Text_Print_Error_L1 string writer and Set_Status_Colour).
     7 				;
     8 				; The 2048-byte IBM CGA font (CGA.F08: 256 x 8x8 1bpp, code page 437 order -
     9 				; glyph index = raw ASCII byte, NO ATASCII remap) is streamed from disk into
    10 				; VRAM at TEXT_FONT_VRAM; the XDL's CHBASE points at it.  "Drawing text" = poking
    11 				; a {glyph, colour} byte pair per cell into the XDL's screen RAM
    12 				; (TEXT_SCREEN_VRAM) through the $2000 MEMAC window.  No glyph rasteriser, no
    13 				; bit-depth expansion.
    14 				;
    15 				; The colour byte: bits 0-6 select the palette entry (0-127) for the character;
    16 				; bit 7 = 0 -> transparent background, 1 -> opaque/coloured background.
    17 				;
    18 				; TEXT_FONT_VRAM / TEXT_SCREEN_VRAM / TEXT_PITCH / TEXT_CHBASE live in
    19 				; view1024.asm's .def block and are shared with XDL_MainMenu (xdl.asm) so the
    20 				; two halves cannot drift.
    21 				;
    22 				; __VBXE_AUTO__ IS DEFINED IN THIS REPO.  Every VBXE_* register hit goes through
    23 				; vbsta / vblda; writes to VBXE_WINDOW ($2000..$2FFF) are plain stores (real
    24 				; memory - the mapped MEMAC window).  vbsta clobbers Y in auto mode: no live Y
    25 				; is held across one below.
    26 				;
    27 				; PUBLIC API (called by ui.asm):
    28 				;   Text_Init        copy both fonts into VRAM once; blank the screen RAM.
    29 				;   Text_Activate    point VBXE_XDL_ADR0/1/2 at XDL_MainMenu.
    30 				;   Text_Deactivate  point them back at XDL_Image_Attribute (offset 0).
    31 				;   Text_Present     blit the back buffer onto the displayed screen, in vblank.
    32 				;   Text_Clear       blitter zero-fill of the 80 x TEXT_ROWS cells (blank +
    33 				;                    transparent) - ONE contiguous buffer backing both the
    34 				;                    XDL's main-content and footer text bands, see xdl.asm.
    35 				;   Text_FillColour  blitter recolour of a cell rectangle: Txt_Row/Txt_Col =
    36 				;                    top-left, Reg1 = width-1 (cells), Reg2 = height-1 (rows),
    37 				;                    A = attribute byte.  Floods the attribute bytes only.
    38 				;   Text_SetPen      A = fg palette entry (0-127), X = bg (0 transparent /
    39 				;                    non-zero opaque)  -> Make_Attr -> Txt_Attr.
    40 				;   Text_PutStrAt    draw the $00-terminated ASCII string at Txt_Ptr, from cell
    41 				;                    (Txt_Col, Txt_Row).
    42 				;
    43 				; INPUT VARIABLES (set by ui.asm before the call):
    44 				;   Txt_Row .byte  0..(TEXT_ROWS-1)    Txt_Col .byte  0..79    Txt_Ptr .word  -> string
    45 				;
    46 				; DOUBLE BUFFERED.  Every draw call below writes the BACK buffer
    47 				; (TEXT_BACK_VRAM), never the displayed one, and sets Txt_Dirty.  Nothing
    48 				; appears until Text_Present copies the whole back buffer across with one blit
    49 				; during vblank - Read_Key_Done does that after every key that drew anything,
    50 				; and the transitions (Enter_Selector, UI_Show_Busy before slow disk I/O) call
    51 				; it directly.  So a repaint, a dialog, a scroll is never seen half-built.
    52 				;=============================================================================
    53
    54 				; --- placeholder tuning knobs (Stephen finalises with Make_Attr / the XDL) ---
    55 = 000F			.def	TEXT_DEF_FG		= $0F			; default foreground (palette 0 index)
    56 = 0000			.def	TEXT_DEF_BG		= $00			; default background
    57
    58 3AA7			.zpvar	Txt_Ptr			.word			; -> the string Text_PutStrAt is drawing
    59 3AA7			.var	Txt_Row			.byte = $6B0
    60 3AA7			.var	Txt_Col			.byte = $6B1
    61 3AA7			.var	Txt_Fg			.byte = $6B2
    62 3AA7			.var	Txt_Bg			.byte = $6B3
    63 3AA7			.var	Txt_Attr		.byte = $6B4	; current pen, as one cell attribute byte
    64 3AA7			.var	Txt_FrameStyle	.byte = $6B5	; Text_Window_Frame border: FRAME_DOUBLE / FRAME_SINGLE
    65 3AA7			.var	Txt_Bank		.byte = $6B6	; VBXE bank currently mapped by the cell writer
    66 3AA7			.var	Txt_Dirty		.byte = $6B7	; non-zero = back buffer changed since the last Text_Present
    67 				;	$6B8 to $6FF free
    68
    69 				;-----------------------------------------------------------------------------
    70 				; Text_Init - default pen, load the font, blank the screen.  Called once.
    71 				;-----------------------------------------------------------------------------
    72 3AA7			Text_Init
    73 3AA7 A9 0F			lda #TEXT_DEF_FG
    74 3AA9 A2 00			ldx #TEXT_DEF_BG
    75 3AAB 20 D1 3B			jsr Text_SetPen						; sets Txt_Attr
    76
    77 3AAE 20 B7 3A			jsr Text_Load_Fonts					; embedded CGA.F08 + ATARI.F08 -> VRAM bank $22
    78 3AB1 20 EB 3B			jsr Text_Clear						; blank the back buffer...
    79 3AB4 4C 93 3B			jmp Text_Present					; ...and the displayed screen, then rts
    80
    81 				;-----------------------------------------------------------------------------
    82 				; Text_Load_Fonts - copy both embedded 2048-byte fonts into VRAM bank
    83 				; TEXT_FONT_BANK ($22) through the $2000 window: CGA.F08 -> $022000 (CHBASE
    84 				; $44), ATARI.F08 -> $022800 (CHBASE $45).  Fonts are embedded rather than
    85 				; streamed from disk so the viewer never depends on a font file being on
    86 				; whatever disk it happens to boot from.  F (Handle_Keys) flips XDL_MainMenu's
    87 				; two CHBASE bytes (main + footer text blocks) between the two.
    88 				;-----------------------------------------------------------------------------
    89 3AB7			Text_Load_Fonts
    90 3AB7 A9 A2			lda #TEXT_FONT_BANK | MEMAC_GLOBAL_ENABLE
    91 3AB9				vbsta VBXE_MA_BSEL					; map VRAM bank $22 into $2000-$2FFF
Macro: VBSTA [Source: vbxe_min.asm]
     2 3AB9 A0 5F			ldy #<VBXE_MA_BSEL
     3 3ABB 91 93			sta (VBXEBase),y
Source: text80.asm
