  2879 6303 A0 07			ldy #$07
  2880 6305 A9 20			lda #' '
  2881 6307			Path_Save_Clr
  2882 6307 99 EC 04			sta Up_Name,y
  2883 630A 88				dey
  2884 630B 10 FA			bpl Path_Save_Clr
  2885 630D A2 00			ldx #$00
  2886 630F			Path_Save_End
  2887 630F BD 28 06			lda Scan_Path,x
