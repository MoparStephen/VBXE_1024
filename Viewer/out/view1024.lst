   943 				;-----------------------------------------------------------------------------
   944 				; Nfo_Name_LoadManifest - open "D[n]:PATH IMAGES.LST", and for every record
   945 				; (8-byte key + source name + $9B) store the name into the matching *.MAP
   946 				; row's slot.  Called from Rescan_Images right after Nfo_Name_ClearCache.
   947 				; A missing / unreadable file just leaves every slot $00 (blank status line).
   948 				;-----------------------------------------------------------------------------
   949 506F			Nfo_Name_LoadManifest
   950 506F 20 59 4B			jsr Build_Manifest_Spec				; Scan_Spec = "D[n]:PATH" + "IMAGES.LST" + $9B
   951 5072 20 2D 30			jsr Find_First_IOCB
   952 5075 C0 01			cpy #$01
   953 5077 D0 79			bne Nfo_Name_LoadManifest_Done		; no free IOCB
   954 5079 8E C5 04			stx Dir_IOCB
   955 507C A9 04			lda #CIO_read						; AUX1 = 4 : plain file, read
   956 507E 9D 4A 03			sta ICAX1,x
   957 5081 A9 00			lda #$00
   958 5083 9D 4B 03			sta ICAX2,x
   959 5086 A9 50			lda #<Scan_Spec
   960 5088 9D 44 03			sta ICBAL,x
   961 508B A9 06			lda #>Scan_Spec
   962 508D 9D 45 03			sta ICBAH,x
   963 5090 A9 03			lda #CIO_open
   964 5092 9D 42 03			sta ICCOM,x
   965 5095 20 56 E4			jsr CIOV
   966 5098 30 58			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
   967
   968 509A			Nfo_Name_LoadManifest_Line
   969 509A AE C5 04			ldx Dir_IOCB
   970 509D A9 05			lda #CIO_gettext
   971 509F 9D 42 03			sta ICCOM,x
   972 50A2 A9 B7			lda #<Nfo_Name_Line
   973 50A4 9D 44 03			sta ICBAL,x
   974 50A7 A9 06			lda #>Nfo_Name_Line
   975 50A9 9D 45 03			sta ICBAH,x
   976 50AC A9 3A			lda #58								; buffer length (8 key + 48 name + $9B, rounded)
   977 50AE 9D 48 03			sta ICBLL,x
   978 50B1 A9 00			lda #$00
   979 50B3 9D 49 03			sta ICBLH,x
   980 50B6 20 56 E4			jsr CIOV
   981 50B9 30 2C			bmi Nfo_Name_LoadManifest_Close		; EOF / error / record over 58 bytes
   982
   983 50BB 20 F3 50			jsr Nfo_Name_Match					; key = Nfo_Name_Line[0..7]  -> A = ordinal
   984 50BE B0 DA			bcs Nfo_Name_LoadManifest_Line		; no matching *.MAP row - drop the line
   985 50C0 8D E1 04			sta Nfo_Name_Ord
   986 50C3 20 17 50			jsr Nfo_Name_MapSlot				; Ptr_Lo/Hi -> slot, bank $2A..$2D mapped
   987 50C6 A0 00			ldy #$00
   988 50C8			Nfo_Name_LoadManifest_Copy
   989 50C8 B9 BF 06			lda Nfo_Name_Line + 8,y
   990 50CB C9 9B			cmp #$9B
   991 50CD F0 0B			beq Nfo_Name_LoadManifest_CopyEnd	; end of record
   992 50CF C9 20			cmp #$20
   993 50D1 90 07			bcc Nfo_Name_LoadManifest_CopyEnd	; NUL / control -> stop
   994 50D3 91 88			sta (Ptr_Lo),y
   995 50D5 C8				iny
   996 50D6 C0 30			cpy #NFO_NAME_CAP
   997 50D8 90 EE			bcc Nfo_Name_LoadManifest_Copy
   998 50DA			Nfo_Name_LoadManifest_CopyEnd
