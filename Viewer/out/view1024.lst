  1635 5AEA 0D 8C 04			ora ImageCount+1
  1636 5AED F0 33			beq Sel_Key_Nav_Done				; empty list
  1637 5AEF AE C7 04			ldx Sel_Index
  1638 5AF2 E8				inx
  1639 5AF3 EC 8B 04			cpx ImageCount
  1640 5AF6 B0 2A			bcs Sel_Key_Nav_Done				; already at the last item
  1641 5AF8 8A				txa
  1642 5AF9 4C FC 5A			jmp Sel_Nav_Apply
