   102 				;-----------------------------------------------------------------------------
   103 				; Rescan_Images - scan Scan_Drive/Scan_Path for *.MAP, rebuild + sort the list.
   104 				; Tolerates zero matches (an ordinary state the selector shows).
   105 				;-----------------------------------------------------------------------------
   106 4ADD			Rescan_Images
   107 4ADD 20 80 4B			jsr Build_Image_List				; fills IMAGE_BANK; sets ImageCount/Dir_Count/FileStart
   108
   109 				; sort the two real groups independently: dirs [FileStart-Dir_Count .. FileStart)
   110 				; then files [FileStart .. ImageCount).  ".." (if present) stays pinned at 0.
   111 4AE0 AD DA 04			lda FileStart
   112 4AE3 38				sec
   113 4AE4 ED D9 04			sbc Dir_Count
   114 4AE7 AE D9 04			ldx Dir_Count
   115 4AEA 20 EF 36			jsr Sort_Range						; directories A-Z
   116 4AED AD 8B 04			lda ImageCount
   117 4AF0 38				sec
   118 4AF1 ED DA 04			sbc FileStart
   119 4AF4 AA				tax									; X = file count
   120 4AF5 AD DA 04			lda FileStart
   121 4AF8 20 EF 36			jsr Sort_Range						; *.MAP files A-Z
   122
   123 4AFB 20 91 4F			jsr Nfo_Name_ClearCache				; drop the status-line name slots - list changed
   124 4AFE 20 6F 50			jsr Nfo_Name_LoadManifest			; refill them from this folder's IMAGES.LST (if any)
