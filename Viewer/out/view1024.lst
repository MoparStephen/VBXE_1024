   439 				;-----------------------------------------------------------------------------
   440 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   441 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   442 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   443 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   444 				;  Returns A = $01 if a name was written, $00 if not.
   445 				;-----------------------------------------------------------------------------
   446 528A			Parse_Dir_Line
   447 528A A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   448 528C			Parse_Skip_L1							; Skip leading spaces / protect flag
   449 528C BD 00 06			lda Dir_Line_Buf,x
   450 528F C9 9B			cmp #$9B
   451 5291 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   452 5293 C9 20			cmp #' '
   453 5295 F0 04			beq Parse_Skip_Next
   454 5297 C9 2A			cmp #'*'
   455 5299 D0 07			bne Parse_Skip_Done
   456 529B			Parse_Skip_Next
   457 529B E8				inx
   458 529C E0 28			cpx #Dir_Line_Len
   459 529E 90 EC			bcc Parse_Skip_L1
   460 52A0 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   461 52A2			Parse_Skip_Done
   462 52A2 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   463 52A4 A9 00			lda #$00
   464 52A6 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   465
   466 52A8			Parse_Copy_L1
   467 52A8 BD 00 06			lda Dir_Line_Buf,x
   468 52AB C9 9B			cmp #$9B
   469 52AD F0 24			beq Parse_Copy_Done
   470 52AF C9 20			cmp #' '
   471 52B1 F0 20			beq Parse_Copy_Done
   472 52B3 C9 2E			cmp #'.'
   473 52B5 F0 1C			beq Parse_Copy_Done
   474 52B7 C9 30			cmp #'0'
   475 52B9 90 07			bcc Parse_Copy_Is_Name_Char
   476 52BB C9 3A			cmp #'9'+1
   477 52BD B0 03			bcs Parse_Copy_Is_Name_Char
   478 52BF 4C C4 52			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   479 52C2			Parse_Copy_Is_Name_Char
   480 52C2 E6 80			inc Reg1
   481 52C4			Parse_Copy_Store
   482 52C4 C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   483 52C6 B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   484 52C8 BD 00 06			lda Dir_Line_Buf,x
   485 52CB 91 8A			sta (Name_Ptr),y
   486 52CD C8				iny
   487 52CE			Parse_Copy_Next
   488 52CE E8				inx
   489 52CF E0 28			cpx #Dir_Line_Len
   490 52D1 90 D5			bcc Parse_Copy_L1
   491
   492 52D3			Parse_Copy_Done
   493 52D3 A5 80			lda Reg1
   494 52D5 F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   495
   496 52D7			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   497 52D7 C0 08			cpy #$08
   498 52D9 B0 07			bcs Parse_Dir_Line_Accept
   499 52DB A9 20			lda #' '
   500 52DD 91 8A			sta (Name_Ptr),y
   501 52DF C8				iny
   502 52E0 D0 F5			bne Parse_Pad_L1
   503
   504 52E2			Parse_Dir_Line_Accept
   505 52E2 A9 01			lda #$01							; Non-zero - a name was stored
   506 52E4 60				rts
   507 52E5			Parse_Dir_Line_Reject
   508 52E5 A9 00			lda #$00
   509 52E7 60				rts
