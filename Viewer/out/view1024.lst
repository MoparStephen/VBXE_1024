   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 402A			Text_Window_Frame_Chars
   504 402A C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 4033 DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 403C			Text_Window_Frame
   508 403C A5 80			lda Reg1
   509 403E 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 4040 AD B1 06			lda Txt_Col
   511 4043 85 87			sta Reg8							; Reg8 = left column
   512 4045 AD B0 06			lda Txt_Row
   513 4048 18				clc
   514 4049 65 81			adc Reg2
   515 404B 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 404D AD B0 06			lda Txt_Row
   517 4050 85 84			sta Reg5							; Reg5 = current screen row
   518 4052 AE B5 06			ldx Txt_FrameStyle
   519 4055 20 74 40			jsr Text_Window_Frame_Row			; top edge
   520 4058			Text_Window_Frame_Mid
   521 4058 E6 84			inc Reg5
   522 405A A5 84			lda Reg5
   523 405C C5 85			cmp Reg6
   524 405E B0 0D			bcs Text_Window_Frame_Bottom
   525 4060 AD B5 06			lda Txt_FrameStyle
   526 4063 18				clc
   527 4064 69 03			adc #$03
   528 4066 AA				tax
   529 4067 20 74 40			jsr Text_Window_Frame_Row			; interior row
   530 406A 4C 58 40			jmp Text_Window_Frame_Mid
   531 406D			Text_Window_Frame_Bottom
   532 406D AD B5 06			lda Txt_FrameStyle
   533 4070 18				clc
   534 4071 69 06			adc #$06
   535 4073 AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 4074			Text_Window_Frame_Row
   540 4074 BD 2A 40			lda Text_Window_Frame_Chars,x
   541 4077 8D 80 06			sta Txt_Line+0
   542 407A BD 2B 40			lda Text_Window_Frame_Chars+1,x
   543 407D 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 407F BD 2C 40			lda Text_Window_Frame_Chars+2,x
   545 4082 85 82			sta Reg3							; Reg3 = right char
   546 4084 A2 01			ldx #$01
   547 4086			Text_Window_Frame_Row_L1
   548 4086 E4 86			cpx Reg7
   549 4088 B0 08			bcs Text_Window_Frame_Row_End
   550 408A A5 83			lda Reg4
   551 408C 9D 80 06			sta Txt_Line,x
   552 408F E8				inx
   553 4090 D0 F4			bne Text_Window_Frame_Row_L1
   554 4092			Text_Window_Frame_Row_End
   555 4092 A5 82			lda Reg3
   556 4094 9D 80 06			sta Txt_Line,x
   557 4097 E8				inx
   558 4098			Text_Window_Frame_PutRow
   559 4098 A9 00			lda #$00
   560 409A 9D 80 06			sta Txt_Line,x
   561 409D A5 84			lda Reg5
   562 409F 8D B0 06			sta Txt_Row
   563 40A2 A5 87			lda Reg8
   564 40A4 8D B1 06			sta Txt_Col
   565 40A7 A9 80			lda #<Txt_Line
   566 40A9 85 96			sta Txt_Ptr
   567 40AB A9 06			lda #>Txt_Line
   568 40AD 85 97			sta Txt_Ptr + $01
   569 40AF 4C B2 40			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 40B2			Text_PutStrAt
   583 40B2 A9 01			lda #$01
   584 40B4 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 40B7 A9 00			lda #$00
   587 40B9 85 80			sta Reg1
   588 40BB 85 81			sta Reg2
   589 40BD AE B0 06			ldx Txt_Row
   590 40C0 F0 0E			beq Text_PutStrAt_Col
   591 40C2			Text_PutStrAt_RowL
   592 40C2 A5 80			lda Reg1
   593 40C4 18				clc
   594 40C5 69 A0			adc #TEXT_PITCH
   595 40C7 85 80			sta Reg1
   596 40C9 90 02			bcc Text_PutStrAt_RowNC
   597 40CB E6 81			inc Reg2
   598 40CD			Text_PutStrAt_RowNC
   599 40CD CA				dex
   600 40CE D0 F2			bne Text_PutStrAt_RowL
   601 40D0			Text_PutStrAt_Col
   602 40D0 AD B1 06			lda Txt_Col
   603 40D3 0A				asl									; Txt_Col * 2 (max 158)
   604 40D4 18				clc
   605 40D5 65 80			adc Reg1
   606 40D7 85 80			sta Reg1
   607 40D9 90 02			bcc Text_PutStrAt_ColNC
   608 40DB E6 81			inc Reg2
   609 40DD			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 40DD A5 81			lda Reg2
   612 40DF 29 10			and #$10							; offset bit 12 = "second bank"
   613 40E1 F0 04			beq Text_PutStrAt_Bank0
   614 40E3 A9 2B			lda #TEXT_BACK_BANK+1
   615 40E5 D0 02			bne Text_PutStrAt_SetBank
   616 40E7			Text_PutStrAt_Bank0
   617 40E7 A9 2A			lda #TEXT_BACK_BANK
   618 40E9			Text_PutStrAt_SetBank
   619 40E9 8D B6 06			sta Txt_Bank
   620 40EC A5 80			lda Reg1
   621 40EE 85 88			sta Ptr_Lo
   622 40F0 A5 81			lda Reg2
   623 40F2 29 0F			and #$0F
   624 40F4 18				clc
   625 40F5 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 40F7 85 89			sta Ptr_Hi
   627 40F9 AD B6 06			lda Txt_Bank
   628 40FC 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 40FE				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 40FE A0 5F			ldy #<VBXE_MA_BSEL
     3 4100 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 4102 A9 00			lda #$00
   632 4104 85 82			sta Reg3							; Reg3 = source string index
   633 4106 AD B1 06			lda Txt_Col
   634 4109 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 410B			Text_PutStrAt_Char
   636 410B A5 83			lda Reg4
   637 410D C9 50			cmp #TEXT_COLS
   638 410F B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 4111 A4 82			ldy Reg3
   640 4113 B1 96			lda (Txt_Ptr),y
   641 4115 F0 43			beq Text_PutStrAt_Done
   642 4117 C9 01			cmp #TXT_PEN
   643 4119 D0 0C			bne Text_PutStrAt_Glyph
   644 411B C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 411C B1 96			lda (Txt_Ptr),y
   646 411E 8D B4 06			sta Txt_Attr
   647 4121 C8				iny
   648 4122 84 82			sty Reg3							; skip both bytes, column unchanged
   649 4124 4C 0B 41			jmp Text_PutStrAt_Char
   650 4127			Text_PutStrAt_Glyph
   651 4127 A0 00			ldy #$00
   652 4129 91 88			sta (Ptr_Lo),y						; glyph byte
   653 412B C8				iny
   654 412C AD B4 06			lda Txt_Attr
   655 412F 91 88			sta (Ptr_Lo),y						; attribute byte
   656 4131 E6 82			inc Reg3
   657 4133 E6 83			inc Reg4
   658 4135 A5 88			lda Ptr_Lo							; window pointer += 2
   659 4137 18				clc
   660 4138 69 02			adc #$02
   661 413A 85 88			sta Ptr_Lo
   662 413C 90 02			bcc Text_PutStrAt_NoPage
   663 413E E6 89			inc Ptr_Hi
   664 4140			Text_PutStrAt_NoPage
   665 4140 A5 89			lda Ptr_Hi
   666 4142 C9 30			cmp #$30							; crossed out of the window -> next bank
   667 4144 90 C5			bcc Text_PutStrAt_Char
   668 4146 38				sec
   669 4147 E9 10			sbc #$10
   670 4149 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 414B EE B6 06			inc Txt_Bank
   672 414E AD B6 06			lda Txt_Bank
   673 4151 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 4153				vbsta VBXE_MA_BSEL
