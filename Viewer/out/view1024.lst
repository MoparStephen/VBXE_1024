   380 				;-----------------------------------------------------------------------------
   381 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   382 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   383 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   384 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   385 				;  Returns A = $01 if a name was written, $00 if not.
   386 				;-----------------------------------------------------------------------------
   387 4F70			Parse_Dir_Line
   388 4F70 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   389 4F72			Parse_Skip_L1							; Skip leading spaces / protect flag
   390 4F72 BD 00 06			lda Dir_Line_Buf,x
   391 4F75 C9 9B			cmp #$9B
   392 4F77 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   393 4F79 C9 20			cmp #' '
   394 4F7B F0 04			beq Parse_Skip_Next
   395 4F7D C9 2A			cmp #'*'
   396 4F7F D0 07			bne Parse_Skip_Done
   397 4F81			Parse_Skip_Next
   398 4F81 E8				inx
   399 4F82 E0 28			cpx #Dir_Line_Len
   400 4F84 90 EC			bcc Parse_Skip_L1
   401 4F86 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   402 4F88			Parse_Skip_Done
   403 4F88 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   404 4F8A A9 00			lda #$00
   405 4F8C 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   406
   407 4F8E			Parse_Copy_L1
   408 4F8E BD 00 06			lda Dir_Line_Buf,x
   409 4F91 C9 9B			cmp #$9B
   410 4F93 F0 24			beq Parse_Copy_Done
   411 4F95 C9 20			cmp #' '
   412 4F97 F0 20			beq Parse_Copy_Done
   413 4F99 C9 2E			cmp #'.'
   414 4F9B F0 1C			beq Parse_Copy_Done
   415 4F9D C9 30			cmp #'0'
   416 4F9F 90 07			bcc Parse_Copy_Is_Name_Char
   417 4FA1 C9 3A			cmp #'9'+1
   418 4FA3 B0 03			bcs Parse_Copy_Is_Name_Char
   419 4FA5 4C AA 4F			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   420 4FA8			Parse_Copy_Is_Name_Char
   421 4FA8 E6 80			inc Reg1
   422 4FAA			Parse_Copy_Store
   423 4FAA C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   424 4FAC B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   425 4FAE BD 00 06			lda Dir_Line_Buf,x
   426 4FB1 91 8A			sta (Name_Ptr),y
   427 4FB3 C8				iny
   428 4FB4			Parse_Copy_Next
   429 4FB4 E8				inx
   430 4FB5 E0 28			cpx #Dir_Line_Len
   431 4FB7 90 D5			bcc Parse_Copy_L1
   432
   433 4FB9			Parse_Copy_Done
   434 4FB9 A5 80			lda Reg1
   435 4FBB F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   436
   437 4FBD			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   438 4FBD C0 08			cpy #$08
   439 4FBF B0 07			bcs Parse_Dir_Line_Accept
   440 4FC1 A9 20			lda #' '
   441 4FC3 91 8A			sta (Name_Ptr),y
   442 4FC5 C8				iny
   443 4FC6 D0 F5			bne Parse_Pad_L1
   444
   445 4FC8			Parse_Dir_Line_Accept
   446 4FC8 A9 01			lda #$01							; Non-zero - a name was stored
   447 4FCA 60				rts
   448 4FCB			Parse_Dir_Line_Reject
   449 4FCB A9 00			lda #$00
   450 4FCD 60				rts
