   439 				;-----------------------------------------------------------------------------
   440 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   441 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   442 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   443 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   444 				;  Returns A = $01 if a name was written, $00 if not.
   445 				;-----------------------------------------------------------------------------
   446 5340			Parse_Dir_Line
   447 5340 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   448 5342			Parse_Skip_L1							; Skip leading spaces / protect flag
   449 5342 BD 00 06			lda Dir_Line_Buf,x
   450 5345 C9 9B			cmp #$9B
   451 5347 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   452 5349 C9 20			cmp #' '
   453 534B F0 04			beq Parse_Skip_Next
   454 534D C9 2A			cmp #'*'
   455 534F D0 07			bne Parse_Skip_Done
   456 5351			Parse_Skip_Next
   457 5351 E8				inx
   458 5352 E0 28			cpx #Dir_Line_Len
   459 5354 90 EC			bcc Parse_Skip_L1
   460 5356 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   461 5358			Parse_Skip_Done
   462 5358 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   463 535A A9 00			lda #$00
   464 535C 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   465
   466 535E			Parse_Copy_L1
   467 535E BD 00 06			lda Dir_Line_Buf,x
   468 5361 C9 9B			cmp #$9B
   469 5363 F0 24			beq Parse_Copy_Done
   470 5365 C9 20			cmp #' '
   471 5367 F0 20			beq Parse_Copy_Done
   472 5369 C9 2E			cmp #'.'
   473 536B F0 1C			beq Parse_Copy_Done
   474 536D C9 30			cmp #'0'
   475 536F 90 07			bcc Parse_Copy_Is_Name_Char
   476 5371 C9 3A			cmp #'9'+1
   477 5373 B0 03			bcs Parse_Copy_Is_Name_Char
   478 5375 4C 7A 53			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   479 5378			Parse_Copy_Is_Name_Char
   480 5378 E6 80			inc Reg1
   481 537A			Parse_Copy_Store
   482 537A C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   483 537C B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   484 537E BD 00 06			lda Dir_Line_Buf,x
   485 5381 91 8A			sta (Name_Ptr),y
   486 5383 C8				iny
   487 5384			Parse_Copy_Next
   488 5384 E8				inx
   489 5385 E0 28			cpx #Dir_Line_Len
   490 5387 90 D5			bcc Parse_Copy_L1
   491
   492 5389			Parse_Copy_Done
   493 5389 A5 80			lda Reg1
   494 538B F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   495
   496 538D			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   497 538D C0 08			cpy #$08
   498 538F B0 07			bcs Parse_Dir_Line_Accept
   499 5391 A9 20			lda #' '
   500 5393 91 8A			sta (Name_Ptr),y
   501 5395 C8				iny
   502 5396 D0 F5			bne Parse_Pad_L1
   503
   504 5398			Parse_Dir_Line_Accept
   505 5398 A9 01			lda #$01							; Non-zero - a name was stored
   506 539A 60				rts
   507 539B			Parse_Dir_Line_Reject
   508 539B A9 00			lda #$00
   509 539D 60				rts
   510
