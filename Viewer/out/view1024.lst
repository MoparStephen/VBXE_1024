  1205
  1206 37DC 85 83			sta Reg4							; m = i
  1207 37DE 20 4E 38			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1208
  1209 37E1 A5 81			lda Reg2
  1210 37E3 18				clc
  1211 37E4 69 01			adc #$01
  1212 37E6 85 82			sta Reg3							; j = i + 1
  1213 37E8			Sort_Range_Inner
  1214 37E8 A5 82			lda Reg3
  1215 37EA C5 84			cmp Reg5
  1216 37EC B0 1D			bcs Sort_Range_Inner_Done			; j >= end
  1217
  1218 37EE A5 82			lda Reg3
  1219 37F0 20 5A 38			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1220 37F3 20 2A 38			jsr Cmp_Records						; rec(m) : rec(j)
  1221 37F6 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1222 37F8 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1223 37FA A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1224 37FC 85 83			sta Reg4
  1225 37FE A5 8C			lda Sort_Ptr
  1226 3800 85 8A			sta Name_Ptr
