  2000 				;-----------------------------------------------------------------------------
  2001 				; Info_Draw - blit an NFO_VISROWS window of the NFO buffer (from line record
  2002 				; Nfo_Top) onto the text screen with one BLT_NFO_DRAW copy - no re-walk.  When
  2003 				; the whole .NFO is shorter than the window, clear first and blit only the
  2004 				; records that exist.
  2005 				;-----------------------------------------------------------------------------
  2006 5722			Info_Draw
  2007 				; Reg6:Reg5 = Nfo_LineCount - Nfo_Top   (records available; >= 0 by scroll invariant)
  2008 5722 38				sec
  2009 5723 AD DE 04			lda Nfo_LineCount
  2010 5726 ED DC 04			sbc Nfo_Top
  2011 5729 85 84			sta Reg5
  2012 572B AD DF 04			lda Nfo_LineCount + $01
  2013 572E ED DD 04			sbc Nfo_Top + $01
  2014 5731 85 85			sta Reg6
  2015 				; rows = min(available, NFO_VISROWS)
  2016 5733 A5 85			lda Reg6
  2017 5735 D0 16			bne Info_Draw_Full					; >= 256 available -> full window
  2018 5737 A5 84			lda Reg5
  2019 5739 C9 14			cmp #NFO_VISROWS
  2020 573B B0 10			bcs Info_Draw_Full
  2021 				; short document: clear, then blit only the records that exist
  2022 573D A5 84			lda Reg5
  2023 573F 85 83			sta Reg4
  2024 5741 20 65 38			jsr Text_Clear
  2025 5744 A5 83			lda Reg4
  2026 5746 F0 68			beq Info_Draw_Ret					; nothing to draw
  2027 5748 C6 83			dec Reg4							; Reg4 = height-1
  2028 574A 4C 51 57			jmp Info_Draw_Blit
  2029 574D			Info_Draw_Full
  2030 574D A9 13			lda #NFO_VISROWS-1
  2031 574F 85 83			sta Reg4
  2032 5751			Info_Draw_Blit
  2033 				; Reg2:Reg1 = Nfo_Top * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS, < $5000)
  2034 5751 A9 00			lda #$00
