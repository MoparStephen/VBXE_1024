   542 3AC2 38				sec
   543 3AC3 E9 10			sbc #$10
   544 3AC5 85 89			sta Ptr_Hi							; wrap back to $20xx
   545 3AC7 EE B6 06			inc Txt_Bank
   546 3ACA AD B6 06			lda Txt_Bank
   547 3ACD 09 80			ora #MEMAC_GLOBAL_ENABLE
   548 3ACF				vbsta VBXE_MA_BSEL
