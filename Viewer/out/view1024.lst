  1056 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1057 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1058 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1059 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1060 				;-----------------------------------------------------------------------------
  1061 577A			Nfo_Name_MapSlot
  1062 577A AD E1 04			lda Nfo_Name_Ord
  1063 577D 4A				lsr									; C = Ord & 1
  1064 577E A9 00			lda #$00
  1065 5780 6A				ror									; A = (Ord & 1) << 7
  1066 5781 85 88			sta Ptr_Lo
  1067 5783 AD E1 04			lda Nfo_Name_Ord
  1068 5786 4A				lsr
  1069 5787 29 0F			and #$0F							; (Ord >> 1) & 15
  1070 5789 18				clc
  1071 578A 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1072 578C 85 89			sta Ptr_Hi
  1073 578E AD E1 04			lda Nfo_Name_Ord
  1074 5791 4A				lsr
  1075 5792 4A				lsr
  1076 5793 4A				lsr
  1077 5794 4A				lsr
  1078 5795 4A				lsr									; Ord >> 5  (0..7)
  1079 5796 18				clc
  1080 5797 69 37			adc #NFO_NAME_BANK
  1081 5799 09 80			ora #MEMAC_GLOBAL_ENABLE
  1082 579B				vbsta VBXE_MA_BSEL
