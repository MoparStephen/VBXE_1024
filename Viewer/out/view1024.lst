  1571 39D9 20 43 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(j)
  1572 39DC 20 13 3A			jsr Cmp_Records						; rec(m) : rec(j)
  1573 39DF 90 0E			bcc Sort_Range_Inner_Next			; rec(m) < rec(j) -> keep m
  1574 39E1 F0 0C			beq Sort_Range_Inner_Next			; equal          -> keep m
  1575 39E3 A5 82			lda Reg3							; rec(m) > rec(j) -> new min is j
  1576 39E5 85 83			sta Reg4
  1577 39E7 A5 8C			lda Sort_Ptr
  1578 39E9 85 8A			sta Name_Ptr
  1579 39EB A5 8D			lda Sort_Ptr + $01
  1580 39ED 85 8B			sta Name_Ptr + $01
  1581 39EF			Sort_Range_Inner_Next
  1582 39EF E6 82			inc Reg3
  1583 39F1 4C D1 39			jmp Sort_Range_Inner
  1584 39F4			Sort_Range_Inner_Done
  1585 39F4 A5 83			lda Reg4
  1586 39F6 C5 81			cmp Reg2
  1587 39F8 F0 0D			beq Sort_Range_Outer_Next			; min already in place
  1588 39FA A5 81			lda Reg2
  1589 39FC 20 43 3A			jsr Sort_SetSortPtr					; Sort_Ptr = rec(i)
  1590 39FF A5 83			lda Reg4
  1591 3A01 20 37 3A			jsr Sort_SetNamePtr					; Name_Ptr = rec(m)
  1592 3A04 20 21 3A			jsr Swap_Records
