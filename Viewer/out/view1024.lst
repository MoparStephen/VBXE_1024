   155 3300			.proc Check_RAMTOP
   156 				; Disable BASIC
   157 3300-33A3> A9 C0			lda #$C0							; Check if RAMTOP is already OK
   158 3302 C5 6A			cmp RAMTOP							; Prevent flickering if BASIC is already off
   159 3304 F0 38			beq Ram_Ok
