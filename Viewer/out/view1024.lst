  1291 				;-----------------------------------------------------------------------------
  1292 				; Build_Filename
  1293 				;  In:  A          = 0 -> .PAL, 1 -> .MAP, 2 -> .RAW, 3 -> .NFO
  1294 				;       File_Index = image ordinal
  1295 				;  Out: FileNamePtr -> Path_Buf holding
  1296 				;         "D[n]:" + Scan_Path + base(<=8) + "." + ext + $00
  1297 				;       IMAGE_BANK unmapped (MEMAC_GLOBAL_DISABLE) on return
  1298 				;  The base name is the space-padded 8-byte record Rescan_Images stored in
  1299 				;  IMAGE_BANK; copying stops at the first space.  Emit_Path_Prefix (ui.asm)
  1300 				;  writes the "D[n]:" + Scan_Path part and returns X = the next Path_Buf index.
  1301 				;-----------------------------------------------------------------------------
  1302 3850			Build_Filename
  1303 3850 85 81			sta Reg2							; Reg2 = extension selector
  1304
  1305 				; Name_Ptr = ImageNames + File_Index * 8   (16-bit; File_Index up to 254)
  1306 3852 AD 8A 04			lda File_Index
  1307 3855 85 82			sta Reg3
  1308 3857 A9 00			lda #$00
  1309 3859 85 83			sta Reg4
  1310 385B 06 82			asl Reg3
  1311 385D 26 83			rol Reg4
  1312 385F 06 82			asl Reg3
  1313 3861 26 83			rol Reg4
  1314 3863 06 82			asl Reg3
  1315 3865 26 83			rol Reg4							; Reg3/Reg4 = File_Index * 8
  1316 3867 A5 82			lda Reg3
  1317 3869 18				clc
  1318 386A 69 00			adc #<ImageNames
  1319 386C 85 8A			sta Name_Ptr
  1320 386E A5 83			lda Reg4
  1321 3870 69 20			adc #>ImageNames
  1322 3872 85 8B			sta Name_Ptr + $01
  1323
  1324 3874 20 FC 4E			jsr Emit_Path_Prefix				; Path_Buf = "D[n]:" + Scan_Path, X = cursor
  1325
