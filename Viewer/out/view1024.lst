   767 				;-----------------------------------------------------------------------------
   768 				; Load_Menu_Banner_Raw - boot-time load of the static menu banner (pixel data,
   769 				; attribute map) into dedicated, resident VRAM - never touched by Load_Image,
   770 				; and never reloaded from disk again after this one call, since the banner
   771 				; never changes at runtime.  Blank-fills any banner target whose file is
   772 				; missing/fails so cold-boot VRAM garbage is never shown.  The separator has
   773 				; no asset file at all - it is always a fixed-colour blitter fill
   774 				; (Menu_Sep_Blank).  The banner's palette (registers 1-3) is no longer a disk
   775 				; asset - see Load_Menu_Ramps (init_vbxe.asm), assembly-embedded directly into
   776 				; MENU_BANNER_PAL_VRAM.  Called once from start:, before the first
   777 				; Enter_Selector.
   778 				;-----------------------------------------------------------------------------
   779 34FF			Load_Menu_Banner_Raw
   780 34FF A9 E5			lda #<Menu_Banner_Raw_Name
   781 3501 8D 28 31			sta FileNamePtr
   782 3504 A9 37			lda #>Menu_Banner_Raw_Name
   783 3506 8D 29 31			sta FileNamePtr + $01
   784 3509 A9 30			lda #MENU_BANNER_BANK
   785 350B 85 8E			sta BankIndex
   786 350D 20 AA 30			jsr LoadData
   787 3510 AD 2D 31			lda LoadStatus
   788 3513 D0 03			bne Load_Menu_Banner_Raw_Sep		; loaded OK
   789 3515 20 88 37			jsr Menu_Banner_Blank				; OPEN/load failed - blank the banner band
   790
   791 3518			Load_Menu_Banner_Raw_Sep
   792 3518 20 B1 37			jsr Menu_Sep_Blank					; no asset to load - always a fixed-colour fill
   793
   794 351B			Load_Menu_Banner_Raw_Map
   795 				; Load the banner's .MAP into $14000 (CRAM_Buffer, shared scratch - fine,
   796 				; this is a one-time boot step) and expand it into MENU_BANNER_MAP_VRAM (its
   797 				; own resident copy, NOT the shared CRAM $017000 - see Setup_Menu_Cmap).
   798 351B A9 DA			lda #<Menu_Banner_Map_Name
   799 351D 8D 28 31			sta FileNamePtr
   800 3520 A9 37			lda #>Menu_Banner_Map_Name
   801 3522 8D 29 31			sta FileNamePtr + $01
   802 3525 A9 14			lda #$14
   803 3527 85 8E			sta BankIndex
   804 3529 20 AA 30			jsr LoadData
   805 352C AD 2D 31			lda LoadStatus
   806 352F F0 03			beq Load_Menu_Banner_Raw_Done		; OPEN/load failed - leave MENU_BANNER_MAP_VRAM as-is
   807 3531 20 77 33			jsr Setup_Menu_Cmap
   808
   809 3534			Load_Menu_Banner_Raw_Done				; Apply_Menu_Banner_Palette isn't called here -
   810 3534 60				rts									; Enter_Selector always calls it before the first frame
   811
   812 				;-----------------------------------------------------------------------------
   813 				; Apply_Menu_Banner_Palette - push MENU_BANNER_PAL_VRAM's resident bytes into
   814 				; hardware palette registers 1-3.  No disk access, no LoadData, no IOCB - a
   815 				; cheap in-VRAM-to-register copy only.  Register 0 is never touched (reserved
   816 				; for text).  Called once at boot (above) and from every Enter_Selector
   817 				; (ui.asm), since Load_Image overwrites registers 1-3 for every real image
   818 				; viewed in between and there is no way to avoid that hardware-register
   819 				; refresh - VBXE has exactly 4 palette registers total (FX manual, "RGB
   820 				; PALETTE MODIFICATION") and there is no per-XDL copy of them.
