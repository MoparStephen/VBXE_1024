   305 3BDF A9 F0			lda #>WIN_SAVE_VRAM
   306 3BE1 8D 99 21			sta BLT_TEXT_RECT + Dest_Adr1
   307 3BE4 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   308 3BE6 8D 9A 21			sta BLT_TEXT_RECT + Dest_Adr2
   309 3BE9 4C 53 3C			jmp Text_Window_Kick
   310
   311 3BEC			Text_Window_Restore
   312 3BEC 20 13 3C			jsr Text_Window_Setup
   313 3BEF A9 00			lda #<WIN_SAVE_VRAM
   314 3BF1 8D 92 21			sta BLT_TEXT_RECT + Src_Adr0
   315 3BF4 A9 F0			lda #>WIN_SAVE_VRAM
   316 3BF6 8D 93 21			sta BLT_TEXT_RECT + Src_Adr1
   317 3BF9 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   318 3BFB 8D 94 21			sta BLT_TEXT_RECT + Src_Adr2
   319 3BFE A5 83			lda Reg4
