  1053 				;-----------------------------------------------------------------------------
  1054 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1055 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1056 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1057 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1058 				;-----------------------------------------------------------------------------
  1059 56F8			Nfo_Name_MapSlot
  1060 56F8 AD E1 04			lda Nfo_Name_Ord
  1061 56FB 4A				lsr									; C = Ord & 1
  1062 56FC A9 00			lda #$00
  1063 56FE 6A				ror									; A = (Ord & 1) << 7
  1064 56FF 85 88			sta Ptr_Lo
  1065 5701 AD E1 04			lda Nfo_Name_Ord
  1066 5704 4A				lsr
  1067 5705 29 0F			and #$0F							; (Ord >> 1) & 15
  1068 5707 18				clc
  1069 5708 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1070 570A 85 89			sta Ptr_Hi
  1071 570C AD E1 04			lda Nfo_Name_Ord
  1072 570F 4A				lsr
  1073 5710 4A				lsr
  1074 5711 4A				lsr
  1075 5712 4A				lsr
  1076 5713 4A				lsr									; Ord >> 5  (0..7)
  1077 5714 18				clc
  1078 5715 69 37			adc #NFO_NAME_BANK
  1079 5717 09 80			ora #MEMAC_GLOBAL_ENABLE
  1080 5719				vbsta VBXE_MA_BSEL
