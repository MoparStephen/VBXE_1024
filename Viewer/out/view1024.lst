   538 				;=============================================================================
   539 				; Selector screen
   540 				;=============================================================================
   541
   542 				;-----------------------------------------------------------------------------
   543 				; Enter_Selector - build the selector in the back buffer (unseen), put the
   544 				; menu palettes back ONLY if an image replaced them (Pal_Image - after Info,
   545 				; Drive, Quit or a directory P-preview the registers are already right), then
   546 				; show the finished screen: one Text_Present + an XDL switch.  When palettes
   547 				; have to be rewritten the overlay is blanked for those ~2 frames, so neither
   548 				; the image nor the logo is ever seen in the wrong colours.  The logo's VRAM
   549 				; is never touched.  Reached from start: (jsr), Handle_Escape (jsr),
   550 				; Slide_Key_Stop (jsr), Pal_Preview_Keys (jsr) and Info_Key_Leave (jsr) -
   551 				; always returns.
   552 				;-----------------------------------------------------------------------------
   553 5109			Enter_Selector
   554 5109 A9 00			lda #$00
   555 510B 8D C6 04			sta UI_Mode
   556 510E 20 9D 51			jsr Selector_Draw					; back buffer only - nothing visible yet
   557 5111 AD E7 04			lda Pal_Image
   558 5114 F0 0F			beq Enter_Selector_Show				; menu palettes still in the registers
   559 5116 20 AE 33			jsr Display_Off						; blank while the registers are rewritten
   560 5119 20 6D 35			jsr Apply_Menu_Palettes				; text set 0 + banner sets 1-3, clears Pal_Image
   561 511C 20 93 3B			jsr Text_Present
   562 511F 20 71 3B			jsr Text_Activate
   563 5122 4C B8 33			jmp Display_On						; (tail)
   564 5125			Enter_Selector_Show
   565 5125 20 93 3B			jsr Text_Present					; the finished screen, in one blit
   566 5128 4C 71 3B			jmp Text_Activate					; (tail) a pure XDL swap
   567
   568 				;-----------------------------------------------------------------------------
   569 				; UI_Build_TextPalette - the standard Atari 256-colour master (NTSC $00200 /
   570 				; PAL $00500, per Video_Flag) has its entries 0-127 in hues 0-7 only (no
   571 				; green), and the VBXE text mode can only reach entries 0-127 as a foreground.
   572 				; De-interleave it so:
   573 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   574 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   575 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   576 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000).  Runs ONCE, from
   577 				; start: - the buffer stays resident (Clear_Screen starts at $01000) and
   578 				; Apply_Menu_Palettes (view1024.asm) uploads it as set 0 whenever needed.
   579 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   580 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr.
   581 				;-----------------------------------------------------------------------------
   582 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   583
   584 512B			UI_Build_TextPalette
   585 512B A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   586 512D				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 512D A0 5F			ldy #<VBXE_MA_BSEL
     3 512F 91 93			sta (VBXEBase),y
Source: ui.asm
