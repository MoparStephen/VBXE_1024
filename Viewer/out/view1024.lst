  1059 5506 6A				ror									; A = (Ord & 1) << 7
  1060 5507 85 88			sta Ptr_Lo
  1061 5509 AD E1 04			lda Nfo_Name_Ord
  1062 550C 4A				lsr
  1063 550D 29 0F			and #$0F							; (Ord >> 1) & 15
  1064 550F 18				clc
  1065 5510 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1066 5512 85 89			sta Ptr_Hi
  1067 5514 AD E1 04			lda Nfo_Name_Ord
  1068 5517 4A				lsr
  1069 5518 4A				lsr
  1070 5519 4A				lsr
  1071 551A 4A				lsr
  1072 551B 4A				lsr									; Ord >> 5  (0..7)
