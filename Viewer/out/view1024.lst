   595 4FAE 85 8A			sta Name_Ptr
   596 4FB0 90 02			bcc UI_Apply_TP_Pass_Next
   597 4FB2 E6 8B			inc Name_Ptr+1
   598 4FB4			UI_Apply_TP_Pass_Next
   599 4FB4 CA				dex
   600 4FB5 D0 DC			bne UI_Apply_TP_Pass_L1
   601 4FB7 60				rts
