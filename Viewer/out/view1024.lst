    96 37E3 85 89			sta Ptr_Hi
    97 37E5 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
    98 37E7 85 80			sta Reg1
    99 37E9 A9 28			lda #>[VBXE_WINDOW + $800]
   100 37EB 85 81			sta Reg2
   101 37ED 20 F7 37			jsr Text_Copy_2K
