   503 5031 9D 8D 04			sta Path_Buf,x
   504 5034 E8				inx
   505 5035			Emit_Path_Prefix_Colon
   506 5035 A9 3A			lda #':'
   507 5037 9D 8D 04			sta Path_Buf,x
   508 503A E8				inx
   509 503B A0 00			ldy #$00
   510 503D			Emit_Path_Prefix_L1
   511 503D B9 28 06			lda Scan_Path,y
   512 5040 F0 09			beq Emit_Path_Prefix_Done
   513 5042 9D 8D 04			sta Path_Buf,x
   514 5045 E8				inx
   515 5046 C8				iny
   516 5047 C0 28			cpy #$28
   517 5049 90 F2			bcc Emit_Path_Prefix_L1
   518 504B			Emit_Path_Prefix_Done
