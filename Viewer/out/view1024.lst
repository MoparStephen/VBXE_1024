     8 2011 11 FF			dta	%00010001,$FF					; XDLC_OVATT (2 bytes)  
     9 				;		 76543210  76543210
    10 2013 00 80			dta %00000000,%10000000				; XDLC (2 Bytes) - End of XDL, wait for VSYNC
