   650 				; lands between frames.  Returns at once if already in vblank.  No key handling
   651 				; (unlike Wait_For_Sync).
   652 				;-----------------------------------------------------------------------------
   653 34DD			Wait_VBlank
   654 34DD AD 0B D4			lda VCOUNT
   655 34E0 C9 7C			cmp #$7C
   656 34E2 90 F9			bcc Wait_VBlank						; still drawing the visible area
   657 34E4 60				rts
   658
