Source: xdl.asm
     1 				; With Attribute Map (for displaying image with the 40*240 cell attribute map on)
     2 2000			XDL_Image_Attribute						; Graphics mode,SD resolution, 240 lines, start at $01000, $140 bytes/line
     3 				;		 76543210  76543210
     4 2000-2078> 6A 0E			dta %01101010,%00001110				; XDLC (2 Bytes)
     5 2002 EE				dta $EE								; XDLC_RPTL (1 byte)    No change for $EF(239) lines
     6 2003 00 10 00 40 01		dta $00,$10,$00,$40,$01				; XDLC_OVADR (5 bytes)  Start @ $001000, Step $0140, End @ $13BFF
     7 2008 00 70 01 A0 00		dta $00,$70,$01,$A0,$00				; XDLC_MAPADR (5 bytes) Start @ $017000, Step $00A0, End @ $
     8 200D 00 00 07 00			dta $00,$00,$07,$00					; XDLC_MAPPAR (4 bytes) No Scroll, size 8x1
     9 2011 11 FF			dta %00010001,$FF					; XDLC_OVATT (2 bytes)
    10 				;		 76543210  76543210
    11 2013 00 80			dta %00000000,%10000000				; XDLC (2 Bytes) - End of XDL, wait for VSYNC
    12
    13 				; Without Attribute Map (for displaying image using 1 palette)
    14 2015			XDL_Image_Normal						; Graphics mode,SD resolution, 240 lines, start at $01000, $140 bytes/line
    15 				;		 76543210
    16 2015 72				dta %01110010						; XDLC Byte 1 $72 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    17 2016 08				dta %00001000						; XDLC Byte 2 $08 (XDLC_ATT)
    18 2017 EE				dta $EE								; XDLC_RPTL (1 byte)    No change for $EF(239) lines
    19 2018 00 10 00 40 01		dta $00,$10,$00,$40,$01				; XDLC_OVADR (5 bytes)  Start @ $001000, Step $0140, End @ $13BFF
    20 201D 11 FF			dta %00010001,$FF					; XDLC_OVATT (2 bytes)  
    21 				;		 76543210  76543210
    22 201F 00 80			dta %00000000,%10000000				; XDLC (2 Bytes) - End of XDL, wait for VSYNC
    23
    24 				; VBXE hardware split-screen menu/info XDL - banner + main text + separator +
    25 				; footer text + separator, framed by blank borders.  Used by both the file
    26 				; selector (UI_Mode 0) and the info/.nfo viewer (UI_Mode 4); the image viewer
    27 				; (XDL_Image_Attribute/Normal above) is untouched.  Font/screen/pitch equates
    28 				; all come from view1024.asm's .def block so this XDL and text80.asm cannot
    29 				; drift.  OV_PALETTE = 0 (ui.asm's Restore_Palette0 keeps standard PAL/NTSC
    30 				; colours in palette 0); the banner's attribute map lives in its own
    31 				; dedicated, resident MENU_BANNER_MAP_VRAM (loaded once at boot, never the
    32 				; shared CRAM $017000 the image viewer uses) so it never needs a reload.
    33 				; Only the banner's palette REGISTERS (1-3) need a per-Enter_Selector
    34 				; refresh - a cheap resident-VRAM-to-register copy, no disk access - since
    35 				; VBXE has exactly 4 physical palette registers total and Load_Image
    36 				; legitimately overwrites them for every real image viewed; see
    37 				; Apply_Menu_Banner_Palette (view1024.asm).
    38 				;
    39 				; 239-scanline layout (confirmed with Stephen; down from the original 240
    40 				; due to the extra separator block added under the banner):
    41 				;   8  blank (top border)
    42 				;  34  med-res graphics + attribute map (banner)                  MENU_BANNER_VRAM
    43 				;   1  lo-res graphics, no attribute map (separator)               MENU_SEP_VRAM
    44 				;   1  blank
    45 				; 160  text, 20 rows (main content: grid / Location / NFO scroll) TEXT_SCREEN_VRAM
    46 				;   1  lo-res graphics, no attribute map (separator, same image)   MENU_SEP_VRAM
    47 				;   1  blank
    48 				;  24  text, 3 rows (footer: status/delay/legend, or info hint)   TEXT_FOOTER_VRAM
    49 				;   1  lo-res graphics, no attribute map (separator, same image)   MENU_SEP_VRAM
    50 				;   8  blank (bottom border)
    51 				;  ---
    52 				; 239  total
    53 2021			XDL_MainMenu
    54 				; Blank-group encoding (XDLC_OVOFF|XDLC_MAPOFF|XDLC_RPTL, no OVADR/OVATT) and
    55 				; the RPTL = scanlines-1 formula both come from Stephen's own working draft.
    56 				;		 76543210
    57 				; --- Block 1: 8 blank scanlines (top border) --------------------------------
    58 2021 34				dta %00110100						; XDLC Byte 1 $34 (XDLC_OVOFF | XDLC_MAPOFF | XDLC_RPTL)
    59 2022 00				dta $00								; XDLC Byte 2 (no ATT/CHBASE)
    60 2023 07				dta $07								; XDLC_RPTL = 8-1
    61
    62 				; --- Block 2: 34 med-res scanlines, banner (attribute-mapped) --------------
    63 2024 6A 0E			dta %01101010,%00001110			; XDLC (GMON|MAPON|RPTL|OVADR, ATT) - matches XDL_Image_Attribute
    64 2026 21				dta $21								; XDLC_RPTL = 34-1
    65 2027 00 00 03 40 01		dta <MENU_BANNER_VRAM, >MENU_BANNER_VRAM, MENU_BANNER_VRAM >> 16, <MENU_BANNER_PITCH, >MENU_BANNER_PITCH
    66 202C 00 50 03 A0 00		dta <MENU_BANNER_MAP_VRAM, >MENU_BANNER_MAP_VRAM, MENU_BANNER_MAP_VRAM >> 16, <$00A0, >$00A0	; XDLC_MAPADR (5 bytes) - dedicated, resident (NOT shared CRAM), Step $00A0
    67 2031 00 00 07 00			dta $00,$00,$07,$00					; XDLC_MAPPAR (4 bytes) No Scroll, size 8x1
    68 2035 11 FE			dta %00010001,$FE					; XDLC_OVATT (2 bytes)  Priority $FE (per Stephen's draft)
    69
    70 				; --- Block 3: 1 lo-res scanline, separator (no attribute map) --------------
    71 				; OV_WIDTH=00 (vs the banner/text's 01) for the narrower 160-byte/row lo-res
    72 				; pitch - UNVERIFIED, tune against Altirra alongside the RPTL/chaining checks
    73 				; this whole XDL already needs (see the implementation plan's risk notes).
    74 2037 72				dta %01110010						; XDLC Byte 1 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    75 2038 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    76 2039 00				dta $00								; XDLC_RPTL = 1-1
    77 203A 00 30 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
    78 203F 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
    79
    80 				; --- Block 4: 1 blank scanline ----------------------------------------------
    81 2041 34				dta %00110100
    82 2042 00				dta $00
    83 2043 00				dta $00								; XDLC_RPTL = 1-1
    84
    85 				; --- Block 5: 160 text scanlines, 20 rows (main content) -------------------
    86 2044 71				dta %01110001						; XDLC Byte 1 (XDLC_TMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    87 2045 09				dta %00001001						; XDLC Byte 2 (XDLC_CHBASE | XDLC_ATT)
    88 2046 9F				dta $9F								; XDLC_RPTL = 160-1
    89 2047 00 30 02 A0 00		dta <TEXT_SCREEN_VRAM, >TEXT_SCREEN_VRAM, TEXT_SCREEN_VRAM >> 16, <TEXT_PITCH, >TEXT_PITCH
    90 204C			XDL_MainMenu_CHBase						; Toggle_Font pokes this byte - see text80.asm
    91 204C 44				dta TEXT_CHBASE						; XDLC_CHBASE (1 byte)  font @ TEXT_FONT_VRAM
    92 204D 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=01 | OV_PALETTE=00 ; Priority $FE
    93
    94 				; --- Block 6: 1 lo-res scanline, separator (same image as Block 3) ---------
    95 204F 72				dta %01110010						; XDLC Byte 1 (XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR)
    96 2050 28				dta %00101000						; XDLC Byte 2 (XDLC_ATT | XDLC_LR)
    97 2051 00				dta $00								; XDLC_RPTL = 1-1
    98 2052 00 30 03 A0 00		dta <MENU_SEP_VRAM, >MENU_SEP_VRAM, MENU_SEP_VRAM >> 16, <MENU_SEP_PITCH, >MENU_SEP_PITCH
    99 2057 01 FE			dta %00000001,$FE					; XDLC_OVATT (2 bytes)  OV_WIDTH=00 (lo-res) | OV_PALETTE=00 ; Priority $FE
   100
   101 				; --- Block 7: 1 blank scanline ----------------------------------------------
   102 2059 34				dta %00110100
   103 205A 00				dta $00
   104 205B 00				dta $00								; XDLC_RPTL = 1-1
   105
   106 				; --- Block 8: 24 text scanlines, 3 rows (footer) ----------------------------
   107 205C 71				dta %01110001
