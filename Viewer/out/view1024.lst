  1523 				;-----------------------------------------------------------------------------
  1524 				; Sort_Range - in-place alphabetical selection sort of the records
  1525 				; [start .. start+count) in IMAGE_BANK (8-byte space-padded, lexicographic).
  1526 				;   In:  A = start index, X = count.  count < 2 -> no-op.
  1527 				; Rescan_Images (ui.asm) calls it once per group (dirs, then files) so the
  1528 				; ".." / dir / file grouping is preserved.  O(n^2) byte compares; trivial.
  1529 				; Clobbers A/X/Y, Reg2..Reg6, Name_Ptr, Sort_Ptr, Path_Buf[0..7].
  1530 				;-----------------------------------------------------------------------------
  1531 3A30			Sort_Range
  1532 3A30 E0 02			cpx #$02
  1533 3A32 90 67			bcc Sort_Range_Done					; 0 or 1 records -> nothing to do
  1534 3A34 85 81			sta Reg2							; Reg2 = i = start
  1535 3A36 86 82			stx Reg3							; Reg3 = count (temp)
  1536 3A38 18				clc
  1537 3A39 65 82			adc Reg3
  1538 3A3B 85 84			sta Reg5							; Reg5 = end = start + count
  1539 3A3D 38				sec
  1540 3A3E E9 01			sbc #$01
  1541 3A40 85 85			sta Reg6							; Reg6 = end - 1 (outer limit)
  1542
  1543 3A42 A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
  1544 3A44				vbsta VBXE_MA_BSEL
