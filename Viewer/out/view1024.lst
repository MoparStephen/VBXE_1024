   770 359A 8D E3 04			sta Seg_Bank
   771 359D 8E E4 04			stx Seg_Chunks
   772 35A0			Image_Read_Segment_L1
   773 35A0 AD E4 04			lda Seg_Chunks
   774 35A3 F0 0F			beq Image_Read_Segment_Tail
   775 35A5 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   776 35A7 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   777 35A9 20 C7 35			jsr Image_Read_Chunk
   778 35AC B0 18			bcs Image_Read_Segment_Done
   779 35AE CE E4 04			dec Seg_Chunks
   780 35B1 4C A0 35			jmp Image_Read_Segment_L1
   781
   782 35B4			Image_Read_Segment_Tail
   783 35B4 AD E5 04			lda Seg_Tail
   784 35B7 0D E6 04			ora Seg_Tail + $01
   785 35BA F0 09			beq Image_Read_Segment_OK			; no partial chunk
   786 35BC AD E5 04			lda Seg_Tail
   787 35BF AC E6 04			ldy Seg_Tail + $01
   788 35C2 4C C7 35			jmp Image_Read_Chunk
   789
   790 35C5			Image_Read_Segment_OK
   791 35C5 18				clc
   792 35C6			Image_Read_Segment_Done
   793 35C6 60				rts
