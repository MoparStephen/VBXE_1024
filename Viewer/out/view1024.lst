   750 34A5 A9 00			lda #<VBXE_WINDOW_SIZE_4k
   751 34A7 A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   752 34A9 20 C7 34			jsr Image_Read_Chunk
   753 34AC B0 18			bcs Image_Read_Segment_Done
