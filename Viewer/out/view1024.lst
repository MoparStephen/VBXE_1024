   498 				;=============================================================================
   499 				; Selector screen
   500 				;=============================================================================
   501
   502 				;-----------------------------------------------------------------------------
   503 				; Enter_Selector - restore Palette 0 for text, refresh the menu banner's
   504 				; palette registers 1-3 (Load_Image overwrites them for every real image
   505 				; viewed in between - a cheap resident-VRAM-to-register copy, no disk access;
   506 				; see Apply_Menu_Banner_Palette in view1024.asm), show the text screen, draw
   507 				; it.  Reached from start: (jsr), Handle_Escape (jsr), Slide_Key_Stop (jsr)
   508 				; and Info_Key_Leave (jsr) - always returns.
   509 				;-----------------------------------------------------------------------------
   510 503F			Enter_Selector
   511 503F 20 15 32			jsr Restore_Palette0				; standard PAL/NTSC master palette -> set 0
   512 5042 20 54 50			jsr UI_Apply_TextPalette			; ...then de-interleave it for text mode
   513 5045 20 47 35			jsr Apply_Menu_Banner_Palette		; refresh the banner's palette registers 1-3
   514 5048 20 E8 3A			jsr Text_Activate					; point the XDL at the menu/info screen
   515 504B A9 00			lda #$00
   516 504D 8D C6 04			sta UI_Mode
   517 5050 20 D3 50			jsr Selector_Draw
   518 5053 60				rts
   519
   520 				;-----------------------------------------------------------------------------
   521 				; UI_Apply_TextPalette - Restore_Palette0 has just put the standard Atari 256-
   522 				; colour master into palette set 0.  The VBXE text mode can only reach entries
   523 				; 0-127 as a foreground, and in the master that range is hues 0-7 (no green).
   524 				; De-interleave it so:
   525 				;     entry e        (0..127) = master colour 2e    (all 16 hues, even lumas)
   526 				;     entry 128+e             = master colour 2e+1  (odd lumas - inverse bg)
   527 				; Build a page-aligned 768-byte image at VBXE $00800 (free: NTSC master
   528 				; $00200-$004FF, PAL master $00500-$007FF, VRAM from $01000) and re-upload it
   529 				; as set 0.  Runs only on entry to the selector - not per frame.
   530 				; Restore_Palette0 itself is left untouched so the DOS-exit path still restores
   531 				; the true master.  Clobbers A/X/Y, Ptr_Lo/Hi, Name_Ptr, Y_Register.
   532 				;-----------------------------------------------------------------------------
   533 = 2800			UI_APPLY_TP_BUF		= VBXE_WINDOW + $800		; page-aligned de-interleave buffer
   534
   535 5054			UI_Apply_TextPalette
   536 5054 A9 80			lda #$00 | MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the window
   537 5056				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
