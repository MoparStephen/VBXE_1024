   557 				; Ptr_Lo/Hi = active master base ($2500 PAL / $2200 NTSC), mirrors Restore_Palette0
   558 4F7A			UI_Apply_TP_SrcBase
   559 4F7A AD 89 04			lda Video_Flag						; 0 = PAL, non-zero = NTSC
   560 4F7D D0 09			bne UI_Apply_TP_SrcNTSC
   561 4F7F A9 00			lda #<(VBXE_WINDOW + $500)
   562 4F81 85 88			sta Ptr_Lo
   563 4F83 A9 25			lda #>(VBXE_WINDOW + $500)
   564 4F85 85 89			sta Ptr_Hi
   565 4F87 60				rts
