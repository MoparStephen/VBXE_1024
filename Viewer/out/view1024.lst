   308 				;-----------------------------------------------------------------------------
   309 				; Text_FillColour - recolour a rectangle of cells by flooding their attribute
   310 				; (odd) bytes.  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   311 				; (cells), Reg2 = height-1 (rows), A = attribute byte.  Patches BLT_FILL_COLOUR
   312 				; (dest address, Width-1, Height-1, Xor mask) then kicks it and waits.
   313 				;-----------------------------------------------------------------------------
   314 3E57			Text_FillColour
   315 3E57 85 82			sta Reg3							; Reg3 = attribute (Xor mask / fill value)
   316 3E59 A9 01			lda #$01
   317 3E5B 8D B7 06			sta Txt_Dirty
   318 				; Reg5:Reg4 = Txt_Row * TEXT_PITCH + Txt_Col*2 + 1  (attribute byte offset)
   319 3E5E A9 00			lda #$00
   320 3E60 85 83			sta Reg4
   321 3E62 85 84			sta Reg5
   322 3E64 AE B0 06			ldx Txt_Row
   323 3E67 F0 0E			beq Text_FillColour_Col
   324 3E69			Text_FillColour_RowL
   325 3E69 A5 83			lda Reg4
   326 3E6B 18				clc
   327 3E6C 69 A0			adc #TEXT_PITCH						; + 160 per row
   328 3E6E 85 83			sta Reg4
   329 3E70 90 02			bcc Text_FillColour_RowNC
   330 3E72 E6 84			inc Reg5
   331 3E74			Text_FillColour_RowNC
   332 3E74 CA				dex
   333 3E75 D0 F2			bne Text_FillColour_RowL
   334 3E77			Text_FillColour_Col
   335 3E77 AD B1 06			lda Txt_Col
   336 3E7A 0A				asl									; Txt_Col * 2
   337 3E7B 18				clc
   338 3E7C 65 83			adc Reg4
   339 3E7E 85 83			sta Reg4
   340 3E80 90 02			bcc Text_FillColour_ColNC
   341 3E82 E6 84			inc Reg5
   342 3E84			Text_FillColour_ColNC
   343 3E84 E6 83			inc Reg4							; + 1  -> the attribute (odd) byte
   344 3E86 D0 02			bne Text_FillColour_Patch
   345 3E88 E6 84			inc Reg5
   346 3E8A			Text_FillColour_Patch
   347 3E8A A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   348 3E8C				vbsta VBXE_MA_BSEL
