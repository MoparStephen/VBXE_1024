  1057 5416 A9 05			lda #CIO_gettext
  1058 5418 9D 42 03			sta ICCOM,x
  1059 541B A9 50			lda #<Nfo_Name_Line
  1060 541D 9D 44 03			sta ICBAL,x
  1061 5420 A9 06			lda #>Nfo_Name_Line
  1062 5422 9D 45 03			sta ICBAH,x
  1063 5425 A9 54			lda #8+NFO_NAME_CAP+1				; buffer length (8 key + 75 desc + $9B = 84)
  1064 5427 9D 48 03			sta ICBLL,x
  1065 542A A9 00			lda #$00
  1066 542C 9D 49 03			sta ICBLH,x
  1067 542F 20 56 E4			jsr CIOV
  1068 5432 10 04			bpl Nfo_Name_LoadManifest_Got
  1069 5434 C0 89			cpy #$89							; 137 = record over 84 bytes: CIO kept the first 84
  1070 5436 D0 2C			bne Nfo_Name_LoadManifest_Close		; EOF / real error -> stop
