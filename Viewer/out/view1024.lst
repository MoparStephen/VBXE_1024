  1139 5533 9D 42 03			sta ICCOM,x
  1140 5536 A9 50			lda #<Nfo_Name_Line
  1141 5538 9D 44 03			sta ICBAL,x
  1142 553B A9 06			lda #>Nfo_Name_Line
  1143 553D 9D 45 03			sta ICBAH,x
