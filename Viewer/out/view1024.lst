   738 				;-----------------------------------------------------------------------------
   739 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   740 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   741 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   742 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   743 				;-----------------------------------------------------------------------------
   744 349A			Image_Read_Segment
