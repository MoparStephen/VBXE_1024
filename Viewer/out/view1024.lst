   955 525F 8E C5 04			stx Dir_IOCB
   956 5262 A9 04			lda #CIO_read						; AUX1 = 4 : plain file, read
   957 5264 9D 4A 03			sta ICAX1,x
   958 5267 A9 00			lda #$00
   959 5269 9D 4B 03			sta ICAX2,x
   960 526C A9 50			lda #<Scan_Spec
   961 526E 9D 44 03			sta ICBAL,x
   962 5271 A9 06			lda #>Scan_Spec
   963 5273 9D 45 03			sta ICBAH,x
   964 5276 A9 03			lda #CIO_open
   965 5278 9D 42 03			sta ICCOM,x
   966 527B 20 56 E4			jsr CIOV
   967 527E 30 58			bmi Nfo_Name_LoadManifest_Done		; no IMAGES.LST here
   968
   969 5280			Nfo_Name_LoadManifest_Line
   970 5280 AE C5 04			ldx Dir_IOCB
   971 5283 A9 05			lda #CIO_gettext
   972 5285 9D 42 03			sta ICCOM,x
   973 5288 A9 B7			lda #<Nfo_Name_Line
   974 528A 9D 44 03			sta ICBAL,x
   975 528D A9 06			lda #>Nfo_Name_Line
   976 528F 9D 45 03			sta ICBAH,x
   977 5292 A9 3A			lda #58								; buffer length (8 key + 48 name + $9B, rounded)
   978 5294 9D 48 03			sta ICBLL,x
   979 5297 A9 00			lda #$00
   980 5299 9D 49 03			sta ICBLH,x
   981 529C 20 56 E4			jsr CIOV
