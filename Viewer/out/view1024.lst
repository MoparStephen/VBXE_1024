   336 3EF9 0A				asl									; Txt_Col * 2
   337 3EFA 18				clc
   338 3EFB 65 83			adc Reg4
   339 3EFD 85 83			sta Reg4
   340 3EFF 90 02			bcc Text_FillColour_ColNC
   341 3F01 E6 84			inc Reg5
   342 3F03			Text_FillColour_ColNC
