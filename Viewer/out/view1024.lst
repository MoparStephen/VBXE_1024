  1040
  1041 3664 A9 A0			lda #<[MENU_DEMO_ROW_BOT*MENU_ATTR_ROW_BYTES]
  1042 3666 85 80			sta Reg1
  1043 3668 A9 0A			lda #>[MENU_DEMO_ROW_BOT*MENU_ATTR_ROW_BYTES]
  1044 366A 85 81			sta Reg2
  1045 366C A9 49			lda #<Menu_Demo_Attr_Bot_Vals
  1046 366E 85 88			sta Ptr_Lo
  1047 3670 A9 36			lda #>Menu_Demo_Attr_Bot_Vals
  1048 3672 85 89			sta Ptr_Hi
  1049 3674 20 7E 36			jsr Set_Menu_Demo_Attr_Band
