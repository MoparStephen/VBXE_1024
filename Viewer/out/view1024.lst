   383 				;-----------------------------------------------------------------------------
   384 				; Text_Window_Save / Text_Window_Restore - blit a rectangle of {glyph,attr}
   385 				; cells between the (back buffer) text screen and WIN_SAVE_VRAM (a save-under buffer held at
   386 				; screen pitch).  Inputs: Txt_Row / Txt_Col = top-left cell, Reg1 = width-1
   387 				; (cells), Reg2 = height-1 (rows).  Patches BLT_TEXT_RECT and waits.  The rect
   388 				; must fit WIN_SAVE_VRAM: 4K / TEXT_PITCH = 25 rows max.
   389 				; Clobbers A/X/Y, Reg4, Reg5.  (Reg1 / Reg2 / Txt_Row / Txt_Col survive - the
   390 				; caller can Save then Frame on the same geometry.)
   391 				;-----------------------------------------------------------------------------
   392 3EE0			Text_Window_Save
   393 3EE0 20 33 3F			jsr Text_Window_Setup				; Reg5:Reg4 = screen offset; W-1/H-1 patched; bank mapped
   394 3EE3 A5 83			lda Reg4
   395 3EE5 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   396 3EE8 A5 84			lda Reg5
   397 3EEA 18				clc
   398 3EEB 69 A0			adc #>TEXT_BACK_VRAM				; back buffer mid byte (offset < $1000, no carry)
   399 3EED 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   400 3EF0 A9 02			lda #[TEXT_BACK_VRAM >> 16]
   401 3EF2 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   402 3EF5 A9 00			lda #<WIN_SAVE_VRAM
   403 3EF7 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   404 3EFA A9 F0			lda #>WIN_SAVE_VRAM
   405 3EFC 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   406 3EFF A9 02			lda #[WIN_SAVE_VRAM >> 16]
   407 3F01 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   408 3F04 4C 73 3F			jmp Text_Window_Kick
   409
   410 3F07			Text_Window_Restore
   411 3F07 A9 01			lda #$01
   412 3F09 8D B7 06			sta Txt_Dirty
   413 3F0C 20 33 3F			jsr Text_Window_Setup
   414 3F0F A9 00			lda #<WIN_SAVE_VRAM
   415 3F11 8D 7E 21			sta BLT_TEXT_RECT + Src_Adr0
   416 3F14 A9 F0			lda #>WIN_SAVE_VRAM
   417 3F16 8D 7F 21			sta BLT_TEXT_RECT + Src_Adr1
   418 3F19 A9 02			lda #[WIN_SAVE_VRAM >> 16]
   419 3F1B 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   420 3F1E A5 83			lda Reg4
   421 3F20 8D 84 21			sta BLT_TEXT_RECT + Dest_Adr0
   422 3F23 A5 84			lda Reg5
   423 3F25 18				clc
   424 3F26 69 A0			adc #>TEXT_BACK_VRAM
   425 3F28 8D 85 21			sta BLT_TEXT_RECT + Dest_Adr1
   426 3F2B A9 02			lda #[TEXT_BACK_VRAM >> 16]
   427 3F2D 8D 86 21			sta BLT_TEXT_RECT + Dest_Adr2
   428 3F30 4C 73 3F			jmp Text_Window_Kick
   429
   430 				; Reg5:Reg4 = Txt_Row*TEXT_PITCH + Txt_Col*2 ; patch Width-1 (bytes) + Height-1 ;
   431 				; map VBXE bank $00 into the $2000 window (Text_Window_Kick unmaps).
   432 3F33			Text_Window_Setup
   433 3F33 A9 00			lda #$00
   434 3F35 85 83			sta Reg4
   435 3F37 85 84			sta Reg5
   436 3F39 AE B0 06			ldx Txt_Row
   437 3F3C F0 0E			beq Text_Window_Setup_Col
   438 3F3E			Text_Window_Setup_RowL
   439 3F3E A5 83			lda Reg4
   440 3F40 18				clc
   441 3F41 69 A0			adc #TEXT_PITCH
   442 3F43 85 83			sta Reg4
   443 3F45 90 02			bcc Text_Window_Setup_RowNC
   444 3F47 E6 84			inc Reg5
   445 3F49			Text_Window_Setup_RowNC
   446 3F49 CA				dex
   447 3F4A D0 F2			bne Text_Window_Setup_RowL
   448 3F4C			Text_Window_Setup_Col
   449 3F4C AD B1 06			lda Txt_Col
   450 3F4F 0A				asl
   451 3F50 18				clc
   452 3F51 65 83			adc Reg4
   453 3F53 85 83			sta Reg4
   454 3F55 90 02			bcc Text_Window_Setup_ColNC
   455 3F57 E6 84			inc Reg5
   456 3F59			Text_Window_Setup_ColNC
   457 3F59 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3F5B				vbsta VBXE_MA_BSEL
