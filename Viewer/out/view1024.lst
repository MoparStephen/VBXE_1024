  2007 				;-----------------------------------------------------------------------------
  2008 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  2009 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  2010 				; equal) otherwise.
  2011 				;-----------------------------------------------------------------------------
  2012 3D08			Cmp_Records
  2013 3D08 A0 00			ldy #$00
  2014 3D0A			Cmp_Records_L1
  2015 3D0A B1 8A			lda (Name_Ptr),y
  2016 3D0C D1 8C			cmp (Sort_Ptr),y
  2017 3D0E D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  2018 3D10 C8				iny
  2019 3D11 C0 08			cpy #$08
  2020 3D13 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  2021 3D15			Cmp_Records_Done
  2022 3D15 60				rts
  2023
  2024 				;-----------------------------------------------------------------------------
  2025 				; Swap_Records - exchange the 8-byte records at (Name_Ptr) and (Sort_Ptr),
  2026 				; using Path_Buf as scratch.
  2027 				;-----------------------------------------------------------------------------
  2028 3D16			Swap_Records
  2029 3D16 A0 00			ldy #$00
  2030 3D18			Swap_Records_L1
  2031 3D18 B1 8A			lda (Name_Ptr),y
  2032 3D1A 99 8D 04			sta Path_Buf,y
  2033 3D1D B1 8C			lda (Sort_Ptr),y
  2034 3D1F 91 8A			sta (Name_Ptr),y
  2035 3D21 B9 8D 04			lda Path_Buf,y
  2036 3D24 91 8C			sta (Sort_Ptr),y
  2037 3D26 C8				iny
  2038 3D27 C0 08			cpy #$08
  2039 3D29 90 ED			bcc Swap_Records_L1
  2040 3D2B 60				rts
  2041
