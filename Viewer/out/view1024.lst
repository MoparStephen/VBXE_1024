  2812 6223 C9 20			cmp #' '
  2813 6225 F0 09			beq Folder_Path_Push_Sep
  2814 6227 9D 28 06			sta Scan_Path,x
  2815 622A E8				inx
  2816 622B C8				iny
  2817 622C C0 08			cpy #$08
  2818 622E 90 EE			bcc Folder_Path_Push_L1
  2819 6230			Folder_Path_Push_Sep
  2820 6230 A9 3E			lda #'>'
  2821 6232 9D 28 06			sta Scan_Path,x
  2822 6235 E8				inx
  2823 6236 A9 00			lda #$00
  2824 6238 9D 28 06			sta Scan_Path,x
  2825 623B 60				rts
