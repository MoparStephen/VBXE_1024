   734 				;-----------------------------------------------------------------------------
   735 				; Load_Image
   736 				; File_Index must be set before calling this!  No range checking is done!
   737 				; One OPEN of D:<name>.V1K, three sequential block reads:
   738 				;   .PAL block -> $21000, pushed to palette registers 0-3
   739 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   740 				;   .RAW block -> $01000 framebuffer
   741 				; A missing or short file stops at the failing block and closes the IOCB.
   742 				;-----------------------------------------------------------------------------
   743 3551			Load_Image
   744 3551 A9 00			lda #$00							; ext 0 = .V1K
   745 3553 20 1D 3C			jsr Build_Filename
   746 3556 20 A5 35			jsr Image_Open
   747 3559 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   748
   749 355B 20 94 35			jsr Image_Read_Pal
   750 355E B0 2A			bcs Load_Image_Close
   751 3560 20 0C 35			jsr Apply_Image_Palette
   752
   753 3563 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   754 3565 A2 02			ldx #V1K_MAP_LEN / $1000
   755 3567 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   756 3569 8C E5 04			sty Seg_Tail
   757 356C A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   758 356E 8C E6 04			sty Seg_Tail + $01
   759 3571 20 D6 35			jsr Image_Read_Segment
   760 3574 B0 14			bcs Load_Image_Close
   761 3576 20 91 34			jsr Setup_Cmap1						; Expand the data out to $17000
   762
   763 3579 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   764 357B A2 12			ldx #V1K_RAW_LEN / $1000
   765 357D A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   766 357F 8C E5 04			sty Seg_Tail
   767 3582 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   768 3584 8C E6 04			sty Seg_Tail + $01
   769 3587 20 D6 35			jsr Image_Read_Segment
   770
   771 358A			Load_Image_Close
   772 358A 20 31 36			jsr Image_Close
   773
   774 358D			Load_Image_Done
   775 358D A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   776 358F				vbsta VBXE_MA_BSEL
