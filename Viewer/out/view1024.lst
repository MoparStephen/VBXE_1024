  1050 				;-----------------------------------------------------------------------------
  1051 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
  1052 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
  1053 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
  1054 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
  1055 				;-----------------------------------------------------------------------------
  1056 5775			Nfo_Name_MapSlot
  1057 5775 AD E1 04			lda Nfo_Name_Ord
  1058 5778 4A				lsr									; C = Ord & 1
  1059 5779 A9 00			lda #$00
  1060 577B 6A				ror									; A = (Ord & 1) << 7
  1061 577C 85 88			sta Ptr_Lo
  1062 577E AD E1 04			lda Nfo_Name_Ord
  1063 5781 4A				lsr
  1064 5782 29 0F			and #$0F							; (Ord >> 1) & 15
  1065 5784 18				clc
  1066 5785 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1067 5787 85 89			sta Ptr_Hi
  1068 5789 AD E1 04			lda Nfo_Name_Ord
  1069 578C 4A				lsr
  1070 578D 4A				lsr
  1071 578E 4A				lsr
  1072 578F 4A				lsr
  1073 5790 4A				lsr									; Ord >> 5  (0..7)
  1074 5791 18				clc
  1075 5792 69 37			adc #NFO_NAME_BANK
  1076 5794 09 80			ora #MEMAC_GLOBAL_ENABLE
  1077 5796				vbsta VBXE_MA_BSEL
