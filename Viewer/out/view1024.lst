  1256 5516 A0 08			ldy #$08
  1257 5518 A9 20			lda #' '
  1258 551A 99 CD 04			sta Name_Row_Buf,y
  1259 551D C8				iny
  1260 551E 99 CD 04			sta Name_Row_Buf,y
  1261 5521 C8				iny
