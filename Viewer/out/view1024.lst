  1438 				;-----------------------------------------------------------------------------
  1439 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1440 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1441 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1442 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1443 				;-----------------------------------------------------------------------------
  1444 5379			Sel_Top_For_Index
  1445 5379 4A				lsr
  1446 537A 4A				lsr
  1447 537B 4A				lsr
  1448 537C 85 80			sta Reg1							; Reg1 = target item_row
  1449 537E AD C8 04			lda Sel_Top
  1450 5381 4A				lsr
  1451 5382 4A				lsr
  1452 5383 4A				lsr								; A = current top_row
  1453 5384 C5 80			cmp Reg1
  1454 5386 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1455 5388 F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1456 538A A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1457 538C 4C 9B 53			jmp Sel_Top_FI_Scale
  1458 538F			Sel_Top_FI_MaybeDown
  1459 538F 18				clc
  1460 5390 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1461 5392 C5 80			cmp Reg1
  1462 5394 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1463 5396 A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1464 5398 38				sec
  1465 5399 E9 0E			sbc #[UI_VISROWS-1]
  1466 539B			Sel_Top_FI_Scale
  1467 539B 0A				asl
  1468 539C 0A				asl
  1469 539D 0A				asl								; row -> Sel_Top (* UI_COLS)
  1470 539E 60				rts
  1471 539F			Sel_Top_FI_Unchanged
  1472 539F AD C8 04			lda Sel_Top
  1473 53A2 60				rts
