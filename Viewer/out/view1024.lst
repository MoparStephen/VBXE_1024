   921 				; Attribute-cell byte offsets (within a 160-byte expanded map row) for the 8
   922 				; columns the demo overlay covers - cell*4+3 (the real attribute byte; the
   923 				; other 3 bytes/cell are always zero - see Setup_Menu_Cmap/BLT_SETUP_MENU_
   924 				; CMAP).  Left-edge block = cells 0-3 (pixels 0-31); right-edge block = cells
   925 				; 36-39 (pixels 288-319, since MENU_BANNER_PITCH/8 = 40 cells/row).
   926 35E9			Menu_Demo_Attr_Cols
   927 35E9 03 07 0B 0F 93 97 + 	dta 3,7,11,15,147,151,155,159
   928 				; Same column order: TL/TR pal ids (<<4), left edge then right edge. Right
   929 				; edge is horizontally mirrored (pal 1,0 instead of 0,1) so the right-hand
   930 				; copy reads as a flipped reflection of the left-hand one; the underlying
   931 				; pixel data (Menu_Demo_Dest_Table) is untouched, only which palette
   932 				; register each cell points at changes.
   933 35F1			Menu_Demo_Attr_Top_Vals
   934 35F1 00 00 10 10 10 10 + 	dta $00,$00,$10,$10,$10,$10,$00,$00
   935 				; Same column order: BL/BR pal ids (<<4), left edge then right edge (mirrored:
   936 				; pal 3,2 instead of 2,3 - see note above).
   937 35F9			Menu_Demo_Attr_Bot_Vals
   938 35F9 20 20 30 30 30 30 + 	dta $20,$20,$30,$30,$30,$30,$20,$20
