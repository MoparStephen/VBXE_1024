  2146 5ACF C9 20			cmp #KEY_COMMA
  2147 5AD1 D0 03			bne InfK_3
  2148 5AD3 4C 1A 5B			jmp Info_Key_PageUp
  2149 5AD6			InfK_3
  2150 5AD6 C9 22			cmp #KEY_DOT
  2151 5AD8 D0 03			bne InfK_4
  2152 5ADA 4C 38 5B			jmp Info_Key_PageDown
  2153 5ADD			InfK_4							; Q does not quit here - Selector only
  2154 5ADD C9 1C			cmp #KEY_ESC
  2155 5ADF F0 07			beq Info_Key_Leave
  2156 5AE1 C9 0D			cmp #KEY_I
  2157 5AE3 F0 03			beq Info_Key_Leave
  2158 5AE5 4C 8F 38			jmp Read_Key_Done
  2159 5AE8			Info_Key_Leave
  2160 5AE8 20 F6 4F			jsr Enter_Selector
  2161 5AEB 4C 8F 38			jmp Read_Key_Done
