   513 				; --- write the cells -------------------------------------------------------
   514 3D46 A9 00			lda #$00
   515 3D48 85 82			sta Reg3							; Reg3 = source string index
   516 3D4A AD B1 06			lda Txt_Col
   517 3D4D 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   518 3D4F			Text_PutStrAt_Char
   519 3D4F A5 83			lda Reg4
   520 3D51 C9 50			cmp #TEXT_COLS
   521 3D53 B0 39			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   522 3D55 A4 82			ldy Reg3
   523 3D57 B1 96			lda (Txt_Ptr),y
   524 3D59 F0 33			beq Text_PutStrAt_Done
   525 3D5B A0 00			ldy #$00
   526 3D5D 91 88			sta (Ptr_Lo),y						; glyph byte
   527 3D5F C8				iny
   528 3D60 AD B4 06			lda Txt_Attr
   529 3D63 91 88			sta (Ptr_Lo),y						; attribute byte
   530 3D65 E6 82			inc Reg3
   531 3D67 E6 83			inc Reg4
   532 3D69 A5 88			lda Ptr_Lo							; window pointer += 2
   533 3D6B 18				clc
   534 3D6C 69 02			adc #$02
   535 3D6E 85 88			sta Ptr_Lo
   536 3D70 90 02			bcc Text_PutStrAt_NoPage
   537 3D72 E6 89			inc Ptr_Hi
   538 3D74			Text_PutStrAt_NoPage
   539 3D74 A5 89			lda Ptr_Hi
   540 3D76 C9 30			cmp #$30							; crossed out of the window -> next bank
   541 3D78 90 D5			bcc Text_PutStrAt_Char
   542 3D7A 38				sec
   543 3D7B E9 10			sbc #$10
   544 3D7D 85 89			sta Ptr_Hi							; wrap back to $20xx
   545 3D7F EE B6 06			inc Txt_Bank
   546 3D82 AD B6 06			lda Txt_Bank
