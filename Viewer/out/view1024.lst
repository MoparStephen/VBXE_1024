   725 3491 30 02			bmi Image_Open_Close
   726 3493 18				clc
   727 3494 60				rts
   728 3495			Image_Open_Close
   729 3495 20 F5 34			jsr Image_Close
   730 3498			Image_Open_Fail
   731 3498 38				sec
   732 3499 60				rts
