  1120 551D A9 05			lda #CIO_gettext
  1121 551F 9D 42 03			sta ICCOM,x
  1122 5522 A9 50			lda #<Nfo_Name_Line
  1123 5524 9D 44 03			sta ICBAL,x
  1124 5527 A9 06			lda #>Nfo_Name_Line
  1125 5529 9D 45 03			sta ICBAH,x
  1126 552C A9 54			lda #8+NFO_NAME_CAP+1				; buffer length (8 key + 75 desc + $9B = 84)
  1127 552E 9D 48 03			sta ICBLL,x
  1128 5531 A9 00			lda #$00
  1129 5533 9D 49 03			sta ICBLH,x
  1130 5536 20 56 E4			jsr CIOV
