   438 3306 20 69 35			jsr Build_Menu_Ramp_Table			; One-time build of the palette-demo overlay's ramp square
   439 3309 20 97 35			jsr Draw_Menu_Demo_Squares			; ...blit it into the banner's 8 demo squares...
   440 330C 20 01 36			jsr Set_Menu_Demo_Attrs			; ...and set their attribute-map cells to the right palette
