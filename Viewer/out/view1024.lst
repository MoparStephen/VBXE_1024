  2093 				;-----------------------------------------------------------------------------
  2094 				; Selector_Handle_P - "P" key: show a 2x2 grid of ramp squares, one per
  2095 				; palette register, zoomed 7x and centered on the image screen (UI_Mode 6,
  2096 				; Esc-only - see Pal_Preview_Keys).
  2097 				;   * on a *.V1K row: "Reading palette..." in row 0, read the .PAL block to
  2098 				;     $21000 with the selector still up; a missing / short file leaves the
  2099 				;     selector up (row 0 restored).  Only once it has loaded is the screen
  2100 				;     (prebuilt at boot by Pal_Preview_Init) swapped in, with the registers
  2101 				;     rewritten under a blanked overlay.
  2102 				;   * on "..", a directory or an empty list: no disk access at all - the
  2103 				;     registers already hold the menu's own palettes 0-3, so just show them.
  2104 				;-----------------------------------------------------------------------------
  2105 5D83			Selector_Handle_P
  2106 5D83 AD 8B 04			lda ImageCount
  2107 5D86 0D 8C 04			ora ImageCount+1
  2108 5D89 F0 35			beq Selector_Handle_P_Menu			; empty list -> the menu palettes
  2109 5D8B AD C7 04			lda Sel_Index
  2110 5D8E 20 39 58			jsr UI_RowType
  2111 5D91 D0 2D			bne Selector_Handle_P_Menu			; dir / ".." -> the menu palettes
  2112
  2113 5D93 AD C7 04			lda Sel_Index
  2114 5D96 8D 8A 04			sta File_Index
  2115 5D99 A9 C4			lda #<UI_Str_ReadPal
  2116 5D9B A0 78			ldy #>UI_Str_ReadPal
  2117 5D9D 20 8A 54			jsr UI_Show_Busy					; "Reading palette..." - on screen now
  2118 5DA0 20 F9 34			jsr Read_Image_Palette				; .PAL block -> $21000, registers untouched
  2119 5DA3 90 03			bcc Selector_Handle_P_Loaded
  2120 5DA5 4C 84 54			jmp Selector_Restore_LocRow			; failed - selector stays up (tail)
  2121
  2122 5DA8			Selector_Handle_P_Loaded
  2123 5DA8 20 91 3A			jsr Set_Attr_Source_Preview			; prebuilt at boot (Pal_Preview_Init)
  2124 5DAB 20 E5 34			jsr Display_Off						; blank while the registers change
  2125 5DAE 20 0C 35			jsr Apply_Image_Palette				; sets Pal_Image -> Enter_Selector restores
  2126 5DB1 A9 00			lda #MEMAC_GLOBAL_DISABLE
  2127 5DB3				vbsta VBXE_MA_BSEL
