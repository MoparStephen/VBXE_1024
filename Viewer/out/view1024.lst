   204
   205 				.ifdef	__VBXE_AUTO__
   206 3167 A5 94			lda VBXEBase+1
   207 3169 8D 8B 31			sta SP2_CR1							; SP2_xxN labels equ *-1 to the store's
   208 316C 8D 93 31			sta SP2_CG1							; high-byte position already - no +1
   209 316F 8D 99 31			sta SP2_CB1
   210 3172 8D A1 31			sta SP2_CR2
   211 3175 8D A9 31			sta SP2_CG2
   212 3178 8D B1 31			sta SP2_CB2
   213 317B 8D B9 31			sta SP2_CR3
   214 317E 8D BF 31			sta SP2_CG3
   215 3181 8D C5 31			sta SP2_CB3
   216 3184 A9 00			lda #$00							; Patching above clobbered A - restore it,
   217 				.endif									; tay below needs #$00 to zero the loop index
   218
   219 3186 A8				tay
   220 3187 B1 95		LoadPal1_1 lda (Y_Register),y
   221 3189 8D 46 00			sta.w VBXE_CR						; Set the red component
   222 = 318B			SP2_CR1	equ *-1
   223 318C C8				iny
   224 318D F0 3B			beq OverFlow1						; Since 256 / 3 is not even, we must skip to next section and resume at CG
   225 318F B1 95			lda (Y_Register),y
   226 3191 8D 47 00			sta.w VBXE_CG						; Set the green component
   227 = 3193			SP2_CG1	equ *-1
   228 3194 C8				iny
   229 3195 B1 95			lda (Y_Register),y
   230 3197 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   231 = 3199			SP2_CB1	equ *-1
   232 319A C8				iny
   233 319B D0 EA			bne LoadPal1_1						; Copy a page
   234 319D B1 95		LoadPal1_2 lda (Y_Register),y
   235 319F 8D 46 00			sta.w VBXE_CR						; Set the red component
   236 = 31A1			SP2_CR2	equ *-1
   237 31A2 C8				iny
   238 31A3 F0 10			beq LoadPal1_3
   239 31A5			LP1_2_G
   240 31A5 B1 95			lda (Y_Register),y
   241 31A7 8D 47 00			sta.w VBXE_CG						; Set the green component
   242 = 31A9			SP2_CG2	equ *-1
   243 31AA C8				iny
   244 31AB F0 22			beq OverFlow2						; Since 256 / 3 is not even, we must skip to next section and resume at CB
   245 31AD B1 95			lda (Y_Register),y
   246 31AF 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   247 = 31B1			SP2_CB2	equ *-1
   248 31B2 C8				iny
   249 31B3 D0 E8			bne LoadPal1_2						; Copy a page
   250 31B5 B1 95		LoadPal1_3 lda (Y_Register),y
   251 31B7 8D 46 00			sta.w VBXE_CR						; Set the red component
   252 = 31B9			SP2_CR3	equ *-1
   253 31BA C8				iny
   254 31BB B1 95			lda (Y_Register),y
   255 31BD 8D 47 00			sta.w VBXE_CG						; Set the green component
   256 = 31BF			SP2_CG3	equ *-1
   257 31C0 C8				iny
   258 31C1			LP1_3_B
   259 31C1 B1 95			lda (Y_Register),y
   260 31C3 8D 48 00			sta.w VBXE_CB						; Set the blue component and increment CSEL
   261 = 31C5			SP2_CB3	equ *-1
   262 31C6 C8				iny
   263 31C7 D0 EC			bne LoadPal1_3						; Copy a page
   264 31C9 60				rts
   265
   266 31CA			OverFlow1
   267 31CA E6 96			inc Y_Register + 1
   268 31CC 4C A5 31			jmp LP1_2_G
   269 31CF			OverFlow2
   270 31CF E6 96			inc Y_Register + 1
   271 31D1 4C C1 31			jmp LP1_3_B
