   596 				;-----------------------------------------------------------------------------
   597 				; Load_Image
   598 				; File_Index must be set before calling this!  No range checking is done!
   599 				; One OPEN of D:<name>.V1K, three sequential block reads:
   600 				;   .PAL block -> $21000, pushed to palette registers 0-3
   601 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   602 				;   .RAW block -> $01000 framebuffer
   603 				; A missing or short file stops at the failing block and closes the IOCB.
   604 				;-----------------------------------------------------------------------------
   605 33ED			Load_Image
   606 33ED A9 00			lda #$00							; ext 0 = .V1K
   607 33EF 20 04 39			jsr Build_Filename
   608 33F2 20 41 34			jsr Image_Open
   609 33F5 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   610
   611 33F7 20 30 34			jsr Image_Read_Pal
   612 33FA B0 2A			bcs Load_Image_Close
   613 33FC 20 B2 33			jsr Apply_Image_Palette
   614
   615 33FF A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   616 3401 A2 02			ldx #V1K_MAP_LEN / $1000
   617 3403 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   618 3405 8C E5 04			sty Seg_Tail
   619 3408 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   620 340A 8C E6 04			sty Seg_Tail + $01
   621 340D 20 72 34			jsr Image_Read_Segment
   622 3410 B0 14			bcs Load_Image_Close
   623 3412 20 54 33			jsr Setup_Cmap1						; Expand the data out to $17000
   624
   625 3415 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   626 3417 A2 12			ldx #V1K_RAW_LEN / $1000
   627 3419 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   628 341B 8C E5 04			sty Seg_Tail
   629 341E A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   630 3420 8C E6 04			sty Seg_Tail + $01
   631 3423 20 72 34			jsr Image_Read_Segment
   632
   633 3426			Load_Image_Close
   634 3426 20 CD 34			jsr Image_Close
   635
   636 3429			Load_Image_Done
   637 3429 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   638 342B				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 342B A0 5F			ldy #<VBXE_MA_BSEL
     3 342D 91 93			sta (VBXEBase),y
Source: view1024.asm
