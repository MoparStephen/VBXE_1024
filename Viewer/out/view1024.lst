   209 4EFB 90 F4			bcc Build_Spec_L1
   210 4EFD 60				rts
   211
   212 4EFE			Build_Browse_Spec						; ... + "*.*" + EOL
   213 4EFE 20 C4 4E			jsr Build_Spec_Prefix
   214 4F01 A0 00			ldy #$00
   215 4F03			Build_Browse_Spec_L1
   216 4F03 B9 28 4F			lda Build_Spec_AnyWild,y
   217 4F06 9D 50 06			sta Scan_Spec,x
   218 4F09 E8				inx
   219 4F0A C8				iny
   220 4F0B C0 04			cpy #$04
   221 4F0D 90 F4			bcc Build_Browse_Spec_L1
   222 4F0F 60				rts
   223
   224 4F10			Build_Manifest_Spec						; ... + "IMAGES.LST" + EOL  (status-line names)
   225 4F10 20 C4 4E			jsr Build_Spec_Prefix
