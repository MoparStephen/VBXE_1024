  1638 				;-----------------------------------------------------------------------------
  1639 				; Sel_Nav_Apply - A = new Sel_Index (already range-checked by the caller).
  1640 				; Common tail for the four nav keys: scrolls (full repaint) if the move
  1641 				; crosses the visible window, else just re-colours the old and new cells;
  1642 				; always repaints the status line, then returns to the key loop.
  1643 				;-----------------------------------------------------------------------------
  1644 579A			Sel_Nav_Apply
  1645 579A 48				pha									; stash the new index
  1646 579B AD C7 04			lda Sel_Index
  1647 579E 85 87			sta Reg8							; Reg8 = old index (survives the calls below)
  1648 57A0 68				pla
  1649 57A1 8D C7 04			sta Sel_Index
  1650 57A4 20 C6 57			jsr Sel_Top_For_Index				; A = the Sel_Top that keeps Sel_Index visible
  1651 57A7 CD C8 04			cmp Sel_Top
  1652 57AA F0 09			beq Sel_Nav_Apply_Rows				; unchanged -> no scroll, cheap 2-cell update
  1653 57AC 8D C8 04			sta Sel_Top							; scrolled -> repaint the whole grid in place
  1654 57AF 20 E6 51			jsr Selector_DrawList
  1655 57B2 4C C0 57			jmp Sel_Key_Nav_Done
  1656 57B5			Sel_Nav_Apply_Rows
  1657 57B5 A5 87			lda Reg8
  1658 57B7 20 8A 52			jsr Selector_HiRow					; un-highlight the cell we left
  1659 57BA AD C7 04			lda Sel_Index
  1660 57BD 20 8A 52			jsr Selector_HiRow					; highlight the cell we moved to
  1661 57C0			Sel_Key_Nav_Done
  1662 57C0 20 BE 53			jsr Selector_DrawStatus				; row 20: description of the new row
  1663 57C3 4C 28 38			jmp Read_Key_Done
  1664
  1665 				;-----------------------------------------------------------------------------
  1666 				; Sel_Top_For_Index - A = target list index -> A = the Sel_Top that keeps
  1667 				; that index inside the visible UI_VISROWS x UI_COLS window, scrolling by
  1668 				; whole grid rows from the CURRENT Sel_Top.  Read-only - caller compares
  1669 				; against Sel_Top and stores it.  Clobbers X, Reg1.
  1670 				;-----------------------------------------------------------------------------
  1671 57C6			Sel_Top_For_Index
  1672 57C6 4A				lsr
  1673 57C7 4A				lsr
  1674 57C8 4A				lsr
  1675 57C9 85 80			sta Reg1							; Reg1 = target item_row
  1676 57CB AD C8 04			lda Sel_Top
  1677 57CE 4A				lsr
  1678 57CF 4A				lsr
  1679 57D0 4A				lsr								; A = current top_row
  1680 57D1 C5 80			cmp Reg1
  1681 57D3 90 07			bcc Sel_Top_FI_MaybeDown			; top_row < item_row
  1682 57D5 F0 15			beq Sel_Top_FI_Unchanged			; top_row == item_row - already the top row
  1683 57D7 A5 80			lda Reg1							; top_row > item_row - scroll up: new top_row = item_row
  1684 57D9 4C E8 57			jmp Sel_Top_FI_Scale
  1685 57DC			Sel_Top_FI_MaybeDown
  1686 57DC 18				clc
  1687 57DD 69 0E			adc #[UI_VISROWS-1]					; A = bottom row of the current window
  1688 57DF C5 80			cmp Reg1
  1689 57E1 B0 09			bcs Sel_Top_FI_Unchanged			; bottom_row >= item_row - still visible
  1690 57E3 A5 80			lda Reg1							; scroll down: new top_row = item_row - (VISROWS-1)
  1691 57E5 38				sec
  1692 57E6 E9 0E			sbc #[UI_VISROWS-1]
  1693 57E8			Sel_Top_FI_Scale
  1694 57E8 0A				asl
  1695 57E9 0A				asl
  1696 57EA 0A				asl								; row -> Sel_Top (* UI_COLS)
  1697 57EB 60				rts
  1698 57EC			Sel_Top_FI_Unchanged
  1699 57EC AD C8 04			lda Sel_Top
  1700 57EF 60				rts
