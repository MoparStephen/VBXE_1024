   793 				;-----------------------------------------------------------------------------
   794 				; Image_Open - OPEN FileNamePtr for read on the first free IOCB (the same
   795 				; sequence LoadData uses, but the file stays open across several block reads).
   796 				;  Out: C=0 and Load_IOCB = IOCB offset, or C=1 (no IOCB / OPEN failed - the
   797 				;       IOCB is closed again so it doesn't leak).
   798 				;-----------------------------------------------------------------------------
   799 35A0			Image_Open
   800 35A0 20 2D 30			jsr Find_First_IOCB
   801 35A3 C0 01			cpy #$01
   802 35A5 D0 28			bne Image_Open_Fail					; no free IOCB
   803 35A7 8E E2 04			stx Load_IOCB
   804 35AA A9 04			lda #CIO_read
   805 35AC 9D 4A 03			sta ICAX1,x
   806 35AF A9 00			lda #$00
   807 35B1 9D 4B 03			sta ICAX2,x
   808 35B4 A9 03			lda #CIO_open
   809 35B6 9D 42 03			sta ICCOM,x
   810 35B9 AD 28 31			lda FileNamePtr
   811 35BC 9D 44 03			sta ICBAL,x
   812 35BF AD 29 31			lda FileNamePtr + $01
   813 35C2 9D 45 03			sta ICBAH,x
   814 35C5 20 56 E4			jsr CIOV
   815 35C8 30 02			bmi Image_Open_Close
   816 35CA 18				clc
   817 35CB 60				rts
   818 35CC			Image_Open_Close
   819 35CC 20 2C 36			jsr Image_Close
   820 35CF			Image_Open_Fail
   821 35CF 38				sec
   822 35D0 60				rts
   823
   824 				;-----------------------------------------------------------------------------
   825 				; Image_Read_Segment - read one fixed-size block of the open .V1K into VRAM
   826 				; through the 4K MEMAC window, 4K at a time, then the partial tail.
   827 				;  In:  A = first VBXE bank, X = full 4K chunks, Seg_Tail = tail bytes (0 ok)
   828 				;  Out: C=1 on any CIO error (including EOF before the block is complete)
   829 				;-----------------------------------------------------------------------------
   830 35D1			Image_Read_Segment
   831 35D1 8D E3 04			sta Seg_Bank
   832 35D4 8E E4 04			stx Seg_Chunks
   833 35D7			Image_Read_Segment_L1
   834 35D7 AD E4 04			lda Seg_Chunks
   835 35DA F0 0F			beq Image_Read_Segment_Tail
   836 35DC A9 00			lda #<VBXE_WINDOW_SIZE_4k
   837 35DE A0 10			ldy #>VBXE_WINDOW_SIZE_4k
   838 35E0 20 FE 35			jsr Image_Read_Chunk
   839 35E3 B0 18			bcs Image_Read_Segment_Done
   840 35E5 CE E4 04			dec Seg_Chunks
   841 35E8 4C D7 35			jmp Image_Read_Segment_L1
   842
   843 35EB			Image_Read_Segment_Tail
   844 35EB AD E5 04			lda Seg_Tail
   845 35EE 0D E6 04			ora Seg_Tail + $01
   846 35F1 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   847 35F3 AD E5 04			lda Seg_Tail
   848 35F6 AC E6 04			ldy Seg_Tail + $01
   849 35F9 4C FE 35			jmp Image_Read_Chunk
   850
   851 35FC			Image_Read_Segment_OK
   852 35FC 18				clc
   853 35FD			Image_Read_Segment_Done
   854 35FD 60				rts
   855
   856 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   857 				; C=1 on a CIO error.
   858 35FE			Image_Read_Chunk
   859 35FE AE E2 04			ldx Load_IOCB
   860 3601 9D 48 03			sta ICBLL,x
   861 3604 98				tya
   862 3605 9D 49 03			sta ICBLH,x							; length stored before vbsta clobbers Y
   863 3608 AD E3 04			lda Seg_Bank
   864 360B 09 80			ora #MEMAC_GLOBAL_ENABLE
   865 360D				vbsta VBXE_MA_BSEL
