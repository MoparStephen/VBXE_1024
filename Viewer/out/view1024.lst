   164 3306 A9 01			lda #$01							; Set BASICF for OS
   165 3308 8D F8 03			sta BASICF							; So BASIC remains OFF after RESET
   166
   167 330B AD 01 D3			lda PORTB							; Disable BASIC bit in PORTB for MMU
   168 330E 09 02			ora #$02							; By Setting bit 2
   169 3310 8D 01 D3			sta PORTB
