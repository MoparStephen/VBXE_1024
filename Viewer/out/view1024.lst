   439 				;-----------------------------------------------------------------------------
   440 				; Parse_Dir_Line - pull the base filename out of one Dir_Line_Buf entry and
   441 				; write it space-padded to exactly 8 bytes at Name_Ptr.  Skips leading spaces
   442 				; and the '*' protect flag; stops the name at space/'.'/EOL.  Rejects an
   443 				; all-digit "name" (the trailing "nnn FREE SECTORS" line).
   444 				;  Returns A = $01 if a name was written, $00 if not.
   445 				;-----------------------------------------------------------------------------
   446 52C1			Parse_Dir_Line
   447 52C1 A2 00			ldx #$00							; X = source index into Dir_Line_Buf
   448 52C3			Parse_Skip_L1							; Skip leading spaces / protect flag
   449 52C3 BD 00 06			lda Dir_Line_Buf,x
   450 52C6 C9 9B			cmp #$9B
   451 52C8 F0 52			beq Parse_Dir_Line_Reject			; Hit EOL before any name
   452 52CA C9 20			cmp #' '
   453 52CC F0 04			beq Parse_Skip_Next
   454 52CE C9 2A			cmp #'*'
   455 52D0 D0 07			bne Parse_Skip_Done
   456 52D2			Parse_Skip_Next
   457 52D2 E8				inx
   458 52D3 E0 28			cpx #Dir_Line_Len
   459 52D5 90 EC			bcc Parse_Skip_L1
   460 52D7 B0 43			bcs Parse_Dir_Line_Reject			; Ran off the end
   461 52D9			Parse_Skip_Done
   462 52D9 A0 00			ldy #$00							; Y = dest index into the entry slot (0-7)
   463 52DB A9 00			lda #$00
   464 52DD 85 80			sta Reg1							; Reg1 = "saw a non-digit name char" flag
   465
   466 52DF			Parse_Copy_L1
   467 52DF BD 00 06			lda Dir_Line_Buf,x
   468 52E2 C9 9B			cmp #$9B
   469 52E4 F0 24			beq Parse_Copy_Done
   470 52E6 C9 20			cmp #' '
   471 52E8 F0 20			beq Parse_Copy_Done
   472 52EA C9 2E			cmp #'.'
   473 52EC F0 1C			beq Parse_Copy_Done
   474 52EE C9 30			cmp #'0'
   475 52F0 90 07			bcc Parse_Copy_Is_Name_Char
   476 52F2 C9 3A			cmp #'9'+1
   477 52F4 B0 03			bcs Parse_Copy_Is_Name_Char
   478 52F6 4C FB 52			jmp Parse_Copy_Store				; '0'-'9' - a digit, don't set Reg1
   479 52F9			Parse_Copy_Is_Name_Char
   480 52F9 E6 80			inc Reg1
   481 52FB			Parse_Copy_Store
   482 52FB C0 08			cpy #$08							; Slot bytes 0-7 hold up to 8 name chars
   483 52FD B0 06			bcs Parse_Copy_Next					; Name already full - keep scanning
   484 52FF BD 00 06			lda Dir_Line_Buf,x
   485 5302 91 8A			sta (Name_Ptr),y
   486 5304 C8				iny
   487 5305			Parse_Copy_Next
   488 5305 E8				inx
   489 5306 E0 28			cpx #Dir_Line_Len
   490 5308 90 D5			bcc Parse_Copy_L1
   491
   492 530A			Parse_Copy_Done
   493 530A A5 80			lda Reg1
   494 530C F0 0E			beq Parse_Dir_Line_Reject			; All digits - e.g. "nnn FREE SECTORS"
   495
   496 530E			Parse_Pad_L1							; Right-pad the slot to a fixed 8 bytes
   497 530E C0 08			cpy #$08
   498 5310 B0 07			bcs Parse_Dir_Line_Accept
   499 5312 A9 20			lda #' '
   500 5314 91 8A			sta (Name_Ptr),y
   501 5316 C8				iny
   502 5317 D0 F5			bne Parse_Pad_L1
   503
   504 5319			Parse_Dir_Line_Accept
   505 5319 A9 01			lda #$01							; Non-zero - a name was stored
   506 531B 60				rts
   507 531C			Parse_Dir_Line_Reject
   508 531C A9 00			lda #$00
   509 531E 60				rts
