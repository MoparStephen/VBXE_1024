   874 				;-----------------------------------------------------------------------------
   875 				; Nfo_Name_MapSlot - Nfo_Name_Ord -> Ptr_Lo/Hi = the slot's $2000-window
   876 				; address, its VBXE bank ($37..$3E) mapped in.  slot byte offset = Ord * 128:
   877 				; bank = $37 + (Ord >> 5), window page = $20 + ((Ord >> 1) & 15),
   878 				; window low = (Ord & 1) << 7.  (128 divides 4K, so a slot never straddles.)
   879 				;-----------------------------------------------------------------------------
   880 52CF			Nfo_Name_MapSlot
   881 52CF AD E1 04			lda Nfo_Name_Ord
   882 52D2 4A				lsr									; C = Ord & 1
   883 52D3 A9 00			lda #$00
   884 52D5 6A				ror									; A = (Ord & 1) << 7
   885 52D6 85 88			sta Ptr_Lo
   886 52D8 AD E1 04			lda Nfo_Name_Ord
   887 52DB 4A				lsr
   888 52DC 29 0F			and #$0F							; (Ord >> 1) & 15
   889 52DE 18				clc
   890 52DF 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   891 52E1 85 89			sta Ptr_Hi
   892 52E3 AD E1 04			lda Nfo_Name_Ord
   893 52E6 4A				lsr
   894 52E7 4A				lsr
   895 52E8 4A				lsr
   896 52E9 4A				lsr
   897 52EA 4A				lsr									; Ord >> 5  (0..7)
   898 52EB 18				clc
   899 52EC 69 37			adc #NFO_NAME_BANK
   900 52EE 09 80			ora #MEMAC_GLOBAL_ENABLE
   901 52F0				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 52F0 A0 5F			ldy #<VBXE_MA_BSEL
     3 52F2 91 93			sta (VBXEBase),y
Source: ui.asm
   902 52F4 60				rts
