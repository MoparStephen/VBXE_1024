   795 				; Restore the OS state Step_1 / Check_RAMTOP changed, BEFORE Cleanup_Exit runs
   796 				; SDX_Console_Restore (its XIO 32 wants the real RAMTOP back).  Lives here, not
   797 				; in the resident Cleanup_Exit, which is page-fenced below $3300 and full - the
   798 				; init-time abort paths that jmp straight to Cleanup_Exit simply skip this.
   799 35D7 AD 81 04			lda CRSINH_OLD
   800 35DA 8D F0 02			sta CRSINH							; Restore Cursor
   801 35DD AD E3 04			lda COLOR1_OLD						; Restore the editor colours Step_1 changed
   802 35E0 8D C5 02			sta COLOR1
   803 35E3 AD 83 04			lda COLOR2_OLD
   804 35E6 8D C6 02			sta COLOR2
   805 35E9 AD E4 04			lda COLOR4_OLD
   806 35EC 8D C8 02			sta COLOR4
   807 35EF AD E2 04			lda RAMTOP_OLD						; Give the SDX soft console its top-of-RAM back
   808 35F2 85 6A			sta RAMTOP
   809 35F4 8D E4 02			sta RAMSIZ
   810 35F7 4C D6 31			jmp Cleanup_Exit					; Clean up and exit (accounts for any long branch issues)
