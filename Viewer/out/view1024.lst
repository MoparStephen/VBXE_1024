  1353 				; Increment_Image - advance File_Index within the *.V1K file band
  1354 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1355 				; No-op when the list holds no files.  (The selector list may now also carry
  1356 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1357 				;-----------------------------------------------------------------------------
  1358 3894			Increment_Image
  1359 3894 AD DA 04			lda FileStart
  1360 3897 CD 8B 04			cmp ImageCount
  1361 389A B0 12			bcs Increment_Image_Done			; no *.V1K files in the list
  1362 389C AE 8A 04			ldx File_Index
  1363 389F E8				inx
  1364 38A0 EC 8B 04			cpx ImageCount
  1365 38A3 90 03			bcc Increment_Image_Store
  1366 38A5 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1367 38A8			Increment_Image_Store
  1368 38A8 8E 8A 04			stx File_Index
  1369 38AB 20 ED 33			jsr Load_Image
  1370 38AE			Increment_Image_Done
  1371 38AE 60				rts
