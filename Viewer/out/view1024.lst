     3 354F 91 93			sta (VBXEBase),y
Source: view1024.asm
   776 3551 60				rts
   777
   778 				; Reg1/Reg2 = running row_offset (16-bit, row*MENU_ATTR_ROW_BYTES from
   779 				; MENU_BANNER_MAP_VRAM's start), advanced by MENU_ATTR_ROW_BYTES each row.
   780 				; Ptr_Lo/Hi = this band's 8-byte value table (Menu_Demo_Attr_Cols order).
   781 				; The column loop counter lives in X, not Y: vbsta/vblda clobber Y on every
   782 				; call in __VBXE_AUTO__ mode (vbxe_min.asm), and this loop calls vbsta once
   783 				; per column, so Y cannot survive across it.  Clobbers A/X/Y/Reg1-8.
   784 3552			Set_Menu_Demo_Attr_Band
   785 3552 A9 10			lda #MENU_DEMO_SQUARE
   786 3554 85 87			sta Reg8							; rows remaining
   787 3556			Set_Menu_Demo_Attr_Band_Row
   788 3556 A2 00			ldx #$00
   789 3558			Set_Menu_Demo_Attr_Band_Col
   790 3558 BD 0D 35			lda Menu_Demo_Attr_Cols,x
   791 355B 18				clc
   792 355C 65 80			adc Reg1
   793 355E 85 82			sta Reg3							; total byte offset, lo
   794 3560 A9 00			lda #$00
   795 3562 65 81			adc Reg2
   796 3564 85 83			sta Reg4							; total byte offset, hi
   797
   798 				; window address = VBXE_WINDOW + (total_offset & $0FFF)
   799 3566 A5 83			lda Reg4
   800 3568 29 0F			and #$0F
   801 356A 09 20			ora #>VBXE_WINDOW
   802 356C 85 85			sta Reg6							; dest ptr hi
   803 356E A5 82			lda Reg3
   804 3570 85 84			sta Reg5							; dest ptr lo
