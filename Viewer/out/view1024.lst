  1926 				;=============================================================================
  1927 				; Info viewer  (UI_Mode = 4) - shows "<image>.NFO" on the 80-col text screen,
  1928 				; scrollable.  The .NFO file IS the byte image of that screen: fixed 160-byte
  1929 				; line records of 80 {glyph,attr} cell pairs (attr $07), no terminators, one
  1930 				; all-$00 record marking end-of-text.  Info_Load streams it verbatim into
  1931 				; NFO_BUF_VRAM (banks $25-$29); Info_Draw blits an NFO_VISROWS window of it with
  1932 				; one BLT_NFO_DRAW copy per scroll - no reformat, no re-walk.
  1933 				;=============================================================================
  1934
  1935 				;-----------------------------------------------------------------------------
  1936 				; Info_Load - stream FileNamePtr into NFO_BUF_VRAM via LoadData, then count the
  1937 				; line records.  LoadStatus (fileio.lib) = 0 if the OPEN failed.  No pre-wipe:
  1938 				; the converter's trailing $00 record stops Info_Count_Lines before any stale
  1939 				; tail from a previous, longer .NFO, and the scroll clamp keeps those records
  1940 				; off screen.
  1941 				;-----------------------------------------------------------------------------
  1942 56BC			Info_Load
  1943 56BC A9 25			lda #NFO_BUF_BANK
  1944 56BE 85 8E			sta BankIndex
  1945 56C0 20 AA 30			jsr LoadData						; FileNamePtr was set by Build_Filename
  1946 56C3 AD 2D 31			lda LoadStatus
  1947 56C6 F0 03			beq Info_Load_Ret					; OPEN failed - Selector_Handle_I bails
  1948 56C8 20 CC 56			jsr Info_Count_Lines				; sets Nfo_LineCount
  1949 56CB			Info_Load_Ret
  1950 56CB 60				rts
  1951
  1952 				;-----------------------------------------------------------------------------
  1953 				; Info_Count_Lines - walk the loaded buffer in TEXT_PITCH (160-byte) steps and
  1954 				; count records whose first byte is non-zero, stopping at the $00 sentinel or
  1955 				; at NFO_MAX_LINES (127).  Leaves Nfo_LineCount (word; hi byte stays 0).
  1956 				; Ptr_Lo/Hi is the $2000-window pointer, Nfo_WalkBank the mapped bank; a
  1957 				; 160-byte step straddles a bank every ~25 records, handled inline.
  1958 				;-----------------------------------------------------------------------------
  1959 56CC			Info_Count_Lines
  1960 56CC A9 00			lda #$00
  1961 56CE 8D DE 04			sta Nfo_LineCount
  1962 56D1 8D DF 04			sta Nfo_LineCount + $01
  1963 56D4 A9 25			lda #NFO_BUF_BANK
  1964 56D6 8D 50 06			sta Nfo_WalkBank
  1965 56D9 09 80			ora #MEMAC_GLOBAL_ENABLE
  1966 56DB				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 56DB A0 5F			ldy #<VBXE_MA_BSEL
     3 56DD 91 93			sta (VBXEBase),y
Source: ui.asm
  1967 56DF A9 00			lda #<VBXE_WINDOW
  1968 56E1 85 88			sta Ptr_Lo
  1969 56E3 A9 20			lda #>VBXE_WINDOW
  1970 56E5 85 89			sta Ptr_Hi
  1971 56E7			Info_Count_L1
  1972 56E7 A0 00			ldy #$00
  1973 56E9 B1 88			lda (Ptr_Lo),y
  1974 56EB F0 2E			beq Info_Count_Done					; $00 first byte -> sentinel / end of text
  1975 56ED EE DE 04			inc Nfo_LineCount
  1976 56F0 AD DE 04			lda Nfo_LineCount
  1977 56F3 C9 7F			cmp #NFO_MAX_LINES
  1978 56F5 B0 24			bcs Info_Count_Done					; hit the record cap
  1979 56F7 A5 88			lda Ptr_Lo							; Ptr += TEXT_PITCH
  1980 56F9 18				clc
  1981 56FA 69 A0			adc #TEXT_PITCH
  1982 56FC 85 88			sta Ptr_Lo
  1983 56FE 90 E7			bcc Info_Count_L1
  1984 5700 E6 89			inc Ptr_Hi
  1985 5702 A5 89			lda Ptr_Hi
  1986 5704 C9 30			cmp #>VBXE_WINDOW + $10				; crossed out of the 4K window ($30xx)?
  1987 5706 90 DF			bcc Info_Count_L1
  1988 5708 E9 10			sbc #$10							; C=1 from the cmp -> back to $20xx-$2Fxx
  1989 570A 85 89			sta Ptr_Hi
  1990 570C EE 50 06			inc Nfo_WalkBank					; and map the next NFO buffer bank
  1991 570F AD 50 06			lda Nfo_WalkBank
  1992 5712 09 80			ora #MEMAC_GLOBAL_ENABLE
  1993 5714				vbsta VBXE_MA_BSEL
