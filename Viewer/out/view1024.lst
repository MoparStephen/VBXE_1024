   161 				;VBXE_Detect - detects VBXE FX core version 1.07 and above,
   162 				; and stores VBXE Base address in VBXEBase
   163 312D			VBXE_Detect
   164 312D A9 00			lda #$00
   165 312F A2 D6			ldx #$D6
   166 3131 8D 40 D6			sta $D640							; Make sure it isn't coincidence
   167 3134 AD 40 D6			lda $D640
   168 3137 C9 10			cmp #$10							; Do we have major version here?
   169 3139 F0 15			beq VBXE_Detected					; If so, then VBXE is detected
   170 313B A9 00			lda #$00
   171 313D E8				inx
   172 313E 8D 40 D7			sta $D740							; No such luck, try other location
   173 3141 AD 40 D7			lda $D740
   174 3144 C9 10			cmp #$10
   175 3146 F0 08			beq VBXE_Detected
   176 3148 A2 00			ldx #$00							; Not here, so not present or FX core version too low
   177 314A 86 94			stx VBXEBase+1
   178 314C 86 93			stx VBXEBase
   179 314E 38				sec
   180 314F 60				rts
   181 3150			VBXE_Detected:
   182 3150 86 94			stx VBXEBase+1
   183 3152 A9 00			lda #$00
   184 3154 85 93			sta VBXEBase
   185 3156				vblda VBXE_MINOR					; Get core minor version
Macro: VBLDA [Source: vbxe_min.asm]
