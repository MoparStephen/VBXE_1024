   320 = DADB			FMUL        equ $DADB					; FR0 * FR1
   321 = DB28			FDIV        equ $DB28					; FR0 / FR1
   322 = DD40			PLYEVL      equ $DD40					; Polynomial evaluation
   323 = DD89			FLD0R       equ $DD89					; Load FR0 by X,Y register pointer
   324 = DD8D			FLD0P       equ $DD8D					; Load FR0 by FLPTR pointer
   325 = DD98			FLD1R       equ $DD98					; Load FR1 by X,Y register pointer
   326 = DD9C			FLD1P       equ $DD9C					; Load FR1 by FLPTR pointer
   327 = DDA7			FST0R       equ $DDA7					; Store FR0 at buffer by X,Y register pointer
   328 = DDAB			FST1P       equ $DDAB					; Store FR0 at buffer by FLPTR pointer
   329 = DDB6			FMOVE       equ $DDB6					; Move FR0 to FR1
   330 = DDC0			EXP         equ $DDC0					; E exponentiation
   331 = DDCC			EXP10       equ $DDCC					; Base 10 exponentiation
   332 = DECD			LOG         equ $DECD					; Natural log of FR0
   333 = DED1			LOG10       equ $DED1					; Base 10 log of FR0
   334
   335 				; ROM Vectors
   336 = E456			CIOV        equ $E456
   337 = E459			SIOV        equ $E459
   338 = E45C			SETVBV      equ $E45C					; Set system timers and interrupt vectors
   339 = E45F			SYSVBV      equ $E45F					; Stage one VBLANK calculations entry point
   340 = E462			XITVBV      equ $E462					; Exit VBLANK routine entry point
   341 = E471			BLKBDV      equ $E471					; Memo Pad Vector
   342 = E474			WARMSV      equ $E474					; Warm Reset Vector
   343 = E477			COLDSV      equ $E477					; Cold Reset Vector
    72
    73 				;-----------------------------------------------------------------------------
    74 				; Structure Declarations
    75 				;-----------------------------------------------------------------------------
    76
    77 				;-----------------------------------------------------------------------------
    78 				; Variables go here
    79 				;-----------------------------------------------------------------------------
    80 				; Page 0 user data ($80 to $FF with some reserved for OS)
    81 				.zpvar Reg1				.byte			; Multi-Use Variables
    82 				.zpvar Reg2				.byte			; Multi-Use Variables
    83 				.zpvar Reg3				.byte			; Multi-Use Variables
    84 				.zpvar Reg4				.byte			; Multi-Use Variables
    85 				.zpvar Reg5				.byte			; Multi-Use Variables
    86 				.zpvar Reg6				.byte			; Multi-Use Variables
    87 				.zpvar Reg7				.byte			; Multi-Use Variables
    88 				.zpvar Reg8				.byte			; Multi-Use Variables
    89 				.zpvar Ptr_Lo			.byte			; Lo byte of pointer
    90 				.zpvar Ptr_Hi			.byte			; Hi byte of pointer
    91 				.zpvar Name_Ptr			.word			; Scan write-cursor / Build_Filename source ptr
    92 				.zpvar Sort_Ptr			.word			; Sort_Range 2nd record ptr
    93
    94 				; Non Page-0 Variables
    95 				;	$480 to $4FF free
    96 				;	$600 to $6FF free
    97 				; When using PMG the 1st $300 bytes are always free
    98 				.var SDMCTL_OLD			.byte = $480	; Save DMA
    99 				.var CRSINH_OLD			.byte = $481	; Save CRSINH (Mouse Pointer)
   100 				.var LMARGIN_OLD		.byte = $482	; Save LMARGIN
   101 				.var COLOR2_OLD			.byte = $483	; Save COLOR2
   102 				.var SP_REG_OLD			.byte = $484	; Save the Stack Pointer
   103 				.var SDLSTL_OLD			.byte = $485	; Save the Display List Pointer
   104 				.var SDLSTH_OLD			.byte = $486	; Save the Display List Pointer
   105 				.var DOSINIL_OLD		.byte = $487	; Save the DOSINI Pointer
   106 				.var DOSINIH_OLD		.byte = $488	; Save the DOSINI Pointer
   107 				.var Video_Flag			.byte = $489	; PAL = 0, NTSC = 1
   108 				.var File_Index			.byte = $48A	; 0-based image ordinal (0 .. ImageCount-1)
   109 				.var ImageCount			.word = $48B	; Images found by Rescan_Images (hi byte always 0)
   110 				.var Path_Buf			:56 .byte = $48D	; Built "D[n]:PATH>NAME.EXT",$00 for LoadData ($48D-$4C4)
   111 				.var Dir_IOCB			.byte = $4C5	; IOCB used by Build_Image_List
   112 				; --- viewer UI state (ui.asm) ---
   113 				.var UI_Mode			.byte = $4C6	; 0 selector / 1 image / 2 slideshow / 3 drive picker / 4 info / 5 quit / 6 P-preview / 7 help
   114 				.var Sel_Index			.byte = $4C7	; highlighted list entry (0-based)
   115 				.var Sel_Top			.byte = $4C8	; list index of the first visible row (scroll)
   116 				.var Slide_Secs			.byte = $4C9	; slideshow delay, seconds (1..30)
   117 				.var Slide_FrameCtr		.word = $4CA	; slideshow countdown, frames
   118 				.var Scan_Drive			.byte = $4CC	; '1'..'8', or $00 for a bare "D:"
   119 				.var Name_Row_Buf		:12 .byte = $4CD	; one name record / formatted row, NUL-terminated
   120 				.var Dir_Count			.byte = $4D9	; selector list: number of sub-directory rows
   121 				.var FileStart			.byte = $4DA	; selector list: index of the first *.V1K row (= upCount + Dir_Count)
   122 				.var Drive_Pick_Index	.byte = $4DB	; drive picker (UI_Mode 3): 0 = "D:", 1..8 = "Dn:"
   123 				.var Nfo_Top			.word = $4DC	; info viewer: first visible line record (0-based)
   124 				.var Nfo_LineCount		.word = $4DE	; info viewer: line records in the loaded .NFO
   125 				.var Font_Sel			.byte = $4E0	; text font: 0 = CGA ($44), 1 = Atari ($45)
   126 				.var Nfo_Name_Ord		.byte = $4E1	; selector status line: file ordinal being fetched
   127 				; --- single-file .V1K image loader (Image_Open / Image_Read_Segment) ---
   128 				.var Load_IOCB			.byte = $4E2	; IOCB offset of the open .V1K file
   129 				.var Seg_Bank			.byte = $4E3	; VBXE bank the next 4K chunk lands in
   130 				.var Seg_Chunks			.byte = $4E4	; full 4K chunks left in this segment
   131 				.var Seg_Tail			.word = $4E5	; bytes in the segment's final partial chunk
   132 				.var Pal_Image			.byte = $4E7	; 1 = an image's palettes are in registers 0-3 (Enter_Selector must restore)
   133 				.var Help_Return_Mode	.byte = $4E8	; UI_Mode to go back to when Help closes (0 selector / 4 info)
   134 				.var Help_Page			.byte = $4E9	; help screen section 0..2
   135 				.var Help_Top			.byte = $4EA	; help screen: first visible row of the section (scroll)
   136 				.var Help_RowCount		.byte = $4EB	; help screen: rows in the current section (set by Help_Draw)
   137 				;	$4EC to $4FF free
   138 				.var Dir_Line_Buf		:$28 .byte = $600	; One GET RECORD dir line ($600-$627)
   139 				.var Scan_Path			:$28 .byte = $628	; subdirectory part, ">DIR>DIR>" or empty ($628-$64F)
   140 				.var Scan_Spec			:$30 .byte = $650	; assembled "D[n]:PATH*.V1K",$9B ($650-$67F)
   141 				.var Txt_Line			:$30 .byte = $680	; scratch line assembled for Text_PutStrAt ($680-$6AF)
   142 				; One IMAGES.LST record (8-byte key + <=NFO_NAME_CAP description + $9B) for
   143 				; Nfo_Name_LoadManifest, and the padded status-line text Nfo_Name_Emit builds
   144 				; for Selector_DrawStatus.  8+75+1 = 84 bytes fits no free gap, so it OVERLAYS
   145 				; Scan_Spec + Txt_Line ($650-$6A3).  Safe because neither is live across
   146 				; either use: Scan_Spec is only read by the CIO OPEN before the record loop
   147 				; (and rebuilt before every scan), Txt_Line is per-draw scratch that
   148 				; Text_PutStrAt does not touch, and Nfo_WalkBank ($650) is only live inside
   149 				; Info_Count_Lines (UI_Mode 4, no status line).
   150 				.var Nfo_Name_Line		:84 .byte = $650	; 8 key + 75 desc + $9B ($650-$6A3)
   151 				;	$6B7 to $6FF free (text80.asm uses $6B0-$6B6)
   152 				; Info viewer (.nfo): Info_Count_Lines maps NFO buffer banks through the $2000
   153 				; window and needs one byte to track which.  Overlays Scan_Spec ($650-$67F),
   154 				; idle whenever UI_Mode = 4 - the next disk scan rebuilds it on the way out.
   155 				.var Nfo_WalkBank		.byte = $650	; NFO buffer VBXE bank currently mapped ($25..$29)
   156 				;	$651-$6AF free while UI_Mode = 4 (Scan_Spec / Txt_Line otherwise)
   157
   158 				;-----------------------------------------------------------------------------
   159 				; Defines go here
   160 				;-----------------------------------------------------------------------------
   161 = FFFF0001		.def	__VBXE_AUTO__
   162 = 2000			.def	VBXE_WINDOW						= $2000
   163 = 1000			.def	VBXE_WINDOW_SIZE_4k				= $1000
   164 = 2000			.def	VBXE_WINDOW_SIZE_8k				= $2000
   165 = 3000			.def	LOAD_ADDRESS					= VBXE_WINDOW + VBXE_WINDOW_SIZE_4k
   166
   167 				; Image name list (built by Rescan_Images - see ui.asm)
   168 = 0040			.def	IMAGE_BANK						= $40	; VBXE bank holding the name list
   169 = 00FF			.def	MAX_IMAGES						= 255	; Hard ceiling - see Memory Map note
   170 = 2000			.def	ImageNames						= VBXE_WINDOW	; List base once IMAGE_BANK is mapped
   171 = 27F8			.def	ImageNames_End					= ImageNames + (MAX_IMAGES * 8)
   172 = 0028			.def	Dir_Line_Len					= $28	; Max length of one dir GET RECORD line
   173
   174 				; Single-file image: <name>.V1K = .PAL block + .MAP block + .RAW block, no
   175 				; header - every block is fixed-size, so every offset is a constant.
   176 				; Load_Image streams each block to the same VRAM the old 3-file load used.
   177 = 0C00			.def	V1K_PAL_LEN						= $0C00		; 4 palettes x 768     = 3072
   178 = 2580			.def	V1K_MAP_LEN						= $2580		; 40 cells x 240 rows  = 9600
   179 = 012C00			.def	V1K_RAW_LEN						= $12C00	; 320 x 240 pixels     = 76800
   180 = 0021			.def	V1K_PAL_BANK					= $21		; -> $21000 (read back by Apply_Image_Palette)
   181 = 0014			.def	V1K_MAP_BANK					= $14		; -> $14000 (CRAM_Buffer, Setup_Cmap1 expands it)
   182 = 0001			.def	V1K_RAW_BANK					= $01		; -> $01000 (framebuffer)
   183
   184 				; VBXE text screen (text80.asm + XDL_MainMenu in xdl.asm - these MUST agree).
   185 				; Chosen clear of the image framebuffer/CRAM ($01000-$205FF), palette buffer
   186 				; ($21000), the name list ($40000) and the dir browser ($41000).
   187 = 022000			.def	TEXT_FONT_VRAM					= $22000	; CGA.F08 (2048 bytes) lands here
   188 = 0022			.def	TEXT_FONT_BANK					= TEXT_FONT_VRAM / $1000	; = $22  (LoadData target bank)
   189 = 0044			.def	TEXT_CHBASE						= TEXT_FONT_VRAM / $800	; = $44  (XDL_MainMenu CHBASE bytes, CGA - boot default)
   190 = 022800			.def	TEXT_FONT2_VRAM					= TEXT_FONT_VRAM + $800	; $22800 - Atari font (2nd 2K slot in bank $22)
   191 = 0045			.def	TEXT_CHBASE2					= TEXT_FONT2_VRAM / $800	; = $45  (XDL_MainMenu CHBASE bytes, Atari)
   192 = 023000			.def	TEXT_SCREEN_VRAM				= $23000	; ONE contiguous {glyph,attr} buffer,
   193 																	; TEXT_ROWS rows x TEXT_PITCH bytes
   194 = 0023			.def	TEXT_SCREEN_BANK				= TEXT_SCREEN_VRAM / $1000	; = $23  (first bank of screen RAM)
   195 = 0050			.def	TEXT_COLS						= 80
   196 = 00A0			.def	TEXT_PITCH						= TEXT_COLS * 2	; $A0 = 160
   197 				; The menu/info XDL displays this ONE linear buffer as two on-screen bands
   198 				; (a blank+separator gap between them is a display-time XDL gap only, not a
   199 				; VRAM gap - text80.asm's Text_PutStrAt just walks linear rows 0..TEXT_ROWS-1):
   200 = 0014			.def	TEXT_MAIN_ROWS					= 20		; rows 0-19: grid/Location/NFO scroll content
   201 = 0003			.def	TEXT_FOOTER_ROWS				= 3		; rows 20-22: status/delay/legend, or an info hint line
   202 = 0017			.def	TEXT_ROWS						= TEXT_MAIN_ROWS + TEXT_FOOTER_ROWS	; = 23 total buffer rows
   203 = 0E60			.def	TEXT_SCREEN_BYTES				= TEXT_ROWS * TEXT_PITCH	; 23*160 = 3680
   204 = 023C80			.def	TEXT_FOOTER_VRAM				= TEXT_SCREEN_VRAM + (TEXT_MAIN_ROWS * TEXT_PITCH)	; row 20 of the same buffer
   205 				; Off-screen back buffer, same layout as TEXT_SCREEN_VRAM.  Every text draw
   206 				; (Text_PutStrAt / Text_Clear / Text_FillColour / save-under / NFO blit) lands
   207 				; here; Text_Present copies it to the displayed buffer with one blit in vblank,
   208 				; so no partly-drawn screen is ever shown.  3680 bytes - fits one bank.
   209 = 02A000			.def	TEXT_BACK_VRAM					= $2A000
   210 = 002A			.def	TEXT_BACK_BANK					= TEXT_BACK_VRAM / $1000	; = $2A
   211
   212 				; Menu/info XDL graphics bands (XDL_MainMenu in xdl.asm) - the top banner and
   213 				; the two (shared) 1-line separators.  Both sit in the previously-undocumented,
   214 				; genuinely-unreferenced $30000-$3FFFF gap, well clear of every other region.
   215 = 030000			.def	MENU_BANNER_VRAM				= $30000
   216 = 0030			.def	MENU_BANNER_BANK				= MENU_BANNER_VRAM / $1000	; = $30
   217 = 0024			.def	MENU_BANNER_ROWS				= 36
   218 = 0140			.def	MENU_BANNER_PITCH				= 320		; = $140, matches XDL_Image_* OVSTEP
   219 = 2D00			.def	MENU_BANNER_BYTES				= MENU_BANNER_ROWS * MENU_BANNER_PITCH	; = 11520 = $2D00
   220 = 033000			.def	MENU_SEP_VRAM					= $33000	; next free bank after the banner (3 banks)
   221 = 00A0			.def	MENU_SEP_PITCH					= 160		; 160-byte pattern table, Palette 0 (modified) indices -
   222 																		; Assets/MENU_SEP.RAW, loaded once by Load_Menu_Sep (init_vbxe.asm)
   223
   224 				; Banner palette + attribute map: never touched at runtime (unlike the real
   225 				; image viewer's $21000/$017000 scratch, which Load_Image legitimately
   226 				; overwrites for every image view).  Dedicated, resident VRAM - see
   227 				; Load_Menu_Logo1-3 (init_vbxe.asm) / Apply_Menu_Palettes (below).
   228 				; The palette is generated, not stored (Apply_Menu_Palettes).  The attribute map has no file either: it is left all
   229 				; zeros (= palette 0) by the boot-time clear_vbxe, and Set_Menu_Demo_Attrs
   230 				; sets just the ramp squares' cells.
   231 = 035000			.def	MENU_BANNER_MAP_VRAM			= $35000	; expanded attribute map (40 cells x 36 rows x
   232 																	; 4 bytes = 5760 bytes, same layout as CRAM);
   233 																	; XDL_MainMenu's banner MAPADR points here, NOT
   234 																	; at the shared $017000 CRAM
   235
   236 				; Menu banner palette-demo overlay: a 32x33px 2x2 grid of identical 16x16
   237 				; ramp squares, repeated at both banner edges. Left edge: TL=pal0, TR=pal1,
   238 				; BL=pal2, BR=pal3. Right edge: same pixel data (Menu_Demo_Dest_Table is
   239 				; unchanged) but horizontally mirrored via the attribute map only -
   240 				; TL=pal1, TR=pal0, BL=pal3, BR=pal2 - see Build_Menu_Ramp_Table, Draw_Menu_Demo_
   241 				; Squares, Set_Menu_Demo_Attrs (below).
   242 = 02E000			.def	MENU_RAMP_VRAM					= $2E000	; 256-byte ascending 0..255 pixel-source table
   243 = 002E			.def	MENU_RAMP_BANK					= MENU_RAMP_VRAM / $1000	; = $2E ("free" bank)
   244 = 0010			.def	MENU_DEMO_SQUARE				= 16		; one ramp square is 16x16 px
   245 = 0000			.def	MENU_DEMO_ROW_TOP				= 0			; first row of the top squares
   246 = 0011			.def	MENU_DEMO_ROW_BOT				= MENU_DEMO_ROW_TOP+MENU_DEMO_SQUARE+1	; = 19, first row of the bottom squares
   247 = 0000			.def	MENU_DEMO_COL_LEFT				= 0			; left-edge block, x
   248 = 0120			.def	MENU_DEMO_COL_RIGHT				= MENU_BANNER_PITCH-(MENU_DEMO_SQUARE*2)	; = 288, right-edge block, x
   249 = 00A0			.def	MENU_ATTR_ROW_BYTES				= 160		; expanded attribute map stride (40 cells x 4 bytes)
   250 				; The 4 demo block origins (top-left pixel of each block's TL square) -
   251 				; Menu_Demo_Dest_Table (below) adds MENU_DEMO_SQUARE to reach each block's TR/BR square.
   252 = 030000			.def	MENU_DEMO_ADDR_L_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   253 = 031540			.def	MENU_DEMO_ADDR_L_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_LEFT
   254 = 030120			.def	MENU_DEMO_ADDR_R_TOP			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_TOP*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   255 = 031660			.def	MENU_DEMO_ADDR_R_BOT			= MENU_BANNER_VRAM+(MENU_DEMO_ROW_BOT*MENU_BANNER_PITCH)+MENU_DEMO_COL_RIGHT
   256
   257 				; P (Pal) preview overlay: reuses the menu banner's ramp-square source
   258 				; (MENU_RAMP_VRAM) blitted 4x into the image framebuffer at 7x zoom
   259 				; (112x112px/square) as one non-mirrored 2x2 grid (TL=pal0, TR=pal1,
   260 				; BL=pal2, BR=pal3), centered on the 320x239 visible image screen.  See
   261 				; Selector_Handle_P (ui.asm), Fill_Pal_Preview_Cmap, Draw_Pal_Preview_Squares.
   262 = 1000			.def	PAL_PREVIEW_VRAM				= $001000	; image framebuffer (same target Load_Image's .RAW uses)
   263 = 0140			.def	PAL_PREVIEW_PITCH				= MENU_BANNER_PITCH	; = 320, same screen pitch
   264 = 0007			.def	PAL_PREVIEW_ZOOM				= 7			; 7x7 zoom -> 112x112px/square
   265 = 0070			.def	PAL_PREVIEW_SQUARE				= MENU_DEMO_SQUARE*PAL_PREVIEW_ZOOM	; = 112
   266 = 00EF			.def	PAL_PREVIEW_VIS_ROWS			= 239		; visible scanlines (XDL_Image_* chains 239, not the 240-row buffer height)
   267 = 0007			.def	PAL_PREVIEW_TOP_ROW				= (PAL_PREVIEW_VIS_ROWS-(PAL_PREVIEW_SQUARE*2))/2	; = 7
   268 = 0077			.def	PAL_PREVIEW_BOT_ROW				= PAL_PREVIEW_TOP_ROW+PAL_PREVIEW_SQUARE			; = 119
   269 = 0030			.def	PAL_PREVIEW_LEFT_COL			= (320-(PAL_PREVIEW_SQUARE*2))/2	; = 48
   270 = 00A0			.def	PAL_PREVIEW_RIGHT_COL			= PAL_PREVIEW_LEFT_COL+PAL_PREVIEW_SQUARE			; = 160
   271 				; 4 destination pixel addresses (framebuffer) - Pal_Preview_Dest_Table (below).
   272 = 18F0			.def	PAL_PREVIEW_ADDR_TL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   273 = 1960			.def	PAL_PREVIEW_ADDR_TR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_TOP_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   274 = A4F0			.def	PAL_PREVIEW_ADDR_BL				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_LEFT_COL
   275 = A560			.def	PAL_PREVIEW_ADDR_BR				= PAL_PREVIEW_VRAM+(PAL_PREVIEW_BOT_ROW*PAL_PREVIEW_PITCH)+PAL_PREVIEW_RIGHT_COL
   276 				; CRAM_Buffer (1 byte/cell, 40 cells/row scratch at $14000) cell addresses for
   277 				; the attribute fills - TL needs no fill (Clear_Screen already zeroed the
   278 				; whole buffer, and palette 0 = $00 is the zero default).
   279 = 014000			.def	CRAM_BUFFER_VRAM				= $14000
   280 = 0028			.def	CRAM_BUFFER_ROW_BYTES			= 40
   281 = 0006			.def	PAL_PREVIEW_CELL_LEFT			= PAL_PREVIEW_LEFT_COL/8	; = 6
   282 = 0014			.def	PAL_PREVIEW_CELL_RIGHT			= PAL_PREVIEW_RIGHT_COL/8	; = 20
   283 = 000E			.def	PAL_PREVIEW_CELL_W				= PAL_PREVIEW_SQUARE/8		; = 14 cells wide
   284 = 01412C			.def	PAL_PREVIEW_CMAP_TR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_TOP_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   285 = 01529E			.def	PAL_PREVIEW_CMAP_BL				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_LEFT
   286 = 0152AC			.def	PAL_PREVIEW_CMAP_BR				= CRAM_BUFFER_VRAM+(PAL_PREVIEW_BOT_ROW*CRAM_BUFFER_ROW_BYTES)+PAL_PREVIEW_CELL_RIGHT
   287
   288 				; NFO display buffer: the <name>.NFO file, loaded verbatim by Info_Load.  The
   289 				; converter emits it as this exact byte image of the text screen - fixed
   290 				; 160-byte line records of 80 {glyph,attr} cell pairs (attr $07), no
   291 				; terminators, one all-$00 record marking end-of-text.  Info_Draw blits an
   292 				; NFO_VISROWS window of it (source = NFO_BUF_VRAM + Nfo_Top*TEXT_PITCH) straight
   293 				; onto the text screen with BLT_NFO_DRAW - one plain rect copy, no reformat.
   294 = 025000			.def	NFO_BUF_VRAM					= $25000	; banks $25-$29 (5 * 4K = 20480 = 128 * 160)
   295 = 0025			.def	NFO_BUF_BANK					= NFO_BUF_VRAM / $1000	; = $25  (LoadData target)
   296
   297 				; Selector status-line description cache.  One NFO_NAME_SLOT-byte slot per
   298 				; image ordinal, filled by Nfo_Name_LoadManifest from D:IMAGES.LST on every
   299 				; Rescan_Images (the converter writes that file - 8-byte key + description per
   300 				; record).  Slot byte 0: $00 = no name, >=$20 = a NUL-terminated name.  128
   301 				; divides 4K so no slot straddles a bank; 255*128 = $7F80 -> banks $37-$3E.
   302 				; Nfo_Name_ClearCache (blitter) wipes it just before each refill.
   303 = 037000			.def	NFO_NAME_VRAM					= $37000
   304 = 0037			.def	NFO_NAME_BANK					= NFO_NAME_VRAM / $1000	; = $37
   305 = 0080			.def	NFO_NAME_SLOT					= 128		; bytes per image slot
   306 = 004B			.def	NFO_NAME_CAP						= 75		; chars shown on the status line
