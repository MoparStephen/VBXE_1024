  2544 				;-----------------------------------------------------------------------------
  2545 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2546 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2547 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2548 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2549 				; its 19 rows, clear first and blit only the records that exist.
  2550 				;-----------------------------------------------------------------------------
  2551 6107			Info_Draw
  2552 6107 A9 01			lda #$01
  2553 6109 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2554 610C AD DE 04			lda Nfo_LineCount
  2555 610F 0D DF 04			ora Nfo_LineCount + $01
  2556 6112 D0 03			bne Info_Draw_Some
  2557 6114 4C A8 3E			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2558 6117			Info_Draw_Some
  2559 6117 20 5C 61			jsr Info_Body_Rows
  2560 611A C9 13			cmp #NFO_VISROWS-1
  2561 611C B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2562 611E 20 A8 3E			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2563 6121			Info_Draw_Head
  2564 6121 A9 00			lda #$00							; record 0 -> row 0, one row
  2565 6123 85 80			sta Reg1
  2566 6125 85 81			sta Reg2
  2567 6127 85 83			sta Reg4
  2568 6129 A9 00			lda #<TEXT_BACK_VRAM
  2569 612B 85 82			sta Reg3
  2570 612D 20 85 61			jsr Info_Blit
  2571 6130 20 5C 61			jsr Info_Body_Rows
  2572 6133 F0 26			beq Info_Draw_Ret					; no body records
  2573 6135 85 83			sta Reg4
  2574 6137 C6 83			dec Reg4							; Reg4 = height-1
  2575 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2576 6139 A9 A0			lda #TEXT_PITCH
  2577 613B 85 80			sta Reg1
  2578 613D A9 00			lda #$00
  2579 613F 85 81			sta Reg2
  2580 6141 AE DC 04			ldx Nfo_Top
  2581 6144 F0 0E			beq Info_Draw_Body
  2582 6146			Info_Draw_MulL
  2583 6146 A5 80			lda Reg1
  2584 6148 18				clc
  2585 6149 69 A0			adc #TEXT_PITCH
  2586 614B 85 80			sta Reg1
  2587 614D 90 02			bcc Info_Draw_MulNC
  2588 614F E6 81			inc Reg2
  2589 6151			Info_Draw_MulNC
  2590 6151 CA				dex
  2591 6152 D0 F2			bne Info_Draw_MulL
  2592 6154			Info_Draw_Body
  2593 6154 A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2594 6156 85 82			sta Reg3
  2595 6158 4C 85 61			jmp Info_Blit						; (tail)
  2596 615B			Info_Draw_Ret
  2597 615B 60				rts
