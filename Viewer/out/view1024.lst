   492 				; Emit_Path_Prefix - Path_Buf = "D[n]:" + Scan_Path.  Returns X = next index.
   493 				; Called by Build_Filename (view1024.asm) before it appends base + "." + ext.
   494 				;-----------------------------------------------------------------------------
   495 50CD			Emit_Path_Prefix
   496 50CD A2 00			ldx #$00
   497 50CF A9 44			lda #'D'
   498 50D1 9D 8D 04			sta Path_Buf,x
   499 50D4 E8				inx
   500 50D5 AD CC 04			lda Scan_Drive
   501 50D8 F0 04			beq Emit_Path_Prefix_Colon
   502 50DA 9D 8D 04			sta Path_Buf,x
   503 50DD E8				inx
   504 50DE			Emit_Path_Prefix_Colon
   505 50DE A9 3A			lda #':'
   506 50E0 9D 8D 04			sta Path_Buf,x
   507 50E3 E8				inx
   508 50E4 A0 00			ldy #$00
   509 50E6			Emit_Path_Prefix_L1
   510 50E6 B9 28 06			lda Scan_Path,y
   511 50E9 F0 09			beq Emit_Path_Prefix_Done
   512 50EB 9D 8D 04			sta Path_Buf,x
   513 50EE E8				inx
   514 50EF C8				iny
   515 50F0 C0 28			cpy #$28
   516 50F2 90 F2			bcc Emit_Path_Prefix_L1
   517 50F4			Emit_Path_Prefix_Done
   518 50F4 60				rts
