  2926 62C8 8D C8 04			sta Sel_Top
  2927 62CB 60				rts
  2928 62CC			Sel_Find_Up_Next
  2929 62CC EE F4 04			inc Up_Idx
  2930 62CF 4C A5 62			jmp Sel_Find_Up_L1
  2931 62D2			Sel_Find_Up_Done
  2932 62D2 60				rts
