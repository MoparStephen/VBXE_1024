   673 				;-----------------------------------------------------------------------------
   674 				; Read_Image_Palette - read just the .PAL block (the first one) of File_Index's
   675 				; .V1K into $21000.  Does NOT touch the palette registers - the caller applies
   676 				; it (Apply_Image_Palette) once the screen it belongs to is ready.  File_Index
   677 				; must be set before calling.  Used by Selector_Handle_P (P-preview, ui.asm).
   678 				;  Out: C=1 if the file is missing or short.
   679 				;-----------------------------------------------------------------------------
   680 34F9			Read_Image_Palette
   681 34F9 A9 00			lda #$00							; ext 0 = .V1K
   682 34FB 20 1D 3C			jsr Build_Filename
   683 34FE 20 A5 35			jsr Image_Open
   684 3501 B0 08			bcs Read_Image_Palette_Done			; OPEN failed (C=1)
   685 3503 20 94 35			jsr Image_Read_Pal
   686 3506 08				php
   687 3507 20 31 36			jsr Image_Close
   688 350A 28				plp									; C from the read
   689 350B			Read_Image_Palette_Done
   690 350B 60				rts
   691
   692 				;-----------------------------------------------------------------------------
   693 				; Apply_Image_Palette - push the 4 x 768-byte palettes at $21000 (the .V1K's
   694 				; .PAL block) into hardware palette registers 0-3.  Sets Pal_Image, so the
   695 				; next Enter_Selector knows the menu's palettes have to be put back.  Clears
   696 				; Pal_Off - every palette is back on.
   697 				;-----------------------------------------------------------------------------
   698 350C			Apply_Image_Palette
   699 350C A9 00			lda #$00
   700 350E 8D FB 04			sta Pal_Off
   701 3511 A9 01			lda #$01
   702 3513 8D E7 04			sta Pal_Image
   703 3516 A9 A1			lda #V1K_PAL_BANK | MEMAC_GLOBAL_ENABLE	; Bank $21 VBXE Window Enabled
   704 3518				vbsta VBXE_MA_BSEL
