   260 				;-----------------------------------------------------------------------------
   261 				; Build_Image_List - rebuild the selector list in IMAGE_BANK through the $2000
   262 				; window, grouped:  ".."  (only below the drive root)  |  sub-directories  |
   263 				; *.V1K files.  Rescan_Images sorts the two real groups A-Z afterwards.
   264 				; Sets ImageCount, Dir_Count and FileStart (index of the first *.V1K row).
   265 				;   - directory pass: OPEN "D[n]:PATH*.*" long DIR format (AUX2 = $80) and keep
   266 				;     only lines carrying SDX's "<DIR>" size-column tag (Line_Has_Dir_Tag).
   267 				;   - file pass:      OPEN "D[n]:PATH*.V1K" short format (AUX2 = $00) as before.
   268 				; One 8-byte write cursor (Name_Ptr) and one ImageNames_End guard span both.
   269 				;-----------------------------------------------------------------------------
   270 5152			Build_Image_List
   271 5152 A9 00			lda #$00
   272 5154 8D 8B 04			sta ImageCount
   273 5157 8D 8C 04			sta ImageCount+1
   274 515A 8D D9 04			sta Dir_Count
   275
   276 515D A9 C0			lda #IMAGE_BANK | MEMAC_GLOBAL_ENABLE
   277 515F				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 515F A0 5F			ldy #<VBXE_MA_BSEL
     3 5161 91 93			sta (VBXEBase),y
Source: ui.asm
   278 5163 A9 00 85 8A A9 20 + 	mwa #ImageNames Name_Ptr
   279
   280 				; --- ".." at slot 0 whenever we are below the drive root
   281 516B AD 28 06			lda Scan_Path
   282 516E F0 19			beq Build_Image_List_Dirs
   283 5170 A0 00			ldy #$00
   284 5172 A9 2E			lda #'.'
   285 5174 91 8A			sta (Name_Ptr),y
   286 5176 C8				iny
   287 5177 91 8A			sta (Name_Ptr),y
   288 5179 C8				iny
   289 517A A9 20			lda #' '
   290 517C			Build_Image_List_DotPad
   291 517C 91 8A			sta (Name_Ptr),y
   292 517E C8				iny
   293 517F C0 08			cpy #$08
   294 5181 90 F9			bcc Build_Image_List_DotPad
   295 5183 EE 8B 04			inc ImageCount
   296 5186 20 7E 52			jsr Build_Image_List_Adv
   297
   298 				; --- directory pass : "D[n]:PATH*.*", long DIR format
   299 5189			Build_Image_List_Dirs
   300 5189 20 19 51			jsr Build_Browse_Spec
   301 518C 20 2D 30			jsr Find_First_IOCB
   302 518F C0 01			cpy #$01
   303 5191 D0 54			bne Build_Image_List_Files			; no free IOCB - skip to files
   304 5193 8E C5 04			stx Dir_IOCB
   305 5196 A9 06			lda #CIO_dir
   306 5198 9D 4A 03			sta ICAX1,x
   307 519B A9 80			lda #$80							; long DIR format -> subdirs carry "<DIR>"
   308 519D 9D 4B 03			sta ICAX2,x
   309 51A0 A9 50			lda #<Scan_Spec
   310 51A2 9D 44 03			sta ICBAL,x
   311 51A5 A9 06			lda #>Scan_Spec
   312 51A7 9D 45 03			sta ICBAH,x
   313 51AA A9 03			lda #CIO_open
   314 51AC 9D 42 03			sta ICCOM,x
   315 51AF 20 56 E4			jsr CIOV
   316 51B2 30 33			bmi Build_Image_List_Files			; dir OPEN failed - still try files
   317
   318 51B4			Build_Image_List_DirL1
   319 51B4 20 47 52			jsr Build_Image_List_ReadLine
   320 51B7 B0 23			bcs Build_Image_List_DirClose		; EOF / error
   321 51B9 20 6C 52			jsr Build_Image_List_Full
   322 51BC B0 F6			bcs Build_Image_List_DirL1			; list full - drain, store nothing
   323 51BE 20 8A 52			jsr Parse_Dir_Line
   324 51C1 F0 F1			beq Build_Image_List_DirL1			; not a name line
   325 51C3 A0 00			ldy #$00
   326 51C5 B1 8A			lda (Name_Ptr),y
   327 51C7 C9 2E			cmp #'.'
   328 51C9 F0 E9			beq Build_Image_List_DirL1			; "." / ".." listing line
   329 51CB 20 A8 61			jsr Line_Has_Dir_Tag
   330 51CE F0 E4			beq Build_Image_List_DirL1			; no "<DIR>" tag -> a file, skip
   331 51D0 EE 8B 04			inc ImageCount
   332 51D3 EE D9 04			inc Dir_Count
   333 51D6 20 7E 52			jsr Build_Image_List_Adv
   334 51D9 4C B4 51			jmp Build_Image_List_DirL1
   335
   336 51DC			Build_Image_List_DirClose
   337 51DC AE C5 04			ldx Dir_IOCB
   338 51DF A9 0C			lda #CIO_close
   339 51E1 9D 42 03			sta ICCOM,x
   340 51E4 20 56 E4			jsr CIOV
   341
   342 				; --- file pass : "D[n]:PATH*.V1K", short format
   343 51E7			Build_Image_List_Files
   344 51E7 AD 8B 04			lda ImageCount						; FileStart = rows so far (".." + dirs)
   345 51EA 8D DA 04			sta FileStart
   346
   347 51ED 20 07 51			jsr Build_Spec
   348 51F0 20 2D 30			jsr Find_First_IOCB
   349 51F3 C0 01			cpy #$01
   350 51F5 D0 49			bne Build_Image_List_Unmap
   351 51F7 8E C5 04			stx Dir_IOCB
   352 51FA A9 06			lda #CIO_dir
   353 51FC 9D 4A 03			sta ICAX1,x
   354 51FF A9 00			lda #$00							; short DIRS format
   355 5201 9D 4B 03			sta ICAX2,x
   356 5204 A9 50			lda #<Scan_Spec
   357 5206 9D 44 03			sta ICBAL,x
   358 5209 A9 06			lda #>Scan_Spec
   359 520B 9D 45 03			sta ICBAH,x
   360 520E A9 03			lda #CIO_open
   361 5210 9D 42 03			sta ICCOM,x
   362 5213 20 56 E4			jsr CIOV
   363 5216 30 28			bmi Build_Image_List_Unmap			; OPEN failed - nothing to scan
   364
   365 5218			Build_Image_List_FileL1
   366 5218 20 47 52			jsr Build_Image_List_ReadLine
   367 521B B0 18			bcs Build_Image_List_FileClose
   368 521D 20 6C 52			jsr Build_Image_List_Full
   369 5220 B0 F6			bcs Build_Image_List_FileL1
   370 5222 20 8A 52			jsr Parse_Dir_Line
   371 5225 F0 F1			beq Build_Image_List_FileL1
   372 5227 EE 8B 04			inc ImageCount
   373 522A D0 03			bne Build_Image_List_FileAdv
