   748 5216 85 80			sta Reg1							; Reg1 = top_row
   749 5218 A5 82			lda Reg3
   750 521A 38				sec
   751 521B E5 80			sbc Reg1							; A = item_row - top_row
   752 521D 90 3A			bcc Selector_HiRow_Skip				; item_row < top_row - above the window
   753 521F C9 0F			cmp #UI_VISROWS
   754 5221 B0 36			bcs Selector_HiRow_Skip				; below the window
   755 5223 18				clc
   756 5224 69 02			adc #UI_FIRSTROW
