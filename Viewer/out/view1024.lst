  1064 56C8 85 88			sta Ptr_Lo
  1065 56CA AD E1 04			lda Nfo_Name_Ord
  1066 56CD 4A				lsr
  1067 56CE 29 0F			and #$0F							; (Ord >> 1) & 15
  1068 56D0 18				clc
  1069 56D1 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
  1070 56D3 85 89			sta Ptr_Hi
  1071 56D5 AD E1 04			lda Nfo_Name_Ord
