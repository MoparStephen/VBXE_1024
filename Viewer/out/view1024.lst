  1222 				;-----------------------------------------------------------------------------
  1223 				; UI_RowType - A = list index -> A = 0 file / 1 directory / 2 "..".
  1224 				; Z is set iff the row is a file.  The list is grouped ".." | dirs | files,
  1225 				; so the type is FileStart / Dir_Count / Scan_Path arithmetic, not a stored byte.
  1226 				;-----------------------------------------------------------------------------
