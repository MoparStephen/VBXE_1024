    84 3A60 85 88			sta Ptr_Lo
    85 3A62 A9 3D			lda #>Text_Font_Data
    86 3A64 85 89			sta Ptr_Hi
    87 3A66 A9 00			lda #<VBXE_WINDOW					; -> VBXE $022000  (CGA)
    88 3A68 85 80			sta Reg1
    89 3A6A A9 20			lda #>VBXE_WINDOW
    90 3A6C 85 81			sta Reg2
    91 3A6E 20 8B 3A			jsr Text_Copy_2K
    92
    93 3A71 A9 A9			lda #<Atari_Font_Data
    94 3A73 85 88			sta Ptr_Lo
    95 3A75 A9 45			lda #>Atari_Font_Data
    96 3A77 85 89			sta Ptr_Hi
    97 3A79 A9 00			lda #<[VBXE_WINDOW + $800]			; -> VBXE $022800  (Atari)
    98 3A7B 85 80			sta Reg1
    99 3A7D A9 28			lda #>[VBXE_WINDOW + $800]
   100 3A7F 85 81			sta Reg2
   101 3A81 20 8B 3A			jsr Text_Copy_2K
   102
   103 3A84 A9 00			lda #MEMAC_GLOBAL_DISABLE
