  1596 				;-----------------------------------------------------------------------------
  1597 				; Cmp_Records - lexicographic compare of the 8 bytes at (Name_Ptr) vs
  1598 				; (Sort_Ptr). Returns C=0 if (Name_Ptr) < (Sort_Ptr); C=1 (and Z=1 when fully
  1599 				; equal) otherwise.
  1600 				;-----------------------------------------------------------------------------
  1601 3A9C			Cmp_Records
  1602 3A9C A0 00			ldy #$00
  1603 3A9E			Cmp_Records_L1
  1604 3A9E B1 8A			lda (Name_Ptr),y
  1605 3AA0 D1 8C			cmp (Sort_Ptr),y
  1606 3AA2 D0 05			bne Cmp_Records_Done					; C/Z set from the mismatching byte
  1607 3AA4 C8				iny
  1608 3AA5 C0 08			cpy #$08
  1609 3AA7 90 F5			bcc Cmp_Records_L1					; all 8 equal -> falls out with C=1,Z=1
  1610 3AA9			Cmp_Records_Done
  1611 3AA9 60				rts
