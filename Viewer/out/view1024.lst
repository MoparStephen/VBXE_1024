   521 513D F0 04			beq Emit_Path_Prefix_Colon
   522 513F 9D 8D 04			sta Path_Buf,x
   523 5142 E8				inx
   524 5143			Emit_Path_Prefix_Colon
   525 5143 A9 3A			lda #':'
   526 5145 9D 8D 04			sta Path_Buf,x
   527 5148 E8				inx
   528 5149 A0 00			ldy #$00
   529 514B			Emit_Path_Prefix_L1
   530 514B B9 28 06			lda Scan_Path,y
   531 514E F0 09			beq Emit_Path_Prefix_Done
   532 5150 9D 8D 04			sta Path_Buf,x
   533 5153 E8				inx
   534 5154 C8				iny
   535 5155 C0 28			cpy #$28
   536 5157 90 F2			bcc Emit_Path_Prefix_L1
   537 5159			Emit_Path_Prefix_Done
   538 5159 60				rts
