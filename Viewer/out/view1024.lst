   448 3F15			Text_Window_Setup_Col
   449 3F15 AD B1 06			lda Txt_Col
   450 3F18 0A				asl
   451 3F19 18				clc
   452 3F1A 65 83			adc Reg4
   453 3F1C 85 83			sta Reg4
   454 3F1E 90 02			bcc Text_Window_Setup_ColNC
   455 3F20 E6 84			inc Reg5
   456 3F22			Text_Window_Setup_ColNC
   457 3F22 A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 -> $2000 window
   458 3F24				vbsta VBXE_MA_BSEL
