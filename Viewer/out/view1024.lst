  1317 382F			Handle_Keys_NotFolder
  1318 382F C9 04			cmp #$04
  1319 3831 D0 03			bne Handle_Keys_NotInfo
  1320 3833 4C 69 5D			jmp Info_Keys						; 4 = info viewer (.nfo)
  1321 3836			Handle_Keys_NotInfo
  1322 3836 C9 05			cmp #$05
  1323 3838 D0 03			bne Handle_Keys_NotQuit
  1324 383A 4C B8 5A			jmp Quit_Confirm_Keys				; 5 = quit-confirm popup (Selector only)
  1325 383D			Handle_Keys_NotQuit
  1326 383D C9 06			cmp #$06
