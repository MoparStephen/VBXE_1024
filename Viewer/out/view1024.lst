   122 				;-----------------------------------------------------------------------------
   123 				; Toggle_Font - flip the text screen between the CGA ($44) and Atari ($45)
   124 				; font by rewriting the two XDLC_CHBASE bytes (main + footer text blocks) in
   125 				; XDL_MainMenu.  The VBXE re-reads the XDL each frame, so the change shows on
   126 				; the next frame with no redraw.  Called from Handle_Keys on the F key, from
   127 				; any screen.
   128 				;-----------------------------------------------------------------------------
   129 39F0			Toggle_Font
   130 39F0 AD E0 04			lda Font_Sel
   131 39F3 49 01			eor #$01
   132 39F5 8D E0 04			sta Font_Sel
   133 39F8 18				clc
   134 39F9 69 44			adc #TEXT_CHBASE					; 0 -> $44 (CGA) / 1 -> $45 (Atari)
   135 39FB AA				tax									; hold it - vbsta clobbers A (and Y)
   136 39FC A9 80			lda #MEMAC_GLOBAL_ENABLE				; map VBXE bank $00 into the $2000 window
   137 39FE				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
