   591 				;-----------------------------------------------------------------------------
   592 				; Load_Image
   593 				; File_Index must be set before calling this!  No range checking is done!
   594 				; One OPEN of D:<name>.V1K, three sequential block reads:
   595 				;   .PAL block -> $21000, pushed to palette registers 0-3
   596 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   597 				;   .RAW block -> $01000 framebuffer
   598 				; A missing or short file stops at the failing block and closes the IOCB.
   599 				;-----------------------------------------------------------------------------
   600 33ED			Load_Image
   601 33ED A9 00			lda #$00							; ext 0 = .V1K
   602 33EF 20 2F 39			jsr Build_Filename
   603 33F2 20 41 34			jsr Image_Open
   604 33F5 B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   605
   606 33F7 20 30 34			jsr Image_Read_Pal
   607 33FA B0 2A			bcs Load_Image_Close
   608 33FC 20 B2 33			jsr Apply_Image_Palette
   609
   610 33FF A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   611 3401 A2 02			ldx #V1K_MAP_LEN / $1000
   612 3403 A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   613 3405 8C E5 04			sty Seg_Tail
   614 3408 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   615 340A 8C E6 04			sty Seg_Tail + $01
   616 340D 20 72 34			jsr Image_Read_Segment
   617 3410 B0 14			bcs Load_Image_Close
   618 3412 20 54 33			jsr Setup_Cmap1						; Expand the data out to $17000
   619
   620 3415 A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   621 3417 A2 12			ldx #V1K_RAW_LEN / $1000
   622 3419 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   623 341B 8C E5 04			sty Seg_Tail
   624 341E A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   625 3420 8C E6 04			sty Seg_Tail + $01
   626 3423 20 72 34			jsr Image_Read_Segment
   627
   628 3426			Load_Image_Close
   629 3426 20 CD 34			jsr Image_Close
   630
   631 3429			Load_Image_Done
   632 3429 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   633 342B				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 342B A0 5F			ldy #<VBXE_MA_BSEL
     3 342D 91 93			sta (VBXEBase),y
Source: view1024.asm
   634
   635 342F 60				rts
