  1291 58D4 A0 08			ldy #$08
  1292 58D6 A9 20			lda #' '
  1293 58D8 99 CD 04			sta Name_Row_Buf,y
  1294 58DB C8				iny
  1295 58DC 99 CD 04			sta Name_Row_Buf,y
  1296 58DF C8				iny
  1297 58E0 A9 00			lda #$00
  1298 58E2 99 CD 04			sta Name_Row_Buf,y
