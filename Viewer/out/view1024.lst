  1586 57E6 4C 16 58			jmp Sel_Nav_Apply
  1587
  1588 57E9			Sel_Key_Up
  1589 57E9 AD C7 04			lda Sel_Index
  1590 57EC C9 08			cmp #UI_COLS
  1591 57EE 90 4C			bcc Sel_Key_Nav_Done				; already in the top grid row
  1592 57F0 38				sec
  1593 57F1 E9 08			sbc #UI_COLS
  1594 57F3 4C 16 58			jmp Sel_Nav_Apply
  1595
  1596 57F6			Sel_Key_Left
