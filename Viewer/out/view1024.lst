   883 50EA 0A				asl
   884 50EB 0A				asl
   885 50EC 0A				asl
   886 50ED 0A				asl
   887 50EE 0A				asl									; A = (Ord & 3) << 6
   888 50EF 85 88			sta Ptr_Lo
   889 50F1 AD E1 04			lda Nfo_Name_Ord
   890 50F4 4A				lsr
   891 50F5 4A				lsr
   892 50F6 29 0F			and #$0F							; (Ord >> 2) & 15
   893 50F8 18				clc
   894 50F9 69 20			adc #>VBXE_WINDOW					; -> $20..$2F
   895 50FB 85 89			sta Ptr_Hi
   896 50FD AD E1 04			lda Nfo_Name_Ord
   897 5100 4A				lsr
   898 5101 4A				lsr
   899 5102 4A				lsr
   900 5103 4A				lsr
   901 5104 4A				lsr
   902 5105 4A				lsr									; Ord >> 6  (0..3)
   903 5106 18				clc
   904 5107 69 2A			adc #NFO_NAME_BANK
   905 5109 09 80			ora #MEMAC_GLOBAL_ENABLE
   906 510B				vbsta VBXE_MA_BSEL
