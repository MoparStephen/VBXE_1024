   752 34B4 0D E6 04			ora Seg_Tail + $01
   753 34B7 F0 09			beq Image_Read_Segment_OK			; no partial chunk
   754 34B9 AD E5 04			lda Seg_Tail
   755 34BC AC E6 04			ldy Seg_Tail + $01
   756 34BF 4C C4 34			jmp Image_Read_Chunk
   757
   758 34C2			Image_Read_Segment_OK
   759 34C2 18				clc
   760 34C3			Image_Read_Segment_Done
   761 34C3 60				rts
   762
   763 				; Map Seg_Bank at VBXE_WINDOW and GET A/Y bytes into it; Seg_Bank++ after.
   764 				; C=1 on a CIO error.
