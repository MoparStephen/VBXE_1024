  1521 				;-----------------------------------------------------------------------------
  1522 				; Increment_Image - advance File_Index within the *.V1K file band
  1523 				; [FileStart, ImageCount), wrapping past the last file to the first.
  1524 				; No-op when the list holds no files.  (The selector list may now also carry
  1525 				; ".." and directory rows below FileStart - Space/BkSp must skip those.)
  1526 				;-----------------------------------------------------------------------------
  1527 3A2F			Increment_Image
  1528 3A2F AD DA 04			lda FileStart
  1529 3A32 CD 8B 04			cmp ImageCount
  1530 3A35 B0 15			bcs Increment_Image_Done			; no *.V1K files in the list
  1531 3A37 AE 8A 04			ldx File_Index
  1532 3A3A E8				inx
  1533 3A3B EC 8B 04			cpx ImageCount
  1534 3A3E 90 03			bcc Increment_Image_Store
  1535 3A40 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1536 3A43			Increment_Image_Store
  1537 3A43 8E 8A 04			stx File_Index
  1538 3A46 20 51 35			jsr Load_Image
  1539 3A49 20 14 3B			jsr Map_View_Reapply				; still in the M map view? solid palettes back
  1540 3A4C			Increment_Image_Done
  1541 3A4C 60				rts
  1542
  1543 				;-----------------------------------------------------------------------------
  1544 				; Decrement_Image - step File_Index back within [FileStart, ImageCount),
  1545 				; wrapping from the first file to the last.  No-op when the list holds no files.
  1546 				;-----------------------------------------------------------------------------
  1547 3A4D			Decrement_Image
  1548 3A4D AD DA 04			lda FileStart
  1549 3A50 CD 8B 04			cmp ImageCount
  1550 3A53 B0 15			bcs Decrement_Image_Done
  1551 3A55 AE 8A 04			ldx File_Index
  1552 3A58 EC DA 04			cpx FileStart
  1553 3A5B D0 03			bne Decrement_Image_Step
  1554 3A5D AE 8B 04			ldx ImageCount						; wrap: first file -> (last file + 1)
  1555 3A60			Decrement_Image_Step
  1556 3A60 CA				dex
  1557 3A61 8E 8A 04			stx File_Index
  1558 3A64 20 51 35			jsr Load_Image
  1559 3A67 20 14 3B			jsr Map_View_Reapply
  1560 3A6A			Decrement_Image_Done
  1561 3A6A 60				rts
