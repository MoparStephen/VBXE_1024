   513 				; --- write the cells -------------------------------------------------------
   514 3D4D A9 00			lda #$00
   515 3D4F 85 82			sta Reg3							; Reg3 = source string index
   516 3D51 AD B1 06			lda Txt_Col
   517 3D54 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   518 3D56			Text_PutStrAt_Char
   519 3D56 A5 83			lda Reg4
   520 3D58 C9 50			cmp #TEXT_COLS
   521 3D5A B0 39			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   522 3D5C A4 82			ldy Reg3
   523 3D5E B1 96			lda (Txt_Ptr),y
   524 3D60 F0 33			beq Text_PutStrAt_Done
   525 3D62 A0 00			ldy #$00
   526 3D64 91 88			sta (Ptr_Lo),y						; glyph byte
   527 3D66 C8				iny
   528 3D67 AD B4 06			lda Txt_Attr
   529 3D6A 91 88			sta (Ptr_Lo),y						; attribute byte
   530 3D6C E6 82			inc Reg3
   531 3D6E E6 83			inc Reg4
   532 3D70 A5 88			lda Ptr_Lo							; window pointer += 2
   533 3D72 18				clc
   534 3D73 69 02			adc #$02
   535 3D75 85 88			sta Ptr_Lo
   536 3D77 90 02			bcc Text_PutStrAt_NoPage
   537 3D79 E6 89			inc Ptr_Hi
   538 3D7B			Text_PutStrAt_NoPage
   539 3D7B A5 89			lda Ptr_Hi
   540 3D7D C9 30			cmp #$30							; crossed out of the window -> next bank
   541 3D7F 90 D5			bcc Text_PutStrAt_Char
   542 3D81 38				sec
   543 3D82 E9 10			sbc #$10
   544 3D84 85 89			sta Ptr_Hi							; wrap back to $20xx
   545 3D86 EE B6 06			inc Txt_Bank
   546 3D89 AD B6 06			lda Txt_Bank
   547 3D8C 09 80			ora #MEMAC_GLOBAL_ENABLE
