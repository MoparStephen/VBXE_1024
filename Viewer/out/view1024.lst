  2516 				;-----------------------------------------------------------------------------
  2517 				; Info_Draw - the info screen, from the NFO buffer by blitter - no re-walk:
  2518 				;   row 0     = record 0 (the report's ==== title rule), pinned - never scrolls
  2519 				;   rows 1-19 = records 1+Nfo_Top onward (Nfo_Top scrolls the body only)
  2520 				; Two BLT_NFO_DRAW copies (head, then body).  When the body is shorter than
  2521 				; its 19 rows, clear first and blit only the records that exist.
  2522 				;-----------------------------------------------------------------------------
  2523 5E0E			Info_Draw
  2524 5E0E A9 01			lda #$01
  2525 5E10 8D B7 06			sta Txt_Dirty						; the blits below write the back buffer
  2526 5E13 AD DE 04			lda Nfo_LineCount
  2527 5E16 0D DF 04			ora Nfo_LineCount + $01
  2528 5E19 D0 03			bne Info_Draw_Some
  2529 5E1B 4C EB 3B			jmp Text_Clear						; empty .NFO - nothing to show (tail)
  2530 5E1E			Info_Draw_Some
  2531 5E1E 20 63 5E			jsr Info_Body_Rows
  2532 5E21 C9 13			cmp #NFO_VISROWS-1
  2533 5E23 B0 03			bcs Info_Draw_Head					; full body window - every row is overwritten
  2534 5E25 20 EB 3B			jsr Text_Clear						; short body: clear the rows the blit won't reach
  2535 5E28			Info_Draw_Head
  2536 5E28 A9 00			lda #$00							; record 0 -> row 0, one row
  2537 5E2A 85 80			sta Reg1
  2538 5E2C 85 81			sta Reg2
  2539 5E2E 85 83			sta Reg4
  2540 5E30 A9 00			lda #<TEXT_BACK_VRAM
  2541 5E32 85 82			sta Reg3
  2542 5E34 20 8C 5E			jsr Info_Blit
  2543 5E37 20 63 5E			jsr Info_Body_Rows
  2544 5E3A F0 26			beq Info_Draw_Ret					; no body records
  2545 5E3C 85 83			sta Reg4
  2546 5E3E C6 83			dec Reg4							; Reg4 = height-1
  2547 				; Reg2:Reg1 = (Nfo_Top + 1) * TEXT_PITCH  (Nfo_Top <= NFO_MAX_LINES-NFO_VISROWS -> <= $4380)
  2548 5E40 A9 A0			lda #TEXT_PITCH
  2549 5E42 85 80			sta Reg1
  2550 5E44 A9 00			lda #$00
  2551 5E46 85 81			sta Reg2
  2552 5E48 AE DC 04			ldx Nfo_Top
  2553 5E4B F0 0E			beq Info_Draw_Body
  2554 5E4D			Info_Draw_MulL
  2555 5E4D A5 80			lda Reg1
  2556 5E4F 18				clc
  2557 5E50 69 A0			adc #TEXT_PITCH
  2558 5E52 85 80			sta Reg1
  2559 5E54 90 02			bcc Info_Draw_MulNC
  2560 5E56 E6 81			inc Reg2
  2561 5E58			Info_Draw_MulNC
  2562 5E58 CA				dex
  2563 5E59 D0 F2			bne Info_Draw_MulL
  2564 5E5B			Info_Draw_Body
  2565 5E5B A9 A0			lda #<[TEXT_BACK_VRAM+TEXT_PITCH]	; row 1 (same bank/page - only the lo byte moves)
  2566 5E5D 85 82			sta Reg3
  2567 5E5F 4C 8C 5E			jmp Info_Blit						; (tail)
  2568 5E62			Info_Draw_Ret
  2569 5E62 60				rts
  2570
  2571 				;-----------------------------------------------------------------------------
  2572 				; Info_Body_Rows - A = body rows to show = min(Nfo_LineCount-1-Nfo_Top,
  2573 				; NFO_VISROWS-1), Z set if 0.  Needs Nfo_LineCount >= 1 (the scroll clamp
  2574 				; keeps Nfo_Top <= Nfo_LineCount-1).  Clobbers Reg5, Reg6.
  2575 				;-----------------------------------------------------------------------------
  2576 5E63			Info_Body_Rows
  2577 5E63 38				sec
  2578 5E64 AD DE 04			lda Nfo_LineCount
  2579 5E67 ED DC 04			sbc Nfo_Top
  2580 5E6A 85 84			sta Reg5
  2581 5E6C AD DF 04			lda Nfo_LineCount + $01
  2582 5E6F ED DD 04			sbc Nfo_Top + $01
  2583 5E72 85 85			sta Reg6
  2584 5E74 A5 84			lda Reg5							; Reg6:Reg5 -= 1 (record 0 is the pinned head)
  2585 5E76 38				sec
  2586 5E77 E9 01			sbc #$01
  2587 5E79 85 84			sta Reg5
  2588 5E7B A5 85			lda Reg6
  2589 5E7D E9 00			sbc #$00
  2590 5E7F D0 06			bne Info_Body_Rows_Full				; >= 256 available
  2591 5E81 A5 84			lda Reg5
  2592 5E83 C9 13			cmp #NFO_VISROWS-1
  2593 5E85 90 02			bcc Info_Body_Rows_Ret
  2594 5E87			Info_Body_Rows_Full
