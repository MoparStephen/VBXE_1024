   604 5354 A5 88			lda Ptr_Lo
   605 5356 18				clc
   606 5357 69 03			adc #$03									; step onto the first odd triplet
   607 5359 85 88			sta Ptr_Lo
   608 535B 90 02			bcc UI_Apply_TP_P2Dst
   609 535D E6 89			inc Ptr_Hi
   610 535F			UI_Apply_TP_P2Dst
   611 535F A9 80			lda #<[UI_APPLY_TP_BUF + $180]				; buf + 128*3
