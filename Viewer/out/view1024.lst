   491 				;-----------------------------------------------------------------------------
   492 				; Text_Window_Frame - draw a box with a blank interior over Txt_Row / Txt_Col /
   493 				; Reg1 (width-1) / Reg2 (height-1), using the current pen.  Txt_FrameStyle
   494 				; picks the border: the CP437 box-drawing glyphs FRAME_DOUBLE / FRAME_SINGLE.
   495 				; The Atari font carries its own single-line glyphs at those same codes (see
   496 				; Text_Load_Fonts), so the frame is right in either font with no redraw.
   497 				; Uses Txt_Line as scratch.  Clobbers A/X/Y, Reg1..Reg8.
   498 				;-----------------------------------------------------------------------------
   499 = 0000			.def	FRAME_DOUBLE	= 0				; Text_Window_Frame_Chars offsets (9 bytes per style)
   500 = 0009			.def	FRAME_SINGLE	= 9
   501
   502 				; Per style, three {left, fill, right} triples: top edge, interior row, bottom edge.
   503 4021			Text_Window_Frame_Chars
   504 4021 C9 CD BB BA 20 BA + 	dta $C9,$CD,$BB, $BA,' ',$BA, $C8,$CD,$BC	; FRAME_DOUBLE  (CP437 double lines)
   505 402A DA C4 BF B3 20 B3 + 	dta $DA,$C4,$BF, $B3,' ',$B3, $C0,$C4,$D9	; FRAME_SINGLE  (CP437 single lines)
   506
   507 4033			Text_Window_Frame
   508 4033 A5 80			lda Reg1
   509 4035 85 86			sta Reg7							; Reg7 = width-1 (survives Text_PutStrAt)
   510 4037 AD B1 06			lda Txt_Col
   511 403A 85 87			sta Reg8							; Reg8 = left column
   512 403C AD B0 06			lda Txt_Row
   513 403F 18				clc
   514 4040 65 81			adc Reg2
   515 4042 85 85			sta Reg6							; Reg6 = bottom-edge screen row
   516 4044 AD B0 06			lda Txt_Row
   517 4047 85 84			sta Reg5							; Reg5 = current screen row
   518 4049 AE B5 06			ldx Txt_FrameStyle
   519 404C 20 6B 40			jsr Text_Window_Frame_Row			; top edge
   520 404F			Text_Window_Frame_Mid
   521 404F E6 84			inc Reg5
   522 4051 A5 84			lda Reg5
   523 4053 C5 85			cmp Reg6
   524 4055 B0 0D			bcs Text_Window_Frame_Bottom
   525 4057 AD B5 06			lda Txt_FrameStyle
   526 405A 18				clc
   527 405B 69 03			adc #$03
   528 405D AA				tax
   529 405E 20 6B 40			jsr Text_Window_Frame_Row			; interior row
   530 4061 4C 4F 40			jmp Text_Window_Frame_Mid
   531 4064			Text_Window_Frame_Bottom
   532 4064 AD B5 06			lda Txt_FrameStyle
   533 4067 18				clc
   534 4068 69 06			adc #$06
   535 406A AA				tax									; bottom edge (tail - returns to caller)
   536
   537 				; X = offset of a {left, fill, right} triple in Text_Window_Frame_Chars.
   538 				; Builds the row in Txt_Line and draws it at row Reg5, column Reg8.
   539 406B			Text_Window_Frame_Row
   540 406B BD 21 40			lda Text_Window_Frame_Chars,x
   541 406E 8D 80 06			sta Txt_Line+0
   542 4071 BD 22 40			lda Text_Window_Frame_Chars+1,x
   543 4074 85 83			sta Reg4							; Reg4 = fill char (Reg3/4 free until Text_PutStrAt)
   544 4076 BD 23 40			lda Text_Window_Frame_Chars+2,x
   545 4079 85 82			sta Reg3							; Reg3 = right char
   546 407B A2 01			ldx #$01
   547 407D			Text_Window_Frame_Row_L1
   548 407D E4 86			cpx Reg7
   549 407F B0 08			bcs Text_Window_Frame_Row_End
   550 4081 A5 83			lda Reg4
   551 4083 9D 80 06			sta Txt_Line,x
   552 4086 E8				inx
   553 4087 D0 F4			bne Text_Window_Frame_Row_L1
   554 4089			Text_Window_Frame_Row_End
   555 4089 A5 82			lda Reg3
   556 408B 9D 80 06			sta Txt_Line,x
   557 408E E8				inx
   558 408F			Text_Window_Frame_PutRow
   559 408F A9 00			lda #$00
   560 4091 9D 80 06			sta Txt_Line,x
   561 4094 A5 84			lda Reg5
   562 4096 8D B0 06			sta Txt_Row
   563 4099 A5 87			lda Reg8
   564 409B 8D B1 06			sta Txt_Col
   565 409E A9 80			lda #<Txt_Line
   566 40A0 85 96			sta Txt_Ptr
   567 40A2 A9 06			lda #>Txt_Line
   568 40A4 85 97			sta Txt_Ptr + $01
   569 40A6 4C A9 40			jmp Text_PutStrAt					; tail (rts returns to Text_Window_Frame's caller)
   570
   571 				;-----------------------------------------------------------------------------
   572 				; Text_PutStrAt - write {ASCII, Txt_Attr} pairs for the $00-terminated string
   573 				; at Txt_Ptr, starting at cell (Txt_Col, Txt_Row), in the back buffer.  Tracks
   574 				; bank + window offset explicitly (kept general - the 3680-byte buffer sits in
   575 				; one bank today, but a cell walk past $xxFFF still steps to the next).
   576 				; Inline colour: TXT_PEN, attr switches the pen mid-string (takes no column),
   577 				; e.g. dta TXT_PEN,UI_PEN_LABEL,c'Location'.  The caller's pen (Txt_Fg/Txt_Bg)
   578 				; is restored on exit, so an escape never leaks into the next draw.
   579 				;-----------------------------------------------------------------------------
   580 = 0001			.def	TXT_PEN			= $01			; pen-change escape (CP437 smiley - never in names/descriptions)
   581
   582 40A9			Text_PutStrAt
   583 40A9 A9 01			lda #$01
   584 40AB 8D B7 06			sta Txt_Dirty
   585 				; --- Reg2:Reg1 = Txt_Row * TEXT_PITCH + Txt_Col * 2  (cell byte offset) -------
   586 40AE A9 00			lda #$00
   587 40B0 85 80			sta Reg1
   588 40B2 85 81			sta Reg2
   589 40B4 AE B0 06			ldx Txt_Row
   590 40B7 F0 0E			beq Text_PutStrAt_Col
   591 40B9			Text_PutStrAt_RowL
   592 40B9 A5 80			lda Reg1
   593 40BB 18				clc
   594 40BC 69 A0			adc #TEXT_PITCH
   595 40BE 85 80			sta Reg1
   596 40C0 90 02			bcc Text_PutStrAt_RowNC
   597 40C2 E6 81			inc Reg2
   598 40C4			Text_PutStrAt_RowNC
   599 40C4 CA				dex
   600 40C5 D0 F2			bne Text_PutStrAt_RowL
   601 40C7			Text_PutStrAt_Col
   602 40C7 AD B1 06			lda Txt_Col
   603 40CA 0A				asl									; Txt_Col * 2 (max 158)
   604 40CB 18				clc
   605 40CC 65 80			adc Reg1
   606 40CE 85 80			sta Reg1
   607 40D0 90 02			bcc Text_PutStrAt_ColNC
   608 40D2 E6 81			inc Reg2
   609 40D4			Text_PutStrAt_ColNC
   610 				; --- fold in TEXT_BACK_VRAM: offset (0..$E5F) -> bank + window pointer --------
   611 40D4 A5 81			lda Reg2
   612 40D6 29 10			and #$10							; offset bit 12 = "second bank"
   613 40D8 F0 04			beq Text_PutStrAt_Bank0
   614 40DA A9 2B			lda #TEXT_BACK_BANK+1
   615 40DC D0 02			bne Text_PutStrAt_SetBank
   616 40DE			Text_PutStrAt_Bank0
   617 40DE A9 2A			lda #TEXT_BACK_BANK
   618 40E0			Text_PutStrAt_SetBank
   619 40E0 8D B6 06			sta Txt_Bank
   620 40E3 A5 80			lda Reg1
   621 40E5 85 88			sta Ptr_Lo
   622 40E7 A5 81			lda Reg2
   623 40E9 29 0F			and #$0F
   624 40EB 18				clc
   625 40EC 69 20			adc #>VBXE_WINDOW					; + $20  -> $20xx..$2Fxx
   626 40EE 85 89			sta Ptr_Hi
   627 40F0 AD B6 06			lda Txt_Bank
   628 40F3 09 80			ora #MEMAC_GLOBAL_ENABLE
   629 40F5				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 40F5 A0 5F			ldy #<VBXE_MA_BSEL
     3 40F7 91 93			sta (VBXEBase),y
Source: text80.asm
   630 				; --- write the cells -------------------------------------------------------
   631 40F9 A9 00			lda #$00
   632 40FB 85 82			sta Reg3							; Reg3 = source string index
   633 40FD AD B1 06			lda Txt_Col
   634 4100 85 83			sta Reg4							; Reg4 = current column (clip at TEXT_COLS)
   635 4102			Text_PutStrAt_Char
   636 4102 A5 83			lda Reg4
   637 4104 C9 50			cmp #TEXT_COLS
   638 4106 B0 49			bcs Text_PutStrAt_Done				; hit the right edge - stop (never wrap)
   639 4108 A4 82			ldy Reg3
   640 410A B1 96			lda (Txt_Ptr),y
   641 410C F0 43			beq Text_PutStrAt_Done
   642 410E C9 01			cmp #TXT_PEN
   643 4110 D0 0C			bne Text_PutStrAt_Glyph
   644 4112 C8				iny									; TXT_PEN, attr - next byte is the new pen
   645 4113 B1 96			lda (Txt_Ptr),y
   646 4115 8D B4 06			sta Txt_Attr
   647 4118 C8				iny
   648 4119 84 82			sty Reg3							; skip both bytes, column unchanged
   649 411B 4C 02 41			jmp Text_PutStrAt_Char
   650 411E			Text_PutStrAt_Glyph
   651 411E A0 00			ldy #$00
   652 4120 91 88			sta (Ptr_Lo),y						; glyph byte
   653 4122 C8				iny
   654 4123 AD B4 06			lda Txt_Attr
   655 4126 91 88			sta (Ptr_Lo),y						; attribute byte
   656 4128 E6 82			inc Reg3
   657 412A E6 83			inc Reg4
   658 412C A5 88			lda Ptr_Lo							; window pointer += 2
   659 412E 18				clc
   660 412F 69 02			adc #$02
   661 4131 85 88			sta Ptr_Lo
   662 4133 90 02			bcc Text_PutStrAt_NoPage
   663 4135 E6 89			inc Ptr_Hi
   664 4137			Text_PutStrAt_NoPage
   665 4137 A5 89			lda Ptr_Hi
   666 4139 C9 30			cmp #$30							; crossed out of the window -> next bank
   667 413B 90 C5			bcc Text_PutStrAt_Char
   668 413D 38				sec
   669 413E E9 10			sbc #$10
   670 4140 85 89			sta Ptr_Hi							; wrap back to $20xx
   671 4142 EE B6 06			inc Txt_Bank
   672 4145 AD B6 06			lda Txt_Bank
   673 4148 09 80			ora #MEMAC_GLOBAL_ENABLE
   674 414A				vbsta VBXE_MA_BSEL
