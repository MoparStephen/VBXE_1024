  1450 39D7 AD DA 04			lda FileStart
  1451 39DA CD 8B 04			cmp ImageCount
  1452 39DD B0 15			bcs Increment_Image_Done			; no *.V1K files in the list
  1453 39DF AE 8A 04			ldx File_Index
  1454 39E2 E8				inx
  1455 39E3 EC 8B 04			cpx ImageCount
  1456 39E6 90 03			bcc Increment_Image_Store
  1457 39E8 AE DA 04			ldx FileStart						; wrap past the last file to the first
  1458 39EB			Increment_Image_Store
  1459 39EB 8E 8A 04			stx File_Index
  1460 39EE 20 15 35			jsr Load_Image
  1461 39F1 20 5F 3B			jsr Map_View_Reapply				; still in key-5 view? recolour entry 1
  1462 39F4			Increment_Image_Done
  1463 39F4 60				rts
