   237 3B8F A9 02			lda #[TEXT_BACK_VRAM >> 16]
   238 3B91 8D 80 21			sta BLT_TEXT_RECT + Src_Adr2
   239 3B94 A9 00			lda #<TEXT_SCREEN_VRAM
