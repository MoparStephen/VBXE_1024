   644 				;-----------------------------------------------------------------------------
   645 				; Load_Image
   646 				; File_Index must be set before calling this!  No range checking is done!
   647 				; One OPEN of D:<name>.V1K, three sequential block reads:
   648 				;   .PAL block -> $21000, pushed to palette registers 0-3
   649 				;   .MAP block -> $14000, blitter-expanded to $17000 by Setup_Cmap1
   650 				;   .RAW block -> $01000 framebuffer
   651 				; A missing or short file stops at the failing block and closes the IOCB.
   652 				;-----------------------------------------------------------------------------
   653 3415			Load_Image
   654 3415 A9 00			lda #$00							; ext 0 = .V1K
   655 3417 20 4C 39			jsr Build_Filename
   656 341A 20 69 34			jsr Image_Open
   657 341D B0 32			bcs Load_Image_Done					; OPEN failed - nothing to close
   658
   659 341F 20 58 34			jsr Image_Read_Pal
   660 3422 B0 2A			bcs Load_Image_Close
   661 3424 20 D5 33			jsr Apply_Image_Palette
   662
   663 3427 A9 14			lda #V1K_MAP_BANK					; Attribute Colour Map -> $14000
   664 3429 A2 02			ldx #V1K_MAP_LEN / $1000
   665 342B A0 80			ldy #<[V1K_MAP_LEN & $0FFF]
   666 342D 8C E5 04			sty Seg_Tail
   667 3430 A0 05			ldy #>[V1K_MAP_LEN & $0FFF]
   668 3432 8C E6 04			sty Seg_Tail + $01
   669 3435 20 9A 34			jsr Image_Read_Segment
   670 3438 B0 14			bcs Load_Image_Close
   671 343A 20 5A 33			jsr Setup_Cmap1						; Expand the data out to $17000
   672
   673 343D A9 01			lda #V1K_RAW_BANK					; Image pixels -> $01000
   674 343F A2 12			ldx #V1K_RAW_LEN / $1000
   675 3441 A0 00			ldy #<[V1K_RAW_LEN & $0FFF]
   676 3443 8C E5 04			sty Seg_Tail
   677 3446 A0 0C			ldy #>[V1K_RAW_LEN & $0FFF]
   678 3448 8C E6 04			sty Seg_Tail + $01
   679 344B 20 9A 34			jsr Image_Read_Segment
   680
   681 344E			Load_Image_Close
   682 344E 20 F5 34			jsr Image_Close
   683
   684 3451			Load_Image_Done
   685 3451 A9 00			lda #MEMAC_GLOBAL_DISABLE			; USE CPU address space
   686 3453				vbsta VBXE_MA_BSEL
Macro: VBSTA [Source: vbxe_min.asm]
     2 3453 A0 5F			ldy #<VBXE_MA_BSEL
     3 3455 91 93			sta (VBXEBase),y
Source: view1024.asm
