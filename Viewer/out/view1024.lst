  2918 6237 01 5D 47 65 6E 65 + 	dta TXT_PEN,UI_PEN_HELPHEAD,c'General Information:',0
  2919 624E 57 68 65 6E 20 74 + 	dta c'When the image viewer starts, it will scan the current directory.',0
  2920 6290 53 75 62 64 69 72 + 	dta c'Subdirectories are displayed alphabetically in Green.',0
  2921 62C6 54 68 65 20 69 6D + 	dta c'The image (V1K) files will be displayed alphabetically in Blue.',0
  2922 6306 45 61 63 68 20 56 + 	dta c'Each V1K file must have a corresponding NFO file to populate the Info screen.',0
  2923 6354 00				dta 0
  2924 6355 2A 2A 2A 20 4D 4F + 	dta c'*** MORE INFO TO COME ***',0
