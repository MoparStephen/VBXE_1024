   721 51BD CD 8B 04			cmp ImageCount
   722 51C0 B0 4E			bcs Selector_HiRow_Skip				; past the end of the list
   723 51C2 4A				lsr
   724 51C3 4A				lsr
   725 51C4 4A				lsr
   726 51C5 85 82			sta Reg3							; Reg3 = item_row (index / UI_COLS)
   727 51C7 AD C8 04			lda Sel_Top
   728 51CA 4A				lsr
   729 51CB 4A				lsr
   730 51CC 4A				lsr								; A = top_row (Sel_Top / UI_COLS)
   731 51CD 85 80			sta Reg1							; Reg1 = top_row
   732 51CF A5 82			lda Reg3
   733 51D1 38				sec
   734 51D2 E5 80			sbc Reg1							; A = item_row - top_row
   735 51D4 90 3A			bcc Selector_HiRow_Skip				; item_row < top_row - above the window
   736 51D6 C9 0F			cmp #UI_VISROWS
   737 51D8 B0 36			bcs Selector_HiRow_Skip				; below the window
   738 51DA 18				clc
   739 51DB 69 02			adc #UI_FIRSTROW
