    28
    29 3325 AD 30 02			lda SDLSTL
    30 3328 8D 85 04			sta SDLSTL_OLD
    31
    32 332B AD 31 02			lda SDLSTL+1
    33 332E 8D 86 04			sta SDLSTH_OLD
    34
