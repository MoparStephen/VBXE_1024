# Keep source in the repo and the working tree as LF (a Windows editor/tool
# rewrote a batch of files as CRLF once, which turned every line into a diff).
* text=auto eol=lf

# Files that are committed as CRLF on purpose - leave them byte-for-byte.
*.lab -text
*.lst -text
Convertor/palgui/presets/*.json -text

# Atari / VBXE binary assets - never touch line endings or diff them as text.
*.raw binary
*.RAW binary
*.pal binary
*.PAL binary
*.map binary
*.MAP binary
*.F08 binary
*.xex binary
*.v1k binary
*.V1K binary
*.nfo binary
*.NFO binary
